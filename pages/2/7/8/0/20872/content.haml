              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔽
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}
              (in fact over every
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
              of the
              %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
              of the
              %a.existingWikiWord{:href => "/nlab/show/ordered+configuration+space+of+points"} ordered configuration space of points
              in the
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
