              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi BU
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo ≅
                        %mo{:stretchy => "false"} [
                        %mi X
                        %mo ,
                        %mi ℂ
                        %msup
                          %mi P
                          %mn ∞
                        %mo{:stretchy => "false"} ]
                      %mtd
                        %mover
                          %mo →
                          %mo ≅
                      %mtd
                        %msub
                          %mi Prin
                          %mrow
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mtr
                      %mtd
                        %mo{:stretchy => "false"} [
                        %mi f
                        %mo{:stretchy => "false"} ]
                      %mtd
                        %mo ↦
                      %mtd
                        %msup
                          %mi f
                          %mo *
                        %mi E
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ≅
                        %msup
                          %mi f
                          %mo *
                        %msup
                          %mi S
                          %mn ∞
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{ccc}
                  [X,BU(1)]
                  \\cong
                  [X,\mathbb{C}P^\infty]
                  \&amp;\xrightarrow{\cong}&amp;
                  Prin_{U(1)}(X)
                  \\\
                  [f]
                  \&amp;\mapsto&amp;
                  f^*E U(1)
                  \\cong f^*S^\infty
                  \\end{array}
          %p
            (
            %a{:href => "#Mitchell11"}> Mitchell 2011, Theorem 7.4
            ).
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)
            is the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B U(1)
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},2)
            = succeed ")." do
              %a{:href => "#Hatcher01"} Hatcher 2001, Example 4.50.
            %a.existingWikiWord{:href => "/nlab/show/identity"} identity
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c_1\colon B U(1)\rightarrow K(\mathbb{Z},2)
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            and an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            (
            %a{:href => "#Hatcher"}> Hatcher 2017, Theorem 3.10.
            ).
            %a.existingWikiWord{:href => "/nlab/show/postcomposition"} Postcomposition
            then creates a
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/singular+cohomology"} singular cohomology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 1
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Prin
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi BU
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ≅
                  %msup
                    %mi H
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  c_1
                  \\colon
                  Prin_{U(1)}(X)
                  \\cong
                  [X,BU(1)]
                  \\xrightarrow{\cong}
                  [X,K(\mathbb{Z},2)]
                  \\cong
                  H^2(X,\mathbb{Z})
                  \\mathrlap{\,.}
          %p
            The infinite
            %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \mathbb{C}P^\infty
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/skeleton"} skeleton
            is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %msup
                    %mi P
                    %mi k
                %annotation{:encoding => "application/x-tex"} \mathbb{C}P^k
            with the largest natural
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} k\in\mathbb{N}
            fulfilling
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi k
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2k\leq n
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/cellular+approximation+theorem"} cellular approximation theorem
            (
            %a{:href => "#Hatcher01"}> Hatcher 2001, Theorem 4.8.
            ) states that every
            %a.existingWikiWord{:href => "/nlab/show/map"} map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi ℍ
                  %msup
                    %mi P
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} X \rightarrow \mathbb{H}P^\infty
            is
            %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopic
            to a cellular map, which in particular factorizes over the canonical inclusion
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mi k
                    %mo ↪
                    %mi ℂ
                    %msup
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^k\hookrightarrow\mathbb{C}P^\infty
            %a.existingWikiWord{:href => "/nlab/show/composition"} postcomposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi ℂ
                  %msup
                    %mi P
                    %mi k
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo ,
                  %mi ℂ
                  %msup
                    %mi P
                    %mn ∞
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [X,\mathbb{C}P^k]\rightarrow[X,\mathbb{C}P^\infty]
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/surjective"} surjective
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            having no more than three dimension, one has
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} k=1
            with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                    %msup
                      %mi P
                      %mn 1
                    %mo ≅
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1\cong S^2
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cohomotopy"} cohomotopy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Prin
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\pi^2(X) \rightarrow Prin_{U(1)}(X)
          %p
            Its composition with the first
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            is exactly the
            %a.existingWikiWord{:href => "/nlab/show/Hurewicz+homomorphism"} Hurewicz homomorphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi π
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi^2(X)\rightarrow H^2(X,\mathbb{Z})
          %h3#associated_vector_bundle Associated vector bundle
          %p
            For principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ↠
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P\twoheadrightarrow X
            %a.existingWikiWord{:href => "/nlab/show/associated+fiber+bundle"} associated
            %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo =
                  %mi P
                  %msub
                    %mo ×
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mi ℂ
                  %mo ↠
                  %mi X
                %annotation{:encoding => "application/x-tex"} L=P\times_{U(1)}\mathbb{C}\twoheadrightarrow X
            using the
            = succeed "." do
              %span.newWikiWord
                balanced product
                %a{:href => "/nlab/new/balanced+product"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            is the induced
            %a.existingWikiWord{:href => "/nlab/show/principal+SU%282%29-bundle"} principal SU(2)-bundle
            (using the canonical inclusion
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi z
                    %mo ↦
                    %mi diag
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo ,
                    %msup
                      %mi z
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)\hookrightarrow SU(2),z\mapsto diag(z,z^{-1})
            %a.existingWikiWord{:href => "/nlab/show/adjoint+bundle"} adjoint bundle
            is given by:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ad
                  %mo{:stretchy => "false"} (
                  %mi Q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msup
                    %mi L
                    %mn 2
                  %mo ⊕
                  %munder
                    %mi ℝ
                    %mo ̲
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Ad(Q)
                  \=L^2\oplus\underline{\mathbb{R}}.
          %p
            (
            %a{:href => "#donaldsonkronheimer91"}> Donaldson &amp; Kronheimer 91, Eq. (4.2.12)
            )
          %h2#examples Examples
          %ul
            %li
              %p
                The canonical projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mn 2
                          %mi n
                          %mo +
                          %mn 1
                      %mo ↠
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                    %annotation{:encoding => "application/x-tex"} S^{2n+1}\twoheadrightarrow\mathbb{C}P^n
                is a principal
                = succeed "-bundle." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n=1
                using
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                        %msup
                          %mi P
                          %mn 1
                        %mo ≅
                        %msup
                          %mi S
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1\cong S^2
                %a.existingWikiWord{:href => "/nlab/show/Hopf+fibration"} Hopf fibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 3
                      %mo ↠
                      %msup
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S^3\twoheadrightarrow S^2
                is a special case. In the general case, the classifying map is given by the canonical inclusion:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mi n
                      %mo ↪
                      %mi ℂ
                      %msup
                        %mi P
                        %mn ∞
                      %mo ≅
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{C}P^n
                      \\hookrightarrow
                      \\mathbb{C}P^\infty
                      \\cong
                      B U(1).
            %li
              %p
                One has
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi n
                            %mo +
                            %mn 1
                        %mo ≅
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S^{2n+1}\cong U(n+1)/U(n)
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 3
                        %mo ↠
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S^3\twoheadrightarrow U(2)
                %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
                are classified by:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 3
                      %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msub
                        %mi π
                        %mn 2
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %mn 1
                      %mpadded{:width => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                          %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\pi_3 B U(1)
                      \\cong
                      \\pi_2 U(1)
                      \\cong
                      1\mathrlap{\,.}
              %p
                (
                %a{:href => "#Mitchell11"}> Mitchell 2011, Corollary 11.2.
                )
          %p
            Hence the principal bundle is trivial, which fits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SU
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msup
                    %mi S
                    %mn 3
                %annotation{:encoding => "application/x-tex"} SU(2)\cong S^3
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
