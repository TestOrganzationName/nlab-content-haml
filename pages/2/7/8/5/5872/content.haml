          %h2#selected_writings Selected writings
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/equivariant+de+Rham+cohomology"} equivariant de Rham cohomology
          %ul
            %li#MathaiQuillen86
              %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"}> Varghese Mathai
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"} Daniel Quillen
              = succeed "," do
                %em Superconnections, Thom classes and equivariant differential forms
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/0040-9383(86)90007-8"} doi:10.1016/0040-9383(86)90007-8
          %p
            Early discussion of
            %a.existingWikiWord{:href => "/nlab/show/orbifold+K-theory"} orbifold K-theory
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/C-star+algebras"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
                \-algebras
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matilde+Marcolli"}> Matilde Marcolli
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                %em Twisted higher index theory on good orbifolds and fractional quantum numbers
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/9803051"}> arXiv:math/9803051
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matilde+Marcolli"}> Matilde Marcolli
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                = succeed "," do
                  %em Twisted index theory on good orbifolds, I: noncommutative Bloch theory
                %strong 1
                4 (1999) 553-587 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/9911102"}> arXiv:math/9911102v1
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/S0219199799000213"} doi:10.1142/S0219199799000213
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matilde+Marcolli"}> Matilde Marcolli
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                = succeed "," do
                  %em Twisted higher index theory on good orbifolds, II: fractional quantum numbers
                %strong 217
                1 (2001) 55-87 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/9911103"}> arXiv:math/9911103
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s002200000351"} doi:10.1007/s002200000351
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+T-duality"} topological T-duality
          %ul
            %li#BouwknegtEvslinMathai04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Bouwknegt"}> Peter Bouwknegt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jarah+Evslin"} Jarah Evslin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                = succeed "," do
                  %em T-Duality: Topology Change from H-flux
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0306062"} hep-th/0306062
            %li#BouwknegtHannabusMathai04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Bouwknegt"}> Peter Bouwknegt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Keith+Hannabus"} Keith Hannabus
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                = succeed "," do
                  %em T-duality for principal torus bundles
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0312284"} hep-th/0312284
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"}> Varghese Mathai
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
                %em T-Duality for Torus Bundles with H-Fluxes via Noncommutative Topology
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0401168"}> arXiv:hep-th/0401168
                )
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/fractional+quantum+Hall+effect"} fractional quantum Hall effect
            via
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Matilde+Marcolli"}> Matilde Marcolli
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
              = succeed "," do
                %em Towards the fractional quantum Hall effect: a noncommutative geometry perspective
              = succeed "," do
                %em Noncommutative Geometry and Number Theory
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/978-3-8348-0352-8_12"} doi:10.1007/978-3-8348-0352-8_12
              = succeed "]" do
                %a{:href => "https://arxiv.org/abs/cond-mat/0502356"} arXiv:cond-mat/0502356
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/analytic+torsion"} analytic torsion
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/twisted+de+Rham+cohomology"} twisted de Rham cohomology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"}> Varghese Mathai
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Siye+Wu"} Siye Wu
              = succeed "," do
                %em Analytic torsion for twisted de Rham complexes
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/0810.4204"} arXiv:0810.4204
          %p
            On
            = succeed "-deformation" do
              %a.existingWikiWord{:href => "/nlab/show/non-commutative+geometry"} non-commutative geometry
            %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
            as it appears on the
            %a.existingWikiWord{:href => "/nlab/show/M5-brane"} M5-brane
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
          %ul
            %li#MathaiSati14
              %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"}> Varghese Mathai
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed "," do
                %em Higher abelian gauge theory associated to gerbes on noncommutative deformed M5-branes and S-duality
              %strong 92
              (2015) 240-251 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1404.2257"}> arXiv:1404.2257
              \&amp;rbrack;
          %p
            On a twisted equivariant version of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Bismut-Chern+character"} Bismut-Chern character
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Fei+Han"}> Fei Han
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
              = succeed "," do
                %em Exotic twisted equivariant cohomology of loop spaces, twisted Bismut-Chern character and T-duality
              %strong 337
              (2015) 127-150 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1405.1320"}> arXiv:1405.1320
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s00220-014-2270-z"} doi:10.1007/s00220-014-2270-z
          %p reviewed in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"}> Varghese Mathai
              ,
              = succeed "," do
                %em T-duality for loop spaces, or equivalently for the 1D sigma model
              = succeed "," do
                %em
                  %a{:href => "/nlab/show/M-Theory+and+Mathematics#Mathai2023"} M-Theory and Mathematics 2023
              = succeed "&rbrack;" do
                %a{:href => "/nlab/show/M-Theory+and+Mathematics#Mathai2023"} web
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/K-theory+classification+of+topological+phases+of+matter"} K-theory classification of topological phases of matter
            %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
            between
            %a.existingWikiWord{:href => "/nlab/show/crystals"} crystals
            and their
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Brillouin+torus"} Brillouin torus
          %ul
