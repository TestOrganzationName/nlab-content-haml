                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{f_i : U_i \to U\}
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
