                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful functor
              %li
                %p
                  for every
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} covering family
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
