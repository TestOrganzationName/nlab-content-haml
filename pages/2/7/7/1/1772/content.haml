                %annotation{:encoding => "application/x-tex"} Hom_C(U,V)\subseteq Hom_{Set}(|U|,|V|)
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_C(*,-)
            is faithful.
          %p
            Then a concrete presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is given by a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi X
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |X|
            together with, for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} U\in C
            a
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi U
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |U|
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mo{:stretchy => "false"} |
                    %mi X
                    %msup
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi U
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} X(U)\subseteq |X|^{|U|}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi U
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} f:U\to V
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g\in X(V)
            implies
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi gf
                    %mo ∈
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} gf\in X(U)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} |
                    %mi X
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} X(*)=|X|
          %p
            This data defines a concrete presheaf
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo :
                    %msup
                      %mi C
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} X:C^{\op}\to Set
          %p
            To give a natural transformation between concrete presheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X\to Y
            is to give a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi X
                  %mo{:stretchy => "false"} |
                  %mo →
                  %mo{:stretchy => "false"} |
                  %mi Y
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} |X|\to |Y|
            that preserves the relations.
          #ConcSheafOnConcSite.un_def
            %h6#definition_4 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conc
                    %mo{:stretchy => "false"} (
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Conc(Sh(C)) \hookrightarrow Sh(C)
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              on concrete sheaves.
          %h3#in_a_local_topos In a local topos
          %p
            A more abstract perspective on the
            %a{:href => "#ConcSheafOnConcSite"} previous definition
            is obtained by noticing the following.
          .un_lemma
            %h6#lemma Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              on a
              %a.existingWikiWord{:href => "/nlab/show/concrete+site"} concrete site
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
          .proof
            %h6#proof Proof
            %p
              Taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} U=*
              in the second condition defining a concrete site implies that any
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              family of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              contains a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/split+epimorphism"} split epimorphism
              %a.existingWikiWord{:href => "/nlab/show/sieve"} sieve
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              is the maximal sieve consisting of all morphisms with
              %a.existingWikiWord{:href => "/nlab/show/target"} target
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+site"} local site
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
          %p
            In fact, we can formulate the definition of concrete sheaf inside any
            %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            over any base topos
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          .un_def
            %h6#definition_5 Definition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Disc
                    %mo ⊣
                    %mi Γ
                    %mo ⊣
                    %mi Codisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi E
                    %mover
                      %munder
                        %mo ←
                        %mi Codisc
                      %mover
                        %munder
                          %mo →
                          %mi Γ
                        %mover
                          %mo ←
                          %mi Disc
                    %mi S
                  %annotation{:encoding => "application/x-tex"} (Disc \dashv \Gamma \dashv Codisc) : E \stackrel{\stackrel{\overset{Disc}{\leftarrow}}{\underset{\Gamma}{\to}}}{\underset{Codisc}{\leftarrow}} S
            %p
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+geometric+morphism"} local geometric morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mover
                      %munder
                        %mo ↪
                        %mi Codisc
                      %mover
                        %mo ←
                        %mi Γ
                    %mi E
                  %annotation{:encoding => "application/x-tex"} S \stackrel{\overset{\Gamma}{\leftarrow}}{\underset{Codisc}{\hookrightarrow}} E
              is a
              %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
              the morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %msup
                      %mi Γ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi isos
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Mor
                    %mi E
                  %annotation{:encoding => "application/x-tex"} V = \Gamma^{-1}(isos(S)) \subset Mor E
              that are inverted by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              are the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/local+isomorphism"} local isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            %p
              The
              %strong concrete sheaves
              are the objects of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              that are the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/separated+objects"} separated objects
          .un_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo =
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi Γ
                        %mo =
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} E = Sh(C) \stackrel{\Gamma = Hom(*,-)}{\to} Set
              the
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              on a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/concrete+site"} concrete site
              = succeed "." do
                %a{:href => "#ConcSheafOnConcSite"} previous definition
          .proof
            %h6#proof_2 Proof
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is concrete, in the
              %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
              %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Disc
                      %mo ,
                      %mi Γ
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} (Disc,\Gamma)\colon Sh(C) \to Set
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is evaluation on the point:
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ↦
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X\mapsto X(*)
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Codisc
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Set
                      %mo →
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Codisc \colon Set\to Sh(C)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to the functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ↦
                      %msub
                        %mi Hom
                        %mi Set
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo ,
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U\mapsto Hom_{Set}(Hom_C(*,U),A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Codisc
                  %annotation{:encoding => "application/x-tex"} Codisc
              is
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} fully faithful
              and thus embeds
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              as a
              %a.existingWikiWord{:href => "/nlab/show/subtopos"} subtopos
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(C)
            %p
              We observe that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ⊣
                    %mi Codisc
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Set
                    %mo →
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma \dashv Codisc) : Set \to  Sh(C)
              is the
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh(C)
              at the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi Disc
                    %mi Γ
                    %mi U
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} |
                    %mi U
                    %mo ∈
                    %mi C
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{Disc \Gamma U \to U | U \in C\}
              of counits of the adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Disc
                    %mo ⊣
                    %mi Γ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Disc \dashv \Gamma)
              on representables: because if for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in Sh(C)
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Hom
                              %mrow
                                %mi Sh
                                %mo{:stretchy => "false"} (
                                %mi C
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi Disc
                            %mi Γ
                            %mi U
                            %mo →
                            %mi U
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo →
                            %msub
                              %mi Hom
                              %mi Set
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi Γ
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo →
                            %msub
                              %mi Hom
                              %mi Set
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Hom
                              %mi C
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo ,
                            %mi U
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} (
                            %mo *
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Hom_{Sh(C)}(Disc \Gamma U \to U, X)
                    \&amp; = (X(U) \to Hom_{Set}(\Gamma(U), \Gamma(X)))
                    \\\
                    \&amp; = (X(U) \to Hom_{Set}(Hom_C(*,U)), X(*))
                    \\end{aligned}
            %p
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi Codisc
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X = Codisc(X(*))
            %p
              On the other hand, comparison with the
              %a{:href => "#ConcSheafOnConcSite"} previous definition
              shows that this is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a concrete sheaf. But this is also the definition of a separated object.
          %p
            So the concrete sheaves on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            are precisely the
            %a.existingWikiWord{:href => "/nlab/show/separated+presheaf"} separated objects
            for this
            %a.existingWikiWord{:href => "/nlab/show/Lawvere-Tierney+topology"} Lawvere-Tierney topology
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Sh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh(C)
            that corresponds to the subtopos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Codisc
                    %mo :
                    %mi Set
                    %mo ↪
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Codisc : Set \hookrightarrow Sh(C)
          %h2#properties Properties
          %h3#general General
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo :
                  %mi E
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} \Gamma : E \to S
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
            %a.existingWikiWord{:href => "/nlab/show/separated+presheaves"} separated presheaves
            it follows immediately that
          .un_prop
            %h6#proposition_2 Proposition
            %p
              The category of concrete sheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Conc
                      %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Conc_\Gamma(E)
              forms a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mover
                      %munder
                        %mo ↪
                        %mi Codisc
                      %mover
                        %mo ←
                        %mi Γ
                    %msub
                      %mi Conc
                      %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mover
                        %mo ←
                        %mi Conc
                    %mi E
                  %annotation{:encoding => "application/x-tex"}
                    S
                    \\stackrel{\overset{\Gamma}{\leftarrow}}{\underset{Codisc}{\hookrightarrow}}
                    Conc_\Gamma(E)
                    \\stackrel{\overset{Conc}{\leftarrow}}{\hookrightarrow}
                    E
            %p
              which is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasitopos"} quasitopos
            %p
              The left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conc
                  %annotation{:encoding => "application/x-tex"} Conc
              is
              %strong concretization
              which sends a sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              sheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conc
                    %mi X
                    %mo :
                    %mi U
                    %mo ↦
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Hom
                      %mi Set
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Conc X : U \mapsto Im(X(U) \to Hom_{Set}(Hom_C(*,U), X(*)))
                    \\,.
          %h3#SliceOverConcreteObject Slice topos over a concrete object
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Disc
                  %mo ⊣
                  %mi Γ
                  %mo ⊣
                  %mi coDisc
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ℰ
                  %mo →
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} (Disc \dashv \Gamma \dashv coDisc) :  \mathcal{E} \to \mathcal{S}
            be a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            that is a
            %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
            be a concrete object, equivalently an object such that the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ⊣
                    %mi coDisc
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\Gamma \dashv coDisc)
            %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} counit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mi coDisc
                  %mi Γ
                  %mi U
                %annotation{:encoding => "application/x-tex"} X \to coDisc \Gamma U
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
          %p
            We discuss properties of the
            %a.existingWikiWord{:href => "/nlab/show/over-topos"} over-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}/X
          %p Notice that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mn 0
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo ⊣
                  %mi coDisc
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi 𝒮
                  %mover
                    %munder
                      %mo →
                      %mi coDisc
                    %mover
                      %mo ←
                      %mi Γ
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"}
                  e_0 \coloneqq (\Gamma \dashv coDisc) : \mathcal{S} \stackrel{\overset{\Gamma}{\leftarrow}}{\underset{coDisc}{\to}} \mathcal{E}
          %p
            is the canonical
            %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} topos point
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          .un_prop
            %h6#observation Observation
            %p
              For every
              %a.existingWikiWord{:href => "/nlab/show/global+element"} global element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ∈
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (x \in \Gamma(X)) : * \to X
              (for every
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
              %a.existingWikiWord{:href => "/nlab/show/point+of+a+topos"} topos point
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 0
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒮
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi x
                            %mo *
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi x
                            %mo *
                    %mi 𝒮
                    %mo{:stretchy => "false"} /
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %mi coDisc
                          %mo{:stretchy => "false"} /
                          %mi X
                      %mover
                        %mo ←
                        %mrow
                          %mi Γ
                          %mo{:stretchy => "false"} /
                          %mi X
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (e_0,x)
                    \:
                    \\mathcal{S}
                    \\stackrel{\overset{x^*}{\leftarrow}}{\underset{x_*}{\to}}
                    \\mathcal{S}/\Gamma(X)
                    \\stackrel{\overset{\Gamma/X}{\leftarrow}}{\underset{coDisc/X}{\to}}
                    \\mathcal{E}/X
                    \\,.
          %p
            This is discussed in detail at
            = succeed "." do
              %a{:href => "http://ncatlab.org/nlab/show/over-topos#Points"} over-topos – points
          .un_prop
            %h6#observation_2 Observation
            %p
              %strong (relative concretization)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{E}
              be concrete. Then the image under the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi coDisc
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo ∘
                      %mi Γ
                      %mo{:stretchy => "false"} /
                      %mi X
                    %annotation{:encoding => "application/x-tex"} coDisc/X \circ \Gamma/X
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
              of any object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (A \to X) \in \mathcal{E}/X
              is an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\tilde A \to X)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde A
              being concrete.
            %p
              This
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde A
              is the finest concrete sheaf structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Gamma A
              that extends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mi A
                    %mo →
                    %mi Γ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Gamma A \to \Gamma X
              to a morphism of concrete sheaves.
          .proof
            %h6#proof_3 Proof
            %p
              By definition of the
              %a{:href => "http://ncatlab.org/nlab/show/adjoint+(infinity%2C1)-functor#OnSlices"} slice geometric morphism
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo ∘
                    %mi Γ
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mover
                      %mo →
                      %mi f
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} coDisc/X \circ \Gamma/X (A \stackrel{f}{\to} X)
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \tilde A \to X
              in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ˜
                          %mtd
                            %mo →
                          %mtd
                            %mi coDisc
                            %mi Γ
                            %mi A
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi coDisc
                                  %mi Γ
                                  %mi A
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi coDisc
                            %mi Γ
                            %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\tilde A &amp;\to &amp; coDisc \Gamma A
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{coDisc \Gamma A}}
                    \\\
                    X &amp;\to&amp; coDisc \Gamma X
                    }
                    \\,,
            %p
              where the bottom morphism is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ⊣
                      %mi coDisc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma \dashv coDisc)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              by assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi coDisc
                    %mi Γ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \tilde A\to coDisc \Gamma A
              is a monomorphism. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                  %annotation{:encoding => "application/x-tex"} coDisc
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              by assumption on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              it follows that the
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi Γ
                    %mi coDisc
                    %mi Γ
                    %mi A
                    %mover
                      %mo →
                      %mo ≃
                    %mi Γ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Gamma \tilde A \to \Gamma coDisc\Gamma A \stackrel{\simeq}{\to} \Gamma A
              is a monomorphism, as is its image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mi Γ
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %mi coDisc
                    %mi Γ
                    %mi A
                  %annotation{:encoding => "application/x-tex"} coDisc \Gamma \tilde A\to coDisc \Gamma A
              under the
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi coDisc
                    %annotation{:encoding => "application/x-tex"} coDisc
            %p
              Then by the
              %a{:href => "http://ncatlab.org/nlab/show/adjoint%20functor#UniversalArrows"} universal property of the unit
              we have a commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi coDisc
                            %mi Γ
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mover
                              %mi A
                              %mo{:stretchy => "false"} ˜
                          %mtd
                            %mo →
                          %mtd
                            %mi coDisc
                            %mi Γ
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; coDisc \Gamma \tilde A
                    \\\
                    \&amp; \nearrow &amp; \downarrow
                    \\\
                    \\tilde A &amp;\to&amp; coDisc \Gamma A
                    }
                    \\,,
            %p
              where the bottom and the right morphisms are
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              = succeed "-unit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ⊣
                      %mi coDisc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma \dashv coDisc)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde A
              is concrete.
          %h2#examples Examples
          %ul
            %li
              %p
                The concrete sheaves on the
                %a.existingWikiWord{:href => "/nlab/show/concrete+site"} concrete site
                %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
                are the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/diffeological+spaces"} diffeological spaces
            %li
              %p
                The category of
                %a.existingWikiWord{:href => "/nlab/show/quasi-Borel+space"} quasi-Borel spaces
                is the category of concrete sheaves on the category of standard Borel spaces considered with the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/extensive+category#Superextensive+sites"} extensive coverage
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/quasi-topological+spaces"} quasi-topological spaces
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/plot"} plot
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/concrete+%28%E2%88%9E%2C1%29-sheaf"} concrete (∞,1)-sheaf
          %h2#references References
          %p The notion of quasitoposes of concrete sheaves goes back to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"}> Eduardo Dubuc
              ,
              = succeed "," do
                %em Concrete quasitopoi
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BFb0061821"} doi:10.1007/BFb0061821
          %p and is further developed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"}> Eduardo Dubuc
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Luis+Espanol"} Luis Espanol
              %em Quasitopoi over a base category
              (
              %a{:href => "http://arxiv.org/abs/math.CT/0612727"}> arXiv:math.CT/0612727
              ) .
          %p
            A review of categories of concrete sheaves, with special attention to sheaves on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/diffeological+space"} diffeological space
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/John+Baez"}> John Baez
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alex+Hoffnung"} Alex Hoffnung
              = succeed "," do
                %em Convenient Categories of Smooth Spaces
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0807.1704"} arXiv
          %p
            The characterization of concrete sheaves in terms of the extra right adjoint of a
            %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
            originated in
            %a{:href => "http://nforum.ncatlab.org/comments.php?DiscussionID=1955"} discussion
            with
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/David+Carchedi"} David Carchedi
          %p
            Concrete sheaves over trivial sites are called
            %em extensional presheaves
            in the following references.
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Rosolini"}> Giuseppe Rosolini
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Streicher"} Thomas Streicher
                = succeed "," do
                  %a{:href => "https://www.researchgate.net/publication/220366978_Comparing_models_of_higher_type_computation"} Comparing models of higher type computation
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Ehrhard"}> Thomas Ehrhard
                ,
                = succeed "," do
                  %a{:href => "https://www.researchgate.net/publication/29650819_On_finiteness_spaces_and_extensional_presheaves_over_the_Lawvere_theory_of_polynomials"} On finiteness spaces and extensional presheaves over the Lawvere theory of polynomials
