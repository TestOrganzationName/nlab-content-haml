                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Hom_{Conc(Sh(C))}(1,-):Conc(Sh(C))\to Set
          %p
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/faithful+functor"} faithful
