          %h2#idea Idea
          %h3#DihedralGroups Dihedral groups
          %p
            The dihedral group,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} D_{2n}
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            of
            %a.existingWikiWord{:href => "/nlab/show/order+of+a+group"} order
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2n
            %a.existingWikiWord{:href => "/nlab/show/symmetry+group"} symmetry group
            of a regular
            = succeed "-gon" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/plane"} plane
          %p
            For instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi D
                    %mn 6
                %annotation{:encoding => "application/x-tex"} D_6
            is the
            %a.existingWikiWord{:href => "/nlab/show/symmetry+group"} symmetry group
            of the equilateral
            %a.existingWikiWord{:href => "/nlab/show/triangle"} triangle
            and is
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            to the
            = succeed "," do
