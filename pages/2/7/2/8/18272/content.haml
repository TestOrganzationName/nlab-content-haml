                    \&amp;{}^{{}_{(pb)}}&amp;
                    \\big\downarrow\mathrlap{{}^{\phi}}
                    \\\
                    C'
                    \&amp;\underset{\alpha}{\longrightarrow}&amp;
                    C
                    }
            %p
              then consecutively forming (pre)images along these maps satisfies a
              %em
                %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"} Beck-Chevalley condition
              in that the following
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              of
              = succeed "-" do
