                    %mi y
                    %mo ∈
                    %mi Y
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∃
                      %mrow
                        %mi x
                        %mo :
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi S
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} f(S) = \{y \in Y: (\exists_{x: f(x) = y})\; x \in S\}
              by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∃
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exists_f(S)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi f
                    %mo :
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exists_f: P(X) \to P(Y)
              between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/power+sets"} power sets
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to the taking of
              %a.existingWikiWord{:href => "/nlab/show/inverse+images"} inverse images
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ↦
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T \mapsto f^{-1}(T)
              as an operator
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^{-1}: P(Y) \to P(X)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                      %mo :
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^\ast: P(Y) \to P(X)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∃
                        %mi f
                      %mo ⊣
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \exists_f \dashv f^\ast
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Lawvere"} Lawvere
              = succeed ")." do
                %a.maruku-ref{:href => "#MoreJargon"}
          %p As for direct images and intersections, we have
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi S
                      %mi i
                    %mo )
                  %mo ⊆
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f\left(\bigcap_{i \in I} S_i\right) \subseteq \bigcap_{i \in I} f(S_i)
          %p
            because this is equivalent to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∀
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi f
                    %mrow
                      %mo (
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi S
                        %mi i
                      %mo )
                    %mo ⊆
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\forall_{i \in I})\; f\left(\bigcap_{i \in I} S_i\right) \subseteq f(S_i)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi S
                      %mi i
                    %mo ⊆
                    %msub
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \bigcap_{i \in I} S_i \subseteq S_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(A) \subseteq f(B)
            if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \subseteq B
          %p
            This inclusion is not usually an equality. For example, in the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+space"} cartesian space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            with
            = succeed "-coordinates," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x y
            %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi x
                %annotation{:encoding => "application/x-tex"} (x, y) \mapsto x
            does not preserve the intersection of the lines
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} y = 1
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} y = 2
          %p
            However, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X \to Y
            is injective, then the direct image operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ↦
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S \mapsto f(S)
            %em does
            preserve intersections of subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} (S_i)_{i \in I}
            indexed over
            %em nonempty
            sets
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
          %ul
            %li
              %p
                For any map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f: X \to Y
                (not necessarily injective) and any subset
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo ⊆
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} T \subseteq Y
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ∩
                        %mi T
                        %mo =
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f(X) \cap T = f(f^{-1}(T))
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is injective, then for any subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊆
                      %mi X
                    %annotation{:encoding => "application/x-tex"} S \subseteq X
                we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo =
                        %msup
                          %mi f
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} S = f^{-1}(f(S))
          %p
            For then, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo =
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi S
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T = \bigcap_{i \in I} f(S_i)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is inhabited, we have for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ⊆
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T \subseteq f(S_i) \subseteq f(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi T
                          %mo =
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ∩
                          %mi T
                        %mtd
                          %mo =
                        %mtd
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi f
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi f
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                            %mi i
                          %mi f
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi S
                            %mi i
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi f
                          %mrow
                            %mo (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msup
                              %mi f
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi S
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi f
                          %mrow
                            %mo (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msub
                              %mi S
                              %mi i
                            %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  T = f(X) \cap T &amp; = &amp; f(f^{-1}(T)) \\
                  \&amp; = &amp; f(f^{-1}(\bigcap_i f(S_i))) \\
                  \&amp; = &amp; f\left(\bigcap_{i \in I} f^{-1}(f(S_i))\right) \\
                  \&amp; = &amp; f\left(\bigcap_{i \in I} S_i\right)
                  }
          %p which was to be shown.
          %h3#inverse_images_preserve_unions_codirect_images_preserve_intersections Inverse images preserve unions, codirect images preserve intersections
          %p
            As for the statement that inverse images of unions are unions of inverse images, it turns out this follows from a second fundamental logical adjunction. For a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X \to Y
            and a subset
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subseteq X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∀
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo ∈
                  %mi Y
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∀
                    %mrow
                      %mi x
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mo ∈
                  %mi U
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \forall_f(U) = \{y \in Y: (\forall_{x: f(x) = y})\; x \in U\}
          %p
            which is analogous to the formula
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∃
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo ∈
                  %mi Y
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∃
                    %mrow
                      %mi x
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mo ∈
                  %mi S
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \exists_f(S) = f(S) = \{y \in Y: (\exists_{x: f(x) = y})\; x \in S\}
            in Remark
            = succeed "." do
              %a.maruku-ref{:href => "#Lawvere"}
            %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
            where the
            %a.existingWikiWord{:href => "/nlab/show/negation"} negation
            operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg
            on power sets means complementation, we have
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∀
                      %mi f
                    %mo =
                    %mo ¬
                    %msub
                      %mo ∃
                      %mi f
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \forall_f = \neg \exists_f \neg
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo ⊆
                  %mi U
                  %mspace{:width => "2em"}
                  %mi iff
                  %mspace{:width => "2em"}
                  %mi T
                  %mo ⊆
                  %msub
                    %mo ∀
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^{-1}(T) \subseteq U \qquad iff \qquad T \subseteq \forall_f (U)
          %p
            The same adjointness proof as used to prove property 1., then shows that the left adjoint part which here is the inverse image operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo =
                  %msup
                    %mi f
                    %mo *
                  %mo :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^{-1} = f^\ast: P(Y) \to P(X)
            preserves unions, and that right adjoint part which here is the “codirect image” operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
