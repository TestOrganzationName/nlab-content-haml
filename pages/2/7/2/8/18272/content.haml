          .num_remark
            %h6#remark Remark
            %p
              The “reasoning forward/backward trick” may be summarized by saying that in a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A = B
              iff (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi A
                    %mo ≤
                    %mi T
                    %mo ⇔
                    %mi B
                    %mo ≤
                    %mi T
                  %annotation{:encoding => "application/x-tex"} A \leq T \Leftrightarrow B \leq T
              ), or dually that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A = B
              iff (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi S
                    %mo ≤
                    %mi A
                    %mo ⇔
                    %mi S
                    %mo ≤
                    %mi B
                  %annotation{:encoding => "application/x-tex"} S \leq A \Leftrightarrow S \leq B
              ). This trick is vastly extrapolated by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
          #Lawvere.num_remark
            %h6#remark_2 Remark
            %p
              People who work with categorial forms of logic denote direct images
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(S)
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∃
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \exists_f(S)
              %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} existential quantification
              as corresponding to taking of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              of pairs
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
