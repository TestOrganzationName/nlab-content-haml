            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %mi T
                    %mspace{:width => "2em"}
                    %mi iff
                    %mspace{:width => "2em"}
                    %mi S
