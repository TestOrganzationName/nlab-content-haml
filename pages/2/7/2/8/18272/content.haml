              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commutes
            #eq:RightBeckChevalleyDiagramForPreImages.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
