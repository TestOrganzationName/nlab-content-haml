                      %mspace{:width => "thinmathspace"}
                      %mi 𝒫
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi 𝒫
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^\ast \,\coloneqq\, f^{-1} \,\colon\, \mathcal{P}(T) \longrightarrow \mathcal{P}(S)
              %p
                forms
                %a.existingWikiWord{:href => "/nlab/show/preimages"} preimages
                under
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo ≔
                      %mspace{:width => "thinmathspace"}
                      %mi T
                      %mo ∖
                      %mi f
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi S
                      %mo ∖
