                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi 𝒫
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_\ast \,\coloneqq\, T \setminus f\big(S \setminus (-)\big) \,\colon\, \mathcal{P}(S) \longrightarrow \mathcal{P}(T)
              %p
                forms the
                %a.existingWikiWord{:href => "/nlab/show/complement"} complement
                of
                %a.existingWikiWord{:href => "/nlab/show/images"} images
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/complements"} complements
          %p
            As discussed above, these three functors constitute an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⊣
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi f
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo ⊣
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"}
                  f(-) \;\dashv\; f^{-1} \;\dashv\; f_\ast
          %p
            In particular, the familiar/evident fact that forming
            %a.existingWikiWord{:href => "/nlab/show/images"} images
            and
            %a.existingWikiWord{:href => "/nlab/show/preimages"} preimages
            %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
            %a.existingWikiWord{:href => "/nlab/show/unions"} unions
            may be understood as a special case of the fact that
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/left+adjoints+preserve+colimits"} left adjoints preserve colimits
          %p
          #BeckChevalleyForPreImages.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"} Beck-Chevalley condition
                for pre-/images)
              %br/
              Given a
              %a.existingWikiWord{:href => "/nlab/show/pullback+diagram"} pullback diagram
              in
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            #eq:PullbackOfSets.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
