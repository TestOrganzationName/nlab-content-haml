                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  S \subseteq \bigcap_{i \in I} f^{-1}(T_i) &amp; iff &amp; (\forall_{i \in I})\; S \subseteq f^{-1}(T_i) \\
