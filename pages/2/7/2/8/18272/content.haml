              are the
              %a.existingWikiWord{:href => "/nlab/show/%28-1%29-truncated+objects"} (-1)-truncated objects
              in the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi S
                  %annotation{:encoding => "application/x-tex"} Set_{/S}
              of
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow Y
              induces a
              %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Set
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi X
                    %munderover
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
