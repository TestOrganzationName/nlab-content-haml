                      %annotation{:encoding => "application/x-tex"} d \theta_i = \omega|_{U_i}
                  on all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mi i
                        %annotation{:encoding => "application/x-tex"} U_i
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi θ
                          %mi j
                        %mo =
                        %msub
                          %mi θ
                          %mi i
                        %mo +
                        %mi d
                        %mi log
                        %msub
                          %mi g
                          %mi ij
                      %annotation{:encoding => "application/x-tex"} \theta_j = \theta_i + d log g_{ij}
                  on all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mrow
                              %mi i
                              %mi j
                        %annotation{:encoding => "application/x-tex"} U_{i j}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %msub
                          %mi g
                          %mrow
                            %mi j
                            %mi k
                        %mo =
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi k
                      %annotation{:encoding => "application/x-tex"} g_{i j} g_{j k} = g_{i k}
                  on all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi U
                            %mrow
                              %mi i
                              %mi j
                              %mi k
                        %annotation{:encoding => "application/x-tex"} U_{i j k}
            %p
              The
              %em quantomorphism Lie algebra
              of this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔔𝔲𝔞𝔫𝔱𝔐𝔬𝔯𝔭𝔥
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %msub
                      %mi θ
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi α
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi ℒ
                        %mi v
                      %mi log
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mo =
                      %msub
                        %mi α
                        %mi j
                      %mo −
                      %msub
                        %mi α
                        %mi i
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %msub
                        %mi ℒ
                        %mi v
                      %msub
                        %mi θ
                        %mi i
                      %mo =
                      %mi d
                      %msub
                        %mi α
                        %mi i
                      %mo }
                    %mo ⊂
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                        %mi i
                      %msup
                        %mi C
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{QuantMorph}(X,\{U_i\},\{g_{i j}, \theta_i\})
                    \=
                    \\left\{
                    (v, \{\alpha_i\})
                    |
                    \\mathcal{L}_v log g_{i j} = \alpha_j - \alpha_i
                    \\,,
                    \\mathcal{L}_v \theta_i = d \alpha_i
                    \\right\}
                    \\subset
                    Vect(X) \oplus \left(\underset{i}{\bigoplus} C^\infty(U_i)\right)
            %p with bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo −
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [(v_1, \{(\alpha_1)_i\}), (v_2, \{(\alpha_2)_i\})]
                    \\coloneqq
                    ([v_1,v_2], \{\mathcal{L}_{v_1}(\alpha_2)_i - \mathcal{L}_{v_2} (\alpha_1)_i\})
                    \\,.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              a
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} presymplectic manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
