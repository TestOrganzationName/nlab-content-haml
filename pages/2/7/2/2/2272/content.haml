                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \{\theta_i \in \Omega^1(U_i)\}
              %li
                %p
                  smooth function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo ∈
                        %msup
                          %mi C
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi U
                          %mrow
                            %mi i
                            %mi j
                        %mo ,
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{g_{i j} \in C^\infty(U_{i j}, U(1))\}
            %p such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
