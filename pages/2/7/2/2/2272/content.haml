              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} presymplectic manifold
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
              %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"} Deligne
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %msub
                      %mi θ
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\{U_i\},\{g_{i j}, \theta_i\})
              for a
              %em
                %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              is
            %ol
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo →
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} }
