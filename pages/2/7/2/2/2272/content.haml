          %h2#idea Idea
          %p
            Poisson manifolds are a mathematical setup for
            %a.existingWikiWord{:href => "/nlab/show/classical+mechanics"} classical mechanics
            with finitely many degrees of freedom.
          %h2#definition Definition
          %p
            A
            %strong
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
            is a commutative unital
            %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo ,
                  %mo{:stretchy => "false"} }
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo ⊗
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \{,\} \colon A\otimes A\to A
            such that, for any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f\in A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi f
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} }
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \{ f,-\} \colon A\to A
            is a
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as an associative algebra.
          %p
            A
            %strong Poisson manifold
            is a real
            %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            equipped with a
            = succeed "." do
              %strong Poisson structure
            %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
