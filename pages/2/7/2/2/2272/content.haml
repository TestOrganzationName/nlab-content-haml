          #CechDelignePrequantizationAnditsInfinitesimalAutomorpisms.num_defn
            %h6#definition_5 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
