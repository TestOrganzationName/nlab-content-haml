              of Hamiltonian vector fields among all
              %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
          .num_remark
            %h6#remark Remark
            %p
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is symplectic then, evidently, there is a unique Hamiltonian vector field, def.
              = succeed "," do
                %a.maruku-ref{:href => "#HamiltonianVectorField"}
              %a.existingWikiWord{:href => "/nlab/show/prequantum+geometry"} prequantum geometry
              is concerned, this is all that the non-degeneracy condition that makes a closed 2-form be symplectic is for. But we will see that the definitions of
              %a.existingWikiWord{:href => "/nlab/show/Poisson+brackets"} Poisson brackets
              and of
              %a.existingWikiWord{:href => "/nlab/show/quantomorphism+groups"} quantomorphism groups
              directly generalize also to the presymplectic situation, simply by considering not just Hamiltonian functions but pairs of a Hamiltonian vector field and a compatible Hamiltonian.
          #PoissonBracket.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} presymplectic manifold
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ham
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi HamVect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ham(X,\omega) \hookrightarrow HamVect(X,\omega) \oplus C^\infty(X)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/linear+subspace"} linear subspace
              of the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
              = succeed "," do
                %a.maruku-ref{:href => "#HamiltonianVectorField"}
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              on those pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v,H)
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is a
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ham
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ,
                      %mi H
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi ι
                        %mi v
                      %mi ω
                      %mo +
                      %mi d
                      %mi H
                      %mo =
                      %mn 0
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ham(X,\omega)
                    \\coloneqq
                    \\left\{
                    (v,H) | \iota_v \omega + d H  = 0
                    \\right\}
                    \\,.
            %p
              Define a
              %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ham
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi Ham
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ham
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [-,-] \;\colon\;
                    Ham(X,\omega) \otimes Ham(X,\omega)
                    \\longrightarrow
                    Ham(X,\omega)
            %p by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %msub
                      %mi H
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    [(v_1,H_1), (v_2,H_2)] \coloneqq ([v_1,v_2], \iota_{v_2}\iota_{v_1} \omega)
                    \\,,
            %p
              called the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [v_1,v_2]
              is the standard Lie bracket on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/vector+fields"} vector fields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi Ham
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{Pois}(X,\omega)
                    \\coloneqq
                    (Ham(X,\omega),[-,-])
            %p
              for the resulting
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is symplectic, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ham
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ham(X,\omega) \simeq C^\infty(X)
              and hence in this case
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{Pois}(X,\omega)
                    \\simeq
                    (C^\infty(X),[-,-])
                    \\,.
          #HeisenbergAlgebraOfSymplecticVectorSpace.num_example
            %h6#example_6 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} X = \mathbb{R}^{2n}
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %mi d
                    %msub
                      %mi p
                      %mi i
                    %mo ∧
                    %mi d
                    %msup
                      %mi q
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \omega = \sum_{i = 1}^n d p_i \wedge d q^i
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi q
                      %mi i
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{q^i\}_{i = 1}^n
              the
              %a.existingWikiWord{:href => "/nlab/show/canonical+coordinates"} canonical coordinates
              on one copy of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi p
                      %mi i
                    %msubsup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{p_i\}_{i = 1}^n
              that on the other (“
              %a.existingWikiWord{:href => "/nlab/show/canonical+momenta"}> canonical momenta
              ”). Hence let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              be a
              %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+space"} symplectic vector space
              of dimension
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 2n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+manifold"} symplectic manifold
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Vect(X)
              is
              %a.existingWikiWord{:href => "/nlab/show/linear+span"} spanned
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\infty(X)
              by the canonical bases vector fields
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mo ∂
                        %mrow
                          %msup
                            %mi q
                            %mi i
                      %mo ,
                      %msub
                        %mo ∂
                        %mrow
                          %msup
                            %mi p
                            %mi i
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{\partial_{q^i}, \partial_{p^i}\}
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
              via
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mrow
                            %msup
                              %mi q
                              %mi i
                    %mi ω
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi d
                    %msub
                      %mi p
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{\partial_{q^i}} \omega = - d p_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mrow
                            %msub
                              %mi p
                              %mi i
                    %mi ω
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mi d
                    %msup
                      %mi q
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{\partial_{p_i}} \omega = + d q^i
                    \\,.
            %p
              Moreover, since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi i
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{i} \in C^\infty(X)
              for the unit constant function, then the nontrivial Poisson brackets between the basis vector fields are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi q
                      %mi i
                    %mo ,
                    %msub
                      %mi p
                      %mi j
                    %mo{:stretchy => "false"} ]
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi p
                          %mi i
                    %mo ,
                    %msup
                      %mi q
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mrow
                        %msup
                          %mi q
                          %mi j
                    %mo ,
                    %msub
                      %mi p
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mi δ
                      %mi j
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mi δ
                      %mi j
                      %mi i
                    %mstyle{:mathvariant => "bold"}
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [q^i, p_j]
                    \\coloneqq
                    [(-\partial_{p_i}, q^i), (\partial_{q^j}, p_j)]
                    \=
                    \-
                    \\delta_j^i
                    (0, \mathbf{i})
                    \=
                    \-
                    \\delta_j^i
                    \\mathbf{i}
                    \\,.
            %p
              This is called the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Heisenberg+algebra"} Heisenberg algebra
            %p
              More generally, the
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
              corresponding to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quadratic+Hamiltonians"} quadratic Hamiltonians
              %a.existingWikiWord{:href => "/nlab/show/polynomials"} polynomials
              in the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msup
                      %mi q
                      %mi i
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{q^i\}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi p
                        %mi i
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{p_i\}
              %a.existingWikiWord{:href => "/nlab/show/affine+symplectic+group"} affine symplectic group
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi ω
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,\omega)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/extended+affine+symplectic+group"} extended affine symplectic group
          %p
            Example
            %a.maruku-ref{:href => "#HeisenbergAlgebraOfSymplecticVectorSpace"}
            serves to motivate a more conceptual origin of the definition of the Poisson bracket in def.
            = succeed "." do
              %a.maruku-ref{:href => "#PoissonBracket"}
          .num_example
            %h6#example_7 Example
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ≔
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 1
                      %mi n
                    %msub
                      %mi p
                      %mi i
                    %mi d
                    %msub
                      %mi q
                      %mi i
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \coloneqq \sum_{i = 1}^n p_i d q_i \in \Omega^1(\mathbb{R}^{2n})
            %p
              for the canonical choice of
              %a.existingWikiWord{:href => "/nlab/show/differential+1-form"} differential 1-form
              satisfying
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi θ
                    %mo =
                    %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d \theta = \omega
                    \\,.
            %p
              If we regard
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo ≃
                    %msup
                      %mi T
                      %mo *
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n} \simeq T^\ast \mathbb{R}^n
              as the
              %a.existingWikiWord{:href => "/nlab/show/cotangent+bundle"} cotangent bundle
              of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Liouville-Poincar%C3%A9+1-form"} Liouville-Poincaré 1-form
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{2n}
              is
              %a.existingWikiWord{:href => "/nlab/show/contractible+topological+space"} contractible
              as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/circle+bundle"} circle bundle
              over it is necessarily trivial, and hence any choice of 1-form such as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              may canonically be thought of as being a
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
              on the trivial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+U%281%29-bundle"} principal U(1)-bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              is a
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mn 2
                          %mi n
                      %mo ,
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mi n
                      %mi d
                      %msub
                        %mi p
                        %mi i
                      %mo ∧
                      %mi d
                      %msup
                        %mi q
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{R}^{2n}, \sum_{i=1}^n d p_i \wedge d q^i)
            %p
              Being thus a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/circle+bundle+with+connection"} circle bundle with connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              has more symmetry than its
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              has: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 2
                        %mi n
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in C^\infty(\mathbb{R}^{2n}, U(1))
              any smooth function, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ↦
                    %mi θ
                    %mo +
                    %mi d
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\theta \mapsto \theta + d\alpha
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi θ
                    %annotation{:encoding => "application/x-tex"} \theta
              %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
            %p
              Hence while a
              %a.existingWikiWord{:href => "/nlab/show/vector+field"} vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is said to preserve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              (is a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/symplectic+vector+field"} symplectic vector field
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              vanishes
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi v
                    %mi ω
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_v \omega = 0
            %p
              in the presence of a choice for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                  %annotation{:encoding => "application/x-tex"} \theta
              the right condition to ask for is that there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi v
                    %mi θ
                    %mo =
                    %mi d
                    %mi α
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_v \theta = d \alpha
                    \\,.
          %p
            For more on this see also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/prequantized+Lagrangian+correspondence"} prequantized Lagrangian correspondence
          %p Notice then the following basic but important fact.
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              a
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} presymplectic manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta \in \Omega^1(X)
              a 1-form such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi θ
                    %mo =
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} d \theta = \omega
              then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v,\alpha) \in Vect(X)\oplus C^\infty(X)
              the condition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mi v
                    %mi θ
                    %mo =
                    %mi d
                    %mi α
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_v \theta = d \alpha
            %p
              is equivalent to the condition that makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ≔
                    %msub
                      %mi ι
                      %mi v
                    %mi θ
                    %mo −
                    %mi α
                  %annotation{:encoding => "application/x-tex"} H \coloneqq \iota_v \theta - \alpha
              a
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian"} Hamiltonian
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              according to def.
              = succeed ":" do
                %a.maruku-ref{:href => "#HamiltonianVectorField"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi v
                    %mi ω
                    %mo +
                    %mi d
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mi v
                    %mi θ
                    %mo −
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_v \omega + d (\iota_v \theta - \alpha  ) = 0
                    \\,.
            %p
              Moreover, the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
              = succeed "," do
                %a.maruku-ref{:href => "#PoissonBracket"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mi i
                    %mo ,
                    %msub
                      %mi α
                      %mi i
                    %mo −
                    %msub
                      %mi ι
                      %mi v
                    %mi θ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (v_i, \alpha_i -\iota_v \theta)
              is equivalently given by the skew-symmetric
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              of the corresponding vector fields on the
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \alpha_i
            #eq:EquationForLieHomomorphism.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} ]
                    %mi θ
                    %mo −
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %mi ω
                    %mo =
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %msub
                      %mi α
                      %mn 2
                    %mo −
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %msub
                      %mi α
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{[v_1,v_2]} \theta
                    \-
                    \\iota_{v_2}\iota_{v_1}\omega
                    \=
                    \\mathcal{L}_{v_1} \alpha_2 - \mathcal{L}_{v_2} \alpha_1
          .proof
            %h6#proof Proof
            %p
              Using
              %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+magic+formula"} Cartan's magic formula
              and by the prequantization condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi θ
                    %mo =
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} d \theta = \omega
              the we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ℒ
                              %mi v
                            %mi θ
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mi v
                            %mi d
                            %mi θ
                            %mo +
                            %mi d
                            %msub
                              %mi ι
                              %mi v
                            %mi θ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mi v
                            %mi ω
                            %mo +
                            %mi d
                            %msub
                              %mi ι
                              %mi v
                            %mi θ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{L}_v \theta &amp;= \iota_v d\theta + d \iota_v \theta
                    \\\
                    \&amp; =  \iota_v\omega + d \iota_v \theta
                    \\end{aligned}
                    \\,.
            %p
              This gives the first statement. For the second we first use the formula for the
              %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
              and then again the definition of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \alpha_i
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %mi ω
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %mi d
                            %mi θ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %mi d
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %mi θ
                            %mo −
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %mi d
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %mi θ
                            %mo −
                            %msub
                              %mi ι
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi v
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi v
                                  %mn 2
                                %mo{:stretchy => "false"} ]
                            %mi θ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %mi d
                            %msub
                              %mi α
                              %mn 2
                            %mo −
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %mi ω
                            %mo −
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %mi d
                            %msub
                              %mi α
                              %mn 1
                            %mo +
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %mi ω
                            %mo −
                            %msub
                              %mi ι
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi v
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi v
                                  %mn 2
                                %mo{:stretchy => "false"} ]
                            %mi θ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 2
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %mi ω
                            %mo +
                            %msub
                              %mi ℒ
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %msub
                              %mi α
                              %mn 2
                            %mo −
                            %msub
                              %mi ℒ
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %msub
                              %mi α
                              %mn 1
                            %mo −
                            %msub
                              %mi ι
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi v
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi v
                                  %mn 2
                                %mo{:stretchy => "false"} ]
                            %mi θ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\iota_{v_2}\iota_{v_1} \omega
                    \&amp; =
                    \\iota_{v_2}\iota_{v_1} d\theta
                    \\\
                    \&amp; =
                    \\iota_{v_1} d \iota_{v_2} \theta
                    \-
                    \\iota_{v_2} d \iota_{v_1} \theta
                    \-
                    \\iota_{[v_1,v_2]} \theta
                    \\\
                    \&amp; =
                    \\iota_{v_1} d \alpha_2 - \iota_{v_1} \iota_{v_2}\omega
                    \- \iota_{v_2} d \alpha_1 + \iota_{v_2} \iota_{v_1}\omega
                    \-
                    \\iota_{[v_1,v_2]} \theta
                    \\\
                    \&amp; =
                    2 \iota_{v_2} \iota_{v_1}\omega
                    + \mathcal{L}_{v_1} \alpha_2
                    \-\mathcal{L}_{v_2} \alpha_1
                    \-
                    \\iota_{[v_1,v_2]} \theta
                    \\end{aligned}
                    \\,.
          #EquivalenceBetweenPoissonBracketAndInfinQuantomorphism.num_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\omega)
              a
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+manifold"} presymplectic manifold
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta \in \Omega^1(X)
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi θ
                      %mo =
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} d \theta = \omega
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔔𝔲𝔞𝔫𝔱𝔐𝔬𝔯𝔭𝔥
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi θ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ,
                      %mi α
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi ℒ
                        %mi v
                      %mi θ
                      %mo =
                      %mi d
                      %mi α
                      %mo }
                    %mo ⊂
                    %mi Vect
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊕
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{QuantMorph}(X,\theta)
                    \=
                    \\left\{
                    (v,\alpha) | \mathcal{L}_v \theta = d \alpha
                    \\right\}
                    \\subset
                    Vect(X) \oplus C^\infty(X)
            %p with Lie bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi α
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %msub
                      %mi α
                      %mn 2
                    %mo −
                    %msub
                      %mi ℒ
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %msub
                      %mi α
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [(v_1,\alpha_1), (v_2,\alpha_2)] = ([v_1,v_2], \mathcal{L}_{v_1}\alpha_2 - \mathcal{L}_{v_2}\alpha_1)
                    \\,.
            %p
              Then by
              %a.maruku-eqref{:href => "#eq:EquationForLieHomomorphism"} (1)
              the linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %msub
                      %mi ι
                      %mi v
                    %mi θ
                    %mo −
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (v,H) \mapsto (v, \iota_v \theta - H)
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔓𝔬𝔦𝔰
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ω
