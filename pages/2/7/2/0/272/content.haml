              = succeed ")" do
                %a{:href => "http://xxx.uni-augsburg.de/abs/hep-th/0101079"} arXiv:hep-th/0101079
          %p
            (relation to
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"} deformation quantization
          %ul
            %li
