                  %annotation{:encoding => "application/x-tex"} X
              a Segal space, write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi hoequ
                    %mo ↪
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    X_{hoequ} \hookrightarrow X_1
            %p
              for the inclusion of the connected components of those vertices that become
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              in the homotopy category, def.
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyCategory"}
          %p
            (
            %a{:href => "#Rezk"}> Rezk, 5.7
            )
          .num_defn
            %h6#definition_5 Definition
            %p
              A Segal space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is called a
              %strong complete Segal space
              if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 0
                    %mo :
                    %msub
                      %mi X
                      %mn 0
                    %mo →
                    %msub
                      %mi X
                      %mi hoequ
                  %annotation{:encoding => "application/x-tex"}
                    s_0 : X_0 \to X_{hoequ}
            %p is a weak equivalence.
          %p
            (
            %a{:href => "#Rezk"}> Rezk, 6.
            )
          .num_remark
            %h6#remark Remark
            %p
              This condition is equivalent to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              being a
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              with respect to the morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mover
                        %mo →
                        %mo ≃
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} N(\{0 \stackrel{\simeq}{\to} 1\}) \to *
              = succeed "." do
                %a{:href => "#CharacterizationOfCompleteness"} below
          .num_remark
            %h6#remark_2 Remark
            %p
              The completeness condition may also be thought of as
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/univalence"} univalence
          .num_remark
            %h6#remark_3 Remark
            %p
              There is a Segal completion functor given in (
              %a{:href => "#Rezk"}> Rezk, 14.
              ).
          %h3#CompleteSegalSpaceObjects Complete Segal space objects
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/category+object+in+an+%28infinity%2C1%29-category"} category object in an (infinity,1)-category
            for more information.
          %p (…)
          %h2#properties Properties
          %h3#CharacterizationOfCompleteness Characterization of Completeness
          .num_theorem
            %h6#theorem Theorem
            %p
              A Segal space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a complete Segal space precisely if it is a
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              with respect to the morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mover
                        %mo →
                        %mo ≃
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} N(0 \stackrel{\simeq}{\to} 1) \to *
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
              %a.existingWikiWord{:href => "/nlab/show/hom+objects"} hom objects
              we have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mover
                      %mo →
                      %mo ≃
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X_0
                    \\simeq
                    [\Delta^{op}, sSet](*, X)
                    \\to
                    [\Delta^{op}, sSet](N(0 \stackrel{\simeq}{\to} 1), X)
            %p is a weak equivalence.
          %p
            (
            %a{:href => "#Rezk"}> Rezk, theorem 6.2
            )
          %h3#ModelCategoryStructure Model category structure
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\Delta^{op}, sSet]
            of
            %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            on the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            (
            %a.existingWikiWord{:href => "/nlab/show/bisimplicial+sets"}> bisimplicial sets
            ) supports a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure whose fibrant objects are precisely the complete Segal spaces: the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+complete+Segal+spaces"} model structure for complete Segal spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-categories"} (∞,1)-category of (∞,1)-categories
          %h3#RelationToSimplicialLocalization Relation to simplicial localization
          %p
            Given
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            a
            %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒲
                  %mo ⊂
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{W} \subset Mor(\mathcal{C})
            or more generally a “
            %a.existingWikiWord{:href => "/nlab/show/relative+category"}> relative category
            ”, then there is canonically a complete Segal space associated with it by the “relative nerve” construction, def.
            %a.maruku-ref{:href => "#RelativeNerve"}
            followed by fibrant replacement, and hence by the
            %a{:href => "#ModelCategoryStructure"} model structure
            this determines an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mi Rezk
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi 𝒲
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N_{Rezk}(\mathcal{C},\mathcal{W})
            \.
          %p
            On the other hand classical
            = succeed "-theory" do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/hammock+localization"} hammock localization
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi 𝒲
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \mathcal{W})
            into an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo{:stretchy => "false"} [
                  %mi 𝒲
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathcal{C}[\mathcal{W}]^{-1}
            which universally turns the elements in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒲
                %annotation{:encoding => "application/x-tex"} \mathcal{W}
            into
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
          .num_theorem
            %h6#theorem_2 Theorem
            %p
              These constructions are compatible in that there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi Rezk
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi 𝒲
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒲
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_{Rezk}(\mathcal{C},\mathcal{W})
                    \\simeq
                    \\mathcal{C}[\mathcal{W}^{-1}]
                    \\,.
          %p
            For
            %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
            this is (
            %a{:href => "#Rezk"}> Rezk, theorem 8.3
            \. For general
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            this is (
            %a{:href => "#Bergner07"}> Bergner 07, theorem 6.2
            ). For the fully general case this follows from results by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Clark+Barwick"} Clark Barwick
            %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
            and
            %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"} Bertrand Toën
            as pointed out by
            %a.existingWikiWord{:href => "/nlab/show/Chris+Schommer-Pries"} Chris Schommer-Pries
            = succeed "." do
              %a{:href => "http://mathoverflow.net/a/93139/381"} here on MathOverflow
          %p
            In fact, the construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi 𝒲
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mi N
                    %mi Rezk
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi 𝒲
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{C},\mathcal{W})\mapsto N_{Rezk}(\mathcal{C},\mathcal{W})
            admits a direct generalization in the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasicategory"} quasicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mi Rezk
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi 𝒲
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N_{Rezk}(\mathcal{C},\mathcal{W})
            still presents the localization
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒲
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}[\mathcal{W}^{-1}]
            = succeed ")." do
              %a{:href => "#MazelGee19"} Mazel-Gee19, Theorem 3.8
            = succeed ")." do
              %a{:href => "#Arakawa23"} Arakawa23, Theorem 1.7
          %h3#model_categories_for_presheaves Model categories for presheaves
          %p
            There is a notion of
            %a.existingWikiWord{:href => "/nlab/show/right%2Fleft+fibration+of+complete+Segal+spaces"} right/left fibration of complete Segal spaces
            analogous to
            %span.newWikiWord
              right/left Kan fibrations
              %a{:href => "/nlab/new/right%2Fleft+Kan+fibrations"} ?
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
          %h2#Examples Examples
          %p
            We discuss some examples. For more and more basic examples see also at
            = succeed "." do
              %em
                %a{:href => "Segal+space#Examples"} Segal space – Examples
          %h3#OrdinaryCategoriesAsCompleteSegalSpaces Ordinary categories as complete Segal spaces
          %p
            We discuss how an ordinary
            %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            is naturally regarded as a complete Segal space. (
            %a{:href => "#Rezk"}> Rezk, 3.5
            )
          %h4#preliminaries Preliminaries
          %p We need the following basic ingredients.
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Cat
                    %mi op
                  %mo ×
                  %mi Cat
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} (-)^{(-)} : Cat^{op} \times Cat \to Cat
            for the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi A
                    %mo =
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^A = Func(A,X)
          %p
            By the discussion at
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            we have a canonical functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo ↪
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  \\Delta \hookrightarrow Cat
          %p
            including the
            %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            into
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            by regarding the
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[n]
            as the category generated from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            consecutive morphisms.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            itself is then then functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo :
                  %mi Cat
                  %mo →
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  N : Cat \to sSet
          %p
            to
            %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            sending a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi k
                  %mo ↦
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N(C) : k \mapsto C^{\Delta[k]}
                  \\,.
          %p
            Its restriction along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grpd
                  %mo ↪
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Grpd \hookrightarrow Cat
            to
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            lands in
            %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KanCplx
                  %mo ↪
                %annotation{:encoding => "application/x-tex"} KanCplx \hookrightarrow
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            operation is the functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Core
                  %mo :
                  %mi Cat
                  %mo →
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  Core : Cat \to Grpd
          %p
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to the inclusion of
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            into
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %h4#the_construction The construction
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo ∈
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{C} \in [\Delta^{op}, sSet]
          %p by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mi k
                  %mo :
                  %mo =
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{C}_k := N(Core(C^{\Delta[k]}))
                  \\,.
          %p
            In degree 0 this is the the
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            itself. In degree 1 it is the groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{C}_1
            underlying the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            One sees that the
            %a.existingWikiWord{:href => "/nlab/show/source"} source
            and
            %a.existingWikiWord{:href => "/nlab/show/target"} target
            functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ,
                  %mi t
                  %mo :
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} s, t : C^{\Delta[1]} \to C
            are
            %a.existingWikiWord{:href => "/nlab/show/isofibrations"} isofibrations
            and hence their image under
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            and
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrations"} Kan fibrations
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            (see there)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mn 1
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mn 0
                  %mi ⋯
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mn 0
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{C}_1 \times_{\mathbf{C}_0} \cdots \times_{\mathbf{C}_0} \mathbf{C}_1
            is given already be the ordinary
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            in the
            %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            the functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ×
                    %mrow
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mi ⋯
                  %msub
                    %mo ×
                    %mrow
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi C
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Core(C^{\Delta[k]}) \to Core(C^{\Delta[1]}) \times_{Core(C)} \cdots \times_{Core(C)} Core(C^{\Delta[1]})
          %p
            are
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mi k
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mn 1
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mn 0
                  %mi ⋯
                  %msub
                    %mo ×
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi C
                        %mn 0
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{C}_k
                  \\to
                  \\mathbf{C}_1 \times_{\mathbf{C}_0} \cdots \times_{\mathbf{C}_0} \mathbf{C}_1
          %p is an equivalence.
          %p
            It is clear that the
            %a.existingWikiWord{:href => "/nlab/show/composition"} composition
            operation in the complete Segal space defined this way “is” the composition in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi k
                  %mo ↦
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mi C
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Core(\mathbf{C}) : k \mapsto N(Core(C)^{\Delta[k]})
                  \= N(Core(C))^{\Delta[k]}
                  \\,,
          %p
            where, note, now we
            %em first
            take the core of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and then form morphism categories.
          %p
            This simplicial Kan complex has in each positive degree a
            %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
            for the
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi Core
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(Core(C))
          %p
            Notably (since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[k]
            is
            %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalent
            to the point) it follows that indeed all the face and degeneracy maps are weak homotopy equivalences.
          %p
            So for every category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi C
                %annotation{:encoding => "application/x-tex"} \mathbf{C}
            constructed as above is a complete Segal space. This construction extends to a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo →
                  %mi completeSegalSpace
                %annotation{:encoding => "application/x-tex"} Cat \to completeSegalSpace
            and this is homotopy full and faithful.
          %h4#PropertiesOfTheInclusionOfCategories Properties of the inclusion
          %p Write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sing
                    %mi J
                  %mo :
                  %mi Cat
                  %mo →
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi Δ
                    %mi op
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  Sing_J : Cat \to [\Delta^{op}, sSet]
          %p for the functor just defined
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              two categories, there are
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sing
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ×
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Sing
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi Sing
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sing_J(C \times D)
                    \\simeq
                    Sing_J(C) \times Sing_J(D)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sing
                      %mi J
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Sing
                      %mi J
                    %mi D
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi Sing
                          %mi J
                        %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sing_J(D^C) \simeq (Sing_J D)^{Sing_J C}
                    \\,.
            %p
              A functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} f : C \to D
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sing
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sing_J(f)
              is an equivalence in the
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi Reedy
                  %annotation{:encoding => "application/x-tex"} [\Delta^{op}, sSet]_{Reedy}
              (hence is degreewise a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              of Kan complexes).
          %p
            This appears as (
            %a{:href => "#Rezk"}> Rezk, theorem 3.7
            ).
          %h3#RelativeCategoryAsCompleteSegalSpace Relative and Model categories as complete Segal spaces
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a category with a class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ⊂
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W \subset Mor(C)
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} weak equivalences
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            could be a
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            or (much) more generally a “
            %a.existingWikiWord{:href => "/nlab/show/relative+category"}> relative category
            ”. Then the
            %a{:href => "#OrdinaryCategoriesAsCompleteSegalSpaces"} above
            construction has the following evident variant.
          #RelativeNerve.num_prop
            %h6#definition_6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} N(C,W) \in [\Delta^{op}, sSet]
              be given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi n
                    %mo ↦
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Core
                      %mi W
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} N(C,W) : n \mapsto N(Core_W(C^{\Delta[n]})) \,,
            %p
              where now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Core
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Core_W(-)
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              on those
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              whose components are
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .num_remark
            %h6#remark_4 Remark
            %p
              The typical
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              is not a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              with respect to the base choice of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/universe"} universe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(C,W)
              will be a “
              %a.existingWikiWord{:href => "/nlab/show/large+set"}> large
              ” bisimplicial set. In other words, one needs to employ some
              %a.existingWikiWord{:href => "/nlab/show/universe+enlargement"} universe enlargement
              to interpret this definition.
          .num_remark
            %h6#remark_5 Remark
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a model category, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Core
                      %mi W
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Core_W(C^{\Delta[n]})
              is the subcategory of weak equivalences in any of the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structures+on+functors"} model structures on functors
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mrow
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} C^{\Delta[n]}
              %a{:href => "/nlab/show/%28infinity%2C1%29-categorical+hom-space#SpacesOfEquivalences"} classical fact
              discssed at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categorical+hom-space"} (∞,1)-categorical hom-space
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              is a model for the
              %a.existingWikiWord{:href => "/nlab/show/core"} core
              of the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
          %p
            The bisimplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(C,W)
            is not, in general, a complete Segal space. It does, however, represent the same
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            as the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            at
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "." do
              %a{:href => "http://mathoverflow.net/questions/92916/does-the-classification-diagram-localize-a-category-with-weak-equivalences/93139"} this MO question
          %p
            We can, of course, always reflect
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(C,W)
            into a complete Segal space by passing to a
            %a.existingWikiWord{:href => "/nlab/show/fibrant+replacement"} fibrant replacement
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+complete+Segal+spaces"} model structure for complete Segal spaces
            %em
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy
              fibrant
            replacement (which does not change the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of the simplicial sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Core
                      %mi W
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(Core_W(C^{\Delta[n]}))
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy fibrant replacement
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(C,W)
              is a complete Segal space.
          %p
            This is (
            %a{:href => "#Rezk"}> Rezk, theorem 8.3
            ).
          %h3#QuasiCategoriesAsCompleteSegal Quasi-categories as complete Segal spaces
          %p
            The formula
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo ↦
                  %mi k
                  %mo ↦
                  %mi Core
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi 𝒞
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{C} \mapsto k \mapsto Core(\mathcal{C}^{\Delta[k]})
            also defines a relative functor from quasi-categories to complete segal spaces, which has a one-sided inverse
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ↦
                    %msub
                      %mi X
                      %mrow
                        %mo •
                        %mo ,
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} X \mapsto X_{\bullet,0}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            appearing in
            = succeed "." do
              %a{:href => "#JoyalTierney07"} Joyal &amp; Tierney (2007), proposition 4.10
          %p However, to get a right Quillen functor, we need to use a different model of Core.
          .num_defn
            %h6#definition_7 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi J
                    %mo :
                    %mi Δ
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_J : \Delta \to sSet
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [n]
              to the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of the
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+groupoid"} codiscrete groupoid
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi J
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mover
                      %mo →
                      %mo ≃
                    %mi ⋯
                    %mover
                      %mo →
                      %mo ≃
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_J[n] = N(0 \stackrel{\simeq}{\to} \cdots \stackrel{\simeq}{\to} n)
                    \\,.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sing
                      %mi J
                    %mo :
                    %mi sSet
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    Sing_J : sSet \to [\Delta^{op}, sSet]
            %p for the functor given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sing
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %msub
                      %mi Hom
                      %mi sSet
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %msub
                      %mi Δ
                      %mi J
                    %mo{:stretchy => "false"} [
                    %mo •
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sing_J(X)_n = Hom_{sSet}(\Delta[n] \times \Delta_J[\bullet], X)
                    \\,.
          .num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} X \in sSet
              a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inner+Kan+complex"} inner Kan complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sing
                      %mi J
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sing_J(X)
              is a complete Segal space.
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+dendroidal+complete+Segal+spaces"} model structure for dendroidal complete Segal spaces
            the section
            %em
              %a{:href => "model+structure+for+dendroidal+complete+Segal+spaces#QuasiOperadsToDendroidalCompleteSegal"} Quasi-operads to dendroidal complete Segal spaces
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/semi-Segal+space"}> semi-Segal space
                ,
                %a.existingWikiWord{:href => "/nlab/show/Segal+space"} Segal space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+complete+Segal+spaces"} model structure for complete Segal spaces
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/higher+complete+Segal+space"}> higher complete Segal space
                ,
                %a.existingWikiWord{:href => "/nlab/show/dendroidal+complete+Segal+space"} dendroidal complete Segal space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rezk+completion"} Rezk completion
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/directed+homotopy+type+theory"} directed homotopy type theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/table+-+models+for+%28infinity%2C1%29-operads"} table - models for (infinity,1)-operads
          %h2#references References
          %h3#general General
          %p Complete Segal spaces were originally defined in
          %ul
            %li#Rezk
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"}> Charles Rezk
              ,
              %em A model for the homotopy theory of homotopy theory
              , Trans. Amer. Math. Soc., 353(3), 973-1007 (
              %a{:href => "https://arxiv.org/abs/math/9811037"}> arXiv:math/9811037
              )
          %p
            The relation to
            %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
            is discussed in
          %ul
            %li#JoyalTierney07
              %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"}> Andre Joyal
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Myles+Tierney"} Myles Tierney
              = succeed "," do
                %em Quasi-categories vs. Segal spaces
              = succeed "," do
                %em Categories in Algebra, Geometry and Mathematical Physics
              %strong 431
              (2007) &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math/0607820"}> arXiv:math/0607820
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1090/conm/431"} doi:10.1090/conm/431
          %p
            Further discussion of the relation to
            %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
            is in
          %ul
            %li#Bergner07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Julia+Bergner"}> Julia Bergner
                ,
                %em Complete Segal spaces arising from simplicial categories
                (
                %a{:href => "http://arxiv.org/abs/0704.1624"}> arXiv:0704.1624
                )
            %li#MazelGee19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aaron+Mazel-Gee"}> Aaron Mazel-Gee
                ,
                = succeed "," do
                  %em The universality of the Rezk nerve
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1510.03150"} arXiv:math/1510.03150
                = succeed ")" do
                  %a{:href => "https://doi.org/10.2140/agt.2019.19.3217"} doi:10.2140/agt.2019.19.3217
            %li#Arakawa23
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kensuke+Arakawa"}> Kensuke Arakawa
                ,
                %em Classification Diagrams of Marked Simplicial Sets
                (
                %a{:href => "https://arxiv.org/abs/2311.01101"}> arXiv:math/2311.01101
                ).
          %p A survey of the definition and its relation to equivalent definitions is in section 4 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Julia+Bergner"}> Julia Bergner
              ,
              %em
                A survey of
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty, 1)
              (
              %a{:href => "http://arxiv.org/abs/math.AT/0610239"}> arXiv
              ).
          %p See also pages 29 to 31 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/On+the+Classification+of+Topological+Field+Theories"} On the Classification of Topological Field Theories
          %p
            For literature on the variants and refinements see at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Theta+space"} Theta space
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/n-fold+complete+Segal+space"} n-fold complete Segal space
          %p Related MathOverflow discussion includes
          %ul
            %li
              %a{:href => "http://mathoverflow.net/q/92916/381"} Does the classification diagram localize a category with weak equivalences?
        .revisedby
