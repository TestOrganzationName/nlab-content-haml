          %h2#idea Idea
          %p
            A
            %em complete Segal space
            is a model for an
            %a.existingWikiWord{:href => "/nlab/show/internal+category+in+an+%28%E2%88%9E%2C1%29-category"} internal category in an (∞,1)-category
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
            by
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            %em Rezk categories
            after
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"} Charles Rezk
          %p
            More in detail, a complete Segal space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
          %ul
            %li
              %p
                for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                a
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} X_n
                = succeed ";" do
                  %em
                    space of composable sequences of
                    = succeed "-morphisms" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                forming a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
                in
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                (a
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/bisimplicial+set"} bisimplicial set
          %p such that
          %ol
            %li
              %p
                there is a
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                operation well defined up to
                %a.existingWikiWord{:href => "/nlab/show/coherence"} coherent
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                %a.existingWikiWord{:href => "/nlab/show/Segal+maps"} Segal maps
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi k
                      %mo →
                      %msub
                        %mi X
                        %mn 1
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi X
                            %mn 0
                      %mi ⋯
                      %msub
                        %mo ×
                        %mrow
                          %msub
                            %mi X
                            %mn 0
                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      X_k \to X_1 \times_{X_0} \cdots \times_{X_0} X_1
              %p
                (into the iterated
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                of the
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
                of 1-morphisms over the
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
              %p
                (so far this defines a
                = succeed ");" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Segal+space"} Segal space
            %li
              %p
                the notion of
                %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
                is compatible with that in the ambient
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
                (“completeness”): the sub-simplicial object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Core
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Core(X_\bullet)
                on the invertible morphisms in each degree is homotopy constant: it has all face and degeneracy maps being
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
              %p
                (this says that if a morphism is an equivalence under the explicit composition operation then it is already a morphism in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} X_0
                ).
          %h2#Definition Definition
          %p We first discuss
          %ul
            %li
              %a{:href => "#CompleteSegalSpaces"} Complete Segal spaces
          %p as such, and then the more general notion of
          %ul
            %li
              %a{:href => "#CompleteSegalSpaceObjects"} Complete Segal space objects
          %p
            internal to a suitable model category/
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            – this reduces to the previous notion for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} = sSet_{Quillen}
          %h3#CompleteSegalSpaces Complete Segal spaces
          .num_defn
            %h6#definition_2 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Segal+space"} Segal space
              is a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
              in
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    X \in [\Delta^{op}, sSet]
            %p such that
            %ul
              %li
                %p
                  it is fibrant in the
                  %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi Δ
                            %mi op
                          %mo ,
                          %msub
                            %mi sSet
                            %mi Quillen
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mi Reedy
                        %annotation{:encoding => "application/x-tex"} [\Delta^{op}, sSet_{Quillen}]_{Reedy}
              %li
                %p
                  it is a
                  %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
                  with respect to the
                  %a.existingWikiWord{:href => "/nlab/show/spine"} spine
                  inclusions
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mi Sp
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo ↪
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %msub
                            %mo{:stretchy => "false"} }
                            %mrow
                              %mi n
                              %mo ∈
                              %mi ℕ
                        %annotation{:encoding => "application/x-tex"} \{Sp[n] \hookrightarrow \Delta[n]\}_{n \in \mathbb{N}}
                %p
                  equivalently: for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Segal+map"} Segal map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi n
                        %mo →
                        %msub
                          %mi X
                          %mn 1
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi X
                              %mn 0
                        %mi ⋯
                        %msub
                          %mo ×
                          %mrow
                            %msub
                              %mi X
                              %mn 0
                        %msub
                          %mi X
                          %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        X_n \to X_1 \times_{X_0} \cdots \times_{X_0} X_1
                %p
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                  (of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
          %p
            (
            %a{:href => "#Rezk"}> Rezk, 4.1
            ).
          #HomotopyCategory.num_defn
            %h6#definition_3 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a Segal space, its
              %strong
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(X)
              is the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Ho%28Top%29"} Ho(Top)
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are the vertices of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} X_0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 0
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    Obj(X) = (X_0)_0
            %p
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
