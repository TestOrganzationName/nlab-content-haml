              the
              %a.existingWikiWord{:href => "/nlab/show/hom+object"} hom object
              is the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi X
                          %mn 0
                    %msub
                      %mi X
                      %mn 1
                    %msub
                      %mo ×
                      %mrow
                        %msub
                          %mi X
                          %mn 0
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ho(X)(x,y) := \pi_0 \Big(\{x\} \times_{X_0} X_1 \times_{X_0} \{y\}\Big)
                    \\,.
            %p
