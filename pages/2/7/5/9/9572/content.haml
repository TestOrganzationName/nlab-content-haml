                      %annotation{:encoding => "application/x-tex"} (X, \Phi)
                  of an object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                  and a
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                  (braiding morphism)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Φ
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        \\Phi \colon X \otimes (-) \to (-) \otimes X
                %p
                  such that for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Φ
                          %mrow
                            %mi Y
                            %mo ⊗
                            %mi Z
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ⊗
                        %msub
                          %mi Φ
                          %mi Z
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Φ
                          %mi Y
                        %mo ⊗
                        %mi id
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\Phi_{Y \otimes Z}
                        \=
                        (id \otimes \Phi_Z) \circ (\Phi_Y \otimes id)
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi Ψ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mrow
                          %mo {
                          %mi f
                          %mo ∈
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mi id
                          %mo ⊗
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %msub
                            %mi Φ
                            %mi Z
                          %mo =
                          %msub
                            %mi Ψ
                            %mi Z
                          %mo ∘
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ⊗
                          %mi id
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %mo ∀
                          %mi Z
                          %mo ∈
                          %mi 𝒞
                          %mo }
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Hom((X, \Phi), (Y,\Psi))
                        \=
                        \\left\{
                        f \in Hom_{\mathcal{C}}(X,Y)
                        \\;|\;
                        (id \otimes f) \circ \Phi_Z
                        \=
                        \\Psi_Z \circ (f \otimes id), \; \forall Z \in \mathcal{C}
                        \\right\}
                        \\,.
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                  is given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo ⊗
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi Ψ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ⊗
                        %mi Y
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo ⊗
                        %mi id
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ⊗
                        %mi Ψ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (X, \Phi) \otimes (Y, \Psi) = (X \otimes Y, (\Phi \otimes id) \circ (id \otimes \Psi))
                        \\,.
          %h2#properties Properties
          %h3#extra_structure_on_the_drinfeld_center Extra structure on the Drinfeld center
          .num_prop
            %h6#proposition Proposition
            %p
              The Drinfeld center
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z(\mathcal{C})
              is naturally a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
          %p
          #DrinfeldCenterOfFusionCategory.num_prop
            %h6 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              %a.existingWikiWord{:href => "/nlab/show/fusion+category"} fusion category
              over an
              %a.existingWikiWord{:href => "/nlab/show/algebraically+closed+field"} algebraically closed field
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z(\mathcal{C})
              is also naturally a fusion category.
          %p
            (
            %a{:href => "#EtingofNikshychOstrik05"}> Etingof, Nikshych &amp; Ostrik 2005, Thm. 2.15
            , review in
            = succeed ")" do
              %a{:href => "#DavydovMuegerNikshychOstrik03"} Davydov, Mueger, Nikshych &amp; Ostrik 2003, Sec. 2.3
          %p
            See also
            = succeed "," do
              %a{:href => "#DrinfeldGelakiNikshychOstrik10"} Drinfeld, Gelaki, Nikshych &amp; Ostrik 2010, Cor. 3.9
            = succeed "." do
              %a{:href => "#Mueger03"} Mueger 2003
          %h3#relation_to_drinfeld_double_under_tannaka_duality Relation to Drinfeld double under Tannaka duality
          %p
