              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} p(x): [a, b] \to \mathbb{R}
              are dense in
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
