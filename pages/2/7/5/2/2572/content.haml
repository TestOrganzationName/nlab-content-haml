              %a.existingWikiWord{:href => "/nlab/show/approximation+of+the+identity"} approximate the identity
              of the convolution product (the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/distribution"} Dirac distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi n
                    %mo =
                    %msub
                      %mi s
                      %mi n
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ‖
                    %msub
                      %mi s
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} ‖
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} K_n = s_n/\|s_n\|_1
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %msup
                      %mi x
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi n
                  %annotation{:encoding => "application/x-tex"} s_n(x) = (1 - x^2)^n
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-1, 1]
              and is compactly supported on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-1, 1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi n
                  %annotation{:encoding => "application/x-tex"} K_n
              approximates the Dirac distribution concentrated at 0. Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mfrac
                        %mn 1
                        %mn 4
                      %mo ,
                      %mfrac
                        %mn 1
                        %mn 4
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f: [-\frac1{4}, \frac1{4}] \to \mathbb{R}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
