                        %mo =
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f_x(x) = g(x)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %msub
                          %mi f
                          %mi x
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi ε
                      %annotation{:encoding => "application/x-tex"} g(y) \leq f_x(y) + \varepsilon
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} y \in X
              .proof
                %h6#proof Proof
                %p
                  For each
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} y \in X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ≠
                        %mi x
                      %annotation{:encoding => "application/x-tex"} y \neq x
                  we can choose
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} s \in A
                  such that
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo ≠
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} s(x) \neq s(y)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  separates points. Thus, given any
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ,
                          %mi y
                        %annotation{:encoding => "application/x-tex"} x, y
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi s
                        %mo ∈
                        %mi A
                      %annotation{:encoding => "application/x-tex"} s \in A
                  and scalars
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
                  such that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo +
                        %mi b
                        %mo ⋅
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mspace{:width => "2em"}
                        %mi a
                        %mo +
                        %mi b
                        %mo ⋅
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} a + b \cdot s(x) = g(x), \qquad a + b \cdot s(y) = g(y)
                %p
                  Denote
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ⋅
                        %mn 1
                        %mo +
                        %mi b
                        %mi s
                      %annotation{:encoding => "application/x-tex"} a \cdot 1 + b s
                  by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mrow
                            %mi x
                            %mo ,
                            %mi y
                      %annotation{:encoding => "application/x-tex"} f_{x, y}
                  (to indicate dependence on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  and
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                        %annotation{:encoding => "application/x-tex"} y
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                        %annotation{:encoding => "application/x-tex"} y
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mi y
                      %annotation{:encoding => "application/x-tex"} V_y
                  so that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %msub
                          %mi f
                          %mrow
                            %mi x
                            %mo ,
                            %mi y
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi ε
                      %annotation{:encoding => "application/x-tex"} g(z) \leq f_{x, y}(z) + \varepsilon
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi z
                          %mo ∈
                          %msub
                            %mi V
                            %mi y
                        %annotation{:encoding => "application/x-tex"} z \in V_y
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi V
                          %mrow
                            %msub
                              %mi y
                              %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi V
                          %mrow
                            %msub
                              %mi y
                              %mi n
                      %annotation{:encoding => "application/x-tex"} V_{y_1}, \ldots, V_{y_n}
                  cover
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mi x
                      %annotation{:encoding => "application/x-tex"} f_x
                  be the join of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mrow
                              %mi x
                              %mo ,
                              %msub
                                %mi y
                                %mn 1
                          %mo ,
                          %mi …
                          %mo ,
                          %msub
                            %mi f
                            %mrow
                              %mi x
                              %mo ,
                              %msub
                                %mi y
                                %mi n
                        %annotation{:encoding => "application/x-tex"} f_{x, y_1}, \ldots, f_{x, y_n}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %msub
                          %mi f
                          %mi x
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi ε
                      %annotation{:encoding => "application/x-tex"} g(y) \leq f_x(y) + \varepsilon
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} y \in X
            %li
              %p
                Given a choice of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi x
                    %annotation{:encoding => "application/x-tex"} f_x
                for each
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mi x
                    %annotation{:encoding => "application/x-tex"} V_x
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi ε
                      %mo ≤
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_x(z) - \varepsilon \leq g(z)
                for all
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mo ∈
                        %msub
                          %mi V
                          %mi x
                      %annotation{:encoding => "application/x-tex"} z \in V_x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi x
                            %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi V
                        %mrow
                          %msub
                            %mi x
                            %mi n
                    %annotation{:encoding => "application/x-tex"} V_{x_1}, \ldots, V_{x_n}
                cover
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                be the meet of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mrow
                            %msub
                              %mi x
                              %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi f
                          %mrow
                            %msub
                              %mi x
                              %mi n
                      %annotation{:encoding => "application/x-tex"} f_{x_1}, \ldots, f_{x_n}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi ε
                      %mo ≤
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≤
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi ε
                    %annotation{:encoding => "application/x-tex"} f(y) - \varepsilon \leq g(y) \leq f(y) + \varepsilon
              %p
                for all
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} y \in X
          %h2#variations Variations
          %p
            There is a complex-valued version of Stone–Weierstrass. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(X, \mathbb{C})
            denote the commutative
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %a.existingWikiWord{:href => "/nlab/show/C-star+algebra"} algebra
            of complex-valued functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} f: X \to \mathbb{C}
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^*
            %strong subalgebra
            is a subalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊆
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℂ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \subseteq C(X, \mathbb{C})
            which is closed under the star operation.
          .un_thm
            %h6#theorem Theorem
            %p
              A
              = succeed "-subalgebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^*
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \subseteq C(X, \mathbb{C})
              is dense if and only if it separates points.
          %p
            There is also a
            %a.existingWikiWord{:href => "/nlab/show/locally+compact+space"} locally compact
            version. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a locally compact Hausdorff space and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_0(X)
            be the space of (say complex-valued) functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            which “vanish at infinity”: for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ε
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \varepsilon \gt 0
            there exists a compact set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ⊆
                  %mi X
                %annotation{:encoding => "application/x-tex"} K \subseteq X
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mo &lt;
                  %mi ε
                %annotation{:encoding => "application/x-tex"} |f(x)| \lt \varepsilon
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            outside
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_0(X)
            is a commutative algebra
            %em without
            unit. In fact, under the sup norm, it is a Banach algebra and even a
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
            = succeed ")." do
              %a{:href => "vanishing+at+infinity#FunctionsVanInftyAreCstar"} here
          %p
            As before, we have a notion of subalgebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \subseteq C_0(X)
          .un_thm
            %h6#theorem_2 Theorem
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \subseteq C_0(X)
              is dense if and only if it separates points and for no
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              is it true that every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f \in A
              vanishes at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %h2#references References
          %p
            Named after
            %a.existingWikiWord{:href => "/nlab/show/Karl+Weierstra%C3%9F"} Karl Weierstraß
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Marshall+Stone"} Marshall Stone
          %p See alsoL
          %ul
            %li
              Wikipedia:
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Stone%E2%80%93Weierstrass_theorem"} Stone-Weierstrass theorem
          %p
            Discussion in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/B.+Banaschewski"}> B. Banaschewski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/C.+J.+Mulvey"} C. J. Mulvey
              = succeed "," do
                %em A constructive proof of the Stone-Weierstrass theorem
              %strong 116
