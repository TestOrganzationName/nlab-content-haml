                      %mi y
                      %mo{:stretchy => "false"} )
                      %mi d
                      %mi y
                    %annotation{:encoding => "application/x-tex"} (K_n * f)(x) = \int_{-1}^1 K_n(x-y) f(y) d y
              %p
                is polynomial (since by differentiating under the integral enough times, we eventually kill the convolving polynomial factor
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi K
                          %mi n
                      %annotation{:encoding => "application/x-tex"} K_n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi K
                        %mi n
                      %mo *
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (K_n * f)
                converges to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                in sup norm (i.e., uniformly) as
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo →
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} n \to \infty
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mfrac
                          %mn 1
                          %mn 4
                        %mo ,
                        %mfrac
                          %mn 1
                          %mn 4
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [-\frac1{4}, \frac1{4}]
          %p
            Now suppose given a Banach subalgebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊆
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \subseteq C(X)
          %ul
            %li
              %p
                Given
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %mi A
                        %mo ⊆
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} f \in A \subseteq C(X)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                are contained in some interval
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [a, b]
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi n
                    %annotation{:encoding => "application/x-tex"} p_n
                converge to the absolute value function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo ⋅
                      %mo{:stretchy => "false"} |
