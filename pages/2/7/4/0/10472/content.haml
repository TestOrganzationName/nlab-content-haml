          %h2#properties Properties
          %h3#general General
          %p
            Most of the relevant constructions on pointed topological spaces are immediate specializations of the general construction discussed at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
          %h3#relation_to_onepoint_compactification Relation to one-point compactification
          #OnePointCompactificationAndSmashProduct.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/one-point+compactification+intertwines+Cartesian+product+with+smash+product"}> one-point compactification intertwines Cartesian product with smash product
                )
            %p
              On the
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi LCHaus
                  %annotation{:encoding => "application/x-tex"} Top_{LCHaus}
              of
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              on the
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+spaces"} locally compact Hausdorff spaces
              with
              %a.existingWikiWord{:href => "/nlab/show/proper+maps"} proper maps
              between them, the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#OnePointCompactificationFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi cpt
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Top
                      %mi LCHaus
                    %mo ⟶
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    (-)^{cpt}
                    \\;\colon\;
                    Top_{LCHaus}
                    \\longrightarrow
                    Top^{\ast/}
            %p
              sends
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              (
              %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"}> product topological spaces
              ) to
              %a.existingWikiWord{:href => "/nlab/show/smash+products"} smash products
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi cpt
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi X
                      %mi cpt
                    %mo ∧
                    %msup
                      %mi Y
                      %mi cpt
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    X \times Y
                    \\big)^{cpt}
                    \\;\simeq\;
                    X^{cpt} \wedge Y^{cpt}
                    \\,.
          %p
            This is briefly mentioned in, for instance,
            = succeed "." do
              %a{:href => "#Bredon93"} Bredon 93, p. 199
            = succeed "," do
              %a{:href => "https://math.stackexchange.com/a/1645794/58526"} MO:a/1645794/
            = succeed "." do
              %a{:href => "#Cutler20"} Cutler 20, Prop. 1.6
          %div
            %h3#SmashMonoidalDiagonals Smash-monoidal diagonals
            %p Write
            #eq:SmashMonoidalCategoryOfPointedTopologicalSpaces.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi PointedTopologicalSpaces
                    %mo ,
                    %msup
                      %mi S
                      %mn 0
                    %mo ,
                    %mo ∧
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi SymmetricMonoidalCategories
                  %annotation{:encoding => "application/x-tex"}
                    \\big( PointedTopologicalSpaces, S^0, \wedge \big)
                    \\;\;\in\;
                    SymmetricMonoidalCategories
            %ul
              %li
                %p
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
                  (with respect to some
                  %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
                  such as
                  %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
                  or
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/D-topological+spaces"} D-topological spaces
              %li
                %p
                  regarded as a
                  %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
                  with tensor product the
                  %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                  and unit the
                  %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mo =
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mo *
                            %mo +
                        %annotation{:encoding => "application/x-tex"} S^0 \,=\, \ast_+
            %p
              This category also has a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi i
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒳
                      %mi i
                    %mo ,
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X_i = (\mathcal{X}_i, x_i)
              with underlying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒳
                      %mi i
                    %mo ∈
                    %mi TopologicalSpaces
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}_i \in TopologicalSpaces
              by
            #eq:CartesianProductOfPointedTopologicalSpaces.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒳
                      %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msub
