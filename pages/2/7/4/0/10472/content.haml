                      %mn 2
                    %mo ,
                    %msub
                      %mi x
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi 𝒳
                      %mn 1
                    %mo ×
                    %msub
                      %mi 𝒳
                      %mn 2
                    %mo ,
