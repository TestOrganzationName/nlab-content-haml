          %h2#idea Idea
          %p
            The
            %em quaternionic Hopf fibration
            is the
            %a.existingWikiWord{:href => "/nlab/show/Hopf+fibration"} Hopf fibration
            induced by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi S
                            %mn 3
                        %mtd
                          %mo ↪
                        %mtd
                          %msup
                            %mi S
                            %mn 7
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi p
                                  %mi ℍ
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mi S
                            %mn 4
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  S^3 &amp;\hookrightarrow&amp; S^7
                  \\\
                  \&amp;&amp;
                  \\Big\downarrow^{\mathrlap{p_{\mathbb{H}}}}
                  \\\
                  \&amp;&amp; S^4
                  }
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
            over the
            %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
            with
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
            %a.existingWikiWord{:href => "/nlab/show/Hopf+construction"} Hopf construction
            from the product operation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℍ
                  %mo ×
                  %mi ℍ
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
