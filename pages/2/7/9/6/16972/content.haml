                              %mo{:stretchy => "false"} )
                            %mrow
                              %mi Spin
                              %mo{:stretchy => "false"} (
                              %mn 4
                              %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  S^3
                  \&amp;\overset{fib(h_{\mathbb{H}})}{\longrightarrow}&amp;
                  S^{7}
                  \&amp;\overset{h_{\mathbb{H}}}{\longrightarrow}&amp;
                  S^4
                  \\\
                  \= &amp;&amp; = &amp;&amp; =
                  \\\
                  \\frac{Spin(4)}{Spin(3)}
                  \&amp;\longrightarrow&amp;
