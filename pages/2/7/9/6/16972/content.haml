                      %mi y
                      %mo{:stretchy => "false"} |
                    %mn 2
                  %mo =
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{(x,y)  | {\vert x\vert}^2 + {\vert y\vert}^2 = 1\}
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℍ
                  %mo ×
                  %mi ℍ
                %annotation{:encoding => "application/x-tex"} \mathbb{H}\times \mathbb{H}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 4
                %annotation{:encoding => "application/x-tex"} S^4
            is regarded as the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+projective+space"} quaternionic projective space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi ℍ
                %annotation{:encoding => "application/x-tex"} p_{\mathbb{H}}
            is given (on points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
