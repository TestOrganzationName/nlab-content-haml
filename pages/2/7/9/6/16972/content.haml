                      %annotation{:encoding => "application/x-tex"} S^4
                  which is induced by the defining action on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 5
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^5
                  under the identification
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 4
                          %mo ≃
                          %mi S
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mn 5
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} S^4 \simeq S(\mathbb{R}^5)
              %li
                %p
                  the
                  = succeed "-action" do
                    %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"} Spin(5)
                  %a.existingWikiWord{:href => "/nlab/show/7-sphere"} 7-sphere
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 7
                      %annotation{:encoding => "application/x-tex"} S^7
                  which is induced under the exceptional
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Spin
                        %mo{:stretchy => "false"} (
                        %mn 5
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi Sp
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mi ℍ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Spin(5) \simeq Sp(2) = U(2,\mathbb{H})
                  (this Prop.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Spin(5)#ExceptionalIsoToSp2"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo ,
                        %mi ℍ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} U(2,\mathbb{H})
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℍ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathbb{H}^2
                  via
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mn 7
                          %mo ≃
                          %mi S
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℍ
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} S^7 \simeq S(\mathbb{H}^2)
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/quaternionic+Hopf+fibration"} quaternionic Hopf fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 7
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi h
                          %mi ℍ
                    %msup
                      %mi S
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} S^7 \overset{h_{\mathbb{H}}}{\longrightarrow} S^4
              is
              %a.existingWikiWord{:href => "/nlab/show/equivariant"} equivariant
              with respect to these
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/actions"} actions
          %p
            This appears as (
            %a{:href => "#GluckWarnerZiller86"}> Gluck, Warner &amp; Ziller (1986), Prop. 4.1
            ).
          %p
            The statement is also almost explicit in
            %a{:href => "#Porteous95"} Porteous 95, p. 263
          %div{:style => "text-align: center"}
            %img{:src => "/nlab/files/Spin5OnHopfH.jpg", :width => "280px"}/
          %p
            A way to make the
            = succeed "-equivariance" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
