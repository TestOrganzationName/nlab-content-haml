                    %mn 5
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(5)
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi S
                            %mn 3
                        %mtd
                          %mover
