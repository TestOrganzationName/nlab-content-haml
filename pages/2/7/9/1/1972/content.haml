                    %br/
          %h2#properties Properties
          %h3#relation_to_the_character_ring Relation to the character ring
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            and we
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
