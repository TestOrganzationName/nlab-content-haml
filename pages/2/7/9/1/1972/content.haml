              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            to the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/character+ring"} character ring
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            that are constant on each
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+class"} conjugacy class
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/class+functions"} class functions
          %p
            Similarly for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
