          %h2#definition Definition
          %p
            Any
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            has a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of finite-dimensional
            = succeed "-linear" do
              %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rep(G)
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
            %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
            (a “
            %a.existingWikiWord{:href => "/nlab/show/tensor+category"}> tensor category
            ”) and thus has a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+ring"} Grothendieck ring
            %strong representation ring
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and denoted
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(G)
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/virtual+representations"} virtual representations
          %h3#in_components In components
          %p
            More concretely, we get
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R(G)
            as follows. It has a
            %a.existingWikiWord{:href => "/nlab/show/basis"} basis
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi e
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi i
                %annotation{:encoding => "application/x-tex"} (e_i)_i
            given by the
            %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
            of
            %strong
              %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is an index for an irreducible finite-dimensional complex representation of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi i
                  %msub
                    %mi e
                    %mi j
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi k
                  %msubsup
                    %mi m
                    %mrow
                      %mi i
                      %mi j
                    %mi k
                  %msub
                    %mi e
                    %mi k
                  %mo ,
                %annotation{:encoding => "application/x-tex"} e_i e_j = \sum_k m_{i j}^k e_k ,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi m
                    %mrow
                      %mi i
                      %mi j
                    %mi k
                %annotation{:encoding => "application/x-tex"} m_{i j}^k
            is the multiplicity of the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+representations"} tensor product of representations
            of the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            these coefficients are also known as
            %em
              %a.existingWikiWord{:href => "/nlab/show/Clebsch-Gordan+coefficients"} Clebsch-Gordan coefficients
            (specifically for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            the
            %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(3)
            %em
              %a.existingWikiWord{:href => "/nlab/show/Fierz+identities"} Fierz identities
            (specifically for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
          %p
            Notice that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R(G)
            is commutative thanks to the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetry
            of the tensor product.
          %h3#AsEquivariantKTheoryOfThePoint As equivariant K-theory of the point
          %p
            Equivalently the representation ring of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            over the
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            is the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
            of the point, or equivalently by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Green-Julg+theorem"} Green-Julg theorem
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            %a.existingWikiWord{:href => "/nlab/show/operator+K-theory"} operator K-theory
            of the
            %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
            (the
            %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebra"} groupoid convolution algebra
            of the
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            groupoid of
            = succeed "):" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi R
                    %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msubsup
                    %mi KU
                    %mi G
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi KK
