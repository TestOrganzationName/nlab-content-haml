                        %annotation{:encoding => "application/x-tex"} R_{\mathbb{F}_p}(G) \simeq  K (\mathbb{F}_p)_G(\ast)  \overset{ \text{compl.} }{\longrightarrow} \widehat {(K \mathbb{F}_p)_G(\ast)} \!\! \overset{\text{&lt;a href="https://ncatlab.org/nlab/show/Rector+completion+theorem"&gt;Rector 73&lt;/a&gt;}}{\simeq} \!\!\!\!\!\! K \mathbb{F}_p(B G)
                    %br/
                %tr
                  %td{:style => "text-align: left;"}
                    (
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+cohomotopy"}> equivariant
                    )
                    %br/
                    %a.existingWikiWord{:href => "/nlab/show/stable+cohomotopy"} stable cohomotopy
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                          %msub
                            %mi 𝔽
                            %mn 1
                          %mover
                            %mo ≃
                            %mtext
                              %a{:href => "stable cohomotopy#StableCohomotopyIsAlgebraicKTheoryOverFieldWithOneElement"} Segal 74
                        %annotation{:encoding => "application/x-tex"} K \mathbb{F}_1 \overset{\text{&lt;a href="stable cohomotopy#StableCohomotopyIsAlgebraicKTheoryOverFieldWithOneElement"&gt;Segal 74&lt;/a&gt;}}{\simeq}
                    %a.existingWikiWord{:href => "/nlab/show/equivariant+sphere+spectrum"} S
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
                    %br/
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝕊
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbb{S}_G(\ast) \simeq A(G)
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Segal-Carlsson+completion+theorem"} Segal-Carlsson completion theorem
                    %br/
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo ≃
                            %mtext
                              %a{:href => "https://ncatlab.org/nlab/show/Burnside+ring+is+equivariant+stable+cohomotopy+of+the+point"} Segal 71
                          %msub
                            %mi 𝕊
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo ⟶
                            %mtext compl.
                          %mover
                            %mrow
                              %msub
                                %mi 𝕊
                                %mi G
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo{:stretchy => "false"} )
                            %mo ^
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mover
                            %mo ≃
                            %mtext
                              %a{:href => "https://ncatlab.org/nlab/show/Segal-Carlsson+completion+theorem"} Carlsson 84
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mspace{:width => "negativethinmathspace"}
                          %mi 𝕊
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mi G
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} A(G) \overset{\text{&lt;a href="https://ncatlab.org/nlab/show/Burnside+ring+is+equivariant+stable+cohomotopy+of+the+point"&gt;Segal 71&lt;/a&gt;}}{\simeq}  \mathbb{S}_G(\ast)  \overset{ \text{compl.} }{\longrightarrow} \widehat {\mathbb{S}_G(\ast)} \!\! \overset{\text{&lt;a href="https://ncatlab.org/nlab/show/Segal-Carlsson+completion+theorem"&gt;Carlsson 84&lt;/a&gt;}}{\simeq} \!\!\!\!\!\! \mathbb{S}(B G)
                    %br/
          %h3#LambdaRingStructure Lambda-ring structure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Adams+operations"} Adams operations
            equip the representation ring with the structure of a
            = succeed ",." do
              %a.existingWikiWord{:href => "/nlab/show/Lambda+ring"} Lambda ring
            = succeed "," do
              %a{:href => "#tomDieck79"} tomDieck 79, section 3.5
            = succeed "," do
              %a{:href => "#tomDieck09"} tom Dieck 09, section 6.2
            = succeed ")." do
              %a{:href => "#Meir17"} Meir 17
          %h3#relation_to_the_burnside_ring Relation to the Burnside ring
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
          %ol
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A(G)
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
                of the
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} G Set
                of
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} R(G)
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+group"} Grothendieck group
                of the monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi Rep
                    %annotation{:encoding => "application/x-tex"} G Rep
                of
                %a.existingWikiWord{:href => "/nlab/show/finite+dimensional+vector+space"} finite dimensional
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
          %p
            Then then map that sends a G-set to the corresponding linear
            %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
            is a
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Set
                  %mover
                    %mo ⟶
                    %mrow
                      %mi ℂ
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                  %mi G
                  %mi Rep
                %annotation{:encoding => "application/x-tex"}
                  G Set \overset{\mathbb{C}[-]}{\longrightarrow} G Rep
          %p
            and hence induces a
            %a.existingWikiWord{:href => "/nlab/show/ring+homomorphism"} ring homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mrow
                      %mi ℂ
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A(G) \overset{ \mathbb{C}[-] }{\longrightarrow} R(G)
          %p Under the identitification
          %ol
            %li
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/Burnside+ring"} Burnside ring
                with the
                %a.existingWikiWord{:href => "/nlab/show/equivariant+stable+cohomotopy"} equivariant stable cohomotopy
                of the point
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi 𝕊
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      A(G) \;\simeq\; \mathbb{S}_G(\ast)
              %p
                (see
                = succeed ")" do
                  %a{:href => "Burnside+ring#AsTheEquivariantStableCohomotopyOfThePoint"} there
            %li
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
                with the
                %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
                of the point
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi K
                        %mi G
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      R(G) \;\simeq\; K_G(\ast)
              %p
                (as
                = succeed ")" do
                  %a{:href => "#AsEquivariantKTheoryOfThePoint"} above
          %p
            this should be image of the initial morphism of
            %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring+spectra"} E-infinity ring spectra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                  %mo ⟶
                  %mi KU
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{S} \longrightarrow KU
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/KU"} KU
          %h3#splitting_principle_and_brauer_induction_theorem Splitting principle and Brauer induction theorem
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Brauer+induction+theorem"} Brauer induction theorem
            says that, over the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            %a.existingWikiWord{:href => "/nlab/show/induced+representations"} induced representations
            of 1-dimensional representations. This may be regarded as the
            %a.existingWikiWord{:href => "/nlab/show/splitting+principle"} splitting principle
            for linear representations and for
            %a.existingWikiWord{:href => "/nlab/show/characteristic+classes+of+linear+representations"} characteristic classes of linear representations
            (
            %a{:href => "#Symonds91"}> Symonds 91
            ).
          %h2#examples Examples
          %p
          #RepresentationRingOfUnitaryGroups.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/representation+ring"} representation ring
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/unitary+groups"} unitary groups
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/U%28n%29"} U(n)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo ,
                    %msubsup
                      %mi x
                      %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    R_{\mathbb{C}}
                    \\big(
                    U(n)
                    \\big)
                    \\;\simeq\;
                    \\mathbb{Z}[x_1, \cdots, x_{n-1}, x_n, x_n^{-1}]
                    \\,,
            %p
              and that of
              %a.existingWikiWord{:href => "/nlab/show/SU%28n%29"} SU(n)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi R
                      %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R_{\mathbb{C}}
                    \\big(
                    SU(n)
                    \\big)
                    \\;\simeq\;
                    \\mathbb{Z}[x_1, \cdots, x_{n-1}]
                    \\,.
            %p
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Husemoeller66"} Husemöller 66, Ch. 14, Thm. 3.1 (p. 192)
          %ul
            %li
              The completion of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Rep
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Rep(Spin(2k))
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi e
                      %mrow
                        %mo ±
                        %msub
                          %mi x
                          %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}[ [ e^{\pm x_j} ] ]
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi j
                    %mo ≤
                    %mi k
                  %annotation{:encoding => "application/x-tex"} 1 \leq j \leq k
              (e.g
              = succeed ")." do
                %a{:href => "#Brylinski90"} Brylinski 90, p. 9
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Clebsch-Gordan+coefficients"}> Clebsch-Gordan coefficients
                ,
                %a.existingWikiWord{:href => "/nlab/show/Fierz+identities"} Fierz identities
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Deligne%27s+theorem+on+tensor+categories"} Deligne's theorem on tensor categories
          %h2#references References
          %h3#general General
          %p Lecture notes:
          %ul
            %li#tomDieck09
              %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
              , Section 4.4. in:
              = succeed "," do
                %em Representation theory
              = succeed ")" do
                %a{:href => "http://www.uni-math.gwdg.de/tammo/rep.pdf"} pdf
          %p
            Computations for the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/classical+Lie+groups"} classical Lie groups
          %ul
            %li#Husemoeller66
              %a.existingWikiWord{:href => "/nlab/show/Dale+Husem%C3%B6ller"}> Dale Husemöller
              ,
              = succeed "," do
                %em Representation Rings of Classical Groups
              = succeed "," do
                %em Fibre bundles
              = succeed "," do
                %strong 20
              = succeed ")" do
                %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/husemoller"} pdf
          %p
            Exposition in relation to
            %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
            includes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Akhil+Mathew"}> Akhil Mathew
                ,
                %em
                  %a{:href => "https://amathew.wordpress.com/2011/12/03/equivariant-k-theory/"} Equivariant K-theory
            %li#Greenlees05
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Greenlees"}> John Greenlees
                ,
                = succeed "," do
                  %em Equivariant version of real and complex connective K-theory
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.hha/1139839291"} Euclid:1139839291
            %li#Wilson16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dylan+Wilson"}> Dylan Wilson
                ,
                = succeed "," do
                  %em Equivariant K-theory
                = succeed "," do
                  %a{:href => "https://www.math.uchicago.edu/~dwilson/notes/equivariant-k-theory-talk.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/WilsonKTheory16.pdf", :title => "pdf"} pdf
          %p
            Classical results for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+groups"} compact Lie groups
          %ul
            %li#Segal68
              %p
                %a.existingWikiWord{:href => "/nlab/show/Graeme+Segal"}> Graeme Segal
                ,
                = succeed "," do
                  %em The representation ring of a compact Lie group
                = succeed ")" do
                  %a{:href => "http://www.numdam.org/item/?id=PMIHES_1968__34__113_0"} numdam:PMIHES_1968__34__113_0
            %li
              %p
                Masaru Tackeuchi,
                = succeed "," do
                  %em A remark on the character ring of a compact Lie group
                = succeed ")" do
                  %a{:href => "http://projecteuclid.org/euclid.jmsj/1259849785"} Euclid
          %p
            In the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+groups"} super Lie groups
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gregory+Landweber"}> Gregory Landweber
                ,
                = succeed "," do
                  %em Representation rings of Lie superalgebras
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0403203"} arXiv:math/0403203
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gregory+Landweber"}> Gregory Landweber
                ,
                = succeed "," do
                  %em Twisted representation rings and Dirac induction
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0403524"} arXiv:math/0403524
          %p
            With an eye towards
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/loop+group+representations"} loop group representations
          %ul
            %li#Brylinski90
              %a.existingWikiWord{:href => "/nlab/show/Jean-Luc+Brylinski"}> Jean-Luc Brylinski
              ,
              = succeed "," do
                %em Representations of loop groups, Dirac operators on loop space, and modular forms
          %p
            Concerning the
            %a.existingWikiWord{:href => "/nlab/show/Brauer+induction+theorem"} Brauer induction theorem
            and the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/splitting+principle"} splitting principle
          %ul
            %li#Symonds91
              %a.existingWikiWord{:href => "/nlab/show/Peter+Symonds"}> Peter Symonds
              ,
              = succeed "," do
                %em A splitting principle for group representations
              = succeed "," do
