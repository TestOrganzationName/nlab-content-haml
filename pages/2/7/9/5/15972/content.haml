                  %mo \
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ∀
                  %mi t
                  %mo ≠
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\widetilde{P_Y X}:=\{f\in \Hom_{D^1}(\Delta^1\times D^1,X\times D^1),\;f(0,0)\in Y,\; f(1,0)\in Y,\;f(-,1)\in (X\backslash Y)\Rightarrow f(x,t)\in (X\backslash Y)\forall t\neq 0\}.
          %p
            More concretely, this is given by the homotopy pullback (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi 𝕄
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} {
                  %mi X
                  %mo ,
                  %mi Y
                  %msup
                    %mo{:stretchy => "false"} }
                    %mo †
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi XY
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(1)=\mathbb{M}(R\{X,Y\}^\dagger/(XY-1))
            and we use the homotopy equivalence
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∼
