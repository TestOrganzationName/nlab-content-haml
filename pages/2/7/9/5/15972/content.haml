                %mrow
                  %msup
                    %mi D
                    %mn 1
                %annotation{:encoding => "application/x-tex"} D^1
            and acting on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
