            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %msub
                    %mi P
                    %mi Y
                  %mi X
                  %mo →
                  %mover
                    %mrow
                      %msub
                        %mi P
                        %mi Y
                      %mi X
                    %mo ˜
                %annotation{:encoding => "application/x-tex"} s:P_Y X\to \widetilde{P_Y X}
            the fiber
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
