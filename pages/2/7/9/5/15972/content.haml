            acting on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            along its identity morphism, and whose fiber at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            will be the formal completion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi X
                      %mo{:stretchy => "false"} ^
                    %mi Y
                %annotation{:encoding => "application/x-tex"} \hat{X}_Y
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            along
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msub
                          %mi P
                          %mi Y
                        %mi X
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{P_Y X}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo :
                  %mover
                    %mrow
                      %msub
                        %mi P
                        %mi Y
                      %mi X
                    %mo ^
                  %mo →
                  %msup
                    %mi D
                    %mn 1
                %annotation{:encoding => "application/x-tex"} t:\widehat{P_Y X}\to D^1
            the natural projection,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %msub
                    %mover
                      %mi P
                      %mo ^
                    %mi Y
                  %mi X
                  %mo →
                  %mover
                    %mrow
                      %msub
                        %mi P
                        %mi Y
                      %mi X
                    %mo ^
