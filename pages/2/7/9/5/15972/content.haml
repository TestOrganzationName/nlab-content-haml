                              %mo ×
                              %mi k
                        %mtd
                          %mi X
                          %mo ×
                          %mi X
                          %mo ×
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 1
                          %mo ×
                          %mi U
                          %mo{:stretchy => "false"} (
