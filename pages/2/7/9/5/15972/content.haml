                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\widetilde{P_Y X} &amp;\to&amp; \Hom_{D^1}(\Delta^1\times D^1,X\times D^1)
                  \\\
                  \\downarrow &amp;&amp; \downarrow^{\mathrlap{ev_{(0,0)}\times ev_{(1,0)}\times \ev_{(-,U(1))}\times \ev_{(-,1)}}}
                  \\\
                  Y\times Y\times \Hom(\Delta^1\times U(1),(X\backslash Y))\times (X\backslash Y) &amp;\stackrel{i\times j\times k}{\to}&amp; X\times X\times \Hom(\Delta^1\times U(1),X)
                  \\times X}
          %p
            It has an evident natural projection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %mover
                      %mrow
                        %msub
                          %mi P
                          %mi Y
                        %mi X
                      %mo ˜
                    %mo →
                    %msup
                      %mi D
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} t:\widetilde{P_Y X}\to D^1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %msub
                        %mi P
                        %mi Y
                      %mi X
