                                    %mo{:stretchy => "false"} )
                                %mo ×
                                %msub
                                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ev
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo ,
                                    %mi U
                                    %mo{:stretchy => "false"} (
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} )
                                %mo ×
                                %msub
                                  %mo{:lspace => "0em", :rspace => "thinmathspace"} ev
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo ,
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi Y
                          %mo ×
                          %mi Y
                          %mo ×
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} Hom
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Δ
                            %mn 1
                          %mo ×
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:stretchy => "false"} (
