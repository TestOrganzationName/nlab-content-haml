                          %mtd
                            %mo =
                            %mi i
                            %mfrac
                              %mn 1
                              %mrow
                                %mi x
                                %mo +
                                %mi i
                                %msup
                                  %mn 0
                                  %mo +
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\widehat \Theta(x)
                    \&amp; =
                    \\int_0^\infty e^{i k x} \,  dk
