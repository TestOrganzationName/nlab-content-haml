                    \&amp; =
                    i \frac{1}{x + i 0^+}
                    \\end{aligned}
            %p
              Here the second equality is also known as
              = succeed "." do
                %em
                  complex
                  %a.existingWikiWord{:href => "/nlab/show/Schwinger+parameter"} Schwinger parameterization
          .proof
            %h6#proof_4 Proof
            %p
              As
              %a.existingWikiWord{:href => "/nlab/show/generalized+functions"} generalized functions
              consider the
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              with a decaying component:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mo ∫
                              %mn 0
                              %mn ∞
                            %msup
                              %mi e
                              %mrow
                                %mi i
                                %mi k
                                %mi x
                            %mspace{:width => "thinmathspace"}
                            %mi dk
                          %mtd
                            %mo =
                            %munder
                              %mi lim
                              %mrow
                                %mi ϵ
                                %mo →
                                %msup
                                  %mn 0
                                  %mo +
                            %msubsup
                              %mo ∫
                              %mn 0
                              %mn ∞
                            %msup
                              %mi e
                              %mrow
                                %mi i
                                %mi k
                                %mi x
                                %mo −
                                %mi ϵ
                                %mi k
                            %mspace{:width => "thinmathspace"}
                            %mi dk
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %munder
                              %mi lim
                              %mrow
                                %mi ϵ
                                %mo →
                                %msup
                                  %mn 0
                                  %mo +
                            %mfrac
                              %mn 1
                              %mrow
                                %mi i
                                %mi x
                                %mo −
                                %mi ϵ
                        %mtr
                          %mtd
                          %mtd
