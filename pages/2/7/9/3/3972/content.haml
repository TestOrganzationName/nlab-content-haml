          #FourierTransformOfPrincipalValueOfPowerOfQuadraticForm.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform
                of principal value of power of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} m \in \mathbb{R}
              be any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mo ∈
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \kappa \in \mathbb{C}
              any
              %a.existingWikiWord{:href => "/nlab/show/complex"} complex
              number. Then the
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo +
                    %msup
                      %mi m
                      %mn 2
                    %mo +
                    %mi i
                    %msup
                      %mn 0
                      %mo +
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi κ
                  %annotation{:encoding => "application/x-tex"} 1/(q + m^2 + i 0^+)^\kappa
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo (
                        %mfrac
                          %mn 1
                          %mrow
                            %mi q
                            %mo +
                            %msup
                              %mi m
                              %mn 2
                            %mo +
                            %mi i
                            %msup
                              %mn 0
                              %mo +
                        %mo )
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %msup
                          %mn 2
                          %mrow
                            %mn 1
                            %mo −
                            %mi κ
                        %mo{:stretchy => "false"} (
                        %msqrt
                          %mrow
                            %mn 2
                            %mi π
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi n
                        %msup
                          %mi m
                          %mrow
                            %mi n
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo −
                            %mi κ
                      %mrow
                        %mi Γ
                        %mo{:stretchy => "false"} (
                        %mi κ
                        %mo{:stretchy => "false"} )
                        %msqrt
                          %mi Δ
                    %mfrac
                      %mrow
                        %msub
                          %mi K
                          %mrow
                            %mi n
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo −
                            %mi κ
                        %mrow
                          %mo (
                          %mi m
                          %msqrt
                            %mrow
                              %msup
                                %mi q
                                %mo *
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mi i
                              %msup
                                %mn 0
                                %mo +
                          %mo )
                      %mrow
                        %msup
                          %mrow
                            %mo (
                            %msqrt
                              %mrow
                                %msup
                                  %mi q
                                  %mo *
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %msup
                                  %mn 0
                                  %mo +
                            %mo )
                          %mrow
                            %mi n
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo −
                            %mi κ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat
                    {
                    \\left(
                    \\frac{1}{q + m^2 + i0^+}
                    \\right)
                    }
                    \\;=\;
                    \\frac{
                    2^{1- \kappa} (\sqrt{2\pi})^{n} m^{n/2-\kappa}
                    }
                    {
                    \\Gamma(\kappa) \sqrt{\Delta}
                    }
                    \\frac{
                    K_{n/2 - \kappa}\left( m \sqrt{q^\ast - i 0^+} \right)
                    }
                    {
                    \\left(\sqrt{q^\ast - i0^+ }\right)^{n/2 - \kappa}
                    }
                    \\,,
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
                  deotes the
                  %a.existingWikiWord{:href => "/nlab/show/Gamma+function"} Gamma function
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi K
                          %mi ν
                      %annotation{:encoding => "application/x-tex"} K_{\nu}
                  denotes the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/modified+Bessel+function"} modified Bessel function
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi ν
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_\nu(a)
              diverges for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \to 0
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ν
                  %annotation{:encoding => "application/x-tex"} a^{-\nu}
              (
              %a{:href => "http://dlmf.nist.gov/10.30#E2"}> DLMF 10.30.2
              ).
          %p
            (
            %a{:href => "#GelfandShilov66"}> Gel’fand-Shilov 66, III 2.8 (8) and (9), p 289
            )
          #FeynmanPropagator.num_example
            %h6#example_5 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"}> Feynman propagator
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≔
                    %msup
                      %mi η
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} q \coloneqq \eta^{-1}
              be the dual
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
              in
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p+1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∝
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mfrac
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mi η
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo ,
                          %mi k
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msup
                            %mi m
                            %mn 2
                          %mo +
                          %mi i
                          %msup
                            %mn 0
                            %mo +
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_F(x)
                    \\;\propto\;
                    \\widehat{
                    \\frac{1}{
                    \-\eta^{-1}(k,k) - m^2 + i0^+
                    }
                    }
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              for the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %a.maruku-ref{:href => "#FourierTransformOfPrincipalValueOfPowerOfQuadraticForm"}
              implies that its
              %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              is the
              %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x \in \mathbb{R}^{p,1} \;\vert\; \eta(x,x) = 0\}
          %h3#FourierTransformOfDeltaOfTheMassShell
            The Fourier transform of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo +
                  %msup
                    %mi m
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta(q + m^2)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} q \colon \mathbb{R}^{n} \to \mathbb{R}
            be a non-degenerate real
            %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
            %a.existingWikiWord{:href => "/nlab/show/analytic+continuation"} analytically continued
            to a real quadratic form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℂ
                    %mi n
                  %mo ⟶
                  %mi ℂ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  q \;\colon\; \mathbb{C}^n \longrightarrow \mathbb{C}
                  \\,.
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            for the
            %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi t
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} t \in \mathbb{N}
            for the number of negative eigenvalues.
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi q
                    %mo *
                %annotation{:encoding => "application/x-tex"} q^\ast
            for the induced quadratic form on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual vector space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            (and hence
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mo *
                  %annotation{:encoding => "application/x-tex"} a^\ast
          #FourierTransformOfDeltaDistributionappliedToMassShell.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
                of
                %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
                applied to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/mass+shell"} mass shell
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} m \in \mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform+of+distributions"} Fourier transform of distributions
              of the
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              applied to the “mass shell”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo +
                    %msup
                      %mi m
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} q + m^2
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi δ
                        %mo{:stretchy => "false"} (
                        %mi q
                        %mo +
                        %msup
                          %mi m
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mfrac
                      %mi i
                      %msqrt
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi Δ
                          %mo{:stretchy => "false"} |
                    %mrow
                      %mo (
                      %msup
                        %mi e
                        %mrow
                          %mi i
                          %mi π
                          %mi t
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mfrac
                        %mrow
                          %msub
                            %mi K
                            %mrow
                              %mi n
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo −
                              %mn 1
                          %mrow
                            %mo (
                            %mi m
                            %msqrt
                              %mrow
                                %msup
                                  %mi q
                                  %mo *
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                %mi i
                                %msup
                                  %mn 0
                                  %mo +
                            %mo )
                        %mrow
                          %msup
                            %mrow
                              %mo (
                              %msqrt
                                %mrow
                                  %msup
                                    %mi q
                                    %mo *
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                                  %mi i
                                  %msup
                                    %mn 0
                                    %mo +
                              %mo )
                            %mrow
                              %mi n
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo −
                              %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo −
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi e
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi i
                          %mi π
                          %mi t
                          %mo{:stretchy => "false"} /
                          %mn 2
                      %mfrac
                        %mrow
                          %msub
                            %mi K
                            %mrow
                              %mi n
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo −
                              %mn 1
                          %mrow
                            %mo (
                            %mi m
                            %msqrt
                              %mrow
                                %msup
                                  %mi q
                                  %mo *
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi i
                                %msup
                                  %mn 0
                                  %mo +
                            %mo )
                        %mrow
                          %msup
                            %mrow
                              %mo (
                              %msqrt
                                %mrow
                                  %msup
                                    %mi q
                                    %mo *
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mi i
                                  %msup
                                    %mn 0
                                    %mo +
                              %mo )
                            %mrow
                              %mi n
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo −
                              %mn 1
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{
                    \\delta(q + m^2)
                    }
                    \\;=\;
                    \- \frac{i}{\sqrt{{\vert\Delta\vert}}}
                    \\left(
                    e^{i \pi t /2 }
                    \\frac{
                    K_{n/2-1}
                    \\left(
                    m \sqrt{ q^\ast + i0^+ }
                    \\right)
                    }{
                    \\left(\sqrt{q^\ast + i0^+}\right)^{n/2 - 1}
                    }
                    \\;-\;
                    e^{-i \pi t /2 }
                    \\frac{
                    K_{n/2-1}
                    \\left(
                    m \sqrt{ q^\ast - i0^+ }
                    \\right)
                    }{
                    \\left(\sqrt{q^\ast - i0^+}\right)^{n/2 - 1}
                    }
                    \\right)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi ν
                  %annotation{:encoding => "application/x-tex"} K_\nu
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/modified+Bessel+function"} modified Bessel function
              of order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} \nu
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi ν
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_\nu(a)
              diverges for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a \to 0
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi ν
                  %annotation{:encoding => "application/x-tex"} a^{-\nu}
              (
              %a{:href => "http://dlmf.nist.gov/10.30#E2"}> DLMF 10.30.2
              ).
          %p
            (
            %a{:href => "#GelfandShilov66"}> Gel’fand-Shilov 66, III 2.11 (7), p 294
            )
          #CausalPropagator.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/causal+propagator"}> causal propagator
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≔
                    %msup
                      %mi η
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} q \coloneqq \eta^{-1}
              be the dual
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+metric"} Minkowski metric
              in
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} p+1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∝
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mrow
                        %mi δ
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo ,
                        %mi k
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msup
                          %mi m
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mi sgn
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi k
                          %mn 0
                        %mo{:stretchy => "false"} )
                      %mo ^
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta_S(x)
                    \\;\propto\;
                    \\widehat{
                    \\delta(-\eta(k,k) - m^2)
                    \\,
                    sgn(k_0)
                    }
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/causal+propagator"} causal propagator
              for the
              %a.existingWikiWord{:href => "/nlab/show/Klein-Gordon+equation"} Klein-Gordon equation
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              %a.maruku-ref{:href => "#FourierTransformOfDeltaDistributionappliedToMassShell"}
              implies that its
              %a.existingWikiWord{:href => "/nlab/show/singular+support"} singular support
              is the
              %a.existingWikiWord{:href => "/nlab/show/light+cone"} light cone
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mrow
                          %mi p
                          %mo ,
                          %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x \in \mathbb{R}^{p,1} \;\vert\; \eta(x,x) = 0\}
