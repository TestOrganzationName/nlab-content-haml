                    i \omega x = - Im(\omega) x + i Re(\omega) x
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/ContoursForHeavisideFourierTransform.png", :width => "300"}/
            %p
              has negative
              %a.existingWikiWord{:href => "/nlab/show/real+part"} real part
              for
              %em positive
              %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
              %a.existingWikiWord{:href => "/nlab/show/line+integral"} line integral
              equals the complex
              %a.existingWikiWord{:href => "/nlab/show/contour+integral"} contour integral
              over a contour
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mo +
                    %mo ⊂
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} C_+ \subset \mathbb{C}
              closing in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/upper+half+plane"} upper half plane
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} i \epsilon
              has positive
              %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
              by construction, this contour does encircle the
              %a.existingWikiWord{:href => "/nlab/show/pole"} pole
              of the
              %a.existingWikiWord{:href => "/nlab/show/integrand"} integrand
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msup
                          %mi e
                          %mrow
                            %mi i
                            %mi ω
                            %mi x
                      %mrow
                        %mi ω
                        %mo −
                        %mi i
                        %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \frac{e^{i \omega x}}{\omega - i \epsilon}
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
