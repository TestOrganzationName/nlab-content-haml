                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
              as a
              %a.existingWikiWord{:href => "/nlab/show/contour+integral"} contour integral
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x \in (0,\infty)
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mi ω
                    %mi x
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi Im
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mi x
                    %mo +
                    %mi i
                    %mi Re
                    %mo{:stretchy => "false"} (
                    %mi ω
                    %mo{:stretchy => "false"} )
                    %mi x
