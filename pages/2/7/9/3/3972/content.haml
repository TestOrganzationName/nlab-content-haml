                            %munder
                              %mi lim
                              %mrow
                                %mi ϵ
                                %mo →
                                %msup
                                  %mn 0
                                  %mo +
                            %mfrac
                              %mn 1
                              %mrow
                                %mn 2
                                %mi π
                                %mi i
                            %msubsup
                              %mo ∫
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn ∞
                              %mn ∞
                            %mfrac
                              %mrow
                                %msup
                                  %mi e
                                  %mrow
                                    %mi i
                                    %mi ω
                                    %mi x
                              %mrow
                                %mi ω
                                %mo −
                                %mi i
                                %mi ϵ
                            %mi d
                            %mi ω
                          %mtd
                            %mo =
                            %munder
                              %mi lim
                              %mrow
                                %mi ϵ
                                %mo →
                                %msup
                                  %mn 0
                                  %mo +
                            %mfrac
                              %mn 1
                              %mrow
                                %mn 2
                                %mi π
                                %mi i
                            %msub
                              %mo ∮
                              %mrow
                                %msub
                                  %mi C
                                  %mo +
                            %mfrac
                              %mrow
                                %msup
                                  %mi e
                                  %mrow
                                    %mi i
                                    %mi ω
                                    %mi x
                              %mrow
                                %mi ω
                                %mo −
                                %mi i
                                %mi ϵ
                            %mi d
                            %mi ω
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mi lim
