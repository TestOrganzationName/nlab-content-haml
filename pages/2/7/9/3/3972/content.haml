                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\underset{\epsilon \to 0^+}{\lim}
                    \\frac{1}{2 \pi i}
                    \\int_{-\infty}^\infty \frac{e^{i \omega x}}{\omega - i \epsilon} d\omega
                    \&amp; =
                    \\underset{\epsilon \to 0^+}{\lim}
                    \\frac{1}{2 \pi i}
                    \\oint_{C_+} \frac{e^{i \omega x}}{\omega - i \epsilon} d \omega
                    \\\
                    \&amp;
                    \=
                    \\underset{\epsilon \to 0^+}{\lim}
