          %h3#PrincipalValueOfPowerOfAQuadraticForm
            The principal value of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msup
                    %mi m
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 1/(q(x) + m^2)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi ℝ
                    %mi n
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} q \colon \mathbb{R}^{n} \to \mathbb{R}
            be a non-degenerate real
            %a.existingWikiWord{:href => "/nlab/show/quadratic+form"} quadratic form
            %a.existingWikiWord{:href => "/nlab/show/analytic+continuation"} analytically continued
            to a real quadratic form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
