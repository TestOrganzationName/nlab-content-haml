                    %mrow
                      %mi ω
                      %mo =
                      %mi i
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \omega = i \epsilon
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+integral+formula"} Cauchy integral formula
              in the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x \gt 0
              one gets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
