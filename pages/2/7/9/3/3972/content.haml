                            %mi i
                            %mfrac
                              %mn 1
                              %mrow
                                %mi x
                                %mo +
                                %mi i
                                %msup
                                  %mn 0
                                  %mo +
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\int_0^\infty e^{i k x} \,  dk
                    \&amp; =
                    \\underset{\epsilon \to 0^+}{\lim}
                    \\int_0^\infty e^{i k x - \epsilon k} \,  dk
                    \\\
                    \&amp; =
                    \-
                    \\underset{\epsilon \to 0^+}{\lim}
