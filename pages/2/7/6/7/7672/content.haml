                  %mo{:stretchy => "false"} )
                  %msup
                    %mi p
                    %mi k
                  %mi m
                %annotation{:encoding => "application/x-tex"} n+1 = 2(p-1)p^k m
            but the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            is missing.)
          .num_defn
            %h6#definition_7 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝕊
                      %mi p
