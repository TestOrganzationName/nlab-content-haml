                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization"} Bousfield localization
              at
              %a.existingWikiWord{:href => "/nlab/show/Morava+E-theory"} Morava E(1)-theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
