            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo −
                  %msup
                    %mi ψ
                    %mi k
                %annotation{:encoding => "application/x-tex"} 1 - \psi^k
            induces via the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
