                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E(1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %msub
                      %mi L
                      %mrow
