          %h5#characterization_via_the_adams_operations Characterization via the Adams operations
          %p (…)
          %p
            We indicate how the
            = succeed "/Adams-Quillen-Sullivan" do
              %a.existingWikiWord{:href => "/nlab/show/Adams+conjecture"} Adams conjecture
            = succeed ")." do
              %a{:href => "#Lorman13"} Lorman 13
          %p (…)
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ψ
                    %mi k
                %annotation{:encoding => "application/x-tex"} \psi^k
            for the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/Adams+operation"} Adams operation
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+K-theory"} complex K-theory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/prime"} prime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            coprime to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
