          %h2#idea Idea
          %p There is a close relationship between
          %ul
            %li
              %p
                the four real
                %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spin+geometry"} spin geometry
                and real (Majorana)
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/spin+representations"} spin representations
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
                of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/super+Poincare+Lie+algebra"} super Poincare Lie algebra
            %li
              %p
                and
                %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
                in
                %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
          %p
            This is based on the fact that in certain dimensions,
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/representation"} representation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕂
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                %annotation{:encoding => "application/x-tex"} \mathbb{K}
            one of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/normed+division+algebras"} normed division algebras
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            = succeed "." do
              %em
                %a{:href => "spin%20group#ExceptionalIsomorphisms"} The exceptional isomorphisms
