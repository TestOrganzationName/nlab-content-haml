          %h2#idea Idea
          %p
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
            of
            %a.existingWikiWord{:href => "/nlab/show/filtered+diagrams"} filtered diagrams
          %h2#characterization Characterization
          #CharacterizationOfFilteredHomotopyColimits.num_prop
            %h6#proposition Proposition
            %p
              In a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              %a.existingWikiWord{:href => "/nlab/show/regular+cardinal"} regular cardinal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              the following holds:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
                  preserve weak equivalences;
              %li
                %p
                  hence
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                        %annotation{:encoding => "application/x-tex"} \kappa
                  %a.existingWikiWord{:href => "/nlab/show/filtered+colimits"} filtered colimits
                  are already
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
          %p
            This appears as (
            %a{:href => "#Dugger00"}> Dugger 00, prop 7.3
            ).
          .proof
            %h6#proof Proof
            %p
              The point is to choose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              such that all domains and codomains of the generating cofibrations are
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
              all its objects are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+objects"} small objects
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %a.existingWikiWord{:href => "/nlab/show/compact+object"} compact object
              for some cardinal
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              to be the maximum of these.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi G
                    %mo :
                    %mi J
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F, G : J \to C
              be
              = succeed "-filtered" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F \to G
              a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              that is degreewise a weak equivalence. Using the functorial factorization provided by the
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              this may be factored as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mi H
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F \to H \to G
              where the first transformation is objectwise an acyclic cofibration and the second objectwise an acyclic fibration, and by functoriality of the factorization this sits over a factorization
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo →
                    %mi F
                    %mover
                      %mo ↪
                      %mo ≃
                    %munder
                      %mi lim
                      %mo →
                    %mi H
                    %mover
                      %mo →
                      %mrow
                    %munder
                      %mi lim
                      %mo →
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\lim_\to F \stackrel{\simeq}{\hookrightarrow} \lim_\to H \stackrel{}{\to}\lim_\to G
                    \\,.
            %p
              It remains to show that the second morphism is a weak equivalence. But by our factorization and by
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3
              applied to our componentwise weak equivalences, we have that all its components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(j) \to G(j)
              are acyclic fibrations.
            %p
              At
              %a.existingWikiWord{:href => "/nlab/show/small+object"} small object
              it is described in detail how
              = succeed "-smallness" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              implies that morphisms from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into a
              = succeed "-filtered" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo →
                          %mtd
                            %mi H
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi H
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi H
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi ⋯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo ∃
                                  %mover
                                    %mi f
                                    %mo{:stretchy => "false"} ^
                            %mo ↗
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo ∀
                                %mi f
                          %mtd
                            %munder
                              %mi lim
                              %mo →
                            %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots&amp;\to&amp;H(j-1) &amp;\to&amp; H(j) &amp;\to&amp; H(j+1) &amp;\to&amp; \cdots
                    \\\
                    \&amp;&amp;&amp;{}^{\mathllap{\exists \hat f}}\nearrow&amp;\downarrow &amp; \swarrow
                    \\\
                    \&amp;&amp;X&amp; \stackrel{\forall f}{\to} &amp;\lim_\to H
                    }
                    \\,.
            %p So given a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %munder
                              %mi lim
                              %mo →
                            %mi H
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi I
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %munder
                              %mi lim
                              %mo →
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\to&amp; \lim_\to H
                    \\\
                    \\downarrow^{\mathrlap{\in I}} &amp;&amp; \downarrow
                    \\\
                    Y &amp;\to&amp; \lim_\to G
                    }
            %p
              we are guaranteed, by the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %a.existingWikiWord{:href => "/nlab/show/small+object"} smallness
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              that we established above, a lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mi H
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %munder
                              %mi lim
                              %mo →
                            %mi H
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi I
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mo ∈
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi rlp
                                    %mo{:stretchy => "false"} (
                                    %mi I
                                    %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mo →
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} (
                            %mi j
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %munder
                              %mi lim
                              %mo →
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\to&amp; H(j) &amp;\to&amp; \lim_\to H
                    \\\
                    \\downarrow^{\mathrlap{\in I}} &amp;&amp; \downarrow^{\in \mathrlap{\in rlp(I)}}
                    \&amp;&amp;
                    \\downarrow
                    \\\
                    Y &amp;\to&amp; G(j) &amp;\to&amp; \lim_\to G
                    }
            %p
              into some component at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi J
                  %annotation{:encoding => "application/x-tex"} j \in J
              and hence a lift
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
