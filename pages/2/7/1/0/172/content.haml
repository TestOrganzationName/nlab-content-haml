              ,
          %p and specifically of
          %ul
            %li
              %p
                %em>
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} (∞,1)-sheaf
                ,
            %li
              %p
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"} geometric homotopy type
          %p
            is the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} categorification
            of the notion of, equivalently
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
                and
                %a.existingWikiWord{:href => "/nlab/show/stack"} stack
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+type"}> geometric homotopy type
                \.
          %p
            Where a sheaf is a
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            with values in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            that satisfies the sheaf condition, an
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} ∞-category
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudo
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
            is an
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-stack
            if it “satisfies descent” in that its assignment to a space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is equivalent to its
            %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            data for any
            %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            or
            %a.existingWikiWord{:href => "/nlab/show/hypercover"} hypercover
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mo •
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y^\bullet \to X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Desc
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Y
                    %mo •
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{A}(X) \to
                  Desc(Y^\bullet, \mathbf{A})
          %p
            is an equivalence. This is the
            = succeed "." do
              %em descent condition
          %p
            One important motivation for
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            from
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} 1-categorical
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher categorical context
          %p
            This is a central
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/motivation+for+sheaves%2C+cohomology+and+higher+stacks"} motivation for considering higher stacks
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/internal+%E2%88%9E-groupoid"} internal ∞-groupoid
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} sheaf topos
          %h2#definition Definition
          %p
            A well developed theory exists for
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            %a.existingWikiWord{:href => "/nlab/show/0-category"} 0-categories
            and that
            = succeed "-groupoid-values" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C0%29-category"} (∞,0)-categories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-sheaf"} (∞,1)-sheaves
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            above some degree
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sheaves+of+n-types"} sheaf of n-types
          %p
            The currently most complete picture of
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-sheaf"} (∞,1)-sheaves
            appears in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p but is based on a long development by other authors, some of which is indicated in the list of references below.
          %p
            With the general machinery of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            theory in place, the definition of the
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-sheaves"} (∞,1)-category of ∞-stacks
            is literally the same as that of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
            %a.existingWikiWord{:href => "/nlab/show/reflective+%28%E2%88%9E%2C1%29-subcategory"} reflective (∞,1)-subcategory
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Stacks
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Sh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mover
                      %mo ←
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo ⋅
                          %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ¯
                  %msub
                    %mi PSh
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\infty Stacks(C) \simeq Sh_\infty(C)
                  \\stackrel{\stackrel{\bar{(\cdot)}}{\leftarrow}}{\to}
                  PSh_\infty(C)
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-functors"} (∞,1)-category of (∞,1)-presheaves
            with values in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo ⋅
                      %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar {(\cdot)}
            – the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stackification"} ∞-stackification
            operation – is left exact.
          %p
            One of the main theorems of
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
            says that the old
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structures on simplicial presheaves
            are the canonical
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/models+for+%E2%88%9E-stack+%28%E2%88%9E%2C1%29-toposes"}> models for ∞-stack (∞,1)-toposes
              \.
          %p
            This allows to regard various old technical results in a new conceptual light and provides powerful tools for actually handling
            = succeed "-stacks." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            In particular this implies that the old definition of
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf+cohomology"} abelian sheaf cohomology
            is secretly the computation of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stackification"} ∞-stackification
            for
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan embedding
            of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial sheaves
