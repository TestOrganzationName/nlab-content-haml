          %h1#plump_ordinals Plump ordinals
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/ordinal+numbers"} ordinal numbers
            admit two
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inequalities"} inequalities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo &lt;
                %annotation{:encoding => "application/x-tex"} \lt
            and a non-strict one
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                  %annotation{:encoding => "application/x-tex"} \le
            %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
            in the von Neumann style as “the set of all smaller ordinals”, these relations are identified with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \in
            (set
            = succeed ")" do
              %span.newWikiWord
                membership
                %a{:href => "/nlab/new/membership"} ?
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊆
                %annotation{:encoding => "application/x-tex"} \subseteq
            (
            %a.existingWikiWord{:href => "/nlab/show/subset"}> containment
            ). And when ordinals are defined in a structural theory as certain well-ordered sets, the relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \le
            refers to inclusion as an
            %span.newWikiWord
              initial subset
              %a{:href => "/nlab/new/initial+subset"} ?
            (a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/simulation"} simulation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo &lt;
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\lt B
            refers to such an inclusion as the strict slice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo{:stretchy => "false"} |
                  %mi y
                  %mo &lt;
                  %mi x
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{ y | y \lt x \}
            of some element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/classical+mathematics"} classical mathematics
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo &lt;
                %annotation{:encoding => "application/x-tex"} \lt
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \le
            are definable in terms of each other’s negation:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo &lt;
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\lt B
            if and only if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ≤
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg(B\le A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≤
                  %mi B
                %annotation{:encoding => "application/x-tex"} A\le B
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo &lt;
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg(B\lt A)
            %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            this is no longer true (although
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \leq
            can still be defined from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo &lt;
                %annotation{:encoding => "application/x-tex"} \lt
            in a more round-about way). This phenomenon occurs for other ordered structures as well; for instance, for the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≤
                %annotation{:encoding => "application/x-tex"} \le
            is definable as the negation of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &gt;
                  %annotation{:encoding => "application/x-tex"} \gt
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi x
                    %mo ≤
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x\le x
              \.
            %li
              Not
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x \lt x
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≤
                      %mi y
                      %mo ≤
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x\le y\le z
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≤
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x\le z
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x\lt y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≤
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x\le y
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi y
                      %mo &lt;
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x\lt y\lt z
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x\lt z
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi y
                      %mo ≤
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x\lt y\le z
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x\lt z
            %li
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≤
                      %mi y
                      %mo &lt;
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x\le y\lt z
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo &lt;
                      %mi z
                    %annotation{:encoding => "application/x-tex"} x\lt z
          %p
            For the constructive ordinal numbers, these are all satisfied
            = succeed "." do
              %em except for the last one
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ≤
                  %mi y
                  %mo &lt;
                  %mi z
                %annotation{:encoding => "application/x-tex"} x\le y\lt z
            implies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo &lt;
                  %mi z
                %annotation{:encoding => "application/x-tex"} x\lt z
            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi z
                  %annotation{:encoding => "application/x-tex"} x,y,z
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            holds: consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo =
                  %mn 2
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} z = 2 = \{0,1\}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo =
                  %mn 1
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} y = 1 = \{0\}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} |
                  %mi P
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} x = \{0 | P\}
            for some proposition
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            However, Paul Taylor
            %a{:href => "#Taylor"} (Taylor)
            realized that this last property can be recovered by essentially “restricting to the subclass of ordinals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                %annotation{:encoding => "application/x-tex"} z
            for which it holds hereditarily”. These are the
            = succeed "." do
              %em plump ordinals
          %h2#definition Definition
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is
            %strong plump
            if
          %ol
            %li
              every ordinal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo &lt;
                    %mi A
                  %annotation{:encoding => "application/x-tex"} B\lt A
              is plump, and
            %li
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ≤
                    %mi B
                    %mo &lt;
                    %mi A
                  %annotation{:encoding => "application/x-tex"} C\le B\lt A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a plump ordinal, then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo &lt;
                      %mi A
                    %annotation{:encoding => "application/x-tex"} C\lt A
          %p
            It is not obvious that this definition is sound (i.e. non-circular), but it can be shown to be so based on a well-founded relation (other than
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            itself). It does, however, require the existence of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/power+sets"} power sets
            %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative mathematics
            which denies the existence of those.
          %h2#examples Examples
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo =
                  %mo ∅
                %annotation{:encoding => "application/x-tex"} 0 = \varnothing
            is trivially plump.
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is plump,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo =
                  %mi 𝒫
                  %mn 0
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} 1 = \mathcal{P}0 = \{0\}
            is also plump.
          %p
            More generally, any subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            (which may be thought of as a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/truth+value"} truth value
          %p
            But
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} 2 = \{0,1\}
            (the set of classical truth values) with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo &lt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0 \lt 1
            is plump if and only if excluded middle holds.
          %p
            In contrast,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo =
                  %mi 𝒫
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \Omega = \mathcal{P}1
            (the set of all truth values) with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo &lt;
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 0 \lt 1
            (as the only instance of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                  %annotation{:encoding => "application/x-tex"} {\lt}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            is the plump version of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            iff excluded middle holds.
          %p
            The plump version of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 3
                %annotation{:encoding => "application/x-tex"} 3
            may be quite large; it consists of all
            %a.existingWikiWord{:href => "/nlab/show/lower+sets"} lower sets
            (downwards-closed collections) of truth values. So it includes
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %a.existingWikiWord{:href => "/nlab/show/downset"} downset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ↓
                  %mi p
                %annotation{:encoding => "application/x-tex"} {\downarrow}p
            (the lower set generated by
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            (not just
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo =
                  %mo{:stretchy => "false"} ↓
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 1 = {\downarrow}0
            and
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo =
                    %mo{:stretchy => "false"} ↓
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \Omega = {\downarrow}1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0,1,2\}
          %p
            Generalizing most of these examples, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is a plump ordinal, then the successor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi α
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \alpha^+
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo +
                    %mn 1
                    %mo =
                    %mi α
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mi α
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \alpha + 1 = \alpha \cup \{\alpha\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo &lt;
                  %mi α
                %annotation{:encoding => "application/x-tex"} 0 \lt \alpha
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi α
                      %mo +
                    %mo =
                    %mi α
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \alpha^+ = \alpha + 1
          %p Any downwards-closed subset of a plump ordinal is also a plump ordinal.
