                        %a.existingWikiWord{:href => "/nlab/show/colorability"} colorability
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/knot+group"} knot group
                    %li
                      %p
                        %span.newWikiWord
                          knot genus
                          %a{:href => "/nlab/new/knot+genus"} ?
                    %li
                      %p polynomial knot invariants
                      %p
                        (
                        %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} observables
                        of
                        %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative
                        = succeed ")" do
                          %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Jones+polynomial"} Jones polynomial
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/HOMFLY+polynomial"} HOMFLY polynomial
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Alexander+polynomial"} Alexander polynomial
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Reshetikhin-Turaev+invariants"} Reshetikhin-Turaev invariants
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Vassiliev+knot+invariants"} Vassiliev knot invariants
                      %p
                        (
                        %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} observables
                        of
                        %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} pertrubative
                        = succeed ")" do
                          %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Khovanov+homology"} Khovanov homology
                    %li
                      %p
                        %span.newWikiWord
                          Kauffman bracket
                          %a{:href => "/nlab/new/Kauffman+bracket"} ?
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/link+invariants"} link invariants
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Milnor+mu-bar+invariants"} Milnor mu-bar invariants
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/linking+number"} linking number
                  %p
                    %strong Related concepts:
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Vassiliev+skein+relation"} Vassiliev skein relation
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Seifert+surface"} Seifert surface
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/virtual+knot+theory"} virtual knot theory
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Dehn+surgery"}> Dehn surgery
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/Kirby+calculus"} Kirby calculus
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/volume+conjecture"} volume conjecture
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/arithmetic+topology"} arithmetic topology
                  .property
                    category:
                    %a.category_link{:href => "/nlab/all_pages/knot+theory"} knot theory
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#method"} Method
              %li
                %a{:href => "#results"} Results
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
              %ul
                %li
                  %a{:href => "#general"} General
                %li
                  %a{:href => "#in_chernsimons_theory"} In Chern-Simons theory
          %h2#idea Idea
          %p
            Dehn surgery is a method for constructing one
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            from another, especially one
            %a.existingWikiWord{:href => "/nlab/show/3-manifold"} 3-manifold
            from another, by a kind of cut-and-paste procedure.
          %h2#method Method
          %p
            A standard application of Dehn surgery is
            %a.existingWikiWord{:href => "/nlab/show/surgery"} surgery
            along a
            %a.existingWikiWord{:href => "/nlab/show/link"} link
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            in a
            %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} S^3
            %em Zahn
            surgery
            %sup#fnref:1>
              %a{:href => "#fn:1", :rel => "footnote"} 1
            ):
          %ul
            %li
              %p
                Form the
                %a.existingWikiWord{:href => "/nlab/show/complement"} complement
                in the
                %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
                of a
                %a.existingWikiWord{:href => "/nlab/show/tubular+neighborhood"} tubular neighborhood
                of the
                %a.existingWikiWord{:href => "/nlab/show/embedding+of+topological+spaces"} embedded
                %a.existingWikiWord{:href => "/nlab/show/link"} link
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo ↪
                        %msup
                          %mi S
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} L \hookrightarrow S^3
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo ×
                        %mi int
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi D
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L \times int(D^2)
                = succeed "." do
                  %em Dehn drilling
                %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} manifold with boundary
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                      %annotation{:encoding => "application/x-tex"} M
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %mi M
                      %mo ≅
                      %mi L
                      %mo ×
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \partial M \cong L \times S^1
                can be viewed as the boundary of a
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                of
                %a.existingWikiWord{:href => "/nlab/show/solid+tori"} solid tori
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo ×
                        %msup
                          %mi D
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} L \times D^2
            %li
              %p
                To each of the
                %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} C_1, \ldots, C_n
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∂
                        %mi M
                      %annotation{:encoding => "application/x-tex"} \partial M
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϕ
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi ϕ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \phi_1, \ldots, \phi_n
                %a.existingWikiWord{:href => "/nlab/show/union"} union
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ϕ
                        %mn 1
                      %mo ∪
                      %mi …
                      %mo ∪
                      %msub
                        %mi ϕ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \phi_1 \cup \ldots \cup \phi_n
                is a homeomorphism
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo :
                        %mo ∂
                        %mi M
                        %mo →
                        %mo ∂
                        %mi M
                      %annotation{:encoding => "application/x-tex"} \phi: \partial M \to \partial M
                %em Dehn filling
                by constructing the
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                of an evident
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/span"} span
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo ∂
                              %mi M
                            %mtd
                              %mover
                                %mo ⟶
                                %mi ϕ
                            %mtd
                              %mo ∂
                              %mi M
                          %mtr
                            %mtd
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi incl
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi incl
                          %mtr
                            %mtd
                              %mi M
                            %mtd
                            %mtd
                              %mi L
                              %mo ×
                              %msup
                                %mi D
                                %mn 2
                              %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\partial M
                      \&amp;
                      \\overset{\phi}{\longrightarrow}
                      \&amp; \partial M
                      \\\
                      \\mathllap{incl}
                      \\downarrow
                      \&amp; &amp;
                      \\downarrow
                      \\mathrlap{incl}
                      \\\
                      M
                      \&amp;
                      \&amp;
                      L \times D^2,
                      }
              %p
                thus refilling the drilled portion, but in a new way (along
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} \phi
                %a.existingWikiWord{:href => "/nlab/show/3-manifold"} 3-manifold
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
          %p
            Some further notes: the surgery can be done one
            %a.existingWikiWord{:href => "/nlab/show/solid+torus"} solid torus
            at a time. A homeomorphism on a boundary torus
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo ×
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} S^1 \times S^1
            sends a meridian
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mn 1
                  %mo ×
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} S_1 \times \{1\}
            to some simple closed curve that is homotopic to a curve of rational slope
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} /
                  %mi q
                %annotation{:encoding => "application/x-tex"} p/q
            (the curve which is the image of the line
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} /
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mi x
                %annotation{:encoding => "application/x-tex"} y = (p/q)x
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^2
            under the quotient map
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo →
                    %msup
                      %mi ℝ
                      %mn 2
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi ℤ
                      %mn 2
                    %mo ≅
                    %msup
                      %mi S
                      %mn 1
                    %mo ×
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^2 \to \mathbb{R}^2/\mathbb{Z}^2 \cong S^1 \times S^1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} /
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p/q
            = succeed "." do
              %em surgery coefficient
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            = succeed "." do
              %em integral surgery
          %p
            Put a bit different: given a
            %a.existingWikiWord{:href => "/nlab/show/framed+link"} framed link
            in an
            %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
            3-manifold like
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} S^3
            %a.existingWikiWord{:href => "/nlab/show/Dehn+twist"} twists
            it an integral number of times according to the framing, and then reattaches it.
          %h2#results Results
          .num_theorem
            %h6#theorem Theorem
            %p
              %strong (Lickorish-Wallace)
              Every
              %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
              %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
              %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed
              %a.existingWikiWord{:href => "/nlab/show/3-manifold"} 3-manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              arises by performing an integral Dehn surgery along a
              %a.existingWikiWord{:href => "/nlab/show/link"} link
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ↪
                    %msup
                      %mi S
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} L \hookrightarrow S^3
              (i.e., surgery along a framed link).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kirby+calculus"} Kirby calculus
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/surgery+theory"} surgery theory
          %h2#references References
          %h3#general General
          %p
            Named after
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Max+Dehn"} Max Dehn
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Dehn_surgery"} Dehn surgery
          %h3#in_chernsimons_theory In Chern-Simons theory
          %p
            Relation between
            %a.existingWikiWord{:href => "/nlab/show/Dehn+surgery"} Dehn surgery
            and
            %a.existingWikiWord{:href => "/nlab/show/Wilson+loop+observables"} Wilson loop observables
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
          %ul
            %li
              %p
                E. Guadagnini,
                = succeed "," do
                  %em Surgery rules in quantum Chern-Simons field theory
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/0550-3213(92)90037-C"} doi:10.1016/0550-3213(92)90037-C
            %li
              %p
                Boguslaw Broda,
                %em Chern-Simons theory on an arbitrary manifold via surgery
                (
                %a{:href => "https://arxiv.org/abs/hep-th/9305051"}> arXiv:hep-th/9305051
                )
          .footnotes
            %hr/
            %ol
              %li#fn:1
                %p
                  Yes, that’s supposed to be a little joke. ‘Zahn’ here is the German word.
                  %a{:href => "#fnref:1", :rev => "footnote"} ↩
