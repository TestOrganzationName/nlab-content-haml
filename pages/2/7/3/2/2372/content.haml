          %h2#homotopy_theory_for_algebras
            Homotopy theory for
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              for
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} A_\infty
              %a.existingWikiWord{:href => "/nlab/show/A-infinity+algebra"} algebras
          %p
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            a complex with the structure of an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            %a.existingWikiWord{:href => "/nlab/show/A-infinity+algebra"} algebra
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %mi W
                %annotation{:encoding => "application/x-tex"} V \to W
            a morphism of chain cmoplexes, we get an induced
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          %p
            Application: for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            a
            %a.existingWikiWord{:href => "/nlab/show/differential+graded+algebra"} differential graded algebra
            its
            %a.existingWikiWord{:href => "/nlab/show/chain+homology+and+cohomology"} chain cohomology
            inherits the structure of an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/A-infinity+algebra"} algebra
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Massey+product"} Massey product
          .un_theorem
            %h6#theorem_getzlerjones_hinich_bergermoerdijk_spitzweck Theorem (Getzler–Jones, Hinich, Berger–Moerdijk, Spitzweck)
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure on the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of differential graded
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/operad"} operad
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              = succeed "es)." do
                %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
          .un_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} P_\infty
              is a cofibrant dg-operad, then under some assumptions
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi P
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} P_\infty
              %a.existingWikiWord{:href => "/nlab/show/algebra+for+an+operad"} algebra for an operad
              structures are preserved by weak equivalences.
          .un_defn
            %h6#definition Definition
            %p A quasi-free dg-operad is one that is free after forgetting the differential
          .un_prop
            %h6#proposition_2 Proposition
            %p Cofibrant operads are the retracts of quasi-free operads.
          %p In particular quasi-free operads are cofibrant.
          %p So we look for quasi-free resolutions.
          .un_defn
            %h6#definition_2 Definition
            %p
              Gerstenhaber algebra: essentially a
              %a.existingWikiWord{:href => "/nlab/show/Poisson+algebra"} Poisson algebra
              in the dg context.
          .un_remark
            %h6#question Question
            %p How to define a Gerstenhaber algebra up to homotopy?
          %p
            Extend the operations dfined by Gerstenhaber on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CH
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CH(A,A)
            whjich induce the Gerstenhaber algebra on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HH
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} HH(A,A)
            to a
            = succeed "." do
              %strong Gerstenhaber algebra up to homotopy
          %p
            So we have a strict structure on Hochschild homology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi HH
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} HH(A,A)
            and are asking for from which homotopy structure it may come on Hochschild chains in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CH
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CH(A,A)
          %p
            So we define the
            %span.newWikiWord
              Gerstenhaber algebra operad
              %a{:href => "/nlab/new/Gerstenhaber+algebra+operad"} ?
            whose
            %a.existingWikiWord{:href => "/nlab/show/algebra+for+an+operad"} algebra for an operad
            are
            = succeed "s." do
              %span.newWikiWord
                Gertsenhaber algebra
                %a{:href => "/nlab/new/Gertsenhaber+algebra"} ?
          %p It is generated of course from the product operation and the bracket operation modulo the associativity constraint for the product, the Jacobi identity for the bracket and the Leibnitz property for their interaction.
          %p
            These relations are always encoded in
            %em quadratic
            expressions.
          %h3#koszul_duality_theory_for_operads Koszul duality theory for operads
          %p
            the dual notion of
            %a.existingWikiWord{:href => "/nlab/show/operad"} operad
            is that of
            %a.existingWikiWord{:href => "/nlab/show/cooperad"} cooperad
            (reverse all arrows)
          .un_theorem
            %h6#theorem_ginzburgkapranov_getzlerjones Theorem (Ginzburg–Kapranov, Getzler–Jones)
            %p
              There exist
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo :
                    %mo{:stretchy => "false"} {
                    %mi dg
                    %mi operads
                    %mo{:stretchy => "false"} }
                    %mo ↔
                    %mo{:stretchy => "false"} {
                    %mi dg
                    %mi cooperads
                    %mo{:stretchy => "false"} }
                    %mo :
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"}
                    B : \{dg operads\} \leftrightarrow \{dg cooperads\} : \Omega
            %p
              given by
              %a.existingWikiWord{:href => "/nlab/show/bar+and+cobar+construction"} bar and cobar construction
            %p under this equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi quadratic
                    %mi operad
                    %mi P
                    %mover
                      %mo →
                      %mrow
                        %mi Koszul
                        %mi duality
                    %mi cooperad
                    %mi P
                    %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    quadratic operad P \stackrel{Koszul duality}{\to}
                    cooperad P'
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn ∞
                    %mo :
                    %mo =
                    %mi Ω
                    %mi P
                    %mo ′
                    %mo →
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P_\infty := \Omega P' \to P
              morphism of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/dg-operad"} dg-operad
          .un_defn
            %h6#definition_koszul_operad Definition (Koszul operad)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is Koszul if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn ∞
                    %mo =
                    %mi Ω
                    %mi P
                    %mo ′
                    %mover
                      %mo →
                      %mo ≃
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P_\infty = \Omega P' \stackrel{\simeq}{\to} P
              is a quasi-isomorphism, i.e. a cofibrant replacement.
          .un_prop
            %h6#proposition_ginzburgkapranov_getzlerjones Proposition (Ginzburg–Kapranov, Getzler–Jones)
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P = F(V)/(R)
              be a quadratic operad with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} dim(V) \lt + \infty
              The
              %em linear dual
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msup
                      %mo ′
                      %mo *
                  %annotation{:encoding => "application/x-tex"} P'^*
              is a quadratic operad aabd the suspension of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %msup
                        %mo ′
                        %mo *
                      %mo ≃
                      %mo ′
                      %mo :
                      %mo =
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi V
                        %mo *
                      %mo ⊗
                      %mi sgn
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi R
                        %mo ⊥
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} P'^* \simeq ' := F(V^* \otimes sgn)/(R^{\perp})
          .proof
            %h6#method Method
            %p
              Compute
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} P'
              and its operadic structure with this formula, then dualize everything to get this formula.
          .un_prop
            %h6#proposition_getzlerjones_markl Proposition (Getzler–Jones, Markl)
            %p
              The Gerstenhaber operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is Koszul.
          %h3#homotopy_gerstenhaber_or_algebras
            Homotopy Gerstenhaber or
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} G_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi G
                  %mo ′
                  %mo =
                  %mi Com
                  %mo ∘
                  %msup
                    %mi Lie
                    %mn 1
                %annotation{:encoding => "application/x-tex"}
                  G = G' = Com \circ Lie^1
          .un_defn
            %h6#definition_batalinvilkovisky_algebra Definition (Batalin–Vilkovisky algebra)
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/Gerstenhaber+algebra"} Gerstenhaber algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with a unary operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo :
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \Delta : A \to A
              of degree +1 such that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mn 2
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \Delta^2 = 0
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [-,-]
                  measures failure of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                      %annotation{:encoding => "application/x-tex"} \Delta
                  to be a derivation with respect to the product
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ⋅
                        %annotation{:encoding => "application/x-tex"} \cdot
          %p
            This also is the algebra over an operad. But this operad is no longer a
            = succeed "." do
              %span.newWikiWord
                quadratic operad
                %a{:href => "/nlab/new/quadratic+operad"} ?
          %p So we define:
          .un_defn
            %h6#definition_quadratic_bvalgebra Definition (quadratic BV-algebra)
            %p
              As above but now demand
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              a derivation of both the product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋅
                  %annotation{:encoding => "application/x-tex"} \cdot
              and the bracket
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-,-]
          %p This is a first step in the resolution process.
          %p Now the corresponding operad is Koszul. So we get
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⇒
                  %msub
                    %mi qBV
                    %mn ∞
                  %mo :
                  %mo =
                  %mi Ω
                  %mi q
                  %mi BV
                  %mo ′
                  %mover
                    %mo →
                    %mo ≃
                %annotation{:encoding => "application/x-tex"}
                  \\Rightarrow qBV_\infty := \Omega q BV' \stackrel{\simeq}{\to}
          %p as a quasi-free resolution.
          .un_defn
            %h6#definitionproposition_a_homotopy_bvalgebra_is_an__for_that
              Definition-proposition** A homotopy BV-algebra is an
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
              for that.
            %p
              In terms of this we have a homotopy BV-algebra structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CH
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CH(A,A)
          .un_remark
            %h6#idea Idea
            %p
              Add a suitable differential
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mn 1
                      %mo :
                      %mi qBV
                      %mo ′
                      %mo →
                      %mi qBV
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} d_1 : qBV' \to qBV'
          %h3#koszul_duality_theory Koszul duality theory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P = F(V)/(R)
            be a quadratic and linear presentation of a dg-operad
          %p
            let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi V
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} q : F(V) \to F(V)^{(2)}
            the quadratic projection
          %p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi qP
                  %mo :
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi qR
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} qP := F(V)/(qR)
            the quadratic analogue of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
          .un_defn
            %h6#definition_quadraticlinear_koszul_operad Definition (quadratic-linear Koszul operad)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo =
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P = F(V)/(R)
              is a Koszul operad if
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo ∩
                        %mi V
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mo ⇔
                        %mi V
                        %mi is
                        %mi minimal
                      %annotation{:encoding => "application/x-tex"} R \cap V = \{0\} \Leftrightarrow V is minimal
              %li
                %p (more …)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi q
                        %mi P
                      %annotation{:encoding => "application/x-tex"} q P
                  is Koszul
          %p This now yields a good machinery for cofibrant resolutions for Koszul operads.
          .un_theorem
            %h6#theorem Theorem
            %p
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is a quadratic linear Koszul operad then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi P
                      %mn ∞
                    %mo :
                    %mo =
                    %mi Ω
                    %mi P
                    %mo ′
                    %mover
                      %mo →
                      %mo ≃
                    %mi P
                  %annotation{:encoding => "application/x-tex"}
                    P_\infty := \Omega P' \stackrel{\simeq}{\to} P
          .un_theorem
            %h6#theorem_2 Theorem
            %p This applies to the BV operad.
          .un_defn
            %h6#definition_3 Definition
            %p
              A
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi BV
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} BV_\infty
                \-algebra
              is an algebra over this cofibrant replacement for the BV operad.
          %h3#applications Applications
          .un_theorem
            %h6#theorem_ginzburg_tradler_menichi Theorem (Ginzburg, Tradler, Menichi)
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Frobenius+algebra"} Frobenius algebra
              %li
                %p
                  Its
                  %a.existingWikiWord{:href => "/nlab/show/Hochschild+cohomology"} Hochschild cohomology
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi HH
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} HH(A,A)
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/BV-algebra"} BV-algebra
          .un_theorem
            %h6#theorem_cyclic_deligne_conjecture Theorem (Cyclic Deligne conjecture)
            %p …
          %h3#comparison_to_other_definitions Comparison to other definitions
          %p
            Another definition of homotopy BV-algebra by Kravchenko – this turns out to be a special case of the definition here by setting some operations to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            (her algebra is not an algebra over a cofibrant operad).
          %p Another definition by Tamarkin–Tsygan: this is more general than the one here. TT have many more operations, namely operations with sevearl outputs.
          %p The notion here also difers from that in Beilinson–Drinfeld.
          %h3#pbw_isomorphism PBW isomorphism
          %p
            The free operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(V)
            is filtered
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⇒
                  %mi P
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Rightarrow P = F(V)/(R)
            is filtered. There is then a morphism of operads
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mi P
                    %mo →
                    %mi gr
                    %mi P
                  %annotation{:encoding => "application/x-tex"} q P \to gr P
          .un_theorem
            %h6#theorem_3 Theorem
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              Koszul we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mi P
                    %mo ≃
                    %mi gr
                    %mi P
                  %annotation{:encoding => "application/x-tex"}
                    q P \simeq gr P
            %p For instance
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mi BV
                    %mo ≃
                    %mi gr
                    %mi P
                  %annotation{:encoding => "application/x-tex"}
                    q BV \simeq gr P
          %h3#relation_with_framed_little_disks Relation with framed little disks
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi dD
                %annotation{:encoding => "application/x-tex"} dD
            be the
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/framed+little+disk+operad"} framed little disk operad
          %p
            Getzler:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi fD
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi BV
                  %annotation{:encoding => "application/x-tex"} H_\bullet(fD) \simeq BV
          .un_theorem
            %h6#theorem_gianciracusasalvatoresevera Theorem (Gianciracusa–Salvatore–Severa)
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi fD
                  %annotation{:encoding => "application/x-tex"} fD
              is formal, i.e. quasi-isomorphic by zig-zags to its homology
          %h3#relation_with_tcft Relation with TCFT
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/topological+conformal+field+theory"} topological conformal field theory
            is an algebra over the
            %a.existingWikiWord{:href => "/nlab/show/PROP"} PROP
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi ℛ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_\bullet(\mathcal{R})
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
          .un_theorem
            %h6#theorem_4 Theorem
            %p
              Any
              %a.existingWikiWord{:href => "/nlab/show/TCFT"} TCFT
              carries a homotopy BV-algebra structure which lifts the
              %a.existingWikiWord{:href => "/nlab/show/BV-algebra"} BV-algebra
              structure of Getzler in its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homology"} homology
          %h3#homotopy_theory_for__algebras
            Homotopy theory for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi P
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} P_\infty
            algebras
          %h3#deformation_theory Deformation theory
          .un_prop
            %h6#proposition_3 Proposition
            %p In some sense homotopy BV is a formal extension of homotopy Gerstenhaber.
          .un_theorem
            %h6#theorem_generalized_lianzuckermann_conjecture Theorem (generalized Lian–Zuckermann conjecture)
            %p
              For any
              %span.newWikiWord
                topological vertex algebra
                %a{:href => "/nlab/new/topological+vertex+algebra"} ?
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi BV
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} BV_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              which extends Lian–Zuckermann operations on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and which lifts the
              %a.existingWikiWord{:href => "/nlab/show/BV-algebra"} BV-algebra
              structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H(A)
          %h2#related_entries Related entries
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/quantum+L-infinity+algebra"} quantum L-infinity algebra
          %h2#references References
          %p The above material probably roughly follows the talk slides
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Bruno+Vallette"}> Bruno Vallette
              ,
              %em Homotopy Batalin-Vilkovisky algebras
              ,
              = succeed ")" do
                %a{:href => "https://www.math.univ-paris13.fr/~vallette/download/Homotopy%20BV.pdf"} slides
          %p The corresponding article is
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Imma+Galvez-Carrillo"}> Imma Galvez-Carrillo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andy+Tonks"} Andy Tonks
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bruno+Vallette"} Bruno Vallette
              %em Homotopy Batalin-Vilkovisky algebras
              (
              %a{:href => "http://arxiv.org/abs/0907.2246"}> arXiv:0907.2246
              )
          %p See also
          %ul
            %li
              Imma Gálvez, Vassily Gorbounov, Andrew Tonks,
              = succeed "," do
                %em Homotopy Gerstenhaber structures and vertex algebras
              %a{:href => "http://arxiv.org/abs/math/0611231"} math/0611231.QA
