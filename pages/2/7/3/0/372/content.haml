          %h2#definition Definition
          %p
          .num_defn
            %h6 Definition
            %p
              An
              %strong initial object
              in a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
              such that for all objects
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} x \,\in\, \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∅
                    %mover
                      %mo →
                      %mrow
                        %mo ∃
                        %mo !
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \varnothing \xrightarrow{\exists !} x
              with
              %a.existingWikiWord{:href => "/nlab/show/source"} source
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∅
                    %annotation{:encoding => "application/x-tex"} \varnothing
              %a.existingWikiWord{:href => "/nlab/show/target"} target
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          %p
          .num_remark
            %h6 Remark
            %p
              An initial object, if it exists, is unique up to unique
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %a.existingWikiWord{:href => "/nlab/show/the"} the
              initial object.
          %p
          #InitialObjectIsEmptyColimit.num_remark
            %h6 Remark
            %p
              When it exists, the initial object is the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              over the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/empty+diagram"} empty diagram
          %p
          .num_remark
            %h6 Remark
            %p
              Initial objects are also called
              = succeed "," do
                %em coterminal
              = succeed "," do
                %em coterminators
              = succeed "," do
                %em universal initial
              = succeed "," do
                %em co-universal
              = succeed "." do
                %em universal
          %p
          .num_defn
            %h6 Definition
            %p
              An initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∅
                  %annotation{:encoding => "application/x-tex"} \varnothing
              is called a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/strict+initial+object"} strict initial object
              if all morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mover
                      %mo →
                      %mspace{:width => "thickmathspace"}
                    %mo ∅
                  %annotation{:encoding => "application/x-tex"} x \xrightarrow{\;} \varnothing
              into it are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              %br/
          %p
          .num_remark
            %h6 Remark
            %p
              Initial objects are the
              %a.existingWikiWord{:href => "/nlab/show/duality"} dual
              concept to
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/terminal+objects"} terminal objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is the same as a terminal object in the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mi op
                    %annotation{:encoding => "application/x-tex"} C^{op}
              %br/
          %p
          .num_remark
            %h6 Remark
            %p
              An object that is both initial and
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
              is called a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
          %h2#examples Examples
          %ul
            %li
              %p
                An initial object in a
                %a.existingWikiWord{:href => "/nlab/show/partial+order"} poset
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/bottom+element"} bottom element
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
                is an initial object in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %li
              %p
                Likewise, the
                %a.existingWikiWord{:href => "/nlab/show/empty+category"} empty category
                is an initial object in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                %a.existingWikiWord{:href => "/nlab/show/empty+space"} empty space
                is an initial object in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/trivial+group"} trivial group
                is the initial object (in fact, the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
                %a.existingWikiWord{:href => "/nlab/show/Grp"} Grp
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/ring"} ring
                of
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                is the initial object of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Ring"} Ring
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/field"} field
                of
                %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Q}
                is the initial object of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Field
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} Field_0
                (category of fields with
                %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} 0
                %a.existingWikiWord{:href => "/nlab/show/prime+field"} prime field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_p
                is the initial object of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Field
                        %mi p
                    %annotation{:encoding => "application/x-tex"} Field_p
                (category of fields with characteristic
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                %a.existingWikiWord{:href => "/nlab/show/Field"} Field
                (category of all fields), which actually doesn’t have one at all.
            %li
              %p
                The initial object of a
                %a.existingWikiWord{:href => "/nlab/show/under+category"} coslice category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:stretchy => "false"} /
                      %mi C
                    %annotation{:encoding => "application/x-tex"} x/C
                is the
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo →
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x \to x
            %li
              %p
                An initial object in a category of
                %a.existingWikiWord{:href => "/nlab/show/central+extensions"} central extensions
                of a given algebraic object is called a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/universal+central+extension"} universal central extension
          %h2#properties Properties
          %h3#left_adjoints_to_constant_functors Left adjoints to constant functors
          %p
          #AdjointsToConstantFunctors.num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
            %ol
              %li
                %p The following are equivalent:
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                      has a
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  %li
                    %p
                      the unique
                      %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                            %mo →
                            %mo *
                          %annotation{:encoding => "application/x-tex"} \mathcal{C} \to \ast
                      to the
                      %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                      has a
                      %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo *
                            %munderover
                              %mo ⊥
                              %munder
                                %mo ⟶
                                %mrow
                              %mover
                                %mo ⟵
                                %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"}
                            \\ast
                            \\underoverset
                            {\underset{}{\longrightarrow}}
                            {\overset{}{\longleftarrow}}
                            {\bot}
                            \\mathcal{C}
                %p
                  Under this equivalence, the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  is identified with the image under the right adjoint of the unique object of the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              %li
                %p Dually, the following are equivalent:
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                      has an
                      = succeed ";" do
                        %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  %li
                    %p
                      the unique
                      %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                            %mo →
                            %mo *
                          %annotation{:encoding => "application/x-tex"} \mathcal{C} \to \ast
                      to the
                      %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                      has a
                      %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                            %munderover
                              %mo ⊥
                              %munder
                                %mo ⟶
                                %mrow
                              %mover
                                %mo ⟵
                                %mrow
                            %mo *
                          %annotation{:encoding => "application/x-tex"}
                            \\mathcal{C}
                            \\underoverset
                            {\underset{}{\longrightarrow}}
                            {\overset{}{\longleftarrow}}
                            {\bot}
                            \\ast
                %p
                  Under this equivalence, the
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  is identified with the image under the left adjoint of the unique object of the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
            %p
          .proof
            %h6#proof Proof
            %p
              Since the unique
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              in the
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              is
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              is directly the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}( L(\ast) , X )
                    \\;\simeq\;
                    Hom_{\ast}( \ast, R(X) )
                    \=
                    \\ast
            %p
              or of a
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}( X , R(\ast) )
                    \\;\simeq\;
                    Hom_{\ast}( L(X), \ast ) = \ast
                    \\,,
            %p respectively.
          %h3#ConesOverTheIdentity Cones over the identity
          %p
            By definition, an initial object is equipped with a universal
            %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
            under the unique functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \emptyset\to C
            from the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/empty+category"} empty category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is initial, the unique morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo !
                  %mo :
                  %mi I
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} !: I \to x
            form a cone
            %em over
            the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mi I
                  %mo →
                  %msub
                    %mi Id
                    %mi C
                %annotation{:encoding => "application/x-tex"} \Delta I \to Id_C
            from the
            %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant functor
            at the initial object to the identity functor. In fact this is almost another characterization of an initial object (e.g.
            = succeed "):" do
              %a{:href => "#MacLane"} MacLane, p. 229-230
          #cone.num_lemma
            %h6#lemma Lemma
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} I\in C
              is an object equipped with a natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi Δ
                    %mi I
                    %mo →
                    %msub
                      %mi Id
                      %mi C
                  %annotation{:encoding => "application/x-tex"} p:\Delta I \to Id_C
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi I
                      %mo =
                      %msub
                        %mn 1
                        %mi I
                      %mo :
                      %mi I
                      %mo →
                      %mi I
                    %annotation{:encoding => "application/x-tex"} p_I = 1_I : I\to I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is an initial object of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .proof
            %h6#proof_2 Proof
            %p
              Obviously
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              has at least one morphism to every other object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} X\in C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi X
                    %annotation{:encoding => "application/x-tex"} p_X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi I
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f:I\to X
              must be equal to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi X
                    %annotation{:encoding => "application/x-tex"} p_X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              implies that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} Id
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msub
                        %mi p
                        %mi I
                      %mo =
                      %msub
                        %mi p
                        %mi X
                      %mo ∘
                      %msub
                        %mi Δ
                        %mi I
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Id_C(f) \circ p_I = p_X \circ \Delta_I(f)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi I
                    %mo =
                    %msub
                      %mn 1
                      %mi I
                  %annotation{:encoding => "application/x-tex"} p_I = 1_I
              this is to say
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∘
                      %msub
                        %mn 1
                        %mi I
                      %mo =
                      %msub
                        %mi p
                        %mi X
                      %mo ∘
                      %msub
                        %mn 1
                        %mi I
                    %annotation{:encoding => "application/x-tex"} f \circ 1_I = p_X \circ 1_I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %msub
                      %mi p
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f=p_X
              as desired.
          #LimitOverIdentityFunctorIsInitialObject.num_theorem
            %h6#theorem Theorem
            %p
              An object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              in a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is initial iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is the
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              of the
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Id
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Id_C
          .proof
            %h6#proof_3 Proof
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is initial, then there is a
              %a.existingWikiWord{:href => "/nlab/show/cone"} cone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo !
                      %mi X
                    %mo :
                    %mi I
                    %mo →
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi X
                        %mo ∈
                        %mi Ob
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (!_X: I \to X)_{X \in Ob(C)}
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Id
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Id_C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi X
                    %mo :
                    %mi A
                    %mo →
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi X
                        %mo ∈
                        %mi Ob
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p_X: A \to X)_{X \in Ob(C)}
              is any cone from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Id
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Id_C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                    %mo =
                    %mi f
                    %mo ∘
                    %msub
                      %mi p
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} p_X = f \circ p_Y
              for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f:Y\to X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi X
                      %mo =
                      %msub
                        %mo !
                        %mi X
                      %mo ∘
                      %msub
                        %mi p
                        %mi I
                    %annotation{:encoding => "application/x-tex"} p_X = !_X \circ p_I
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi I
                    %mo :
                    %mi A
                    %mo →
                    %mi I
                  %annotation{:encoding => "application/x-tex"} p_I: A \to I
              defines a morphism of cones, and it is the unique morphism of cones since if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              is any morphism of cones, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi I
                    %mo =
                    %msub
                      %mo !
                      %mi I
                    %mo ∘
                    %mi q
                    %mo =
                    %msub
                      %mn 1
                      %mi I
                    %mo ∘
                    %mi q
                    %mo =
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p_I = !_I \circ q = 1_I \circ q = q
              (using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo !
                      %mi I
                    %mo =
                    %msub
                      %mn 1
                      %mi I
                  %annotation{:encoding => "application/x-tex"} !_I = 1_I
              by initiality). Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo !
                      %mi X
                    %mo :
                    %mi I
                    %mo →
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi X
                        %mo ∈
                        %mi Ob
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (!_X: I \to X)_{X \in Ob(C)}
              is the limit cone.
            %p
              Conversely, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi X
                    %mo :
                    %mi L
                    %mo →
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi X
                        %mo ∈
                        %mi Ob
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p_X: L \to X)_{X \in Ob(C)}
              is a limit cone for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Id
                        %mi C
                    %annotation{:encoding => "application/x-tex"} Id_C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %msub
                      %mi p
                      %mi Y
                    %mo =
                    %msub
                      %mi p
                      %mi X
                  %annotation{:encoding => "application/x-tex"} f\circ p_Y = p_X
              for any
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f:Y\to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                    %mo ∘
                    %msub
                      %mi p
                      %mi L
                    %mo =
                    %msub
                      %mi p
                      %mi X
                  %annotation{:encoding => "application/x-tex"} p_X \circ p_L = p_X
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi L
                    %mo :
                    %mi L
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} p_L: L \to L
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi L
                    %mo :
                    %mi L
                    %mo →
                    %mi L
                  %annotation{:encoding => "application/x-tex"} 1_L: L \to L
              define morphisms of cones; since the limit cone is the terminal cone, we infer
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi L
                      %mo =
                      %msub
                        %mn 1
                        %mi L
                    %annotation{:encoding => "application/x-tex"} p_L = 1_L
              %a.maruku-ref{:href => "#cone"}
              we conclude
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is initial.
          #RelevanceForAdjointFunctorTheorem.num_remark
            %h6#remark Remark
            %p
              %strong
                (relevance for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
            %p
              Theorem
              %a.maruku-ref{:href => "#LimitOverIdentityFunctorIsInitialObject"}
              is actually a key of entry into the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} general adjoint functor theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} G: C \to D
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              is tantamount to showing that each functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi G
                    %mo −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(d, G-)
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} ↓
                    %mi G
                  %annotation{:encoding => "application/x-tex"} d \downarrow G
              has an initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi θ
                    %mo :
                    %mi d
                    %mo →
                    %mi G
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c, \theta: d \to G c)
              (see at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
              = succeed ")." do
                %a{:href => "#PointwiseExpressionOfLeftAdjoints"} this prop.
