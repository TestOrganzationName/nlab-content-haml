                %annotation{:encoding => "application/x-tex"}
                  (Lan_p \dashv p^* \dashv Ran_p)
                  \:=
                  (p_! \dashv p^* \dashv p_*)
                  \:
                  [C,A]
                  \\stackrel{\overset{Lan_p}{\to}}{\stackrel{\overset{p^*}{\leftarrow}}{\underset{Ran_p}{\to}}}
                  [C',A]
                  \\,.
          %p
            These are the left and right
            %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            functors.
          %p
            The following definition is the straightforward evident generalization of this from plain categories to
            = succeed "." do
