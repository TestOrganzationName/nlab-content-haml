          %h2#idea Idea
          %p
            Homotopy Kan extensions are models/presentations for
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Kan+extension"} (∞,1)-Kan extension
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            theory – in terms of
            %a.existingWikiWord{:href => "/nlab/show/homotopical+category"} homotopical category
            theory and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
          %p
            As a special case they reduce to
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} (∞,1)-categorical limits and colimits
          %h2#in_combinatorial_simplicial_model_categories In combinatorial simplicial model categories
          %p
            The following describes homotopy Kan extensions in the context of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+simplicial+model+categories"} combinatorial simplicial model categories
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            %a.existingWikiWord{:href => "/nlab/show/enriched+model+categories"} enriched model categories
            whose underlying ordinary model category is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sSet
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            replaced by any
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/excellent+model+category"} excellent model category
          %h3#recollection_of_ordinary_global_kan_extensions Recollection of ordinary global Kan extensions
          %p
            Recall the global definition of ordinary
            = succeed "s:" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi C
                  %mo →
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} p : C \to C'
            a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
            %a.existingWikiWord{:href => "/nlab/show/functor+categories"} functor categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C,A]
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ′
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [C',A]
            and precomposition with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            induces a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi p
                    %mo *
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ′
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  p^* : [C',A] \to [C,A]
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            has all limits and colimits, then this functor has a
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Lan
                    %mi p
                %annotation{:encoding => "application/x-tex"} Lan_p
            and a
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Ran
                    %mi p
                %annotation{:encoding => "application/x-tex"} Ran_p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Lan
                    %mi p
                  %mo ⊣
                  %msup
                    %mi p
                    %mo *
                  %mo ⊣
                  %msub
                    %mi Ran
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mo !
                  %mo ⊣
                  %msup
                    %mi p
                    %mo *
                  %mo ⊣
                  %msub
                    %mi p
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi C
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi Ran
                            %mi p
                      %mover
                        %mo ←
                        %mrow
                          %msup
                            %mi p
                            %mo *
                    %mover
                      %mo →
