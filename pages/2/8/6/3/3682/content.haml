                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ′
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A(a,G(-))  \in [C',sSet]
              as a homotopy right Kan extension of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} A(a,F(-)) \in [C,sSet]
          .proof
            %h6#proof_2 Proof
            %p
              This appears as
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. A.3.3.12
            %p
              First notice that a replacement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mover
                      %mo →
                      %mo ≃
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} F \stackrel{\simeq}{\to} \hat F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                  %annotation{:encoding => "application/x-tex"} [C,A]_{inj}
              by a fibrant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat F
              induces a weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(a,F(-)) \to A(a,\hat F(-))
              for all cofibrant
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is assumed projectively fibrant and using the properties of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-space"} derived hom-space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            %p
              Therefore we may assume without loss of generality that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is already injectively fibrant. Then it also follows that for all cofibrant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                  %annotation{:encoding => "application/x-tex"} A(a,F(-)) \in [C,sSet]_{inj}
              is fibrant: because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(a,(-))
              having
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              against all acyclic cofibrations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo →
                    %mi H
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} H \to H'
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                  %annotation{:encoding => "application/x-tex"} [C,sSet]_{inj}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi H
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                            %mo{:stretchy => "false"} (
                            %mi a
                            %mo ,
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                            %mi H
                            %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H &amp;\to &amp; A(a,F(-))
                    \\\
                    \\downarrow &amp; \nearrow
                    \\\
                    H'
                    }
            %p
              is equivalent, by the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "-adjunction" do
                %a.existingWikiWord{:href => "/nlab/show/copower"} tensor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              itself having the right lifting property against the map from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⋅
                    %mi H
                    %mo :
                    %mi c
                    %mo ↦
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \cdot H : c \mapsto H(c)\cdot A
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ′
                    %mo ⋅
                    %mi A
                  %annotation{:encoding => "application/x-tex"} H' \cdot A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi H
                            %mo ⋅
                            %mi a
                          %mtd
                            %mo →
                          %mtd
                            %mi F
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↗
                        %mtr
                          %mtd
                            %mi H
                            %mo ′
                            %mo ⋅
                            %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H\cdot a &amp;\to &amp; F
                    \\\
                    \\downarrow &amp; \nearrow
                    \\\
                    H'\cdot a
                    }
                    \\,.
            %p
              But since tensoring in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              is a left
              %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
              by definition of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              with an acyclic cofibration of simplicial sets produces an acaclic cofibration in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⋅
                    %mi a
                    %mo →
                    %mi H
                    %mo ′
                    %mo ⋅
                    %mi a
                  %annotation{:encoding => "application/x-tex"} H \cdot a \to H'\cdot a
              is an acyclic cofibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi inj
                    %annotation{:encoding => "application/x-tex"} [C,sSet]_{inj}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is (can assumed to be) injectively fibrant, hence the lift exists. Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(a,F(-))
              is indeed injectively fibrant.
            %p With this in hand, we have now the following equivalent restatement of the claim:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is a weak equivalence precisely if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \eta_a
              is for all cofibrant (or cofibrant and fibrant)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
            %p
              The implication
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mi we
                    %mo{:stretchy => "false"} )
                    %mo ⇒
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
                      %mi a
                    %mi we
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\eta we) \Rightarrow (\eta_a we)
              follows because in the
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(a,F(-))
              out of the cofibrant objectwise
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              into the fibrant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(-)
              preserves weak equivalences.
            %p
              Conversely, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi a
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi f
                      %mo *
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta_a: A(a,G(-)) \to A(a,f_* F(-))
              is a weak equivalence for all fibrant and cofibrant
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi f
                      %mo *
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta(c) : G(c) \to f_* F(c)
              is a weak equivalence for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              = succeed "-enriched" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(sSet)
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(A)
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ho(A)
              is an iso if homming all other objects into it produces an isomorphism.
          .num_remark
            %h6#remark Remark
            %p
              Notice that the statement makes sense in the full
              = succeed "-subcategory" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} A^\circ
              on fibrant-cofibrant objects of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
              is involved. This allows to define homotopy Kan extensions in arbitrary Kan-complex enriched categories, which may or may not arise as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo ∘
                  %annotation{:encoding => "application/x-tex"} A^\circ
              for A a simplicial model category. This is discussed below.
          %h2#InKanCplCat In Kan-complex enriched categories
          %p We obtain a notion of homotopy Kan extension that does not depend on any model category structure or even on weak equivalences anymore, but takes place entirely just in Kan-complex enriched categories.
          %h3#definition_3 Definition
          %p
            The above characterization of homotopy Kan extensions in simplicial combinatorial model categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in terms of homotopy Kan extensions in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} sSet
            only involves
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(a,c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            is cofibrant and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            is fibrant. So it involves only the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/derived+hom-space"} derived hom-space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "es." do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
          %p
            Accordingly, this characterization makes sense for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            any locally fibrant
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
          .num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f : C \to C'
              an
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              of small
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} F \in [C,A]
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ′
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} G \in [C',A]
              we say a morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo :
                      %mi G
                      %mo →
                      %msub
                        %mi f
                        %mo *
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \eta : G \to f_* F
              %strong
                exhibits
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                as a homotopy right Kan extension
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi a
                    %mo :
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %msub
                      %mi f
                      %mo *
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta_a : A(a,G(-)) \to  A(a,f_* F(-))
            %p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo ′
                    %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} A(a,G(-)) : C' \to sSet_{Quillen}
              as a homotopy right Kan extension of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi C
                      %mo →
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} A(a,F(-)) : C \to sSet_{Quillen}
          %h3#Holims Homotopy limits and colimits
          %p
            If the diagram category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ′
                %annotation{:encoding => "application/x-tex"} C'
            is the terminal
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"} f : C \to {*}
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
          %h4#characterization_in_terms_of_homadjuncts Characterization in terms of hom-adjuncts
          %p
            In thae case that we are homotopy Kan extending to the point, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi G
                  %mo →
                  %msub
                    %mi f
                    %mo *
                  %mi F
                %annotation{:encoding => "application/x-tex"} \eta : G \to f_* F
            exhibits a right homotopy Kan extension,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} G \in A
            is a single object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and by adjunction this corresponds to a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi G
                    %mo =
                    %mi const
                    %mi G
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} f^* G = const G \to F
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi η
                    %mi c
                  %mo :
                  %mi G
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi c
                      %mo ∈
                      %mi C
                %annotation{:encoding => "application/x-tex"}
                  \\{ \eta_c : G \to F(c) \}_{c \in C}
          %p
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .num_cor
            %h6#corollary Corollary
            %p
              The fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              exhibits a right homotopy Kan extension is equivalent to the statement that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %munder
                      %mi lim
                      %mo ←
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A(a, G) \to \lim_{\leftarrow} A(a,F(-))
            %p
              induced by composing with the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi η
                      %mi c
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\eta_c\}
              %em
                exhibits
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A(a,G)
                as a homotopy limit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A(a,F(-))
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mo ←
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi const
                    %mi a
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lim_{\leftarrow} A(a,F(-)) = [C,sSet](const a,F)
              is an isomorphissm, this in turn is equivalent to the statemeent that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi const
                    %mi a
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A(a, G) \to [C,sSet](const a, F)
            %p exhibits that homotopy Kan extension.
          %p Analogously for homotopy colimits.
          %h4#relation_to_quasicategorical_limits_and_colimits Relation to quasi-categorical limits and colimits
          %p
            The above considerations can be used to show that under the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} quasi-categorical colimits
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              Kan-complex-enriched categories and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} F \in [C,A]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi F
                    %mo →
                    %msub
                      %mi const
                      %mi q
                  %annotation{:encoding => "application/x-tex"} \eta : F \to const_q
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} q \in A
              as a homotopy colimit in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in the above sense precisely if for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(f) : N(C) \to N(A)
              the corresponding morphism of
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
              under the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ▹
                    %mo :
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ▹
                    %mo →
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(f)^\triangleright : N(C)^\triangleright \to N(A)
              the extension to cones given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi f
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ▹
                  %annotation{:encoding => "application/x-tex"} N(f)^{\triangleright}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} quasi-categorical colimit diagram
          .proof
            %h6#proof_3 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, theorem 4.2.4.1
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/limit+in+a+quasi-category"} limit in a quasi-category
          %h2#in_terms_of_derivators In terms of derivators
          %p
            The notion of
            %a.existingWikiWord{:href => "/nlab/show/derivator"} derivator
            is largely a tool for handling homotopy Kan extensions. See there for details.
          %h2#properties_2 Properties
          %h3#Pointwise Pointwise homotopy Kan extensions
          %p
            Under suitable conditions (but typically) homotopy Kan extensions may be computed
            %a{:href => "Kan+extension#Pointwise"} pointwise
            by
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} homotopy colimits
          %p
            Discussion of pointwise homotopy Kan extensions in
            %a.existingWikiWord{:href => "/nlab/show/cofibration+categories"} cofibration categories
            is in
            = succeed "." do
              %a{:href => "#Radulescu-Banu06"} Radulescu &amp; Banu 2006, theorem 9.6.5
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            in
            = succeed "." do
              %a{:href => "#Cisinski09"} Cisinski 2009, prop. 1.14
            %a.existingWikiWord{:href => "/nlab/show/relative+categories"} relative categories
            discussion is in
            = succeed "." do
              %a{:href => "#Gonzales11"} Gonzales 2011, section 4
          %p
            See also at
            = succeed "." do
              %em
                %a{:href => "/%28infinity%2C1%29-Kan+extension#Pointwise"} (∞,1)-Kan extension – Properties – Pointwise
          %h2#references References
          %p General theory of homotopy Kan extensions is discussed in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , section A.3.3 of
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Philip+Hirschhorn"} Philip Hirschhorn
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jeff+Smith"}> Jeff Smith
                ,
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Homotopy+Limit+Functors+on+Model+Categories+and+Homotopical+Categories"} Homotopy Limit Functors on Model Categories and Homotopical Categories
                , volume 113 of Mathematical Surveys and Monographs
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bruno+Kahn"}> Bruno Kahn
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Georges+Maltsiniotis"} Georges Maltsiniotis
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Structures+de+D%C3%A9rivabilit%C3%A9"} Structures de Dérivabilité
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Marc+Cordier"} Jean-Marc Cordier
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"} Tim Porter
                = succeed "," do
                  %em Homotopy Coherent Category Theory
          %p A list of basic properties is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Samuel+Isaacson"}> Samuel Isaacson
              , section 4 of
              %em Exercises on homotopy colimits
              (
              %a{:href => "http://math.mit.edu/~mbehrens/TAGS/Isaacson_exer.pdf"}> pdf
              )
          %p
            Pointwise
            %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extensions"} homotopy Kan extensions
            are discussed in
          %ul
            %li#Radulescu-Banu06
              %p
                Andrei Radulescu-Banu,
                %em Cofibrations in Homotopy Theory
                (
                %a{:href => "http://arxiv.org/abs/math/0610009"}> arXiv:0610009
                )
            %li#Cisinski09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
                ,
                = succeed "," do
                  %em Images directes cohomologiques dans les catégories de modèles
