            in
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            (not yet checking
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/Yukawa+couplings"} Yukawa couplings
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Volker+Braun"}> Volker Braun
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Burt+Ovrut"} Burt Ovrut
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tony+Pantev"} Tony Pantev
                = succeed "," do
                  %em A Heterotic Standard Model
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0501070"} arXiv:hep-th/0501070
            %li#BraunHeOvrutPantev06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Volker+Braun"}> Volker Braun
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Burt+Ovrut"} Burt Ovrut
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tony+Pantev"} Tony Pantev
                = succeed "," do
                  %em The Exact MSSM Spectrum from String Theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0512177"} arXiv:hep-th/0512177
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Vincent+Bouchard"}> Vincent Bouchard
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ron+Donagi"} Ron Donagi
                = succeed "," do
                  %em An SU(5) Heterotic Standard Model
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0512149"} arXiv:hep-th/0512149
          %p
            A computer search through the “
            %a.existingWikiWord{:href => "/nlab/show/landscape+of+string+theory+vacua"}> landscape
            ” of
            %a.existingWikiWord{:href => "/nlab/show/Calabi-Yau+varieties"} Calabi-Yau varieties
            showed severeal hundreds more such exact heterotic standard models (about one billionth of all CYs searched, and most of them arising as
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 5
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(5)
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/GUTs"} GUTs
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lara+Anderson"}> Lara Anderson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andre+Lukas"} Andre Lukas
                = succeed "," do
                  %em Heterotic Compactification, An Algorithmic Approach
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0702210"} arXiv:hep-th/0702210
            %li#AndersonGrayLukasPalti11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lara+Anderson"}> Lara Anderson
                , James Gray,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andre+Lukas"} Andre Lukas
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eran+Palti"} Eran Palti
                %em Two Hundred Heterotic Standard Models on Smooth Calabi-Yau Threefolds
                (
                %a{:href => "http://arxiv.org/abs/1106.4804"}> arXiv:1106.4804
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lara+Anderson"}> Lara Anderson
                , James Gray,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andre+Lukas"} Andre Lukas
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eran+Palti"} Eran Palti
                %em Heterotic Line Bundle Standard Models
                JHEP06(2012)113 (
                %a{:href => "https://arxiv.org/abs/1202.1757"}> arXiv:1202.1757
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lara+Anderson"}> Lara Anderson
                , Andrei Constantin, James Gray,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andre+Lukas"} Andre Lukas
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Eran+Palti"} Eran Palti
                = succeed "," do
                  %em A Comprehensive Scan for Heterotic SU(5) GUT models
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1307.4787"} arXiv:1307.4787
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"}> Yang-Hui He
                , Seung-Joo Lee,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andre+Lukas"} Andre Lukas
                %em Heterotic Model Building: 16 Special Manifolds
                (
                %a{:href => "http://arxiv.org/abs/1309.0223"}> arXiv:1309.0223
                )
            %li#CHE18
              %p
                Andrei Constantin,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andre+Lukas"} Andre Lukas
                %em Counting String Theory Standard Models
                (
                %a{:href => "https://arxiv.org/abs/1810.00444"}> arXiv:1810.00444
                )
          %p The resulting database of compactifications is here:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Lara+Anderson"}> Lara Anderson
              , James Gray,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andre+Lukas"} Andre Lukas
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eran+Palti"} Eran Palti
              %em Heterotic standard model database
              (
              %a{:href => "http://www-thphys.physics.ox.ac.uk/projects/CalabiYau/linebundlemodels/index.html."}> web
              )
          %p Review includes
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lara+Anderson"}> Lara Anderson
                ,
                = succeed "," do
                  %em New aspects of heterotic geometry and phenomenology
                = succeed "," do
                  %a{:href => "http://wwwth.mpp.mpg.de/conf/strings2012/"} Strings2012
                = succeed ")" do
                  %a{:href => "http://wwwth.mpp.mpg.de/members/strings/strings2012/strings_files/program/Talks/Wednesday/Anderson.pdf"} pdf
            %li#He18a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"}> Yang-Hui He
                ,
                %em The Calabi-Yau Landscape: from Geometry, to Physics, to Machine-Learning
                (
                %a{:href => "https://arxiv.org/abs/1812.02893"}> arXiv:1812.02893
                )
            %li#He18b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"}> Yang-Hui He
                ,
                = succeed "," do
                  %em Deep-learning the landscape
                %em
                  %a{:href => "https://ims.nus.edu.sg/events/2018/wstring/wk.php"} String and M-Theory: The new geometry of the 21st century
                (
                %a{:href => "https://ims.nus.edu.sg/events/2018/wstring/files/yang.pdf"}> pdf slides
                ,
                = succeed ")" do
                  %a{:href => "https://www.youtube.com/watch?v=x3ThgBgkPlE"} video recording
          %p
            Computation of
            %a.existingWikiWord{:href => "/nlab/show/metrics"} metrics
            on these Calabi-Yau compactifications (eventually needed for computing their induced
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Yukawa+couplings"} Yukawa couplings
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Volker+Braun"}> Volker Braun
              , Tamaz Brelidze,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Douglas"} Michael Douglas
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Burt+Ovrut"} Burt Ovrut
              = succeed "," do
                %em Calabi-Yau Metrics for Quotients and Complete Intersections
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/0712.3563"} arXiv:0712.3563
          %p This “heterotic standard model” has a “hidden sector” copy of the actual standard model, more details of which are discussed here:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Volker+Braun"}> Volker Braun
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Burt+Ovrut"} Burt Ovrut
              %em Supersymmetric Hidden Sectors for Heterotic Standard Models
              (
              %a{:href => "http://arxiv.org/abs/1301.6767"}> arXiv:1301.6767
              )
          %p
            The issue of
            %a.existingWikiWord{:href => "/nlab/show/moduli+stabilization"} moduli stabilization
            in these kinds of models is discussed in
          %ul
            %li
              %p
                Michele Cicoli, Senarath de Alwis, Alexander Westphal,
                %em Heterotic Moduli Stabilization
                (
                %a{:href => "http://arxiv.org/abs/1304.1809"}> arXiv:1304.1809
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lara+Anderson"}> Lara Anderson
                , James Gray,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andre+Lukas"} Andre Lukas
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Burt+Ovrut"} Burt Ovrut
                %em Vacuum Varieties, Holomorphic Bundles and Complex Structure Stabilization in Heterotic Theories
                (
                %a{:href => "http://arxiv.org/abs/1304.2704"}> arXiv:1304.2704
                )
          %p Principles singling out heterotic models with three generations of fundamental particles are discussed in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Philip+Candelas"}> Philip Candelas
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Xenia+de+la+Ossa"} Xenia de la Ossa
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yang-Hui+He"} Yang-Hui He
              = succeed "," do
                %em Triadophilia: A Special Corner in the Landscape
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0706.3134"} arXiv:0706.3134
          %p See also
          %ul
            %li
              Hajime Otsuka,
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                        %mo{:stretchy => "false"} (
                        %mn 32
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SO(32)
                  heterotic line bundle models
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1801.03684"} arXiv:1801.03684
          %h3#moduli_space_of_2d_scfts Moduli space of 2d SCFTs
          %p
            Some general thoughts on what a
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of 2d CFTs should be are in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Douglas"}> Michael Douglas
              ,
              %em Spaces of Quantum Field Theories
              (
              %a{:href => "http://arxiv.org/abs/1005.2779"}> arXiv:1005.2779
              )
          %p The compactness results mentioned there are discussed in
          %ul
            %li#Soibelman11
              %a.existingWikiWord{:href => "/nlab/show/Yan+Soibelman"}> Yan Soibelman
              ,
              %em Collapsing CFTs, spaces with non-negative Ricci curvature and nc geometry
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              (eds.)
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Mathematical+Foundations+of+Quantum+Field+and+Perturbative+String+Theory"} Mathematical Foundations of Quantum Field and Perturbative String Theory
              Proceedings of Symposia in Pure Mathematics, AMS (2011)
          %p based on conjectures in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yan+Soibelman"} Yan Soibelman
              = succeed "," do
                %em Homological Mirror Symmetry and torus fibrations
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/math/0011041"} math.SG/0011041
          %h3#ReferencesPhenomenologicalSpeculation Phenomenological speculation
          %p Early and technical articles that amplified the existence of a finite but very large number of string theory compactifications are
          %ul
            %li#LercheLustSchellekens86
              %a.existingWikiWord{:href => "/nlab/show/Wolfgang+Lerche"}> Wolfgang Lerche
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dieter+L%C3%BCst"} Dieter Lüst
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bert+Schellekens"} Bert Schellekens
              = succeed "," do
                %em Ten dimensional heterotic strings from Niemeier lattices
              = succeed ")" do
                %a{:href => "http://cds.cern.ch/record/170910/files/198609340.pdf"} pdf
          %p which says on p. 2
          %blockquote
            %p Although the consistency requirements which string theories have to satisfy are quite restrictive, it has become clear that there are more solutions than one originally expected. [] Although the possibility of making Lorentz rotations suggests a continuous infinity of new ten dimensional theories, there is actually only a discrete set of theories that makes physical sense, as we will explain below.
          %p and
          %ul
            %li#LercheLustSchellekens87
              %a.existingWikiWord{:href => "/nlab/show/Wolfgang+Lerche"}> Wolfgang Lerche
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dieter+L%C3%BCst"} Dieter Lüst
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bert+Schellekens"} Bert Schellekens
              %em Chiral Four-dimensional Heterotic Strings from Self-dual Lattices
              Nucl. Phys. B 287, 477, 1987 (
              %a{:href => "http://lerche.web.cern.ch/lerche/papers/4dhetstrings.pdf"}> pdf
              )
          %p which says in conclusion on page 45-46
          %blockquote
            %p Although the number of chiral theories of this type is finite, our results suggest that there exist very many of them, so that a complete enumeration appears impossible.
          %p A popular account of these observations was given in
          %ul
            %li#Schellekens98
              %a.existingWikiWord{:href => "/nlab/show/Bert+Schellekens"}> Bert Schellekens
              ,
              = succeed "," do
                %em Naar een waardig slot
              = succeed ")" do
                %a{:href => "https://mobile.repository.ubn.ru.nl/handle/2066/18631"} ubn:2066/18631
          %p a commented translation of which later appeared as
          %ul
            %li#Schellekens06
              %a.existingWikiWord{:href => "/nlab/show/Bert+Schellekens"}> Bert Schellekens
              ,
              %em The Landscape “avant la lettre”
              (
              %a{:href => "http://arxiv.org/abs/physics/0604134"}> arXiv:physics/0604134
              )
          %p Similarly
          %ul
            %li#Schellekens08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bert+Schellekens"}> Bert Schellekens
                ,
                = succeed "," do
                  %em The Emperor’s Last Clothes?
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0807.3249"} arXiv:0807.3249
            %li#Schellekens16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bert+Schellekens"}> Bert Schellekens
                ,
                %em Big Numbers in String Theory
                (
                %a{:href => "http://arxiv.org/abs/1601.02462"}> arXiv:1601.02462
                )
          %p
            The articles
            = succeed "," do
              %a{:href => "#LercheLustSchellekens86"} Lerche-Lüst-Schellekens 86
            = succeed "," do
              %a{:href => "#LercheLustSchellekens87"} Lerche-Lüst-Schellekens 87
            = succeed "," do
              %a{:href => "#Schellekens98"} Schellekens 98
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stabilization"} moduli stabilization
          %p
            That there are
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 10
                    %mi hundreds
                %annotation{:encoding => "application/x-tex"} 10^{hundreds}
            different flux compactifications was maybe first said explicitly in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Raphael+Bousso"}> Raphael Bousso
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Polchinski"} Joseph Polchinski
              %em Quantization of Four-form Fluxes and Dynamical Neutralization of the Cosmological Constant
              (
              %a{:href => "http://arxiv.org/abs/hep-th/0004134"}> arXiv:hep-th/0004134
              )
          %p
            The idea became popular in discussion of the
            %a.existingWikiWord{:href => "/nlab/show/cosmological+constant"} cosmological constant
            with the alleged construction of a large set of metastable
            = succeed "-vacua" do
              %a.existingWikiWord{:href => "/nlab/show/de+Sitter+spacetime"} de Sitter spacetime
          %ul
            %li#KKLT03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Shamit+Kachru"}> Shamit Kachru
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Renata+Kallosh"} Renata Kallosh
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Andrei+Linde"} Andrei Linde
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sandip+Trivedi"} Sandip Trivedi
                = succeed "," do
                  %em de Sitter Vacua in String Theory
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0301240"} arXiv:hep-th/0301240
              %p
                (“KKLT”, a good quick review is in
                = succeed "," do
                  %a{:href => "#DanielssonVanRiet18"} Danielsson-VanRiet 18 section 2.5.1
                = succeed ")" do
                  %a{:href => "#IbanezUranga12"} Ibanez-Uranga 12, section 15.3.1
          %p
            and the amplification of the complication of the
            = succeed "-construction" do
              %a{:href => "#KKLT03"} KKLT 03
          %ul
            %li#Susskind03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Leonard+Susskind"}> Leonard Susskind
                ,
                = succeed "," do
                  %em The Anthropic Landscape of String Theory
                = succeed "," do
                  %em Universe or multiverse
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0302219"} arXiv:hep-th/0302219
              %p
                “The vacua in
                %a{:href => "#KKLT03"} KKLT 03
                are not at all simple. They are jury-rigged,
                %a{:href => "https://en.wikipedia.org/wiki/Rube_Goldberg_machine"} Rube Goldberg contraptions
                that could hardly have fundamental significance.” (p. 5)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Polchinski"}> Joseph Polchinski
                ,
                %em The Cosmological Constant and the String Landscape
                (
                %a{:href => "http://arxiv.org/abs/hep-th/0603249"}> arXiv:hep-th/0603249
                )
          %p Review includes
          %ul
            %li#IbanezUranga12
              %a.existingWikiWord{:href => "/nlab/show/Luis+Ib%C3%A1%C3%B1ez"}> Luis Ibáñez
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Angel+Uranga"} Angel Uranga
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/String+Theory+and+Particle+Physics+--+An+Introduction+to+String+Phenomenology"} String Theory and Particle Physics – An Introduction to String Phenomenology
          %p
            (Beware that the approach of
            %a{:href => "#KKLT03"} KKLT 03
            is argued to be false in
            %a{:href => "#Danielsson-VanRiet18"} DanielssonVanRiet 18
            and is being abandoned in
            = succeed "," do
              %a{:href => "#ObiedOoguriSpodyneikoVafa18"} Obied-Ooguri-Spodyneiko-Vafa 18
            = succeed ")." do
              %a{:href => "#de+Sitter+spacetime#BDDGS18"} Danielsson et. al 18
          %p
            The specific (but arbitrary) value “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msup
                    %mn 10
                    %mn 500
                %annotation{:encoding => "application/x-tex"} 10^{500}
            ” for the typical number of flux compactification, which became iconic in public discussion of the issue, originates in
          %ul
            %li#Douglas04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Douglas"}> Michael Douglas
                , p. 4 of
                = succeed "," do
                  %em Basic results in vacuum statistics
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0409207"} arXiv:hep-th/0409207
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ralph+Blumenhagen"}> Ralph Blumenhagen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Florian+Gmeiner"} Florian Gmeiner
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gabriele+Honecker"} Gabriele Honecker
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dieter+L%C3%BCst"} Dieter Lüst
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Timo+Weigand"} Timo Weigand
                = succeed "," do
                  %em The Statistics of Supersymmetric D-brane Models
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0411173"} arXiv:hep-th/0411173
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Douglas"}> Michael Douglas
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Shamit+Kachru"} Shamit Kachru
                = succeed "," do
                  %em Flux Compactification
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0610102"} arXiv:hep-th/0610102
          %p Previously
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Suyay+Ashok"}> Suyay Ashok
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Douglas"} Michael Douglas
              = succeed "," do
                %em Counting flux vacua
          %p
            had considered
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 10
                    %mn 120
                %annotation{:encoding => "application/x-tex"} 10^{120}
            and earlier
            %a{:href => "#LercheLustSchellekens87"} Lerche-Lüst-Schellekens 87
            had
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mn 10
                      %mn 1500
                  %annotation{:encoding => "application/x-tex"} 10^{1500}
          %p A review of the issue of flux compactifications is in
          %ul
            %li#Grana05
              %a.existingWikiWord{:href => "/nlab/show/Mariana+Gra%C3%B1a"}> Mariana Graña
              ,
              %em Flux compactifications in string theory: a comprehensive review
              (
              %a{:href => "http://arxiv.org/abs/hep-th/0509003"}> arXiv:hep-th/0509003
              )
          %p General considerations on this state of affairs are in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Frank+Wilczek"}> Frank Wilczek
              ,
              %em Multiversality
              (
              %a{:href => "http://arxiv.org/abs/1307.7376"}> arXiv:1307.7376
              )
          %p
            The fact that in principle all the parameters of the “landscape” of string theory vacua are dynamical (are moduli fields) and the idea that an
            %a.existingWikiWord{:href => "/nlab/show/eternal+cosmic+inflation"} eternal cosmic inflation
            might be something like an
            %a.existingWikiWord{:href => "/nlab/show/ergodic+process"} ergodic process
            in this landscape has led to ideas to connect this to
            %a.existingWikiWord{:href => "/nlab/show/phenomenology"} phenomenology
            and the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/standard+model+of+cosmology"} standard model of cosmology
            %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
            by way of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/statistical+mechanics"} statistical mechanics
          %p Summaries of this line of thinking include
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Raphael+Bousso"}> Raphael Bousso
              ,
              %em The State of the Multiverse:
              %p
                The String Landscape, the Cosmological Constant, and the Arrow of Time_, 2011 (
                %a{:href => "http://www.ctc.cam.ac.uk/stephen70/talks/swh70_bousso.pdf"}> pdf
                )
          %p
            For more on this see the references at
            %em
              %a.existingWikiWord{:href => "/nlab/show/multiverse"} multiverse
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/eternal+inflation"} eternal inflation
          %h3#ReferencesDeSitter Landscape of de Sitter vacua (or not)
          %p
            On the other hand, discussion casting doubt on the existence of a large number of
            %a.existingWikiWord{:href => "/nlab/show/de+Sitter+spacetime"} de Sitter spacetime
            %a.existingWikiWord{:href => "/nlab/show/perturbative+string+theory+vacua"} perturbative string theory vacua
            includes the following:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tom+Banks"}> Tom Banks
                ,
                %em Landskepticism: or Why Effective Potentials Don’t Count String Models
                (
                %a{:href => "https://arxiv.org/abs/hep-th/0412129"}> arXiv:hep-th/0412129
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tom+Banks"}> Tom Banks
                ,
                %em
                  The Top
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mn 10
                          %mn 500
                      %annotation{:encoding => "application/x-tex"} 10^{500}
                  Reasons Not to Believe in the Landscape
                (
                %a{:href => "https://arxiv.org/abs/1208.5715"}> arXiv:1208.5715
                )
            %li#Banks19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tom+Banks"}> Tom Banks
                ,
                %em On the Limits of Effective Quantum Field Theory: Eternal Inflation, Landscapes, and Other Mythical Beasts
                (
                %a{:href => "https://arxiv.org/abs/1910.12817"}> arxiv:1910.12817
                )
              %p from pages 14-22:
              %blockquote
                %p
                  these considerations lead to conclusions at odds with the seemingly similar arguments of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                      %annotation{:encoding => "application/x-tex"} [
                  the
                  %a.existingWikiWord{:href => "/nlab/show/swampland+conjectures"} swampland conjectures
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} ]
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi ⋯
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\cdots]
                  Perturbative moduli space completely distorts the true nature of the class of consistent models.
                %p
                  It’s important to realize that the entire procedure just outlined for finding (meta) stable AdS minima of a non-perturbative effective potential is purely hypothetical and has no basis in well founded string theory calculations.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi ⋯
                        %mo{:stretchy => "false"} ]
                        %mo .
                      %annotation{:encoding => "application/x-tex"} [\cdots].
                %p
                  The hypothesis of the String Landscape is entirely based on low energy effective field theory ideas about finding “vacua” by minimizing an effective potential. Everything that’s been said above indicates that this idea has no validity in genuine models of quantum gravity.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi ⋯
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\cdots]
                %p The most serious issue, in my opinion, is the contention that one can make the AdS radius much larger thanthe size of the compact manifold. All well established examples of large radius AdS/CFT havea compact manifold of dimension 2 or greater whose radius is comparable to that of the AdSspace. In Appendix A we’ll present an argument based on the properties of AdS black holes,that this is in fact necessary.
                %p
                  The next step in the construction of “realistic” models involves “adding an anti-brane to break supersymmetry and make the c.c. positive”. This is supposed to be a small modification of the model, calculable in low energy effective field theory, and that seems manifestly incorrect.
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi ⋯
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [\cdots]
                %p
                  even if one believes that the construction of meta-stable dS models is reliable, there is no clear argument about what the proper observables of the model are nor that different dS constructions are part of the same model. Neither is there an interpretation of these correlators as transition amplitudes in a quantum mechanical model.
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi ⋯
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\cdots]
                %p
                  The conclusion that effective field theorists should draw from this is that unlike super-symmetric string models in flat or AdS space-time, many of which have at least perturbative definitions as mathematical models obeying the axioms of quantum mechanics, all literature on the String Landscape is speculation based on the unfounded notion that all string models with a given amount of SUSY are part of one single model and that it makes sense to define an effective action that encompasses all string models. Every single non-perturbative construction of string models contradicts this claim
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi ⋯
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\cdots]
            %li
              %p
                %a{:href => "#BrennanCartaVafa17"} Brennan-Carta-Vafa 17
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Kutasov"}> David Kutasov
                , Travis Maxfield, Ilarion Melnikov,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"} Savdeep Sethi
                = succeed "," do
                  %em Constraining de Sitter Space in String Theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1504.00056"} arXiv:1504.00056
            %li
              %p
                Jakob Moritz, Ander Retolaza, Alexander Westphal,
                = succeed "," do
                  %em Towards de Sitter from 10D
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1707.08678"} arXiv:1707.08678
            %li#Sethi17
              %p
                %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"}> Savdeep Sethi
                ,
                %em Supersymmetry Breaking by Fluxes
                (
                %a{:href => "https://arxiv.org/abs/1709.03554"}> arXiv:1709.03554
                )
              %p re-amplified in:
              %p
                %a.existingWikiWord{:href => "/nlab/show/Savdeep+Sethi"}> Savdeep Sethi
                ,
                = succeed "," do
                  %em Hope or No Hope for a String Landscape?
                %a{:href => "https://indico.cern.ch/event/782251/"} StringPheno2019
                (
                %a{:href => "https://indico.cern.ch/event/782251/contributions/3441886/attachments/1870138/3076971/3_Sethi.pdf"}> pdf
                ,
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/SethiLandscape2019.pdf", :title => "pdf"} pdf
            %li#DanielssonVanRiet18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulf+Danielsson"}> Ulf Danielsson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Van+Riet"} Thomas Van Riet
                = succeed "," do
                  %em What if string theory has no de Sitter vacua?
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1804.01120"} arXiv:1804.01120
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1142/S0218271818300070"} doi:10.1142/S0218271818300070
            %li#vanRiet18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Van+Riet"}> Thomas Van Riet
                ,
                = succeed "," do
                  %em
                    Is dS space in the
                    %a.existingWikiWord{:href => "/nlab/show/swampland"} Swampland
                %a{:href => "http://sp18.fuw.edu.pl/"} StringPheno18
                (
                %a{:href => "http://sp18.fuw.edu.pl/wp-content/uploads/participants-database/thomasvanriet.pdf"}> pdf slides
                )
            %li#vanRiet18a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Van+Riet"}> Thomas Van Riet
                ,
                = succeed "," do
                  %em Status of KKLT
                %em
                  %a{:href => "http://scgp.stonybrook.edu/archives/24870"} Simons summer workshop 2018
                (
                %a{:href => "http://scgp.stonybrook.edu/video_portal/video.php?id=3730"}> recording
                )
            %li
              %p
                Jakob Moritz, Ander Retolaza, Alexander Westphal,
                %em On uplifts by warped anti-D3-branes
                (
                %a{:href => "https://arxiv.org/abs/1809.06618"}> arXiv:1809.06618
                )
          %h3#ReferencesSwampland The Swampland
          %p
            Discussion of aspects of
            %a.existingWikiWord{:href => "/nlab/show/effective+field+theories"} effective field theories
            which might rule them out as having a
            %a.existingWikiWord{:href => "/nlab/show/UV-completion"} UV-completion
            by a
            %a.existingWikiWord{:href => "/nlab/show/string+theory+vacuum"} string theory vacuum
            (be in the “
            %a.existingWikiWord{:href => "/nlab/show/swampland"}> swampland
            ”) has been initiated in
          %ul
            %li#Vafa05
              %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"}> Cumrun Vafa
              ,
              %em The String Landscape and the Swampland
              (
              %a{:href => "http://arxiv.org/abs/hepth/0509212"}> arXiv:hepth/0509212
              )
          %p Comprehensive review is in:
          %ul
            %li
              Eran Palti,
              = succeed "," do
                %em The Swampland: Introduction and Review
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1903.06239"} arXiv:1903.06239
          %p See also
          %ul
            %li#BrennanCartaVafa17
              %p
                T. Daniel Brennan, Federico Carta,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                %em The String Landscape, the Swampland, and the Missing Corner
                (
                %a{:href => "https://arxiv.org/abs/1711.00864"}> arXiv:1711.00864
                )
            %li
              %p
                Ben Heidenreich,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matthew+Reece"} Matthew Reece
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tom+Rudelius"} Tom Rudelius
                %em Emergence and the Swampland Conjectures
                (
                %a{:href => "https://arxiv.org/abs/1802.08698"}> arXiv:1802.08698
                )
          %p Implications of the possible non-existence of de Sitter vacua in string theory are explored in
          %ul
            %li#ObiedOoguriSpodyneikoVafa18
              %p
                Georges Obied,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hirosi+Ooguri"} Hirosi Ooguri
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                %em De Sitter Space and the Swampland
                (
                %a{:href => "https://arxiv.org/abs/1806.08362"}> arXiv:1806.08362
                )
            %li#AgrawalObiedSteinhardtVafa18
              %p
                Prateek Agrawal, Georges Obied, Paul Steinhardt,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                %em On the Cosmological Implications of the String Swampland
                (
                %a{:href => "https://arxiv.org/abs/1806.09718"}> arXiv:1806.09718
                )
            %li#Vafa18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"}> Cumrun Vafa
                ,
                = succeed "," do
                  %em Cosmology and the String Swampland
                %em
                  %a{:href => "https://indico.oist.jp/indico/event/5/"} Strings 2018
                (
                %a{:href => "https://indico.oist.jp/indico/event/5/picture/96.pdf"}> pdf slides
                ,
                = succeed ")" do
                  %a{:href => "https://www.youtube.com/watch?v=fU8sJRCRz24&t=1904s"} recording
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Frederik+Denef"}> Frederik Denef
                , Arthur Hebecker, Timm Wrase,
                %em The dS swampland conjecture and the Higgs potential
                (
                %a{:href => "https://arxiv.org/abs/1807.06581"}> arXiv:1807.06581
                )
