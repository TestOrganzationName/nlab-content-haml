            and
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            for the
            %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective spectrum
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+modular+forms"} topological modular forms
            %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
            is an
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞
            %a.existingWikiWord{:href => "/nlab/show/ring+spectra"} ring spectra
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕊
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi e
                        %mi tmf
                  %mi tmf
