                  %annotation{:encoding => "application/x-tex"} E_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi KO
                  %mo ⟵
                  %mo ⟵
                  %mi 𝕊
                %annotation{:encoding => "application/x-tex"}
                  KO \longleftarrow \longleftarrow \mathbb{S}
          %p
            exhibiting
            %a.existingWikiWord{:href => "/nlab/show/KO"} KO
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo =
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℳ
                      %mrow
                        %msub
                          %mi 𝔾
                          %mi m
                    %mo ,
                    %msup
                      %mi 𝒪
                      %mi top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} = \Gamma(\mathcal{M}_{\mathbb{G}_m}, \mathcal{O}^{top})
          %p
            At least after
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} 2-localization
            the canonical
            %a.existingWikiWord{:href => "/nlab/show/double+cover"} double cover
            of the compactification of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℳ
                    %mrow
                      %msub
                        %mi 𝔾
                        %mi m
                  %mo ≃
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi ℤ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathcal{M}_{\mathbb{G}_m} \simeq \mathbf{B}\mathbb{Z}_2
            similarly yields under
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mi top
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma(-,\mathcal{O}^{top})
            the inclusion of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ko
                %annotation{:encoding => "application/x-tex"} ko
