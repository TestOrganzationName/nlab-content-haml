                          %msub
                            %mi tmf
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  ku_{(2)} &amp; \longleftarrow &amp; tmf_1(3)_{(2)}
                  \\\
                  \\uparrow &amp;&amp; \uparrow
                  \\\
