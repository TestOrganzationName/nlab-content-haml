                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi ku
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↑
                      %mtr
                        %mtd
                          %msub
                            %mi ko
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mn 2
                              %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
