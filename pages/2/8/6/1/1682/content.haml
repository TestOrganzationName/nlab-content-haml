                        %mo •
                        %mo ≤
                        %mn 6
                    %mo{:stretchy => "false"} (
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %msub
                          %mi π
                          %mrow
                            %mo •
                            %mo ≤
                            %mn 6
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mi tmf
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo ≤
                        %mn 6
                    %mo{:stretchy => "false"} (
                    %mi tmf
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
