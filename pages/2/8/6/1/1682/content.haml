                  \\\
                  \\uparrow
                  \\\
                  ko_{(2)}
                  }
          %p
            and combined with the above this comes with maps from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi tmf
                %annotation{:encoding => "application/x-tex"} tmf
            by restriction along the inclusion of the
            %a.existingWikiWord{:href => "/nlab/show/nodal+curve"} nodal curve
            %a.existingWikiWord{:href => "/nlab/show/cusp"} cusp
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
