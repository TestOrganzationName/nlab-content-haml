            (this is originally asserted in
            = succeed "," do
              %a{:href => "#AndoHopkinsStrickland01"} Ando-Hopkins-Strickland 01
            = succeed ")." do
              %a{:href => "#HillLawson13"} Hill-Lawson 13, appendix A
          %h3#witten_genus_and_string_orientation Witten genus and string orientation
          %p
