                %p
                  for each way
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mi k
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \phi \colon \mathbb{R}^k \to X
                  of laying out a coordinate system
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi k
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
                  in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  a differential
                  = succeed "-form" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ϕ
                          %mo *
                        %mi ω
                        %mo ∈
                        %msup
                          %mi Ω
                          %mi n
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℝ
                          %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\phi^* \omega \in \Omega^n(\mathbb{R}^k)
                %p
                  on the abstract coordinate system, as given by def.
                  = succeed ";" do
                    %a.maruku-ref{:href => "#DifferentialnForms"}
              %li
                %p
                  for each abstract
                  %a.existingWikiWord{:href => "/nlab/show/coordinate+transformation"} coordinate transformation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi k
                              %mn 2
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                      %annotation{:encoding => "application/x-tex"} f \colon \mathbb{R}^{k_2} \to \mathbb{R}^{k_1}
                  a corresponding compatibility condition between local differential forms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϕ
                          %mn 1
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \phi_1 \colon \mathbb{R}^{k_1} \to X
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ϕ
                          %mn 2
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi ℝ
                          %mrow
                            %msub
                              %mi k
                              %mn 2
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \phi_2 \colon \mathbb{R}^{k_2} \to X
                  of the form
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mo *
                        %msubsup
                          %mi ϕ
                          %mn 1
                          %mo *
                        %mi ω
                        %mo =
                        %msubsup
                          %mi ϕ
                          %mn 2
                          %mo *
                        %mi ω
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        f^* \phi_1^* \omega = \phi_2^* \omega
                        \\,.
            %p Hence a differential form on a smooth space is simply a collection of differential forms on all its coordinate systems such that these glue along all possible coordinate transformations.
          %p
            The following adds further explanation to the role of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %mo ∈
                  %mi Smooth
                  %mn 0
                  %mi Tye
                %annotation{:encoding => "application/x-tex"} \Omega^n \in Smooth0Tye
            as a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Omega^n
            is itself a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Omega^n
            itsefl.
          #UniversalDifferentialnForm.num_defn
            %h6#definition_9 Definition
            %p
              The
              %strong
                universal differential
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              is the differential
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ω
                      %mi univ
                      %mi n
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\omega^n_{univ} \in \Omega^n(\Omega^n)
            %p
              which is modulated by the
              %a.existingWikiWord{:href => "/nlab/show/identity"} identity
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi id
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi Ω
                        %mi n
                      %mo →
                      %msup
                        %mi Ω
                        %mi n
                    %annotation{:encoding => "application/x-tex"} id \colon \Omega^n \to \Omega^n
          %p With this definition we have:
          .num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Smooth
                    %mn 0
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} X \in Smooth0Type
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+space"} smooth space
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n(X)
              is the pullback of differential forms, def.
              = succeed "," do
                %a.maruku-ref{:href => "#PullbackOfDifferentialFormsOnSmoothSpaces"}
              = succeed "-form," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a.maruku-ref{:href => "#UniversalDifferentialnForm"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              into the moduli space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Omega^n
              of differential
              = succeed "-forms:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %msubsup
                      %mi ω
                      %mi univ
                      %mi n
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\omega = f^* \omega^n_{univ}
                    \\,.
          .num_remark
            %h6#remark_6 Remark
            %p
              This statement is of course in a way a big tautology. Nevertheless it is a very useful tautology to make explicit. The whole concept of differential forms on smooth spaces here may be thought of as simply a variation of the theme of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
          %div
            %h6{:id => ""} {}
            %p
              This ends the Model-layer discussion of differential forms. We now pass to a more advanced discussion of this topic in the
              = succeed "." do
                %a{:href => "#DifferentialFormsLayerSem"} Semantics layer below
              = succeed "." do
                %a{:href => "#Differentiation"} differentiation below
          %h3#DifferentialFormsLayerSem Semantic Layer
          %h4#ConcreteObjects Concrete smooth spaces
          %p
            The smooth universal moduli space of differential forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^n(-)
            from def.
            %a.maruku-ref{:href => "#SmoothModuliSpaceOfnForms"}
            is noteworthy in that it has a property not shared by many smooth spaces that one might think of more naively: while evidently being “large” (the space of all differential forms!) it has “very few points” and “very few
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          .num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \lt n
              the smooth space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Omega^n
              admits only a unique probe by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo ,
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi Ω
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom(\mathbb{R}^k, \Omega^n(-))
                    \\simeq
                    \\Omega^n(\mathbb{R}^k)
                    \=
                    \\{0\}
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              a smooth morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                    %mo →
                    %msup
                      %mi Ω
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^k \to \Omega^n
              is a
              %a.existingWikiWord{:href => "/nlab/show/differential+n-form"} differential n-form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                      %mo ∈
                      %msup
                        %mi Ω
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \omega \in \Omega^n(\mathbb{R}^k)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n \gt k
              there is only the 0 element.
          %p
            So while
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^n()
            is a large smooth space, it is “not supported on probes” in low dimensions in as much as one might expect, from more naive notions of smooth spaces.
          %p
            We now formalize this. The formal notion of an smooth space which
            %em is
            supported on its probes is that of a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/concrete+object"} concrete object
            = succeed "." do
              %em concretification
            %em non-concrete
            in that their concetrification is the point.
          #ConcreteObjectsAndConcretification.num_defn
            %h6#definition_10 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ♯
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \sharp \colon \mathbf{H} \to \mathbf{H}
              for the corresponding sharp modality, def.
              = succeed "." do
                %a.maruku-ref{:href => "#SharpModalityOfLocalTopos"}
            %ol
              %li
                %p
                  An object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
                  is called a
                  %strong
                    %a.existingWikiWord{:href => "/nlab/show/concrete+object"} concrete object
                  if
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi DeCoh
                          %mi X
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mo ♯
                        %mi X
                      %annotation{:encoding => "application/x-tex"}
                        DeCoh_X \colon X \to \sharp X
                %p
                  is a
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              %li
                %p
                  For
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
                  any object, its
                  %strong concretification
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Conc
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} Conc(X) \in \mathbf{H}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/image"} image
                  factorization of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi DeCoh
                            %mi X
                        %annotation{:encoding => "application/x-tex"} DeCoh_X
                  %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                  followed by a
                  %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi DeCoh
                          %mi X
                        %mo :
                        %mi X
                        %mo →
                        %mi Conc
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mo ♯
                        %mi X
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        DeCoh_X : X \to Conc(X) \hookrightarrow \sharp X
                        \\,.
          .num_remark
            %h6#remark_7 Remark
            %p
              Hence the concretification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conc
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Conc(X)
              of an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is itself a
              %a.existingWikiWord{:href => "/nlab/show/concrete+object"} concrete object
              and it is
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal
              with this property. (…)
          #DecohesOverASiteWithTerminalObject.num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              of definition for the
              %a.existingWikiWord{:href => "/nlab/show/local+topos"} local topos
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
