                        %mrow
                          %mi f
                          %mo :
                          %mi A
                          %mo →
                          %mi B
                      %mi{:mathvariant => "normal"} isEquiv
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \simeq B \coloneqq \sum_{f:A \to B} \mathrm{isEquiv}(f)
          %p
            Finally, if the dependent type theory has
            %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isEquiv
                %annotation{:encoding => "application/x-tex"} \mathrm{isEquiv}
            type family and the
            %a.existingWikiWord{:href => "/nlab/show/equivalence+type"} equivalence type
            directly for homotopy equivalences above; the coherence condition follows from the fact that the type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi A
                  %mi x
                %annotation{:encoding => "application/x-tex"} g(f(x)) =_A x
            is always a
            %a.existingWikiWord{:href => "/nlab/show/mere+proposition"} mere proposition
            in the presence of axiom K or UIP:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                  %mo ⊢
                  %mi{:mathvariant => "normal"} isEquiv
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi g
                      %mo :
                      %mi B
                      %mo →
                      %mi A
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi x
                        %mo :
                        %mi A
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi A
                    %mi x
                    %mo )
                  %mo ×
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi y
                        %mo :
                        %mi B
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi B
                    %mi y
                    %mo )
                %annotation{:encoding => "application/x-tex"} f:A \to B \vdash \mathrm{isEquiv}(f) \coloneqq \sum_{g:B \to A} \left(\prod_{x:A} g(f(x)) =_A x\right) \times \left(\prod_{y:B} f(g(y)) =_B y\right)
          %p
            In all three cases, by
            %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
            for the first two and additionally by
            %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            or
            %a.existingWikiWord{:href => "/nlab/show/UIP"} UIP
            for the third case, the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} isEquiv
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{isEquiv}(f)
            type family is a
            %a.existingWikiWord{:href => "/nlab/show/mere+proposition"} mere proposition
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A \to B
            %a.existingWikiWord{:href => "/nlab/show/equivalence+type"} equivalence type
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ≃
                  %mi B
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo :
                      %mi A
                      %mo →
                      %mi B
                  %mi{:mathvariant => "normal"} isEquiv
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \simeq B \coloneqq \sum_{f:A \to B} \mathrm{isEquiv}(f)
          %h3#HistoricalNote Historical note
          %p
            The first attempt at a definition of an equivalence of type was the definition of a quasi-invertible function by
            = succeed "." do
              %a{:href => "#HofmannStreicher98"} Hofmann &amp; Streicher (1998), §5.4
            %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            = succeed "." do
              %a{:href => "#TheIssueWithQuasiInverses"} below
          %p Later on, the following definitions of equivalences were constructed:
          %ul
            %li
              %p
                as a function with contractible fibers, first proposed by
                %a{:href => "#Voevodsky10"} Voevodsky (2010), p. 8, 10
            %li
              %p
                as a homotopy isomorphism, first proposed by
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"} André Joyal
                in a 2011 Oberwolfach meeting, recorded in
                = succeed "," do
                  %a{:href => "#KapulkinLumsdaine21"} Kapulkin &amp; Lumsdaine (2012, 2021), Def. 3.1.1
            %li
              %p
                as a one-to-one correspondence, first proposed in
                %a{:href => "#Shulman22"} Shulman 2022
          %p
            However, these definitions are only equivalent to one another in the presence of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
          %h2#Properties Properties
          %p
            %br/
          %p
            Most of the following claims may be found proven in
            = succeed "." do
              %a{:href => "#UFP13"} UFP13, §2.4 &amp; §4
          %h3#functions_with_contractible_fibers_and_onetoone_correspondences  Functions with contractible fibers and one-to-one correspondences
          %p
            We define an
            %a.existingWikiWord{:href => "/nlab/show/anafunction"} anafunction
            to be a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi A
                  %mo ×
                  %mi B
                  %mo →
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} R :A \times B \to \mathcal{U}
            with a witness
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi a
                      %mo :
                      %mi A
                  %mo ∃
                  %mo !
                  %mi b
                  %mo :
                  %mi B
                  %mo .
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p:\prod_{a:A} \exists!b:B.R(a,b)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/principle+of+unique+choice"} principle of unique choice
            holds in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %mi A
                    %mo ×
                    %mi B
                    %mo →
                    %mi 𝒰
                  %annotation{:encoding => "application/x-tex"} R :A \times B \to \mathcal{U}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A \to B
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A \to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi A
                  %mo ×
                  %mi B
                  %mo →
                  %mi 𝒰
                %annotation{:encoding => "application/x-tex"} R :A \times B \to \mathcal{U}
            defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi B
                    %mi b
                  %annotation{:encoding => "application/x-tex"} R(a,b) \coloneqq f(a) =_B b
          %p A function with contractible fibers comes with a witness
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo :
                      %mi B
                  %mo ∃
                  %mo !
                  %mi a
                  %mo :
                  %mi A
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi A
                  %mi b
                %annotation{:encoding => "application/x-tex"} q:\prod_{b:B} \exists!a:A.f(a) =_A b
          %p while an one-to-one correspondence is an anafunction which comes with a witness
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi b
                      %mo :
                      %mi B
                  %mo ∃
                  %mo !
                  %mi a
                  %mo :
                  %mi A
                  %mo .
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} q:\prod_{b:B} \exists!a:A.R(a, b)
          %p
            Since we established that the types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi A
                  %mi b
                %annotation{:encoding => "application/x-tex"} f(a) =_A b
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R(a, b)
            are the same for function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and anafunction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h3#TheIssueWithQuasiInverses The issue with two-sided quasi-inverses
          %p
            The definition of equivalences as two-sided
            %a.existingWikiWord{:href => "/nlab/show/quasi-inverse+functions"} quasi-inverse functions
            (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#FunctionWithTwoSidedInverse"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi A
                  %mo →
                  %mi B
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊢
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi qinv
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mover
                        %mi f
                        %mo ¯
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo →
                      %mi A
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Id
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo →
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mover
                    %mi f
                    %mo ¯
                  %mo ∘
                  %mi f
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ↦
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ×
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Id
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo →
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi f
                  %mo ∘
                  %mover
                    %mi f
                    %mo ¯
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ↦
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  f \colon A \to B
                  \\;\;\;\;\;\;
                  \\vdash
                  \\;\;\;\;\;\;
                  qinv(f)
                  \\coloneqq
                  \\underset{
                  \\overline{f} \colon B \to A
                  }{\sum}
                  \\;\;
                  Id_{(A \to A)}
                  \\big(
                  \\overline{f} \circ f
                  ,\,
