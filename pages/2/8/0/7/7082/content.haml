                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi B
                  %mo{:maxsize => "3em", :minsize => "3em"} [
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mover
                        %mi f
                        %mo ¯
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo →
                      %mi A
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
