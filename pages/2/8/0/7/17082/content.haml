                  %mi M
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thickmathspace"}
                  %mi ⧄
                  %mspace{:width => "thickmathspace"}
                  %mi Srjctv
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
