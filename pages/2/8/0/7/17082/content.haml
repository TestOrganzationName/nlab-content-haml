                    %mrow
                      %mi A
                      %mo ≠
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} A\neq \emptyset
                or
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo =
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A=B
            %li
