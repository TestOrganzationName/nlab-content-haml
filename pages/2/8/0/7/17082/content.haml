                is Abelian, for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                        %mo ,
                        %mo .
                        %mo .
                        %mo .
                        %mo ,
                        %mi n
                        %mo −
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} i=0,...,n-1
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
