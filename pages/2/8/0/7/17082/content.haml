                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi r
                    %annotation{:encoding => "application/x-tex"} \{\mathbb{Z} \to 0\}^{&amp;solb;  r}
                , resp.
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo →
                        %mi ℤ
                        %msup
                          %mo{:stretchy => "false"} }
                          %mrow
                            %mi ⧄
                            %mi r
                      %annotation{:encoding => "application/x-tex"} \{0\to \mathbb{Z}\}^{&amp;solb;  r}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                denotes the infinite
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            %li
              %p
                A group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is a
                %a.existingWikiWord{:href => "/nlab/show/free+group"} free group
                iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} 0\to F
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo →
                      %mi ℤ
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi r
                          %mi ℓ
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} \{0\to \mathbb{Z} \}^{&amp;solb;  r\ell},
            %li
              %p
                A group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is
                %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion-free
                iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} 0\to A
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi n
                      %mi ℤ
                      %mo →
                      %mi ℤ
                      %mo :
                      %mi n
                      %mo ≥
                      %mn 0
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi r
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} \{ n \mathbb{Z} \to \mathbb{Z} : n\ge0 \}^{&amp;solb;  r},
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                is
                %span.newWikiWord
                  pure
                  %a{:href => "/nlab/new/pure+subgroup"} ?
                iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} A \to B
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi n
                      %mi ℤ
                      %mo →
                      %mi ℤ
                      %mo :
                      %mi n
                      %mo ≥
                      %mn 0
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi r
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \{ n\mathbb{Z}\to \mathbb{Z} : n\ge0 \}^{&amp;solb;  r}.
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo →
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi l
                    %annotation{:encoding => "application/x-tex"} (*\to 1)^{&amp;solb; l}
                is the class of retracts
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo →
                      %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi r
                    %annotation{:encoding => "application/x-tex"} (1\to *)^{&amp;solb; r}
                is the class of split homomorphisms
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ⟶
                      %mi ℤ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi r
                    %annotation{:encoding => "application/x-tex"} (0\longrightarrow \mathbb{Z})^{&amp;solb; r}
                is the class of surjections
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo →
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi r
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z}\to 1)^{&amp;solb; r}
                is the class of injections
            %li
              %p
                a group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is free iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %mi F
                    %annotation{:encoding => "application/x-tex"} 1\to F
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ⟶
                      %mi ℤ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi rl
                    %annotation{:encoding => "application/x-tex"} (0\longrightarrow \mathbb{Z})^{&amp;solb;rl}
            %li
              %p
                a group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is Abelian iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} A\to 1
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔽
                        %mn 2
                      %mo →
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi r
                    %annotation{:encoding => "application/x-tex"} ( \mathbb{F}_2 \to \mathbb{Z}\times\mathbb{Z})^{&amp;solb; r}
            %li
              %p
                group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                can be obtained from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                by adding commutation relations, i.e.~the kernel of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H\to G
                is generated by commutators
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi h
                          %mn 1
                        %mo ,
                        %msub
                          %mi h
                          %mn 2
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [h_1,h_2]
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi h
                          %mn 1
                        %mo ,
                        %msub
                          %mi h
                          %mn 2
                        %mo ∈
                        %mi H
                      %annotation{:encoding => "application/x-tex"} h_1,h_2\in H
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo →
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H\to G
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔽
                        %mn 2
                      %mo →
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi rl
                    %annotation{:encoding => "application/x-tex"} ( \mathbb{F}_2 \to \mathbb{Z}\times\mathbb{Z})^{&amp;solb;rl}
            %li
              %p
                subgroup
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is the normal span of substitutions in words
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mn 1
                      %mo ,
                      %mo .
                      %mo .
                      %mo ,
                      %msub
                        %mi w
                        %mi i
                    %annotation{:encoding => "application/x-tex"} w_1,..,w_i
                of the free group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_n
                iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G \to G/H
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔽
                        %mi n
                      %mo →
                      %msub
                        %mi 𝔽
                        %mi n
                      %mo{:stretchy => "false"} /
                      %mo ≤
                      %mspace{:width => "negativethinmathspace"}
                      %msub
                        %mi w
                        %mn 1
                      %mo ,
                      %mo .
                      %mo .
                      %mo .
                      %mo ,
                      %msub
                        %mi w
                        %mi i
                      %mspace{:width => "negativethinmathspace"}
                      %mo ≥
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi rl
                    %annotation{:encoding => "application/x-tex"} ( \mathbb{F}_n \to \mathbb{F}_n/\le\!w_1,...,w_i\!\ge)^{&amp;solb;rl}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo →
                      %mi A
                      %mo :
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mtext abelian
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi ℓ
                          %mi l
                    %annotation{:encoding => "application/x-tex"} \{0\to A : A\,\,\text{ abelian}\}^{&amp;solb; \ell l}
                is the class of homomorphisms whose kernel is perfect
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/finite+group"} finite group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                      %mo{:stretchy => "false"} }
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mi ⧄
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mi G
                      %mo →
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \{0\to {\mathbb{Z}}/p{\mathbb{Z}}\} \,\,&amp;solb;\,\, G\to 1
                iff the
                %a.existingWikiWord{:href => "/nlab/show/order"} order
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is prime to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mn 1
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi p
                      %mi ℤ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi rr
                    %annotation{:encoding => "application/x-tex"} G\to 1 \in (0\to {\mathbb{Z}}/p{\mathbb{Z}})^{&amp;solb;  rr}
                iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/p-group"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi p
                        %annotation{:encoding => "application/x-tex"} p
                    \-group
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                is nilpotent iff the diagonal map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo →
                      %mi H
                      %mo ×
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H\to H\times H
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo →
                      %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi ℓ
                          %mi r
                    %annotation{:encoding => "application/x-tex"} (1\to *)^{&amp;solb; \ell r}
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo →
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1\to *)
                denotes the class of maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo →
                      %mi G
                      %mo :
                      %mi G
                      %mtext arbitrary
                      %mo{:stretchy => "false"} }
                      %mo ,
                    %annotation{:encoding => "application/x-tex"} \{ 1\to G : G \text{ arbitrary}\},
            %li
              %p
                a finite group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                is
                %span.newWikiWord
                  soluble
                  %a{:href => "/nlab/new/soluble"} ?
                iff
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %mi H
                    %annotation{:encoding => "application/x-tex"} 1\to H
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo →
                      %mi A
                      %mo :
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mtext abelian
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi ℓ
                          %mi r
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi G
                      %mo :
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mtext arbitrary
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi ℓ
                          %mi r
                      %mo .
                    %annotation{:encoding => "application/x-tex"} \{0\to A : A\,\,\text{ abelian}\}^{&amp;solb; \ell r}=\{[G,G]\to G : G\,\,\text{ arbitrary } \}^{&amp;solb; \ell r}.
          %p Moreover,
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo →
                      %mi G
                      %mo :
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mtext arbitrary
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi ℓ
                          %mi r
                    %annotation{:encoding => "application/x-tex"} \{0\to G : G\,\,\text{ arbitrary}\}^{&amp;solb; \ell r}
                is the class of subnormal subgroups
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo →
                      %mi A
                      %mo :
                      %mi A
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mtext abelian
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi ℓ
                          %mi r
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi G
                      %mo :
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mtext arbitrary
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi ℓ
                          %mi r
                    %annotation{:encoding => "application/x-tex"} \{0\to A : A\,\,\text{ abelian}\}^{&amp;solb; \ell r}=\{[G,G]\to G : G\,\,\text{ arbitrary } \}^{&amp;solb; \ell r}
                , and is the class of subgroups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ≤
                      %mi G
