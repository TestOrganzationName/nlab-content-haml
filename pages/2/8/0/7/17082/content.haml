                      %mo ≤
                      %mo{:stretchy => "false"} |
                      %mi J
                      %mo{:stretchy => "false"} |
                      %mo ,
                      %mi J
                      %mo ⊂
                      %mi I
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"}
                      \\emptyset\to X \,\,&amp;solb;\,\,
                      \\{ (F,J): 1\leq |F|\leq n+1, F\subset J\subset I\}\longrightarrow
                      \\{ J: 1\leq |J|, J\subset I\}
                where the order on the domain
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
