                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo →
                      %mi S
                      %msup
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi ⧄
                          %mi ℓ
                          %mi r
                    %annotation{:encoding => "application/x-tex"} \{1 \to S\}^{&amp;solb; \ell r}
                is the class of subgroups
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ≤
                      %mi G
