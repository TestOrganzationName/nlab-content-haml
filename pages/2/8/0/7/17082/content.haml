                      %mo =
                      %mi G
                    %annotation{:encoding => "application/x-tex"} H=G_0 \vartriangleleft G_1  \vartriangleleft \ldots  \vartriangleleft G_n =G
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
