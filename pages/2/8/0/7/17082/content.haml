                it holds that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi o
                      %mo{:stretchy => "false"} }
                      %mo ⟶
                      %mi K
                    %annotation{:encoding => "application/x-tex"} \{o\}\longrightarrow K
                is in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
