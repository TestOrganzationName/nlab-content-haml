                  %mi M
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thickmathspace"}
                  %mi ⧄
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo →
                  %mi R
                  %msup
                    %mo{:stretchy => "false"} }
                    %mi ⧄
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
