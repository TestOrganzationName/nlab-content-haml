                      %mi J
                      %mo ⊂
                      %mi I
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{ (F,J): 1\leq |F|\leq n+1, F\subset J\subset I\}
                is given by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
