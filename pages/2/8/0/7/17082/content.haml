                          %mi ⧄
                          %mi rll
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo{:stretchy => "false"} }
                      %mo ⟶
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} }
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi l
                    %annotation{:encoding => "application/x-tex"} (\emptyset\longrightarrow \{o\})^{&amp;solb;rll} = (\{a\}\longrightarrow \{a,b\})^{&amp;solb;l}
            %li
              %p
                A topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                has Lebesgue dimension at most
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                iff for each finite set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo →
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mi ⧄
                      %mspace{:width => "thinmathspace"}
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} {
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ,
                      %mi J
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mn 1
                      %mo ≤
                      %mo{:stretchy => "false"} |
                      %mi F
                      %mo{:stretchy => "false"} |
