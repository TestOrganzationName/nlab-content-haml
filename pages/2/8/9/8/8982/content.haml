                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                already defined in the dependent type theory, and the flat modality is only defined for types in the universe
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ♯
                        %mi U
                      %annotation{:encoding => "application/x-tex"} \sharp U
          %h4#natural_deduction_inference_rules Natural deduction inference rules
          %p
            We assume a
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            with crisp term judgments
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a::A
            in addition to the usual (cohesive) type and term judgments
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mspace{:width => "thickmathspace"}
                  %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} A \; \mathrm{type}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a:A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ξ
                  %mo{:stretchy => "false"} |
