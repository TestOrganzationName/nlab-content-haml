                  %mrow
                    %mi k
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} k:X\to Y
              to the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mi X
                    %mo →
                    %mi S
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} S X \to S Y
              which takes a zero-one measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} p\in S X
              and gives the zero-one measure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              defined by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ↦
                      %mi p
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi k
                        %mo *
                      %mi B
                      %mo{:stretchy => "false"} )
