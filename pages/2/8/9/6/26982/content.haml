                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mu_S(\delta_S(p))(A) \;=\; \delta_S(p)(A^*) \;=\; 1_{A^*}(p) \;=\; p(A)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi S
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi μ
                    %mi S
                  %mo{:stretchy => "false"} (
