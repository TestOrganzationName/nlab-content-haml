                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mo *
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\delta_S(\mu_S(\pi))(A^*) \;=\; 1_{A*}(\mu_S(\pi)) \;=\; \mu_S(\pi)(A) \;=\; \pi(A^*) .
          %p
            Therefore (using the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ↦
                  %msup
                    %mi A
                    %mo *
                %annotation{:encoding => "application/x-tex"} A\mapsto A^*
            is a bijection),
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi δ
                    %mi S
                  %mo :
                  %mi S
                  %mi X
                  %mo →
                  %mi S
                  %mi S
                  %mi X
                %annotation{:encoding => "application/x-tex"} \delta_S: S X\to S S X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi μ
