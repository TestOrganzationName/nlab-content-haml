          %p
            We take as unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi S
                %annotation{:encoding => "application/x-tex"} \eta_S
            the resulting map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi S
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X\to S X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi η
                    %mi S
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mn 1
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mi x
                            %mo ∈
                            %mi A
                            %mo ;
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi x
                            %mo ∉
                            %mi A
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\eta_S(x)(A) \;=\; 1_A(x) \;=\; \begin{cases}
                  1 &amp; x\in A ; \\
                  0 &amp; x\notin A .
                  \\end{cases}
          %p
          .num_prop
            %h6 Proposition
            %p
              The assignment
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↦
                    %msup
                      %mi A
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A\mapsto A^*
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/sigma-algebras"} sigma-algebras
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mi X
                      %mo →
                      %msub
                        %mi Σ
                        %mrow
                          %mi S
                          %mi X
                    %annotation{:encoding => "application/x-tex"} \Sigma_X\to \Sigma_{S X}
