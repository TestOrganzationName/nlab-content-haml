                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mn 1
                    %mrow
                      %mi A
                      %mo *
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi μ
                    %mi S
                  %mo{:stretchy => "false"} (
