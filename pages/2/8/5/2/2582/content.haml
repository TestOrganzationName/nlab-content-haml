                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %em Whitehead tower
            of a
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an interpolation of the point inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} * \to X
            by a sequence of homotopy types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mi ⋯
                  %mo →
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  * \to \cdots \to X^{(2)} \to X^{(1)} \to X^{(0)}
                  \\simeq X
          %p
            that are obtained from right to left by
            = succeed "," do
              %em
                removing
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
                from below
          %ul
            %li
              %p
                each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X^{(n)}
                is
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                %a.existingWikiWord{:href => "/nlab/show/n-simply+connected+space"} connected
            %li
              %p
                and each
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X^{(n+1)} \to X^{(n)}
                induces an
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                on all
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
                in degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ≥
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} k \geq (n+1)
                (and the inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo →
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 1 \to \pi_n(X^{(n)})
                in degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                as well as the identity
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1 = 1
                in degree
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo &lt;
                        %mi n
                      %annotation{:encoding => "application/x-tex"} k \lt n
          %p
            The notion of Whitehead tower is
            %a.existingWikiWord{:href => "/nlab/show/duality"} dual
            to the notion of
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"} X \to *
            into a tower, where homotopy groups are
            %em added
            from right to left.
          %p
            In fact, the Whitehead tower may be constructed by taking each stage
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X^{(n+1)} \to X
            to be the
            %em
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of the corresponding map into the
            = succeed "st" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
          %h2#definition Definition
          %p
            The construction of Whitehead towers is traditionally done for
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            regarded up to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          %p
            The
            %strong Whitehead tower
            of a
            %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a sequence of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo →
                  %mi ⋯
                  %mo →
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi X
                %annotation{:encoding => "application/x-tex"} * \to \cdots \to X^{(2)} \to X^{(1)} \to X^{(0)} \simeq X
          %p
            where
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X^{(n)}
            is
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msub
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to X_{(n+1)}
            into the item
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X_{(n+1)}
            in the
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Here each
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi X
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi X
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X^{(n)} &amp;\to&amp; *
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  X &amp;\to&amp; X_{(n+1)}
                  }
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            may be computed (as described at
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            in the 1-
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            of a fibrantly replaced diagram, for instance with the point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            replaced by the path fibration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"} P X_{(n+1)} \simeq *
            %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibration"} Hurewicz fibration
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %msub
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo +
                        %mn 1
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P X_{(n+1)} \to X_{(n+1)}
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X^{(n)}\to X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi X
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi P
                          %msub
                            %mi X
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi X
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X^{(n)} &amp;\to&amp; P X_{(n+1)}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  X &amp;\to&amp; X_{(n+1)}
                  }
          %p is a fibration, and this is often taken as part of the definition of the Whitehead tower.
          %p
            From this perspective the
            %em Whitehead tower
            of a
            %a.existingWikiWord{:href => "/nlab/show/pointed+space"} pointed space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,x)
            is a sequence of fibrations
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi …
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi …
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mn 0
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\ldots \to X\langle n\rangle \to \ldots \to X\langle 1 \rangle \to X\langle 0 \rangle \to X
          %p
            where each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} X\langle n\rangle \to X\langle n-1 \rangle
            induces isomorphisms on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi i
                %annotation{:encoding => "application/x-tex"} \pi_i
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo &gt;
                  %mi n
                %annotation{:encoding => "application/x-tex"} i\gt n
            and such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} X\langle n\rangle
            is
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/n-connected"} connected
            (has trivial
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mi i
                %annotation{:encoding => "application/x-tex"} \pi_i
            for
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≤
                    %mi n
                  %annotation{:encoding => "application/x-tex"} i \leq n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} X\langle n\rangle \to X\langle n-1 \rangle
            is a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(\pi_{n-1}(X,x),n-1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Mac+Lane+space"} Eilenberg-Mac Lane space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} K(\pi_{n-1}(X,x),n-1)
            which is an abelian topological group; this has a remarkable consequence when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi e
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,x)=(G,e)
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} G\langle n\rangle
            has a model which is a topological group, which is an abelian group extension:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi K
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"}
                  1\to K(\pi_{n-1}(X,x),n-1) \to G\langle n\rangle \to G\langle n-1 \rangle \to 1
          %p
            For instance, the
            %a.existingWikiWord{:href => "/nlab/show/string+group"} string group
            can be realized as a topological group as a
            = succeed "-extension" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\mathbb{Z},2)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} n=0
            we require that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mn 0
                  %mo{:stretchy => "false"} ⟩
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} X\langle 0 \rangle \hookrightarrow X
            is the inclusion of the path-component of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+%28as+an+operation%29"} homotopy
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is locally connected and semilocally path-connected, then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} X\langle 1\rangle
            can be chosen as the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+covering+space"} universal covering space
          %p
            In traditional models this construction is highly non-
            %a.existingWikiWord{:href => "/nlab/show/functor"}> functor
            ial, except for nice spaces in low dimensions as remarked above.
          %h2#constructions Constructions
          %h3#whiteheads_construction Whitehead’s construction
          %p
            %a{:href => "#Whitehead"} Whitehead 1952
            answered the question, posed by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Witold+Hurewicz"} Witold Hurewicz
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X\langle n\rangle \to X
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} X\langle n\rangle
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            The construction proceeds as follows (using modern terminology). Given a pointed space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
          %ul
            %li
              %p
                Choose a representative for the
                %a.existingWikiWord{:href => "/nlab/show/Postnikov+section"} Postnikov section
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X_n
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ↪
                      %msub
                        %mi X
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X \hookrightarrow X_n
                is a closed subspace (I would be tempted to make it a closed cofibration, but I don’t know any reason for this to be necessary -DMR).
            %li
              %p
                Form the
                = succeed "-connected" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} X_n
                %a.existingWikiWord{:href => "/nlab/show/path+fibration"} path fibration
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %msub
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} P X_n
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Hurewicz+fibration"} Hurewicz fibration
            %li
              %p
                Pull this back to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo{:stretchy => "false"} ⟨
                        %mi n
                        %mo{:stretchy => "false"} ⟩
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} p\colon X\langle n\rangle \to X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                has the desired properties.
          %p
            This gives us a single
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi …
                  %mo →
                  %msub
                    %mi X
                    %mi n
                  %mo →
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo →
                  %mi …
                  %mo →
                  %msub
                    %mi X
                    %mn 1
                  %mo →
                  %msub
                    %mi X
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  X \to (\ldots \to X_n \to X_{n-1} \to \ldots \to X_1 \to X_0)
          %p
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %msub
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"} X \to X_n
            is the inclusion of a closed subspace, it is simple to see there are induced maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo{:stretchy => "false"} ⟩
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} ⟨
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} X\langle n\rangle \to X\langle n-1\rangle
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            One way of obtaining a Postnikov section as above is to choose representatives
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi S
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \phi_g\colon S^{n+1} \to X
            of generators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_{n+1}(X,x)
            and attaching cells:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msup
                      %mi B
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %msub
                      %mo ∪
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi ϕ
                          %mi g
                        %mo{:stretchy => "false"} }
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X(1)\coloneqq B^{n+2} \cup_{\{\phi_g\}} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_{n+2}(X(1),x)
            and attach cells and so on. The colimit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi lim
                    %mrow
                      %mo →
                      %mi n
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lim_{\to n} X(n)
            is then a Postnikov section with the properties we require.
          %p
            Understandably, this process is unbelievably non-canonical, and so we are generally reduced to existence theorems using this method – unless there is a functorial way to construct Postnikov sections. Strictly speaking we can only say
            %em an
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/well-connected+space"} well-connected space
          %h3#functorial_constructions Functorial constructions
          %p
            The
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of the map from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Postnikov+tower"} Postnikov tower
            %a.existingWikiWord{:href => "/nlab/show/path+object"} path space
            of the target).
          %p
            The
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is also the cofibrant replacement for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in the right
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization"} Bousfield localization
            of
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            with respect to the object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S^n
            (or so). Since
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            is right proper and cellular this localization exists by the result of chapter 5 of Hirschhorn’s book on
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model categories
          %p
            Another straightforward construction was mentioned by
            = succeed ":" do
              %a{:href => "#Clausen10"} Clausen 2010
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi …
                  %mo →
                  %msup
                    %mi B
                    %mn 3
                  %msup
                    %mi Ω
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi B
                    %mn 2
                  %msup
                    %mi Ω
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \ldots \to B^{3} \Omega^{3} (X) \to B^{2} \Omega^{2} (X) \to B \Omega (X) \to X
          %h2#examples Examples
          %h3#OfTheOrthogonalGroup Whitehead tower of the orthogonal group
          %p
            The Whitehead tower of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of the
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n)
            starts out as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mtext Whitehead tower
                      %mtr
                        %mtd
                        %mtd
                          %mi ⋮
                      %mtr
                        %mtd
                        %mtd
                          %mi B
                          %mi Fivebrane
                        %mtd
                          %mo →
                        %mtd
                          %mi ⋯
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mtext second frac Pontr. class
                        %mtd
                          %mi B
                          %mi String
                        %mtd
                          %mo →
                        %mtd
                          %mi ⋯
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 6
                              %msub
                                %mi p
                                %mn 2
                        %mtd
                          %msup
                            %mi B
                            %mn 8
                          %mi ℤ
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mtext first frac Pontr. class
                        %mtd
                          %mi B
                          %mi Spin
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mn 2
                              %msub
                                %mi p
                                %mn 1
                        %mtd
                          %msup
                            %mi B
                            %mn 4
