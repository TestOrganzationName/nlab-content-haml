          %p
          #ComplexConjugation.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"}> complex conjugation
                )
              %br/
              The
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              – regarded as an
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              over the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              – form a star-algebra with anti-involution (which here is an involution, since the product is
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"} commutative
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
          %p
          .num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+construction"}> Cayley-Dickson construction
                )
              The
              %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+construction"} Cayley-Dickson construction
              takes any star-algebra over the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              to a new star algebra.
            %p
              Applied to the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              trivially regarded as a star-algebra (via Example
              = succeed ")," do
                %a.maruku-ref{:href => "#TrivialStarStructure"}
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                  (Example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#TrivialStarStructure"}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
                  (Example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#ComplexConjugation"}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/octonions"} octonions
            %p
              (which are the four
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/real+normed+division+algebras"} real normed division algebras
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/sedenions"} sedenions
              %li
                %p …
            %p
              In each case the star-operation may be thought of as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+conjugation"} complex conjugation
              %a.existingWikiWord{:href => "/nlab/show/imaginary+part"} imaginary part
              and keeping the
              %a.existingWikiWord{:href => "/nlab/show/real+part"} real part
              intact.
            %p
          %p
          .num_remark
            %h6 Example
            %p
              %strong
                (operators on a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              The algebra of
              %a.existingWikiWord{:href => "/nlab/show/continuous+operators"} continuous operators
              on a
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              is a star-algebra, with the
              %a.existingWikiWord{:href => "/nlab/show/Hermitian+adjoint"} Hermitian adjoint
              as the anti-involution.
          %p
          .num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/C-star+algebras"}> C-star algebras
                )
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/C-star+algebra"} C-star algebra
              is a star-algebra where the anti-involution is compatible with the
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              of the underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Banach+algebra"} Banach algebra
          %h3#InvolutiveHopfAlgebras Involutive Hopf algebras
          %p
          #InvolutiveHopfAlgebrasAreStarAlgebras.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/involutive+Hopf+algebras"} involutive Hopf algebras
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/star-algebras"} star-algebras
              %br/
              Any
              %a.existingWikiWord{:href => "/nlab/show/involutive+Hopf+algebra"} involutive Hopf algebra
              is a star-algebra, with star-involution given by the
              %a.existingWikiWord{:href => "/nlab/show/antipode"} antipode
              (by
              = succeed ")." do
                %a{:href => "Hopf+algebra#AntipodeIsAnAntihomomorphism"} this Prop.
          %p
          .num_remark
            %h6 Example
            %p
              %strong (groupoid algebras are star-algebras)
              A
              %a.existingWikiWord{:href => "/nlab/show/group+algebra"} group algebra
              and, more generally, a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/groupoid+convolution+algebra"} groupoid convolution algebra
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              given by pullback along the
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inversion
              operation of the groupoid.
            %p
              Yet more generally, the
              %a.existingWikiWord{:href => "/nlab/show/category+convolution+algebra"} category convolution algebra
              of a
              %a.existingWikiWord{:href => "/nlab/show/dagger-category"} dagger-category
              is a
              = succeed "-algebra," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo †
                  %annotation{:encoding => "application/x-tex"} \dagger
              operation.
            %p
              All these are
              %a.existingWikiWord{:href => "/nlab/show/involutive+Hopf+algebras"} involutive Hopf algebras
              (since taking
              %a.existingWikiWord{:href => "/nlab/show/inverses"} inverses
              and taking
              %a.existingWikiWord{:href => "/nlab/show/dagger-category"} dagger-operations
              squares to the identity) and as such are special cases of Example
              %a.maruku-ref{:href => "#InvolutiveHopfAlgebrasAreStarAlgebras"}
          %p
          #StarAlgebraOfHorizontalChordDiagrams.num_remark
            %h6 Example
            %p
              %strong
                (star-algebra of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
              %br/
              The algebra of
              %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
              is a star-algebra under reversal of orientation of strands (see
              = succeed "," do
                %a{:href => "horizontal+chord+diagram#StarAlgebraStructure"} here
              = succeed ")." do
                %a{:href => "#CSS21"} CSS 21, Prop. 2.9
            %p
              Since
              %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams+are+the+homology+of+the+loop+space+of+configuration+space"} horizontal chord diagrams are the homology of the loop space of configuration space
              and the
              %a.existingWikiWord{:href => "/nlab/show/homology+of+a+loop+space"} homology of a loop space
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/involutive+Hopf+algebra"} involutive Hopf algebra
              = succeed "." do
                %a.maruku-ref{:href => "#InvolutiveHopfAlgebrasAreStarAlgebras"}
          %h2#generalizations Generalizations
          %p
            This concept could be generalized from the category of
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi I
                  %mo ,
                  %mo ⊗
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C, I, \otimes)
            be a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi e
                  %mo :
                  %mi I
                  %mo →
                  %mi A
                  %mo ,
                  %mi π
                  %mo :
                  %mi A
                  %mo ⊗
                  %mi A
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A, e:I \to A, \pi:A \otimes A \to A)
            be a
            %a.existingWikiWord{:href => "/nlab/show/unital+algebra+object"} unital algebra object
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            is a
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              \-algebra object
            %a.existingWikiWord{:href => "/nlab/show/internalization"} in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            if it comes with a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \iota:A \to A
            such that
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ι
                      %mo ∘
                      %mi ι
                      %mo =
                      %msub
                        %mi{:mathvariant => "normal"} id
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \iota \circ \iota = \mathrm{id}_A
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ι
                      %mo ∘
                      %mi e
                      %mo =
                      %mi e
                    %annotation{:encoding => "application/x-tex"} \iota \circ e = e
            %li
              %p
                for all morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo :
                      %mi I
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} a:I \to A
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo :
                        %mi I
                        %mo →
                        %mi A
                      %annotation{:encoding => "application/x-tex"} b:I \to A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo ∘
                  %mi π
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi π
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi ι
                  %mo ∘
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi ι
                  %mo ∘
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \iota \circ \pi \circ (a \otimes b) = \pi \circ ((\iota \circ b) \otimes (\iota \circ a))
          %p
            In the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/anti-involution"} anti-involutive
                %a.existingWikiWord{:href => "/nlab/show/unital+magmas"} unital magmas
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+of+abelian+groups"} category of abelian groups
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/%2A-rings"} *-rings
