          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Bourbaki71"} Bourbaki 71, section I.4
          .proof
            %h6#proof Proof
            %p
              The required
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %munder
                          %mi lim
                          %mo ⟵
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi S
                        %mi i
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi τ
                        %mi initial
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi p
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
