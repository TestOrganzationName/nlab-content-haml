                          %mo ∈
                          %mi S
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \underset{s \in S}{\coprod}\ast
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              itself equipped with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/final+topology"} final topology
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
          #ProductTopologicalSpace.num_example
            %h6#example_6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
              a set of topological spaces, their
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mo ∈
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod} X_i \in Top
              is the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of the underlying sets equipped with the
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Tychonoff+product"} Tychonoff product
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \times Y
              %a.existingWikiWord{:href => "/nlab/show/basis+for+a+topology"} sub-basis
              for the product topology is given by the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              of the open subsets of (a basis for) each factor space.
          #EqualizerInTop.num_example
            %h6#example_7 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
              of two
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f, g \colon X \stackrel{\longrightarrow}{\longrightarrow} Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              is the equalizer of the underlying functions of sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi eq
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi S
                      %mi X
                    %mover
                      %munder
                        %mo ⟶
                        %mi g
                      %mover
                        %mo ⟶
                        %mi f
                    %msub
                      %mi S
                      %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    eq(f,g)
                    \\hookrightarrow
                    S_X
                    \\stackrel{\overset{f}{\longrightarrow}}{\underset{g}{\longrightarrow}}
                    S_Y
            %p
              (hence the largets subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi X
                  %annotation{:encoding => "application/x-tex"} S_X
              on which both functions coincide) and equipped with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalSubspace"}
          #CoequalizerInTop.num_example
            %h6#example_8 Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              of two
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f, g \colon X \stackrel{\longrightarrow}{\longrightarrow} Y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
              is the coequalizer of the underlying functions of sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi X
                    %mover
                      %munder
                        %mo ⟶
                        %mi g
                      %mover
                        %mo ⟶
                        %mi f
                    %msub
                      %mi S
                      %mi Y
                    %mo ⟶
                    %mi coeq
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S_X
                    \\stackrel{\overset{f}{\longrightarrow}}{\underset{g}{\longrightarrow}}
                    S_Y
                    \\longrightarrow
                    coeq(f,g)
            %p
              (hence the
              %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
              by the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
              generated by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∼
