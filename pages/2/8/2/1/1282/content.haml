                    %mi Top
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\sqcup} X_i \in Top
              is their
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
          %p In particular:
          #DiscreteTopologicalSpaceAsCoproduct.num_example
            %h6#example_5 Example
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} S \in Set
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of the point,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
