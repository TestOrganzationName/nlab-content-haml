                %a{:href => "#examplesoflimits"} Examples of limits
              %ul
                %li
                  %a{:href => "#limitssimplediagrams"} Simple diagrams
                %li
                  %a{:href => "#filteredlimits"} Filtered limits
                %li
                  %a{:href => "#limitsintermsofotherops"} In terms of other operations
                %li
                  %a{:href => "#limitsinpresheafcat"} Limits in presheaf categories
                %li
                  %a{:href => "#limitsinundercat"} Limits in under-categories
              %li
                %a{:href => "#further_resources"} Further resources
          %h2#limcoliminset Limits and colimits of sets
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            and
            %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            reduce to the familiar operations of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
              of sets;
            %li
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of sets;
            %li
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              defined by
              %a.existingWikiWord{:href => "/nlab/show/equations"} equations
            %li
              %a.existingWikiWord{:href => "/nlab/show/quotient+sets"} quotient sets
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relations"} equivalence relations
          %h3#limits Limits
          %h4#terminal_object Terminal object
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            is the limit of the empty functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi ∅
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F: \emptyset \to Set
            %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that there is a unique function from any set to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{a\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} Y \to \{a\}
            from any set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is the function that sends every element in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
          %h4#product Product
          %p
            Given two sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A, B
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            is the limit of the diagram (with no non-trivial maps)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi A
                        %mtd
                          %mi B
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  A &amp; B
                  }.
          %p
            This is given by the usual product of sets, which can be constructed as the set of
            %a.existingWikiWord{:href => "/nlab/show/Kuratowski+pairs"} Kuratowski pairs
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi B
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} }
                  %mo :
                  %mi a
                  %mo ∈
                  %mi A
                  %mo ,
                  %mi b
                  %mo ∈
                  %mi B
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  A \times B = \{ \{\{a\}, \{a, b\}\}: a \in A, b \in B\}.
          %p
            We tend to write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a, b)
            instead of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo{:stretchy => "false"} }
                    %mo ,
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\{a\}, \{a, b\}\}
          %p
            The projection maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo :
                  %mi A
                  %mo ×
                  %mi B
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \pi_1: A \times B \to A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 2
                  %mo :
                  %mi A
                  %mo ×
                  %mi B
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} \pi_2: A \times B \to B
            are given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi a
                  %mo ,
                  %msub
                    %mi π
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi b
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\pi_1(a, b) = a, \pi_2(a, b) = b.
          %p
            To see this satisfies the universal property of products, given any pair of maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} f: X \to A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} g: X \to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi X
                  %mo →
                  %mi A
                  %mo ×
                  %mi B
                %annotation{:encoding => "application/x-tex"} (f, g): X \to A \times B
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (f, g)(x) = (f(x), g(x)).
          %p
            More generally, given a (possibility infinite) collection of sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi A
                      %mi α
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi α
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{A_\alpha\}_{\alpha \in I}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi α
                        %mo ∈
                        %mi I
                    %msub
                      %mi A
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \prod_{\alpha \in I} A_\alpha
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi α
                      %mo ∈
                      %mi I
                  %msub
                    %mi A
                    %mi α
                  %mo =
                  %mrow
                    %mo {
                    %mi f
                    %mo :
                    %mi I
                    %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mrow
                        %mi α
                        %mo ∈
                        %mi I
                    %msub
                      %mi A
                      %mi α
                    %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} ∣
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi α
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msub
                      %mi A
                      %mi α
                    %mspace{:width => "thickmathspace"}
                    %mtext for all
                    %mspace{:width => "thickmathspace"}
                    %mi α
                    %mo ∈
                    %mi I
                    %mo }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{\alpha \in I} A_\alpha = \left\{f: I \to \bigcup_{\alpha \in I} A_\alpha \mid f(\alpha) \in A_\alpha\;\text{ for all }\;\alpha \in I\right\}.
          %h4#equalizer Equalizer
          %p
            Given a pair of functions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ,
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f, g: X \to Y
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            is the limit of the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %munder
                            %mover
                              %mo ⇉
                              %mi f
                            %mi g
                        %mtd
                          %mi Y
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  X &amp; \underset{g}{\overset{f}{\rightrightarrows}} &amp; Y
                  }.
          %p
            The limit is given by a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo :
                  %mi A
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} e: A \to X
            such that given any
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi B
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} a: B \to X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∘
                    %mi a
                    %mo =
                    %mi g
                    %mo ∘
                    %mi a
                  %annotation{:encoding => "application/x-tex"} f \circ a = g \circ a
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            factors through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} im
                    %mi a
                    %mo ⊆
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ∈
                    %mi X
                    %mo :
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \im a \subseteq \{x \in X: f(x) = g(x)\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo ∈
                  %mi X
                  %mo :
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  A = \{x \in X: f(x) = g(x)\},
          %p
            and the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo :
                  %mi A
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} e: A \to X
            is given by the inclusion.
          %h4#pullback Pullback
          %p
            Given two maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} f: A \to C
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} g: B \to C
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            is the limit of the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi A
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi f
                      %mtr
                        %mtd
                          %mi B
                        %mtd
                          %munder
                            %mo →
                            %mi g
                        %mtd
                          %mi C
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; &amp; A\\
                  \&amp; &amp; \downarrow^\mathrlap{f}\\
                  B &amp; \underset{g}{\to} &amp; C
                  }.
          %p This limit is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi A
                  %mo ×
                  %mi B
                  %mo :
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\{(a, b) \in A \times B: f(a) = g(b)\},
          %p
            with the maps to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            given by the projections.
          %p
            While the definition of a pullback is symmetric in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            (or the other way round). This has more natural interpretations in certain special cases.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} g: B \to C
            is the inclusion of a subset (ie. is a
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ∈
                  %mi A
                  %mo :
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi B
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\{a \in A: f(a) \in B\}.
          %p
            So this is given by restricting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to the elements that are mapped into
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            Further, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} f: A \to C
            is
            %em also
            the inclusion fo a subset, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are both subobjects of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %p
            Alternatively, we can view the map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} f: A \to C
            as a collection of sets indexed by elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} c \in C
            is given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi c
                    %mo =
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_c = f^{-1}(c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            back along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            gives a collection of sets indexed by elements of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} b \in B
            is given b
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mrow
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_{g(b)}
          %h4#general_limits General limits
          %p
            Given a general
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi D
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} F : D \to Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lim
                  %mi F
                %annotation{:encoding => "application/x-tex"} lim F
            exists, then by definition, for any set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi A
                  %mo →
                  %mi lim
                  %mi F
                %annotation{:encoding => "application/x-tex"} f: A \to lim F
            is equivalent to a compatible family of maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi d
                  %mo :
                  %mi A
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f_d: A \to F(d)
            for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \in Obj(D)
          %p
            In particular, since an element of a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            bijects with maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} 1 \to X
            from the singleton
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi ∅
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} 1 = \{\emptyset\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lim
                  %mi F
                  %mo ≅
                  %mi Set
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi lim
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mo{:stretchy => "false"} [
                  %mi D
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi const
                    %mn 1
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  lim F \cong Set (1, lim F) \cong [D, Set](const_1, F),
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi const
                    %mn 1
                %annotation{:encoding => "application/x-tex"} const_1
            is the functor that constantly takes the value
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi const
                    %mn 1
                %annotation{:encoding => "application/x-tex"} const_1
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            More concretely, a compatible family of maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo →
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 1 \to F(d)
            is given by an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi s
                    %mi d
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} s_d \in F(d)
            for each
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \in Obj(d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi d
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \prod_{d \in Obj(d)} F(d)
            of all objects:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi lim
                  %mi F
                  %mo =
                  %mrow
                    %mo {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi d
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi d
                    %mo ∈
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mi d
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo ∀
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mover
                      %mo →
                      %mi f
                    %mi d
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi s
                      %mrow
                        %mi d
                        %mo ′
                    %mo }
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  lim F = \left\{ (s_d)_d \in \prod_d F(d) | \forall (d \stackrel{f}{\to} d') : F(f)(s_{d}) = s_{d'}  \right\}.
          %h3#colimits Colimits
          %h4#initial_object Initial object
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that there is a unique map from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to any other set. This is given by the empty set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \emptyset
          %h4#coproduct Coproduct
          %p (…)
          %h4#coequalizer Coequalizer
          %p (…)
          %h4#pushout Pushout
          %p (…)
          %h4#general_colimits General colimits
          %p
            The colimit over a
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi D
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F : D \to Set
            is a quotient set of the disjoint union
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi d
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \coprod_{d \in Obj(D)} F(d)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi colim
                  %mi F
                  %mo ≃
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi d
                        %mo ∈
                        %mi D
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo )
                  %msub
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  colim F \simeq \left(\coprod_{d\in D} F(d)\right)/_\sim \,,
          %p
            where the equivalence relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            is that which is
            %em generated
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ′
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mi if
                  %mspace{:width => "1em"}
                  %mo{:stretchy => "false"} (
                  %mo ∃
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo :
                  %mi d
                  %mo →
                  %mi d
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mi with
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ((x \in F(d)) \sim (x' \in F(d')))\quad if \quad (\exists (f : d \to d') \quad with F(f)(x) = x')
                  \\,.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a
            %a.existingWikiWord{:href => "/nlab/show/filtered+category"} filtered category
            then the resulting equivalence relation can be described as follows:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ∼
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ′
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mi iff
                  %mspace{:width => "1em"}
                  %mo{:stretchy => "false"} (
                  %mo ∃
                  %mi d
                  %mo ″
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo :
                  %mi d
                  %mo →
                  %mi d
                  %mo ″
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo :
                  %mi d
                  %mo ′
                  %mo →
                  %mi d
                  %mo ″
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mi with
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  ((x \in F(d)) \sim (x' \in F(d')))\quad iff \quad (\exists d'', (f : d \to d''), (g: d' \to d'') \quad with F(f)(x) = F(g)(x'))
                  \\,.
          %p
            (If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is not filtered, then this description doesn’t yield an equivalence relation.)
          %h2#OfTopologicalSpaces Limits and colimits of topological spaces
          %p
            We discuss limits and colimits in the category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %div
            %p
              %strong
                examples of
                = succeed ":" do
                  %a{:href => "Top#UniversalConstructions"} universal constructions of topological spaces
            %table
              %thead
                %tr
                  %th
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi AAAA
                        %annotation{:encoding => "application/x-tex"} \phantom{AAAA}
                    %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                  %th
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi AAAA
                        %annotation{:encoding => "application/x-tex"} \phantom{AAAA}
                    %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %tbody
                %tr
