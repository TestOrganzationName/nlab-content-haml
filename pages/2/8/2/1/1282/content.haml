                          %mo ⟶
                    %msub
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Groupoids
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"}
                    Func
                    \\big(
                    \\mathcal{C}^{op},
                    Groupoids_\infty
                    \\big)
                    \\underoverset
                    {
                    \\underset{const}{\longleftarrow}
                    }
                    {
                    \\overset{ \underset{\longrightarrow}{\lim} }{\longrightarrow}
                    }
                    {\phantom{AA}\bot\phantom{AA}}
                    \\Groupoids_\infty
            %p
              and the second step is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
          %h2#examplesoflimits Examples of limits
          %p
            In the following examples,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is any category and the limit is taken over a functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi D
                      %mi op
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : D^{op} \to C
          %h3#limitssimplediagrams Simple diagrams
          %ul
            %li
              %p
                the limit of the empty diagram
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} D = \emptyset
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is, if it exists
                %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} F : D \to C
                is just a collection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi i
                    %annotation{:encoding => "application/x-tex"} c_i
                of objects of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %a.existingWikiWord{:href => "/nlab/show/product"} product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi i
                      %msub
                        %mi c
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \prod_i c_i
                of these.
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mover
                        %mo →
                        %mo →
                      %mi b
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} D = \{a \stackrel{\to}{\to} b\}
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mi F
                    %annotation{:encoding => "application/x-tex"} lim F
                is the
                %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
                of the two morphisms
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(b) \to F(a)
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                has an
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                (so that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is an
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                in
                = succeed ")," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mi op
                      %annotation{:encoding => "application/x-tex"} D^{op}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %msup
                        %mi D
                        %mi op
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} F : D^{op} \to C
                is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi I
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(I)
          %h3#filteredlimits Filtered limits
          %ul
            %li
              %p
                if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/poset"} poset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi op
                    %annotation{:encoding => "application/x-tex"} D^{op}
                is the supremum over the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(d)
                with respect to
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo ⇔
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                        %mover
                          %mo ←
                          %mrow
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mo ≤
                            %mo{:stretchy => "false"} )
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (F(d) \leq F(d')) \Leftrightarrow (F(d) \stackrel{F(\leq)}{\leftarrow} F(d'))
            %li
              %p
                the generalization of this is where the term “limit” for categorical limit (probably) originates from: for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/filtered+category"} filtered category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi op
                    %annotation{:encoding => "application/x-tex"} D^{op}
                a cofiltered category, one may think of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mover
                        %mo →
                        %mi f
                      %mi d
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ←
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (d \stackrel{f}{\to} d') \mapsto (F(d) \stackrel{F(f)}{\leftarrow} F(d')
                as witnessing that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(d')
                is “larger than”
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(d)
                in some sense, and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mi F
                    %annotation{:encoding => "application/x-tex"} lim F
                is then the “largest” of all these objects, the limiting object. This interpretation is perhaps more evident for filtered
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimits
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is thought of as being the
                %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo =
                        %msup
                          %mi E
                          %mi op
                      %annotation{:encoding => "application/x-tex"} C = E^{op}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/ind-object"} ind-object
          %h3#limitsintermsofotherops In terms of other operations
          %p
            If products and equalizers exist in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi D
                    %mi op
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F : D^{op} \to C
            can be exhibited as a
            %a.existingWikiWord{:href => "/nlab/show/subobject"} subobject
            of the
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            of the
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(d)
            %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
            of
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi d
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msub
                        %mi p
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} ⟩
                        %mrow
                          %mi f
                          %mo ∈
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{d \in Obj(D)}
                  F(d)
                  \\stackrel{\langle F(f) \circ p_{F(t(f))} \rangle_{f \in Mor(D)} }{\to}
                  \\prod_{f \in Mor(D)}
                  F(s(f))
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi d
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} ⟨
                      %msub
                        %mi p
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} ⟩
                        %mrow
                          %mi f
                          %mo ∈
                          %mi Mor
                          %mo{:stretchy => "false"} (
                          %mi D
                          %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi f
                      %mo ∈
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\prod_{d \in Obj(D)}
                  F(d)
                  \\stackrel{\langle p_{F(s(f))} \rangle_{f \in Mor(D)} }{\to}
                  \\prod_{f \in Mor(D)}
                  F(s(f))
                  \\,.
          %p
            See the explicit formula for the limit in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            in terms of a subset of a product set.
          %p In particular therefore, a category has all limits already if it has all products and equalizers.
          %h3#limitsinpresheafcat Limits in presheaf categories
          %p
            Consider limits of functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi D
                    %mi op
                  %mo →
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F : D^{op} \to PSh(C)
            with values in the
            %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
            over a
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          #LimitsOfPresheaves.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/limits+of+presheaves+are+computed+objectwise"}> limits of presheaves are computed objectwise
                )
            %p Limits of presheaves are computed objectwise:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lim
                    %mi F
                    %mo :
                    %mi c
                    %mo ↦
                    %mi lim
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    lim F : c \mapsto lim F(-)(c)
            %p
              Here on the right the limit is over the functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi D
                        %mi op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} F(-)(c) : D^{op} \to Set
            %p Similarly for colimits
          %p
            Similarly
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo :
                    %mi C
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y : C \to PSh(C)
              commutes with small limits:
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %msup
                        %mi D
                        %mi op
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} F : D^{op} \to C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi lim
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi lim
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ∘
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Y(lim F) \simeq lim (Y\circ F)
            %p
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lim
                    %mi F
                  %annotation{:encoding => "application/x-tex"} lim F
              exists.
          %p
            %strong Warning
            The Yoneda embedding does
            %em not
            in general preserve colimits.
          %h3#limitsinundercat Limits in under-categories
          %p
            Limits in
            %a.existingWikiWord{:href => "/nlab/show/under+category"} under categories
            are a special case of limits in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma categories
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Limits in an
              %a.existingWikiWord{:href => "/nlab/show/under+category"} under category
              are computed as limits in the underlying category.
            %p
              Precisely: let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} t \in C
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} t/C
              the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/under+category"} under category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p : t/C \to C
              the obvious projection.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi D
                    %mo →
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : D \to t/C
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∘
                    %mi F
                  %annotation{:encoding => "application/x-tex"} p \circ F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              of the limit over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi lim
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi lim
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    p(\lim F)  \simeq \lim (p F)
            %p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi lim
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \lim F
              is uniquely characterized by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lim (p F)
          .proof
            %h6#proof_3 Proof
            %p
              Over a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo :
                    %mi d
                    %mo →
                    %mi d
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \gamma : d \to d'
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              the limiting cone over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} p F
              (which exists by assumption) looks like
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi lim
                            %mi p
                            %mi F
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; \lim p F
                    \\\
                    \&amp; \swarrow &amp;&amp; \searrow
                    \\\
                    p F(d) &amp;&amp;\stackrel{p F(\gamma)}{\to}&amp;&amp; p F(d')
                    }
            %p
              By the universal property of the limit this has a unique lift to a cone in the
              %a.existingWikiWord{:href => "/nlab/show/under+category"} under category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} t/C
              over
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi t
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi lim
                            %mi p
                            %mi F
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; t
                    \\\
                    \&amp; \swarrow &amp;\downarrow &amp; \searrow
                    \\\
                    \&amp;&amp; \lim p F
                    \\\
                    \\downarrow &amp; \swarrow &amp;&amp; \searrow &amp; \downarrow
                    \\\
                    p F(d) &amp;&amp;\stackrel{p F(\gamma)}{\to}&amp;&amp; p F(d')
                    }
            %p
              It therefore remains to show that this is indeed a limiting cone over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} t \to Q
              be another cone over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo{:stretchy => "false"} /
                      %mi C
                    %annotation{:encoding => "application/x-tex"} t/C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              is another cone over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} p F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and we get in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a universal morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo →
                    %mi lim
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Q \to \lim p F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi t
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Q
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi lim
                            %mi p
                            %mi F
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi p
                                %mi F
                                %mo{:stretchy => "false"} (
                                %mi γ
                                %mo{:stretchy => "false"} )
                          %mtd
                          %mtd
                            %mi p
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ′
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; t
                    \\\
                    \&amp; \swarrow &amp; \downarrow &amp; \searrow
                    \\\
                    \&amp;&amp; Q
                    \\\
                    \\downarrow &amp; \swarrow &amp;\downarrow &amp; \searrow &amp; \downarrow
                    \\\
                    \&amp;&amp; \lim p F
                    \\\
                    \\downarrow &amp; \swarrow &amp;&amp; \searrow &amp; \downarrow
                    \\\
                    p F(d) &amp;&amp;\stackrel{p F(\gamma)}{\to}&amp;&amp; p F(d')
                    }
            %p
              A glance at the diagram above shows that the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo →
                    %mi Q
                    %mo →
                    %mi lim
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} t \to Q \to \lim p F
              constitutes a morphism of cones in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              into the limiting cone over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mi F
                    %annotation{:encoding => "application/x-tex"} p F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo →
                      %mi lim
                      %mi p
                      %mi F
                    %annotation{:encoding => "application/x-tex"} t \to \lim p F
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mi p
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \lim p F
            %p
              This shows that the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo →
                    %mi lim
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Q \to \lim p F
              which was the unique one giving a cone morphism on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              does lift to a cone morphism in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo{:stretchy => "false"} /
                      %mi C
                    %annotation{:encoding => "application/x-tex"} t/C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo →
                    %mi lim
                    %mi p
                    %mi F
                  %annotation{:encoding => "application/x-tex"} t \to \lim p F
              and thus identifies it with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \lim F
          %ul
            %li
              Remark: One often says “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              reflects limits” to express the conclusion of this proposition. A conceptual way to consider this result is by appeal to a more general one: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U: A \to C
              is
              %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
              (i.e., has a left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              such that the canonical
              %a.existingWikiWord{:href => "/nlab/show/comparison+functor"} comparison functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mtext -
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} A \to (U F)\text{-}Alg
              is an
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              both reflects and preserves limits. In the present case, the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi A
                    %mo =
                    %mi t
                    %mo{:stretchy => "false"} /
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p: A = t/C \to C
              is monadic, is essentially the category of algebras for the monad
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                      %mo +
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T(-) = t + (-)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              admits binary coproducts. (Added later: the proof is even simpler: if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %mi A
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U: A \to C
              is the underlying functor for the category of algebras of an
              %em endofunctor
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              (as opposed to algebras of a monad), then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              reflects and preserves limits; then apply this to the endofunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              above.)
