                      %mi 𝒢
                      %mn 0
                    %mo ,
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (t : N \to \mathcal{G}_0,\mathcal{G})
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/module+over+a+groupoid"} module over a groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
