          %h6#AdjointModule 7.4.i Adjoint module and augmentation module
          .un_def
            %h6#definition_5 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/module+over+a+groupoid"} module over a groupoid
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo ,
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (N,\mathcal{G})
              %strong semidirect product groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mo ⋉
                    %mi N
