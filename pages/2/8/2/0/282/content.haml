                    %msub
                      %mi 𝒞
                      %mi n
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mo :
                    %mo =
                    %msub
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{C}_n X)_x := H_n(\hat X_n(x),\hat X_{n-1}(x) )
                    \\,.
            %p
              The action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi X
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(X,X_0)
              on this is the evident one induced by composition of paths.
            %p
              This extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mo •
                    %mo :
                    %mi FTop
                    %mo →
                    %mi Chn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_\bullet : FTop \to Chn
                    \\,.
          %p
            This is
            %em def 8.4.1
          %p The next proposition asserts that this notion of chain complex of a filtered topological space is reproduced by the combination of
          %ul
            %li
              %p
                the
                %a{:href => "#FundamentalCrossedComplex"} fundamental crossed complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \Pi X_\bullet
            %li
              %p
                and the
                %a{:href => "#ChainOfCrossed"} chain complex of a crossed complex
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∇
                        %mi Π
                        %msub
                          %mi X
                          %mo •
                      %annotation{:encoding => "application/x-tex"} \nabla \Pi X_\bullet
          .un_prop
            %h6#proposition_2 Proposition
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/filtered+space"} filtered space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              is
              %a.existingWikiWord{:href => "/nlab/show/connected+space"} connected
              then there is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mo •
                    %mi X
                    %mo ≃
                    %mo ∇
                    %mi Π
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_\bullet X \simeq \nabla \Pi X
                    \\,.
          %p
            This is
            %em proposition 8.4.2
            \. Use the
            %a.existingWikiWord{:href => "/nlab/show/Hurewicz+theorem"} relative Hurewicz theorem
            to translate from
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/homology+group"} homology group
          %h6#example_chains_on_the_simplex
            Example: Chains on the
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .un_example
            %h6#example_3 Example
            %p
              %strong
                (chains on the
                = succeed "-simplex)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %p
              Consider
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msup
                        %mi Δ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} X = \Delta^n
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
              regarded as a
              %a.existingWikiWord{:href => "/nlab/show/filtered+space"} filtered space
              with the union of its
              = succeed "-faces" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              Notice that since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Delta^n
              is a
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+space"} simply connected space
              in this case we have that for each basepoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x \in (\Delta^n)_0
              the universal cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mi x
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \hat X_{x} = X
              coincices with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p We have that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mo •
                    %msup
                      %mi Δ
                      %mi n
                    %mo ≃
                    %mo ∇
                    %mi Π
                    %msup
                      %mi Δ
                      %mi n
                    %mo ≃
                    %msub
                      %mi N
                      %mo •
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_\bullet \Delta^n \simeq \nabla \Pi \Delta^n
                    \\simeq
                    N_\bullet \Delta[n]
            %p
              is, over each vertex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi n
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} x \in (\Delta^n)_0
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} normalized chain complex
              of
              %a.existingWikiWord{:href => "/nlab/show/cochain+on+a+simplicial+set"} chains on the simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[n]
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mn 0
                    %msup
                      %mi Δ
                      %mi n
                    %mo =
                    %msup
                      %mi ℤ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mn 0
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mo =
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_0 \Delta^n = \mathbb{Z}^{n+1}
                    \\;\;\;\;\;
                    (\mathcal{C}_0 \Delta^n)_x = \mathbb{Z}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mn 1
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mo =
                    %msup
                      %mi ℤ
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{C}_1 \Delta^n)_{x} = \mathbb{Z}^n
            %p etc.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mi n
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi x
                    %mo =
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{C}_n \Delta^n)_x = \mathbb{Z}
                    \\,.
            %p
              We have moreover that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(\Delta^n, (\Delta^n)_0)
              is the
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+groupoid"} codiscrete groupoid
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              objects. It acts on the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_k(\Delta^n)
              by identity maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi i
                    %mo →
                    %msub
                      %mi x
                      %mi j
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mi k
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi x
                          %mi i
                    %mover
                      %mo →
                      %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mi k
                    %msup
                      %mi Δ
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi x
                          %mi j
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (x_i \to x_j) : (\mathcal{C}_{k} \Delta^n)_{x_i}
                    \\stackrel{=}{\to}
                    (\mathcal{C}_{k} \Delta^n)_{x_j}
                    \\,.
            %p
              It follows in particular that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mo •
                  %annotation{:encoding => "application/x-tex"} D_\bullet
              an ordinary
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
              %a.existingWikiWord{:href => "/nlab/show/modules+over+a+groupoid"} modules over a groupoid
              in the trivial way, morphisms of modules over groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mo •
                    %msup
                      %mi Δ
                      %mi n
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_\bullet \Delta^n \to D
            %p are canonically identified with morphisms of ordinary chain complexes of abelian groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mo •
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi D
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_\bullet \Delta[n] \to D
                    \\,.
            %p
              For more on this see
              = succeed "." do
                %a{:href => "#DoldKanMap"} Dold-Kan map and omega-nerve
          %h4#9_tensor_products_and_homotopies_of_crossed_complexes 9 Tensor products and homotopies of crossed complexes
          %h5#HomotopyAdditionSimplex 9.9 The homotopy addition lemma for a simplex
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Delta^n
            the topological
            = succeed "-simplex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/filtered+space"} filtered space
            in the canonical way, the fundamental crossed complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %msup
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Pi X^n
            is a groupoid-version of the
