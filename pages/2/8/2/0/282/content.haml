            %h6#definition_9 Definition
            %p
              %strong (homology chain complex of a filtered space)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
