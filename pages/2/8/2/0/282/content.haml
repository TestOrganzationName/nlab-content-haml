            %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoid"} strict ∞-groupoid
            on a single
            = succeed "-simplex." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %h5#SimpSetAndCrs 9.10 Simplicial sets and crossed complexes
          %p
            By the discussion at
            %a{:href => "#HomotopyAdditionSimplex"} The homotopy addition lemma for a simplex
            the
            %a{:href => "#FundamentalCrossedComplex"} fundamental crossed complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %msup
                    %mi Δ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Pi \Delta^n
            plays the role of the free strict
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %msup
                    %mi Δ
                    %mo •
                  %mo :
                  %mi Δ
                  %mo →
                  %mi Crs
                  %mo ≃
                  %mi Str
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  \\Pi \Delta^\bullet :
                  \\Delta \to Crs \simeq Str \infty Grpd
          %p
            induced by the discussion at
            %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
            a simplicial
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            operation on
            %a.existingWikiWord{:href => "/nlab/show/strict+%E2%88%9E-groupoid"} strict ∞-groupoid
            – an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-nerve"} ∞-nerve
          .un_def
            %h6#definition_10 Definition
            %p
              %strong (simplicial nerve)
            %p
              Let
