                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/noncommutative+motives"} noncommutative motives
                    %math#mathml_55f3094059c9fbdb4ade37c5d893a16a5acbd98f_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
