                  %td{:style => "text-align: left;"} …
          %h2#references References
          %h3#introductions Introductions
          %p Surveys with accounts of the historical development include
          %ul
            %li#Arlettaz04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dominique+Arlettaz"}> Dominique Arlettaz
                ,
                %em Algebraic K-theory of rings from a topological viewpoint
                (
                %a{:href => "http://www.math.uiuc.edu/K-theory/0420/Arlettaz-survey.pdf"}> pdf
                )
            %li#Grayson13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Grayson"}> Daniel Grayson
                ,
                = succeed "," do
                  %em Quillen’s work in algebraic K-theory
                %a{:href => "http://www.math.uiuc.edu/~dan/Papers/qs-published-final.pdf"} pdf
          %p An introductory textbook account is in
          %ul
            %li#Weibel
              %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"}> Charles Weibel
              ,
              %em The K-Book: An introduction to algebraic K-theory
              (
              %a{:href => "http://www.math.rutgers.edu/~weibel/Kbook.html"}> web
              )
          %p Further review includes
          %ul
            %li#Isely05
              %p
                Olivier Isely,
                = succeed "," do
                  %em
                    Algebraic
                    = succeed "-theory" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi K
                          %annotation{:encoding => "application/x-tex"} K
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/IselyKTheory.pdf", :title => "pdf"} pdf
            %li#Gerhardt14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Teena+Gerhardt"}> Teena Gerhardt
                ,
                = succeed "," do
                  %em Computations in algebraic K-theory
                %a{:href => "http://qcpages.qc.cuny.edu/~swilson/cunyworkshop14.html"} CUNY Workshop on differential cohomologies 2014
                (
                %a{:href => "http://videostreaming.gc.cuny.edu/videos/video/1800/in/channel/55/"}> video recording
                )
          %p
            Review of the relation to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Dennis+trace"} Dennis trace
            %a.existingWikiWord{:href => "/nlab/show/topological+cyclic+homology"} topological cyclic homology
            and
            %a.existingWikiWord{:href => "/nlab/show/topological+Hochschild+homology"} topological Hochschild homology
            is in
          %ul
            %li#DundasGoodwillieMcCarthy13
              %a.existingWikiWord{:href => "/nlab/show/Bj%C3%B8rn+Dundas"}> Bjørn Dundas
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Goodwillie"} Thomas Goodwillie
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Randy+McCarthy"} Randy McCarthy
              = succeed "," do
                %em The local structure of algebraic K-theory
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/978-1-4471-4393-2"} doi:10.1007/978-1-4471-4393-2
          %h3#classical Classical
          %p Original articles:
          %ul
            %li#Quillen73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> Daniel Quillen
                \:
                = succeed "," do
                  %em Higher algebraic K-theory I
                %em Higher K-theories
                Proc. Seattle 1972 Lec., Notes Math.
                = succeed "," do
                  %strong 341
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/BFb0067053"} doi:10.1007/BFb0067053
                = succeed "&rbrack;" do
                  %a{:href => "https://people.math.rochester.edu/faculty/doug/otherpapers/Quillen-Higher-I.pdf"} pdf
              %p
                also:
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Grayson"} Daniel Grayson
                %em Higher algebraic K-theory II, [after Daniel Quillen]
                \&amp;lbrack;
                %a{:href => "http://www.math.illinois.edu/~dan/Papers/HigherAlgKThyII.pdf"}> pdf
                \&amp;rbrack;
            %li#BrownGersten73
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kenneth+Brown"}> Kenneth Brown
                , Stephen M. Gersten,
                = succeed "," do
                  %em Algebraic K-theory as generalized sheaf cohomology
            %li#Waldhausen85
              %p
                %a.existingWikiWord{:href => "/nlab/show/F.+Waldhausen"}> F. Waldhausen
                ,
                = succeed "," do
                  %em Algebraic K-theory of spaces
                = succeed "." do
                  %a{:href => "http://www.maths.ed.ac.uk/~aar/surgery/rutgers/wald.pdf"} pdf
            %li#Thomason85
              %p
                %a.existingWikiWord{:href => "/nlab/show/R.+W.+Thomason"}> R. W. Thomason
                ,
                = succeed "," do
                  %em Algebraic K-theory and étale cohomology
            %li#Nisnevich89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yevsey+Nisnevich"}> Yevsey Nisnevich
                ,
                = succeed "," do
                  %em The completely decomposed topology on schemes and associated descent spectral sequences in algebraic K-theory
            %li#ThomasonTrobaugh90
              %p
                %a.existingWikiWord{:href => "/nlab/show/R.+W.+Thomason"}> R. W. Thomason
                , Thomas Trobaugh,
                = succeed "," do
                  %em Higher algebraic K-theory of schemes and of derived categories
                = succeed "," do
                  %em The Grothendieck Festschrift
            %li#Rosenschon06
              %p
                Andreas Rosenschon, P.A. Ostvær,
                = succeed "," do
                  %em Descent for K-theories
          %p
            For
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+varieties"} complex varieties
          %ul
            %li#PedriniWeibel01
              %p
                Claudio Pedrini,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Charles+Weibel"} Charles Weibel
                = succeed "," do
                  %em The higher K-theory of complex varieties
                = succeed ")" do
                  %a{:href => "http://www.math.uiuc.edu/K-theory/0403/"} web
            %li
              %p
                Michael Paluch,
                %em Algebraic K-theory and topological spaces
                (
                %a{:href => "http://www.math.uiuc.edu/K-theory/0471/alg-top.pdf"}> pdf
                )
          %p For discussion of stable phenomena in algebraic K-theory, see section 4 of
          %ul
            %li#Cohen
              %a.existingWikiWord{:href => "/nlab/show/Ralph+Cohen"}> Ralph Cohen
              ,
              %em Stability phenomena in the topology of moduli spaces
              (
              %a{:href => "http://arxiv.org/PS_cache/arxiv/pdf/0908/0908.1938v2.pdf"}> pdf
              )
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/comparison+map+between+algebraic+and+topological+K-theory"} comparison map between algebraic and topological K-theory
            includes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"}> Jonathan Rosenberg
              ,
              %em
                Comparison between algebraic and topological K-theory for Banach algebras and
                = succeed "-algebras" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mo *
                      %annotation{:encoding => "application/x-tex"} C^\ast
              (
              %a{:href => "http://www2.math.umd.edu/~jmr/algtopK.pdf"}> pdf
              )
          %p
            For
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
          %ul
            %li#BunkeNikolausVoelkl13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+V%C3%B6lkl"} Michael Völkl
                = succeed "," do
                  %em Differential cohomology theories as sheaves of spectra
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/1311.3188"} arXiv:1311.3188
            %li#Bunke14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                %em A regulator for smooth manifolds and an index theorem
                (
                %a{:href => "http://arxiv.org/abs/1407.1379"}> arXiv:1407.1379
                )
          %h3#ReferencesAlgebraicKTheoryForQuotientStacks Algebraic K-theory of quotient stacks
          %p
            Discussion of algebraic K-theory for
            %a.existingWikiWord{:href => "/nlab/show/algebraic+stacks"} algebraic stacks
            (generalizing algebraic
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Thomason"}> Robert Thomason
                ,
                = succeed "," do
                  %em Algebraic K-theory of group scheme actions
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Amalendu+Krishna"}> Amalendu Krishna
                , Charanya Ravi,
                %em On the K-theory of schemes with group scheme actions
                (
                %a{:href => "http://arxiv.org/abs/1509.05147"}> arXiv:1509.05147
                )
          %p
            See also at
            = succeed "." do
              %em
                %a{:href => "universal+Chern-Simons+line+3-bundle#ForReductiveAlgebraicGroups"} universal Chern-Simons 3-bundle – For reductive groups
          %h3#algebraic_ktheory_of_ring_spectra Algebraic K-theory of ring spectra
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory"} algebraic K-theory
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/ring+spectra"} ring spectra
          %ul
            %li#EKMM97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anthony+Elmendorf"}> Anthony Elmendorf
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"} Igor Kriz
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Mandell"} Michael Mandell
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Rings%2C+modules+and+algebras+in+stable+homotopy+theory"} Rings, modules and algebras in stable homotopy theory
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/BOOKS/EKMM.pdf"} pdf
            %li#BlumbergGepnerTabuada10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"}> Andrew Blumberg
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Gon%C3%A7alo+Tabuada"} Gonçalo Tabuada
                = succeed "," do
                  %em A universal characterization of higher algebraic K-theory
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1001.2282"} arXiv:1001.2282
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.2140/gt.2013.17.733"} doi:10.2140/gt.2013.17.733
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                ,
                = succeed "," do
                  %em Algebraic K-Theory of Ring Spectra
                = succeed "," do
                  %em
                    %a{:href => "https://www.math.ias.edu/~lurie/281.html"} Algebraic K-Theory and Manifold Topology
                = succeed ")" do
                  %a{:href => "http://people.math.harvard.edu/~lurie/281notes/Lecture19-Rings.pdf"} pdf
          %p
            The algebraic K-theory specifically of
            %a.existingWikiWord{:href => "/nlab/show/suspension+spectra"} suspension spectra
            of
            %a.existingWikiWord{:href => "/nlab/show/loop+spaces"} loop spaces
            (Waldhausen’s
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/A-theory"} A-theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Friedhelm+Waldhausen"}> Friedhelm Waldhausen
              ,
              = succeed "," do
                %em Algebraic K-theory of spaces
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BFb0074449"} doi:10.1007/BFb0074449
          %p See also:
          %p
            (
            %a{:href => "#ThomasonTrobaugh90"}> Thomason-Trobaugh 90
            )
          %h3#via_stable_categories
            Via stable
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category"} stable (∞,1)-category
            theory picture is discussed in
          %ul
            %li#BlumbergGepnerTabuada10
              %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"}> Andrew Blumberg
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gon%C3%A7alo+Tabuada"} Gonçalo Tabuada
              = succeed "," do
                %em A universal characterization of higher algebraic K-theory
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/1001.2282"} arXiv:1001.2282
              = succeed ")" do
                %a{:href => "http://dx.doi.org/10.2140/gt.2013.17.733"} doi:10.2140/gt.2013.17.733
          %p
            (in terms of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+motives"} noncommutative motives
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Clark+Barwick"}> Clark Barwick
              ,
              %em On the algebraic K-theory of higher categories, I. The universal property of Waldhausen K-theory
              (
              %a{:href => "http://de.arxiv.org/abs/1204.3607"}> arXiv:1204.3607
              )
          %h3#via_symmetric_monoidal_categories
            Via symmetric monoidal
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            The perspective of
            %a.existingWikiWord{:href => "/nlab/show/algebraic+K-theory+of+a+symmetric+monoidal+%28%E2%88%9E%2C1%29-category"} algebraic K-theory of a symmetric monoidal (∞,1)-category
            is developed in
          %ul
            %li#BunkeTamme12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Georg+Tamme"} Georg Tamme
                %em Regulators and cycle maps in higher-dimensional differential algebraic K-theory
                (
                %a{:href => "http://arxiv.org/abs/1209.6451"}> arXiv:1209.6451
                )
            %li#Nikolaus13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
                %em
                  Algebraic K-Theory of
                  = succeed "-Operads" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                (
                %a{:href => "http://arxiv.org/abs/1303.2198"}> arXiv:1303.2198
                )
            %li#BunkeTamme13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Georg+Tamme"} Georg Tamme
                %em Multiplicative differential algebraic K-theory and applications
                (
                %a{:href => "http://arxiv.org/abs/1311.1421"}> arXiv:1311.1421
                )
            %li#BunkeNikolausVoelkl13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+V%C3%B6lkl"} Michael Völkl
                %em Differential cohomology theories as sheaves of spectra
                (
                %a{:href => "http://arxiv.org/abs/1311.3188"}> arXiv:1311.3188
                )
            %li#GepnerGrothNikolaus13
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Gepner"}> David Gepner
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Moritz+Groth"} Moritz Groth
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
                = succeed "," do
                  %em Universality of multiplicative infinite loop space machines
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/1305.4550"} arXiv:1305.4550
          %h3#ktheory_stacks K-theory stacks
          %p
            The system of
            %a.existingWikiWord{:href => "/nlab/show/infinite+loop+spaces"} infinite loop spaces
            of the algebraic K-theory spectrum regarded as an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            on the
            %a.existingWikiWord{:href => "/nlab/show/Nisnevich+site"} Nisnevich site
            and the
            %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
            over it is considered in
          %ul
            %li#Saito14
              %a.existingWikiWord{:href => "/nlab/show/Sho+Saito"}> Sho Saito
              ,
              %em Higher Tate central extensions via K-theory and infinity-topos theory
              (
              %a{:href => "http://arxiv.org/abs/1405.0923"}> arXiv:1405.0923
              )
          %p implementing a suggestion stated in
          %ul
            %li#Drinfeld03
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Drinfeld"}> Vladimir Drinfeld
              ,
              %em Infinite-dimensional vector bundles in algebraic geometry (an introduction)
              (
              %a{:href => "http://arxiv.org/abs/math/0309155"}> arXiv:math/0309155
              )
          %h3#equivariant_versions Equivariant versions
          %p
            Refinement to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/global+equivariant+stable+homotopy+theory"} global equivariant stable homotopy theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              ,
              %em Global algebraic K-theory
              (
              %a{:href => "https://arxiv.org/abs/1912.08872"}> arXiv:1912.08872
              )
          %h3#examples_3 Examples
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Benjamin+Antieau"}> Benjamin Antieau
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Achim+Krause"} Achim Krause
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
                %em
                  On the K-theory of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℤ
                        %mo{:stretchy => "false"} /
                        %msup
                          %mi p
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}/p^n
                (2024). (
                %a{:href => "https://arxiv.org/abs/2405.04329"}> arXiv:2405.04329
                ).
            %li#Ananyevskiy
              %p
                Alexey Ananyevskiy,
                %em
                  On the algebraic
                  = succeed "-theory" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
                (
                %a{:href => "http://www.math.uni-bielefeld.de/lag/man/431.pdf"}> pdf
                )
          %p
            On the algebraic K-theory of rings being encoded in the respective
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/derived+categories"} derived categories
          %ul
            %li#DuggerShipley04
              %a.existingWikiWord{:href => "/nlab/show/Daniel+Dugger"}> Daniel Dugger
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              = succeed "," do
                %em K-theory and derived equivalences
              %strong 124
              3 (2004) 587-617 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math/0209084"}> arXiv:math/0209084
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://projecteuclid.org/journals/duke-mathematical-journal/volume-124/issue-3/K-theory-and-derived-equivalences/10.1215/S0012-7094-04-12435-2.short"} doi:10.1215/S0012-7094-04-12435-2
