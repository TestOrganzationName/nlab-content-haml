                        %semantics
                          %mrow
                            %mi 𝒩
                            %mo =
                            %mn 4
                          %annotation{:encoding => "application/x-tex"} \mathcal{N} = 4
                      Super Yang Mills
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0202021"} arXiv:hep-th/0202021
              %li
                %p
                  N. Itzhaki,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Igor+Klebanov"} Igor Klebanov
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Sunil+Mukhi"} Sunil Mukhi
                  = succeed "," do
                    %em PP Wave Limit and Enhanced Supersymmetry in Gauge Theories
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0202153"} arXiv:hep-th/0202153
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Nakwoo+Kim"}> Nakwoo Kim
                  , Ari Pankiewicz, Soo-Jong Rey,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Stefan+Theisen"} Stefan Theisen
                  = succeed "," do
                    %em Superstring on PP-Wave Orbifold from Large-N Quiver Gauge Theory
                  = succeed ")" do
