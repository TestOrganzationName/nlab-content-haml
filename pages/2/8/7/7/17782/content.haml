                %strong 85
                126005 (2012) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1202.5501"}> arXiv:1202.5501
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1103/PhysRevD.85.126005"} doi:10.1103/PhysRevD.85.126005
          %div
            %h3#ppwaves_as_penrose_limits_of__spacetimes
              pp-Waves as Penrose limits of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
