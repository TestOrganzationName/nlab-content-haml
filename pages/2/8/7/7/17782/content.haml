                  \\tfrac{1}{2}
                  (\mu/6)^2 x^j (\Gamma_{+ j} \theta)^\alpha \, e^-
                  \\,-\,
                  \\big(
                  \\tfrac{1}{6}
                  \\tfrac{1}{3!}
                  (G_4)_{a\, b_1 b_2 b_3}
                  \\Gamma^{b_1 b_2 b_3}
                  \-
                  \\tfrac{1}{12}
                  \\tfrac{1}{4!}
                  (G_4)^{b_1 \cdots b_4}
                  \\Gamma_{a\, b_1 \cdots b_4}
                  \\big)
                  \\theta\, e^a
                  \\,,
                  \\end{array}
          %p
            where in the second line we inserted
            %a.maruku-eqref{:href => "#eq:SpinConnectionForMaximallySuSyWaveIn11d"} (3)
            and
            %a.maruku-eqref{:href => "#eq:CFieldFLuxDensityForMaximalSuSyWaveIn11d"} (2)
            via
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:RecallingSupeGravitinoFieldInMaximalSuSyWaveIn11d"} (7)
            = succeed "," do
              %a{:href => "#DSV02"} DSV 2002 (2.10)
            = succeed "&rbrack;" do
              %a{:href => "#Bandos12"} Bandos 2012 (3.14)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi ψ
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %mi D
                        %mi θ
                        %mo +
                        %mi ⋯
                        %mspace{:width => "thinmathspace"}
                        %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{l}
                  \\psi
                  \\;\coloneqq\;
                  D \theta
                  + \cdots
                  \\,.
                  \\end{array}
          %p (…)
          %h3#the_mwave_in_11d The M-wave in 11d
          %p
            A half BPS pp-wave solution of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/M-wave"} M-wave
          %p
            %br/
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/flat+space+holography"} flat space holography
          %h2#references References
          %h3#general General
          %p
            Introducing what came to be known as the
            %em Penrose limit
            for producing pp-wave spacetimes:
          %ul
            %li#Penrose76
              %a.existingWikiWord{:href => "/nlab/show/Roger+Penrose"}> Roger Penrose
              ,
              = succeed "," do
                %em Any Space-Time has a Plane Wave as a Limit
              = succeed "," do
                %em Differential Geometry and Relativity
              = succeed "," do
                %strong 3
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/978-94-010-1508-0_23"} doi:10.1007/978-94-010-1508-0_23
              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/content/pdf/10.1007/978-94-010-1508-0_23.pdf"} pdf
          %p Lecture notes
          %ul
            %li#Blau11
              %a.existingWikiWord{:href => "/nlab/show/Matthias+Blau"}> Matthias Blau
              ,
              %em Plane waves and Penrose limits
              (2011) &amp;lbrack;
              %a{:href => "http://www.blau.itp.unibe.ch/lecturesPP.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/BlauPlaneWavesAndPenroseLimit.pdf", :title => "pdf"} pdf
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Pp-wave_spacetime"} pp-wave spacetime
          %p Detailed mathematical discussion:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Figueroa-O%27Farrill"}> José Figueroa-O'Farrill
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Patrick+Meessen"} Patrick Meessen
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Simon+Philip"} Simon Philip
                = succeed "," do
                  %em Homogeneity and plane-wave limits
                %strong 2005
                JHEP05 (2005) &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/0504069"}> arXiv:hep-th/0504069
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1088/1126-6708/2005/05/050"} doi:10.1088/1126-6708/2005/05/050
            %li#Philip05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Philip"}> Simon Philip
                ,
                = succeed "," do
                  %em Plane-wave limits and homogeneous M-theory backgrounds
                = succeed "," do
                  %a{:href => "https://www.era.lib.ed.ac.uk/bitstream/handle/1842/15645/Philip2005.Pdf?sequence=1"} pdf
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/PhilipPlaneWave05.pdf", :title => "pdf"} pdf
            %li#Philip06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Simon+Philip"}> Simon Philip
                ,
                = succeed "," do
                  %em Penrose limits of homogeneous spaces
                %strong 56
                9 (2006) 1516-1533 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/j.geomphys.2005.08.002"}> doi:10.1016/j.geomphys.2005.08.002
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/math/0405506"} arXiv:math/0405506
          %p
            %br/
          %h3#ReferencesExamples Examples
          %p
            The maximally supersymmetric pp-wave solution of
            %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            is due to:
          %ul
            %li#Kowalski-Glikman84
              %p
                Jerzy Kowalski-Glikman,
                = succeed "," do
                  %em Vacuum states in supersymmetric Kaluza-Klein theory
                %strong 134
                3–4 (1984) 194-196 &amp;lbrack;
                %a{:href => "https://doi.org/10.1016/0370-2693(84)90669-5"}> doi:10.1016/0370-2693(84)90669-5
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://inspirehep.net/literature/202143"} InSpire:202143
            %li#FigueroaPapadopoulos01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+Figueroa-O%E2%80%99Farrill"}> José Figueroa-O’Farrill
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/George+Papadopoulos"} George Papadopoulos
                = succeed "," do
                  %em Homogeneous fluxes, branes and a maximally supersymmetric solution of M-theory
                = succeed "," do
