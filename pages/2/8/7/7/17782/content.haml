            %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            is given as follows &amp;lbrack;
            %a{:href => "#Kowalski-Glikman84"}> Kowalski-Glikman 1984 (9)
            ,
            = succeed "&rbrack;:" do
