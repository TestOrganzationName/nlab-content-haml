                %a{:href => "https://arxiv.org/abs/hep-th/0202021"} arXiv:hep-th/0202021
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1088/1126-6708/2002/04/013"} doi:10.1088/1126-6708/2002/04/013
          %p Review:
          %ul
            %li
              %p
