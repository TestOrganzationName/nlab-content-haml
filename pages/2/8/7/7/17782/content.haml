              %li
                %p
                  E. Floratos,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Alex+Kehagias"} Alex Kehagias
                  = succeed "," do
                    %em Penrose Limits of Orbifolds and Orientifolds
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs/hep-th/0203134"} arXiv:hep-th/0203134
              %li
                %p
                  E. M. Sahraoui, E. H. Saidi,
                  = succeed "," do
                    %em Metric Building of pp Wave Orbifold Geometries
                  = succeed ")" do
                    %a{:href => "https://arxiv.org/abs//hep-th/0210168"} arXiv:hep-th/0210168
            %p Review:
