                %a{:href => "https://arxiv.org/abs/hep-th/0307101"}> arXiv:hep-th/0307101
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1002/prop.200310121"} doi:10.1002/prop.200310121
          %p Further references as of 2010 are listed at:
          %ul
            %li
              %a{:href => "https://www.stringwiki.org/wiki/String_Theory_Wiki"}> String Theory Wiki
              ,
              %em
                %a{:href => "https://www.stringwiki.org/wiki/The_BMN_limit"} The BMN limit
              (2010)
          %p
