          %h2#references References
          %ul
            %li#Pohlova
              %p
                Věra Pohlová. “On sums in generalized algebraic categories.” Czechoslovak Mathematical Journal
                = succeed ".2" do
                  %strong 23
                = succeed "&rbrack;" do
                  %a{:href => "http://eudml.org/doc/12718"} eudml:12718
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Ad%C3%A1mek"}> Jiří Adámek
                ,
                = succeed "," do
                  %em Free algebras and automata realizations in the language of categories
                = succeed ".4" do
                  %strong 15
                = succeed "&rbrack;" do
                  %a{:href => "https://eudml.org/doc/16649"} eudml:16649
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ji%C5%99%C3%AD+Ad%C3%A1mek"}> Jiří Adámek
                , Věra Trnková,
                %em Automata and algebras in categories
                %strong 37
                Springer (1990) &amp;lbrack;
                %a{:href => "https://link.springer.com/book/9780792300106"}> ISBN:9780792300106
                \&amp;rbrack;
