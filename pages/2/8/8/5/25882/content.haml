          %title Quantum cohomology as Pontrjagin rings
          %h3#ReferencesOnQuantumCohomologyAsPontrjaginRings Quantum cohomology as Pontrjagin rings
          %p
            On the relation between
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+cohomology+rings"} quantum cohomology rings
            %a.existingWikiWord{:href => "/nlab/show/Gromov-Witten+invariants"} Gromov-Witten invariants
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+string+theory"} topological string theory
            %a.existingWikiWord{:href => "/nlab/show/flag+manifold"} flag manifold
            %a.existingWikiWord{:href => "/nlab/show/target+spaces"} target spaces
            (such as the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/CP%5E1+sigma-model"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℂ
                      %msup
                        %mi P
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1
                \-sigma model
            %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+rings"} Pontrjagin rings
            (
            %a.existingWikiWord{:href => "/nlab/show/homology"}> homology
            \-
            %a.existingWikiWord{:href => "/nlab/show/Hopf+algebras"} Hopf algebras
            of
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/based+loop+spaces"} based loop spaces
          %p
            That the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+ring"} Pontryagin ring
            %a.existingWikiWord{:href => "/nlab/show/structure"} structure
            on the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            of the
            %a.existingWikiWord{:href => "/nlab/show/based+loop+space"} based loop space
            of a
            %a.existingWikiWord{:href => "/nlab/show/simply-connected+topological+space"} simply-connected
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is essentially the
            %a.existingWikiWord{:href => "/nlab/show/quantum+cohomology+ring"} quantum cohomology ring
            of the
            %a.existingWikiWord{:href => "/nlab/show/flag+variety"} flag variety
            of its
            %a.existingWikiWord{:href => "/nlab/show/complexification"} complexification
            by its
            %a.existingWikiWord{:href => "/nlab/show/Borel+subgroup"} Borel subgroup
            is attributed (“Peterson isomorphism”) to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dale+H.+Peterson"} Dale H. Peterson
              (notes by
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/Arun+Ram"} Arun Ram
              = succeed "," do
                %em
                  Quantum Cohomology of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi H
                      %annotation{:encoding => "application/x-tex"} G/H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "http://math.soimeme.org/~arunram/Resources/QuantumCohomologyOfGPL1-5.html"} web
              = succeed "," do
                %a{:href => "http://math.soimeme.org/~arunram/Resources/PetersonGmodBcourse1997.pdf"} pdf
              %a.existingWikiWord{:href => "/nlab/files/Peterson-QuantumCohomology.pdf", :title => "pdf"} pdf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p see also
          %ul
            %li
              Yasha Savelyev,
              = succeed "," do
                %em Quantum characteristic classes and the Hofer metric
              %strong 12
              (2008) 2277-2326
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/0709.4510"} arXiv:0709.4510
              %a{:href => "https://doi.org/10.2140/gt.2008.12.2277"} doi:10.2140/gt.2008.12.2277
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p and proven in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Lam"}> Thomas Lam
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mark+Shimozono"} Mark Shimozono
                = succeed "," do
                  %em
                    Quantum cohomology of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi P
                        %annotation{:encoding => "application/x-tex"} G/P
                    and homology of affine Grassmannian
                %strong 204
                (2010) 49–90
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/0705.1386"} arXiv:0705.1386
                %a{:href => "https://doi.org/10.1007/s11511-010-0045-8"} doi:10.1007/s11511-010-0045-8
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chi+Hong+Chow"}> Chi Hong Chow
                ,
                %em Peterson-Lam-Shimozono’s theorem is an affine analogue of quantum Chevalley formula
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://arxiv.org/abs/2110.09985"} arXiv:2110.09985
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
            %li#Chow22
              %p
                %a.existingWikiWord{:href => "/nlab/show/Chi+Hong+Chow"}> Chi Hong Chow
                ,
                %em
                  On D. Peterson’s presentation of quantum cohomology of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi P
                      %annotation{:encoding => "application/x-tex"} G/P
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                    %annotation{:encoding => "application/x-tex"} [
                %a{:href => "https://arxiv.org/abs/2210.17382"} arXiv:2210.17382
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} ]
          %p reviewed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jimmy+Chow"}> Jimmy Chow
              ,
              = succeed "," do
                %em Homology of based loop groups and quantum cohomology of flag varieties
              %em Western Hemisphere Virtual Symplectic Seminar
              (2021)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "https://freemath.xyz/chowslides.pdf"} pdf
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/files/Chow-QuantumCohomologyOfFlagVarieties.pdf", :title => "pdf"} pdf
              %a{:href => "https://www.youtube.com/watch?v=ovbQBj7t3eU"} YT
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %p with further discussion in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Naichung+Conan+Leung"}> Naichung Conan Leung
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Changzheng+Li"} Changzheng Li
              = succeed "," do
                %em
                  Gromov-Witten invariants for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi B
                      %annotation{:encoding => "application/x-tex"} G/B
