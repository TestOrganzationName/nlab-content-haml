          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
