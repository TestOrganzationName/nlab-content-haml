                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mn 2
                            %mo ⊗
                            %msub
                              %mi V
                              %mn 3
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi τ
                                  %mrow
                                    %msub
                                      %mi V
                                      %mn 1
                                    %mo ,
                                    %msub
                                      %mi V
                                      %mn 2
                                    %mo ⊗
                                    %msub
                                      %mi V
                                      %mn 3
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mn 2
                            %mo ⊗
                            %msub
                              %mi V
                              %mn 3
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %msub
                              %mi V
                              %mn 1
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %msup
                              %mrow
                              %mrow
                                %msub
                                  %mi τ
                                  %mrow
                                    %msub
                                      %mi V
