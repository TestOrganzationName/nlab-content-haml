          %p
            The formula for the “cohomologically- and super-graded commutativity” in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega^\bullet(\mathbb{R}^{p|q})
            is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ∧
                  %mi β
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mi n
                        %mi α
                      %msub
                        %mi n
                        %mi β
                      %mo +
                      %msub
                        %mi σ
                        %mi α
                      %msub
                        %mi σ
                        %mi β
                  %mspace{:width => "thickmathspace"}
                  %mi β
                  %mo ∧
                  %mi α
                %annotation{:encoding => "application/x-tex"}
                  \\alpha \wedge \beta
                  \=
                  \\;
                  (- 1)^{n_\alpha n_\beta + \sigma_\alpha \sigma_\beta}
                  \\;
                  \\beta \wedge \alpha
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo ,
                  %mi β
                  %mo ∈
                  %msup
                    %mi Ω
                    %mo •
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
                      %mi q
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha,  \beta \in \Omega^\bullet(\mathbb{R}^{p|q})
            of homogeneous
            = succeed "-degree." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}\times \mathbb{Z}_2
            %em two
            contributions to the sign picked up when exchanging two super-differential forms in the wedge product:
          %ol
            %li
              %p
                there is a “cohomological sign” which for commuting an
                = succeed "-forms" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} n_1
                = succeed "-form" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} n_2
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi n
                              %mn 1
                            %msub
                              %mi n
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} (-1)^{n_1 n_2}
            %li
              %p
                in addition there is a “super-grading” sich which for commuting a
                = succeed "-graded" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \sigma_1
                = succeed "-graded" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \sigma_2
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi σ
                              %mn 1
                            %msub
                              %mi σ
                              %mn 2
                      %annotation{:encoding => "application/x-tex"} (-1)^{\sigma_1 \sigma_2}
