                %annotation{:encoding => "application/x-tex"}
                  C^\infty(\mathbb{R}^{p|q}) = \langle \{x^a\}_{1}^p, \{ \theta^\alpha\}_{\alpha= 1}^q \rangle
                  \\,.
          %p
            Accordingly, by the discussion at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+forms"} Kähler forms
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
            of
            %a.existingWikiWord{:href => "/nlab/show/differential+forms"} differential forms
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mi p
                      %mo{:stretchy => "false"} |
