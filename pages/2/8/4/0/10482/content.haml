                              %mi V
                              %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mrow
                                      %msub
                                        %mi V
                                        %mn 1
                                      %mo ,
                                      %msub
                                        %mi V
                                        %mn 2
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %msup
                              %mrow
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mrow
                                      %msub
                                        %mi V
                                        %mn 2
                                      %mo ,
                                      %msub
                                        %mi V
                                        %mn 1
                        %mtr
                          %mtd
                            %mi id
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mn 1
                            %mo ⊗
                            %msub
                              %mi V
                              %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi id
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi τ
                                  %mi Deligne
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi if
                            %mo{:stretchy => "false"} (
                            %mi W
                            %mo ⊗
                            %mi V
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    id(V_1) \otimes id(V_2)
                    \&amp;\stackrel{\tau_{Bernst}}{\longrightarrow}&amp; id(V_2) \otimes id(V_1)
                    \\\
                    {}^{\mathllap{\mu_{V_1,V_2}}}\Big\downarrow
                    \&amp;&amp;
                    \\Big\downarrow{}^{\mathrlap{\mu_{V_2,V_1}}}
                    \\\
                    id(V_1\otimes V_2)
                    \&amp;\overset{id(\tau_{Deligne})}{\longrightarrow}&amp; if(W \otimes V)
                    }
            %p As before, this is equivalent to a condition on the signs picked up both ways, which reads:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi σ
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi n
                          %mn 2
                        %mo +
                        %msub
                          %mi σ
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                        %msub
                          %mi σ
                          %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %msub
                          %mi σ
                          %mn 2
                        %mo +
                        %msub
                          %mi n
                          %mn 1
                        %msub
                          %mi n
                          %mn 2
                        %mo +
                        %msub
                          %mi σ
                          %mn 1
                        %msub
                          %mi σ
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-1)^{ (n_1 + \sigma_1)(n_2 + \sigma_2) + n_2 \sigma_1}
                    \\;=\;
                    (-1)^{ n_1 \sigma_2 + n_1 n_2 + \sigma_1 \sigma_2 }
                    \\,.
            %p Inspection shows that this is indeed the case:
            %p
              The two signs of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Deligne
                  %annotation{:encoding => "application/x-tex"} \tau_{Deligne}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Bernst
                  %annotation{:encoding => "application/x-tex"} \tau_{Bernst}
              differ by the “mixed terms” that are produced in
              %a.existingWikiWord{:href => "/nlab/show/distributivity"} multiplying out
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mi v
                    %mo +
                    %msub
                      %mi σ
                      %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mi w
                    %mo +
                    %msub
                      %mi σ
                      %mi w
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n_v + \sigma_v)(n_w + \sigma_w)
              and these two mixed terms is just what the two occurences
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              provides (using that
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %mn 1
                      %mo =
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ∈
                      %msub
                        %mi 𝔽
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} +1 = -1 \in \mathbb{F}_2
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %h3#EquivalenceOfSuperLieAlgebraCohomology Equivalence of super Lie algebra cohomology in both conventions
          %p
            The different choice of signs in the de Rham complex
            %a{:href => "#DifferentialFormsInSuperOddConvention"} above
            affects the signs of any super-
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"}> Chevalley-Eilenberg algebra
            , by the identification of elements in the CE-algebra with
            %a.existingWikiWord{:href => "/nlab/show/left+invariant+differential+forms"} left invariant differential forms
            on the supegroup.
          %p
            We show now that as
            %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
            the two CE-algebras are
            %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphic
            and hence do have the same
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            is not affected by the different perspective on signs.
          %p
            (This follows abstract from Prop.
            = succeed "," do
              %a.maruku-ref{:href => "#EquivalenceTwoSymmetricMonoidalStructuresOnChSuperVect"}
          %p A chain-isomorphism can be obtained as follows:
          %p Write
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi CE
                        %mo •
                    %annotation{:encoding => "application/x-tex"} CE^\bullet
                for the
                %a.existingWikiWord{:href => "/nlab/show/cochain+complex"} cochain complex
                underlying the
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                with the signs given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 1
                      %mo ,
                      %msub
                        %mi σ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 2
                      %mo ,
                      %msub
                        %mi σ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %msub
                            %mi n
                            %mn 2
                          %mo +
                          %msub
                            %mi σ
                            %mn 1
                          %msub
                            %mi σ
                            %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      ((n_1, \sigma_1), (n_2, \sigma_2)) \mapsto (-1)^{n_1 n_2 + \sigma_1 \sigma_2}
            %li
              %p
                write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi CE
                        %mrow
                          %msub
                            %mi ℤ
                            %mn 2
                        %mo •
                    %annotation{:encoding => "application/x-tex"} CE^\bullet_{\mathbb{Z}_2}
                for the cochain complex obtained with the sign rule
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 1
                      %mo ,
                      %msub
                        %mi σ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 2
                      %mo ,
                      %msub
                        %mi σ
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi σ
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi n
                            %mn 2
                          %mo +
                          %msub
                            %mi σ
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      ((n_1, \sigma_1), (n_2, \sigma_2)) \mapsto (-1)^{(n_1 + \sigma_1)(n_2 + \sigma_2)}
                      \\,.
          %p
            Say that a product of generators representing an element in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi CE
                    %mi k
                %annotation{:encoding => "application/x-tex"} CE^k
            is in
            %em normal order
            of all the
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo •
                    %mo ,
                    %mi even
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\bullet,even)
            = succeed "-graded" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo •
                    %mo ,
                    %mi odd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\bullet,odd)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∧
                  %mi ⋯
                  %mi e
                  %mo ∧
                  %mi ψ
                  %mo ∧
                  %mi ⋯
                  %mi ψ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  e \wedge \cdots e \wedge \psi \wedge \cdots \psi
                  \\,.
          %p
            To define a
            %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi CE
                    %mi k
                  %mo ⟶
                  %msubsup
                    %mi CE
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %mo •
                %annotation{:encoding => "application/x-tex"} CE^k  \longrightarrow CE^\bullet_{\mathbb{Z}_2}
            declare that elements in this normal form go to the elements given by the same expression.
          %p
            This defines a linear map in each degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %em not
            a morphism of algebras, in any sense, but it
            %em is
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            which is of degree
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi even
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (1,even)
            on a term of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∧
                  %mi ⋯
                  %mi e
                  %mo ∧
                  %mi ψ
                  %mo ∧
                  %mi ⋯
                  %mi ψ
                %annotation{:encoding => "application/x-tex"} e \wedge \cdots e \wedge \psi \wedge \cdots \psi
            produces a sum of such terms where in each summand one generator is replaced by a term of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi e
                %annotation{:encoding => "application/x-tex"} d e
            or by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} d \psi
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∧
                    %mi ⋯
                    %mi e
                    %mo ∧
                    %mi ψ
                    %mo ∧
                    %mi ⋯
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} e \wedge \cdots e \wedge \psi \wedge \cdots \psi
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %mi e
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi ψ
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %mi ψ
                %annotation{:encoding => "application/x-tex"}
                  e \wedge \cdots \wedge e \wedge (d e) \wedge \psi \wedge \cdots \wedge \psi
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %mi e
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mi ψ
                  %mo ∧
                  %mi ⋯
                  %mo ∧
                  %mi ψ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  e \wedge \cdots \wedge e \wedge (d \psi)  \wedge \psi \wedge \cdots \wedge \psi
                  \\,.
          %p Now observe:
          %ol
            %li
              %p
                for terms of the first type, the signs picked up by commuting
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi e
                    %annotation{:encoding => "application/x-tex"} d e
                to the middle are by definition the same in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi CE
                        %mo •
                    %annotation{:encoding => "application/x-tex"} CE^\bullet
                and in
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi CE
                          %mrow
                            %msub
                              %mi ℤ
                              %mn 2
                          %mo •
                      %annotation{:encoding => "application/x-tex"} CE^\bullet_{\mathbb{Z}_2}
            %li
              %p
                for terms of the second type there are a priori more signs picked up in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi CE
                        %mo •
                    %annotation{:encoding => "application/x-tex"} CE^\bullet
                than in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi CE
                          %mrow
                            %msub
                              %mi ℤ
                              %mn 2
                          %mo •
                      %annotation{:encoding => "application/x-tex"} CE^\bullet_{\mathbb{Z}_2}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
                that one commutes through. But as the differential first passes from the left into the string of
                = succeed "s" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                      %annotation{:encoding => "application/x-tex"} \psi
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} d \psi
                in turn is passed back to the left, these extra signs appear in even number and hence cancel out.
          %p
            In summary this establishes a
            %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi CE
                    %mo •
                  %mo ⟶
                  %msubsup
                    %mi CE
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %mo •
                %annotation{:encoding => "application/x-tex"} CE^\bullet \longrightarrow CE^\bullet_{\mathbb{Z}_2}
            which is an cochain
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            and hence in particular a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
          %h2#references References
          %h3#internalization_sign_rule Internalization sign rule
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internalization
            into the
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            over
            %a.existingWikiWord{:href => "/nlab/show/superpoints"} superpoints
            is due to
          %ul
            %li#Schwarz84
              %a.existingWikiWord{:href => "/nlab/show/Albert+Schwarz"}> Albert Schwarz
              ,
              = succeed "," do
                %em On the definition of superspace
              = succeed ")" do
                %a{:href => "http://www.mathnet.ru/links/b12306f831b8c37d32d5ba8511d60c93/tmf5111.pdf"} russian original pdf
          %p
            The internalization sign rule follows for instance from applying the construction of
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebras"} Grassmann algebras
            in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of
            %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            as discussed in
          %ul
            %li#Deligne90
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              , p. 165 in:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Cat%C3%A9gories+Tannakiennes"} Catégories Tannakiennes
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+Festschrift"} Grothendieck Festschrift
              %strong 87
              (1990) 111-195.
          %p The corresponding internal sign rule appears for instance in
          %ul
            %li#BonoraBregolaLechnerPastiTonin87
              %p
                %a.existingWikiWord{:href => "/nlab/show/Loriano+Bonora"}> Loriano Bonora
                , M. Bregola,
                = succeed "," do
