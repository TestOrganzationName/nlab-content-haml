                    %mo{:stretchy => "false"} (
                    %mi L
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q \circ f = f' \circ (L p)
          %h2#properties Properties
          %ul
            %li#EnvelopeOfAdjunctionCOmmaCategory
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:lspace => "verythinmathspace"} :
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} L \colon C \to D
                is
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                to a functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:lspace => "verythinmathspace"} :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} R \colon D \to C
                if and only if there is an isomorphism of
                %a.existingWikiWord{:href => "/nlab/show/comma+categories"} comma categories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} ↓
                      %mi D
                      %mo ≅
                      %mi C
                      %mo{:stretchy => "false"} ↓
                      %mi R
                    %annotation{:encoding => "application/x-tex"} L \downarrow D \cong C \downarrow R
                and this isomorphism commutes with the
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functors"} forgetful functors
                to the
                %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ×
                      %mi D
                    %annotation{:encoding => "application/x-tex"} C \times D
                (see
                = succeed ")." do
                  %a{:href => "adjoint+functor#InTermsOfCommaCategories"} there
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Env
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Env(L \dashv R)
                is also isomorphic to these comma categories over the evident
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo ×
                        %mi D
                      %annotation{:encoding => "application/x-tex"} C \times D
            %li
              %p
                Every adjunction factors through its envelope via a
                %a.existingWikiWord{:href => "/nlab/show/reflection"} reflective subcategory
                and a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/coreflection"} coreflective subcategory
