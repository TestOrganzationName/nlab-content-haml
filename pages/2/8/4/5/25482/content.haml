          %p
            In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Inv
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ⊣
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Inv(F \dashv G)
            is the full subcategory of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Env
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ⊣
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Env(F \dashv G)
            whose objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo ,
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c, d, f, g)
            have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            isomorphisms. (See Lemma 12.1 of
            = succeed ".)" do
              %a{:href => "#AveryLeinster"} Avery and Leinster
          %ul
            %li
              The envelope construction (respectively the
              %a.existingWikiWord{:href => "/nlab/show/fixed+point+of+an+adjunction"} fixed point
              construction) can be seen as
              %a.existingWikiWord{:href => "/nlab/show/2-adjunctions"} 2-adjunctions
              between
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              %a.existingWikiWord{:href => "/nlab/show/wide+subcategory"} wide
              sub-2-category of adjunctions whose morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo ,
                    %mi Q
                    %mo ,
                    %mi α
                    %mo ,
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (P, Q, \alpha, \beta)
              have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              invertible)).
