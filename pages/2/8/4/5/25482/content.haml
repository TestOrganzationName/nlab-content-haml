                  %mo ∘
                  %mi g
                  %mo =
                  %mi g
                  %mo ′
                  %mo ∘
                  %mi p
                %annotation{:encoding => "application/x-tex"} (R q) \circ g = g' \circ p
            or equivalently
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ∘
