          %p
            The
            %strong envelope
            of the adjunction, denoted
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Env
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Env(L \dashv R)
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            whose
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            are
            %a.existingWikiWord{:href => "/nlab/show/quadruples"} quadruples
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ∈
                  %mi C
                  %mo ,
                  %mi d
                  %mo ∈
                  %mi D
                  %mo ,
                  %mi f
                  %mo :
                  %mi L
                  %mi c
                  %mo →
                  %mi d
                  %mo ,
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi c
                  %mo →
                  %mi R
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (c \in C, d \in D, f : L c \to d, g \colon c \to R d)
          %p
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            are each other’s
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mate"} mate
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            are
            %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
