                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            %p
              And
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
              (example
              = succeed "):" do
                %a.maruku-ref{:href => "#OppositeCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
