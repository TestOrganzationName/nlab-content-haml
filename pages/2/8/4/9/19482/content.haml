                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{V}}\left(1,
                    \\left(
                    \\underset{c \in \mathcal{C}}{\int}
                    \\big[ F(c),G(c) \big]
                    \\right)
                    \\right)
                    \\;\simeq\;
                    Hom_{[\mathcal{C}, \mathcal{V}]}(F,G)
                    \\,.
          .proof
            %h6#proof_9 Proof
            %p
              The underlying pointed set functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
