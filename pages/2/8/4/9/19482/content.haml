          #LimitingCones.num_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cones"} cones
            %p
              Unwinding Definition
              %a.maruku-ref{:href => "#Limits"}
              of
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
            %p
              First of all, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
              any
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{C} \longrightarrow \mathcal{D}
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#NaturalTransformations"}
            #eq:ConeAsNaturalTransformation.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi const
                      %mi d
                    %mover
                      %mo ⇒
                      %mi i
                    %mi F
                  %annotation{:encoding => "application/x-tex"}
                    const_d \overset{i}{\Rightarrow} F
            %p has component morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi d
                        %mtr
                          %mtd
