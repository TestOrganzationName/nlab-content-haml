              %li
                %p and/or when a (co-)limiting cone exists only for some but not for all functors of this form.
          #TerminalObjectIsEmptyLimit.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"}> terminal
                \/
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                is
                %a.existingWikiWord{:href => "/nlab/show/empty+category"} empty
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/category"} category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \ast \in \mathcal{C}
              be an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  (Def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#InitialObject"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  of
                  %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
