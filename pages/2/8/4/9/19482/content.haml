              which satisfy some compatibility conditions in their dependence on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              (
              %a.existingWikiWord{:href => "/nlab/show/enriched+natural+transformation"} natural
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              and “
              %a.existingWikiWord{:href => "/nlab/show/extranatural"}> extranatural
              ” in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              to systems of morphisms of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    F(c)
                    \\longrightarrow
                    [\mathcal{C}(c,d), G(d)]
            %p
              satisfying the analogous compatibility conditions. By Example
              %a.maruku-ref{:href => "#NaturalTransformationsViaEnds"}
              these are in
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              with systems of morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(c) \longrightarrow [\mathcal{C},\mathcal{V}](\mathcal{C}(c,-), G(-))
            %p
              natural in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/enriched+Yoneda+lemma"} enriched Yoneda lemma
              (Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#YonedaReductionTopological"}
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              with systems of morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(c) \longrightarrow G(c)
            %p
              natural in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi 𝒞
                        %mo ,
                        %mi 𝒱
                        %mo{:stretchy => "false"} ]
                    %mrow
                      %mo (
                      %mover
                        %mo ∫
                        %mrow
                          %mi c
                          %mo ∈
                          %mi 𝒞
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Hom
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi 𝒞
                        %mo ,
                        %mi 𝒱
                        %mo{:stretchy => "false"} ]
                    %mrow
                      %mo (
                      %mi F
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{[\mathcal{C},\mathcal{V}]}
                    \\left(
                    \\overset{c \in \mathcal{C}}{\int} \mathcal{C}(c,-) \otimes F(c)
                    \\;,\;
                    (-)
                    \\right)
                    \\;\simeq\;
                    Hom_{[\mathcal{C},\mathcal{V}]}
                    \\left(
                    F,
                    (-)
                    \\right)
                    \\,.
            %p
              With this, the ordinary
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#YonedaLemma"}
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi 𝒞
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C},\mathcal{V}]
              implies the required isomorphism.
          #coYonedaLemmaOverSet.num_example
            %h6#example_7 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
                over
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalCoYonedaLemma"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathcal{V} =
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
            %p
              In this case the coequalizer in question is the set of
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mover
                      %mo →
                      %mrow
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    ( c \overset{}{\to} c_0,\; x  )
                    \\;\;
                    \\in
                    \\mathcal{C}(c,c_0) \otimes F(c)
                    \\,,
            %p where two such pairs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mover
                      %mo →
                      %mi f
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mover
                      %mo →
                      %mi g
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( c \overset{f}{\to} c_0,\; x \in F(c) )
                    \\,,\;\;\;\;
                    ( d \overset{g}{\to} c_0,\; y \in F(d) )
            %p are regarded as equivalent if there exists
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mover
                      %mo →
                      %mi ϕ
                    %mi d
                  %annotation{:encoding => "application/x-tex"}
                    c \overset{\phi}{\to} d
            %p such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi g
                    %mo ∘
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi y
                    %mo =
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f = g \circ \phi
                    \\,,
                    \\;\;\;\;\;and\;\;\;\;\;
                    y = \phi(x)
                    \\,.
            %p
              (Because then the two pairs are the two images of the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g,x)
              under the two morphisms being coequalized.)
            %p
              But now considering the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo =
                    %msub
                      %mi c
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} d = c_0
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo =
                      %msub
                        %mi id
                        %mrow
                          %msub
                            %mi c
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} g = id_{c_0}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} f = \phi
              shows that any pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mover
                      %mo →
                      %mi ϕ
                    %msub
                      %mi c
                      %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi x
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ( c \overset{\phi}{\to} c_0, \; x \in F(c))
            %p is identified, in the coequalizer, with the pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi c
                          %mn 0
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (id_{c_0},\; \phi(x) \in F(c_0))
                    \\,,
            %p
              hence with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi F
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi(x)\in F(c_0)
          %p As a conceptually important corollary we obtain:
          #FreeCocompletion.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/free+co-completion"} free co-completion
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SmallCategory"}
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mover
                      %mo ↪
                      %mi y
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \overset{y}{\hookrightarrow} [\mathcal{C}^{op}, Set]
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#YonedaEmbedding"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Set]
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/free+co-completion"} free co-completion
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              under forming
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#Limits"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/universal+morphism"} universal morphism
              %a.maruku-ref{:href => "#UniversalArrow"}
              but “up to natural isomorphism”, into a category with all colimits (by Example
              = succeed ")" do
                %a.maruku-ref{:href => "#LimitsOfPresheavesAreComputedObjectwise"}
            %ol
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}
                  any
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  with all
                  %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                  (Def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#Limits"}
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝒞
                        %mo ⟶
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{C} \longrightarrow \mathcal{D}
                  any
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %p
              there is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo ˜
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \widetilde F \;\colon\; [\mathcal{C}^{op}, Set] \longrightarrow \mathcal{D}
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo ˜
                      %annotation{:encoding => "application/x-tex"} \widetilde F
                  %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                  all
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo ˜
                      %annotation{:encoding => "application/x-tex"} \widetilde F
                  %a.existingWikiWord{:href => "/nlab/show/extension"} extends
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  through the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
