          #NaturalTransformationsViaEnds.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/enriched+natural+transformations"} enriched natural transformations
                as
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/ends"} ends
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi G
