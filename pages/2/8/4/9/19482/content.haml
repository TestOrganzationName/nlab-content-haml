                      %mi op
                    %mo ×
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"}
                    [F(-),G(-)]
                    \\;\colon\;
                    \\mathcal{C}^{op} \times \mathcal{C}
                    \\longrightarrow
                    \\mathcal{V}
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/set"} set
