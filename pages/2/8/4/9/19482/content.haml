                              %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    I(c_2)
                    \&amp;\longrightarrow&amp;
                    \\underset{\underset{d \in \mathcal{D}}{\longleftarrow}}{lim}
                    F(d)(c_2)
                    \\\
                    \\big\downarrow &amp;&amp; \big\downarrow
                    \\\
                    I(c_1)
                    \&amp;\longrightarrow&amp;
                    \\underset{\underset{d \in \mathcal{D}}{\longleftarrow}}{lim}
                    F(d)(c_1)
                    }
                    \\,.
            %p
              But since everything else commutes, the two ways of going around this diagram constitute two morphisms from a cone over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(-)(c_1)
              to the limit cone over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(-)(c_1)
          #HomFunctorPreservesLimits.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/hom-functor+preserves+limits"}> hom-functor preserves limits
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi 𝒞
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ×
                    %mi 𝒞
                    %mo ⟶
                    %mi Set
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{\mathcal{C}}
                    \\;\colon\;
                    \\mathcal{C}^{op} \times \mathcal{C}
                    \\longrightarrow
                    Set
            %p
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Limits"}
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
              is a
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              More in detail, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℐ
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X_\bullet \colon \mathcal{I} \longrightarrow \mathcal{C}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            %ol
              %li
                %p
                  If the
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %munder
                            %mi lim
                            %mo ⟵
                          %mi i
                        %msub
                          %mi X
                          %mi i
                      %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}_i X_i
                  exists in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  then for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mrow
                          %mo (
                          %mi Y
                          %mo ,
                          %msub
                            %munder
                              %mi lim
                              %mo ⟵
                            %mi i
                          %msub
                            %mi X
                            %mi i
                          %mo )
                        %mo ≃
                        %msub
                          %munder
                            %mi lim
                            %mo ⟵
                          %mi i
                        %mrow
                          %mo (
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mrow
                            %mo (
                            %mi Y
                            %mo ,
                            %msub
                              %mi X
                              %mi i
                            %mo )
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{\mathcal{C}}\left(Y, \underset{\longleftarrow}{\lim}_i X_i \right)
                        \\simeq
                        \\underset{\longleftarrow}{\lim}_i \left( Hom_{\mathcal{C}}\left( Y, X_i \right) \right)
                        \\,,
                %p
                  where on the right we have the limit over the diagram of
                  %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
                  given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi X
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi ℐ
                        %mover
                          %mo ⟶
                          %mi X
                        %mi 𝒞
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mi Set
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{\mathcal{C}}(Y,-) \circ X \;\colon\; \mathcal{I} \overset{X}{\longrightarrow} \mathcal{C} \overset{Hom_{\mathcal{C}}(Y,-)  }{\longrightarrow} Set\,.
              %li
                %p
                  If the
                  %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %munder
                            %mi lim
                            %mo ⟶
                          %mi i
                        %msub
                          %mi X
                          %mi i
                      %annotation{:encoding => "application/x-tex"} \underset{\longrightarrow}{\lim}_i X_i
                  exists in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  then for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
                  there is a
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mrow
                          %mo (
                          %msub
                            %munder
                              %mi lim
                              %mo ⟶
                            %mi i
                          %msub
                            %mi X
                            %mi i
                          %mo ,
                          %mi Y
                          %mo )
                        %mo ≃
                        %msub
                          %munder
                            %mi lim
                            %mo ⟵
                          %mi i
                        %mrow
                          %mo (
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mrow
                            %mo (
                            %msub
                              %mi X
                              %mi i
                            %mo ,
                            %mi Y
                            %mo )
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{\mathcal{C}}\left(\underset{\longrightarrow}{\lim}_i X_i ,Y\right)
                        \\simeq
                        \\underset{\longleftarrow}{\lim}_i \left( Hom_{\mathcal{C}}\left( X_i , Y\right) \right)
                        \\,,
                %p
                  where on the right we have the limit over the diagram of
                  %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
                  given by
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Hom
                          %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo ∘
                        %mi X
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi ℐ
                          %mi op
                        %mover
                          %mo ⟶
                          %mi X
                        %msup
                          %mi 𝒞
                          %mi op
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi Y
                            %mo{:stretchy => "false"} )
                        %mi Set
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Hom_{\mathcal{C}}(-,Y) \circ X \;\colon\; \mathcal{I}^{op} \overset{X}{\longrightarrow} \mathcal{C}^{op} \overset{Hom_{\mathcal{C}}(-,Y)  }{\longrightarrow} Set\,.
          .proof
            %h6#proof_4 Proof
            %p
              We give the proof of the first statement, the proof of the second statement is
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
              (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#OppositeCategory"}
            %p
              First observe that, by the very definition of
              %a.existingWikiWord{:href => "/nlab/show/limit"} limiting
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cones"} cones
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              into them are in natural bijection with the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cones
                    %mrow
                      %mo (
                      %mi Y
                      %mo ,
                      %msub
                        %mi X
                        %mo •
                      %mo )
                  %annotation{:encoding => "application/x-tex"} Cones\left(Y, X_\bullet \right)
              of cones over the diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              with tip
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mrow
                      %mo (
                      %mi Y
                      %mo ,
                      %msub
                        %munder
                          %mi lim
                          %mo ⟵
                        %mi i
                      %msub
                        %mi X
                        %mi i
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi Cones
                    %mrow
                      %mo (
                      %mi Y
                      %mo ,
                      %msub
                        %mi X
                        %mo •
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom\left(
                    Y,
                    \\underset{\longleftarrow}{\lim}_{i} X_i
                    \\right)
                    \\;\simeq\;
                    Cones\left(
                    Y, X_\bullet
                    \\right)
                    \\,.
            %p Hence it remains to show that there is also a natural bijection like so:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cones
                    %mrow
                      %mo (
                      %mi Y
                      %mo ,
                      %msub
                        %mi X
                        %mo •
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %munder
                        %mi lim
                        %mo ⟵
                      %mi i
                    %mrow
                      %mo (
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi X
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cones\left(
                    Y,
                    X_\bullet
                    \\right)
                    \\;\simeq\;
                    \\underset{\longleftarrow}{\lim}_{i} \left( Hom(Y,X_i) \right)
                    \\,.
            %p Now, again by the very definition of limiting cones, a single element in the limit on the right is equivalently a cone of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo *
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi const
                                        %mrow
                                          %msub
                                            %mi p
                                            %mi i
                                %mo ↙
                              %mtd
                              %mtd
                                %msup
                                  %mo ↘
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi const
                                        %mrow
                                          %msub
                                            %mi p
                                            %mi j
                            %mtr
                              %mtd
                                %mi Hom
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %msub
                                  %mi X
                                  %mi i
                                %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %msub
                                      %mi X
                                      %mi α
                                    %mo ∘
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                              %mtd
                              %mtd
                                %mi Hom
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %msub
                                  %mi X
                                  %mi j
                                %mo{:stretchy => "false"} )
                        %mo }
                      %mrow
                        %mi i
                        %mo ,
                        %mi j
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi ℐ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi α
                        %mo ∈
                        %msub
                          %mi Hom
                          %mi ℐ
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\array{
                    \&amp;&amp; \ast
                    \\\
                    \&amp; {}^{\mathllap{const_{p_i}}}\swarrow &amp;&amp; \searrow^{\mathrlap{const_{p_j}}}
                    \\\
                    Hom(Y,X_i)
                    \&amp;&amp; \underset{X_\alpha \circ (-)}{\longrightarrow} &amp;&amp;
                    Hom(Y,X_j)
                    }
                    \\right\}_{i, j \in Obj(\mathcal{I}), \alpha \in Hom_{\mathcal{I}}(i,j) }
                    \\,.
            %p
              This is equivalently for each object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} i \in \mathcal{I}
              a choice of morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Y
                    %mo →
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} p_i \colon Y \to X_i
              , such that for each pair of objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} i,j \in \mathcal{I}
              and each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msub
                      %mi Hom
                      %mi ℐ
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha \in Hom_{\mathcal{I}}(i,j)
              we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi α
                      %mo ∘
                      %msub
                        %mi p
                        %mi i
                      %mo =
                      %msub
                        %mi p
                        %mi j
                    %annotation{:encoding => "application/x-tex"} X_\alpha \circ p_i = p_j
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cones
                      %mrow
                        %mo (
                        %mi Y
                        %mo ,
                        %msub
                          %mi X
                          %mo •
                        %mo{:stretchy => "false"} }
                        %mo )
                    %annotation{:encoding => "application/x-tex"} Cones\left( Y, X_\bullet\} \right)
          #InitialAndTerminalObjectInTermsOfAdjunction.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
                and
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                in terms of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#Categories"}
            %ol
              %li
                %p The following are equivalent:
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                      has a
                      %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                      (Def.
                      = succeed ");" do
                        %a.maruku-ref{:href => "#InitialObject"}
                  %li
                    %p
                      the unique
                      %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                            %mo →
                            %mo *
                          %annotation{:encoding => "application/x-tex"} \mathcal{C} \to \ast
                      (Def.
                      = succeed ")" do
