                        %mo{:stretchy => "false"} [
                        %mi 𝒞
                        %mo ,
                        %mi 𝒟
                        %mo{:stretchy => "false"} ]
                        %mo ⟶
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"}
