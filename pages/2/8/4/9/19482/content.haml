                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mphantom
                        %mi AAAAAAAA
                      %munder
                        %mo ⟶
                        %mrow
                          %munder
                            %mo ⊔
