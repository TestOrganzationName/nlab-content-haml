                    \\\
                    \\big\downarrow^{\mathrlap{i_c}}
                    \\\
                    F(c)
                    }
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
              %a.maruku-eqref{:href => "#eq:Naturality"} (?)
              says that these form a
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CommutingDiagram"}
            #eq:ConeInComponents.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi d
                        %mtr
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mrow
                                      %msub
                                        %mi c
                                        %mn 1
                            %mo ↙
                          %mtd
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi i
                                    %mrow
                                      %msub
                                        %mi c
                                        %mn 2
                        %mtr
                          %mtd
                            %mi F
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
