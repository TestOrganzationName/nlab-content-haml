                    \\,.
            %p
              This is particularly suggestive when
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusion (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo →
