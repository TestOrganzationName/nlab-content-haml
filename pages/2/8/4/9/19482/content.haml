          #CoendGivesQuotientByDiagonalGroupAction.num_example
            %h6#example_5 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} G \in \mathcal{V}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              as in Example
              = succeed "." do
                %a.maruku-ref{:href => "#DeloopingGroupoid"}
            %p
              Then a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi ρ
                      %mi l
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ⟶
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"}
                    (X,\rho_l) \;\colon\; \mathbf{B}G \longrightarrow \mathcal{V}
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≔
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} X \coloneqq F(\ast) \; \in \mathcal{V}
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mi l
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ⊗
                    %mi X
                    %mo ⟶
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\rho_l \;\colon\; G \otimes X \longrightarrow X
            %p
              satisfying the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              property. Hence this is equivalently an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#OppositeAndProductOfPointedTopologicallyEnrichedCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)^{op}
              comes from the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/opposite+group"} opposite group
              %a.existingWikiWord{:href => "/nlab/show/group+object"} object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi G
                      %mi op
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{B}G)^{op}
                    \=
                    \\mathbf{B}(G^{op})
                    \\,.
            %p
              (The isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ≃
                    %msup
                      %mi G
                      %mi op
                  %annotation{:encoding => "application/x-tex"} G \simeq G^{op}
              induces a canonical euqivalence of enriched categories
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo ≃
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)^{op} \simeq \mathbf{B}G
            %p
              So an
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %msub
                      %mi ρ
                      %mi r
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ⟶
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"}
                    (Y,\rho_r)
                    \\;\colon\;
                    (\mathbf{B} G)^{op} \longrightarrow \mathcal{V}
            %p
              is equivalently a
              %em right
              %a.existingWikiWord{:href => "/nlab/show/action"} action
