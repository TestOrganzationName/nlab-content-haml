                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; d
                    \\\
                    \&amp; {}^{\mathllap{ i_{c_1} } }\swarrow &amp;&amp; \searrow^{\mathrlap{ i_{c_2} }}
                    \\\
                    F(c_1)
                    \&amp;&amp; \underset{ \phantom{AA} F(f) \phantom{AA} }{\longrightarrow} &amp;&amp;
                    F(c_2)
