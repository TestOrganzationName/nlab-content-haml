          #CoendFormulaForPresheavesOfSets.num_example
            %h6#example_8 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/coend"} coend
                formula for left
                %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
                of ordinary
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              to be
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathcal{V} =
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              = succeed "," do
                %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopEnrichedCategory"}
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Categories"}
              = succeed "," do
                %a.maruku-ref{:href => "#SetEnrichedCategoriesArePlainCategories"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %a.existingWikiWord{:href => "/nlab/show/enriched+presheaves"} enriched presheaves
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#EnrichedPresheaf"}
              %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              (Example
              = succeed ")." do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
            %p
              Then for any plain
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Functors"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi op
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mi p
                        %mphantom
                          %mi AA
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ′
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}^{op}
                    \\overset{\phantom{AA} p \phantom{AA}}{\longrightarrow}
                    (\mathcal{C}')^{op}
            %p
              the general formula
              %a.maruku-eqref{:href => "#eq:FormulaLeftKanExtensionByCoend"} (17)
              for
              %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Lan
                          %mi p
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ′
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op},Set]
                    \\overset{Lan_p}{\longrightarrow}
                    [(\mathcal{C}')^{op}, Set]
            %p is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                    %mi C
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Lan_p F)(c') \simeq \int^{c \in C} C'(c', p(c)) \times F(c)
                    \\,.
            %p
              Using here the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#YonedaLemma"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi Hom
                        %mrow
                          %mi PSh
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(c) \simeq Hom_{PSh(C)}(c,F)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Lan
                      %mi p
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mo ∫
                      %mrow
                        %mi c
                        %mo ∈
                        %mi C
                    %msub
                      %mi Hom
                      %mrow
                        %mi C
                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msub
                      %mi Hom
                      %mrow
                        %mi PSh
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Lan_p F)(c') \simeq \int^{c \in C} Hom_{C'}(c', p(c)) \times Hom_{PSh(C)}(c,F)
                    \\,.
            %p
              Hence this
              = succeed "-set" do
                %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
              of
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              of
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo →
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi c
                    %mo →
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (c' \to p(c), c \to F)
            %p
              where two such are regarded as equivalent whenever there is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi c
                    %msub
                      %mo ′
                      %mn 1
                    %mo →
                    %mi c
                    %msub
                      %mo ′
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f \colon c'_1 \to c'_2
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
