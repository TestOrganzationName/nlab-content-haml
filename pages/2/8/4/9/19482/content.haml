                    \\\
                    p(c_1) &amp;&amp; \stackrel{p(f)}{\longrightarrow} &amp;&amp; p(c_2)
                    \\\
                    c_1 &amp;&amp; \stackrel{f}{\longrightarrow} &amp;&amp; c_2
                    \\\
