                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            In general, for any derived stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            one can define the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty, 1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X)
            of ‘functions on
            = succeed "\u2019." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as a colimit of affine derived schemes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ≃
                  %msub
                    %mi colim
                    %mrow
                      %mi U
                      %mo ∈
                      %msub
                        %mi Aff
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                  %mi U
                %annotation{:encoding => "application/x-tex"} X \simeq colim_{U \in Aff_{/X}} U
            and then one sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi lim
                    %mrow
                      %mi U
                      %mo ∈
                      %msub
                        %mi Aff
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  QC(X) = lim_{U \in Aff_{/X}} QC(U)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(U)
            for an
            %em affine
            stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo =
                  %mi Spec
                  %mi A
                %annotation{:encoding => "application/x-tex"} U = Spec A
            is simply defined as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Mod
                      %mi A
                  %annotation{:encoding => "application/x-tex"} Mod_A
          %p
            One incarnation of derived stack in differential geometry is as an
            = succeed "." do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
                \-groupoid internal to differential graded manifolds
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            groupoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            internal to differential graded manifolds) we can more simply set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi smooth
                  %mi ω
                  %mo −
                  %mi functors
                  %mi from
                  %mi X
                  %mi to
                  %mi chain
                  %mi complexes
                %annotation{:encoding => "application/x-tex"}
                  QC(X) = smooth \omega-functors from X to chain complexes
          %p
            since the latter plays the role of a ‘derived
            = succeed "-module\u2019." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
          %p
            A derived stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %em perfect
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X)
            is ‘finitely generated’ in an appropriate sense. One first has to decide what means by a ‘finite object’, and then one must decide what it means for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X)
            to be ‘generated’ by these objects. There are various routes one could take, but happily in the context of
            %em perfect
            stacks these all turn out to be equivalent. (In fact, it seems more or less true that perfect stacks are precisely those stacks where these various requirements coincide).
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/derived+stack"} derived stack
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/perfect+%E2%88%9E-stack"} perfect ∞-stack
          %h4#definition_of_a_perfect_stack definition of a perfect stack
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/compact+object+in+an+%28%E2%88%9E%2C1%29-category"} compact object in an (∞,1)-category
          %h4#base_change_and_projection_formula base change and projection formula
          %h4#constructions_of_perfect_stacks constructions of perfect stacks
          %h3#4_tensor_products_and_integral_transforms 4. Tensor products and integral transforms
          %p
            Classical algebra is all about constructions in the category
            %b
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            in the usual sense is a
            %a.existingWikiWord{:href => "/nlab/show/monoid+object"} monoid object
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi Ab
                %annotation{:encoding => "application/x-tex"} R \in {\mathbf Ab}
            together with multiplication and unit morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mi R
                  %mo ⊗
                  %mi R
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} m: R \otimes R \rightarrow R
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi η
                  %mo :
                  %mi ℤ
                  %mo →
                  %mi R
                %annotation{:encoding => "application/x-tex"} \eta: \mathbb{Z} \rightarrow R
            so that we have commutativity of appropriate diagrams expressing associativity and unity. Likewise, a right
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            in the usual sense is an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi Ab
                %annotation{:encoding => "application/x-tex"} M \in {\mathbf Ab}
            together with an
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi M
                  %mo ⊗
                  %mi R
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} a: M \otimes R \rightarrow M
            such that appropriate diagrams commute, and similarly for left modules.
          %p
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} Brave new algebra
            is about constructions in the
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-category+of+spectra"} stable (∞,1)-category of spectra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} S_{\infty}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2C1%29-category"} closed symmetric monoidal
            (under
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/smash+product+of+spectra"} smash product of spectra
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} (co)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete
            %a.existingWikiWord{:href => "/nlab/show/algebra+in+an+%28infinity%2C1%29-category"} algebra objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and
            %a.existingWikiWord{:href => "/nlab/show/commutative+algebra+in+an+%28infinity%2C1%29-category"} commutative algebra objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} S_{\infty}
          %p
            Even more generally, one can develop a
            %em fearless new algebra
            in which we consider some closed, symmetric monoidal and (co)complete
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and algebras and commutative algebras in it (see
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Pr
                      %mi L
                  %annotation{:encoding => "application/x-tex"} Pr^{L}
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-categories"} presentable (∞,1)-categories
            with morphisms given by colimit preserving functors. (More on the closed monoidal structure below.)
          %p
            The particular algebra objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Pr^{L}
            of interest to BZFN are
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-categories"} stable (∞,1)-categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X)
            of quasi-coherent sheaves on a
            %a.existingWikiWord{:href => "/nlab/show/perfect+infinity-stack"} perfect
            %a.existingWikiWord{:href => "/nlab/show/derived+stack"} derived stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X)
            being the good old-fashioned
            %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            of quasi-coherent
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaves
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X)
            is symmetric monoidal under the usual
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of quasi-coherent sheaves. Given two perfect derived stacks
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} X_{1}, X_{2}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                          %mo ×
                          %msub
                            %mi X
                            %mn 2
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mrow
                              %msub
                                %mi p
                                %mn 1
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                          %msup
                            %mrow
                            %mrow
                              %msub
                                %mi p
                                %mn 2
                      %mtr
                        %mtd
                          %msub
                            %mi X
                            %mn 1
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi X
                            %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; X_1 \times X_2
                  \\\
                  \&amp; {}^{p_1}\swarrow &amp;&amp; \searrow{}^{p_2}
                  \\\
                  X_1 &amp;&amp;&amp;&amp; X_2
                  
                  }
          %p
            Given an object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mo ∈
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{P} \in QC(X_1 \times X_2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Φ
                    %mi 𝒫
                  %mo :
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi_{\mathcal{P}}: QC(X_1) \rightarrow QC(X_2)
            by pulling-back along
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℱ
                    %mo ∈
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{F} \in QC(X_1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Φ
                      %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi ℱ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mrow
                        %msub
                          %mi p
                          %mn 2
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msup
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                      %mo *
                    %mi ℱ
                    %mo ⊗
                    %mi 𝒫
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi_{\mathcal{P}}(\mathcal{F}):= {p_2}_{*}({p_1}^{*}\mathcal{F} \otimes \mathcal{P})
            %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
            of the sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℱ
                %annotation{:encoding => "application/x-tex"} \mathcal{F}
            with respect to the kernel
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
          %p In fact, because of the naturality of the above operations, this process gives a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo :
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ×
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Fun
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \Phi: QC(X_1 \times X_2) \rightarrow Fun^{L}(QC(X_1), QC(X_2)),
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Fun
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fun^{L}(QC(X_1), QC(X_2))
            is the internal Hom in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Pr^{L}
            and consists of colimit preserving functors and their natural transformations.
          %p
            The main result of section 4 of BZFN (which has been called above the fundamental theorem of geometric
            = succeed "-function" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          .standout
            %p
              %a.existingWikiWord{:href => "/nlab/show/integral+transform"}> integral transform
              s = colimit preserving functors
          %p
            This was first proved in the context of
            %a.existingWikiWord{:href => "/nlab/show/dg-category"} differential graded categories
            by Toën, building on work of Bondal, Orlov, and others. Note that one can define a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            in the same way at the level of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated categories
          %h4#41_tensor_products_of_categories
            4.1 Tensor products of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            In order to be more precise, we need to look at the closed, symmetric monoidal structure on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Pr
                      %mi L
                  %annotation{:encoding => "application/x-tex"} Pr^{L}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} DAG II.4 and DAG III.6
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            between two
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-categories"} presentable (∞,1)-categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ,
                  %mi D
                %annotation{:encoding => "application/x-tex"} C,D
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fun
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fun^{L}(C,D)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functors"} (∞,1)-functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            as
            %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
            or weak Kan complexes. Functors from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            are just maps of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is just the simplicial set of maps (internal Hom in simplicial sets)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fun
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fun(C,D)
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is an
            = succeed "-category/weak" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fun
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fun(C,D)
            = succeed "-subcategory" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-simplices" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fun
                      %mi L
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fun^{L}(C,D)
          %blockquote
            %p
              %a.existingWikiWord{:href => "/nlab/show/Chris+Brav"}> Chris
              \: (If there is some inaccuracy noted by anyone, feel free to comment. I might have forgotten some fibrant or cofibrant replacement somewhere.)
          %p
            For the
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2C1%29-category+of+presentable+%28infinity%2C1%29-categories"} tensor product of presentable (∞,1)-categories
            we construct the
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ⊗
                  %mi D
                %annotation{:encoding => "application/x-tex"} C \otimes D
            which is ‘the universal recipient of a bilinear functor’ from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ×
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C \times D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            as addition, so if a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ×
                  %mi D
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} C \times D \rightarrow E
            preserves colimits in each variable, then in particular it preserves coproducts and so is ‘bilinear’. Such a bilinear functor will factor uniquely (in a homotopic sense) through a universal bilinear functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ×
                    %mi D
                    %mo →
                    %mi C
                    %mo ⊗
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C \times D \rightarrow C \otimes D
          %p
            Now given the above closed
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+%28infinity%2C1%29-category"} symmetric monoidal structure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Pr^{L}
            and since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Pr^{L}
            also has limits and colimits, we can have all kinds of fun. For instance, given an algebra object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %msup
                      %mi Pr
                      %mi L
                  %annotation{:encoding => "application/x-tex"} R \in Pr^{L}
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ∈
                    %msup
                      %mi Pr
                      %mi L
                  %annotation{:encoding => "application/x-tex"} M \in Pr^{L}
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %msup
                      %mi Pr
                      %mi L
                  %annotation{:encoding => "application/x-tex"} N \in Pr^{L}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %msub
                    %mo ⊗
                    %mi R
                  %mi N
                  %mo ∈
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} M \otimes_R N \in Pr^{L}
            as the coequalizer of the pair of functors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ⊗
                  %mi R
                  %mo ⊗
                  %mi N
                  %munderover
                    %mo ⇉
                    %mi α
                    %mi β
                  %mi M
                  %mo ⊗
                  %mi N
                %annotation{:encoding => "application/x-tex"} M \otimes R \otimes N \underoverset{\alpha}{\beta}{\rightrightarrows} M \otimes N
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            is the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            on the right of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            is the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            on the left of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
          %p
            In section of 4.1 BZFN, there are various results, which are consequences of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Barr-Beck+theorem"} (∞,1)-categorical Barr–Beck theorem
          %blockquote
            %p
              %a.existingWikiWord{:href => "/nlab/show/Chris+Brav"}> Chris
              \: They seem interesting and useful, but I don’t seem to need them just at the moment, so I’ll come back to them some other time.
          %h4#42_sheaves_on_fiber_products 4.2 Sheaves on fiber products
          %p
            In our present context, we consider a morphism of
            %a.existingWikiWord{:href => "/nlab/show/perfect+infinity-stack"} perfect
            %a.existingWikiWord{:href => "/nlab/show/derived+stacks"} derived stacks
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} q: X \rightarrow Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            and tensoring, we make
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M=QC(X)
            into a
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R=QC(Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ?
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi q
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mo ?
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (?) \otimes q^{*}(?): QC(X) \times QC(Y) \rightarrow QC(X)
            is indeed bilinear since pullback
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi q
                    %mo *
                %annotation{:encoding => "application/x-tex"} q^{*}
            is the left adjoint of pushforward
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi q
                      %mo *
                  %annotation{:encoding => "application/x-tex"} q_{*}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} QC(X) \otimes QC(Y) \rightarrow QC(Y)
          %p
            Now given a pair of perfect derived stacks
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi X
                    %mn 2
                %annotation{:encoding => "application/x-tex"} X_1, X_2
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R=QC(Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo =
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M=QC(X_1)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo =
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N=QC(X_2)
            (left and right don’t matter here, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo =
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R=QC(Y)
            is symmetric monoidal) and we can form their relative tensor product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi QC
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} QC(X_1) \otimes_{QC(Y)} QC(X_2).
          %p Now we can define a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊠
                  %mo :
                  %mo =
                  %msup
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                    %mo *
                  %mo ?
                  %mo ⊗
                  %msup
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                    %mo *
                  %mo ?
                  %mo :
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi QC
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %msub
                    %mo ×
                    %mi Y
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} \boxtimes:={p_1}^{*}? \otimes {p_2}^{*}?: QC(X_1) \otimes_{QC(Y)} QC(X_2) \rightarrow QC(X_1 \times_Y X_2).
          %p
            (We see that the above functor is bilinear (since pullbacks and tensor products preserve colimits) and coequalizes the action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(Y)
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X_1)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X_2)
            (by commutativity of the fibre product diagram), so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊠
                %annotation{:encoding => "application/x-tex"} \boxtimes
            does indeed define a functor.)
          %p
            The first step in proving that ‘integral transforms=colimit preserving functors’ is to show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊠
                %annotation{:encoding => "application/x-tex"} \boxtimes
            is an equivalence. Then one has to show that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X_1)
            is self-dual as a
            = succeed "-module," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} QC(Y)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi QC
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %msub
                    %mo ⊗
                    %mrow
                      %mi QC
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msubsup
                    %mi Fun
                    %mi Y
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} QC(X_1) \otimes_{QC(Y)} QC(X_2) \simeq QC(X_1)^{*}\otimes_{QC(Y)} QC(X_2)\simeq Fun_{Y}^{L}(QC(X_1),QC(X_2)).
          %p
            As an intermediate step, BZFN first establish an equivalence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊠
                    %mo :
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi c
                    %mo ⊗
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi c
                    %mo ≃
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \boxtimes: QC(X_1)^{c} \otimes QC(X_2)^{c} \simeq QC(X_1 \times X_2)^{c}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            denotes the
            = succeed "-subcategories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi c
                    %mo ⊗
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi c
                  %annotation{:encoding => "application/x-tex"} QC(X_1)^{c} \otimes QC(X_2)^{c}
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            takes compact objects to compact objects, so we do get a functor as above, and that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ×
                  %msub
                    %mi X
                    %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi c
                %annotation{:encoding => "application/x-tex"} QC(X_1 \times X_2)^{c}
            is generated by external products. To prove that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊠
                %annotation{:encoding => "application/x-tex"} \boxtimes
            is an equivalence, it is therefore sufficient to prove that for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi M
                      %mi i
                    %mo ,
                    %msub
                      %mi N
                      %mi i
                    %mo ∈
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M_i,N_i \in QC(X_i)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %msub
                        %mi X
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mn 1
                  %mo ⊠
                  %msub
                    %mi M
                    %mn 2
                  %mo ,
                  %msub
                    %mi N
                    %mn 1
                  %mo ⊠
                  %msub
                    %mi N
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi Hom
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mn 1
                  %mo ,
                  %msub
                    %mi N
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msub
                    %mi Hom
                    %mrow
                      %msub
                        %mi X
                        %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi M
                    %mn 2
                  %mo ,
                  %msub
                    %mi N
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} Hom_{X_1 \times X_2}(M_1 \boxtimes M_2, N_1 \boxtimes N_2) \simeq Hom_{X_1}(M_1, N_1) \otimes Hom_{X_2}(M_2, N_2),
          %p
            which is a nice exercise using the dualizability of the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi i
                %annotation{:encoding => "application/x-tex"} M_i
            and the projection formula.
          %p
            Having established the equivalence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊠
                    %mo :
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi c
                    %mo ⊗
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi c
                    %mo ≃
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi c
                  %annotation{:encoding => "application/x-tex"} \boxtimes: QC(X_1)^{c} \otimes QC(X_2)^{c} \simeq QC(X_1 \times X_2)^{c}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ind
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi i
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ind(QC(X_i)^{c})\simeq QC(X_i)
            and the fact (Proposition 4.4) that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ind
                  %mo :
                  %mi Idem
                  %mo →
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Ind: Idem \rightarrow Pr^{L}
            from small idempotent complete stable
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Pr^{L}
            is symmetric monoidal, we get that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Ind
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi c
                  %mo ⊗
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Ind
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ×
                  %msub
                    %mi X
                    %mn 2
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ×
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} QC(X_1) \otimes QC(X_2) \simeq Ind(QC(X_1)^{c} \otimes QC(X_2)^{c}) \simeq Ind(QC(X_1 \times X_2)^{c}) \simeq QC(X_1 \times X_2).
          %p
            This gives the absolute version of the equivalence we want. To make it relative over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi QC
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X_1) \otimes_{QC(Y)} QC(X_2)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %msub
                    %mo ×
                    %mi Y
                  %msub
                    %mi X
                    %mn 2
                %annotation{:encoding => "application/x-tex"} X_1 \times_{Y} X_2
            in concrete terms. For the former, you use Barr-Beck and realize the category as modules for the monad
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo *
                    %msup
                      %mi π
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \pi_{*}\pi^{*}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %msub
                      %mi X
                      %mn 1
                    %msub
                      %mo ×
                      %mi Y
                    %msub
                      %mi X
                      %mn 2
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \pi: X_1 \times_{Y} X_2 \rightarrow X_1 \times X_2
          %p
            Now given the equivalence
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊠
                    %mo :
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %mi QC
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %msub
                      %mo ×
                      %mi Y
                    %msub
                      %mi X
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \boxtimes: QC(X_1) \otimes_{QC(Y)} QC(X_2) \rightarrow QC(X_1 \times_Y X_2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} p: X \rightarrow Y
            of perfect stacks,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X)
            is self-dual as a
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} QC(Y)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %mi QC
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi X
                    %msub
                      %mo ×
                      %mi Y
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} QC(X) \otimes_{QC(Y)} QC(X) \simeq QC(X \times _Y X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo :
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi QC
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau: QC(X) \otimes_{QC(Y)} QC(X) \rightarrow QC(Y)
            and unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo :
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %mi QC
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} u: QC(Y) \rightarrow QC(X) \otimes_{QC(Y)} QC(X)
            so that the composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi id
                  %mo ⊗
                  %mi τ
                  %mo ∘
                  %mi u
                  %mo ⊗
                  %mi id
                  %mo :
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} id \otimes \tau \circ u \otimes id: QC(Y) \rightarrow QC(Y)
            is the identity. To do this, consider the relative diagonal morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                  %msub
                    %mo ×
                    %mi Y
                  %mi X
                %annotation{:encoding => "application/x-tex"} \Delta: X \rightarrow X \times_Y X
            and define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo =
                  %msub
                    %mi Δ
                    %mo *
                  %msup
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} p
                    %mo *
                %annotation{:encoding => "application/x-tex"} u=\Delta_{*}\p^{*}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo :
                    %msub
                      %mi p
                      %mo *
                    %msup
                      %mi Δ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \tau: p_{*}\Delta^{*}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
            satisfy the necessary conditions.
          %p The final result from this section, Corollary 4.12, is useful for the applications to topological field theory:
          %p
            Given a finite simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            a perfect stack
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"} X^{\Sigma}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} QC(X^{\Sigma}) \simeq QC(X) \otimes \Sigma
          %blockquote
            %p
              %a.existingWikiWord{:href => "/nlab/show/Chris+Brav"}> Chris
              \:Haven’t thought this through. Someone may comment, or I’ll come back to it later.
          %h4#43_geometric_base_stacks 4.3 Geometric base stacks
          %p
            The ‘fundamental theorem’ described above can be extended to the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X_1 \rightarrow Y
            is a perfect morphism of geometric stacks (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} X_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            need not be absolutely perfect) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 2
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X_2 \rightarrow Y
            is an arbitrary morphism of stacks.
          %h3#5_applications 5. Applications
          %p
            In this section, BZFN study the categorical center
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "italic"}
                    %mi Z
                %annotation{:encoding => "application/x-tex"} \mathit{Z}
            and trace
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "italic"}
                    %mi Tr
                %annotation{:encoding => "application/x-tex"} \mathit{Tr}
            of presentable mononoidal
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p Two geometric cases are of special interest.
          %p
            When the monoidal category is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi QC
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} QC(X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "italic"}
                    %mi Z
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi LX
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mstyle{:mathvariant => "italic"}
                    %mi Tr
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \mathit{Z}(QC(X))\simeq QC(LX) \simeq \mathit{Tr}(QC(X)),
          %p
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LX
                    %mo =
                    %mi X
                    %msub
                      %mo ×
                      %mrow
                        %mi X
                        %mo ×
                        %mi X
                    %mi X
                  %annotation{:encoding => "application/x-tex"} LX=X \times_{X \times X} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            When the monoidal category is
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo ×
                    %mi Y
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} QC(X \times_Y X)
            equipped with convolution, then there is an equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "italic"}
                    %mi Z
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo ×
                    %mi Y
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi LY
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathit{Z}(QC(X \times_Y X))\simeq QC(LY)
          %p and once Grothendieck duality has been worked out for derived stacks, then there will be another equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi LY
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mstyle{:mathvariant => "italic"}
                    %mi Tr
                  %mo{:stretchy => "false"} (
                  %mi QC
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo ×
                    %mi Y
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} QC(LY) \simeq \mathit{Tr}(QC(X \times_Y X)).
          %p
            The categorical center is a generalization of lots of things: the center of an algebra, the Hochschild cochain complex of an algebra, the Drinfeld double of a monoidal category… It turns out to be an
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %h4#some_background Some background
          %p
            Let’s start with a good old-fashioned algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            (an algebra object in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ab
                %annotation{:encoding => "application/x-tex"} Ab
            of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Vect
                  %annotation{:encoding => "application/x-tex"} Vect
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z(A)
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as a bimodule over itself:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi End
                      %mrow
                        %mi A
                        %mo ⊗
                        %msup
                          %mi A
                          %mi op
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} End_{A \otimes A^{op}}(A)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi End
                    %mrow
                      %mi A
                      %mo ⊗
                      %msup
                        %mi A
                        %mi op
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Z(A) \rightarrow End_{A \otimes A^{op}}(A)
          %p
            that sends a central element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to multiplication by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is an isomorphism of algebras (multiplication by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is indeed a bimodule endomorphism since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            is central and every bimodule endomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi φ
                %annotation{:encoding => "application/x-tex"} \varphi
            is of this form since it is determined by
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi φ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \varphi(1)=x
          %p
            If we consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as an algebra object in the (dg enhanced) derived category of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} Ab
            %em derived
            endomorphisms of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as an
            = succeed "-bimodule," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %em derived center
            of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi RHom
                    %mrow
                      %mi A
                      %mo ⊗
                      %msup
                        %mi A
                        %mi op
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} RHom_{A \otimes A^{op}}(A,A).
          %p
            The cohomology of this dg algebra is a graded algebra known as the
            %em Hochschild cohomology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi End
                      %mrow
                        %mi A
                        %mo ⊗
                        %msup
                          %mi A
                          %mi op
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Z(A)=End_{A \otimes A^{op}}(A)
          %p
            To compute
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi RHom
                    %mrow
                      %mi A
                      %mo ⊗
                      %msup
                        %mi A
                        %mi op
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} RHom_{A \otimes A^{op}}(A,A)
            in practice, one has take a projective resolution of the first entry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as an
            = succeed "-bimodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                  %annotation{:encoding => "application/x-tex"} Hom
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo =
                  %mi A
                  %mo ⊗
                  %mo ?
                  %mo :
                  %mi Mod
                  %msup
                    %mi A
                    %mi op
                  %mo →
                  %mi Mod
                  %mi A
                  %mo ⊗
                  %msup
                    %mi A
                    %mi op
                  %mo ,
                %annotation{:encoding => "application/x-tex"} L=A \otimes ?: Mod A^{op} \rightarrow  Mod A \otimes A^{op},
          %p
            which is left adjoint to the forgetful functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %mi Mod
                    %mi A
                    %mo ⊗
                    %msup
                      %mi A
                      %mi op
                    %mo →
                    %mi Mod
                    %msup
                      %mi A
                      %mi op
                  %annotation{:encoding => "application/x-tex"} R:Mod A \otimes A^{op} \rightarrow Mod A^{op}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi LR
                %annotation{:encoding => "application/x-tex"} LR
            is a comonad on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mod
                  %mi A
                  %mo ⊗
                  %msup
                    %mi A
                    %mi op
                %annotation{:encoding => "application/x-tex"} Mod A \otimes A^{op}
            and so applying it to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            gives (in the usual way) an augmented simplicial object whose
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %mo ⊗
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} A^{\otimes k+1}
            = succeed "st" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} -1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_*(A)
            of free
            = succeed "-bimodules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                %annotation{:encoding => "application/x-tex"} Hom
            complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mrow
                      %mi A
                      %mo ⊗
                      %msup
                        %mi A
                        %mi op
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi C
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom_{A \otimes A^{op}}(C_*(A),A)
          %p
            is known as the Hochschild cochain complex of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and provides the standard model for the derived center of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            Now for the categorical trace. Given two bimodules
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo ,
                  %mi N
                %annotation{:encoding => "application/x-tex"} M,N
            we can form their relative tensor product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %msub
                      %mo ⊗
                      %mi A
                    %mo ⊗
                    %msup
                      %mi A
                      %mi op
                    %mi N
                  %annotation{:encoding => "application/x-tex"} M \otimes_A\otimes A^{op} N
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            by flat (or a fortiori free)
            = succeed "-bimodules," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with itself as an
            = succeed "-bimodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo ⊗
                    %mrow
                      %mi A
                      %mo ⊗
                      %msup
                        %mi A
                        %mi op
                  %msub
                    %mi C
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} A \otimes_{A \otimes A^{op}} C_*(A),
          %p
            whose homology is the
            %em Hochschild homology
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h4#centers_and_traces Centers and traces
          %p
            The above constructions can be carried over to algebra objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in a closed symmetric monoidal
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %msup
                      %mi Pr
                      %mi L
                  %annotation{:encoding => "application/x-tex"} C=Pr^{L}
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We define the
            %em categorical center
            to be the endomorphism object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi End
                    %mrow
                      %mi A
                      %mo ⊗
                      %msup
                        %mi A
                        %mi op
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi Pr
                    %mi L
                  %mo ,
                %annotation{:encoding => "application/x-tex"} End_{A \otimes A^{op}}(A) \in Pr^{L},
          %p
            where we consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            as module-category over itself on the left and on the right and we compute the internal
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                %annotation{:encoding => "application/x-tex"} Hom
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Pr^{L}
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with itself as bimodule.
          %p
            Also we define the
            %em categorical trace
            to the the pairing object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo ⊗
                    %mrow
                      %mi A
                      %mo ⊗
                      %msup
                        %mi A
                        %mi op
                  %mi A
                %annotation{:encoding => "application/x-tex"} A \otimes_{A \otimes A^{op}} A
          %p
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with itself as a bimodule, using the tensor product in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Pr
                    %mi L
                %annotation{:encoding => "application/x-tex"} Pr^{L}
            and then coequalizing the left and right actions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            on itself to form the relative tensor product.
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/span+trace"} span trace
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/co-span+co-trace"} co-span co-trace
          %h4#centers_of_convolution_categories Centers of convolution categories
          %h4#higher_centers higher centers
          %h3#epilogue_topological_field_theory epilogue: topological field theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/FQFT"} FQFT
          %h4#topological_field_theory_from_perfect_stacks topological field theory from perfect stacks
          %ul
            %li
              %span.newWikiWord
                ∞-model
                %a{:href => "/nlab/new/%E2%88%9E-model"} ?
          %h4#delignekontsevich_conjectures_for_derived_centers Deligne-Kontsevich conjectures for derived centers
          %h2#character_quantum_field_theory Character Quantum Field Theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ringed+site"} ringed site
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/D-module"} D-module
          %h3#and_so_on and so on
          %h1#background_literature Background literature
          %p
            For the general
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category"} (∞,1)-categorical
            formalism
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p
            For the
            %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-category"} stable
            aspects
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Stable+%E2%88%9E-Categories"} Stable ∞-Categories
          %p
            For the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+%28infinity%2C1%29-category"} monoidal
            aspects
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} Noncommutative and commutative algebra
          %p For the general TQFT background and in particular see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em On the classification of TFT
              (
              %a{:href => "http://www.math.harvard.edu/~lurie/papers/cobordism.pdf"}> pdf
              )
          %p
            In particular see also the beginning of section 4.1 there for more on
            = succeed "-monoidal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                  %annotation{:encoding => "application/x-tex"} E_n
            = succeed "-categories." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            For more details on
            %a.existingWikiWord{:href => "/nlab/show/loop+space+objects"} loop space objects
            for
            %a.existingWikiWord{:href => "/nlab/show/derived+stacks"} derived stacks
          %ul
            %li
              %strong LoopSpace
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"} David Ben-Zvi
              %em Loop Spaces and Langlands Parameters
              (
              %a{:href => "http://arxiv.org/abs/0706.0322"}> arXiv
              )
          %p
            %a.existingWikiWord{:href => "/nlab/show/John+Francis"}> John Francis
            ‘ work on actions of the
            %a.existingWikiWord{:href => "/nlab/show/little+k-cubes+operad"} little k-cubes operad
            on
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li
              %strong EnAction
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Francis"} John Francis
              = succeed ")" do
                %a{:href => "http://dspace.mit.edu/handle/1721.1/43792"} web
          %p
            For more related material see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Northwestern+TFT+Conference+2009"} Northwestern TFT Conference 2009
