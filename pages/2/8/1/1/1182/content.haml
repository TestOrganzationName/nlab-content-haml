          %p of finite-dimensional vector spaces.
          %p
            In geometric
            = succeed "-function" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
