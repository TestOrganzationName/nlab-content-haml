                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi f
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi Δ
                    %mi x
                  %annotation{:encoding => "application/x-tex"} f(x) + f'(x) \Delta x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi f
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi Δ
                  %mi x
                  %mo +
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mi Δ
                  %mi x
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mi Δ
                  %mi x
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 2
                  %mi f
                  %mo ′
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mi x
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mo .
                %annotation{:encoding => "application/x-tex"} \frac{1}{2}(f(x) + f'(x)\Delta x + f(x))\Delta x = f(x) \Delta x + \frac{1}{2} f'(x) (\Delta x)^2.
          %p
            This would lead us to integrate the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
