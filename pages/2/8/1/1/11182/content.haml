                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mstyle{:mathvariant => "bold"}
                          %mi x
                        %mo ∈
                        %msub
                          %mi T
                          %mstyle{:mathvariant => "bold"}
                            %mi x
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \mathrm{d}\mathbf{x}\in T_{\mathbf{x}}X
                  the function
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                        %mi h
                        %mo .
                        %mi ω
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
