                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi Δ
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mi Δ
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \frac{1}{2}(f(x+\Delta x) + f(x))\Delta x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is differentiable, we can approximate
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi Δ
                  %mi x
                  %mo{:stretchy => "false"} )
