              over any differentiable curve exists.
          .proof
            %h6#proof_2 Proof
            %p The Riemann sums in the definition of the genuine integral simplify in the case of a 1-cojet form to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 1
                      %mn ∞
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Δ
                    %msub
                      %mi t
                      %mi i
                    %mo ⋅
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \sum_{n=1}^\infty \omega(c(t^*_i), \Delta t_i \cdot c'(t^*_i)).
            %p
              Note that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %msub
                      %mi t
                      %mi i
                    %mo =
                    %msub
                      %mi t
                      %mi i
                    %mo −
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \Delta t_i = t_i - t_{i-1}
              is always positive. By the assumptions, for any positive
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              we can write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi x
                    %mo ,
                    %mi h
                    %mo ⋅
                    %mi{:mathvariant => "normal"} d
                    %mstyle{:mathvariant => "bold"}
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi x
                    %mo ,
                    %mi{:mathvariant => "normal"} d
                    %mstyle{:mathvariant => "bold"}
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi h
                    %mo +
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi x
                    %mo ,
                    %mi{:mathvariant => "normal"} d
                    %mstyle{:mathvariant => "bold"}
                      %mi x
                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi h
                  %annotation{:encoding => "application/x-tex"} \omega(\mathbf{x}, h\cdot \mathrm{d}\mathbf{x}) = f(\mathbf{x}, \mathrm{d}\mathbf{x})\, h + g(\mathbf{x}, \mathrm{d}\mathbf{x},h)\,h
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is continuous and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mrow
                          %mi h
                          %mo →
                          %mn 0
