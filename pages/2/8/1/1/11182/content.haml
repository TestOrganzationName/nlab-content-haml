                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{i=1}^n \omega(c(t^*_i), \Delta c_i)
          %p
            where
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %msub
                      %mi c
                      %mi i
                    %mo =
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta c_i = c(t_i) - c(t_{i-1})
            = succeed "." do
              %strong affine integral
          %p
            Note that this Riemann sum manifestly depends only on the points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi t
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c(t_i)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi t
                    %mi i
                    %mo *
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c(t^*_i)
            (and the order in which they occur). Thus, any increasing bijection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ′
                  %mo ,
                  %mi b
                  %mo ′
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \phi:[a',b'] \to [a,b]
            induces a bijection between tagged partitions which respects their Riemann sums. It also maps intervals to intervals, so any gauge on one interval induces one on the other interval. Thus the limits also coincide (in the strong sense that one exists if and only if the other does, and in that case they are equal), and so the affine integral is completely parametrization-independent.
          %p We now show that the affine integral agrees with the genuine integral.
          .un_theorem
            %h6#theorem_4 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is a tangent-Lipschitz 1-cojet form on an open subset of an affine space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .proof
            %h6#proof_3 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} c:[a,b]\to X
              be differentiable. Then by definition of differentiability, for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mn 1
                    %mo &lt;
                    %msup
                      %mi t
                      %mo *
                    %mo &lt;
                    %msub
                      %mi t
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} t_1 \lt t^*\lt t_2
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [a,b]
              we can write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi t
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 2
                    %mo −
                    %msub
                      %mi t
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi t
                      %mo *
                    %mo ,
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mn 2
                    %mo −
                    %msub
                      %mi t
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(t_2) - c(t_1) - c'(t^*)(t_2-t_1) = g(t^*,t_1,t_2)(t_2-t_1)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi t
                      %mo *
                    %mo ,
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g(t^*,t_1,t_2) \to 0
              as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi t
                        %mn 2
                      %mo −
                      %msub
                        %mi t
                        %mn 1
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} t_2-t_1 \to 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is tangent-Lipschitz, for any tagged partition we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi t
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Δ
                      %msub
                        %mi c
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi t
                        %mi i
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Δ
                      %msub
                        %mi t
                        %mi i
                      %mo ⋅
                      %mi c
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi t
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %mo &lt;
                    %mi L
                    %mo{:stretchy => "false"} ‖
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi t
                      %mo *
                    %mo ,
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ‖
                    %mo ⋅
                    %mi Δ
                    %msub
                      %mi t
                      %mi i
                    %mo .
                  %annotation{:encoding => "application/x-tex"} {|\omega(c(t^*_i), \Delta c_i) - \omega(c(t^*_i),\Delta t_i \cdot c'(t^*))|} \lt L \Vert g(t^*,t_1,t_2) \Vert \cdot \Delta t_i.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi t
                      %mo *
                    %mo ,
                    %msub
                      %mi t
                      %mn 1
                    %mo ,
                    %msub
                      %mi t
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} g(t^*,t_1,t_2) \to 0
              as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi t
                        %mn 2
                      %mo −
                      %msub
                        %mi t
                        %mn 1
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} t_2-t_1 \to 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi o
                    %mo{:stretchy => "false"} (
                    %mi dx
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} o(dx)
              forms. But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Δ
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega(c(t^*_i), \Delta c_i)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Δ
                    %msub
                      %mi t
                      %mi i
                    %mo ⋅
                    %mi c
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi t
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega(c(t^*_i),\Delta t_i \cdot c'(t^*))
              are exactly the terms in the Riemann sums for the affine and genuine integrals.
          %p Finally, a similar argument shows that the affine integral can be extended to all finite-dimensional smooth manifolds by local charts.
          .un_theorem
            %h6#theorem_5 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U\subseteq X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ⊆
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} V\subseteq Y
              be open subsets of affine spaces and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi U
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \phi:U\to V
              be differentiable. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              be a tangent-Lipschitz 1-cojet form on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi U
                  %annotation{:encoding => "application/x-tex"} c:[0,1]\to U
              a differentiable curve. Then for the affine integrals we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi c
                    %msup
                      %mi ϕ
                      %mo *
                    %mi ω
                    %mo =
                    %msub
                      %mo ∫
                      %mrow
                        %mi ϕ
                        %mi c
                    %mi ω
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \int_c \phi^*\omega = \int_{\phi c} \omega.
          .proof
            %h6#proof_4 Proof
            %p
              By definition,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ϕ
                        %mo *
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ω
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi d
                        %mi x
                      %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \phi^*\omega(x,v) = \omega(\phi(x),d_x\phi(v))
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi d
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi t
                          %mi i
                          %mo *
                        %mo{:stretchy => "false"} )
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \sum_i \omega(\phi(c(t^*_i)),d_{c(t^*_i)}\phi(\Delta c_i)).
            %p while the RHS is a limit of sums of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mi c
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \sum_i \omega(\phi(c(t^*_i)),\Delta (\phi c)_i).
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is differentiable, for any point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c(t^*_i)
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mi c
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo =
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi t
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi d
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi t
                          %mi i
                          %mo *
                        %mo{:stretchy => "false"} )
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo +
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Δ
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi Δ
                      %msub
                        %mi c
                        %mi i
                      %mo{:stretchy => "false"} ‖
                  %annotation{:encoding => "application/x-tex"} \Delta (\phi c)_i = \phi(c(t_{i})) - \phi(c(t_{i-1})) = d_{c(t^*_i)}\phi(\Delta c_i) + E(c(t^*_i),\Delta c_i)\cdot {\Vert \Delta c_i \Vert }
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Δ
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} E(c(t^*_i),\Delta c_i)\to 0
              as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi t
                        %mi i
                      %mo −
                      %msub
                        %mi t
                        %mrow
                          %mi i
                          %mo −
                          %mn 1
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} t_i - t_{i-1} \to 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
              is tangent-Lipschitz, this gives
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ‖
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Δ
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mi c
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi d
                      %mrow
                        %mi c
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi t
                          %mi i
                          %mo *
                        %mo{:stretchy => "false"} )
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} ‖
                    %mo &lt;
                    %mi L
                    %mo ⋅
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi t
                      %mi i
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Δ
                    %msub
                      %mi c
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi Δ
                      %msub
                        %mi c
                        %mi i
                      %mo{:stretchy => "false"} ‖
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \Big\Vert \omega(\phi(c(t^*_i)),\Delta (\phi c)_i) - \omega(\phi(c(t^*_i)),d_{c(t^*_i)}\phi(\Delta c_i)) \Big\Vert \lt L \cdot E(c(t^*_i),\Delta c_i) \cdot {\Vert \Delta c_i \Vert }.
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              depend on the point chosen, but nevertheless, we can choose gauges as before to make this term vanish in the limit. Thus, the two integrals agree.
          %h3#stieltjes_integrals_functions_and_distributions
            Stieltjes integrals,
            = succeed "-functions," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
          %p
            An alternative approach to proving FTC would be to observe that essentially by definition of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi{:mathvariant => "normal"} d
                  %mi f
                %annotation{:encoding => "application/x-tex"} f(x+\mathrm{d}x) - f(x) - \mathrm{d}f
          %p
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi o
                    %mo{:stretchy => "false"} (
                    %mi dx
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} o(dx)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi c
                  %mi{:mathvariant => "normal"} d
                  %mi f
                  %mo =
                  %msub
                    %mo ∫
                    %mi c
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int_c \mathrm{d}f = \int_c (f(x+\mathrm{d}x)-f(x))
            if either exists. If the latter integral can be calculated using only partitions tagged by their left endpoint, then it is obviously
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(c(b))-f(c(a))
            — but it is not clear that such partitions suffice.
          %p
            In the list of examples above, we denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo +
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x+\mathrm{d}x)-f(x)
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mi f
                  %annotation{:encoding => "application/x-tex"} \Delta f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mi f
                %annotation{:encoding => "application/x-tex"} \Delta f
            (perhaps multiplied by another function
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
            = succeed "." do
              %span.newWikiWord
                Stieltjes integration
                %a{:href => "/nlab/new/Stieltjes+integration"} ?
          %p
            We can, at least, show that the second definition of the
            %a.existingWikiWord{:href => "/nlab/show/Dirac+delta+function"} Dirac delta function
            has its expected properties. Recall that this was
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable{:columnalign => "left left", :displaystyle => "false"}
                        %mtr
                          %mtd
                            %mfrac
                              %mn 1
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mi{:mathvariant => "normal"} d
                                %mi x
                                %mo{:stretchy => "false"} |
                          %mtd
                            %mspace{:width => "2em"}
                            %mi x
                            %mo =
                            %mn 0
                            %mspace{:width => "thickmathspace"}
                            %mi and
                            %mspace{:width => "thickmathspace"}
                            %mi{:mathvariant => "normal"} d
                            %mi x
                            %mo ≠
                            %mn 0
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mspace{:width => "2em"}
                            %mi otherwise
                            %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\delta =
                  \\begin{cases}
                  \\frac{1}{|\mathrm{d}x|} &amp;\qquad x=0 \;and\; \mathrm{d}x\neq 0\\
                  0 &amp;\qquad otherwise.
                  \\end{cases}
          .un_theorem
            %h6#theorem_6 Theorem
            %p
              For any function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi ℝ
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} f:\mathbb{R}\to \mathbb{R}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ≤
                    %mn 0
                    %mo ≤
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a\le 0 \le b
              then we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mi a
                      %mi b
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi δ
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi x
                    %mo =
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int_a^b f(x)\, \delta \,\mathrm{d}x = f(0)
              for the affine integral.
          .proof
            %h6#proof_5 Proof
            %p
              We define a gauge, denoted
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              (since the letter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              is already in use) as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mrow
                        %mtable{:columnalign => "left left", :displaystyle => "false"}
                          %mtr
                            %mtd
                              %mn ∞
                            %mtd
                              %mspace{:width => "2em"}
                              %mi x
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mi x
                                %mo{:stretchy => "false"} |
                            %mtd
                              %mspace{:width => "2em"}
                              %mi x
                              %mo ≠
                              %mn 0
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta(x) =
                    \\begin{cases}
                    \\infty &amp;\qquad x=0\\
                    {|x|} &amp;\qquad x\neq 0.
                    \\end{cases}
            %p
              Then in any
              = succeed "-fine" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              must be the tag of the subinterval containing it. Therefore, the Riemann sum of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi δ
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi x
                  %annotation{:encoding => "application/x-tex"} f(x)\, \delta \,\mathrm{d}x
              over any such tagged partition is simply
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi{:mathvariant => "normal"} d
                        %mi x
                        %mo{:stretchy => "false"} |
                    %mi{:mathvariant => "normal"} d
                    %mi x
                  %annotation{:encoding => "application/x-tex"} f(0) \frac{1}{|\mathrm{d}x|} \mathrm{d}x
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}x
              is the width of the subinterval containing
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(0)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(0)
          %p
            One might instead define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            to be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x=0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi δ
                %annotation{:encoding => "application/x-tex"} f(x)\, \delta
            rather than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi δ
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi x
                  %annotation{:encoding => "application/x-tex"} f(x) \,\delta \,\mathrm{d}x
            = succeed "\u201D," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∫
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \int f(x)\, \delta(x)\,\mathrm{d}x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            is a function of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi x
                %annotation{:encoding => "application/x-tex"} \mathrm{d}x
            as well as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                %annotation{:encoding => "application/x-tex"} \delta
            the usual scaling and precomposition properties, usually written as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %mi α
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \delta(\alpha x) = \frac{\delta(x)}{|\alpha|}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                  %mfrac
                    %mrow
                      %mi δ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo −
                      %mi c
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi g
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \delta(g(x)) = \sum_{g(c)=0} \frac{\delta(x-c)}{|g'(c)|}
          %p
            In our notation, instead of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta(g(x))
            we would write
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} d
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta(g(x),\mathrm{d}g)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                    %mi g
                    %mo =
                    %mi g
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}g = g'(x)\,\mathrm{d}x
          %p
            Note that
            = succeed "-functions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            %em unoriented
            regions. Since our integrals are oriented, we have to specify that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a,b]
            is traversed left-to-right (as in the notation
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo ∫
                      %mi a
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \int_a^b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(0)
            as the answer; if we integrated
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo ∫
                    %mi b
                    %mi a
                %annotation{:encoding => "application/x-tex"} \int_b^a
            instead we would get
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} -f(0)
          %p
            We can, of course, avoid the minus sign by integrating against
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} |
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \delta\,|\mathrm{d}x|
            instead of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mspace{:width => "thinmathspace"}
                    %mi{:mathvariant => "normal"} d
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \delta \,\mathrm{d}x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
          %p
            Since we have successfully represented the
            = succeed "-distribution" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi ϵ
                %annotation{:encoding => "application/x-tex"} \phi_\epsilon
            are test functions converging to a distribution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                %annotation{:encoding => "application/x-tex"} \theta
            as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon\to 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi{:mathvariant => "normal"} d
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi ϕ
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %mi x
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \theta(x,\mathrm{d}x) = \phi_{\mathrm{d}x}(x)
          %h2#higher_forms Higher forms
          %p
            One can define a
            %strong
              cogerm differential
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            to be a function on germs of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/differential+form"} exterior
            differential
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/absolute+differential+form"} absolute
            differential
            = succeed "-forms." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            There is a sort of “
            %strong> exterior differential
            ” acting from cogerm
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-forms," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (k+1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} d
                  %mo ∧
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathrm{d}\wedge -)
            to avoid confusion with the commutative cogerm differential
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} d
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k=1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi{:mathvariant => "normal"} d
                  %mo ∧
                  %mi ω
                  %mo{:stretchy => "false"} |
                  %mi c
                  %mo{:stretchy => "false"} ⟩
                  %mo =
                  %munder
                    %mi lim
                    %mrow
                      %mi A
                      %mo →
                      %mn 0
                  %mfrac
                    %mn 1
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi A
                      %mo{:stretchy => "false"} ‖
                  %msub
                    %mo ∮
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mi ω
                  %mo .
                %annotation{:encoding => "application/x-tex"} \langle \mathrm{d}\wedge \omega {|} c \rangle = \lim_{A \to 0} \frac{1}{\Vert A \Vert} \oint_{c(\partial A)} \omega.
          %p
            Here the limit is over some neighborhoods
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ∈
                  %msup
                    %mi ℝ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} 0\in\mathbb{R}^2
            whose areas
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ‖
                  %mi A
                  %mo{:stretchy => "false"} ‖
                %annotation{:encoding => "application/x-tex"} \Vert A \Vert
            shrink to zero, and the integral over the boundary is defined as above. The definition for general
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is similar.
          %p
            This limit can only exist if the integral
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∮
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mo ∂
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \oint_{c(\partial A)} \omega
            is invariant under oriented reparametrization of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \partial A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is an absolute form, then usually there will not be enough cancellation to make the limit above finite (it would be analogous to defining a 1-dimensional “derivative” as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi lim
                    %mrow
                      %mi h
                      %mo →
                      %mn 0
                  %mfrac
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo +
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mi h
                %annotation{:encoding => "application/x-tex"} \lim_{h\to 0} \frac{f(x+h)+f(x)}{h}
            rather than
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mrow
                        %mi h
                        %mo →
                        %mn 0
                    %mfrac
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo +
                        %mi h
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi h
                  %annotation{:encoding => "application/x-tex"} \lim_{h\to 0} \frac{f(x+h)-f(x)}{h}
            = succeed "-forms." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %p
            It is unclear whether there is a notion of exterior differential which is significantly more general. Similarly, it is unclear whether the wedge product of exterior forms can be sensibly extended to cogerm ones, or whether there is a sensible commutative cogerm differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                %annotation{:encoding => "application/x-tex"} \mathrm{d}
            acting on cogerm
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo &gt;
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k\gt 1
          %h2#nonsymmetrized_version Nonsymmetrized version
          %p
            More general than cojet forms (but analytic), we have the
            = succeed "," do
              %em coflare differential forms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mn 0
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}_{0}x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mn 1
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}_{1}x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mrow
                        %mn 1
                        %mo ,
                        %mn 0
                    %mi x
                    %mo =
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mn 1
                    %msub
                      %mi{:mathvariant => "normal"} d
                      %mn 0
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{d}_{1,0}x = \mathrm{d}_{1}\mathrm{d}_{0}x
            %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T X
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T (T (T X))
            %a.existingWikiWord{:href => "/nlab/show/exterior+differential+forms"} exterior differential forms
            are included in the calculus of coflare forms, as are nonlinear versions of exterior forms such as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/absolute+differential+forms"} absolute differential forms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            (which we may take to be the default), while the exterior form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mi x
                  %mo ∧
                  %mi{:mathvariant => "normal"} d
                  %mi y
                %annotation{:encoding => "application/x-tex"} \mathrm{d}x \wedge \mathrm{d}y
            is really
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mn 0
                  %mi x
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mn 1
                  %mi y
                  %mo −
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mn 1
                  %mi x
                  %msub
                    %mi{:mathvariant => "normal"} d
                    %mn 0
                  %mi y
                %annotation{:encoding => "application/x-tex"} \mathrm{d}_{0}x \mathrm{d}_{1}y - \mathrm{d}_{1}x \mathrm{d}_{0}y
            (possibly divided by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mo !
                  %annotation{:encoding => "application/x-tex"} 2!
          %p
            A more abstract version of coflare forms (including both cogerm forms and the coflare forms of the previous paragraph) may be based on germs of maps with domain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^p
            instead of only curves (with domain
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^p
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            to
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p - 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is a partial function from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^p
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is the subset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} dom
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \dom \phi
            on which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is (say)
            = succeed "-times" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} D
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                      %mo ,
                      %mi k
                  %mi ϕ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi U
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathrm{D}_{i,j,k}\phi\colon U \to \mathbb{R}
            for the third partial derivative of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            with respect to variable
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            (in any order). Then if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            is a thrice-differentiable function to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            from a neighbourhood of the origin in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a thrice-differentiable function to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            from a neighbourhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c(0)
            in
            = succeed "," do
