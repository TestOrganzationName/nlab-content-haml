                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ab
                      %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet \;\colon\; SeqSpec(sSet) \longrightarrow Ab^{\mathbb{Z}}
                    \\,.
          #StableWeakEquivalenceOfSequentialsSetSpectra.num_defn
            %h6#definition_3 Definition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              = succeed "," do
                %a.maruku-ref{:href => "#SequentialSpectra"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
              = succeed "-functor" do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+group"} stable homotopy group
              %a.maruku-ref{:href => "#StableHomotopyGroups"}
              is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet(f) \;\colon\; \pi_\bullet(X) \longrightarrow \pi_\bullet(Y)
                    \\,.
          %h3#omegaspectra Omega-spectra
          #OmegaSpectrum.num_defn
            %h6#definition_4 Definition
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              is a sequential spectrum
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#SequentialSpectra"}
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibrant+replacement"} Kan fibrant replacement
              the (
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊣
                  %annotation{:encoding => "application/x-tex"} \dashv
              = succeed ")-" do
                %a.existingWikiWord{:href => "/nlab/show/pointed+mapping+space"} pointed mapping space
              %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} |
                    %mover
                      %mo ⟶
                      %mrow
                    %msup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msup
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msup
                          %mi S
                          %mn 1
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    {\vert X_n\vert} \stackrel{}{\longrightarrow} {\vert X^{n+1}\vert}^{{\vert S^1\vert}}
            %p
              of the structure maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi σ
                        %mi n
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} {\vert \sigma_n\vert}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
          #StableHomotopyGroupsOfOmegaSpectrum.num_remark
            %h6#remark Remark
            %p
              If a
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
              = succeed "," do
                %a.maruku-ref{:href => "#OmegaSpectrum"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              = succeed "," do
                %a.maruku-ref{:href => "#StableHomotopyGroups"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo ≃
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi π
                                %mi k
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi X
                                  %mn 0
                                %mo{:stretchy => "false"} |
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi k
                              %mo ≥
                              %mn 0
                          %mtr
                            %mtd
                              %msub
                                %mi π
                                %mn 0
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msub
                                  %mi X
                                  %mi k
                                %mo{:stretchy => "false"} |
                            %mtd
                              %mi if
                              %mspace{:width => "thickmathspace"}
                              %mi k
                              %mo &lt;
                              %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_k(X) \simeq
                    \\simeq
                    \\left\{
                    \\array{
                    \\pi_k {\vert X_0 \vert} &amp; if\; k \geq 0
                    \\\
                    \\pi_0 {\vert X_k \vert} &amp; if \; k \lt 0
                    }
                    \\right.
                    \\,.
          #Spectrification.num_defn
            %h6#definition_5 Definition
            %p
              The canonical
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi Ω
                    %annotation{:encoding => "application/x-tex"} \Omega
                \-
                %a.existingWikiWord{:href => "/nlab/show/spectrification"} spectrification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Q X
              of a
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
