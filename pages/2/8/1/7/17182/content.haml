              %strong
                %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential spectrum
              for short (or even just
              %strong
                %a.existingWikiWord{:href => "/nlab/show/spectrum"}> spectrum
                ), is
            %ul
              %li
                %p
                  an
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} \mathbb{N}
                  %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
                  %a.existingWikiWord{:href => "/nlab/show/pointed+simplicial+set"} pointed simplicial set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mo •
                      %annotation{:encoding => "application/x-tex"} X_\bullet
              %li
                %p
                  equipped with morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi n
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mo →
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \sigma_n \colon S^1 \wedge X_n \to X_{n+1}
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              of spectra is a sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet \colon X_\bullet \to Y_\bullet
              of homomorphisms of pointed simplicial sets, such that all
              %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msup
                                  %mi S
                                  %mn 1
                                %mo ∧
                                %msub
                                  %mi f
                                  %mi n
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi Y
                              %mi n
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi σ
                                    %mi n
                                    %mi X
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msubsup
                                    %mi σ
                                    %mi n
                                    %mi Y
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi f
                                  %mrow
                                    %mi n
                                    %mo +
                                    %mn 1
                          %mtd
                            %msub
                              %mi Y
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \wedge X_n &amp;\stackrel{S^1 \wedge f_n}{\longrightarrow}&amp; S^1 \wedge Y_n
                    \\\
                    \\downarrow^{\mathrlap{\sigma_n^X}} &amp;&amp; \downarrow^{\mathrlap{\sigma_n^Y}}
                    \\\
                    X_{n+1} &amp;\stackrel{f_{n+1}}{\longrightarrow}&amp; Y_{n+1}
                    }
            %p
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commute
              \.
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SeqSpec(sSet)
              for this
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of sequential spectra.
          #SmashProductOfSpectrumWithSimplicialSet.num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X \in SeqSpec(sSet)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} K \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mo +
                    %mo ∈
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} K_+ \in sSet^{\ast/}
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                  %annotation{:encoding => "application/x-tex"} X \wedge K_+
              is the sequential spectrum degreewise given by the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of pointed objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (X \wedge K_+)_n \coloneqq (X_n \wedge K_+)
            %p and with structure maps given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi n
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi X
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi σ
                          %mi n
                        %mo ∧
                        %msub
                          %mi K
                          %mo +
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo ∧
                    %msub
                      %mi K
                      %mo +
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^1 \wedge (X_n \wedge K_+) \simeq (S^1 \wedge X_n) \wedge K_+ \stackrel{\sigma_n \wedge K_+}{\longrightarrow} X_{n+1}\wedge K_+
                    \\,.
          #SimplicialEnrichment.num_prop
            %h6#proposition Proposition
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpec
                  %annotation{:encoding => "application/x-tex"} SeqSpec
              of def.
              %a.maruku-ref{:href => "#SequentialSpectra"}
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
              (in fact an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi sSet
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} sSet^{\ast/}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              %a.existingWikiWord{:href => "/nlab/show/hom+objects"} hom objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} [X,Y]\in sSet
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi n
                    %mo ≔
                    %msub
                      %mi Hom
                      %mrow
                        %mi SeqSpec
                        %mo{:stretchy => "false"} (
                        %mi sSet
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ∧
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo +
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [X,Y]_n \coloneqq Hom_{SeqSpec(sSet)}(X\wedge \Delta[n]_+,Y)
                    \\,.
          #StableHomotopyGroups.num_defn
            %h6#definition_2 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              of a
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential spectrum
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "," do
                %a.maruku-ref{:href => "#SequentialSpectra"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/graded+abelian+groups"} graded abelian groups
              given by the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              of
              %a.existingWikiWord{:href => "/nlab/show/geometric+realizations"} geometric realizations
              of the component spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %msub
                      %munder
                        %mi lim
                        %mo ⟶
                      %mi k
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mrow
                      %mo{:stretchy => "false"} |
                      %msub
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_\bullet(X)
                    \\coloneqq
                    \\underset{\longrightarrow}{\lim}_k
                    \\pi_{\bullet+k}({\vert X_n \vert})
                    \\,.
            %p
              This constitutes a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi SeqSpec
