              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 1
                  %mo ≔
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo ∂
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
