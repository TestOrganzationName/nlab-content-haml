          #PropertiesOfStandardSpectrification.num_prop
            %h6#proposition_2 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/spectrification"} spectrification
              of def.
              %a.maruku-ref{:href => "#Spectrification"}
              satisfies
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Q X
                  is an
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
                  = succeed ";" do
                    %a.maruku-ref{:href => "#OmegaSpectrum"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi η
                          %mi X
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ⟶
                        %mi Q
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \eta_X \colon X \longrightarrow Q X
                  is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
                  = succeed ";" do
                    %a.maruku-ref{:href => "#StableWeakEquivalenceOfSequentialsSetSpectra"}
              %li
                %p
                  if for a homomorphims of sequential spectra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
