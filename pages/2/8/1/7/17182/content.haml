                                %mi Q
                                %mi X
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi n
                            %mtr
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi f
                                        %mi n
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mi Q
                                      %msub
                                        %mi f
                                        %mi n
                            %mtr
                              %mtd
                                %msub
                                  %mi Y
                                  %mi n
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi Q
                                %mi Y
                                %msub
                                  %mo{:stretchy => "false"} )
                                  %mi n
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        X_n &amp;\stackrel{}{\longrightarrow}&amp; (Q X)_n
                        \\\
                        \\downarrow^{\mathrlap{f_n}} &amp;&amp; \downarrow^{\mathrlap{Q f_n}}
                        \\\
                        Y_n &amp;\stackrel{}{\longrightarrow}&amp; (Q Y)_n
                        }
                %p
                  are
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                  squares (with respect to the
                  = succeed ")." do
                    %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
          #StableModelStructureOnSequentialSpectraIsModelCategory.num_prop
            %h6#proposition_4 Proposition
            %p
              The classes of morphisms in def.
              %a.maruku-ref{:href => "#ClassesOfMorphismsOfTheStableModelStructureOnSequentialSpectra"}
              give the structure of a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SeqSpec
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi stable
                    %annotation{:encoding => "application/x-tex"} SeqSpec(sSet)_{stable}
              %strong stable model structure
              on sequential spectra.
            %p Moreover, this is
            %ul
              %li
                %p
                  a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
                  with respect to the simplicial enrichment of prop.
                  = succeed "." do
                    %a.maruku-ref{:href => "#SimplicialEnrichment"}
          %p
            (
            %a{:href => "#BousfieldFriedlander78"}> Bousfield-Friedlander 78, theorem 2.3
            ).
          .proof
            %h6#proof_2 Proof
            %p
              By corollary
              = succeed "," do
                %a.maruku-ref{:href => "#StableWeakHomotopyEquivalencesofSeqsSetSpectraIsDegreewsieWeakHomotopyEquivalencesOfSpectrification"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SeqSpectra
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} SeqSpectra(sSet)_{stable}
              is, if indeed it exists, the
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              of the strict model structure of prop.
              %a.maruku-ref{:href => "#StrictModelStructureOnSequentialPrespectraIsModelCategory"}
              at the morphisms that become weak equivalences under the
              %a.existingWikiWord{:href => "/nlab/show/spectrification"} spectrification
              functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo{:lspace => "verythinmathspace"} :
                      %mi SeqSpectra
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi SeqSpectra
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Q \colon SeqSpectra(sSet) \longrightarrow SeqSpectra(sSet)
              = succeed "." do
                %a.maruku-ref{:href => "#Spectrification"}
              %a.maruku-ref{:href => "#PropertiesOfStandardSpectrification"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              satisfies the conditions of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bousfield-Friedlander+theorem"} Bousfield-Friedlander theorem
          .num_remark
            %h6#remark_2 Remark
            %p
              A spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} X \in SeqSpec(sSet)_{stable}
              is
            %ul
              %li
                %p
                  fibrant precisely if it is an
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Omega-spectrum"} Omega-spectrum
                  = succeed "," do
                    %a.maruku-ref{:href => "#OmegaSpectrum"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi n
                      %annotation{:encoding => "application/x-tex"} X_n
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %li
                %p
                  cofibrant precisely if all the structure maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mo →
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1 \wedge X_n \to X_{n+1}
                  are cofibrations of simplicial sets, i.e.
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
          %h2#properties Properties
          %h3#FibrantAndCofibrantObjects Fibrations and cofibrations
          .num_prop
            %h6#proposition_5 Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectrum"} sequential spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi SeqSpec
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi stable
                  %annotation{:encoding => "application/x-tex"} X\in SeqSpec(sSet)_{stable}
              is cofibrant precisely if all its structure morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^1 \wedge X_n \to X_{n+1}
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
          .proof
            %h6#proof_3 Proof
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \ast \to X
              is a cofibration according to def.
              %a.maruku-ref{:href => "#ClassesOfMorphismsOfTheStrictModelStructureOnSequentialSpectra"}
              (in either the strict or stable model structure, they have the same cofibrations) if
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} X_0
                  is cofibrant; this is no condition in
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %li
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo *
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mo *
                              %mi n
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mo ⟶
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        \\ast_{n+1}\underset{S^1 \wedge \ast_n}{\coprod} S^1 \wedge X_n
                        \\longrightarrow
                        X_{n+1}
                %p
                  is a cofibration. But in this case the
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                  reduces to just its second summand, and so this is now equivalent to
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi X
                          %mi n
                        %mo ⟶
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        S^1 \wedge X_n \longrightarrow X_{n+1}
                %p being cofibrations; hence inclusions.
          %h3#relation_to_sequential_spectra_in__and_to_combinatorial_spectra
            Relation to sequential spectra in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            and to combinatorial spectra
          .num_prop
            %h6#proposition_6 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
              of
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
              relating the Bousfield-Friedlander model structure
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SeqSpec
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi stable
                    %annotation{:encoding => "application/x-tex"} SeqSpec(sSet)_{stable}
              = succeed "," do
                %a.maruku-ref{:href => "#ClassesOfMorphismsOfTheStableModelStructureOnSequentialSpectra"}
              %a.maruku-ref{:href => "#StableModelStructureOnSequentialSpectraIsModelCategory"}
              with standard model structures on
              %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
              in
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+topological+sequential+spectra"} model structure on topological sequential spectra
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+spectra"} combinatorial spectra
          %p
            (
            %a{:href => "#BousfieldFriedlander78"}> Bousfield-Friedlander 78, section 2.5
            ).
          %h3#relation_to_symmetric_spectra Relation to symmetric spectra
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            to the
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+symmetric+spectra"} model structure on symmetric spectra
            (
            %a{:href => "#HoveyShipleySmith00"}> Hovey-Shipley-Smith 00, section 4.3
            ,
            = succeed ")." do
              %a{:href => "#MandellMaySchwedeShipley01"} Mandell-May-Schwede-Shipley 01, theorem 0.1
          %h3#RelationToExcisiveFunctors Relation to excisive functors
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between the Bousfield-Friedlander model structure and a
            %a.existingWikiWord{:href => "/nlab/show/model+structure+for+excisive+functors"} model structure for excisive functors
            (
            %a{:href => "#Lydakis98"}> Lydakis 98
            ).
          #SimplicialSetsPointedAndFinite.num_defn
            %h6#definition_8 Definition
            %p Write
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  of
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi sSet
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} sSet^{\ast/}
                  for the category of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
                  simplicial sets;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi sSet
                          %mi fin
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mo ≃
                        %mi s
                        %mo{:stretchy => "false"} (
                        %mi FinSet
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mo ↪
                        %msup
                          %mi sSet
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} sSet_{fin}^{\ast/}\simeq s(FinSet)^{\ast/} \hookrightarrow sSet^{\ast/}
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                  of
                  %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/finite+sets"} finite sets
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mover
                      %munder
                        %mo ⟶
                        %mi u
                      %mover
                        %mo ⟵
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo +
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    sSet^{\ast/}
                    \\stackrel{\overset{(-)_+}{\longleftarrow}}{\underset{u}{\longrightarrow}}
                    sSet
            %p
              for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free-forgetful+adjunction"} free-forgetful adjunction
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo +
                  %annotation{:encoding => "application/x-tex"} (-)_+
              freely adjoins a base point.
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∧
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ×
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge \colon sSet^{\ast/} \times sSet^{\ast/} \longrightarrow sSet^{\ast/}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi sSet
                        %mi fin
                        %mo *
                    %annotation{:encoding => "application/x-tex"} sSet_{fin}^{\ast}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∧
                    %mi Y
                    %mo ≔
                    %mi cofib
                    %mrow
                      %mo (
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo *
                        %mo{:stretchy => "false"} )
                        %mo ⊔
                        %mo{:stretchy => "false"} (
                        %mo *
                        %mo ,
                        %mi u
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo )
                      %mo ⟶
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi u
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \wedge Y
                    \\coloneqq
                    cofib\left(
                    \\;
                    \\left(\,
                    (u(X),\ast) \sqcup (\ast, u(Y))
                    \\,\right)
                    \\longrightarrow
                    u(X) \times u(Y)
                    \\;
                    \\right)
                    \\,.
            %p
              This gives
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} sSet^{\ast/}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} sSet^{\ast/}_{fin}
              the structure of a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
              and we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ×
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ⟶
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    [-,-]_\ast \;\colon\; (sSet^{\ast/})^{op} \times sSet^{\ast/} \longrightarrow sSet^{\ast/}
            %p
              for the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %a.existingWikiWord{:href => "/nlab/show/function+complex"} function complex
              functor.
          %p
            We regard all the categories in def.
            %a.maruku-ref{:href => "#SimplicialSetsPointedAndFinite"}
            canonically as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+categories"} simplicially enriched categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi sSet
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} sSet^{\ast/}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi sSet
                    %mi fin
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                %annotation{:encoding => "application/x-tex"} sSet^{\ast/}_{fin}
            as
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} sSet^{\ast/}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
          %p
            The category that supports a
            %a.existingWikiWord{:href => "/nlab/show/model+structure+for+excisive+functors"} model structure for excisive functors
            is the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} sSet^{\ast/}
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msubsup
                    %mi sSet
                    %mi fin
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo ,
                  %msup
                    %mi sSet
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  [sSet^{\ast/}_{fin}, sSet^{\ast/}]
                  \\,.
          %p
            (
            %a{:href => "#Lydakis98"}> Lydakis 98, example 3.8, def. 4.4
            )
          %p
            In order to compare this to to
            %a.existingWikiWord{:href => "/nlab/show/sequential+spectra"} sequential spectra
            consider also the following variant.
          #CategoriesOfStandardSpheres.num_defn
            %h6#definition_9 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi S
                      %mi std
                      %mn 1
                    %mo ≔
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msup
                      %mi sSet
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} S^1_{std} \coloneqq \Delta[1]/\partial\Delta[1]\in sSet^{\ast/}
              for the standard minimal pointed simplicial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/1-sphere"} 1-sphere
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi StdSpheres
                    %mo ⟶
                    %msubsup
                      %mi sSet
                      %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
