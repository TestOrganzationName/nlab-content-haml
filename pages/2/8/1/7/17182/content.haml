          %h2#TheStableModelStructure The stable model structure on sequential spectra
          #ClassesOfMorphismsOfTheStableModelStructureOnSequentialSpectra.num_defn
            %h6#definition_7 Definition
            %p
              Say that a homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi X
                      %mo •
                    %mo →
                    %msub
                      %mi Y
                      %mo •
                  %annotation{:encoding => "application/x-tex"} f_\bullet \colon X_\bullet \to Y_\bullet
              in the category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SeqSpec
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SeqSpec(sSet)
              %a.maruku-ref{:href => "#SequentialSpectra"}
              is
            %ul
              %li
                %p
                  a
                  %strong stable weak equivalence
                  if it is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/stable+weak+homotopy+equivalence"} stable weak homotopy equivalence
                  = succeed ";" do
                    %a.maruku-ref{:href => "#StableWeakEquivalenceOfSequentialsSetSpectra"}
              %li
                %p
                  a
                  %strong stable cofibration
                  if the simplicial maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mn 0
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi X
                          %mn 0
                        %mo →
                        %msub
                          %mi Y
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} f_0\colon X_0 \to Y_0
                  as well as all
                  %a.existingWikiWord{:href => "/nlab/show/pushout+products"} pushout products
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mi n
                      %annotation{:encoding => "application/x-tex"} f_n
                  with the structure maps of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                            %mo ∧
                            %msub
                              %mi X
                              %mi n
                        %msup
                          %mi S
                          %mn 1
                        %mo ∧
                        %msub
                          %mi Y
                          %mi n
                        %mo ⟶
                        %msub
                          %mi Y
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"}
                        X_{n+1}\underset{S^1 \wedge X_n}{\coprod} S^1 \wedge Y_n
                        \\longrightarrow
                        Y_{n+1}
                %p
                  are cofibrations of simplicial sets in the
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                  (i.e.:
                  %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
                  of simplicial sets);
              %li
                %p
                  a
                  %strong stable fibration
                  if it is degreewise a fibration of simplicial sets, hence degreewise a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/spectrification"} spectrification
                  = succeed "," do
                    %a.maruku-ref{:href => "#Spectrification"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %msub
                                  %mi X
                                  %mi n
                              %mtd
