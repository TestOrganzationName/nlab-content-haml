                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi f
                                    %mi n
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Y
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi B
                              %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X_n &amp;\stackrel{h_n}{\longrightarrow}&amp; A_n
                    \\\
                    \\downarrow^{\mathrlap{f_n}} &amp;&amp; \downarrow
                    \\\
                    Y_n &amp;\longrightarrow&amp; B_n
                    }
            %p such that all structure maps are respected.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi X
                              %mi n
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi σ
