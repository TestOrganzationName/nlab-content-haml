                %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+free+loop+space"} Sullivan model of free loop space
          %h3#rational_cohomotopy_spaces Rational Cohomotopy spaces
          %p
            We discuss results on the
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+type"} rational homotopy type
            of
            %a.existingWikiWord{:href => "/nlab/show/spaces+of+maps"} spaces of maps
            into an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            %a.existingWikiWord{:href => "/nlab/show/rational+Cohomotopy"} rational Cohomotopy
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cocycle+spaces"} cocycle spaces
          #RationalHomotopyTypeOfMapsNSphereToNsphere.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+type"} rational homotopy type
                of
                %a.existingWikiWord{:href => "/nlab/show/space+of+maps"} space of maps
                from
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                to itself)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              be a
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi S
                      %mi n
                    %mo →
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} f\colon S^n \to S^n
              a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              from the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              to itself. Then the
              %a.existingWikiWord{:href => "/nlab/show/connected+component"} connected component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi f
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msup
                      %mi S
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} Maps_f\big( S^n, S^n\big)
              of the
              %a.existingWikiWord{:href => "/nlab/show/space+of+maps"} space of maps
              which contains this map has the following
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            #eq:RationalHomotopyTypeOfMappingSpacesSnToSn.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Maps
                      %mi f
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msup
                      %mi S
                      %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ≃
                      %mi ℚ
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mi n
                              %mo ×
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi n
                              %mspace{:width => "thinmathspace"}
                              %mtext even
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                              %mi deg
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mo =
                              %mn 0
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mrow
                                  %mn 2
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi n
                              %mspace{:width => "thinmathspace"}
                              %mtext even
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                              %mi deg
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mo ≠
                              %mn 0
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mi n
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi n
                              %mspace{:width => "thinmathspace"}
                              %mtext odd
                  %annotation{:encoding => "application/x-tex"}
                    Maps_f\big( S^n, S^n\big)
                    \\;\simeq_{\mathbb{Q}}\;
                    \\left\{
                    \\array{
                    S^n \times S^{n-1} &amp;\vert&amp; n\,\text{even}\,, deg(f) = 0
                    \\\
                    S^{2n-1} &amp;\vert&amp; n \, \text{even}\,, deg(f) \neq 0
                    \\\
                    S^n &amp;\vert&amp; n\, \text{odd}
                    }
                    \\right.
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} deg(f)
              is the
              %a.existingWikiWord{:href => "/nlab/show/degree+of+a+continuous+function"} degree
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              Moreover, under the canonical morphism expressing the canonical
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of the
              %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(n+1)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo =
                    %mi S
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} S^n = S\big( \mathbb{R}^{n+1}\big)
              (regarded as the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
              in
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi H
                              %mo •
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mi SO
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi H
                              %mo •
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %msub
                              %mi Maps
                              %mrow
                                %mi f
                                %mo =
                                %mi id
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi S
                              %mi n
                            %mo ,
                            %msup
                              %mi S
                              %mi n
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H_\bullet\Big(
                    SO\big( n+ 1 \big)
                    \\Big)
                    \&amp;\longrightarrow&amp;
                    H_\bullet\Big(
                    Maps_{f = id}\big( S^n, S^n  \big)
                    \\Big)
                    }
            %p
              the generator in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi H
                                %mrow
                                  %mn 2
                                  %mi n
                                  %mo +
                                  %mn 1
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mi SO
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi ℚ
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mo ≃
                              %mi ℚ
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi n
                              %mspace{:width => "thinmathspace"}
                              %mtext even
                          %mtr
                            %mtd
                              %msub
                                %mi H
                                %mi n
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mi SO
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo +
                              %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi ℚ
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mo ≃
                              %mi ℚ
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi n
                              %mspace{:width => "thinmathspace"}
                              %mtext odd
                  %annotation{:encoding => "application/x-tex"} \left\{ \array{ H_{2n+1}\big( SO(n+1), \mathbb{Q} \big) \simeq \mathbb{Q} &amp;\vert&amp; n\, \text{even} \\ H_{n}\big( SO(n+1), \mathbb{Q} \big) \simeq \mathbb{Q} &amp;\vert&amp; n\, \text{odd}   }  \right.
              maps to the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
              of the respective
              %a.existingWikiWord{:href => "/nlab/show/spheres"} spheres
              in
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:RationalHomotopyTypeOfMappingSpacesSnToSn"} (1)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero"} zero
          %p
            (
            %a{:href => "#MollerRaussen85"}> Møller-Raussen 85, Example 2.5
            ,
            = succeed ")" do
              %a{:href => "#CohenVoronov05"} Cohen-Voronov 05, Lemma 5.3.5
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+a+spherical+fibration"} Sullivan model of a spherical fibration
            for more on this.
          #RationalCohomologyOfIteratedLoopSpaceOf2kSphere.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational cohomology
                of
                %a.existingWikiWord{:href => "/nlab/show/iterated+loop+space"} iterated loop space
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} 2k-sphere
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ≤
                    %mi D
                    %mo &lt;
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    1 \leq D \lt n = 2k \in \mathbb{N}
            %p
              (hence two
              %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
              %a.existingWikiWord{:href => "/nlab/show/even+number"} even
              and the other required to be smaller than the first) and consider the
              %a.existingWikiWord{:href => "/nlab/show/iterated+loop+space"} D-fold loop space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi D
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Omega^D S^n
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            %p
              Its
              %a.existingWikiWord{:href => "/nlab/show/rational+cohomology"} rational
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              is the
              %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
              %a.existingWikiWord{:href => "/nlab/show/graded-commutative+algebra"} graded-commutative algebra
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
              on one
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mrow
                        %mi n
                        %mo −
                        %mi D
                  %annotation{:encoding => "application/x-tex"} e_{n-D}
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo −
                    %mi D
                  %annotation{:encoding => "application/x-tex"} n - D
              and one generator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mi D
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} a_{2n - D - 1}
              of degree
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                      %mi n
                      %mo −
                      %mi D
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 2n - D - 1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Ω
                      %mi D
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℚ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi ω
                      %mrow
                        %mi n
                        %mo −
                        %mi D
                    %mo ,
                    %msub
                      %mi ω
                      %mrow
                        %mn 2
                        %mi n
                        %mo −
                        %mn 1
                        %mo −
                        %mi D
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet
                    \\big(
                    \\Omega^D S^n
                    ,
                    \\mathbb{Q}
                    \\big)
                    \\;\simeq\;
                    \\mathbb{Q}\big[ \omega_{n - D}, \omega_{2n - 1 - D} \big]
                    \\,.
          %p
            (by
            %a{:href => "Sullivan+model+of+free+loop+space#SullivanModelsOfMapsFromSkToSnFornLargerk"} this Prop.
            at
            = succeed ";" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+based+loop+space"} Sullivan model of based loop space
            = succeed ")" do
              %a{:href => "#KallelSjerve99"} Kallel-Sjerve 99, Prop. 4.10
          %p
            For the edge case
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi D
                  %msup
                    %mi S
                    %mi D
                %annotation{:encoding => "application/x-tex"} \Omega^D S^D
            the above formula does not apply, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mrow
                      %mi D
                      %mo −
                      %mn 1
                  %msup
                    %mi S
                    %mi D
                %annotation{:encoding => "application/x-tex"} \Omega^{D-1} S^D
            is not
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
            (its
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mi D
                        %mo −
                        %mn 1
                    %msup
                      %mi S
                      %mi D
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Ω
                      %mi D
                    %msup
                      %mi S
                      %mi D
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo =
                    %msub
                      %mi π
                      %mi D
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi D
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \pi_1\big( \Omega^{D-1}S^D \big) = \pi_0 \big(\Omega^D S^D\big) = \pi_D(S^D) = \mathbb{Z}
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+group+of+spheres"} stable homotopy group of spheres
          %p But:
          #RationalModelsForBasedMappingSpaceSDToSD.num_example
            %h6#example Example
            %p
              The rational model for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi D
                    %msup
                      %mi S
                      %mi D
                  %annotation{:encoding => "application/x-tex"} \Omega^D S^D
              follows from Prop.
              %a.maruku-ref{:href => "#RationalHomotopyTypeOfMapsNSphereToNsphere"}
              by realizing the pointed mapping space as the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the
              %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
              from the free mapping space:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mi Ω
                                  %mi D
                                %msup
                                  %mi S
                                  %mi D
                                %mo ≃
                                %mspace{:width => "thickmathspace"}
                            %msup
                              %mi Maps
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                                %mspace{:width => "negativethinmathspace"}
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msup
                              %mi S
                              %mi D
                            %mo ,
                            %msup
                              %mi S
                              %mi D
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi fib
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi ev
                                    %mo *
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Maps
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mi D
                            %mo ,
                            %msup
                              %mi S
                              %mi D
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi ev
                                    %mo *
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mi D
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathllap{
