                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+a+finite+G-quotient"} Sullivan model of a finite G-quotient
          %h2#references References
          %h3#ReferencesSullivanModelsForMappingSpaces General
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+models"} Sullivan models
            and models via
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spaces+of+maps"} spaces of maps
          %ul
            %li
              %p
                Samuel Bruce Smith,
                = succeed "," do
                  %em Rational evaluation subgroups
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BF02622121"} doi:10.1007/BF02622121
            %li
              %p
                Gregory Lupton, Samuel Bruce Smith,
                %em Rationalized Evaluation Subgroups of a Map and the Rationalized G-Sequence
                (
                %a{:href => "https://arxiv.org/abs/math/0309432"}> arXiv:math/0309432
                )
            %li#CohenVoronov05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ralph+Cohen"}> Ralph Cohen
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Voronov"} Alexander Voronov
                %em Notes on string topology
                (
                %a{:href => "https://arxiv.org/abs/math/0503625"}> arXiv:math/0503625
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urtzi+Buijs"}> Urtzi Buijs
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Aniceto+Murillo"} Aniceto Murillo
                = succeed "," do
                  %em Basic constructions in rational homotopy theory of function spaces
                = succeed ")" do
                  %a{:href => "https://doi.org/10.5802/aif.2201"} doi:10.5802/aif.2201
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Micheline+Vigu%C3%A9-Poirrier"}> Micheline Vigué-Poirrier
                ,
                = succeed "," do
                  %em Rational formality of function spaces
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0706.2977"} arXiv:0706.2977
            %li
              %p
                Gregory Lupton, Samuel Bruce Smithm,
                = succeed "," do
                  %em
                    Rationalized evaluation subgroups of a map I: Sullivan models, derivations and
                    = succeed "-sequences" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi G
                          %annotation{:encoding => "application/x-tex"} G
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/j.jpaa.2006.05.018"} doi:10.1016/j.jpaa.2006.05.018
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Urtzi+Buijs"}> Urtzi Buijs
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Aniceto+Murillo"} Aniceto Murillo
                = succeed "," do
                  %em The rational homotopy Lie algebra of function spaces
                = succeed ")" do
                  %a{:href => "https://pdfs.semanticscholar.org/d404/657ccc24b0c06434086485d3e528e0316e26.pdf"} pdf
            %li
              %p
                Gregory Lupton, Samuel Bruce Smith,
                = succeed "," do
                  %em Whitehead products in function spaces: Quillen model formulae
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/0812.1829"} arXiv:0812.1829
                = succeed ")" do
                  %a{:href => "https://projecteuclid.org/euclid.jmsj/1265380424"} euclid:jmsj/1265380424
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrey+Lazarev"}> Andrey Lazarev
                ,
                = succeed "," do
                  %em Maurer-Cartan moduli and models for function spaces
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1109.3715"} arxiv:1109.3715
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2012.11.009"} doi:10.1016/j.aim.2012.11.009
            %li
              %p
                J.-B. Gatsinzi,
                = succeed "," do
                  %em A model for function spaces
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1016/j.topol.2014.02.021"} doi:10.1016/j.topol.2014.02.021
            %li
              %p
                J.-B. Gatsinzi,
                = succeed "," do
                  %em Rational Gottlieb Group of Function Spacesof Maps into an Even Sphere
