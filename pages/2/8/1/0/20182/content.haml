          %h2#idea Idea
          %p
            Given two
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            one may ask for the
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy type
            of their
            %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Maps
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Maps(X,Y)
            %a.existingWikiWord{:href => "/nlab/show/nilpotent+space"} nilpotent space
            of
            %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            and hence admits a
            %a.existingWikiWord{:href => "/nlab/show/Sullivan+model"} Sullivan model
            from which its rationalized
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            and its rational
            %a.existingWikiWord{:href => "/nlab/show/cohomology+groups"} cohomology groups
            may be read off.
