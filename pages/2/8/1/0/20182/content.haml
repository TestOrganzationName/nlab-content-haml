              in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+an+n-sphere"} Sullivan model of an n-sphere
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+a+spherical+fibration"} Sullivan model of a spherical fibration
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Sullivan+model+of+complex+projective+space"} Sullivan model of complex projective space
              %li
