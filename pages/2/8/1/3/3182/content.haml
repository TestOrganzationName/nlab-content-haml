                      %mi Δ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %mi Δ
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Quillen
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    \\int^\Delta (-) \cdot (-) :
                    [\Delta, sSet_{Quillen}]_{proj} \times
                    [\Delta^{op}, [C^{op}, sSet]_{proj}]_{inj}
                    \\to
                    [C^{op}, sSet]_{proj}
            %p
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mi Δ
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int^\Delta \mathbf{\Delta} \cdot (-)
              is left Quillen and hence preserves weak equivalences between cofibrant objects (by the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Sing
                      %mi U
                      %mover
                        %mo →
                        %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \mathbf{Sing}U \stackrel{\simeq}{\to} *
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi k
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mstyle{:mathvariant => "bold"}
                              %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 0
                                  %mo ,
                                  %mi ⋯
                                  %mo ,
                                  %msub
                                    %mi i
