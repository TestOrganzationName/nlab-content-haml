                                  %mo ,
                                  %msub
                                    %mi i
                                    %mi n
                              %mo )
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi k
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mstyle{:mathvariant => "bold"}
                              %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %mrow
                              %mo (
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mrow
                                  %msub
                                    %mi i
                                    %mn 0
                                  %mo ,
                                  %mi ⋯
                                  %mo ,
                                  %msub
                                    %mi i
                                    %mi n
                              %mo *
                              %mo )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mo ≃
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Sing
                            %mi U
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\int^{[k] \in \Delta}
                    \\mathbf{\Delta}[k] \cdot
                    \\left(
                    \\coprod_{i_0, \cdots, i_n} \mathbf{Sing} U_{i_0, \cdots, i_n}
                    \\right)
                    \&amp;\stackrel{\simeq}{\to}&amp;
                    \\int^{[k] \in \Delta}
                    \\mathbf{\Delta}[k] \cdot
                    \\left(
                    \\coprod_{i_0, \cdots, i_n} *
                    \\right)
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\simeq}
                    \\\
                    \\mathbf{Sing}U &amp;\stackrel{\simeq}{\to}&amp; *
                    }
                    \\,,
            %p
              with weak equivalences in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              as indicated: the top morphism is a weak equivalence by the argument just given, the bottom one by the
              = succeed "-construction" do
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              and the right vertical morphism is a weak equivalence by the assumption on an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+site"} ∞-connected site
            %p
              This establishes the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              is left Quillen on the local model structure on simplicial presheaves. By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
              this implies that its left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              is a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi U
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing} U \simeq *
              does coindice with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \Pi(U) \simeq *
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
          .un_corollary
            %h6#corollary_2 Corollary
            %p
              For all cofibrant
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} X \in [C^{op}, sSet]_{proj,loc}
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+(infinity%2C1)-topos#deRhamCohomology"} de Rham coefficient object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{dR} X
              is presented by the ordinary
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi Sing
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mstyle{:mathvariant => "bold"}
                                %mi Π
                              %mi dR
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp;\to&amp; *
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{Sing}X &amp;\to&amp; \mathbf{\Pi}_{dR} X
                    }
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
          .proof
            %h6#proof_14 Proof
            %p
              By definition we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi dR
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_{dR}
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pushout"} (∞,1)-pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi X
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X) \coprod_X *
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(C)
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              the ordinary pushout of that diagram does compute the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
          %h2#homotopy_localization Homotopy localization
          %p
            We discuss that the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+localization"} homotopy localization
            of topological
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ≃
                %annotation{:encoding => "application/x-tex"} \simeq
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            = succeed ")." do
              %a{:href => "#Dugger"} Dugger
          %h3#idea_2 Idea
          %p
            A central result about the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(Top)
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            is that the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+localization"} homotopy localization
            is equivalent to
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            itself
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Sh
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi Top
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi I
                  %mo ≃
                  %mi Top
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Sh_{(\infty,1)}(Top)^I \simeq Top
                  \\,.
          %p
            A discussion of this is in (the nice but not quite finished) (
            %a{:href => "#Dugger"}> Dugger
            ).
          %p
            In fact, this is true even for
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+%E2%88%9E-groupoid"} Lie ∞-groupoid
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
          %p
            This provides a useful resolution of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/locale"} locale
          %h3#details Details
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SPSh
                  %mo{:stretchy => "false"} (
                  %mi Diff
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi loc
                %annotation{:encoding => "application/x-tex"} SPSh(Diff)^{loc}
            be the local
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            obtained by left
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localization
            at the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/Cech+cover"} Cech cover
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topology"} Grothendieck topology
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
            %a.existingWikiWord{:href => "/nlab/show/models+for+%E2%88%9E-stack+%28%E2%88%9E%2C1%29-toposes"} model for ∞-stacks
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SPSh
                  %mo{:stretchy => "false"} (
                  %mi Diff
                  %msubsup
                    %mo{:stretchy => "false"} )
                    %mi I
                    %mi loc
                %annotation{:encoding => "application/x-tex"} SPSh(Diff)^{loc}_I
            be furthermore the left
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} Bousfield localization
            at the set of projection morphisms out of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi ℝ
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} X \times \mathbb{R} \to X
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Diff
                  %annotation{:encoding => "application/x-tex"} X \in Diff
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
            %em homotopy invariant
            = succeed "-stacks," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            of homotopy invariant
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Diff
                  %annotation{:encoding => "application/x-tex"} Diff
          %p
            There is a
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %mi SSet
                  %mover
                    %mo →
                    %mo ←
                  %mi SPSh
                  %mo{:stretchy => "false"} (
                  %mi Diff
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi R
                %annotation{:encoding => "application/x-tex"}
                  L : SSet \stackrel{\leftarrow}{\to} SPSh(Diff) : R
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            sends a simplicial set to the simplicial presheaf constant on that simplicial set, and where evaluates a simplicial presheaf on the manifold that is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point"} point
          .un_theorem
            %h6#theorem_dugger Theorem (Dugger)
            %p
              This adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi L
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (L \dashv R)
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              with respect to the standard
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
              on the left and the above model structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SPSh
                    %mo{:stretchy => "false"} (
                    %mi Diff
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi loc
                      %mi I
                  %annotation{:encoding => "application/x-tex"} SPSh(Diff)_{loc}^I
              on the right.
