              and since the above is an evaluation of the left
              %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
