                    H^1_{ETop}(X,G) := \pi_0 ETop\infty Grpd (X, \mathbf{B}G)
            %p
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ⋯
                        %mo ≃
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi Mfd
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi G
                        %mi Bund
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msub
                          %mi π
                          %mn 0
                        %mi G
                        %mi Bund
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \cdots \simeq \pi_0 [Mfd^{op}, sSet](X, G Bund) \simeq \pi_0 G Bund(X)
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ⋯
                        %mo ≃
                        %msub
                          %mi π
                          %mn 0
                        %mo{:stretchy => "false"} [
                        %msubsup
                          %mi CartSp
                          %mi top
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mover
                          %mi W
                          %mo{:stretchy => "false"} ¯
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msubsup
                          %mi H
                          %mi Ch
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \cdots \simeq \pi_0 [CartSp_{top}^{op}, sSet](C(\{U_i\}), \bar W G) \simeq H^1_{Ch}(X,G)
                  \.
            %p
              In the first case we need to construct the fibrant replacement
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi Bund
                    %annotation{:encoding => "application/x-tex"} G Bund
              = succeed "-cocycles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-bundles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %em all
              manifolds and then evaluate on the given one,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-Yoneda+lemma"} 2-Yoneda lemma
            %p
              In the second case however we cofibrantly replace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              by a good open cover, and then find the
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycles
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on that.
            %p
              For ordinary
              = succeed "-bundles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-bundles" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stackification"} ∞-stackification
              to the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
              of all
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          %h2#structures_in_the_cohesive_topos_
            Structures in the cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ETop
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
          %p
            We discuss what some of the general abstract
            %a{:href => "http://ncatlab.org/nlab/show/cohesive+(infinity%2C1)-topos#Structures"} Structures in a cohesive (∞,1)-topos
            look like in the model
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
          %p As usual, write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Π
                  %mo ⊣
                  %mi Disc
                  %mo ⊣
                  %mi Γ
                  %mo ⊣
                  %mi coDisc
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ETop
                  %mn ∞
                  %mi Grpd
                  %mover
                    %mover
                      %mover
                        %munder
                          %mo ←
                          %mi coDisc
                        %mover
                          %mo →
                          %mi Γ
                      %mover
                        %mo ←
                        %mi Disc
                    %mover
                      %mo →
                      %mi Π
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"}
                  (\Pi \dashv Disc \dashv \Gamma \dashv coDisc) :
                  ETop \infty Grpd
                  \\stackrel{\overset{\Pi}{\to}}{\stackrel{\overset{Disc}{\leftarrow}}{\stackrel{\overset{\Gamma}{\to}}{\underset{coDisc}{\leftarrow}}}}
                  \\infty Grpd
          %p
            for the defining quadruple of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+%28%E2%88%9E%2C1%29-functor"} adjoint (∞,1)-functor
            %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-geometric+morphism"} (∞,1)-geometric morphism
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
          %h3#Groups
            Cohesive
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            By the general properties of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
            of definition, every
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            object is presented by a presheaf of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ETop
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
            among these are the
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+group"} simplicial topological group
          %h3#GeometricHomotopy Geometric homotopy and Galois theory
          %p
            We discuss the realization of the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} inft
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop \inft Grpd
          #FundGroupoidOfParacompact.num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              such that that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              admits a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              by
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+manifold"} paracompact manifold
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \Pi(X) := \Pi(i(X)) \in \infty Grpd
              is equivalent to the standard
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
              of a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              that is presented by the
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Sing X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Sing
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi(X) \simeq Sing X
                    \\,.
            %p
              Equivalently, under
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mn ∞
                    %mi Grpd
                    %mo →
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} \mathbb{L}|-| : \infty Grpd \to Top
              we have that there is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≃
                    %mo{:stretchy => "false"} |
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \simeq |\Pi(X)|
                    \\,.
          .proof
            %h6#proof_7 Proof
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
              we have an equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi 𝕃
                    %msub
                      %mi lim
                      %mo →
                  %annotation{:encoding => "application/x-tex"} \Pi(-) \simeq \mathbb{L} \lim_\to
              to the
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              of the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mo →
                      %mo :
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                      %mo →
                      %msub
                        %mi sSet
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} \lim_\to : [CartSp^{op}, sSet]_{proj,loc} \to sSet_{Quillen}
            %p
              To compute this derived functor, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
              be a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
              = succeed "ally" do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} C(\coprod_i U_i \to X) \in [CartSp^{op}, sSet]
              is degreewise a
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              of
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/split+hypercover"} split hypercover
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              we have that in this case the canonical morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    C(\coprod_i U_i \to X) \to X
            %p
              is a cofibrant
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,loc}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi 𝕃
                    %munder
                      %mi lim
                      %mo →
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %munder
                      %mi lim
                      %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi(X) \simeq (\mathbb{L} \lim_\to) (X) \simeq \lim_\to C(\coprod_i U_i \to X)
                    \\,.
            %p
              Using the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet] \simeq [\Delta^{op}, [CartSp^{op}, Set]]
              and that
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %a.existingWikiWord{:href => "/nlab/show/presheaf+categories"} presheaf categories
              are computed objectwise and finally using that the colimit of a
              %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable functor
              is the point (an incarnation of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi(X)
              is presented by the
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              that is obtained by contracting in the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\coprod_i U_i)
              each open subset to a point.
            %p
              The classical
              %a.existingWikiWord{:href => "/nlab/show/nerve+theorem"} nerve theorem
              asserts that this implies the claim.
          .num_remark
            %h6#remark Remark
            %p
              We may regard
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              itself as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Π
                        %mi Top
                      %mo ⊣
                      %msub
                        %mi Disc
                        %mi Top
                      %mo ⊣
                      %msub
                        %mi Γ
                        %mi Top
                      %mo ⊣
                      %msub
                        %mi coDisc
                        %mi Top
                      %mo{:stretchy => "false"} )
                      %mi Top
                      %mover
                        %mo →
                        %mo ≃
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} (\Pi_{Top}\dashv Disc_{Top} \dashv \Gamma_{Top} \dashv coDisc_{Top}) Top \stackrel{\simeq}{\to} \infty Grpd
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
            %p
              Using this the above proposition may be stated as saying that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              that admits a
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Π
                      %mrow
                        %mi ETop
                        %mn ∞
                        %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Π
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi_{ETop\infty Grpd}(X) \simeq \Pi_{Top}(X)
                    \\,.
          #FundGroupoidOfSimplicialParacompact.num_prop
            %h6#proposition_8 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              be a
              %a.existingWikiWord{:href => "/nlab/show/good+simplicial+topological+space"} good simplicial topological space
              that is degreewise
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact
              and degreewise admits a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                      %mo ∈
                      %msup
                        %mi Top
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                      %mo →
                      %mi ETop
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} X_\bullet \in Top^{\Delta^{op}} \to ETop \infty Grpd
            %p
              We have that the intrinsic
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} \Pi(X_\bullet) \in \infty Grpd
              coincides under
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                    %mo{:stretchy => "false"} |
                    %mo −
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mn ∞
                    %mi Grpd
                    %mover
                      %mo →
                      %mo ≃
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} \mathbb{L}|-| : \infty Grpd \stackrel{\simeq}{\to} Top
              with the ordinary
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi X
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %msup
                              %mi Δ
                              %mi op
                  %annotation{:encoding => "application/x-tex"} |X_\bullet|_{Top^{\Delta^{op}}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo •
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo ≃
                    %mo{:stretchy => "false"} |
                    %msub
                      %mi X
                      %mo •
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %msup
                              %mi Δ
                              %mi op
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    |\Pi(X_\bullet)| \simeq |X_\bullet|_{Top^{\Delta^{op}}}
                    \\,.
          .proof
            %h6#proof_8 Proof
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              for Dugger’s cofibrant replacement functor on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi CartSp
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,loc}
              (discussed at
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              it is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mi X
                    %mo :
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %msub
                            %mi U
                            %mn 0
                          %mo →
                          %mi ⋯
                          %mo →
                          %msub
                            %mi U
                            %mi n
                          %mo →
                          %mi X
                      %msub
                        %mi U
                        %mn 0
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Q X := \int^{[n] \in \Delta} \Delta[n] \cdot
                    \\left(
                    \\coprod_{U_0 \to \cdots \to U_n \to X} U_0
                    \\right)
                    \\,,
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              in the integrand of the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              is over all sequences of morphisms from
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              as indicated. On a general
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} X_\bullet
              it is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %msub
                      %mi X
                      %mo •
                    %mo :
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mi Q
                    %msub
                      %mi X
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Q X_\bullet := \int^{[k] \in \Delta} \Delta[k] \cdot Q X_k
                    \\,,
            %p
              which is the simplicial presheaf that over any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n \in CartSp
              takes as value the
              %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
              of the
              %a.existingWikiWord{:href => "/nlab/show/bisimplicial+set"} bisimplicial set
              whose
              = succeed "-entry" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n,r)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %msub
                            %mi U
                            %mn 0
                          %mo →
                          %mi ⋯
                          %mo →
                          %msub
                            %mi U
                            %mi n
                          %mo →
                          %msub
                            %mi X
                            %mi k
                      %msub
                        %mi CartSp
                        %mi top
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo ,
                      %msub
                        %mi U
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \coprod_{U_0 \to \cdots \to U_n \to X_k} CartSp_{top}(\mathbb{R}^n,U_0)
            %p
              Since
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mo •
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} (
                            %mi 𝕃
                            %munder
                              %mi lim
                              %mo →
                            %mo{:stretchy => "false"} )
                            %msub
                              %mi X
                              %mo •
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %munder
                              %mi lim
                              %mo →
                            %mi Q
                            %msub
                              %mi X
                              %mo •
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi n
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %munder
                              %mi lim
                              %mo →
                            %mo{:stretchy => "false"} (
                            %mi Q
                            %msub
                              %mi X
                              %mi k
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Pi(X_\bullet)
                    \&amp; \simeq
                    (\mathbb{L} \lim_\to) X_\bullet
                    \\\
                    \&amp; \simeq \lim_\to Q X_\bullet
                    \\\
                    \&amp; \simeq \int^{[n] \in \Delta} \Delta[k] \cdot \lim_\to (Q X_k)
                    \\,.
                    \\end{aligned}
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
              this
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              is a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              over the simplicial
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mo →
                    %mi Q
                    %msub
                      %mi X
                      %mo •
                    %mo :
                    %mi Δ
                    %mo →
                    %msub
                      %mi sSet
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} \lim_\to Q X_\bullet : \Delta \to sSet_{Quillen}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msub
                      %mi hocolim
                      %mi Δ
                    %munder
                      %mi lim
                      %mo →
                    %mi Q
                    %msub
                      %mi X
                      %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq hocolim_\Delta \lim_\to Q X_\bullet
                    \\,.
            %p
              By the
              %a{:href => "#FundGroupoidOfParacompact"} above proposition
              we have for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              weak equivalences
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mo →
                      %mi Q
                      %msub
                        %mi X
                        %mi k
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi 𝕃
                      %msub
                        %mi lim
                        %mo →
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi X
                        %mi k
                      %mo ≃
                      %mi Sing
                      %msub
                        %mi X
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \lim_\to Q X_k \simeq (\mathbb{L} \lim_\to) X_k \simeq Sing X_k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mo ≃
                            %msub
                              %mi hocolim
                              %mi Δ
                            %mi Sing
                            %msub
                              %mi X
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msup
                              %mo ∫
                              %mrow
                                %mo{:stretchy => "false"} [
                                %mi k
                                %mo{:stretchy => "false"} ]
                                %mo ∈
                                %mi Δ
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                            %mo ⋅
                            %mi Sing
                            %msub
                              %mi X
                              %mi k
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi diag
                            %mi Sing
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi X
                              %mo •
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo •
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\cdots &amp;\simeq hocolim_\Delta Sing X_k
                    \\\
                    \&amp; \simeq \int^{[k] \in \Delta} \Delta[k] \cdot Sing X_k
                    \\\
                    \&amp; \simeq diag Sing(X_\bullet)_\bullet
                    \\end{aligned}
                    \\,.
            %p
              By the discussion at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological spaces
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              of the simplicial topological space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
          %h3#PresentationOfPathGroupoid Paths and geometric Postnikov towers
          %p
            We discuss the notion of
            %em
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+%28infinity,1%29-topos+--+structures#Paths"} geometric path ∞-groupoids
            realized in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
          %p
            In the
            %a{:href => "#GeometricRealization"} above
            constructions of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Pi(X)
            the actual paths are not explicit. We discuss here presentations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X)
            in terms of actual paths.
          %p
            By prop.
            %a.maruku-ref{:href => "#FundGroupoidOfParacompact"}
            we have
          #DiscretePathGroupoid.num_prop
            %h6#proposition_9 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ETop
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X)
              is presented by the constant
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi Sing
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo :
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mi k
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Disc Sing(X)
                    \\,:\,
                    (U,[k])
                    \\mapsto
                    Hom_{Top}(\Delta^k, X)
                    \\,.
          %p Possibly more natural would seem to look at the topological Kan complex that remembers the topology on the spaces of paths:
          .num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a paracompact topological space, define the simplicial presheaf
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi X
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %msup
                      %mi Δ
                      %mi k
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Sing} X
                    \:
                    (U,[k])
                    \\mapsto
                    Hom_{Top}(U \times \Delta^k, X)
                    \\,.
          .num_prop
            %h6#observation Observation
            %p
              Also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing} X
              is a presentation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X)
          .proof
            %h6#proof_9 Proof
            %p
              For each fixed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              the inclusion of simplicial sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sing
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Sing X \to \mathbf{Sing}(X)(U)
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi CartSp
                  %annotation{:encoding => "application/x-tex"} U \in CartSp
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
            %p Therefore the inclusion of simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi Sing
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    Disc Sing X \to \mathbf{Sing} X
            %p
              is a weak equivalence in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj}
              = succeed "." do
                %a.maruku-ref{:href => "#DiscretePathGroupoid"}
          .num_remark
            %h6#remark_2 Remark
            %p
              Typically one is interested in mapping out of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi Sing
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Disc Sing X
              is cofibrant in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi CartSp
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [CartSp^{op}, sSet]_{proj,loc}
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Sing
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{Sing}X
          %h3#Cohomology
            Cohomology and principal
            = succeed "-bundles" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            We dicuss aspects of the intrinsic
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi Top
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} E Top \infty Grpd
            and of the
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
          .un_def
            %h6#definition_7 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              be any
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete ∞-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} |A| \in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              for its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is the set of
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              classes of maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} X \to |A|
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H_{Top}(X,A) := \pi_0 Top(X,|A|)
                    \\,.
            %p
              We say
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Top(X,|A|)
              itself is the
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              for
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Similarly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo ∈
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} X, \mathbf{A} \in ETop \infty Grpd
              two e-topological
              = succeed "-groupoids," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi ETop
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msub
                      %mi π
                      %mn 0
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_{ETop}(X,\mathbf{A}) := \pi_0 ETop\infty Grpd(X,\mathbf{A})
            %p
              for the intrinsic
              %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with coefficients in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \mathbf{A}
          .un_prop
            %h6#proposition_10 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} A \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mi A
                    %mo ∈
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} Disc A \in ETop \infty Grpd
              for the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-groupoid"} discrete topological ∞-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mi Top
                      %mn 1
                    %mover
                      %mo ↪
                      %mi i
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} X \in Top_1 \stackrel{i}{\hookrightarrow} ETop \infty Grpd
              be a
              %a.existingWikiWord{:href => "/nlab/show/paracompact+topological+space"} paracompact topological space
              regarded as a 0-
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
              Euclidean-topological
              = succeed "-groupoid." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            %p
              We have an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              of cohomology sets
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi H
                      %mi ETop
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Disc
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H_{Top}(X,A) \simeq H_{ETop}(X,Disc A)
            %p
              and in fact an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28%E2%88%9E%2C1%29-category"} equivalence
              of
              %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Disc
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Top(X,|A|) \simeq ETop\infty Grpd(X, Disc A)
                    \\,.
          .proof
            %h6#proof_10 Proof
            %p
              By the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo ⊣
                      %mi Disc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              of the
              %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Disc
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo →
                      %mo ≃
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo −
                        %mo{:stretchy => "false"} |
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} |
                    %mi Π
                    %mi X
                    %mo{:stretchy => "false"} |
                    %mo ,
                    %mo{:stretchy => "false"} |
                    %mi A
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ETop\infty Grpd(X, Disc A) \simeq \infty Grpd(\Pi(X), A)
                    \\underoverset{\simeq}{|-|}{\to}
                    Top(|\Pi X|, |A|)
                    \\,.
            %p
              From this the claim follows by the
              = succeed "." do
                %a{:href => "#FundGroupoidOfParacompact"} above proposition
          #GeometricRealizationOfHomotopyFibers.un_prop
            %h6#proposition_11 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/well-pointed+simplicial+topological+group"} well-pointed simplicial topological group
              degreewise in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/TopMfd"} TopMfd
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mi{:mathvariant => "normal"} ETop
                    %mn ∞
                    %mi{:mathvariant => "normal"} Grpd
                    %mo →
                    %mn ∞
                    %mi{:mathvariant => "normal"} Grpd
                  %annotation{:encoding => "application/x-tex"} \Pi : \mathrm{ETop}\infty\mathrm{Grpd} \to \infty \mathrm{Grpd}
              preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \to \mathbf{B}G
              that are presented in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi{:mathvariant => "normal"} CartSp
                      %mi{:mathvariant => "normal"} top
                      %mi{:mathvariant => "normal"} op
                    %mo ,
                    %mi{:mathvariant => "normal"} sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [\mathrm{CartSp}_{\mathrm{top}}^{\mathrm{op}}, \mathrm{sSet}]_{proj}
              by morphism of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} X \to \bar W G
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              fibrant.
          .proof
            %h6#proof_11 Proof
            %p
              Notice that since
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheafification"} (∞,1)-sheafification
              preserves finite
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mi X
                    %mover
                      %mo →
                      %mo ≃
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Q X \stackrel{\simeq}{\to} X
              for the global cofibrant resolution given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mi X
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mrow
                              %msub
                                %mi i
                                %mn 0
                          %mo →
                          %mi ⋯
                          %mo →
                          %msub
                            %mi U
                            %mrow
                              %msub
                                %mi i
                                %mi n
                          %mo →
                          %msub
                            %mi X
                            %mi n
                          %mo{:stretchy => "false"} }
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                    %annotation{:encoding => "application/x-tex"} Q X : [n] \mapsto \coprod_{\{U_{i_0} \to \cdots \to U_{i_n} \to X_n\}} U_{i_0}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mi k
                  %annotation{:encoding => "application/x-tex"} U_{i_k}
              range over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} CartSp
                      %mi{:mathvariant => "normal"} top
                  %annotation{:encoding => "application/x-tex"} \mathrm{CartSp}_{\mathrm{top}}
              \. (Discussed at
              = succeed "." do
                %a{:href => "http://nlab.mathforge.org/nlab/show/model+structure+on+simplicial+presheaves#CofibrantReplacement"} model structure on simplicial presheaves – cofibrant replacement
              %a.existingWikiWord{:href => "/nlab/show/good+simplicial+topological+space"} good simplicial topological space
              that is degreewise in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/TopMfd"} TopMfd
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagrams of simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi P
                            %mo ′
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi P
                          %mtd
                            %mo →
                          %mtd
                            %mi W
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Q
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mo ≃
                          %mtd
                            %mi X
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi W
                              %mo{:stretchy => "false"} ¯
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    P' &amp;\stackrel{\simeq}{\to}&amp;  P &amp;\to&amp; W G
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    Q X &amp;\stackrel{\simeq}{\to}&amp; X &amp;\to &amp; \bar W G
                    }
                    \\,.
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological spaces
              we have that the rightmost vertical morphism is a fibration in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi top
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [CartSp_{top}^{op}, sSet]_{proj}
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
              it follows then that also the top left horizontal morphism is a weak
            %p
              Since the square on the right is a pullback of fibrant objects with one morphism being a fibration,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is a presentation of the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mover
                        %mi W
                        %mo{:stretchy => "false"} ¯
                      %mi G
                    %annotation{:encoding => "application/x-tex"} X \to \bar W G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} P'
            %p
              By prop.
              %a.maruku-ref{:href => "#FundGroupoidOfSimplicialParacompact"}
              we have that on the outer diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} \Pi
              is presented by
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological spaces
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mo −
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} |-|
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+principal+bundle"} simplicial principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} Top
                      %mi{:mathvariant => "normal"} Quillen
                  %annotation{:encoding => "application/x-tex"} \mathrm{Top}_{\mathrm{Quillen}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi P
                              %mo{:stretchy => "false"} |
                          %mtd
                            %mo →
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi W
                              %mi G
                              %mo{:stretchy => "false"} |
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi Q
                              %mi X
                              %mo{:stretchy => "false"} |
                          %mtd
                            %mo →
                          %mtd
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mover
                                %mi W
                                %mo{:stretchy => "false"} ¯
                              %mi G
                              %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    {|P|} &amp;\to&amp;  {|W G|}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    {|Q X|} &amp; \to &amp; {|\bar W G|}
                    }
            %p
              which exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi P
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |P|
              as the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Q
                      %mi X
                      %mo{:stretchy => "false"} |
                      %mo →
                      %mo{:stretchy => "false"} |
