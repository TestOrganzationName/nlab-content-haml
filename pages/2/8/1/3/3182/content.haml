            %em
              D-topological
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            is an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            equipped with
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesion
            in the form
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/D-topology"} D-topology
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/D-topological+spaces"} D-topological spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Delta-generated+topological+spaces"} Delta-generated topological spaces
            %a.existingWikiWord{:href => "/nlab/show/concrete+object"} concrete
            %span.newWikiWord
              0-truncated
              %a{:href => "/nlab/new/0-truncated+object+in+an+%28infinity%2C1%29-category"} ?
            D-topological
            = succeed "-groupoids," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+manifolds"} topological manifolds
          %p
            Examples of
            %a.existingWikiWord{:href => "/nlab/show/1-truncated+object+in+an+%28infinity%2C1%29-category"} 1-truncated objects
            in D-topological
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/topological+groupoids"} topological groupoids
            %a.existingWikiWord{:href => "/nlab/show/topological+stacks"} topological stacks
            which are presented by
            %a.existingWikiWord{:href => "/nlab/show/internal+groupoids"} internal groupoids
            in
            %a.existingWikiWord{:href => "/nlab/show/D-topological+spaces"} D-topological spaces
            (hence degree-wise
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/concrete+object"} concrete
          %p
            More generally, every
            %a.existingWikiWord{:href => "/nlab/show/simplicial+topological+space"} simplicial topological space
            whose topology is degreewise
            %a.existingWikiWord{:href => "/nlab/show/D-topological+space"} D-topological
            canonically presents a D-topological
            = succeed "-groupoid." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization+of+simplicial+topological+spaces"} geometric realization of simplicial topological manifolds
                is equivalently the image
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi(X)
                of the corresponding Euclidean-topological
                = succeed "-groupoid" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                under the canonical
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
            %li
              %p
                topological
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+principal+bundle"} simplicial principal bundle
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ETop
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
                classified by its
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cohomology"} internal cohomology
          %h2#definition Definition
          .un_defn
            %h6#definition_2 Definition
            %p
              Let
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi top
                  %annotation{:encoding => "application/x-tex"} {}_{top}
              be the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              has as
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              the
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+topology"} Euclidean topology
              and as
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
              between them; and whose
              %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              is given by
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
          .un_defn
            %h6#definition_3 Definition
            %p Define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ETop \infty Grpd := (\infty,1)Sh(CartSp_{top})
            %p
              to be the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CartSp
                        %mi top
                    %annotation{:encoding => "application/x-tex"} CartSp_{top}
          %h2#properties Properties
          %h3#general General
          #ETopInfGrpdAsCohesiveTopos.un_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
          .proof
            %h6#proof Proof
            %p
              The site
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi top
                  %annotation{:encoding => "application/x-tex"} {}_{top}
              an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
          %p
            For completeness we record general properties of
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
          #PointLikePropertiesOfETopInfGrpd.un_prop
            %h6#corollary Corollary
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
              is
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"}> hypercomplete
                  ;
              %li
                %p
                  of
                  %a.existingWikiWord{:href => "/nlab/show/cohomological+dimension"} cohomological dimension
                  0;
              %li
                %p
                  of
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+dimension"} homotopy dimension
                  0;
              %li
                %p
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/shape+of+an+%28%E2%88%9E%2C1%29-topos"} shape of an (∞,1)-topos
                  of the point.
          .un_def
            %h6#definition_4 Definition
            %p
              We say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
              defines
              = succeed "." do
                %strong Euclidean-topological cohesion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
              we call a
              = succeed "." do
                %strong
                  Euclidean-topological
                  = succeed "-groupoid" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
          #ToposOverTopMfd.un_prop
            %h6#proposition_2 Proposition
            %p
              Write
              %a.existingWikiWord{:href => "/nlab/show/TopMfd"} TopMfd
              for the category of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              %a.existingWikiWord{:href => "/nlab/show/large+site"} large site
              with the
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mo ≃
                    %msub
                      %mover
                        %mi Sh
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi TopMfd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ETop\infty Grpd
                    \\simeq
                    \\hat Sh_{(\infty,1)}(TopMfd)
            %p
              with the
              %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercompletion
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/TopMfd"} TopMfd
          .proof
            %h6#proof_2 Proof
            %p
              Since every
              %a.existingWikiWord{:href => "/nlab/show/topological+manifold"} topological manifold
              admits an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              by
              %a.existingWikiWord{:href => "/nlab/show/open+balls"} open balls
              %a.existingWikiWord{:href => "/nlab/show/homeomorphic"} homeomorphic
              to a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              it follows that
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi top
                  %annotation{:encoding => "application/x-tex"} {}_{top}
              is a
              %a.existingWikiWord{:href => "/nlab/show/dense+sub-site"} dense sub-site
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi TopMfd
                    %annotation{:encoding => "application/x-tex"} TopMfd
              %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
              are
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi top
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %mi TopMfd
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Sh(CartSp_{top}) \simeq Sh(TopMfd)
                    \\,.
            %p
              By the discussion at
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sheaves"} model structure on simplicial sheaves
              it follows that the
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/hypercomplete+%28%E2%88%9E%2C1%29-topos"} hypercomplete (∞,1)-topos
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalent
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi Sh
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi top
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mover
                        %mi Sh
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi TopMfd
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat Sh_{(\infty,1)}(CartSp_{top})
                    \\simeq
                    \\hat Sh_{(\infty,1)}(TopMfd)
                    \\,.
            %p
              But by the
              %a{:href => "#ETopInfGrpdAsCohesiveTopos"} above proposition
              we have that before
              %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercompletion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi top
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(CartSp_{top})
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+%28%E2%88%9E%2C1%29-topos"} local (∞,1)-topos
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercompletion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Sh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi CartSp
                        %mi top
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mover
                          %mi Sh
                          %mo{:stretchy => "false"} ^
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi CartSp
                        %mi top
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh_{(\infty,1)}(CartSp_{top}) \simeq \hat Sh_{(\infty,1)}(CartSp_{top})
          .un_def
            %h6#definition_5 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} Top_1
              for the 1-
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              and continuous maps. There is a canonical functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %msub
                      %mi Top
                      %mn 1
                    %mo →
                    %msub
                      %mi τ
                      %mrow
                        %mo ≤
                        %mn 0
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mo ↪
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"}
                    j : Top_1 \to \tau_{\leq 0}ETop\infty Grpd \hookrightarrow  ETop\infty Grpd
            %p
              given by sending a topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to the 0-
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncated
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"} (∞,1)-sheaf
              (=
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
              %a.existingWikiWord{:href => "/nlab/show/CartSp"} CartSp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                      %mi top
                  %annotation{:encoding => "application/x-tex"} {}_{top}
              externally represented by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              under the embedding
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CartSp
                        %mi top
                      %mo ↪
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} CartSp_{top} \hookrightarrow Top
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ∈
                    %msub
                      %mi CartSp
                      %mi top
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi Top
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Set
                    %mo ↪
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    j(X) : (U \in CartSp_{top}) \mapsto Hom_{Top}(U,X)
                    \\in Set \hookrightarrow \infty Grpd
                    \\,.
          .un_prop
            %h6#proposition_3 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              exhibits
              %a.existingWikiWord{:href => "/nlab/show/TopMfd"} TopMfd
              as a full
              %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TopMfd
                    %mo ↪
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    TopMfd \hookrightarrow ETop\infty Grpd
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              With the
              %a{:href => "#ToposOverTopMfd"} above proposition
              this follows directly by the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Yoneda+lemma"} (∞,1)-Yoneda lemma
          %h3#ModelCategoryPresentation Model category presentation
          %p
            We dicuss some aspects of the
            %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ETop
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
            by
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structures.
          .un_prop
            %h6#proposition_4 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi top
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [CartSp_{top}^{op}, sSet]_{proj,loc}
              be the Cech-local projective
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentation
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi CartSp
                      %mi top
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo ≃
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ([CartSp_{top}^{op}, sSet]_{proj,loc})^\circ
                    \\simeq
                    ETop \infty Grpd
                    \\,.
            %p
              Also the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sheaves"} model structure on simplicial sheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi top
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi loc
                  %annotation{:encoding => "application/x-tex"} sSh(CartSp_{top})_{loc}
              is a presentation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi sSh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi CartSp
                      %mi top
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi loc
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo ≃
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (sSh(CartSp_{top})_{loc})^\circ
                    \\simeq
                    ETop \infty Grpd
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              The first statement is a special case of the general discussion at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sheaves"} model structure on simplicial sheaves
              we have that this presents the
              %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercompletion
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-sheaves"} (∞,1)-category of (∞,1)-sheaves
              %a{:href => "#PointLikePropertiesOfETopInfGrpd"} the above
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
              already is hypercomplete.
          %p Moreover:
          .un_prop
            %h6#proposition_5 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
              is also the
              %a.existingWikiWord{:href => "/nlab/show/hypercompletion"} hypercompletion
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              presented by the local
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              over all of
              %a.existingWikiWord{:href => "/nlab/show/Mfd"} Mfd
              (or over any
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              %a.existingWikiWord{:href => "/nlab/show/dense+sub-site"} dense sub-site
              such as for instance the full sub-category of manifolds bounded in size by some
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/regular+cardinal"} regular cardinal
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Mfd
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo ≃
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat{}([Mfd^{op}, sSet]_{proj,loc})^\circ
                    \\simeq
                    ETop \infty Grpd
                    \\,.
          .proof
            %h6#proof_5 Proof
            %p
              By the
              = succeed "." do
                %a{:href => "#ToposOverTopMfd"} above proposition
          %p
            While the model structures on simplicial presheaves over both sites present the same
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
          %p
            the model structure over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi CartSp
                    %mi top
                %annotation{:encoding => "application/x-tex"} CartSp_{top}
            has more fibrant objects and hence fewer cofibrant objects, while the model structure over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mfd
                %annotation{:encoding => "application/x-tex"} Mfd
            has more cofibrant objects and fewer fibrant objects. More specifically:
          .un_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Mfd
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} X \in [Mfd^{op}, sSet]
              be an object that is
              = succeed "," do
                %em globally fibrant
              %em separated
              and
              = succeed "," do
                %em locally trivial
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(U)
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/inhabited"} inhabited
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                  for all
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo ∈
                          %mi Mfd
                        %annotation{:encoding => "application/x-tex"} U \in Mfd
              %li
                %p
                  for every
                  %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo →
                        %mi U
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{U_i \to U\}
                  in
                  %a.existingWikiWord{:href => "/nlab/show/Mfd"} Mfd
                  the
                  %a.existingWikiWord{:href => "/nlab/show/descent"} descent
                  comparison morphism
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi Mfd
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X(U) \to [Mfd^{op}, sSet](C(\{U_i\}), X)
                  is a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+%28%E2%88%9E%2C1%29-functor"} full and faithful (∞,1)-functor
              %li
                %p
                  for
                  %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  we have
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi π
                            %mn 0
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi Mfd
                            %mi op
                          %mo ,
                          %mi sSet
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo ≃
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \pi_0[Mfd^{op}, sSet](C(\{U_i\}), X) \simeq *
            %p
              Then the restriction of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CartSp
                      %mi top
                    %mo ↪
                    %mi Mfd
                  %annotation{:encoding => "application/x-tex"} CartSp_{top} \hookrightarrow Mfd
              is a fibrant object in the local model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi top
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [CartSp_{top}^{op}, sSet]_{proj,loc}
          .proof
            %h6#proof_6 Proof
            %p The fibrant objects in the local model structure are precisely those that are Kan complexes over every object and for which the descent morphism is an equivalence for all covers.
            %p
              The first condition is given by the first assumption. The second and third assumptions imply the second condition over contractible manifolds, such as the
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
          .un_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              %a.existingWikiWord{:href => "/nlab/show/Mfd"} Mfd
              that it
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} represents
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar W G
              (see the notation at
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Mfd
                  %annotation{:encoding => "application/x-tex"} Mfd
              given by the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of the
              %a.existingWikiWord{:href => "/nlab/show/topological+groupoid"} topological groupoid
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mover
                        %mo →
                        %mo →
                      %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (G \stackrel{\to}{\to} *)
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of the
              %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncated
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ∈
                      %mi ETop
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} G \in ETop\infty Grpd
              = succeed "." do
                %a{:href => "#Groups"} below
            %p
              The fibrant
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar W G
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Mfd
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [Mfd^{op}, sSet]_{proj,loc}
              is (the rectification of) its
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/stackification"} stackification
              %a.existingWikiWord{:href => "/nlab/show/stack"} stack
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Bund
                  %annotation{:encoding => "application/x-tex"} G Bund
              of topological
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                    %mo →
                    %mi G
                    %mi Bund
                  %annotation{:encoding => "application/x-tex"}
                    \\bar W G \to G Bund
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
              (over each object
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi Mfd
                    %annotation{:encoding => "application/x-tex"} U \in Mfd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar W G
              as the trivial
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar W G
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              are
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              = succeed "-bundle." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi W
                      %mo{:stretchy => "false"} ¯
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar W G
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/separated+prestack"} separated prestack
            %p
              Moreover, it is locally trivial: every
              %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycle
              for a
              = succeed "-bundle" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              is equivalent to the trivial one. Equivalently, also
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mi G
                      %mi Bund
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \pi_0 G Bund(\mathbb{R}^n) \simeq *
            %p
              Therefore
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi W
                        %mo{:stretchy => "false"} ¯
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \bar W G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CartSp
                        %mi top
                    %annotation{:encoding => "application/x-tex"} CartSp_{top}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi top
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [CartSp_{top}^{op}, sSet]_{proj,loc}
            %p
              On the other hand, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi Mfd
                  %annotation{:encoding => "application/x-tex"} X \in Mfd
              be any non-contractible manifold. Since in the projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              every representable is cofibrant, this is a cofibrant object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Mfd
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [Mfd^{op}, sSet]_{proj,loc}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi CartSp
                        %mi top
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [CartSp_{top}^{op}, sSet]_{proj,loc}
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              of any
              %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
