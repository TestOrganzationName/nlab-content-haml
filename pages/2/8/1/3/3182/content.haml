                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} |Q X| \to |\bar W G|
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo →
                      %mover
                        %mi W
                        %mo{:stretchy => "false"} ¯
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} |\Pi(X \to \bar W  G)|
          %h3#twisted_cohomology Twisted cohomology
          %p
            See
            %em
              %a.existingWikiWord{:href => "/nlab/show/twisted+bundle"} twisted bundle
            \.
          %h3#WhiteheadTowers Universal coverings and geometric Whitehead towers
          %p
            We discuss
            %a{:href => "http://ncatlab.org/nlab/show/cohesive+(infinity%2C1)-topos#Coverings"} geometric Whitehead towers
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ETop
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} ETop\infty Grpd
          .un_prop
            %h6#proposition_12 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed] [[paracompact topological space
              that admits a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mi ⋯
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} * \to \cdots X^{(2)} \to X^{(1)} \to X^{(0)} = X
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              coincides with the image under the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} intrinsic fundamental ∞-groupoid functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |\Pi(-)|
              of its
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower+in+an+%28%E2%88%9E%2C1%29-topos"} geometric Whitehead tower
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^{\mathbf{(\infty)}} \to \cdots X^{\mathbf{(2)}} \to X^{\mathbf{(1)}} \to X^{\mathbf{(0)}} = X
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ETop
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} ETop \infty Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} |
                            %mi Π
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mo :
                            %mo{:stretchy => "false"} (
