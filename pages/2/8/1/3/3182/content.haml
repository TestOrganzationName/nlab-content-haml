          .proof
            %h6#proof_12 Proof
            %p
              By the general discussion at
              %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower+in+an+%28%E2%88%9E%2C1%29-topos"} Whitehead tower in an (∞,1)-topos
              the geometric Whitehead tower is characterized for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              by the
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi n
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X^{\mathbf{(n)}} \to X^{\mathbf{(n-1)}} \to
                    \\mathbf{B}^n \mathbf{\pi}_n(X)
                    \\to
                    \\mathbf{\Pi}_n(X) \to \mathbf{\Pi}_{(n-1)}(X)
                    \\,.
            %p
              By the above
              %a{:href => "#FundGroupoidOfParacompact"} proposition on the fundamental ∞-groupoid
              we have that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Disc
                      %mi Sing
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}_n(X) \simeq Disc Sing X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              is
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              and hence preserves
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi n
                      %mi Disc
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{B} \mathbf{\pi}_n(X) \simeq \mathbf{B}^n Disc \pi_n(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_n(X)
              is the ordinary
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              of the pointed topological space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Then by the above
              %a{:href => "#GeometricRealizationOfHomotopyFibers"} proposition on geometric realization of homotopy fibers
              we have that under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} |\Pi(-)|
              the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mstyle{:mathvariant => "bold"}
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X^{\mathbf{(n)}}
              maps to the homotopy fiber of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mstyle{:mathvariant => "bold"}
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo −
                            %mn 1
                            %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mo →
                      %msup
                        %mi B
                        %mi n
                      %mo{:stretchy => "false"} |
                      %mi Disc
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} |
                      %mo =
                      %msup
                        %mi B
                        %mi n
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} |\Pi(X^{\mathbf{(n-1)}})| \to B^n |Disc \pi_n(X)| = B^n \pi_n(X)
            %p
              By induction over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              this implies the claim.
          %h3#PathInftinityGroupoids
            Path
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+site"} ∞-connected site
            %em
              %a{:href => "http://ncatlab.org/nlab/show/cohesive+(infinity%2C1)-topos#Paths"} constant path inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Π
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \to \mathbf{\Pi}(X)
            in the
            %a.existingWikiWord{:href => "/nlab/show/locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} locally ∞-connected (∞,1)-topos
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            such that the component maps are cofibrations.
          .un_remark
            %h6#remark_3 Remark
            %p
              The projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              has a set of generating cofibrations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi U
                    %mo ⋅
                    %mo ∂
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↪
                    %mi U
                    %mo ⋅
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} |
                    %mi U
                    %mo ∈
                    %mi C
                    %mo ,
                    %mi n
                    %mo ∈
                    %mi ℕ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    I =
                    \\{
                    U \cdot \partial \Delta[n] \hookrightarrow U \cdot \Delta[n] | U \in C, n \in \mathbb{N})
                    \\}
                    \\,.
          %p
            See
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
            for details.
          .un_def
            %h6#definition_8 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mo :
                    %mi C
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Sing} : C \to [C^{op}, sSet]
            %p
              for the functor given by applying the
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              to this set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              to obtain a functorial factorization of the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} U \to *
              into a cofibration followed by an acyclic fibration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ↪
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi U
                    %mover
                      %mo →
                      %mo ≃
                    %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U \hookrightarrow \mathbf{Sing} U \stackrel{\simeq}{\to} *
                    \\,.
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Sing} : [C^{op}, sSet] \to [C^{op}, sSet]
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+extension"} Yoneda extension
              (left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              through the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]
          .un_remark
            %h6#remark_4 Remark
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U \in C
              the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}U
              is a
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
              of the (
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of the)
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_1(U)
            %p
              the non-degenerate components of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}U
              at the first stage of the
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              are such that a map out of them into a simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              are given by commuting diagrams
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mn 0
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                            %msub
                              %mi U
                              %mn 0
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi s
                                %mo ,
                                %mi t
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi U
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mn 0
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_0 \coprod U_0 &amp;\stackrel{(s,t)}{\to}&amp; U
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    U_0 \times \Delta[1] &amp;\to&amp; A
                    }
                    \\,.
            %p
              This is a
              = succeed "-parameterized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              together with a
              = succeed "-parameterized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} U_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              associated to the pairs of points
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} (s,t) \in U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}U
              indeed is an
              = succeed "-groupoid" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
          .un_prop
            %h6#proposition_13 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              is the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              of a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (\mathbf{Sing} \dashv R) :
                    [C^{op}, sSet]_{proj, loc} \to [C^{op}, sSet]_{proj, loc}
                    \\,.
            %p
              Its left
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              is equivalent to the intrinsic
              %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid+in+a+locally+%E2%88%9E-connected+%28%E2%88%9E%2C1%29-topos"} fundamental ∞-groupoid in a locally ∞-connected (∞,1)-topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{L}\mathbf{Sing}(-) \simeq \Pi(-)
            %p
              and the
              %em constant path inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo →
                    %mi Π
                  %annotation{:encoding => "application/x-tex"} Id \to \Pi
              is presented by the canonical
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Id
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi Sing
                    %annotation{:encoding => "application/x-tex"} Id \to \mathbf{Sing}
          .proof
            %h6#proof_13 Proof
            %p
              On an arbitrary simplicial presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mo :
                    %mi X
                    %mo ↦
                    %msup
                      %mo ∫
                      %mrow
                        %mi U
                        %mo ∈
                        %mi C
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{Sing} : X \mapsto
                    \\int^{U \in C} X(U) \cdot \mathbf{Sing}U
                    \\,.
            %p
              By construction this preserves all colimits. Hence by the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              (using that domain and codomain are
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/presheaf+categories"} presheaf categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi X
                    %mo :
                    %mi U
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi U
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R X : U \mapsto [C^{op}, sSet](\mathbf{Sing}U, X)
                    \\,.
            %p
              We check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              is also a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} left Quillen functor
              first for the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} global projective model structure
              %a.existingWikiWord{:href => "/nlab/show/Quillen+bifunctor"} Quillen bifunctor
              (see the examples-section there for details)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mo ×
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int^C (-) \cdot (-) :
                    [C^{op}, sSet]_{proj} \times [C, [C^{op}, sSet]_{proj}]_{inj}
                    \\to
                    [C^{op}, sSet]_{proj}
                    \\,.
            %p
              Since every representable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              is cofibrant in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U \to \mathbf{Sing}U
              is a cofibration by the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}U
              is cofibrant in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}(-)
              is cofibrant in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi pro
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi inj
                    %annotation{:encoding => "application/x-tex"} [C, [C^{op}, sSet]_{pro}]_{inj}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int^C (-) \cdot (-)
              is a left Quillen bifunctor it follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∫
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \int^C (-)\cdot \mathbf{Sing}
              is a left Quillen functor. Hence it preserves cofibrations and acyclic cofibrations.
            %p
              This establishes that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              is a left simplicial Quillen functor on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
            %p
              Since this is a
              %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper model category
              we have by the discussion at
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
              that for showing that this does descend to the local model structure it is sufficient to check that the right adjoint preserves local fibrant objects. Which, in turn, is implied if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              send covering
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
            %p
              Let therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo →
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\coprod_i U_i \to U)
              be the Cech nerve of a covering family in the
              %a.existingWikiWord{:href => "/nlab/show/site"} site
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi i
                            %mi n
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi i
                            %mi n
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C(\coprod_i U_i) = \int^{[k] \in \Delta} \Delta[k] \cdot
                    \\left(
                    \\coprod_{i_0, \cdots, i_n} U_{i_0, \cdots, i_n}
                    \\right)
                    \\,,
            %p
              where by assumption on the
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-connected+site"} ∞-connected site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              all the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %msub
                          %mi i
                          %mn 0
                        %mo ,
                        %mi ⋯
                        %mo ,
                        %msub
                          %mi i
                          %mi n
                  %annotation{:encoding => "application/x-tex"} U_{i_0, \cdots, i_n}
              are representable. By precomposing the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C(\coprod_i U_i) \to X
              with the objectwise
              %a.existingWikiWord{:href => "/nlab/show/Bousfield-Kan+map"} Bousfield-Kan map
              that replaces the simplices with the
              %a.existingWikiWord{:href => "/nlab/show/fat+simplex"} fat simplex
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mo :
                      %mi Δ
                      %mo →
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Delta} : \Delta \to sSet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi i
                            %mi n
                      %msub
                        %mi U
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi i
                            %mi n
                      %mo )
                    %mover
                      %mo →
                      %mo ≃
                    %mi C
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mi i
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi U
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C(\coprod_i U_i) = \int^{[k] \in \Delta}
                    \\mathbf{\Delta}[k] \cdot
                    \\left(
                    \\coprod_{i_0, \cdots, i_n} U_{i_0, \cdots, i_n}
                    \\right)
                    \\stackrel{\simeq}{\to}
                    C(\coprod_i U_i)
                    \\to U
                    \\,.
            %p
              Here the first map is an objectwise weak equivalence by Bousfield-Kan (see the examples at
              %a.existingWikiWord{:href => "/nlab/show/Reedy+model+structure"} Reedy model structure
              for details). Hence by 2-out-of-3 we may equivalently check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              sends these morphisms to weak equivalences in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi sSet
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [C^{op}, sSet]_{proj}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Sing
                  %annotation{:encoding => "application/x-tex"} \mathbf{Sing}
              commutes with all colimits and hence coends the result of applying it to this morphism is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
