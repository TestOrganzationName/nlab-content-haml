                        %mi k
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi Δ
                    %mstyle{:mathvariant => "bold"}
                      %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ⋅
                    %mrow
                      %mo (
                      %munder
