          %h2#Properties Properties
          %h3#relation_to_axiom_k  Relation to axiom K
          %p
          .num_theorem
            %h6 Theorem
            %p
              Suppose that the strict circle type, defined using a single element and a single self-identification, has an identification
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} refl
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} base
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi{:mathvariant => "normal"} loop
                    %annotation{:encoding => "application/x-tex"} K:\mathrm{refl}_{S^1}(\mathrm{base}) = \mathrm{loop}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/set"} set
          %p
          .proof
            %h6 Proof
            %p
              For all types
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi x
                      %msub
                        %mo =
                        %mi A
                      %mi x
                    %annotation{:encoding => "application/x-tex"} p:x =_A x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{S^1}(x, p):S^1 \to A
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{S^1}(x, p)(\mathrm{base}) \equiv x
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} ap
                        %mrow
                          %msubsup
                            %mi{:mathvariant => "normal"} rec
                            %mrow
                              %msup
                                %mi S
                                %mn 1
                            %mi A
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mi p
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi{:mathvariant => "normal"} loop
                      %mo{:stretchy => "false"} )
                      %mo ≡
                      %mi p
                    %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\mathrm{rec}_{S^1}^A(x, p)}(\mathrm{base}, \mathrm{base}, \mathrm{loop}) \equiv p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} rec
