                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} dpath
                      %mo :
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} left
                      %msub
                        %mo =
                        %mi C
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} right
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{dpath}:c_\mathrm{left} =_{C} c_\mathrm{right}
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} left
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{left}
