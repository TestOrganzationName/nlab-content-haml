                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\mathrm{rec}_{S^1}(x, p)}
              that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} rec
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo ,
                    %mi{:mathvariant => "normal"} base
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
