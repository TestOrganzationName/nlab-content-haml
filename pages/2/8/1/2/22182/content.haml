                      %mi{:mathvariant => "normal"} base
                    %annotation{:encoding => "application/x-tex"} p_\mathrm{base}:f(c_\mathrm{base}) =_{S^1} \mathrm{base}
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
