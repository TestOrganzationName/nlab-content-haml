                            %msup
                              %mi S
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
