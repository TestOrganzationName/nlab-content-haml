                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi{:mathvariant => "normal"} ap
