                    %mi{:mathvariant => "normal"} left
                    %mo ,
                    %mi{:mathvariant => "normal"} right
                    %mo ,
                    %mi{:mathvariant => "normal"} dpath
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi q
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\mathrm{rec}_{S^1}^A(x, y, p, q)}(\mathrm{left}, \mathrm{right}, \mathrm{upath}) \equiv p \qquad \mathrm{ap}_{\mathrm{rec}_{S^1}^A(x, y, p, q)}(\mathrm{left}, \mathrm{right}, \mathrm{dpath}) \equiv q
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/congruence+rules"} congruence rules
              of
              %a.existingWikiWord{:href => "/nlab/show/judgmental+equality"} judgmental equality
              applied to the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} rec
