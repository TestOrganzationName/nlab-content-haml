                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi{:mathvariant => "normal"} base
                        %mo ,
                        %mi{:mathvariant => "normal"} base
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} loop
                    %mo ,
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} rec
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %mi x
