                    %mi y
                    %mo ,
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} left
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "2em"}
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} right
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi y
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{S^1}(x, y, p, q)(\mathrm{left}) \equiv x \qquad \mathrm{rec}_{S^1}(x, y, p, q)(\mathrm{right}) \equiv y
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msubsup
                          %mi{:mathvariant => "normal"} rec
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi p
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} left
                    %mo ,
                    %mi{:mathvariant => "normal"} right
                    %mo ,
                    %mi{:mathvariant => "normal"} upath
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi p
                    %mspace{:width => "2em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msubsup
                          %mi{:mathvariant => "normal"} rec
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                          %mi A
