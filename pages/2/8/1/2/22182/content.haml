                    %annotation{:encoding => "application/x-tex"} \Sigma \mathrm{Bool}
                of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/coequalizer+type"} coequalizer type
                of any two
                %a.existingWikiWord{:href => "/nlab/show/endofunctions"} endofunctions
                on the
                %a.existingWikiWord{:href => "/nlab/show/unit+type"} unit type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
