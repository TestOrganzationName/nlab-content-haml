                    %annotation{:encoding => "application/x-tex"} A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a set.
          %p
          .num_theorem
            %h6 Theorem
            %p
              Suppose that the two parallal identifications of the strict circle type are
              %a.existingWikiWord{:href => "/nlab/show/judgmentally+equal"} judgmentally equal
              to each other of the base of the circle
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} upath
                      %mo ≡
                      %mi{:mathvariant => "normal"} dpath
                      %mo :
                      %mi{:mathvariant => "normal"} left
                      %msub
                        %mo =
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mi{:mathvariant => "normal"} right
                    %annotation{:encoding => "application/x-tex"} \mathrm{upath} \equiv \mathrm{dpath}:\mathrm{left} =_{S^1} \mathrm{right}
              %a.existingWikiWord{:href => "/nlab/show/judgmental+uniqueness+of+identity+proofs"} judgmental uniqueness of identity proofs
              holds.
          %p
          .proof
            %h6 Proof
            %p
              For all types
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
