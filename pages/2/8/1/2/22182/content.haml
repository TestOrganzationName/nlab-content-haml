                    %mtr
                      %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{c}
                  \&amp; f(c_\mathrm{base}) &amp; \overset{\mathrm{ap}_{f}(c_\mathrm{loop})}= &amp; f(c_\mathrm{base}) &amp;  \\
                  p_\mathrm{base} &amp; \Vert &amp;  &amp; \Vert &amp; p_\mathrm{base}\\
                  \&amp; \mathrm{base} &amp; \underset{\mathrm{loop}}= &amp; \mathrm{base} &amp; \\
                  \\end{array}
          %ul
            %li an identification saying that the square commutes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi{:mathvariant => "normal"} loop
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %mo •
                  %msub
                    %mi p
                    %mi{:mathvariant => "normal"} base
                  %msub
                    %mo =
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mi{:mathvariant => "normal"} loop
                  %msub
                    %mi p
                    %mi{:mathvariant => "normal"} base
                  %mo •
                  %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} p_\mathrm{loop}:\mathrm{ap}_f(c_\mathrm{loop}) \bullet p_\mathrm{base} =_{f(c_\mathrm{base}) =_{S^1} \mathrm{loop}} p_\mathrm{base} \bullet \mathrm{loop}
          %p one can construct
          %ul
            %li a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} g:S^1 \to C
          %ul
            %li
              a homotopy witnessing that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} sec
                    %mi g
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi x
                %annotation{:encoding => "application/x-tex"} \mathrm{sec}_g:\prod_{x:S^1} f(g(x)) =_{S^1} x
          %p such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} base
                  %mspace{:width => "1em"}
                  %msub
                    %mi{:mathvariant => "normal"} sec
                    %mi g
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi p
                    %mi{:mathvariant => "normal"} base
                  %mspace{:width => "1em"}
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi g
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} g(\mathrm{base}) \equiv c_\mathrm{base} \quad \mathrm{sec}_g(\mathrm{base}) \equiv p_\mathrm{base} \quad \mathrm{ap}_{g}(\mathrm{loop}) \equiv c_\mathrm{loop}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mo =
                  %mrow
                    %mo (
                    %mi λ
                    %mi x
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo .
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                        %mi x
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} sec
                      %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} base
                    %mo ,
                    %mi{:mathvariant => "normal"} base
                    %mo ,
                    %mi{:mathvariant => "normal"} loop
                    %mo )
                  %mo ≡
                  %msub
                    %mi p
                    %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{=}\left(\lambda x:S^1.\mathrm{refl}_{f(g(x)) =_{S^1} x}(\mathrm{sec}_g(x)), \mathrm{base}, \mathrm{base}, \mathrm{loop}\right) \equiv p_\mathrm{loop}
          %p
            The last condition needs some explanation. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is a section of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \circ g
            is
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} i:S^1 \to S^1
            with homotopy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi x
                %annotation{:encoding => "application/x-tex"} j:\prod_{x:S^1} i(x) =_{S^1} x
          %p
            we have the following square for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} x:S^1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} y:S^1
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi x
                    %msub
                      %mo =
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi y
                  %annotation{:encoding => "application/x-tex"} q:x =_{S^1} y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                      %mtd
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mover
                          %mo =
                          %mrow
                            %msub
                              %mi{:mathvariant => "normal"} ap
                              %mi i
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo{:stretchy => "false"} )
                      %mtd
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                      %mtd
                    %mtr
                      %mtd
                        %mi j
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                        %mi j
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                    %mtr
                      %mtd
                      %mtd
                        %mi x
                      %mtd
                        %munder
                          %mo =
                          %mi q
                      %mtd
                        %mi y
                      %mtd
                    %mtr
                      %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{c}
                  \&amp; i(x) &amp; \overset{\mathrm{ap}_{i}(q)}= &amp; i(y) &amp;  \\
                  j(x) &amp; \Vert &amp;  &amp; \Vert &amp; j(y)\\
                  \&amp; x &amp; \underset{q}= &amp; y &amp; \\
                  \\end{array}
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/commutative+square"} square commutes
            via the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/J+rule"} J rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mi x
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo •
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{i}(\mathrm{refl}_{S^1}(x)) \bullet j(x) =_{i(x) =_{S^1} x} j(x) \bullet \mathrm{refl}_{S^1}(x)
          %p
            But
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{i}(\mathrm{refl}_{S^1}(x)) \bullet j(x)
            reduces down to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j(x)
            via
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{i}(\mathrm{refl}_{S^1}(x)) \bullet j(x) \equiv \mathrm{refl}_{S^1}(i(x)) \bullet j(x) \equiv j(x)
          %p
            and similarly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo •
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j(x) \bullet \mathrm{refl}_{S^1}(x)
            reduces down to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(x)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(x)
          %p So the naturality square is inductively defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mo =
                  %mrow
                    %mo (
                    %mi λ
                    %mi x
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo .
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                        %mi x
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi q
                    %mo )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mi y
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi q
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{=}\left(\lambda x:S^1.\mathrm{refl}_{i(x) =_{S^1} x}(j(x)), x, y, q\right):\mathrm{ap}_{i}(q) \bullet j(y) =_{i(x) =_{S^1} y} j(x) \bullet q
          %p
            When
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≔
                    %mi f
                    %mo ∘
                    %mi g
                  %annotation{:encoding => "application/x-tex"} i \coloneqq f \circ g
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≔
                    %msub
                      %mi{:mathvariant => "normal"} sec
                      %mi g
                  %annotation{:encoding => "application/x-tex"} j \coloneqq \mathrm{sec}_g
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≔
                    %mi{:mathvariant => "normal"} base
                  %annotation{:encoding => "application/x-tex"} x \coloneqq \mathrm{base}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ≔
                    %mi{:mathvariant => "normal"} base
                  %annotation{:encoding => "application/x-tex"} y \coloneqq \mathrm{base}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≔
                    %mi{:mathvariant => "normal"} loop
                  %annotation{:encoding => "application/x-tex"} q \coloneqq \mathrm{loop}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mo =
                  %mrow
                    %mo (
                    %mi λ
                    %mi x
                    %mo :
                    %msup
                      %mi S
                      %mn 1
                    %mo .
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mrow
                            %msup
                              %mi S
                              %mn 1
                        %mi x
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} sec
                      %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi{:mathvariant => "normal"} base
                    %mo ,
                    %mi{:mathvariant => "normal"} base
                    %mo ,
                    %mi{:mathvariant => "normal"} loop
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{=}\left(\lambda x:S^1.\mathrm{refl}_{f(g(x)) =_{S^1} x}(\mathrm{sec}_g(x)), \mathrm{base}, \mathrm{base}, \mathrm{loop}\right)
          %p
            which is of the same type as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi p
                    %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} p_\mathrm{loop}
            due to the
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equalities"} judgmental equalities
            in the other computation rules.
          %p
            One gets back the usual induction principle of the interval type when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ≡
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C \equiv \sum_{x:S^1} P(x)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ≡
                  %msub
                    %mi π
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f \equiv \pi_1
            the first projection function of the dependent sum type, and one gets back the recursion principle of the interval type when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ≡
                  %msup
                    %mi S
                    %mn 1
                  %mo ×
                  %mi P
                %annotation{:encoding => "application/x-tex"} C \equiv S^1 \times P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ≡
                  %msub
                    %mi π
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f \equiv \pi_1
            the first projection function of the product type.
          %h3#extensionality_principle_of_the_circle_type Extensionality principle of the circle type
          %p
            The extensionality principle of the circle type says that there is an equivalence of types between the identification type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} base
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi{:mathvariant => "normal"} base
                %annotation{:encoding => "application/x-tex"} \mathrm{base} =_{S^1} \mathrm{base}
            and the type of integers
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ext
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathrm{ext}_{S^1}:(\mathrm{base} =_{S^1} \mathrm{base}) \simeq \mathbb{Z}
          %p
            Equivalently, that the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+type"} loop space type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega(S^1, \mathrm{base})
            is equivalent to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
          %p
            Thus, the extensionality principle of the circle type implies that the integers and thus the natural numbers are
            %a.existingWikiWord{:href => "/nlab/show/contractible+types"} contractible types
            if
            %a.existingWikiWord{:href => "/nlab/show/axiom+K"} axiom K
            or
            %a.existingWikiWord{:href => "/nlab/show/uniqueness+of+identity+proofs"} uniqueness of identity proofs
            hold for the entire type theory. If the extensionality principle of the natural numbers also hold in the type theory, then every type is contractible.
          %p
            One can prove the extensionality principle of the circle type, given a
            %a.existingWikiWord{:href => "/nlab/show/univalent+universe"} univalent universe
            where the circle is small relative to the universe. The
            %a.existingWikiWord{:href => "/nlab/show/HoTT+book"} HoTT book
            provides a number of such proofs.
          %p
            If one doesn’t have a type of integers or a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
            says that the
            %a.existingWikiWord{:href => "/nlab/show/identity+types"} identity types
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} base
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi{:mathvariant => "normal"} base
                %annotation{:encoding => "application/x-tex"} \mathrm{base} =_{S^1} \mathrm{base}
            satisfy the
            %a.existingWikiWord{:href => "/nlab/show/dependent+universal+property+of+the+integers+type"} dependent universal property of the integers type
            with respect to the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi{:mathvariant => "normal"} base
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi{:mathvariant => "normal"} base
                %annotation{:encoding => "application/x-tex"} \mathrm{refl}_{S^1}(\mathrm{base}):\mathrm{base} =_{S^1} \mathrm{base}
            and the equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi p
                  %mo :
                  %mi{:mathvariant => "normal"} base
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi{:mathvariant => "normal"} base
                  %mo .
                  %mi p
                  %mo •
                  %mi{:mathvariant => "normal"} loop
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda p:\mathrm{base} =_{S^1} \mathrm{base}.p \bullet \mathrm{loop}:(\mathrm{base} =_{S^1} \mathrm{base}) \simeq (\mathrm{base} =_{S^1} \mathrm{base})
          %p
            This is a special case of the extensionality principle of
            %a.existingWikiWord{:href => "/nlab/show/coequalizer+types"} coequalizer types
            and
            %a.existingWikiWord{:href => "/nlab/show/pushout+types"} pushout types
            as detailed in
            = succeed "." do
              %a{:href => "#KrausRaumer19"} Kraus and Raumer (2019)
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/circle+type#LargeRecursionPrinciple"} large recursion principle
            of the circle type also implies the extensionality principle of the circle type.
          %h3#the_circle_type_and_infinity The circle type and infinity
          %p
            The extensionality principle of the circle type says that the loop space of the circle at its base point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega(S^1, \mathrm{base})
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/denumerable+set"} denumerable set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega(S^1, \mathrm{base})
            is an
            %a.existingWikiWord{:href => "/nlab/show/infinite+set"} infinite
            type.
          %p By the recursion principle of the natural numbers, there is a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} rec
                    %mi ℕ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi λ
                  %mi l
                  %mo :
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo .
                  %mi l
                  %mo •
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ℕ
                  %mo →
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{N}}(\mathrm{refl}_{S^1}(\mathrm{base}), \lambda l:\Omega(S^1, \mathrm{base}).l \bullet \mathrm{loop}):\mathbb{N} \to \Omega(S^1, \mathrm{base})
          %p
            which takes zero to reflexivity of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} base
                %annotation{:encoding => "application/x-tex"} \mathrm{base}
            and the successor function to concatenation of a self-identification by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} loop
                  %annotation{:encoding => "application/x-tex"} \mathrm{loop}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega(S^1, \mathrm{base})
            is an infinite set, states that the above function is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/embedding+of+types"} embedding of types
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} inf
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo :
                  %mi{:mathvariant => "normal"} isEmbed
                  %mrow
                    %mo (
                    %msub
                      %mi{:mathvariant => "normal"} rec
                      %mi ℕ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi λ
                    %mi l
                    %mo :
                    %mi Ω
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 1
                    %mo ,
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo .
                    %mi l
                    %mo •
                    %mi{:mathvariant => "normal"} loop
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{inf}_{S^1}:\mathrm{isEmbed}\left(\mathrm{rec}_{\mathbb{N}}(\mathrm{refl}_{S^1}(\mathrm{base}), \lambda l:\Omega(S^1, \mathrm{base}).l \bullet \mathrm{loop})\right)
          %p
            or equivalently that application of the above function is an equivalence for all natural numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo :
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} m:\mathbb{N}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo :
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n:\mathbb{N}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} inf
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
