              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} dpath
                %annotation{:encoding => "application/x-tex"} \mathrm{dpath}
            results in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} upath
                %annotation{:encoding => "application/x-tex"} c_\mathrm{upath}
