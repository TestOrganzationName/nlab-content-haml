          %h2#idea Idea
          %p
            The
            %em circle type
            is an
            %a.existingWikiWord{:href => "/nlab/show/axiom"} axiomatization
            of the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of the (
            %a.existingWikiWord{:href => "/nlab/show/shape+modality"} shape
            of) the
            %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %h2#definition Definition
          %p
            There are many ways of defining the
            %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
            as a
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
          %ul
            %li
              %p
                As the
                = succeed ":" do
                  %a{:href => "#GenericSelfIdentification"} generic self-identification
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
                with element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} base
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathrm{base}:S^1
                and a self-identification
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} loop
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi{:mathvariant => "normal"} base
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{loop}:\mathrm{Id}_{S^1}(\mathrm{base}, \mathrm{base})
            %li
              %p
                As the
                = succeed ":" do
                  %a{:href => "#GenericPairOfIdentifications"} generic parallel pair of identifications
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
                with points
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} left
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathrm{left}:S^1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} right
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathrm{right}:S^1
                and self-identifications
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} upath
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} left
                      %mo ,
                      %mi{:mathvariant => "normal"} right
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{upath}:\mathrm{Id}_{S^1}(\mathrm{left}, \mathrm{right})
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} dpath
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} Id
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} left
                      %mo ,
                      %mi{:mathvariant => "normal"} right
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathrm{dpath}:\mathrm{Id}_{S^1}(\mathrm{left}, \mathrm{right})
          %h3#GenericSelfIdentification As the generic self-identification
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %msub
                    %mo =
                    %mi A
                  %mi b
                %annotation{:encoding => "application/x-tex"} a =_A b
            denote the
            %a.existingWikiWord{:href => "/nlab/show/identification+type"} identification type
            between elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a:A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} b:A
            of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %msubsup
                    %mo =
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mi z
                %annotation{:encoding => "application/x-tex"} y =_{x:A.B(x)}^{(a, b, p)} z
            denote the
            %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identification+type"} heterogeneous identification type
            between elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y:B(a)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} z:B(b)
            of type family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a:A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} b:A
            and
            %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi b
                  %annotation{:encoding => "application/x-tex"} p:a =_A b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} apd
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{apd}_f(a, b, p)
            denote the
            %a.existingWikiWord{:href => "/nlab/show/dependent+function+application"} dependent function application
            of the
            %a.existingWikiWord{:href => "/nlab/show/dependent+function"} dependent function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:\prod_{x:A} B(x)
            to the
            %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi a
                  %msub
                    %mo =
                    %mi A
                  %mi b
                %annotation{:encoding => "application/x-tex"} p:a =_A b
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            formulation of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
          %p
            First the rule that defines the circle type itself in some context
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/type+formation"} type formation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msup
                        %mi S
                        %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash S^1 \; \mathrm{type}}
          %p
            Now the basic “introduction” rule, which says that the circle type consists of a base point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} base
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathrm{base}:S^1
            and a loop identification
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} loop
                    %mo :
                    %mi{:mathvariant => "normal"} base
                    %msub
                      %mo =
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi{:mathvariant => "normal"} base
                  %annotation{:encoding => "application/x-tex"} \mathrm{loop}:\mathrm{base} =_{S^1} \mathrm{base}
          %p
            %strong>
              %a.existingWikiWord{:href => "/nlab/show/term+introduction"} term introduction
            \:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} base
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} loop
                      %mo :
                      %mi{:mathvariant => "normal"} base
                      %msub
                        %mo =
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mi{:mathvariant => "normal"} base
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{base}:S^1} \qquad \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{loop}:\mathrm{base} =_{S^1} \mathrm{base}}
          %h4#induction_principle Induction principle
          %p
            There are different induction principles associated with the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equalities"} judgmental equalities
            or
            %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            are used; if the former are used, this results in
            = succeed "," do
              %strong strict circle types
            = succeed "." do
              %strong weak circle types
          %p The induction principle for strict circle types states that if:
          %ol
            %li
              %p
                For all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x:S^1
                we have a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(x)
            %li
              %p
                For any term
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} base
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{base}:C(\mathrm{base})
                and any heterogeneous identification
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} loop
                      %mo :
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %msubsup
                        %mo =
                        %mrow
                          %mi x
                          %mo :
                          %msup
                            %mi S
                            %mn 1
                          %mo .
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} base
                          %mo ,
                          %mi{:mathvariant => "normal"} base
                          %mo ,
                          %mi{:mathvariant => "normal"} loop
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{loop}:c_\mathrm{base} =_{x:S^1.C(x)}^{(\mathrm{base}, \mathrm{base}, \mathrm{loop})} c_\mathrm{base}
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{base}
                is equal to itself across
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} loop
                    %annotation{:encoding => "application/x-tex"} \mathrm{loop}
          %p
            then we have a dependent function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c:\prod_{x:S^1} C(x)
            such that evaluating
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} base
                %annotation{:encoding => "application/x-tex"} \mathrm{base}
            results in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} base
                %annotation{:encoding => "application/x-tex"} c_\mathrm{base}
            and applying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            across
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} \mathrm{loop}
            results in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mi{:mathvariant => "normal"} loop
                  %annotation{:encoding => "application/x-tex"} c_\mathrm{loop}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} base
                  %mspace{:width => "2em"}
                  %msub
                    %mi{:mathvariant => "normal"} apd
                    %mi c
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} c(\mathrm{base}) \equiv c_\mathrm{base} \qquad \mathrm{apd}_c(\mathrm{base}, \mathrm{base}, \mathrm{loop}) \equiv c_\mathrm{loop}
          %p The induction principle for weak circle types states that if:
          %ol
            %li
              %p
                For all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x:S^1
                we have a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(x)
            %li
              %p
                For any term
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} base
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{base}:C(\mathrm{base})
                and any heterogeneous identification
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} loop
                      %mo :
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %msubsup
                        %mo =
                        %mrow
                          %mi x
                          %mo :
                          %msup
                            %mi S
                            %mn 1
                          %mo .
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} base
                          %mo ,
                          %mi{:mathvariant => "normal"} base
                          %mo ,
                          %mi{:mathvariant => "normal"} loop
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{loop}:c_\mathrm{base} =_{x:S^1.C(x)}^{(\mathrm{base}, \mathrm{base}, \mathrm{loop})} c_\mathrm{base}
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{base}
                is equal to itself across
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} loop
                    %annotation{:encoding => "application/x-tex"} \mathrm{loop}
          %p
            there exists a dependent function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
