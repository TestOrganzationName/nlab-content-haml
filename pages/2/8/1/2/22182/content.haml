                  %mstyle{:mathvariant => "bold"}
                    %mn 1
                  %mo →
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{1} \rightrightarrows \mathbf{1} \to S^1
          %ul
            %li
              Following
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+homotopy+theory"} synthetic homotopy theory
              %a.existingWikiWord{:href => "/nlab/show/coequalizer+type"} coequalizer type
              of the pair of functions on the
              %a.existingWikiWord{:href => "/nlab/show/line+type"} line type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
