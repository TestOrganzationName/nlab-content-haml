                    %mi{:mathvariant => "normal"} right
                    %mo ,
                    %mi{:mathvariant => "normal"} dpath
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\mathrm{ap}_{\mathrm{rec}_{S^1}(x, y, p, q)}(\mathrm{left}, \mathrm{right})}(\mathrm{upath}, \mathrm{dpath}, \mathrm{UIP}):\mathrm{ap}_{\mathrm{rec}_{S^1}(x, y, p, q)}(\mathrm{left}, \mathrm{right}, \mathrm{upath}) = \mathrm{ap}_{\mathrm{rec}_{S^1}(x, p)}(\mathrm{left}, \mathrm{right}, \mathrm{dpath})
            %p which reduces down to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} ap
                          %mrow
                            %msub
                              %mi{:mathvariant => "normal"} rec
                              %mrow
                                %msup
                                  %mi S
                                  %mn 1
