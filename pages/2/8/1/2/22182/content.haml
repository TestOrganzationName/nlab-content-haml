                  %annotation{:encoding => "application/x-tex"} x:A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} y:A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi x
                    %msub
                      %mo =
                      %mi A
                    %mi y
                  %annotation{:encoding => "application/x-tex"} p:x =_A y
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
