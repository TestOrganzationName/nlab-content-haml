                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} c(\mathrm{base}) \equiv c_\mathrm{base} \qquad \mathrm{ap}_c(\mathrm{base}, \mathrm{base}, \mathrm{loop}) \equiv c_\mathrm{loop}
          %p The recursion principle for weak circle types states that if:
          %ol
            %li
              %p
                We have a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                For any term
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %mo :
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{base}:C
                and any identification
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} loop
                      %mo :
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %msub
                        %mo =
                        %mi C
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{loop}:c_\mathrm{base} =_{C} c_\mathrm{base}
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{base}
                is equal to itself
          %p
            there exists a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} c:S^1 \to C
            and an identification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi c
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} base
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} base
                %annotation{:encoding => "application/x-tex"} p:c(\mathrm{base}) =_{C(\mathrm{base})} c_\mathrm{base}
            such that applying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            across
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} \mathrm{loop}
            is equal to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} c_\mathrm{loop}
            across
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi c
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %msubsup
                    %mo =
                    %mrow
                      %mi z
                      %mo :
                      %mi C
                      %mo .
                      %mi z
                      %msub
                        %mo =
                        %mi C
                      %mi z
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} base
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_c(\mathrm{base}, \mathrm{base}, \mathrm{loop}) =_{z:C.z =_{C} z}^{(c(\mathrm{base}), c_\mathrm{base}, p)} c_\mathrm{loop}
          %p
            The recursion principle for weak circle types can be presented as a single rule via the use of a
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi C
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %mo :
                      %mi C
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} loop
                      %mo :
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %msub
                        %mo =
                        %mi C
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msubsup
                        %mi{:mathvariant => "normal"} rec
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                        %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %mo ,
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} loop
                      %mo{:stretchy => "false"} )
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi c
                          %mo :
                          %msup
                            %mi S
                            %mn 1
                          %mo →
                          %mi C
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi p
                          %mo :
                          %mi c
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} base
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo =
                            %mrow
                              %mi C
                              %mo{:stretchy => "false"} (
                              %mi{:mathvariant => "normal"} base
                              %mo{:stretchy => "false"} )
                          %msub
                            %mi c
                            %mi{:mathvariant => "normal"} base
                      %msub
                        %mi{:mathvariant => "normal"} ap
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi{:mathvariant => "normal"} loop
                      %mo{:stretchy => "false"} )
                      %msubsup
                        %mo =
                        %mrow
                          %mi z
                          %mo :
                          %mi C
                          %mo .
                          %mi z
                          %msub
                            %mo =
                            %mi C
                          %mi z
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} base
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mi c
                            %mi{:mathvariant => "normal"} base
                          %mo ,
                          %mi p
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash C \; \mathrm{type} \quad \Gamma \vdash c_\mathrm{base}:C \quad \Gamma \vdash c_\mathrm{loop}:c_\mathrm{base} =_{C} c_\mathrm{base}}{\Gamma \vdash \mathrm{rec}_{S^1}^{C}(c_\mathrm{base}, c_\mathrm{loop}):\sum_{c:S^1 \to C} \sum_{p:c(\mathrm{base}) =_{C(\mathrm{base})} c_\mathrm{base}} \mathrm{ap}_c(\mathrm{base}, \mathrm{base}, \mathrm{loop}) =_{z:C.z =_{C} z}^{(c(\mathrm{base}), c_\mathrm{base}, p)} c_\mathrm{loop}}
          %p
            and similarly, the (non-dependent)
            %strong universal property of the circle type
            is presented as a single rule by replacing the dependent sum type in the recursion principle with a uniqueness quantifier
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi C
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %mo :
                      %mi C
                      %mspace{:width => "1em"}
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} loop
                      %mo :
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %msub
                        %mo =
                        %mi C
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msubsup
                        %mi{:mathvariant => "normal"} rec
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                        %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} base
                      %mo ,
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} loop
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo ∃
                      %mo !
                      %mi c
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                      %mo →
                      %mi C
                      %mo .
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi p
                          %mo :
                          %mi c
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} base
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo =
                            %mrow
                              %mi C
                              %mo{:stretchy => "false"} (
                              %mi{:mathvariant => "normal"} base
                              %mo{:stretchy => "false"} )
                          %msub
                            %mi c
                            %mi{:mathvariant => "normal"} base
                      %msub
                        %mi{:mathvariant => "normal"} ap
                        %mi c
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi{:mathvariant => "normal"} loop
                      %mo{:stretchy => "false"} )
                      %msubsup
                        %mo =
                        %mrow
                          %mi z
                          %mo :
                          %mi C
                          %mo .
                          %mi z
                          %msub
                            %mo =
                            %mi C
                          %mi z
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} base
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mi c
                            %mi{:mathvariant => "normal"} base
                          %mo ,
                          %mi p
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \vdash C \; \mathrm{type} \quad \Gamma \vdash c_\mathrm{base}:C \quad \Gamma \vdash c_\mathrm{loop}:c_\mathrm{base} =_{C} c_\mathrm{base}}{\Gamma \vdash \mathrm{rec}_{S^1}^{C}(c_\mathrm{base}, c_\mathrm{loop}):\exists!c:S^1 \to C.\sum_{p:c(\mathrm{base}) =_{C(\mathrm{base})} c_\mathrm{base}} \mathrm{ap}_c(\mathrm{base}, \mathrm{base}, \mathrm{loop}) =_{z:C.z =_{C} z}^{(c(\mathrm{base}), c_\mathrm{base}, p)} c_\mathrm{loop}}
          %h4#LargeRecursionPrinciple Large recursion principle
          %p
            There is also a large recursion principle which allows one to construct a family of types indexed by the circle type from a type and an
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/autoequivalence"} autoequivalence
          %p The large recursion principle for circle types states that if:
          %ol
            %li
              %p
                We have a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                We have an autoequivalence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo :
                      %mi A
                      %mo ≃
                      %mi A
                    %annotation{:encoding => "application/x-tex"} e:A \simeq A
          %p
            then we have a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                  %mo ⊢
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:S^1 \vdash C(x)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\mathrm{base})
            results in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %a.existingWikiWord{:href => "/nlab/show/transport"} transport
            across
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} \mathrm{loop}
            results in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi A
                  %mspace{:width => "2em"}
                  %msubsup
                    %mi{:mathvariant => "normal"} tr
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi e
                %annotation{:encoding => "application/x-tex"} C(\mathrm{base}) \equiv A \qquad \mathrm{tr}_{S^1}^C(\mathrm{base}, \mathrm{base}, \mathrm{loop}) \equiv e
          %p Usually, the second computation principle is given by a typal equality, similarly to the recursion and induction principles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi β
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mrow
                      %mi{:mathvariant => "normal"} loop
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msubsup
                    %mi{:mathvariant => "normal"} tr
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi A
                      %mo ≃
                      %mi A
                  %mi e
                %annotation{:encoding => "application/x-tex"} \beta_{S^1}^{\mathrm{loop},A}(e):\mathrm{tr}_{S^1}^C(\mathrm{base}, \mathrm{base}, \mathrm{loop}) =_{A \simeq A} e
          %p There are also typal computation rules for the type as well, which postulate an equivalence of types instead of a judgmental equality, with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi β
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mrow
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi A
                  %mspace{:width => "2em"}
                  %msubsup
                    %mi β
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mrow
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msubsup
                    %mi{:mathvariant => "normal"} tr
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msubsup
                    %mi β
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mrow
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi e
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ≡
                  %mo ∘
                  %mi e
                %annotation{:encoding => "application/x-tex"} \beta_{S^1}^{\mathrm{base},A}(e):C(\mathrm{base}) \simeq A \qquad \beta_{S^1}^{\mathrm{base},A}(e) \circ \mathrm{tr}_{S^1}^C(\mathrm{base}, \mathrm{base}, \mathrm{loop}) \circ \beta_{S^1}^{\mathrm{base},A}(e)^{-1} \equiv \circ e
          %p Similarly, the second computation principle can be given by a typal equality, similarly to the recursion and induction principles:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi β
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mrow
                      %mi{:mathvariant => "normal"} loop
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msubsup
                    %mi β
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mrow
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msubsup
                    %mi{:mathvariant => "normal"} tr
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %msubsup
                    %mi β
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mrow
                      %mi{:mathvariant => "normal"} base
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi e
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %msub
                    %mo =
                    %mrow
                      %mi A
                      %mo ≃
                      %mi A
                  %mi e
                %annotation{:encoding => "application/x-tex"} \beta_{S^1}^{\mathrm{loop},A}(e):\beta_{S^1}^{\mathrm{base},A}(e) \circ \mathrm{tr}_{S^1}^C(\mathrm{base}, \mathrm{base}, \mathrm{loop}) \circ \beta_{S^1}^{\mathrm{base},A}(e)^{-1} =_{A \simeq A} e
          %p
            If one is working in a
            %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory+with+type+variables"} dependent type theory with type variables
            which has
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identity+type#IdentityTypesBetweenTypes"} identity types between types
          %ol
            %li
              %p
                We have a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                We have an self-identification of types
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi A
                      %mo =
                      %mi A
                    %annotation{:encoding => "application/x-tex"} p:A = A
          %p
            then we have a type family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                  %mo ⊢
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} x:S^1 \vdash C(x)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C(\mathrm{base})
            results in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and the
            %a.existingWikiWord{:href => "/nlab/show/action+on+identifications"} action on identifications
            across
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} loop
                %annotation{:encoding => "application/x-tex"} \mathrm{loop}
            results in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi A
                  %mspace{:width => "2em"}
                  %msubsup
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi p
                %annotation{:encoding => "application/x-tex"} C(\mathrm{base}) \equiv A \qquad \mathrm{ap}_{S^1}^C(\mathrm{base}, \mathrm{base}, \mathrm{loop}) \equiv p
          %p Usually, the second computation principle is given by a typal equality, similarly to the recursion and induction principles
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi β
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mrow
                      %mi{:mathvariant => "normal"} loop
                      %mo ,
                      %mi A
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msubsup
                    %mi{:mathvariant => "normal"} tr
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo ,
                  %mi{:mathvariant => "normal"} loop
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi A
                      %mo =
                      %mi A
                  %mi p
                %annotation{:encoding => "application/x-tex"} \beta_{S^1}^{\mathrm{loop},A}(p):\mathrm{tr}_{S^1}^C(\mathrm{base}, \mathrm{base}, \mathrm{loop}) =_{A = A} p
          %p …
          %h3#GenericPairOfIdentifications As the generic parallel pair of identifications
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %msub
                    %mo =
                    %mi A
                  %mi b
                %annotation{:encoding => "application/x-tex"} a =_A b
            denote the
            %a.existingWikiWord{:href => "/nlab/show/identification+type"} identification type
            between elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a:A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} b:A
            of type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %msubsup
                    %mo =
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                      %mo .
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                  %mi z
                %annotation{:encoding => "application/x-tex"} y =_{x:A.B(x)}^{(a, b, p)} z
            denote the
            %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identification+type"} heterogeneous identification type
            between elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y:B(a)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} z:B(b)
            of type family
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a:A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} b:A
            and
            %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi b
                  %annotation{:encoding => "application/x-tex"} p:a =_A b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} apd
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{apd}_f(a, b, p)
            denote the
            %a.existingWikiWord{:href => "/nlab/show/dependent+function+application"} dependent function application
            of the
            %a.existingWikiWord{:href => "/nlab/show/dependent+function"} dependent function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:\prod_{x:A} B(x)
            to the
            %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi a
                  %msub
                    %mo =
                    %mi A
                  %mi b
                %annotation{:encoding => "application/x-tex"} p:a =_A b
          %p
            In the
            %a.existingWikiWord{:href => "/nlab/show/natural+deduction"} natural deduction
            formulation of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inference+rules"} inference rules
          %p
            First the rule that defines the circle type itself in some context
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
          %p
            %strong
              %a.existingWikiWord{:href => "/nlab/show/type+formation"} type formation
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msup
                        %mi S
                        %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash S^1 \; \mathrm{type}}
          %p
            Now the basic “introduction” rule, which says that the circle type consists of two endpoints
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} left
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathrm{left}:S^1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} right
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathrm{right}:S^1
            and a pair of parallel identifications
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} upath
                  %mo :
                  %mi{:mathvariant => "normal"} left
                  %msub
                    %mo =
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                  %mi{:mathvariant => "normal"} right
                %annotation{:encoding => "application/x-tex"} \mathrm{upath}:\mathrm{left} =_{S^1} \mathrm{right}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} dpath
                    %mo :
                    %mi{:mathvariant => "normal"} left
                    %msub
                      %mo =
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                    %mi{:mathvariant => "normal"} right
                  %annotation{:encoding => "application/x-tex"} \mathrm{dpath}:\mathrm{left} =_{S^1} \mathrm{right}
          %p
            %strong>
              %a.existingWikiWord{:href => "/nlab/show/term+introduction"} term introduction
            \:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} left
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} right
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} upath
                      %mo :
                      %mi{:mathvariant => "normal"} left
                      %msub
                        %mo =
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mi{:mathvariant => "normal"} right
                  %mspace{:width => "2em"}
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi{:mathvariant => "normal"} dpath
                      %mo :
                      %mi{:mathvariant => "normal"} left
                      %msub
                        %mo =
                        %mrow
                          %msup
                            %mi S
                            %mn 1
                      %mi{:mathvariant => "normal"} right
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{left}:S^1} \qquad \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{right}:S^1} \qquad \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{upath}:\mathrm{left} =_{S^1} \mathrm{right}} \qquad \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{dpath}:\mathrm{left} =_{S^1} \mathrm{right}}
          %h4#induction_principle_2 Induction principle
          %p
            There are different induction principles associated with the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+type"} circle type
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equalities"} judgmental equalities
            or
            %a.existingWikiWord{:href => "/nlab/show/identifications"} identifications
            are used; if the former are used, this results in
            = succeed "," do
              %strong strict circle types
            = succeed "." do
              %strong weak circle types
          %p The induction principle for strict circle types states that if:
          %ol
            %li
              %p
                For all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x:S^1
                we have a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(x)
            %li
              %p
                For any term
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} left
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} left
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{left}:C(\mathrm{left})
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} right
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi{:mathvariant => "normal"} right
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{right}:C(\mathrm{right})
                and any two heterogeneous identifications
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} upath
                      %mo :
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} left
                      %msubsup
                        %mo =
                        %mrow
                          %mi x
                          %mo :
                          %msup
                            %mi S
                            %mn 1
                          %mo .
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} left
                          %mo ,
                          %mi{:mathvariant => "normal"} right
                          %mo ,
                          %mi{:mathvariant => "normal"} upath
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} right
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{upath}:c_\mathrm{left} =_{x:S^1.C(x)}^{(\mathrm{left}, \mathrm{right}, \mathrm{upath})} c_\mathrm{right}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} dpath
                      %mo :
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} left
                      %msubsup
                        %mo =
                        %mrow
                          %mi x
                          %mo :
                          %msup
                            %mi S
                            %mn 1
                          %mo .
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi{:mathvariant => "normal"} left
                          %mo ,
                          %mi{:mathvariant => "normal"} right
                          %mo ,
                          %mi{:mathvariant => "normal"} dpath
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} right
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{dpath}:c_\mathrm{left} =_{x:S^1.C(x)}^{(\mathrm{left}, \mathrm{right}, \mathrm{dpath})} c_\mathrm{right}
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} left
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{left}
                is identified with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mi{:mathvariant => "normal"} right
                    %annotation{:encoding => "application/x-tex"} c_\mathrm{right}
                itself across
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} upath
                    %annotation{:encoding => "application/x-tex"} \mathrm{upath}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi{:mathvariant => "normal"} dpath
                    %annotation{:encoding => "application/x-tex"} \mathrm{dpath}
          %p
            then we have a dependent function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %msup
                        %mi S
                        %mn 1
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} c:\prod_{x:S^1} C(x)
            such that evaluating
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} left
                %annotation{:encoding => "application/x-tex"} \mathrm{left}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} right
                %annotation{:encoding => "application/x-tex"} \mathrm{right}
            results in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} left
                %annotation{:encoding => "application/x-tex"} c_\mathrm{left}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mi{:mathvariant => "normal"} right
                %annotation{:encoding => "application/x-tex"} c_\mathrm{right}
            and applying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            across
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} upath
