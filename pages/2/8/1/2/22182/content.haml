                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} base
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≡
