                    %mi m
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{inf}_{S^1}:\prod_{m:\mathbb{N}} \prod_{n:\mathbb{N}} \mathrm{isEquiv}\left(\mathrm{ap}_{\mathrm{rec}_{\mathbb{N}}(\mathrm{refl}_{S^1}(\mathrm{base}), \lambda l:\Omega(S^1, \mathrm{base}).l \bullet \mathrm{loop})}(m, n)\right)
          %p
            If one doesn’t have a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+type"} natural numbers type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mi{:mathvariant => "normal"} base
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Omega(S^1, \mathrm{base})
            of the circle type at its base point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} base
                  %mo :
                  %msup
                    %mi S
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathrm{base}:S^1
            is an
            %a.existingWikiWord{:href => "/nlab/show/infinite+set"} infinite set
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo{:stretchy => "false"} (
