                        %mi u
                        %mo{:stretchy => "false"} ^
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi α
                        %mo ∈
                        %msup
                          %mi ℕ
                          %mi n
                    %msup
                      %mi c
                      %mi α
                    %msub
                      %mo ∂
                      %mi α
                    %msub
                      %mi δ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    {\hat u}^\prime - \hat u
                    \\;=\;
                    \\underset{
                    {\alpha \in \mathbb{N}^n}
                    }{\sum}
                    c^\alpha \partial_\alpha \delta_0
            %p
              for constants
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi c
                        %mi α
                      %mo ∈
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} c^\alpha \in \mathbb{C}
              %a{:href => "scaling+degree+of+a+distribution#DerivativesOfDeltaDistributionScalingDegree"} this example
              the
              %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
              of these
              %a.existingWikiWord{:href => "/nlab/show/point-supported+distributions"} point-supported distributions
              is non-negative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∂
                      %mi α
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                    %mo ≥
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg( \partial_\alpha \delta_0)
                    \=
                    {\vert \alpha\vert} \geq 0
                    \\,.
            %p
              This implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi c
                      %mi α
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} c^\alpha = 0
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
            %p Regarding existence:
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    b \in C^\infty_{cp}(\mathbb{R}^n)
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/bump+function"} bump function
              which is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \leq 1
              and
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              on 1 over a
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              of the origin. Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo ≔
                    %mn 1
                    %mo −
                    %mi b
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\chi \coloneqq 1 - b \;\in\; C^\infty(\mathbb{R}^n)
            %center
              %img{:src => "https://ncatlab.org/nlab/files/PointExtensionOfDistributions.png"}/
            %blockquote
              %p
                graphics grabbed from
                %a{:href => "#Duetsch18"} Dütsch 18, p. 108
            %p
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda \in (0,\infty)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive real number
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi λ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_\lambda(x)
                    \\coloneqq
                    \\chi(\lambda x)
                    \\,.
            %p
              Since the
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi λ
                    %mi u
                  %annotation{:encoding => "application/x-tex"} \chi_\lambda u
              has
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} support of a distribution
              on a
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of a
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              of the origin, we may extend it by zero to a distribution on all of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi λ
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_\lambda u \in \mathcal{D}'(\mathbb{R}^n)
                    \\,.
            %p
              By construction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mi λ
                    %mi u
                  %annotation{:encoding => "application/x-tex"} \chi_\lambda u
              coincides with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              away from a neighbourhood of the origin, which moreover becomes arbitrarily small as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              increases. This means that if the following
              %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
              exists
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %mrow
                        %mi λ
                        %mo →
                        %mn ∞
                    %msub
                      %mi χ
                      %mi λ
                    %mi u
                  %annotation{:encoding => "application/x-tex"}
                    \\hat u
                    \\;\coloneqq\;
                    \\underset{\lambda \to \infty}{\lim}
                    \\chi_\lambda u
            %p
              then it is an extension of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
            %p
              To see that the limit exists, it is sufficient to observe that we have a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cauchy+sequence"} Cauchy sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b\in C^\infty_{cp}(\mathbb{R}^n)
              the difference
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi u
                    %mo −
                    %msub
                      %mi χ
                      %mi n
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi u
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi χ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo +
                    %msub
                      %mi χ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\chi_{n+1} u - \chi_n u)(b)
                    \\;=\;
                    u(b)( \chi_{n+1} + \chi_n )
            %p becomes arbitrarily small.
            %p
              It remains to see that the unique extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat u
              thus established has the same scaling degree as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                    %annotation{:encoding => "application/x-tex"} u
              = succeed ")." do
                %a{:href => "#BrunettiFredenhagen00"} Brunetti-Fredenhagen 00, p. 24
          #SpaceOfPointExtensions.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (space of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/point-extensions+of+distributions"} point-extensions of distributions
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ∈
                    %mi 𝒟
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} u \in \mathcal{D}'(\mathbb{R}^n \setminus \{0\})
              be a
              %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
              of
              %a.existingWikiWord{:href => "/nlab/show/scaling+degree+of+a+distribution"} degree of divergence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi deg
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} deg(u) \lt \infty
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              does admit at least one
              %a.existingWikiWord{:href => "/nlab/show/extension+of+distributions"} extension
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExtensionOfDistributions"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                      %mo ∈
                      %mi 𝒟
                      %mo ′
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hat u \in \mathcal{D}'(\mathbb{R}^n)
              %a.existingWikiWord{:href => "/nlab/show/degree+of+divergence+of+a+distribution"} degree of divergence
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(\hat u) = deg(u)
                    \\,.
            %p
              Moreover, any two such extensions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} {\hat u}^\prime
              differ by a linear combination of
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial
              %a.existingWikiWord{:href => "/nlab/show/derivatives+of+distributions"} derivatives of distributions
              of order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≤
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \leq deg(u)
              of the
              %a.existingWikiWord{:href => "/nlab/show/delta+distribution"} delta distribution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \delta_0
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} supported
              at the origin:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi u
                        %mo{:stretchy => "false"} ^
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ^
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mi α
                            %mo ∈
                            %msup
                              %mi ℕ
                              %mi n
                        %mrow
                          %mrow
                            %mrow
                              %mo{:stretchy => "false"} |
                              %mi α
                              %mo{:stretchy => "false"} |
                            %mo ≤
                            %mi deg
                            %mo{:stretchy => "false"} (
                            %mi u
                            %mo{:stretchy => "false"} )
                    %msup
                      %mi q
                      %mi α
                    %msub
                      %mo ∂
                      %mi α
                    %msub
                      %mi δ
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    {\hat u}^\prime
                    \-
                    \\hat u
                    \\;=\;
                    \\underset{
                    { \alpha \in \mathbb{N}^n }
                    \\atop
                    { {\vert \alpha\vert} \leq deg(u) }
                    }{\sum}
                    q^\alpha
                    \\partial_\alpha \delta_0
                    \\,,
            %p
              for a finite number of constants
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi q
                        %mi α
                      %mo ∈
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} q^\alpha \in \mathbb{C}
          %p
            This is essentially (
            %a{:href => "#Hoermander90"}> Hörmander 90, thm. 3.2.4
            ). We follow (
            %a{:href => "#BrunettiFredenhagen00"}> Brunetti-Fredenhagen 00, theorem 5.3
            ), which was inspired by (
            %a{:href => "#EpsteinGlaser73"}> Epstein-Glaser 73, section 5
            ). Review of this approach is in (
            %a{:href => "#Duetsch18"}> Dütsch 18, theorem 3.35 (b)
            ), see also remark
            %a.maruku-ref{:href => "#WExtensions"}
            below.
          .proof
            %h6#proof_2 Proof
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R}^n)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \rho \in \mathbb{N}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                vanishes to order
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
              at the origin if all
              %a.existingWikiWord{:href => "/nlab/show/partial+derivatives"} partial derivatives
              with multi-index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %msup
                      %mi ℕ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \alpha \in \mathbb{N}^n
              of total order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} {\vert \alpha\vert} \leq \rho
              vanish at the origin:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∂
                      %mi α
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mphantom
                      %mi AAA
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi α
                      %mo{:stretchy => "false"} |
                    %mo ≤
                    %mi ρ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial_\alpha f (0) = 0
                    \\phantom{AAA}
                    {\vert \alpha\vert} \leq \rho
                    \\,.
            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hadamard%27s+lemma"} Hadamard's lemma
            #eq:ForVanishingOrderRhoHadamardExpansion.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
