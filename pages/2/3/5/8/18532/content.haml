                    %annotation{:encoding => "application/x-tex"} r_\alpha \in C^\infty_{cp}(\mathbb{R}^n)
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒟
                      %mi ρ
