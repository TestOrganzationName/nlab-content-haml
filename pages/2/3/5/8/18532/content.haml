                %mrow
                  %mi X
                  %mo ↪
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} X \hookrightarrow \hat X
            and a
            %a.existingWikiWord{:href => "/nlab/show/distribution"} distribution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em extension
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                %annotation{:encoding => "application/x-tex"} u
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat X
            is a distribution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi u
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat u
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat X
            whose
            %a.existingWikiWord{:href => "/nlab/show/restriction+of+distributions"} restriction of distributions
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
