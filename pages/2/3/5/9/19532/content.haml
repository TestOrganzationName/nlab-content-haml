                  %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
                #eq:SimplicialModelCategoryComparisonMorphism.maruku-equation
                  %span.maruku-eq-number (3)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo ⟶
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi A
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo ×
                          %mrow
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathcal{C}(Y,A)
                        \\longrightarrow
