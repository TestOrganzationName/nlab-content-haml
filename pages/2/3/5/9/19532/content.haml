              a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              inclusion and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
