                    {{\longrightarrow}}
                    {\overset{C = L'}{\longleftarrow}}
                    {\phantom{{}_{Qu}}\bot_{Qu}}
                    [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
