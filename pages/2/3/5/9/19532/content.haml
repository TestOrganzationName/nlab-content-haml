                      %mi U
                      %mi i
                    %mover
                      %mo →
                      %mrow
                    %mi X
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{U_i \overset{}{\to} X\}
              (either in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi red
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{red}
              or in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CechNerve"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              in the global projective/injective
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo ,
                    %mi R
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi R
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [X, R\mathbf{X}] \longrightarrow [ C(\{U_i\}), R\mathbf{X} ]
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
              = succeed "," do
                %a.maruku-ref{:href => "#DerivedHomFunctorPOnSimplicialModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/sites"} sites
              are assumed to be
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+sites"} ∞-cohesive sites
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#InfinityCohesiveSite"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              is projectively cofibrant, and hence also injectively cofibrant, by Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
            %p
              Now by the
              = succeed "-isomorphism" do
                %a.existingWikiWord{:href => "/nlab/show/enriched+adjunction"} enriched adjunction
              %a.maruku-eqref{:href => "#eq:EnrichedAdjunctionIsomorphism"} (?)
              this means equivalently that
            #eq:LocalityForInfinityCohesiveSite.maruku-equation
              %span.maruku-eq-number (16)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
