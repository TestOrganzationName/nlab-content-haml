                        %mi y
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi X
                          %mrow
                            %msub
                              %mi i
                              %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbf{X}_k \;\simeq\; \underset{i_k}{\coprod} y(X_{i_k})
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/degeneracy+maps"} degeneracy maps
                  are inclusions of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/direct+summands"} direct summands
            %p
              In particular every
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/representable+presheaf"} representable presheaf
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Universal+Homotopy+Theories"}> Dugger 00, section 9, lemma 2.7
            )
          %p
            The following concept of
            %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
            is the analog for
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            of the concept of reflection onto
            %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
            (Def.
            = succeed "):" do
              %a.maruku-ref{:href => "#LocalizationAtACollectionOfMorphisms"}
          #BousfieldLocalizationOfModelCategories.num_defn
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"}> left Bousfield localization
                )
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization+of+model+categories"} left Bousfield localization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi loc
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{loc}
              of a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelCategory"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cof
                      %mi loc
                    %mo =
                    %mi Cof
                  %annotation{:encoding => "application/x-tex"}
                    Cof_{loc} = Cof
            %p
              but more
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mi loc
                    %mo ⊃
                    %mi W
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W_{loc} \supset W
                    \\,.
            %p
              We say that this is localization
              = succeed "." do
                %em
                  at
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi W
                          %mi loc
                      %annotation{:encoding => "application/x-tex"} W_{loc}
          %p Notice that:
          #BasicPropertiesOfLectBousfieldLocalizations.num_prop
            %h6#proposition_4 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+reflection"} Quillen reflection
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization+of+model+categories"} left Bousfield localization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi loc
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{loc}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              as in def.
              = succeed "," do
                %a.maruku-ref{:href => "#BousfieldLocalizationOfModelCategories"}
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
              exhibits a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+reflection"} Quillen reflection
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenReflection"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi loc
                    %munderover
                      %mrow
                        %msub
                          %mrow
                          %mphantom
                            %mi Qu
                        %msub
                          %mo ⊥
                          %mi Qu
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi id
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mi id
                    %mi 𝒞
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_{loc}
                    \\underoverset
                    {\underset{\phantom{AA}id\phantom{AA}}{\longrightarrow}}
                    {\overset{id}{\longleftarrow}}
                    {{}_{\phantom{Qu}}\bot_{Qu}}
                    \\mathcal{C}
                    \\,.
            %p
              In particular, by Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#QuillenReflectionViaReflectionOfHomotopyCategories"}
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenAdjunctionInducesAdjunctionOnHomotopyCategories"}
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              inclusion of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒞
                      %mi loc
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ℝ
                          %mi id
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mi 𝕃
                          %mi id
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Ho(\mathcal{C}_{loc})
                    \\underoverset
                    {\underset{\phantom{AA}\mathbb{R} id \phantom{AA}}{\hookrightarrow}}
                    {\overset{\mathbb{L}id}{\longleftarrow}}
                    {\bot}
                    Ho(\mathcal{C})
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p We claim that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi Fib
                          %mi loc
                        %mo ⊂
                        %mi Fib
                      %annotation{:encoding => "application/x-tex"} Fib_{loc} \subset Fib
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi W
                          %mi loc
                        %mo ∩
                        %msub
                          %mi Fib
                          %mi loc
                        %mo =
                        %mi W
                        %mo ∩
                        %mi Fib
                      %annotation{:encoding => "application/x-tex"} W_{loc} \cap Fib_{loc} = W \cap Fib
                  ;
            %p
              Using the properties of the
              %a.existingWikiWord{:href => "/nlab/show/weak+factorization+systems"} weak factorization systems
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#WeakFactorizationSystem"}> def.
              ) of (acyclic cofibrations, fibrations) and (cofibrations, acyclic fibrations) for both model structures we get
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Fib
                              %mi loc
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Cof
                              %mi loc
                            %mo ∩
                            %msub
                              %mi W
                              %mi loc
                            %mo{:stretchy => "false"} )
                            %mi Inj
                        %mtr
                          %mtd
                          %mtd
                            %mo ⊂
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi Cof
                              %mi loc
                            %mo ∩
                            %mi W
                            %mo{:stretchy => "false"} )
                            %mi Inj
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Fib
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Fib_{loc}
                    \&amp;=
                    (Cof_{loc} \cap W_{loc})Inj
                    \\\
                    \&amp;\subset
                    (Cof_{loc} \cap W)Inj
                    \\\
                    \&amp; =
                    Fib
                    \\end{aligned}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi Fib
                              %mi loc
                            %mo ∩
                            %msub
                              %mi W
                              %mi loc
                          %mtd
                            %mo =
                            %msub
                              %mi Cof
                              %mi loc
                            %mi Inj
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Cof
                            %mspace{:width => "thinmathspace"}
                            %mi Inj
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Fib
                            %mo ∩
                            %mi W
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Fib_{loc} \cap W_{loc}
                    \&amp; =
                    Cof_{loc} Inj
                    \\\
                    \&amp; =
                    Cof \, Inj
                    \\\
                    \&amp; =
                    Fib \cap W
                    \\end{aligned}
                    \\,.
            %p
              Next to see that the
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#QuillenAdjunction"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi id
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝒞
                    %mo →
                    %msub
                      %mi 𝒞
                      %mi loc
                  %annotation{:encoding => "application/x-tex"} id \colon \mathcal{C} \to \mathcal{C}_{loc}
              preserves cofibrations and acyclic cofibrations, hence is a left Quillen functor.
            %p
              To see that the
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#DerivedAdjunctionUnit"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
            %p
              Since we have an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/identity+functors"} identity functors
              %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              is the
              %a.existingWikiWord{:href => "/nlab/show/identity+morphisms"} identity morphisms
              and hence the
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
              on a
              %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is just a
              = succeed "-morphism" do
                %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %msub
                          %mi W
                          %mi 𝒟
                        %mo ∩
                        %msub
                          %mi Fib
                          %mi 𝒟
                      %mrow
                        %msub
                          %mi p
                          %mi c
                    %mi c
                  %annotation{:encoding => "application/x-tex"}
                    Q(c) \underoverset{ \in W_{\mathcal{D}} \cap Fib_{\mathcal{D}} }{p_c}{\longrightarrow} c
            %p
              but regarded in the model structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒟
                        %mi loc
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}_{loc}
              %a.existingWikiWord{:href => "/nlab/show/acyclic+fibrations"} acyclic fibrations
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              remain weak equivalences in the left Bousfield localized model structure. In fact they even remain acyclic fibrations, bu the first point above.
            %p
              We may also easily check directly the equivalent statement (via Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenReflectionViaReflectionOfHomotopyCategories"}
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              on
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy categories
              is a
              = succeed "-inclusion:" do
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cof
                      %mi loc
                    %mo =
                    %mi Cof
                  %annotation{:encoding => "application/x-tex"} Cof_{loc} = Cof
              the notion of
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mi loc
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}_{loc}
              is the same as that in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              inclusion. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Fib
                      %mi loc
                    %mo ⊂
                    %mi Fib
                  %annotation{:encoding => "application/x-tex"} Fib_{loc} \subset Fib
              by the first statement above, on these cofibrant-fibrant objects the
              %a.existingWikiWord{:href => "/nlab/show/right+derived+functor"} right derived functor
              of the identity is just the identity and hence does exhibit this inclusion. The left adjoint to this inclusion is given by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕃
                      %mi id
                    %annotation{:encoding => "application/x-tex"} \mathbb{L}id
              = succeed "))." do
                %a.maruku-ref{:href => "#QuillenAdjunctionInducesAdjunctionOnHomotopyCategories"}
          #BousfieldLocalizationIsQuillenReflection.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+reflection"} Quillen reflection
            %p Let
          .proof
            %h6#proof_3 Proof
            %p
              We consider the case of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localizations"} left Bousfield localizations
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
            %p
              A left Bousfield localization is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              by
              %a.existingWikiWord{:href => "/nlab/show/identity+functors"} identity functors
              (
              %a{:href => "Bousfield+localization+of+model+categories#ImmediateImpiciationsOfLeftBousfieldLocalization"}> this Remark
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
