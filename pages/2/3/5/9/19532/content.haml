          #DerivedModalityFromQuillenAdjointTriple.num_lemma
            %h6#lemma_2 Lemma
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functors"} fully faithful functors
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
            %p
              Consider a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenAdjointTriple"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mn 1
                    %munderover
                      %mrow
                        %msub
                          %mrow
                          %mphantom
                            %mi Qu
                        %msub
                          %mo ⊥
                          %mi Qu
                      %mo ⟵
                      %mover
                        %mo ⟶
                        %mi L
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_1
                    \\underoverset
                    {{\longleftarrow}}
                    {\overset{L}{\longrightarrow}}
                    {{}_{\phantom{Qu}}\bot_{Qu}}
                    \\mathcal{D}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mn 2
                    %munderover
                      %mrow
                        %msub
                          %mrow
                          %mphantom
                            %mi Qu
                        %msub
                          %mo ⊥
                          %mi Qu
