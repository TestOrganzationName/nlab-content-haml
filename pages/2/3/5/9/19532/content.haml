                          %mi p
                          %mstyle{:mathvariant => "bold"}
                            %mi X
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝔸
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                    %mi const
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                      %mi ϵ
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"}
