                        %mo →
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} }
                          %mi i
                      %annotation{:encoding => "application/x-tex"} \{U_i \to X\}_i
                  in the given
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
                  (Example
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CechNerve"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo ,
                        %mi sSet
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} C(\{U_i\}) \in [\mathcal{C}^{op}, sSet]
                  satisfies the following conditions
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} C(\{U_i\})
                      is a
                      %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
                      in the
                      %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+simplicial+presheaves"} projective model structure on simplicial presheaves
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒞
                              %mi op
                            %mo ,
                            %msub
                              %mi sSet
                              %mi Qu
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mi proj
                          %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
                      (Prop.
                      = succeed ")" do
                        %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
                  %li
                    %p
                      The
                      %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                      obtained as the degreewise
                      %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                      over the
                      %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
                      is
                      %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weakly homotopy equivalent
                      to the point
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %munder
                              %mi lim
                              %munder
                                %mo ⟶
                                %mrow
                                  %msup
                                    %mi 𝒞
                                    %mi op
