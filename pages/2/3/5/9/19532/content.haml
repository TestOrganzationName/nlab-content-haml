                  %mrow
                    %mo *
                    %mo =
                    %msup
                      %mi 𝔸
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \ast = \mathbb{A}^0
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#InitialObject"}
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              operation is given just by evaluation on that object:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
