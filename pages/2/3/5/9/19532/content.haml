          %p
            The following is the analog of Prop.
            = succeed ":" do
              %a.maruku-ref{:href => "#CategoriesOfSheavesOnCohesiveSiteIsCohesive"}
          #OverInfinityCohesiveSiteCohesiveInfinityTopos.num_prop
            %h6#proposition_15 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/model+topos"} model topos
                over
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+model+topos"} cohesive model topos
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive site
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#InfinityCohesiveSite"}
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelTopos"}
              %a.existingWikiWord{:href => "/nlab/show/topological+localization"} topological localization
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalLocalization"}
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CohesiveInfinityTopos"}
          .proof
            %h6#proof_14 Proof
            %p
              By Example
              %a.maruku-ref{:href => "#simplicialPresheavesAdjointQuadrupleOnSiteWithTerminalObject"}
              we have the required
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+quadruple"} Quillen adjoint quadruple
              on the projective
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              at the
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              projections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi Set
                      %mi Qu
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AAA
                                %mi Π
                                %mphantom
                                  %mi AAA
                        %mtr
                          %mtd
                            %mover
                              %mo ↩
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi Disc
                                %mphantom
                                  %mi AA
                        %mtr
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AAA
                                %mi Γ
                                %mphantom
                                  %mi AAA
                        %mtr
                          %mtd
                            %mover
                              %mo ↩
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi coDisc
                                %mphantom
                                  %mi AA
                    %msub
                      %mi sSet
                      %mi Qu
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, Set_{Qu}]
                    \\array{
                    \\overset{\phantom{AAA} \Pi \phantom{AAA}}{\longrightarrow}
                    \\\
                    \\overset{\phantom{AA} Disc \phantom{AA} }{\hookleftarrow}
                    \\\
                    \\overset{\phantom{AAA} \Gamma \phantom{AAA} }{\longrightarrow}
                    \\\
                    \\overset{\phantom{AA} coDisc \phantom{AA} }{\hookleftarrow}
                    }
                    sSet_{Qu}
            %p
              Hence it remains to see that these
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
              pass to the local model structures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi Set
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo{:stretchy => "false"} /
                        %mi inj
                        %mo ,
                        %mi loc
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Set_{Qu}]_{proj/inj, loc}
              from Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#TopologicalLocalization"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                  %annotation{:encoding => "application/x-tex"} coDisc
              then still participate in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+reflection"} Quillen (co-)reflections
            %p
              By Prop.
              %a.maruku-ref{:href => "#SimplicialPresheavesIsProperCombinatorialSimplicial"}
              and Prop.
              %a.maruku-ref{:href => "#ExistenceOfLeftBousfieldLocalization"}
              all model structures involved are
              %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              %a.maruku-ref{:href => "#RecognitionOfSimplicialQuillenAdjunction"}
              for recognition of the required
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              does not change the class of
              %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#BousfieldLocalizationOfModelCategories"}
              %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functors"} right Quillen functors
              in the above global
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+quadruple"} Quillen adjoint quadruple
              preserve
              %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
              with respect to the local model structure.
            %p For the Quillen adjunctions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Π
                    %mo ⊣
                    %mi Disc
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ⊣
                    %mi coDisc
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %mo ↔
                    %msub
                      %mi sSet
                      %mi Qu
                  %annotation{:encoding => "application/x-tex"}
                    (\Pi \dashv Disc), (\Gamma \dashv coDisc)
                    \\;\colon\;
                    [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
                    \\leftrightarrow
                    sSet_{Qu}
            %p
              this means to check that for every
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} S \in sSet
              the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(S)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} coDisc(S)
              are derived-
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              (Def.
              = succeed "," do
                %a.maruku-ref{:href => "#DerivedLocalObjects"}
              = succeed ")" do
                %a.maruku-ref{:href => "#ExistenceOfLeftBousfieldLocalization"}
              %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
              projections. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                  %annotation{:encoding => "application/x-tex"} Disc
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                  %annotation{:encoding => "application/x-tex"} coDisc
              are
              %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functors"} right Quillen functors
              with respect to the global model projective model structure,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(S)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi coDisc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} coDisc(S)
              are globally projectively fibrant simplicial presheaves. Since, moreover,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\{U_i\})
              is projectively cofibrant by assumption, and since the representables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
              are projectively cofibrant by Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#SomeProjectivelyCofibrantSimplicialPresheaves"}
              %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
              reduces to that of the ordinary
              %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#EnrichedHomFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒞
                              %mi op
                            %mo ,
                            %mi sSet
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi Disc
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi W
                          %mtd
                            %mo{:stretchy => "false"} [
