              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
                  (Def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
          #ClassicalModelStructureOnSimplicialSetsIsCombinatorial.num_prop
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClassesOfMorphismsOnsSetQuillen"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Qu
                  %annotation{:encoding => "application/x-tex"} sSet_{Qu}
              is a
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CombinatorialModelCategory"}
          #CategoriesOfSimplicialPresheaves.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+presheaves"}> category of simplicial presheaves
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmallCategory"}
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              (Def.
              %a.maruku-ref{:href => "#TopEnrichedCategory"}
              with Example
              = succeed ")" do
                %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
              %a.existingWikiWord{:href => "/nlab/show/enriched+presheaf+category"} enriched presheaf category
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#EnrichedPresheaf"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sPSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    sPSh(\mathcal{C})
                    \\;\coloneqq\;
                    [\mathcal{C}^{op}, sSet]
            %p
              This is called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+presheaves"} category of simplicial presheaves
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %p
              By Prop.
              %a.maruku-ref{:href => "#SimplicialSetsAsPresheavesOnTheSimplexCategory"}
              this is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjointEquivalenceOfCategories"}
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              in the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Example
              = succeed "):" do
                %a.maruku-ref{:href => "#CategoryOfPresheaves"}
            #eq:SimplicialObjectsInPresheavesAreSimplicialPresheaves.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi Δ
                      %mi op
                    %mo ,
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, sSet]
                    \\;\simeq\;
                    [\Delta^{op}, \mathcal{C}^{op}, Set]
            %p This implies for instance that if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mover
                      %mo ⟶
                      %mi F
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}
                    \\overset{F}{\longrightarrow}
                    \\mathcal{D}
            %p
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              (Remark
              = succeed ")" do
                %a.maruku-ref{:href => "#AdjointTriples"}
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              %a.existingWikiWord{:href => "/nlab/show/Kan+extensions"} Kan extensions
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalLeftKanExtensionBCoend"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mo ⊥
                                %mphantom
                                  %mi AA
                              %mrow
                                %msub
                                  %mi Lan
                                  %mi F
                        %mtr
                          %mtd
                            %munderover
                              %mo ⟵
                              %mrow
                                %mphantom
                                  %mi AA
                                %mo ⊥
                                %mphantom
                                  %mi AA
                              %mrow
                                %msup
                                  %mi F
                                  %mo *
                        %mtr
                          %mtd
                            %munderover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mphantom
                                  %mo ⊥
                                %mphantom
                                  %mi AA
                              %mrow
                                %msub
                                  %mi Ran
                                  %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒟
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, sSet]
                    \\;
                    \\array{
                    \\underoverset{\phantom{AA}\bot\phantom{AA}}{Lan_F}{\longrightarrow}
                    \\\
                    \\underoverset{\phantom{AA}\bot\phantom{AA}}{F^\ast}{\longleftarrow}
                    \\\
                    \\underoverset{\phantom{AA}\phantom{\bot}\phantom{AA}}{Ran_F}{\longrightarrow}
                    }
                    \\;
                    [\mathcal{D}^{op}, sSet]
            %p
              is given simplicial-degreewise by the corresponding
              = succeed "-enriched" do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          #ModelCategoriesOfSimplicialPresheaves.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/model+categories+of+simplicial+presheaves"}> model categories of simplicial presheaves
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SmallCategory"}
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
              (Def.
              %a.maruku-ref{:href => "#TopEnrichedCategory"}
              with Example
              = succeed ")." do
                %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
              %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+presheaves"} category of simplicial presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, sSet]
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#CategoriesOfSimplicialPresheaves"}
              %a.existingWikiWord{:href => "/nlab/show/structures"} structures
              of a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelCategory"}
            %ol
              %li
                %p
                  the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+simplicial+presheaves"} projective model structure on simplicial presheaves
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo ,
                        %msub
                          %mi sSet
                          %mi Qu
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi proj
                      %annotation{:encoding => "application/x-tex"}
                        [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
                %p
                  has as
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                  and
                  %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
                  those
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                  whose component on every
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                  is a weak equivalences or fibration, respectively, in the
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                  (Def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#ClassesOfMorphismsOnsSetQuillen"}
              %li
                %p
                  the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/injective+model+structure+on+simplicial+presheaves"} injective model structure on simplicial presheaves
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi 𝒞
                          %mi op
                        %mo ,
                        %msub
                          %mi sSet
                          %mi Qu
                        %msub
                          %mo{:stretchy => "false"} ]
                          %mi inj
                      %annotation{:encoding => "application/x-tex"}
                        [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                %p
                  has as
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                  and
                  %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                  those
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                  whose component on every
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                  is a weak equivalences or cofibration, respectively, in the
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                  (Def.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#ClassesOfMorphismsOnsSetQuillen"}
            %p
              Moreover, the
              %a.existingWikiWord{:href => "/nlab/show/identity+functors"} identity functors
              constitute a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenEquivalence"}
            #eq:QuillenEquivalenceBetweenInjectiveAndProjective.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi inj
                    %munderover
                      %mrow
                        %msub
                          %mo ≃
                          %mi Qu
                      %munder
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi id
                          %mphantom
                            %mi AA
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi id
                          %mphantom
                            %mi AA
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                    \\underoverset
                    {\underset{\phantom{AA}id\phantom{AA}}{\longrightarrow}}
                    {\overset{\phantom{AA}id\phantom{AA}}{\longleftarrow}}
                    {\simeq_{Qu}}
                    [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
          #ProjectiveCofibrationIsObjectwiseCofibration.num_remark
            %h6#remark Remark
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              %a.maruku-eqref{:href => "#eq:QuillenEquivalenceBetweenInjectiveAndProjective"} (2)
              in Prop.
              %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
              implies in particular that
            %ol
              %li
                %p every projective cofibration is in particular an objectwise cofibration;
              %li
                %p every injective fibration is in particular an objectwise fibration;
          #SomeProjectivelyCofibrantSimplicialPresheaves.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (some
                %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+simplicial+presheaves"} projectively
                %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SmallCategory"}
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#sSet"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
