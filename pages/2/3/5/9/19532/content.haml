                      %msub
                        %mi 𝒟
                        %mi loc
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}_{loc}
              %a.existingWikiWord{:href => "/nlab/show/acyclic+fibrations"} acyclic fibrations
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              remain weak equivalences in the left Bousfield localized model structure. In fact they even remain acyclic fibrations, by
              = succeed "." do
                %a{:href => "Bousfield+localization+of+model+categories#ImmediateImpiciationsOfLeftBousfieldLocalization"} this Remark
          %p
            The following proposition says that Definition
            %a.maruku-ref{:href => "#CombinatorialModelCategory"}
            of
            %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
            is indeed the suitable analog of Def.
            %a.maruku-ref{:href => "#LocallyPresentableCategory"}
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+categories"} locally presentable categories
          #DuggerTheorem.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Dugger%27s+theorem"}> Dugger's theorem
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CombinatorialModelCategory"}
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒮
                        %annotation{:encoding => "application/x-tex"} \mathcal{S}
              %li
                %p
