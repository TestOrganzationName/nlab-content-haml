                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
                  %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserving
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
                  %em ;
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  in
                  %a.existingWikiWord{:href => "/nlab/show/Ho%28CombModCat%29"} Ho(CombModCat)
                  is an
                  = succeed "." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
          %p
            The following example is the genralization of the
            %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
            (Def.
            = succeed ")" do
              %a.maruku-ref{:href => "#CategoryOfSets"}
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          #InfinityGroupoid.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"}> ∞Grpd
                )
            %p
              The image of the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Qu
                  %annotation{:encoding => "application/x-tex"} sSet_{Qu}
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#ClassesOfMorphismsOnsSetQuillen"}
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              by example
              = succeed "," do
                %a.maruku-ref{:href => "#ClassicalModelStructureOnSimplicialSetsIsCombinatorial"}
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
              to
              %a.existingWikiWord{:href => "/nlab/show/Ho%28CombModCat%29"} Ho(CombModCat)
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#HoCombModCat"}
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
              of
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi CombModCat
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mphantom
                                  %mi AA
                                %mi γ
                                %mphantom
                                  %mi AA
                          %mtd
                            %mi Ho
                            %mo{:stretchy => "false"} (
                            %mi CombModCat
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msub
                              %mi sSet
                              %mi Qu
                          %mtd
                            %mo ↦
                          %mtd
                            %mn ∞
                            %mi Grpd
