                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mo ∈
                                %mi W
                          %mtd
                            %mo{:stretchy => "false"} [
