                    {\phantom{{}_{Qu}}\bot_{Qu}}
                    \\mathcal{D}_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
                      %mn 2
                    %munderover
                      %mrow
                        %mphantom
                          %mrow
                            %msub
                              %mrow
                              %mi Qu
                        %msub
                          %mo ⊥
                          %mi Qu
                      %mo ⟶
                      %mover
                        %mo ⟵
