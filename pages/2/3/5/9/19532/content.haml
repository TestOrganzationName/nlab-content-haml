                    {\overset{\iota_{inf}}{\hookrightarrow}}
                    {\bot}
                    \\mathcal{C}
            %p
              be an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-elastic+site"} ∞-elastic site
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#InfinityElasticSite"}
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalLeftKanExtensionBCoend"}
              %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched
              over
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
              %a.existingWikiWord{:href => "/nlab/show/cohesive+%28infinity%2C1%29-toposes"} cohesive
              %a.existingWikiWord{:href => "/nlab/show/model+toposes"} model toposes
              (Prop.
              = succeed ")" do
