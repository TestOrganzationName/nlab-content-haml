                        %msub
                          %mi j
                          %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝔸
                          %mn 0
                        %mo{:stretchy => "false"} )
                    %mi const
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X
