                    const(X)(\mathbb{A}^0)
                    \\overset{ const(j_X)(\mathbb{A}^0) }{\longrightarrow}
                    const(P X)(\mathbb{A}^0)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi j
                          %mi X
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \overset{j_X}{\longrightarrow} P X
              is a
              %a.existingWikiWord{:href => "/nlab/show/fibrant+replacement"} fibrant replacement
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} const(-)(\mathbb{A}^0)
              is clearly the
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
              and the plain adjunction unit is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi X
                  %annotation{:encoding => "application/x-tex"} j_X
              itself, which is indeed a weak equivalence.
            %p
              For the other case, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi inj
                        %mo ,
                        %mi loc
                        %mo ,
                        %msup
                          %mi 𝔸
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbf{X} \in [\mathcal{C}^{op}, sSet_{Qu}]_{inj, loc, \mathbb{A}^1}
              be fibrant. This means (by Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ExistenceOfLeftBousfieldLocalization"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              is fibrant in the injective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              as well as in the local model structure, and is a derived-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
              \-
              %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#DerivedLocalObjects"}
              %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
              out of any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo ×
                    %msup
                      %mi 𝔸
                      %mn 1
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                    %msup
                      %mi 𝔸
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^n \times \mathbb{A}^1 \overset{p_1}{\longrightarrow} \mathbb{A}^n
              into
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                    %mi ℝ
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %msup
