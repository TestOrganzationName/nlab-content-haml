                      %mi n
                    %mo ×
                    %msup
                      %mi 𝔸
                      %mn 1
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}Hom( p_1 )
                    \\;\colon\;
                    \\mathbb{R}Hom( \mathbb{A}^n , \mathbf{X})
                    \\overset{\in W}{\longrightarrow}
                    \\mathbb{R}Hom( \mathbb{A}^n \times \mathbb{A}^1 , \mathbf{X})
            %p
              But since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}
              is fibrant, this derived hom is equivalent to the ordinary
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              (Lemma
              = succeed ")," do
                %a.maruku-ref{:href => "#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"}
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#YonedaLemma"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mo ∈
                        %mi W
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝔸
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{X}(p_1)
                    \\;\colon\;
                    \\mathbf{X}(\mathbb{A}^n)
                    \\overset{\in W}{\longrightarrow}
                    \\mathbf{X}(\mathbb{A}^{n+1})
            %p
              is a weak equivalence, for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              %a.existingWikiWord{:href => "/nlab/show/induction"} induction
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              this means that in fact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
