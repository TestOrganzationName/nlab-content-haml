                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                            %mo ≃
