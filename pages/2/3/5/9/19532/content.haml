                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi coDisc
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [\mathcal{C}^{op}, sSet]( X, Disc(S) )
                    \&amp;\overset{\in W}{\longrightarrow}&amp;
                    [\mathcal{C}^{op}, sSet]( C(\{U_i\}), Disc(S) )
                    \\\
                    [\mathcal{C}^{op}, sSet]( X, coDisc(S) )
                    \&amp;\overset{\in W}{\longrightarrow}&amp;
                    [\mathcal{C}^{op}, sSet]( C(\{U_i\}), coDisc(S) )
