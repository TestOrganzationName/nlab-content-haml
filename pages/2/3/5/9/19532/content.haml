              %a.existingWikiWord{:href => "/nlab/show/site"} site
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Coverage"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+site"} ∞-cohesive
              if the following conditions are satisfied:
            %ol
              %li
                %p
                  The
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  has
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              %li
                %p
                  For every
                  %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                  family
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
