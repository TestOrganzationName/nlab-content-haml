                        %mo ⟶
                        %mi R
                      %mover
                        %mo ⟵
                        %mi C
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}_2
                    \\underoverset
                    {\underset{R}{\longrightarrow}}
                    {\overset{C}{\longleftarrow}}
                    {{}_{\phantom{Qu}}\bot_{Qu}}
                    \\mathcal{D}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              are
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functors"} fully faithful functors
              (necessarily jointly, by Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#FullyFaithfulAdjointTriple"}
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                    %mi L
                  %annotation{:encoding => "application/x-tex"} \mathbb{L}L
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}R
              (Prop.
              = succeed ")." do
                %a.maruku-ref{:href => "#QuillenAdjunctionInducesAdjunctionOnHomotopyCategories"}
          .proof
            %h6#proof_8 Proof
            %p
              We discuss that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              being fully faithful implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}R
              is fully faithful. Since also the
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              form an
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              (by Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#QuillenAdjointTripleInducesAdjointTripleOfDerivedFunctors"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕃
                      %mi L
                    %annotation{:encoding => "application/x-tex"} \mathbb{L}L
              = succeed "." do
                %a.maruku-ref{:href => "#FullyFaithfulAdjointTriple"}
            %p
              By Lemma
              %a.maruku-ref{:href => "#DerivedAdjunctionUnitOfQuillenAdjointTriple"}
              the
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊣
                    %mi R
                  %annotation{:encoding => "application/x-tex"} C \dashv R
              is, up to weak equivalence, the ordinary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is fully faithful (by
              = succeed ")." do
                %a{:href => "adjoint+functor#FullyFaithfulAndInvertibleAdjoints"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ⊣
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (C \dashv R)
              is a weak equivalence, hence that its image in the homotopy category is an isomorphism. But the latter is the ordinary
              %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕃
                    %mi C
                    %mo ⊣
                    %mi ℝ
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \mathbb{L}C \dashv \mathbb{R}R
              (by
              = succeed ")," do
                %a{:href => "geometry+of+physics+--+categories+and+toposes#QuillenAdjunctionInducesAdjunctionOnHomotopyCategories"} this Prop.
              = succeed "." do
                %a{:href => "adjoint+functor#FullyFaithfulAndInvertibleAdjoints"} that Prop.
