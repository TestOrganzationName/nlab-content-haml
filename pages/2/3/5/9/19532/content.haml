          .proof
            %h6#proof_15 Proof
            %p
              By Example
              %a.maruku-ref{:href => "#QuillenAdjointQuadrupleOfHomotopyKanExtensionAlongAdjointPair"}
              we have a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+quadruple"} Quillen adjoint quadruple
              for the global
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+simplicial+presheaves"} projective model structure on simplicial presheaves
              of the form
            .maruku-equation
