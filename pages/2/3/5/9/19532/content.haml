            %p
              Here we denote
              %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
              along a functor by the same symbol as that functor, which is consistent by Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#LeftKanExtensionPreservesRepresentableFunctors"}
            %p
              By Prop.
              %a.maruku-ref{:href => "#SimplicialPresheavesIsProperCombinatorialSimplicial"}
              all
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              appearing here are
              %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              %a.maruku-ref{:href => "#BousfieldLocalizationOfModelCategories"}
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              retains the
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              %a.maruku-ref{:href => "#RecognitionOfSimplicialQuillenAdjunction"}
              says that to see that this is also a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+quadruple"} Quillen adjoint quadruple
              for the
              %a.existingWikiWord{:href => "/nlab/show/local+model+structure+on+simplicial+presheaves"} local model structure on simplicial presheaves
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalLocalization"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              preserves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
              %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#DerivedLocalObjects"}
            %p
              For each
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              here this means to consider any
              %a.existingWikiWord{:href => "/nlab/show/covering"} covering
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
