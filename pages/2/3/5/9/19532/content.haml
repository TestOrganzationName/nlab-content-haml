                  %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊂
                        %msub
                          %mi Mor
                          %mrow
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒮
                              %mi op
                            %mo ,
                            %mi sSet
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} S \subset Mor_{[\mathcal{S}^{op}, sSet]}
                  in its
                  %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+presheaves"} category of simplicial presheaves
                  (Example
                  = succeed ");" do
                    %a.maruku-ref{:href => "#CategoriesOfSimplicialPresheaves"}
            %p
              1 a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenEquivalence"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒮
                      %mi op
                    %mo ,
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi S
                    %munderover
                      %mrow
                        %mphantom
                          %mrow
                            %msub
                              %mrow
                              %mi Qu
                        %msub
                          %mo ≃
                          %mi Qu
                      %munder
                        %mo ⟶
                        %mphantom
                          %mi AAAA
                      %mover
                        %mo ⟵
                        %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    [\mathcal{S}^{op}, sSet_{Qu}]_{proj,S}
                    \\underoverset
                    {\underset{\phantom{AAAA}}{\longrightarrow}}
                    {\overset{}{\longleftarrow}}
                    {\phantom{{}_{Qu}}\simeq_{Qu}}
                    \\mathcal{C}
            %p
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and the
              %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BousfieldLocalizationOfModelCategories"}
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+simplicial+presheaves"} projective model structure on simplicial presheaves
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
