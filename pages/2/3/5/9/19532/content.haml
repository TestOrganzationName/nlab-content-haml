                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    [L X, \mathbf{X}] \longrightarrow [ L C(\{U_i\}), \mathbf{X} ]
            %p is a weak equivalence. This we now check in each of the three cases:
            %p
              For the case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mi inf
                    %mo ⊣
                    %msub
                      %mi Π
                      %mi inf
                    %mo{:stretchy => "false"} )
