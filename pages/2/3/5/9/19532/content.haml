                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
          #InSimplicialModelCategoryEnrichedHomIsHomotopical.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (in
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
                %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
                out of
                %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
                into
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SimplicialModelCategory"}
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
              %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#EnrichedHomFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ⟶
                    %msub
                      %mi sSet
                      %mi Qu
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(Y,-)
                    \\;\colon\;
                    \\mathcal{C}
                    \\longrightarrow
                    sSet_{Qu}
            %p
              preserves
              %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/acyclic+fibrations"} acyclic fibrations
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{C}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
              %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#EnrichedHomFunctor"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝒞
                      %mi op
                    %mo ⟶
                    %msub
                      %mi sSet
                      %mi Qu
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(-,A)
                    \\;\colon\;
                    \\mathcal{C}^{op}
                    \\longrightarrow
                    sSet_{Qu}
            %p
              sends
              %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              and
              %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibrations"} acyclic cofibrations
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              to fibrations and acyclic fibrations, respectively, in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
          .proof
            %h6#proof_4 Proof
            %p
              In the first case, consider the comparison morphism
              %a.maruku-eqref{:href => "#eq:SimplicialModelCategoryComparisonMorphism"} (3)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} X =\emptyset
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} B = \ast
              the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InitialObject"}
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/tensored+and+cotensored+category"} tensored and cotensored category
              %a.maruku-ref{:href => "#InTensoredCotensoredCategoryInitialObjectIsEnrichedInitial"}
              says that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi ∅
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mphantom
                      %mi AA
                    %mtext and
                    %mphantom
                      %mi AA
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo *
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi sSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(\emptyset, -)
                    \\;\simeq\;
                    \\ast
                    \\phantom{AA}
                    \\text{and}
                    \\phantom{AA}
                    \\mathcal{C}(-,\ast)
                    \\;\ast\;
                    \\;\;\;
                    \\in sSet
                    \\,.
            %p This means that in the first case the comparison morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi 𝒞
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi B
                        %mo{:stretchy => "false"} )
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}(Y,A)
                    \\longrightarrow
                    \\mathcal{C}(X,A)
                    \\underset{\mathcal{C}(X,B)}{\times}
                    \\mathcal{C}(Y,B)
            %p
              %a.maruku-eqref{:href => "#eq:SimplicialModelCategoryComparisonMorphism"} (3)
              becomes equal to the top morphism in the following diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %mi 𝒞
                                %mo{:stretchy => "false"} (
                                %mi Y
                                %mo ,
                                %mi g
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %munder
                              %mo ⟶
                              %mphantom
                                %mi AAA
                          %mtd
                            %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}(Y,A)
                    \&amp;\overset{\mathcal{C}(Y,g)}{\longrightarrow}&amp;
                    \\mathcal{C}(Y,B)
                    \\\
                    \\Big\downarrow
                    \&amp;&amp;
                    \\Big\downarrow
                    \\\
                    \\ast &amp;\underset{\phantom{AAA}}{\longrightarrow}&amp; \ast
                    }
            %p while in the second case it becomes equal to the left morphism in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi Y
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mphantom
                                %mrow
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi Y
                                  %mo ,
                                  %mi g
                                  %mo{:stretchy => "false"} )
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo ,
                                  %mi A
                                  %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                        %mtr
                          %mtd
                            %mi 𝒞
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ,
                            %mi A
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mphantom
                                %mi AAA
                          %mtd
                            %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{C}(Y,A)
                    \&amp;\overset{\phantom{\mathcal{C}(Y,g)}}{\longrightarrow}&amp;
                    \\ast
                    \\\
                    {}^{\mathllap{ \mathcal{C}(f,A) }}\Big\downarrow
                    \&amp;&amp;
                    \\Big\downarrow
                    \\\
                    \\mathcal{C}(X,A)
                    \&amp;\underset{\phantom{AAA}}{\longrightarrow}&amp;
                    \\ast
                    }
            %p
              Hence the claim follows by the defining condition on the comparison morphism in a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
          #DerivedHomFunctorPOnSimplicialModelCategory.num_defn
            %h6#definition_6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"}> derived hom-functor
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SimplicialModelCategory"}
            %p
              By Prop.
              %a.maruku-ref{:href => "#InSimplicialModelCategoryEnrichedHomIsHomotopical"}
              and by
              %a.existingWikiWord{:href => "/nlab/show/Ken+Brown%27s+lemma"} Ken Brown's lemma
              (Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#KenBrownLemma"}
              %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
              (Example
              = succeed ")" do
                %a.maruku-ref{:href => "#EnrichedHomFunctor"}
              %a.existingWikiWord{:href => "/nlab/show/right+derived+functor"} right derived functor
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
              and its second argument is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant
              %em
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi hom
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ×
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi sSet
                      %mi Quillen
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}hom
                    \\;\colon\;
                    Ho(\mathcal{C})^{op} \times Ho(\mathcal{C})
                    \\longrightarrow
                    Ho(sSet_{Quillen})
            %p
              In view of the
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sSet
                      %mi Qu
                    %msub
                      %mo ≃
                      %mi Qu
                    %msub
                      %mi Top
                      %mi Qu
                  %annotation{:encoding => "application/x-tex"} sSet_{Qu} \simeq_{Qu} Top_{Qu}
              (Theorem
              = succeed ")," do
                %a.maruku-ref{:href => "#TopsSetQuillenEquivalence"}
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}hom(X,A)
              are also called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/derived+hom-spaces"} derived hom-spaces
            %p
              In the presence of
              %a.existingWikiWord{:href => "/nlab/show/functorial+factorization"} functorial
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              and
              %a.existingWikiWord{:href => "/nlab/show/fibrant+resolution"} fibrant resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
              %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}(-,-)
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mi X
                    %mo ,
                    %mi P
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}hom(X,Y)
                    \\;\simeq\;
                    \\mathcal{C}(Q X, P Y)
                    \\,.
          #RecognitionOfSimplicialQuillenAdjunction.num_prop
            %h6#proposition_7 Proposition
            %p
              %strong
                (recognition of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunctions"} simplicial Quillen adjunctions
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              be two
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SimplicialModelCategory"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
              is also a
              %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper model category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#RightProperModelCategory"}
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+adjunction"} enriched adjunction
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EnrichedAdjunction"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi R
                      %mover
                        %mo ⟵
                        %mrow
                          %mphantom
                            %mi AA
                          %mi L
                          %mphantom
                            %mi AA
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    \\underoverset
                    {\underset{R}{\longrightarrow}}
                    {\overset{\phantom{AA}L\phantom{AA}}{\longleftarrow}}
                    {\bot}
                    \\mathcal{D}
            %p
              to be
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              (Def.
              = succeed "," do
                %a.maruku-ref{:href => "#QuillenAdjunction"}
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
                  preserves
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  preserves
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
            %p
              (i.e. this already implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              preserves all
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> Lurie HTT, cor. A.3.7.2
            )
          #SimplicialPresheavesIsProperCombinatorialSimplicial.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
                is
                %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small
              (Def.
