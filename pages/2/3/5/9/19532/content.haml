                    %mi CombModCat
                  %annotation{:encoding => "application/x-tex"} CombModCat
              for the
              %a.existingWikiWord{:href => "/nlab/show/very+large+category"} very large category
              whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CombinatorialModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functors"} left Quillen functors
              between them (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#QuillenAdjunction"}
            %p We write
            %p
              %a.existingWikiWord{:href => "/nlab/show/Ho%28CombModCat%29"} Ho(CombModCat)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≔
                    %mi CombModCat
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msup
                      %mi QuillenEquivs
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %annotation{:encoding => "application/x-tex"} \coloneqq CombModCat\big[ QuillenEquivs^{-1}\big]
            %p
              for its
              %a.existingWikiWord{:href => "/nlab/show/localization"} localization
