            %p
              to be a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
              with respect to the
              %em projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                      %annotation{:encoding => "application/x-tex"} \mathbf{X}
                  is degreewise a
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                  of
                  %a.existingWikiWord{:href => "/nlab/show/representable+presheaves"} representable presheaves
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mi X
                          %mi k
                        %mspace{:width => "thickmathspace"}
                        %mo ≃
                        %mspace{:width => "thickmathspace"}
                        %munder
