            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+quadruple"} Quillen adjoint quadruple
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#QuillenAdjointTriple"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒞
