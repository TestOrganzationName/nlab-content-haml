                          %mi Fib
                          %mi 𝒟
                      %mrow
                        %msub
                          %mi p
                          %mi c
                    %mi c
                  %annotation{:encoding => "application/x-tex"}
                    Q(c) \underoverset{ \in W_{\mathcal{D}} \cap Fib_{\mathcal{D}} }{p_c}{\longrightarrow} c
            %p
              but regarded in the model structure
