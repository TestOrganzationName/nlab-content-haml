                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{D}_{loc}
                    \\underoverset
                    {\underset{\phantom{AA}id\phantom{AA}}{\longrightarrow}}
                    {\overset{id}{\longleftarrow}}
                    {{}_{\phantom{Qu}} \bot_{Qu}}
