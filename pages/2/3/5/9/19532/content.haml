            %p
              are weak equivalences. But now by the ordinary adjunction hom-isomorphism
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (?)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msup
                              %mi 𝒞
                              %mi op
                            %mo ,
                            %mi sSet
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} (
                            %munder
                              %mi lim
                              %mo ⟶
                            %mi X
