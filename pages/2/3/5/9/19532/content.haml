              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
              %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
              (by Prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#SimplicialPresheavesIsProperCombinatorialSimplicial"}
              %a.maruku-ref{:href => "#RecognitionOfSimplicialQuillenAdjunction"}
