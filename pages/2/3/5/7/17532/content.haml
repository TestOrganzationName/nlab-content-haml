          .num_prop
            %h6#proposition_2 Proposition
            %p
              The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi G
                    %mo{:lspace => "verythinmathspace"} :
                    %mi G
                    %mi Set
                    %mo →
                    %msup
                      %mi G
                      %mi δ
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} i_G \colon G Set \to G^\delta Set
              has a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi G
                    %mo :
                    %msup
                      %mi G
                      %mi δ
                    %mo →
                    %mi G
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} r_G: G^\delta \to G Set
              such that for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi G
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} X \in G Set
              = succeed "-set" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi r
                      %mi G
                    %mi X
                  %annotation{:encoding => "application/x-tex"} r_G X
              is the subset of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              consisting of those points with open
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stabilizer"} stabilizer subgroup
          .proof
            %h6#proof_2 Proof
            %p
              This follows from the observation that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f \colon X \to Y
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant function
              between
              = succeed "-sets," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)
              includes the stabilizer of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi G
                      %mi δ
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U \colon G^\delta Set \to Set
              %a.existingWikiWord{:href => "/nlab/show/created+limit"} creates
              all
              %a.existingWikiWord{:href => "/nlab/show/small+limit"} small
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
          .proof
            %h6#proof_3 Proof
            %p
              This follows from the general fact that limits and colimits in
              %a.existingWikiWord{:href => "/nlab/show/presheaf+categories"} presheaf categories
              are computed pointwise.
            %p
              Alternatively, there is an obvious
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-sets." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              The creating limits part also comes from the fact that the forgetful functor is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/monadic"} monadic
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The inclusion
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi G
                    %mo :
                    %mi G
                    %mi Set
                    %mo →
                    %msup
                      %mi G
                      %mi δ
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} i_G: G Set \to G^\delta Set
              %a.existingWikiWord{:href => "/nlab/show/created+limit"} creates
              all
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and all
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
          .proof
            %h6#proof_4 Proof
            %p
              This follows from the observation that the finite limits and colimits created by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo :
                    %msup
                      %mi G
                      %mi δ
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} U: G^\delta Set \to Set
              have a continuous action if each factor has a continuous action, using the fact that finite intersections and arbitrary unions of open sets are open.
          .num_cor
            %h6#corollary Corollary
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} G Set
              has all
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              and arbitrary
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
          .num_cor
            %h6#corollary_2 Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi G
                    %mo ⊣
                    %msub
                      %mi r
                      %mi G
                  %annotation{:encoding => "application/x-tex"} i_G \dashv r_G
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
          .num_cor
            %h6#corollary_3 Corollary
            %p
              A map in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} G Set
              is a
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              if and only if it is
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              if and only if it is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/surjective+function"} surjective
          .proof
            %h6#proof_5 Proof
            %p
              A map is monic if and only if its
              %a.existingWikiWord{:href => "/nlab/show/kernel+pair"} kernel pair
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
