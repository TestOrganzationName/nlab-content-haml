          .num_cor
            %h6#corollary_4 Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} G Set
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \Omega = 2
              %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial
              = succeed "-action." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .num_prop
            %h6#proposition_5 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi G
                      %mi δ
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} G^\delta Set
              is defined by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Y
                        %mi X
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mtext functions
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mo →
                      %mi Y
                      %mo{:stretchy => "false"} }
