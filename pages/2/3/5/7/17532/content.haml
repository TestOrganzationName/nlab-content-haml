                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (S(G, \mathcal{U}), At)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi 𝒰
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S(G, \mathcal{U})
              are the open subgroups in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} \mathcal{U}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} H \to K
              are the left cosets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mi K
                  %annotation{:encoding => "application/x-tex"} a K
              such that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo ⊆
                      %mi a
                      %mi K
                      %msup
                        %mi a
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} H \subseteq a K a^{-1}
            %p
              Alternatively, it is the full subcategory of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} G Set
              containing objects of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi U
                    %annotation{:encoding => "application/x-tex"} G/U
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi 𝒰
                    %annotation{:encoding => "application/x-tex"} U \in \mathcal{U}
          %p
            In particular, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a discrete group, then the
            %a.existingWikiWord{:href => "/nlab/show/trivial+subgroup"} trivial subgroup
            itself is a cofinal set of open subgroups. So
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Set
                %annotation{:encoding => "application/x-tex"} G Set
            is the category of sheaves on the category with only one object, whose morphisms are the elements of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Set
                %annotation{:encoding => "application/x-tex"} G Set
            as the
            %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Set
                      %mi G
                  %annotation{:encoding => "application/x-tex"} Set^G
          %h3#as_a_comonad_algebra As a comonad algebra
          %p To be included.
          %h3#as_a_classifying_topos As a classifying topos
          %p To be included.
          %h2#InternalGroupActions For internal group actions
          %p
            The above construction of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Set
                %annotation{:encoding => "application/x-tex"} G Set
            – of
            %a.existingWikiWord{:href => "/nlab/show/G-sets"} G-sets
            for a
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            in the
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            of
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            – generalizes to
            %a.existingWikiWord{:href => "/nlab/show/group+objects"} group objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mi Groups
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \in Groups(\mathcal{E})
            in any
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            The resulting category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} G\mathcal{E}
            – of
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            equipped with
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            and with
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/equivariant+function"} equivariant
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            between them – is itself a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            = succeed "." do
              %a.maruku-ref{:href => "#GSetsIsAnElementaryTopos"}
          %p
            A particularly interesting case of this is an
            %a.existingWikiWord{:href => "/nlab/show/internal+group"} internal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            in the topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Set
                %annotation{:encoding => "application/x-tex"} G Set
            itself, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            (a “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-
            %a.existingWikiWord{:href => "/nlab/show/equivariant+group"}> equivariant group
            ”, see there for more):
          %p
            Seen externally this is equivalently a discrete group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} Aut
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \to \Aut(H)
            to the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %a.existingWikiWord{:href => "/nlab/show/semidirect+product+group"} semidirect product
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⋊
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \rtimes G
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              be a
              %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} G Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H (G Set)
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo ⋊
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} (H \rtimes G) Set
          .proof
            %h6#proof_sketch Proof sketch
            %p
              This is a straightforward computation. Given an
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi H
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mi Set
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \in H (G Set)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi H
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mu \colon H \times X \to X
              for the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              morphism, and denote the action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              merely by a dot. Then we define the action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⋊
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \rtimes G
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi h
                    %mo ,
                    %mi g
                    %mo ⋅
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ((h, g), x) \mapsto \mu(h, g \cdot x)
                    \\,.
            %p
              Conversely, given an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with an
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⋊
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \rtimes G
              action, we give it a
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              action by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ⋅
                      %mi x
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi e
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi x
                    %annotation{:encoding => "application/x-tex"} g \cdot x = (e, g) \cdot x
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi h
                      %mo ,
                      %mi e
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi x
                    %annotation{:encoding => "application/x-tex"} \mu(h, x) = (h, e) \cdot x
          %p
            The case of
            %a.existingWikiWord{:href => "/nlab/show/topological+groups"} topological groups
            is more complicated, because an internal topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            on a space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an internally complete lattice
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo ⊆
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T \subseteq P(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            an external topological space. Then we have the following result:
          .num_prop
            %h6#proposition_7 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              be a topological group object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} G Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H (G Set)
              is equivalent to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo ⋊
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} (H \rtimes G) Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⋊
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \rtimes G
              is given the product topology.
          %p
            The
            %strong proof
            is a straightforward check that the continuity conditions match up.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/G-set"} G-set
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+G-space"} topological G-space
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fraenkel-Mostowski+model"} Fraenkel-Mostowski model
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/class+equation"} class equation
          %h2#references References
          %p
            Basic exposition of the topos of
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/discrete+groups"} discrete groups
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jaap+van+Oosten"}> Jaap van Oosten
              , (eg. p. 32 in:)
              %em Topos Theory
              (2018) &amp;lbrack;
              %a{:href => "https://webspace.science.uu.nl/~ooste110/syllabi/topostheory.pdf"}> pdf
              ,
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/vanOosten-ToposTheory.pdf", :title => "pdf"} pdf
          %p
            Some elementary properties of continuous
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %ul
            %li#MaclaneMoerdijk
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Sheaves+in+Geometry+and+Logic"} Sheaves in Geometry and Logic
              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/book/10.1007/978-1-4612-0927-0"} doi:10.1007/978-1-4612-0927-0
          %p
            The formal correspondence between permutation models of
            %a.existingWikiWord{:href => "/nlab/show/ZFA"} ZFA
            and toposes of continuous
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Fourman"}> Michael Fourman
              ,
              = succeed "," do
                %em Sheaf models for set theory
              %strong 19
              (1980) pp 91-101, doi:
              %a{:href => "http://dx.doi.org/10.1016/0022-4049%2880%2990096-1"}> 10.1016/0022-4049(80)90096-1
              , (
              %a{:href => "http://www.sciencedirect.com/science/article/pii/0022404980900961/pdf?md5=0de18da810657bf1ba9de7399d224ec5&pid=1-s2.0-0022404980900961-main.pdf"}> publisher pdf
              )
