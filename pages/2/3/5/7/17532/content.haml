              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi G
                      %mo ×
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \mu \colon G \times X \to X
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
