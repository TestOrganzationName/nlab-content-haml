                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    g \cdot f = g \circ f \circ g^{-1}.
            %p
              The exponential object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Y^X
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} G Set
              is given by the subset of the functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \to Y
              that have an open
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mi X
                    %mo =
                    %msub
                      %mi r
                      %mi G
                    %mo{:stretchy => "false"} (
                    %msub
