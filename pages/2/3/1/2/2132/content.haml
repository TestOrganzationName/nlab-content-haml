                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %msup
                    %mi Ω
                    %mrow
                      %mn 0
                      %mo ,
                      %mn 1
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} Hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 2
                  %mi T
                  %mo ⊗
                  %msup
                    %mi T
                    %mrow
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 2
                      %mo{:stretchy => "false"} )
                  %mo ,
