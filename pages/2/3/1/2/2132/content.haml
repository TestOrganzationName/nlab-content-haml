                      %mi X
                      %mo ,
                      %mi T
                      %mo ⊗
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^{\bullet - 1}(X, T \otimes A)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/module"} module
            %p
          %p
            Moreover, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a Kähler manifold then this graded Lie algebra admits a lift to a
            %a.existingWikiWord{:href => "/nlab/show/L-infinity-algebra"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
              \-algebra
            on the shifted
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Dolbeault+complex"} Dolbeault complex
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+metric"} Kähler metric
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            with
            %a.existingWikiWord{:href => "/nlab/show/connection"} connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            consider
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ∇
                      %mo ˜
                    %mo =
                    %mo ∇
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mover
                      %mo ∂
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \widetilde{\nabla} = \nabla + \overline{\partial}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mo ∂
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{\partial}
            is the
            = succeed "-connection" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+structure"} complex manifold
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mo ∇
                    %mo ˜
                %annotation{:encoding => "application/x-tex"} \widetilde{\nabla}
            is the Dolbeault representative of the
            %a.existingWikiWord{:href => "/nlab/show/Atiyah+Lie+algebroid"} Atiyah class
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mrow
                        %msub
                          %mi T
                          %mi X
                  %annotation{:encoding => "application/x-tex"} \alpha_{T_X}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                %annotation{:encoding => "application/x-tex"} h
            being Kähler the connection is torsionless and the curvature
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 2
                    %mi T
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
