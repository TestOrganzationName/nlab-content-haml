                        %mn 0
                        %mo ,
                        %msub
                          %mi j
                          %mn 1
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi ⋯
