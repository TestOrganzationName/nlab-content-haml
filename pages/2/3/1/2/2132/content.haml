                    %mi T
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "1em"}
                    %mi n
                    %mo ≥
                    %mn 2
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    b_n
                    \\,\colon\,
                    \\Omega^{0, j_1}(T)
                    \\otimes \cdots \otimes
                    \\Omega^{0, j_n}(T)
                    \\longrightarrow
                    \\Omega^{0, j_1 + \cdots + j_n + 1}(T)
                    \\,, \quad
                    n \geq 2,
            %p
              given by composing the
              %a.existingWikiWord{:href => "/nlab/show/wedge+product"} wedge product
              (with values in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
