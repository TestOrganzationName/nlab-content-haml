          %p
          .num_theorem
            %h6 Theorem
            %p
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be any
              %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              be any
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaf"} quasicoherent sheaf
              of commutative
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒪
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{O}_X
            %p
              (a) The maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi T
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi H
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi T
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi H
                      %mrow
                        %mi i
                        %mo +
                        %mi j
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi T
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^i(X, T \otimes A) \otimes H^j(X, T \otimes A) \longrightarrow H^{i+j+1}(X, T \otimes A)
              = succeed "given" do
                %br/
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mrow
                          %msub
                            %mi T
                            %mi X
                      %mo ∈
                      %msup
                        %mi H
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi{:mathvariant => "normal"} Hom
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 2
                      %mi T
                      %mo ,
                      %mi T
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha_{T_X} \in H^1(X, \mathrm{Hom}(S^2 T, T))
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi T
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{\bullet - 1}(X, T \otimes A)
              into a
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %p
              (b) For any
              %a.existingWikiWord{:href => "/nlab/show/holomorphic+vector+bundle"} holomorphic vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi T
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %msup
                      %mi H
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi E
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mrow
                        %mi i
                        %mo +
                        %mi j
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi E
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^i(X, T \otimes A) \otimes H^j(X, E \otimes A) \to H^{i+j+1}(X, E \otimes A)
              given by composing the
              %a.existingWikiWord{:href => "/nlab/show/cup-product"} cup-product
              with the
              %a.existingWikiWord{:href => "/nlab/show/Atiyah+class"} Atiyah class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi E
                    %mo ∈
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi{:mathvariant => "normal"} Hom
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo ⊗
                    %mi E
                    %mo ,
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} \alpha_E \in H^1(X, \mathrm{Hom}(T \otimes E, E)),
              make
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi E
                    %mo ⊗
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{\bullet - 1}(X, E \otimes A)
              into a
              %a.existingWikiWord{:href => "/nlab/show/graded+module"} graded
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mrow
                          %mo •
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
