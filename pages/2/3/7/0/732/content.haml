          %title Contents
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#results"} Results
              %li
                %a{:href => "#the_groupoid_tcomplex_associated_to_a_simplicial_groupoid"} The group(oid) T-complex associated to a simplicial group(oid)
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            A
            %strong
              group
              = succeed "-complex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            is ‘’a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+T-complex"} simplicial T-complex
            internal to the category of groups’’. They were first studied in Nick Ashley’s thesis (see references below for the published version)
          %p More precisely:
          %h2#definition Definition
          %p
            A
            %strong
              group
              = succeed "-complex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
            is a pair,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G,T)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a graded subgroup of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            consisting of
            %em thin
            elements, and which satisfies the conditions:
          %ul
            %li Every degenerate element is thin.
            %li
              Every
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              has a unique thin filler.
            %li A thin filler of a thin box also has its last face thin.
          %h2#results Results
          .un_lemma
            %h6#lemma Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} D = (D_n)_{n\geq 1}
              be the graded subgroup of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              generated by the images of the degeneracy maps,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi i
                      %mo :
                      %msub
                        %mi G
                        %mi n
                      %mo →
                      %msub
                        %mi G
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} s_i :G_n \rightarrow G_{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              has a filler in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
          .proof
            %h6#proof Proof
            %p
              The algorithmic formulae used when proving that any simplicial group is a Kan complex (cf., entry on
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D_n
          .un_proposition
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G,T)
              is a group
              = succeed "-complex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo =
                      %mi D
                    %annotation{:encoding => "application/x-tex"} T = D
          .proof
            %h6#proof_2 Proof
            %p
              To see this, we note that as every degenerate element is this,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo ⊆
                      %mi T
                    %annotation{:encoding => "application/x-tex"} D \subseteq T
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ∈
                      %msub
                        %mi T
                        %mi n
                    %annotation{:encoding => "application/x-tex"} t \in T_n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %msub
                        %mi d
                        %mn 1
                      %mi t
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi d
                        %mi n
                      %mi t
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (  - , d_1t, \ldots, d_n t )
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo =
                      %mi d
                    %annotation{:encoding => "application/x-tex"} t = d
          %p
            This is neat. It says there is basically only one possible group
            = succeed "-complex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .un_proposition
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is a simplicial group, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G,D)
              is a group
              = succeed "-complex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi NG
                    %mo ∩
                    %mi D
                  %annotation{:encoding => "application/x-tex"} NG\cap D
              is the trivial graded subgroup.
          .proof
            %h6#proof_3 Proof
            %p
              One way around, this is nearly trivial. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G,D)
              is a group
              = succeed "-complex" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi NG
                        %mi n
                    %annotation{:encoding => "application/x-tex"} x\in NG_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              fills a box
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-, 1, \ldots, 1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msub
                        %mi NG
                        %mi n
                      %mo ∩
                      %msub
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} x\in NG_n\cap D_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              must itself be the thin filler, however 1 is also a thin filler for this box, so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} x = 1
              as required.
            %p
              Conversely if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi NG
                      %mo ∩
                      %mi D
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} NG\cap D = \{1\}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              are in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi th
                  %annotation{:encoding => "application/x-tex"} k^{th}
              face missing) then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo =
                    %msup
                      %mi xy
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} z = xy^{-1}
              fills a box with 1s on all faces (and the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mi th
                  %annotation{:encoding => "application/x-tex"} k^{th}
              face missing).
            %p
              If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k = 0
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ∈
                      %msub
                        %mi NG
                        %mi n
                      %mo ∩
                      %msub
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} z \in NG_n\cap D_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} z = 1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              are equal. If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k \gt 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mo &lt;
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \ell \lt k
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ∈
                    %msub
                      %mi D
                      %mi n
                    %mo ∩
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi i
                        %mo ≠
                        %mi ℓ
                    %mi Ker
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi d
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    z \in D_n \cap
                    \\bigcap_{i\neq \ell} Ker\, d_i
              then
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} z = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi st
                  %annotation{:encoding => "application/x-tex"} (k-1)^{st}
              case). Consider
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo =
                      %msub
                        %mi zs
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                      %msub
                        %mi d
                        %mi k
                      %msup
                        %mi z
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} w = zs_{k-1}d_k z^{-1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D_n
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %mi w
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} d_i w = 1
              unless
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mi k
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} i = k-1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} w = 1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo =
                      %msub
                        %mi s
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                      %msub
                        %mi d
                        %mi kz
                    %annotation{:encoding => "application/x-tex"} z = s_{k-1}d_kz
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                      %mi z
                      %mo =
                      %msub
                        %mi d
                        %mi k
                      %mi z
                    %annotation{:encoding => "application/x-tex"} d_{k-1} z = d_k z
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                      %mi z
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} d_{k-1} z = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi k
                    %mi z
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} d_k z = 1
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} z = 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x = y
              and we have uniqueness at the next stage.
            %p
              To verify the third axiom, assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi D
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} x \in D_{n + 1}
              and each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %mi x
                    %mo ∈
                    %msub
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} d_i x \in D_n
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ≠
                      %mi k
                    %annotation{:encoding => "application/x-tex"} i \neq k
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} k = 0
            %p
              Suppose therefore that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi i
                    %mi x
                    %mo ∈
                    %msub
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} d_i x \in D_n
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo &lt;
                      %mi i
                      %mo &lt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 0 \lt i \lt n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              must be the degenerate filler given by the standard method, we can calculate
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              as follows:
            %p
              let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi w
                        %mi n
                      %mo =
                      %msub
                        %mi s
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %msub
                        %mi d
                        %mi n
                      %mi x
                    %annotation{:encoding => "application/x-tex"} w_n = s_{n-1}d_n x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi w
                      %mi i
                    %mo =
                    %msub
                      %mi w
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi s
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %msub
                      %mi d
                      %mi i
                    %msub
                      %mi w
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msub
                      %mi s
                      %mrow
                        %mi i
                        %mo −
                        %mn 1
                    %msub
                      %mi y
                      %mi i
                  %annotation{:encoding => "application/x-tex"} w_i = w_{i+1}(s_{i-1}d_i w_{i+1})^{-1}s_{i-1}y_i
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      i =
                      1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo =
                      %msub
                        %mi w
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} x = w_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 0
                    %mi x
                    %mo ∈
                    %msub
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} d_0x \in D_n
              as required.
          %h2#the_groupoid_tcomplex_associated_to_a_simplicial_groupoid The group(oid) T-complex associated to a simplicial group(oid)
          %p
            This suggests that, given an arbitrary simplicial group(oid),
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-complex," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi NG
                      %mi n
                    %mo ∩
                    %msub
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} NG_n\cap D_n
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi NG
                      %mi n
                    %mo ∩
                    %msub
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} NG_n\cap D_n
              need not be a normal subgroup of
              = succeed "!" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi n
                    %annotation{:encoding => "application/x-tex"} G_n
          %p
            A variant of the idea does however work. We concentrate on the case of simplicial groups. The extension to simplicial groupoids is then straightforward. We need the Conduché non-Abelian version of the
            %a.existingWikiWord{:href => "/nlab/show/decomposition+theorem+for+simplicial+groups"} decomposition theorem for simplicial groups
            that makes up an important part of the Dold-Kan correspondence. With that we note the fairly obvious point that when we divide out by a graded subgroup in a simplicial group, then it has effects in all dimensions due to the face and degeneracy maps, so if we kill elements in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi NG
                    %mi n
                  %mo ∩
                  %msub
                    %mi D
                    %mi n
                %annotation{:encoding => "application/x-tex"} NG_n\cap D_n
            in all dimensions, we must also kill
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi NG
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo ∩
                  %msub
                    %mi D
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} d_0(NG_{n+1}\cap D_{n+1})
            and all the
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi NG
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ∩
                    %msub
                      %mi D
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} s_k(NG_{n-1}\cap D_{n-1})
            = succeed "-complex" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %a.existingWikiWord{:href => "/nlab/show/crossed+complex"} crossed complex
            structure in a natural way.
          %p
            It is easier to give the corresponding formula for the equivalent crossed complex to this group
            = succeed "-complex." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi G
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo =
                  %mfrac
                    %mrow
                      %mi 𝒩
                      %msub
                        %mi G
                        %mi n
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒩
                      %msub
                        %mi G
                        %mi n
                      %mo ∩
                      %msub
                        %mi D
                        %mi n
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi d
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi 𝒩
                      %msub
                        %mi G
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo ∩
                      %msub
                        %mi D
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
