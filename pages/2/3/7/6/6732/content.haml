                %a.existingWikiWord{:href => "/nlab/show/Alexander+A.+Migdal"}> Alexander A. Migdal
                ,
                = succeed "," do
                  %em
                    Loop equations and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mi N
                        %annotation{:encoding => "application/x-tex"} 1/N
                    expansion
                %strong 102
                (4) 199-290 (1983) &amp;lbrack;
                %a{:href => "https://doi.org/10.1016%2F0370-1573%2883%2990076-5"}> doi
                \&amp;rbrack;
            %li
              %p
                M. Bershadsky, Z. Kakushadze,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed "," do
                  %em
                    String expansion as large
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                    expansion of gauge theories
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/hep-th/9803076"} hep-th/9803076
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.1016/S0550-3213(98)00272-7"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gary+Horowitz"}> Gary Horowitz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hirosi+Ooguri"} Hirosi Ooguri
                = succeed "," do
                  %em
                    Spectrum of large
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                    gauge theory from supergravity
            %li
              %p
                S. Sinha,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SO
                      %annotation{:encoding => "application/x-tex"} SO
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sp
                      %annotation{:encoding => "application/x-tex"} Sp
                  Chern-Simons at Large
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                (
                %a{:href => "https://arxiv.org/abs/hep-th/0012136"}> arXiv:hep-th/0012136
                )
              %p
                (for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory+as+a+topological+string+theory"} Chern-Simons theory as a topological string theory
            %li
              %p
                Hiroyuki Fuji, Yutaka Ookouchi,
                = succeed "," do
                  %em
                    Confining Phase Superpotentials for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi SO
                          %mo{:stretchy => "false"} /
                          %mi Sp
                        %annotation{:encoding => "application/x-tex"} SO/Sp
                    Gauge Theories via Geometric Transition
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0205301"} arXiv:hep-th/0205301
            %li#OoguriVafa02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hirosi+Ooguri"}> Hirosi Ooguri
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed "," do
                  %em
                    Worldsheet derivation of a large
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                    duality
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0205297"} arXiv:hep-th/0205297
            %li
              %p
                Semyon Klevtsov,
                = succeed "," do
                  %em Random normal matrices, Bergman kernel and projective embeddings
                %a{:href => "https://doi.org/10.1007JHEP01(2014)133"} doi
                %a{:href => "https://arxiv.org/abs/1309.7333"} arXiv:1309.7333
            %li
              %p
                Jan Albert, Johan Henriksson,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Leonardo+Rastelli"} Leonardo Rastelli
                %em
                  Bootstrapping mesons at large
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2312.15013"}> arXiv:2312.15013
                \&amp;rbrack;
          %p
            On a kind of
            %a.existingWikiWord{:href => "/nlab/show/BV-quantization"} BV-quantization
            of the
            %a.existingWikiWord{:href => "/nlab/show/Loday-Quillen-Tsygan+theorem"} Loday-Quillen-Tsygan theorem
            and relating to the
            %a.existingWikiWord{:href => "/nlab/show/large+N+limit"}
              large
              = succeed "-limit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gr%C3%A9gory+Ginot"}> Grégory Ginot
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Owen+Gwilliam"} Owen Gwilliam
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alastair+Hamilton"} Alastair Hamilton
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mahmoud+Zeinalian"} Mahmoud Zeinalian
                = succeed "," do
                  %em
                    Large
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N
                    phenomena and quantization of the Loday-Quillen-Tsygan theorem
                %strong 409A
                (2022) 108631 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2108.12109"}> arXiv:2108.12109
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2022.108631"} doi:10.1016/j.aim.2022.108631
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Owen+Gwilliam"}> Owen Gwilliam
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alastair+Hamilton"} Alastair Hamilton
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mahmoud+Zeinalian"} Mahmoud Zeinalian
                %em A homological approach to the Gaussian Unitary Ensemble
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2206.04256"}> arXiv:2206.04256
                \&amp;rbrack;
          %p
            In the context of
            %a.existingWikiWord{:href => "/nlab/show/effective+field+theory"} effective
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+field+theory"} noncommutative field theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alastair+Hamilton"}> Alastair Hamilton
              ,
              %em
                Noncommutative effective field theories and the large
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                correspondence
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2505.13678"}> arxiv:2505.13678
              \&amp;rbrack;
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/logical+equivalence"} logical equivalence
            between the
            %a.existingWikiWord{:href => "/nlab/show/four-colour+theorem"} four-colour theorem
            and a statement about transition from the
            %a.existingWikiWord{:href => "/nlab/show/small+N+limit"} small N limit
            to the
            %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} large N limit
            for
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
            on
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            via the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/%27t+Hooft+double+line+construction"} 't Hooft double line construction
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dror+Bar-Natan"}> Dror Bar-Natan
              ,
              = succeed "," do
                %em Lie Algebras and the Four Color Theorem
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/q-alg/9606016"} arXiv:q-alg/9606016
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BF01196130"} doi:10.1007/BF01196130
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} large N limit
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/lattice+gauge+theory"} lattice gauge theory
          %ul
            %li
              Margarita Garcia Perez,
              %em
                Prospects for large
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                gauge theories on the lattice
              (
              %a{:href => "https://arxiv.org/abs/2001.10859"}> arXiv:2001.10859
              )
          %p See also:
          %ul
            %li
              Marco Bochicchio, Mauro Papinutto, Francesco Scardino,
              %em
                On the structure of the large-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                expansion in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(N)
                Yang-Mills theory
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2401.09312"}> arXiv:2401.09312
              \&amp;rbrack;
          %h3#openclosed_string_duality Open/closed string duality
          %p
            On the role of
            %a.existingWikiWord{:href => "/nlab/show/open%2Fclosed+string+duality"} open/closed string duality
            in interpreting the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/large+N+limit"} large N limit
          %ul
            %li#GopakumarVafa98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rajesh+Gopakumar"}> Rajesh Gopakumar
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Cumrun+Vafa"} Cumrun Vafa
                = succeed "," do
                  %em On the Gauge Theory/Geometry Correspondence
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/9811131"} arXiv:hep-th/9811131
            %li#GaiottiRastelli05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Davide+Gaiotto"}> Davide Gaiotto
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Leonardo+Rastelli"} Leonardo Rastelli
                = succeed "," do
                  %em A paradigm of open/closed duality: Liouville D-branes and the Kontsevich model
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0312196"} hep-th/0312196
          %blockquote
            %p
              Nowadays we interpret
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              the
              %a.existingWikiWord{:href => "/nlab/show/%27t+Hooft+double+line+notation"} 't Hooft double line notation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
              quite literally as the perturbative expansion of an open string theory, either because the full open string theory is just equal to the gauge theory (as e.g. for Chern-Simons theory [27]), or because we take an appropriate low-energy limit (as e.g. for N = 4 SYM [31]).
            %p
              The general speculation [1] is that upon summing over the number of holes, (1.1) can be recast as the genus expansion for some closed string theory of coupling
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi s
                      %mo =
                      %msubsup
                        %mi g
                        %mi YM
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} g_s = g_{YM}^2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo →
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} N\to \infty
              and tune
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              to the critical point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi t
                      %mi c
                  %annotation{:encoding => "application/x-tex"} t_c
              where diagrams with a diverging number of holes dominate.
            %p
              However, in AdS/CFT, or in the Gopakumar-Vafa duality [2],
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              is a free parameter, corresponding on the closed string theory side to a geometric modulus. The intuition described above clearly goes wrong here.
            %p A much more fitting way in which the open/closed duality may come about in these cases is for each fatgraph of genus g and with h holes to be replaced by a closed Riemann surface of the same genus g and with h punctures: each hole is filled and replaced by a single closed string insertion.
          %ul
            %li#Gopakumar04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Rajesh+Gopakumar"}> Rajesh Gopakumar
                ,
                = succeed "," do
                  %em Free Field Theory as a String Theory?
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0409233"} hep-th/0409233
            %li#Marino04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marcos+Marino"}> Marcos Marino
                ,
                = succeed "," do
                  %em Chern-Simons Theory and Topological Strings
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0406005"} arXiv:hep-th/0406005
          %p
            In relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quantum+error+correction"} quantum error correction
          %ul
            %li
              Alexey Milekhin,
              %em
                Quantum error correction and large
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
              (
              %a{:href => "https://arxiv.org/abs/2008.12869"}> arXiv:2008.12869
              )
