          %h2#idea Idea
          %p
            For classes of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/super+Yang-Mills+theory"} super
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            or
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            or various
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/matrix+models"} matrix models
            %a.existingWikiWord{:href => "/nlab/show/gauge+groups"} gauge groups
            may be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo ×
                  %mi N
                %annotation{:encoding => "application/x-tex"} N \times N
            %a.existingWikiWord{:href => "/nlab/show/square+matrices"} square matrices
            for any
            %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} special unitary group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(N)
            %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+group"} special orthogonal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO(N)
            or the
            %a.existingWikiWord{:href => "/nlab/show/quaternionic+unitary+group"} quaternionic unitary group
            (“symplectic group”)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sp(N)
            %a.existingWikiWord{:href => "/nlab/show/limit+of+a+sequence"} limit
            of the theory’s
            %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
            and other
            %a.existingWikiWord{:href => "/nlab/show/quantum+observables"} quantum observables
            as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo →
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} N\to \infty
            (“large
            = succeed "-limit\u201D)." do
              %a.existingWikiWord{:href => "/nlab/show/number+of+colours"} number of colours
            %em
              large
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              limit
            scale with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi N
                %annotation{:encoding => "application/x-tex"} 1/N
            and allow a
            %a.existingWikiWord{:href => "/nlab/show/perturbation+series"} perturbation series
            around the large
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            limit called the
            = succeed "." do
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi N
                    %annotation{:encoding => "application/x-tex"} 1/N
                expansion
          %p
            This
            %em
              large
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              limit
            often has remarkable properties, often revealing an otherwise hidden relation to
            %a.existingWikiWord{:href => "/nlab/show/perturbative+string+theories"} perturbative string theories
            with the parameter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi N
                %annotation{:encoding => "application/x-tex"} 1/N
            proportional to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/string+coupling+constant"} string coupling constant
          %p
            Notably for
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            and in particular for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
            = succeed "-behaviour" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%27t+Hooft+double+line+notation"} 't Hooft double line notation
            %a.existingWikiWord{:href => "/nlab/show/%27t+Hooft+coupling"} 't Hooft coupling
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mn 2
                  %mi N
