                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in H^3(X,\mathbb{Z})
              the class of a
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/circle+2-bundle"} circle 2-bundle
              %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi C
                      %mo *
                    %mi Alg
                    %mo →
                    %mi KK
                  %annotation{:encoding => "application/x-tex"}
                    C_c(X) \in C^\ast Alg \to KK
            %p
              for the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/twisted+groupoid+convolution+algebra"} twisted groupoid convolution algebra
              %a.existingWikiWord{:href => "/nlab/show/operator+K-theory"} operator K-theory
              is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi KK
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo ,
