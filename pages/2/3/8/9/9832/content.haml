                    %mo ≃
                    %msub
                      %mi K
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi c
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    KK_\bullet(\mathbb{C}, C_c(X)) \simeq K_{\bullet + c}(X)
                    \\,.
          #DualOfCompactManifoldWithTwist.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              with
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundle"} tangent bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \tau_X
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msup
                      %mi H
                      %mn 3
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in H^3(X,\mathbb{Z})
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twist
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_{c}(X)
              of def.
              %a.maruku-ref{:href => "#CStarAlgebraOf2BundleOnManifold"}
              has a
              %a.existingWikiWord{:href => "/nlab/show/dual+object"} dual object
              in the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
              on
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/separable+C%2A-algebras"} separable C*-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi C
                      %mi c
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∨
                    %mo ≃
                    %msub
                      %mi C
                      %mfrac
                        %mn 1
                        %mrow
                          %mi c
                          %mo ⊗
                          %msub
                            %mi W
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi τ
                            %mi X
                          %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (C_c(X))^\vee
                    \\simeq
                    C_{\frac{1}{c\otimes W_3(\tau_X)}}(X)
                    \\,,
            %p
              hence by the same manifold but with twist the inverse of the third
              %a.existingWikiWord{:href => "/nlab/show/integral+Stiefel-Whitney+class"} integral Stiefel-Whitney class
              and the original twist.
            %p
              The same remains true in
              = succeed "-equivariant" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
          %p
            The non-equivariant case is in (
            %a{:href => "#BrodzkiMathaiRosenbergSzabo06"}> Brodzki-Mathai-Rosenberg-Szabo 06, section 7.3
            ) and the generalization to the equivariant case in (
            %a{:href => "#Tu06"}> Tu 06, theorem 3.1
            ) (where we use remark
            %a.maruku-ref{:href => "#OppositeConvolutionAlgebraAndInverseTwist"}
            in order to interpret the opposite twisted convolution algebra up to equivalence as inducing the inverse twist).
          %h4#PropertiesKOrientationAndUmkehrMaps K-Orientation and Umkehr maps
          %p
            We discuss
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Umkehr+maps"} Umkehr maps
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration+in+generalized+cohomology"} fiber integration in generalized cohomology
            in
            %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
            using Poincaré duality algebras /
            %a.existingWikiWord{:href => "/nlab/show/dual+objects"} dual objects
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Every homomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f \colon A \to B
              between PD
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mo *
                    %annotation{:encoding => "application/x-tex"} C^\ast
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/K-orientation"} K-orientable in KK-theory
              %a.existingWikiWord{:href => "/nlab/show/K-orientation"} K-orientation
              is given by the corresponding
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo !
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f! \colon B \to A
              given as the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo !
                    %mo ≔
                    %msubsup
                      %mi Δ
                      %mi A
                      %mo ∨
                    %msub
                      %mo ⊗
                      %mrow
                        %msup
                          %mi A
                          %mi op
                    %msup
                      %mi f
                      %mi op
                    %msub
                      %mo ⊗
                      %mrow
                        %msup
                          %mi B
                          %mi op
                    %msub
                      %mi Δ
                      %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    f!
                    \\coloneqq
                    \\Delta^\vee_A \otimes_{A^{op}} f^{op} \otimes_{B^{op}} \Delta_B
                    \\,.
          %p
            (
            %a{:href => "#BMRS07"}> BMRS 07, 3.3
            )
          %p More generally we have the following.
          #PushAlongInclusionOfManifoldsAndDBraneCharge.num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Q
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i \colon Q \to X
              be a map of
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %msup
                      %mi B
                      %mn 2
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi \colon X \to B^2 U(1)
              modulate a
              %a.existingWikiWord{:href => "/nlab/show/circle+2-bundle"} circle 2-bundle
              regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twist for K-theory
              %a.existingWikiWord{:href => "/nlab/show/twisted+groupoid+convolution+algebras"} twisted groupoid convolution algebras
              yields a
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
              morphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mi χ
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟵
                      %mrow
                        %msup
                          %mi i
                          %mo *
                    %msub
                      %mi C
                      %mi χ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C_{i^\ast \chi}(Q)
                    \\stackrel{i^\ast}{\longleftarrow}
                    C_{\chi}(X)
                    \\,,
            %p
              with notation as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#CStarAlgebraOf2BundleOnManifold"}
              %a.maruku-ref{:href => "#DualOfCompactManifoldWithTwist"}
              the
              %a.existingWikiWord{:href => "/nlab/show/dual+morphism"} dual morphism
              is of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mfrac
                        %mn 1
                        %mrow
                          %msup
                            %mi i
                            %mo *
                          %mi χ
                          %mo ⊗
                          %msub
                            %mi W
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mi Q
                          %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo !
                    %msub
                      %mi C
                      %mfrac
                        %mn 1
                        %mrow
                          %mi χ
                          %mo ⊗
                          %msub
                            %mi W
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mi X
                          %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    C_{\frac{1}{i^\ast \chi \otimes W_3(T Q)}}(Q)
                    \\stackrel{i_!}{\longrightarrow}
                    C_{\frac{1}{\chi \otimes W_3(T X)}}(X)
                    \\,.
            %p
              If we redefine the twist on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to absorb this “quantum correction” as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo ↦
                    %mfrac
                      %mn 1
                      %mrow
                        %mi χ
                        %mo ⊗
                        %msub
                          %mi W
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %mi T
                        %mi X
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi \mapsto \frac{1}{\chi \otimes W_3(T X)}
              then this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %msup
                          %mi i
                          %mo *
                        %mi χ
                        %mfrac
                          %mrow
                            %msub
                              %mi W
                              %mn 3
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi i
                              %mo *
                            %mi T
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi W
                              %mn 3
                            %mo{:stretchy => "false"} (
                            %mi T
                            %mi Q
                            %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi i
                          %mo !
                    %msub
                      %mi C
                      %mi χ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C_{i^\ast \chi\frac{W_3(i^\ast T X)}{W_3(T Q)}}(Q)
                    \\stackrel{i_!}{\longrightarrow}
                    C_{\chi}(X)
                    \\,,
            %p
              Postcomposition with this map in
              %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
              now yields a map from the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mo *
                      %mi χ
                      %mo ⊗
                      %msub
                        %mi W
                        %mn 3
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mi Q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i^\ast \chi \otimes W_3(N Q)
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} Q
              to the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi χ
                    %annotation{:encoding => "application/x-tex"} \chi
              %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mo !
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi K
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %msub
                          %mi W
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mi Q
                        %mo{:stretchy => "false"} )
                        %mo +
                        %msup
                          %mi i
                          %mo *
                        %mi χ
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi K
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi χ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i_! \colon K_{\bullet + W_3(N Q) + i^\ast \chi}(Q) \to K_{\bullet +\chi}
                    \\,.
            %p
              This is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/twisted+Umkehr+map"} twisted Umkehr map
              in this context.
            %p
              If we here think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi Q
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} i \colon Q \hookrightarrow X
              as being the inclusion of a
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                  %annotation{:encoding => "application/x-tex"} \chi
              would be the class of the
              %a.existingWikiWord{:href => "/nlab/show/background+gauge+field"} background
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
              and an element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi ξ
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi K
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %msub
                          %mi W
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mi Q
                        %mo{:stretchy => "false"} )
                        %mo +
                        %msup
                          %mi i
                          %mo *
                        %mi χ
                    %mo{:stretchy => "false"} (
                    %mi Q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [\xi] \in K_{\bullet + W_3(N Q) + i^\ast \chi}(Q)
            %p
              is called (the K-class of) a
              %em
                %a.existingWikiWord{:href => "/nlab/show/Chan-Paton+gauge+field"} Chan-Paton gauge field
              on the D-brane satisfying the
              %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly+cancellation"} Freed-Witten-Kapustin anomaly cancellation
              mechanism. (The orginal
              %a.existingWikiWord{:href => "/nlab/show/Freed-Witten+anomaly+cancellation"} Freed-Witten anomaly cancellation
              assumes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              given by a
              %a.existingWikiWord{:href => "/nlab/show/twisted+unitary+bundle"} twisted line bundle
              in which case it exhibits a
              %a.existingWikiWord{:href => "/nlab/show/twisted+spin%5Ec+structure"} twisted spin^c structure
              on
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} push-forward
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi i
                      %mo !
                    %mi ξ
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi K
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi χ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [i_! \xi] \in K_{\bullet- \chi}(X)
            %p
              is called the corresponding
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/D-brane+charge"} D-brane charge
          %p
            See (
            %a{:href => "#Nuiten13"}> Nuiten 13
            ).
          %h2#examples Examples
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A = C_0(X)
              the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              on a
              %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
              %a.existingWikiWord{:href => "/nlab/show/complex+manifold"} complex manifold
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is a PD algebra with fundamental class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              in
              %a.existingWikiWord{:href => "/nlab/show/K-homology"} K-homology
              given by the
              %a.existingWikiWord{:href => "/nlab/show/Dolbeault+operator"} Dolbeault operator
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \times X
          %p
            (
            %a{:href => "#BMRS07"}> BMRS 07, example 3.2
            )
          .num_example
            %h6#example_3 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo =
                    %msub
                      %mi C
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A = C_0(X)
              the
              %a.existingWikiWord{:href => "/nlab/show/algebra+of+functions"} algebra of functions
              %a.existingWikiWord{:href => "/nlab/show/vanishing+at+infinity"} vanishing at infinity
              of a
              %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/spin%5Ec+structure"} spin^c structure
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo =
                      %msub
                        %mi C
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi T
                        %mo *
                      %mi X
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ≃
                        %mi KK
                      %msup
                        %mi A
                        %mi op
                      %mo ≃
                      %mi A
                    %annotation{:encoding => "application/x-tex"} B = C_0(T^\ast X) \simeq_{KK} A^{op} \simeq A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              constructed from the
              %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
              on the
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra+bundle"} Clifford algebra bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi T
                      %mo *
                    %mi X
                  %annotation{:encoding => "application/x-tex"} T^\ast X
              is a fundamental class.
          %p
            (
            %a{:href => "#BMRS07"}> BMRS 07, proof of theorem 2.9
            )
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fundamental+class"} fundamental class
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/virtual+fundamental+class"} virtual fundamental class
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+duality+complex"} Poincaré duality complex
          %h2#references References
          %h3#for_graded_associative_algebras For graded associative algebras
          %ul#LambrechstStanley07
            %li
              Pascal Lambrechts, Don Stanley,
              %em Poincaré duality and commutative differential graded algebras
              (
              %a{:href => "http://arxiv.org/abs/math/0701309"}> arXiv:math/0701309
              )
          %h3#for_algebras_3
            For
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo *
                  %annotation{:encoding => "application/x-tex"} C^\ast
          %p
            For
            = succeed "/in" do
              %a.existingWikiWord{:href => "/nlab/show/C%2A-algebras"} C*-algebras
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+topology"} noncommutative topology
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Henri+Moscovici"}> Henri Moscovici
              ,
              = succeed "," do
                %em Eigenvalue inequalities and Poincaré duality in noncommutative geometry
          %p
            Chapter 6.4
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            (starting p. 601) in
          %ul#Connes
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alain+Connes"}> Alain Connes
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Noncommutative+Geometry"} Noncommutative Geometry
          %p Def. 2.1 in
          %ul#BMRS07
            %li
              Jacek Brodzki,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"} Richard Szabo
              = succeed "," do
                %em Noncommutative correspondences, duality and D-branes in bivariant K-theory
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0708.2648"} arXiv:0708.2648
          %p
            Duality including the
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            induced by
            %a.existingWikiWord{:href => "/nlab/show/twisted+spin%5Ec+structure"} twisted spin^c structure
            over
            %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
            is discussed in section 7 of
          %ul#BrodzkiMathaiRosenbergSzabo06
            %li
              Jacek Brodzki,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Richard+Szabo"} Richard Szabo
              = succeed "," do
                %em D-Branes, RR-Fields and Duality on Noncommutative Manifolds
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/0607020"} arXiv:hep-th/0607020
          %p
            and generalized to equivariant
            %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            in
          %ul#Tu06
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Tu"}> Jean-Louis Tu
              ,
              %em Twisted K-theory and Poincaré duality
              (
              %a{:href => "http://arxiv.org/abs/math/0609556"}> arXiv:math/0609556
              )
          %p More on dual objects in KK is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Heath+Emerson"}> Heath Emerson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ralf+Meyer"} Ralf Meyer
                = succeed "," do
                  %em Bivariant K-theory via correspondences
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/0812.4949"} arXiv:0812.4949
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Heath+Emerson"}> Heath Emerson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ralf+Meyer"} Ralf Meyer
                %em Dualities in equivariant Kasparov theory
                (
                %a{:href => "http://arxiv.org/abs/0711.0025"}> arXiv:0711.0025
                )
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/twisted+Umkehr+map"} twisted Umkehr map
            and the
            %a.existingWikiWord{:href => "/nlab/show/Freed-Witten-Kapustin+anomaly"} Freed-Witten-Kapustin anomaly
            in this context is in
          %ul#Nuiten13
            %li
              %a.existingWikiWord{:href => "/nlab/show/Joost+Nuiten"}> Joost Nuiten
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/master+thesis+Nuiten"} Cohomological quantization of local prequantum boundary field theory
        .revisedby
