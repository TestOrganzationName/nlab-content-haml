                    %mo ,
                    %mi ⋯
                    %msub
                      %mi y
                      %mi r
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y} \coloneqq \{y_1, \cdots y_r\}
              for sets of spacetime points, and hence abbreviate the expression for the “value” of the generalized function in the above as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(\mathbf{X}, \mathbf{Y})
              etc.
            %p In this condensed notation the above reads
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∫
                      %mrow
                        %msup
                          %mi Σ
                          %mrow
                            %mi r
                            %mo +
                            %mi s
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi g
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %msub
                      %mi g
                      %mi r
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi r
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi j
                      %mrow
                        %mi r
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mrow
                        %mi r
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %msub
                      %mi j
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mrow
                        %msup
                          %mi Σ
                          %mrow
                            %mi r
                            %mo +
                            %mi s
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{\Sigma^{r+s}}{\int}
                    T(\mathbf{X}, \mathbf{Y})
                    \\,
                    g_1(x_1) \cdots g_r(x_r)
                    j_{r+1}(x_{r+1}) \cdots j_n(x_n)
                    \\,
                    dvol_{\Sigma^{r+s}}(\mathbf{X})
                    \\,.
          %p This condensed notation turns out to be greatly simplify computations, as it absorbs all the “relative” combinatorial prefactors:
          #ProductOfPerturbationSeriesInGenealizedFunctionNotation.num_example
            %h6#example_4 Example
            %p
              %strong
                (product of perturbation series in
                = succeed "-notation)" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %mfrac
                      %mn 1
                      %mrow
                        %mi n
                        %mo !
                    %mo ∫
                    %mi U
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi dvol
                  %annotation{:encoding => "application/x-tex"}
                    U(g)
                    \\coloneqq
                    \\underoverset{n = 0}{\infty}{\sum}
                    \\frac{1}{n!}
                    \\int U(x_1, \cdots, x_n)
                    \\,
                    g(x_1) \cdots g(x_n) \, dvol
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %mfrac
                      %mn 1
                      %mrow
                        %mi n
                        %mo !
                    %mo ∫
                    %mi V
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi dvol
                  %annotation{:encoding => "application/x-tex"}
                    V(g)
                    \\coloneqq
                    \\underoverset{n = 0}{\infty}{\sum}
                    \\frac{1}{n!}
                    \\int V(x_1, \cdots, x_n)
                    \\,
                    g(x_1) \cdots g(x_n) \, dvol
            %p
              be power series of
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              %a.existingWikiWord{:href => "/nlab/show/distributions"} distributions
              in the
              = succeed "-notation" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
              = succeed "." do
                %a.maruku-ref{:href => "#NotationForTimeOrderedProductsAsGeneralizedFunctions"}
            %p
              Then their product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(g) \coloneqq U(g) V(g)
              with
              = succeed "-representation" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %mfrac
                      %mn 1
                      %mrow
                        %mi n
                        %mo !
                    %mo ∫
                    %mi W
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mi ⋯
                    %mi g
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi dvol
                  %annotation{:encoding => "application/x-tex"}
                    W(g)
                    \\coloneqq
                    \\underoverset{n = 0}{\infty}{\sum}
                    \\frac{1}{n!}
                    \\int W(x_1, \cdots, x_n)
                    \\,
                    g(x_1) \cdots g(x_n) \, dvol
            %p is given simply by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mo ⊂
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi I
                    %mo{:stretchy => "false"} )
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ∖
                    %mstyle{:mathvariant => "bold"}
                      %mi I
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    W(\mathbf{X})
                    \\;=\;
                    \\underset{\mathbf{I} \subset \mathbf{X}}{\sum} U(\mathbf{I}) V(\mathbf{X} \setminus \mathbf{I})
                    \\,.
          %p
            (
            %a{:href => "S-matrix#EpsteinGlaser73"}> Epstein-Glaser 73 (5)
            )
          .proof
            %h6#proof_7 Proof
            %p
              For fixed
              %a.existingWikiWord{:href => "/nlab/show/cardinality"} cardinality
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mstyle{:mathvariant => "bold"}
                        %mi I
                      %mo{:stretchy => "false"} |
                    %mo =
                    %msub
                      %mi n
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} {\vert \mathbf{I} \vert} = n_1
              the sum over all subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi I
                    %mo ⊂
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbf{I} \subset \mathbf{X}
              overcounts the sum over
              %a.existingWikiWord{:href => "/nlab/show/partitions"} partitions
              of the coordinates as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi ⋯
                    %msub
                      %mi x
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ,
                    %msub
                      %mi x
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %mn 1
                    %mo ,
                    %mi ⋯
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1, \cdots x_{n_1}, x_{n_1 + 1}, \cdots x_n)
              precisely by the
              %a.existingWikiWord{:href => "/nlab/show/binomial+coefficient"} binomial coefficient
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi n
                          %mo !
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo !
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo −
                          %msub
                            %mi n
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo !
                    %annotation{:encoding => "application/x-tex"} \frac{n!}{n_1! (n - n_1) !}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo !
                  %annotation{:encoding => "application/x-tex"} n!
              cancels against the “global” combinatorial prefactor in the above expansion of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(g)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo !
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %msub
                          %mi n
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo !
                  %annotation{:encoding => "application/x-tex"} \frac{1}{n_1! (n - n_1) !}
              is just the “relative” combinatorial prefactor seen at total order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              when expanding the product
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(g)V(g)
          %p
            In order to prove that the axioms for
            %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
            do imply those for a perturbative
            %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            (prop.
            %a.maruku-ref{:href => "#TimeOrderedProductInducesPerturbativeSMatrix"}
            below) we need to consider the corresponding reverse-time ordered products:
          #ReverseTimeOrderedProduct.num_defn
            %h6#definition_11 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/reverse-time+ordered+products"}> reverse-time ordered products
                )
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi T
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} T = \{T_k\}_{k \in \mathbb{N}}
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TimeOrderedProduct"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/reverse-time+ordered+product"} reverse-time ordered product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi T
                        %mo ¯
                      %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                      %mi LocObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi ℏ
                      %mo ,
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                      %mo )
                    %mo ⟶
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℏ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{T}_k
                    \\;\colon\;
                    \\left(
                    {\, \atop \,}
                    LocObs(E_{\text{BV-BRST}})[ [\hbar, g, j] ]
                    {\, \atop \,}
                    \\right)
                    \\longrightarrow
                    PolyObs(E_{\text{BV-BRST}})((\hbar))[ [g, j] ]
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              is defined by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi T
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mn 1
                    %mi ⋯
                    %msub
                      %mi A
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %munderover
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi r
                                  %mo =
                                  %mn 1
                                %mi n
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi r
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                %mrow
                                  %mi σ
                                  %mo ∈
                                  %mi Unshuffl
                                  %mo{:stretchy => "false"} (
                                  %mi n
                                  %mo ,
                                  %mi r
                                  %mo{:stretchy => "false"} )
                              %mi T
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi A
                                %mrow
                                  %mi σ
                                  %mo{:stretchy => "false"} (
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mi ⋯
                              %msub
                                %mi A
                                %mrow
                                  %mi σ
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi k
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mi T
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi A
                                %mrow
                                  %mi σ
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi k
                                    %mn 1
                                  %mo +
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mi ⋯
                              %msub
                                %mi A
                                %mrow
                                  %mi σ
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi k
                                    %mn 2
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mi ⋯
                              %mi T
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi A
                                %mrow
                                  %mi σ
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi k
                                    %mrow
                                      %mi r
                                      %mo −
                                      %mn 1
                                  %mo +
                                  %mn 1
                                  %mo{:stretchy => "false"} )
                              %mi ⋯
                              %msub
                                %mi A
                                %mrow
                                  %msub
                                    %mi σ
                                    %mrow
                                      %msub
                                        %mi k
                                        %mi r
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo ≥
                              %mn 1
                          %mtr
                            %mtd
                              %mn 1
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi k
                              %mo =
                              %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\overline{T}( A_1 \cdots A_n )
                    \\;\coloneqq\;
                    \\left\{
                    \\array{
                    \\underoverset{r = 1}{n}{\sum}
                    (-1)^r
                    \\underset{\sigma \in Unshuffl(n,r)}{\sum}
