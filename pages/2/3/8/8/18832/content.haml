            %p
              With this the statement follows by the definition of
              %a.existingWikiWord{:href => "/nlab/show/vacuum+stability"} vacuum stability
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#VacuumStability"}
          .num_remark
            %h6#remark_4 Remark
            %p
              %strong
                (computing
                %a.existingWikiWord{:href => "/nlab/show/S-matrices"} S-matrices
                via
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
            %p
              For practical computation of
              %a.existingWikiWord{:href => "/nlab/show/vacuum+expectation+values"} vacuum expectation values
              of
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#InteractinFieldTimeOrderedProduct"}
              = succeed "," do
                %a.maruku-ref{:href => "#ScatteringAmplitudeFromInteractingFieldObservables"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in increasing order in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            %p
              Such a method is provided by the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
              (example
              %a.maruku-ref{:href => "#FeynmanPerturbationSeries"}
              below) and the
              %em
                %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#InPerturbationTheoryActionEffective"}
              %a.maruku-ref{:href => "#SMatrixVacuumContribution"}
              below.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#RemarksOnCausalPerturbationTheoryAxioms
            %strong Conceptual remarks
          %p
            The simple axioms for
            %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            %a.existingWikiWord{:href => "/nlab/show/renormalization+scheme"} schemes
            in
            %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
            %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
            (def.
            = succeed ")" do
              %a.maruku-ref{:href => "#InteractingFieldObservables"}
          #AsymptoticSeriesObservables.num_remark
            %h6#remark_5 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative QFT
                and
                %a.existingWikiWord{:href => "/nlab/show/asymptotic+expansion"} asymptotic expansion
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/probability+amplitudes"} probability amplitudes
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              %a.existingWikiWord{:href => "/nlab/show/renormalization+scheme"} scheme
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              %a.maruku-ref{:href => "#FormalPowerSeriesInteractingFieldObservables"}
              the
              %a.existingWikiWord{:href => "/nlab/show/expectation+values"} expectation values
              of
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InteractingFieldObservables"}
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in the formal parameters
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              (which are interpreted as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo ⟨
                      %msub
                        %mi A
                        %mi int
                      %mo ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\langle A_{int} \right\rangle
                    \\;\in\;
                    \\mathbb{C}[ [\hbar, g] ]
                    \\,.
            %p
              This means that there is
              %em no
              guarantee that these series
              %em
                %a.existingWikiWord{:href => "/nlab/show/convergence"} converge
              for any
              %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive
              value of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              and/or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
              this means that in
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              the
              %a.existingWikiWord{:href => "/nlab/show/deformation"} deformation
              of the
              %a.existingWikiWord{:href => "/nlab/show/classical+field+theory"} classical
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
              by quantum effects (measured by
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
              %a.existingWikiWord{:href => "/nlab/show/interactions"} interactions
              (meaured by
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal"} infinitesimal
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              in a space of
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theories"} Lagrangian field theories
              at the point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \hbar = 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} g = 0
            %p
              In fact, a simple argument (due to
              = succeed ")" do
                %a{:href => "perturbative+quantum+field+theory#Dyson52"} Dyson 52
              %em never
              converge for
              %em any
              %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive
              value of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              and/or
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              would imply a
              %a.existingWikiWord{:href => "/nlab/show/positive+real+number"} positive
              %em
                %a.existingWikiWord{:href => "/nlab/show/radius+of+convergence"} radius of convergence
              around
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} g = 0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi g
                  %annotation{:encoding => "application/x-tex"} -g
              and even for
              %a.existingWikiWord{:href => "/nlab/show/imaginary+number"} imaginary
              values of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %a.existingWikiWord{:href => "/nlab/show/interactions"} interactions
              for which no converging field theory is to be expected. (See
              %a{:href => "perturbative+quantum+field+theory#Helling"} Helling, p. 4
              for the example of
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/phi%5E4+theory"} phi^4 theory
            %p
              In physical practice one tries to interpret these non-converging
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              as
              %em
                %a.existingWikiWord{:href => "/nlab/show/asymptotic+expansions"} asymptotic expansions
              of actual but hypothetical functions in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                      %mo ,
                      %mi g
                    %annotation{:encoding => "application/x-tex"} \hbar, g
              %em
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative quantum field theory
              that one imagines is being approximated by
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              methods. An
              %em
                %a.existingWikiWord{:href => "/nlab/show/asymptotic+expansion"} asymptotic expansion
              of a function is a
              %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
              which may not converge, but which has for every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              an estimate for how far the
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              of the first
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              terms in the series may differ from the function being approximated.
            %p
              For examples such as
              %a.existingWikiWord{:href => "/nlab/show/quantum+electrodynamics"} quantum electrodynamics
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quantum+chromodynamics"} quantum chromodynamics
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
              to the first handful of
              %a.existingWikiWord{:href => "/nlab/show/loop+orders"} loop orders
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              happens to agree with
              %a.existingWikiWord{:href => "/nlab/show/experiment"} experiment
              (such as at the
              %a.existingWikiWord{:href => "/nlab/show/LHC"} LHC
              collider) to high precision (for
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/QED"} QED
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
              = succeed ")." do
                %a.maruku-ref{:href => "#AdiabaticLimit"}
            %p
              In summary this says that
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              is an extremely
              %em coarse
              and restrictive approximation to what should be genuine
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative quantum field theory
            %p
              This is strong motivation for going beyond
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              to understand and construct genuine
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative quantum field theory
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting field theory
              in
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≥
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} \geq 4
              has been non-perturbatively quantized. Already a single aspect of the
              %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative
              %a.existingWikiWord{:href => "/nlab/show/quantization+of+Yang-Mills+theory"} quantization of Yang-Mills theory
              (as in
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/QCD"} QCD
              %em
                %a{:href => "http://www.claymath.org/millennium-problems/yang%E2%80%93mills-and-mass-gap"} Millennium Problems
              of our age; and speculation about
              %a.existingWikiWord{:href => "/nlab/show/non-perturbative+quantum+field+theory"} non-perturbative
              %a.existingWikiWord{:href => "/nlab/show/quantum+gravity"} quantum gravity
              is the subject of much activity.
            %p
              Now, as the name indicates, the
              %a.existingWikiWord{:href => "/nlab/show/axioms"} axioms
              of
              %em
                %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              %em not
              address
              %a.existingWikiWord{:href => "/nlab/show/non-perturbative+effect"} non-perturbative aspects
              of
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/non-perturbative+field+theory"} non-perturbative field theory
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              that are axiomatized by
              %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InteractingFieldObservables"}
              %em not
              addressed by the theory. The point of the axioms of
              %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
              is to give rigorous mathematical meaning to
              %em everything else
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
          #DysonCausalFactorization.num_remark
            %h6#remark_6 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Dyson+series"} Dyson series
                and
                %a.existingWikiWord{:href => "/nlab/show/Schr%C3%B6dinger+equation"} Schrödinger equation
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/interaction+picture"} interaction picture
            %p
              The axiom “
              %a.existingWikiWord{:href => "/nlab/show/causal+additivity"}> causal additivity
              ”
              %a.maruku-eqref{:href => "#eq:CausalAdditivity"} (5)
              on an
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              scheme (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              %a.maruku-ref{:href => "#CausalFactorizationAlreadyImpliesSMatrix"}
              below):
            %ul
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/causal+factorization"}> causal factorization
                  )
                %p
                  For all
                  %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi O
                          %mn 1
                        %mo ,
                        %msub
                          %mi O
                          %mn 2
                        %mo ∈
                        %mi LocObs
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mtext BV-BRST
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi ℏ
                        %mo ,
                        %mi h
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ⟨
                        %mi g
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} ⟩
                      %annotation{:encoding => "application/x-tex"} O_1, O_2 \in LocObs(E_{\text{BV-BRST}})[ [\hbar, h, j] ]\langle g , j\rangle
                  we have
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mi supp
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo ∨
                            %mspace{:width => "negativethinmathspace"}
                            %mspace{:width => "negativethinmathspace"}
                            %mspace{:width => "negativethinmathspace"}
                            %mo ∧
                          %mi supp
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⇒
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 1
                          %mo +
                          %msub
                            %mi O
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mo )
                      %annotation{:encoding => "application/x-tex"}
                        \\left(
                        {\, \atop \,}
                        supp(O_1) {\vee\!\!\!\wedge} supp(O_2)
                        {\, \atop \,}
                        \\right)
                        \\;\; \Rightarrow \;\;
                        \\left(
                        {\, \atop \,}
                        \\mathcal{S}( O_1 + O_2 )
                        \=
                        \\mathcal{S}( O_1 ) \, \mathcal{S}( O_2 )
                        {\, \atop \,}
                        \\right)
            %p
              (This is the special case of “causal additivity” for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi O
                        %mn 0
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} O_0 = 0
              %a.maruku-eqref{:href => "#eq:ExponentialSeriesScatteringMatrix"} (4)
              we have
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}(0) = 1
            %p
              If we now think of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mn 1
                    %mo =
                    %mi g
                    %msub
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} O_1 = g S_{1}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi O
                      %mn 2
                    %mo =
                    %mi g
                    %msub
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} O_2 = g S_2
              themselves as
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action+functionals"} action functionals
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∨
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo ∧
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⇒
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                      %mi 𝒮
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msub
                        %mi S
                        %mn 1
                      %mo +
                      %mi g
                      %msub
                        %mi S
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi 𝒮
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msub
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mi 𝒮
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msub
                        %mi sS
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %mrow
                          %mspace{:width => "thinmathspace"}
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    {\, \atop \,}
                    supp(S_1) {\vee\!\!\!\wedge} supp(S_2)
                    {\, \atop \,}
                    \\right)
                    \\;\; \Rightarrow \;\;
                    \\left(
                    {\, \atop \,}
                    \\mathcal{S}( g S_1 + g S_2 )
                    \=
                    \\mathcal{S}( g S_1) \, \mathcal{S}( g sS_2)
                    {\, \atop \,}
                    \\right)
            %p
              This exhibits the
              = succeed "-scheme" do
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              %a.existingWikiWord{:href => "/nlab/show/causal+ordering"} causally ordered
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/Dyson+series"} Dyson series
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic field theory
              of what in
              %a.existingWikiWord{:href => "/nlab/show/quantum+mechanics"} quantum mechanics
              is the “integral version of the
              %a.existingWikiWord{:href => "/nlab/show/Schr%C3%B6dinger+equation"} Schrödinger equation
              in the
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/interaction+picture"} interaction picture
              %a{:href => "S-matrix#IntegralVersionSchroedingerEquationInInteractionPicture"} this equation
              at
              = succeed ";" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              = succeed ")." do
                %a{:href => "S-matrix#Scharf95"} Scharf 95, second half of 0.3
            %p
              The relevance of manifest
              %a.existingWikiWord{:href => "/nlab/show/causal+additivity"} causal additivity
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              %a.existingWikiWord{:href => "/nlab/show/causal+factorization"} causal factorization
              (even though both conditions happen to be equivalent, see prop.
              %a.maruku-ref{:href => "#CausalFactorizationAlreadyImpliesSMatrix"}
              below), is that it directly implies that the induced
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+algebra+of+observables"} interacting field algebra of observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InteractingFieldObservables"}
              %a.existingWikiWord{:href => "/nlab/show/causally+local+net"} causally local net
              (prop.
              %a.maruku-ref{:href => "#PerturbativeQuantumObservablesIsLocalnet"}
              below).
          #InterpretationOfPerturbativeSMatrix.num_remark
            %h6#remark_7 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/path+integral"}> path integral
                \-intuition)
            %p
              In informal discussion of
              %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              going back to informal ideas of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Schwinger-Tomonaga-Feynman-Dyson"} Schwinger-Tomonaga-Feynman-Dyson
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              is thought of in terms of a would-be
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mrow
                      %mo (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo =
                      %mtext not really!
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %munder
                      %mo ∫
                      %mrow
                        %mi Φ
                        %mo ∈
                        %msub
                          %mi Γ
                          %mi Σ
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mtext BV-BRST
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi asm
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mi exp
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mi i
                            %mi ℏ
                      %msub
                        %mo ∫
                        %mi Σ
                      %mrow
                        %mo (
                        %mi g
                        %msub
                          %mi L
                          %mi int
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi j
                        %mi A
                        %mo{:stretchy => "false"} (
                        %mi Φ
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mi exp
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mrow
                            %mi i
                            %mi ℏ
                      %msub
                        %mo ∫
                        %mi Σ
                      %msub
                        %mi L
                        %mi free
                      %mo{:stretchy => "false"} (
                      %mi Φ
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mi D
                    %mo{:stretchy => "false"} [
                    %mi Φ
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}\left(
                    g S_{int} + j A
                    \\right)
                    \\;\overset{\text{not really!}}{=}\;
                    \\!\!\!\!\!
                    \\underset{\Phi \in \Gamma_\Sigma(E_{\text{BV-BRST}})_{asm}}{\int}
                    \\!\!\!\!\!\!
                    \\exp\left(
                    \\tfrac{1}{i \hbar}
                    \\int_\Sigma
                    \\left(
                    g L_{int}(\Phi) + j A(\Phi)
                    \\right)
                    \\right)
                    \\,
                    \\exp\left(
                    \\tfrac{1}{i \hbar}\int_\Sigma L_{free}(\Phi)
                    \\right) D[\Phi]
                    \\,.
            %p
              Here the would-be
              %a.existingWikiWord{:href => "/nlab/show/integration"} integration
              is thought to be over the
              %a.existingWikiWord{:href => "/nlab/show/space+of+field+histories"} space of field histories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi asm
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E_{\text{BV-BRST}})_{asm}
              (the
              %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} space of sections
              of the given
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              = succeed ")" do
                %a.maruku-ref{:href => "#PossibleFieldHistories"}
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              which satisfy given asymptotic conditions at
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 0
                      %mo →
                      %mo ±
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} x^0 \to \pm \infty
              %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
              that defines the required operator in the
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              (e.g.
              = succeed ")." do
                %a{:href => "S-matrix#Weinberg95"} Weinberg 95, around (9.3.10) and (9.4.1)
              %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
              (example
              %a.maruku-ref{:href => "#FeynmanPerturbationSeries"}
              below) expressing a sum over all possible interactions of
              %a.existingWikiWord{:href => "/nlab/show/virtual+particles"} virtual particles
              (remark
              = succeed ")." do
                %a.maruku-ref{:href => "#WorldlineFormalism"}
            %p
              Beyond toy examples, it is not known how to define the would-be
              %a.existingWikiWord{:href => "/nlab/show/measure"} measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} [
                    %mi Φ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} D[\Phi]
              and it is not known how to make sense of this expression as an actual
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/integral"} integral
            %p
              The analogous path-integral intuition for
              %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
              for
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InteractingFieldObservables"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi int
                          %mtd
                            %mover
                              %mo =
                              %mtext not really!
                            %mfrac
                              %mi d
                              %mrow
                                %mi d
                                %mi j
                            %mi ln
                            %mrow
                              %mo (
                              %munder
                                %mo ∫
                                %mrow
                                  %mi Φ
                                  %mo ∈
                                  %msub
                                    %mi Γ
                                    %mi Σ
                                  %mo{:stretchy => "false"} (
                                  %mi E
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mi asm
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mi exp
                              %mrow
                                %mo (
                                %munder
                                  %mo ∫
                                  %mi Σ
                                %mi g
                                %msub
                                  %mi L
                                  %mi int
                                %mo{:stretchy => "false"} (
                                %mi Φ
                                %mo{:stretchy => "false"} )
                                %mo +
                                %mi j
                                %mi A
                                %mo{:stretchy => "false"} (
                                %mi Φ
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mspace{:width => "thinmathspace"}
                              %mi exp
                              %mrow
                                %mo (
                                %munder
                                  %mo ∫
                                  %mi Σ
                                %msub
                                  %mi L
                                  %mi free
                                %mo{:stretchy => "false"} (
                                %mi Φ
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mi D
                              %mo{:stretchy => "false"} [
                              %mi Φ
                              %mo{:stretchy => "false"} ]
                              %mo )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %mi j
                                %mo =
                                %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_{int}
                    \&amp; \overset{\text{not really!}}{=}
                    \\frac{d}{d j}
                    \\ln
                    \\left(
                    \\underset{\Phi \in \Gamma_\Sigma(E)_{asm}}{\int}
                    \\!\!\!\!
                    \\exp\left(
                    \\underset{\Sigma}{\int}
                    g L_{int}(\Phi) + j A(\Phi)
                    \\right)
                    \\,
                    \\exp\left( \underset{\Sigma}{\int} L_{free}(\Phi) \right)
                    D[\Phi]
                    \\right)
                    \\vert_{j = 0}
                    \\end{aligned}
            %p If here we were to regard the expression
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mo ≔
                      %mtext not really!
                    %mspace{:width => "thickmathspace"}
