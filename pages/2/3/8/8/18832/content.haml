            %p
              Multiplying both sides of
              %a.maruku-eqref{:href => "#eq:CausalAdditivity"} (5)
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mn 0
