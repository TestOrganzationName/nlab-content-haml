                %a.maruku-ref{:href => "#ReverseTimeOrderedProduct"}
              = succeed "." do
                %a.maruku-ref{:href => "#ReverseTimOrderedProductsGiveReverseSMatrix"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(-,-)
              are also called the “generating
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/retarded+products"} retarded products
              %a.maruku-ref{:href => "#RetardedProductFromPerturbativeSMatrix"}
              below.)
            %p
              In the condensed notation of remark
              %a.maruku-ref{:href => "#NotationForTimeOrderedProductsAsGeneralizedFunctions"}
              and its way of absorbing combinatorial prefactors as in example
              %a.maruku-ref{:href => "#ProductOfPerturbationSeriesInGenealizedFunctionNotation"}
              this yields at order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} /
                    %mi ℏ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                        %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} /
                    %mi ℏ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mstyle{:mathvariant => "bold"}
                          %mi X
                        %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} (g/\hbar)^{\vert \mathbf{Y}\vert} (j/\hbar)^{\vert \mathbf{X}\vert}
              the coefficient
            #eq:CoefficientOfgeneratingRetardedProduct.maruku-equation
              %span.maruku-eq-number (13)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi I
                        %mo ⊂
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                    %mover
                      %mi T
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi I
                    %mo{:stretchy => "false"} )
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ∖
                    %mstyle{:mathvariant => "bold"}
                      %mi I
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R(\mathbf{Y}, \mathbf{X})
                    \\;=\;
                    \\underset{\mathbf{I} \subset \mathbf{Y}}{\sum}
                    \\overline{T}(\mathbf{I})
                    T( (\mathbf{Y} \setminus \mathbf{I}) , \mathbf{X} )
                    \\,.
            %p
              We claim now that the
              %a.existingWikiWord{:href => "/nlab/show/support+of+a+distribution"} support
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is inside the subset for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              is in the
              %a.existingWikiWord{:href => "/nlab/show/causal+past"} causal past
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} R(-,-)
              it then follows that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ∨
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mspace{:width => "negativethinmathspace"}
                        %mo ∧
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mo ⇒
                    %mrow
                      %mo (
                      %msub
                        %mi Z
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi g
                          %msub
                            %mi S
                            %mi int
                          %mo +
                          %mi j
                          %msub
                            %mi A
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi j
                      %msub
                        %mi A
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi Z
                        %mrow
                          %msub
                            %mi S
                            %mi int
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi A
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(supp(A_1) {\vee\!\!\!\wedge} supp(A_2)\right)
                    \\Rightarrow
                    \\left( Z_{(g S_{int}  + j A_1)}(j A_2) = Z_{S_{int}}(A_2) \right)
            %p
              and by prop.
              %a.maruku-ref{:href => "#ZCausalAdditivity"}
              this is equivalent to
              %a.existingWikiWord{:href => "/nlab/show/causal+additivity"} causal additivity
              of the S-matrix.
            %p It remains to prove the claim:
            %p
              Consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \mathbf{X}, \mathbf{Y} \subset \Sigma
              such that the subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                    %mo ⊂
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{P} \subset \mathbf{Y}
              of points not in the past of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}
              %a.existingWikiWord{:href => "/nlab/show/causal+ordering"} causal ordering
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{P} {\vee\!\!\!\wedge} \mathbf{X}
                    \\,,
            %p
              is non-empty. We need to show that in this case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} R(\mathbf{Y}, \mathbf{X}) = 0
              (in the sense of generalized functions).
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mo ≔
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                    %mo ∖
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \mathbf{Q} \coloneqq \mathbf{Y} \setminus \mathbf{P}
              for the complementary set of points, so that all points of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} \mathbf{Q}
              are in the past of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}
              is also not in the past of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} \mathbf{Q}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{P} {\vee\!\!\!\wedge} \mathbf{Q}
                    \\,.
            %p
              With this decomposition of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              %a.maruku-eqref{:href => "#eq:CoefficientOfgeneratingRetardedProduct"} (13)
              over subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi I
                  %annotation{:encoding => "application/x-tex"} \mathbf{I}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              may be decomposed into a sum over subsets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi J
                  %annotation{:encoding => "application/x-tex"} \mathbf{J}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi P
                  %annotation{:encoding => "application/x-tex"} \mathbf{P}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi K
                  %annotation{:encoding => "application/x-tex"} \mathbf{K}
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Q
                    %annotation{:encoding => "application/x-tex"} \mathbf{Q}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(-)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TimeOrderedProduct"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi T
                      %mo ¯
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \overline{T}(-)
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#ReverseCausalFactorizationOfReverseTimeOrderedProducts"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi R
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi Y
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mstyle{:mathvariant => "bold"}
                                      %mi J
                                    %mo ⊂
                                    %mstyle{:mathvariant => "bold"}
                                      %mi P
                                %mrow
                                  %mrow
                                    %mstyle{:mathvariant => "bold"}
                                      %mi K
                                    %mo ⊂
                                    %mstyle{:mathvariant => "bold"}
                                      %mi Q
                            %mspace{:width => "thinmathspace"}
                            %mover
                              %mi T
                              %mo ¯
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi J
                            %mo ∪
                            %mstyle{:mathvariant => "bold"}
                              %mi K
                            %mo{:stretchy => "false"} )
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi P
                            %mo ∖
                            %mstyle{:mathvariant => "bold"}
                              %mi J
                            %mo{:stretchy => "false"} )
                            %mo ∪
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi Q
                            %mo ∖
                            %mstyle{:mathvariant => "bold"}
                              %mi K
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mstyle{:mathvariant => "bold"}
                                      %mi J
                                    %mo ⊂
                                    %mstyle{:mathvariant => "bold"}
                                      %mi P
                                %mrow
                                  %mrow
                                    %mstyle{:mathvariant => "bold"}
                                      %mi K
                                    %mo ⊂
                                    %mstyle{:mathvariant => "bold"}
                                      %mi Q
                            %mspace{:width => "thinmathspace"}
                            %mover
                              %mi T
                              %mo ¯
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi K
                            %mo{:stretchy => "false"} )
                            %mover
                              %mi T
                              %mo ¯
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi J
                            %mo{:stretchy => "false"} )
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi P
                            %mo ∖
                            %mstyle{:mathvariant => "bold"}
                              %mi J
                            %mo{:stretchy => "false"} )
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi Q
                            %mo ∖
                            %mstyle{:mathvariant => "bold"}
                              %mi K
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi K
                                %mo ⊂
                                %mstyle{:mathvariant => "bold"}
                                  %mi Q
                            %mover
                              %mi T
                              %mo ¯
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi K
                            %mo{:stretchy => "false"} )
                            %munder
                              %munder
                                %mrow
                                  %mo (
                                  %munder
                                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                    %mrow
                                      %mstyle{:mathvariant => "bold"}
                                        %mi J
                                      %mo ⊂
                                      %mstyle{:mathvariant => "bold"}
                                        %mi P
                                  %mover
                                    %mi T
                                    %mo ¯
