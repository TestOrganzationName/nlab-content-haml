                  %annotation{:encoding => "application/x-tex"} g_{sw} \in Cautoff(\mathcal{O})
              constant over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
