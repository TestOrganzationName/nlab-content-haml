                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\mathcal{S}(g S_{int})
                    \&amp; =
                    \\exp_\cdot\left( \tfrac{1}{i \hbar} S_{eff,vac}(g,j) \right)
                    \\\
                    \&amp; =
                    \\underset{\Gamma \in \mathcal{G}_{vac}}{\sum}
                    \\Gamma\left(g S_{int}\right)
                    \\end{aligned}
                    \\,.
            %p
              More generally, the S-matrix with
              = succeed "-contribution" do
                %a.existingWikiWord{:href => "/nlab/show/source+field"} source field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mi A
                  %annotation{:encoding => "application/x-tex"} j A
              included always splits as a
              %em pointwise
              product of the vacuum S_matrix with the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
              over all
              %a.existingWikiWord{:href => "/nlab/show/Feynman+graphs"} Feynman graphs
              with at least one external vertex:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
