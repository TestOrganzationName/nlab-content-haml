                      %annotation{:encoding => "application/x-tex"} W(j)
                  or
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi E
                          %mo{:stretchy => "false"} (
