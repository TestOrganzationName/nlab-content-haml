                                    %mi P
                                  %mo ∖
                                  %mstyle{:mathvariant => "bold"}
                                    %mi J
                                  %mo{:stretchy => "false"} )
                                  %mo )
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                            %mi T
                            %mo{:stretchy => "false"} (
                            %mstyle{:mathvariant => "bold"}
                              %mi Q
                            %mo ∖
                            %mstyle{:mathvariant => "bold"}
                              %mi K
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi X
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    R(\mathbf{Y}, \mathbf{X})
                    \&amp; =
                    \\underset{ {\mathbf{J} \subset \mathbf{P}} \atop { \mathbf{K} \subset \mathbf{Q} } }{\sum}
                    \\,
                    \\overline{T}( \mathbf{J} \cup \mathbf{K} )
                    T( (\mathbf{P} \setminus \mathbf{J}) \cup (\mathbf{Q} \setminus \mathbf{K}), \mathbf{X} )
                    \\\
                    \&amp; =
                    \\underset{ {\mathbf{J} \subset \mathbf{P}} \atop { \mathbf{K} \subset \mathbf{Q} } }{\sum}
                    \\,
                    \\overline{T}( \mathbf{K} )
                    \\overline{T}( \mathbf{J} )
                    T( \mathbf{P} \setminus \mathbf{J} )
                    T( \mathbf{Q} \setminus \mathbf{K}, \mathbf{X} )
                    \\\
                    \&amp; =
                    \\underset{ \mathbf{K} \subset \mathbf{Q} }{\sum}
                    \\overline{T}(\mathbf{K})
                    \\underset{= 0}{
                    \\underbrace{
                    \\left(
                    \\underset{\mathbf{J} \subset \mathbf{P}}{\sum}
                    \\overline{T}(\mathbf{J})
                    T( \mathbf{P} \setminus \mathbf{J} )
                    \\right)
                    }}
                    T(\mathbf{Q} \setminus \mathbf{K}, \mathbf{X})
                    \\end{aligned}
                    \\,.
            %p
              Here the sub-sum in brackets vanishes by the inversion formula, prop.
              = succeed "." do
                %a.maruku-ref{:href => "#InversionFormulaForTimeOrderedProducts"}
          %p In conclusion:
          #CausalFactorizationAlreadyImpliesSMatrix.num_prop
            %h6#proposition_10 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
                scheme via
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/causal+factorization"} causal factorization
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
