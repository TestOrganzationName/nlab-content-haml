          %p
            After having discussed the uniqueness of the
            %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
            away from coinciding spacetime arguments (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalizing
            them.
          #ExtensionOfTimeOrderedProoductsRenormalization.num_defn
            %h6#definition_16 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Epstein-Glaser+renormalization"} Epstein-Glaser ("re"-)normalization
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#VacuumFree"}
            %p
              Prop.
              %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
              implies that the problem of constructing a sequence of
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#TimeOrderedProduct"}
              = succeed "," do
                %a.maruku-ref{:href => "#TimeOrderedProductInducesPerturbativeSMatrix"}
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              scheme (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
              around the given
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              %em
                %a.existingWikiWord{:href => "/nlab/show/extensions+of+distributions"} extensions of distributions
              of the
              %a.existingWikiWord{:href => "/nlab/show/star+products"} star products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo ⋆
                            %mi F
                          %mi ⋯
                          %msub
                            %mo ⋆
                            %mi F
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mi k
                        %mspace{:width => "thickmathspace"}
                        %mtext arguments
