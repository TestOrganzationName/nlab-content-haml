                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g_{sw} \in Cutoffs(\mathcal{O})
              an
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatic switching
              function (def.
              = succeed ")" do
