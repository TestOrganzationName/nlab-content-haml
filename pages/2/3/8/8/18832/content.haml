                            %mn 1
                          %annotation{:encoding => "application/x-tex"}
                            T_0( g S_{int} + j A) = 1
                  %li
                    %p
                      The unary map is the inclusion of
                      %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                      as
                      %a.existingWikiWord{:href => "/nlab/show/normal-ordered+products"} normal-ordered products
                      %a.maruku-eqref{:href => "#eq:NormalOrderingLocalObservables"} (2)
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi T
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msub
                              %mi S
                              %mi int
                            %mo +
                            %mi j
                            %mi A
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi g
                            %mo :
                            %msub
                              %mi S
                              %mi int
                            %mo :
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mi j
                            %mo :
                            %mi A
                            %mo :
                          %annotation{:encoding => "application/x-tex"}
                            T_1(g S_{int} + j A) = g :S_{int}: + j :A:
                  %li
                    %p
                      The perturbative S-matrix is the
                      %a.existingWikiWord{:href => "/nlab/show/exponential+series"} exponential series
                      of these maps in that for all
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi g
                            %msub
                              %mi S
                              %mi int
                            %mo +
                            %mi j
                            %mi A
                            %mo ∈
                            %mi LocObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
                            %mo{:stretchy => "false"} [
                            %mi ℏ
                            %mo ,
                            %mi g
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} ⟨
                            %mi g
                            %mo ,
                            %mi j
                            %mo{:stretchy => "false"} ⟩
                          %annotation{:encoding => "application/x-tex"} g S_{int} + j A  \in LocObs(E_{\text{BV-BRST}})[ [\hbar , g, j] ]\langle g,j\rangle
                    #eq:ExponentialSeriesScatteringMatrix.maruku-equation
                      %span.maruku-eq-number (4)
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mrow
                              %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                                %mtr
                                  %mtd
                                    %mi 𝒮
                                    %mo{:stretchy => "false"} (
                                    %mi g
                                    %msub
                                      %mi S
                                      %mi int
                                    %mo +
                                    %mi j
                                    %mi A
                                    %mo{:stretchy => "false"} )
                                  %mtd
                                    %mo =
                                    %mi T
                                    %mrow
                                      %mo (
                                      %msub
                                        %mi exp
                                        %mo ⊗
                                      %mrow
                                        %mo (
                                        %mstyle{:displaystyle => "false"}
                                          %mfrac
                                            %mn 1
                                            %mrow
                                              %mi i
                                              %mi ℏ
                                        %mrow
                                          %mo (
                                          %mi g
                                          %msub
                                            %mi S
                                            %mi int
                                          %mo +
                                          %mi j
                                          %mi A
                                          %mo )
                                        %mo )
                                      %mo )
                                %mtr
                                  %mtd
                                  %mtd
                                    %mo ≔
                                    %munderover
                                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                      %mrow
                                        %mi k
                                        %mo =
                                        %mn 0
                                      %mn ∞
                                    %mfrac
                                      %mn 1
                                      %mrow
                                        %mi k
                                        %mo !
                                    %msup
                                      %mrow
                                        %mo (
                                        %mfrac
                                          %mn 1
                                          %mrow
                                            %mi i
                                            %mi ℏ
                                        %mo )
                                      %mi k
                                    %msub
                                      %mi T
                                      %mi k
                                    %mrow
                                      %mo (
                                      %mfrac{:linethickness => "0"}
                                        %mrow
                                          %mspace{:width => "thinmathspace"}
                                        %mrow
                                          %mspace{:width => "thinmathspace"}
                                      %munder
                                        %munder
                                          %mrow
                                            %mo{:stretchy => "false"} (
                                            %mi g
                                            %msub
                                              %mi S
                                              %mi int
                                            %mo +
                                            %mi jA
                                            %mo{:stretchy => "false"} )
                                            %mo ,
                                            %mi ⋯
                                            %mo ,
                                            %mo{:stretchy => "false"} (
                                            %mi g
                                            %msub
                                              %mi S
                                              %mi int
                                            %mo +
                                            %mi j
                                            %mi A
                                            %mo{:stretchy => "false"} )
                                          %mo ⏟
                                        %mrow
                                          %mi k
                                          %mspace{:width => "thinmathspace"}
                                          %mtext arguments
                                      %mfrac{:linethickness => "0"}
                                        %mrow
                                          %mspace{:width => "thinmathspace"}
                                        %mrow
                                          %mspace{:width => "thinmathspace"}
                                      %mo )
                          %annotation{:encoding => "application/x-tex"}
                            \\begin{aligned}
                            \\mathcal{S}( g S_{int} + j A)
                            \&amp; =
                            T
                            \\left(
                            \\exp_{\otimes}
                            \\left(
                            \\tfrac{ 1 }{i \hbar}
                            \\left(
                            g S_{int} + j A
                            \\right)
                            \\right)
                            \\right)
                            \\\
                            \&amp; \coloneqq
                            \\underoverset{k = 0}{\infty}{\sum}
                            \\frac{1}{k!}
                            \\left( \frac{1}{i \hbar} \right)^k
                            T_k
                            \\left(
                            {\, \atop \,}
                            \\underset{k\,\text{arguments}}{\underbrace{ (g S_{int}  + jA) , \cdots,  (g S_{int} + j A)  }}
                            {\, \atop \,}
                            \\right)
                            \\end{aligned}
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/causal+additivity"}> causal additivity
                  )
                %p
                  For all perturbative
                  %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi O
                          %mn 0
                        %mo ,
                        %msub
                          %mi O
                          %mn 1
                        %mo ,
                        %msub
                          %mi O
                          %mn 2
                        %mo ∈
                        %mi LocObs
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mtext BV-BRST
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi ℏ
                        %mo ,
                        %mi g
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} O_0, O_1, O_2 \in LocObs(E_{\text{BV-BRST}})[ [\hbar, g, j] ]
                  we have
                #eq:CausalAdditivity.maruku-equation
                  %span.maruku-eq-number (5)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mi supp
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo ∨
                            %mspace{:width => "negativethinmathspace"}
                            %mspace{:width => "negativethinmathspace"}
                            %mspace{:width => "negativethinmathspace"}
                            %mo ∧
                          %mi supp
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mo )
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mo ⇒
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mrow
                          %mo (
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %mo +
                          %msub
                            %mi O
                            %mn 1
                          %mo +
                          %msub
                            %mi O
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %mo +
                          %msub
                            %mi O
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %mo +
                          %msub
                            %mi O
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\left(
                        {\, \atop \,}
                        supp( O_1 ) {\vee\!\!\!\wedge} supp( O_2 )
                        {\, \atop \,}
                        \\right)
                        \\;\; \Rightarrow \;\;
                        \\left(
                        {\, \atop \,}
                        \\mathcal{S}( O_0 + O_1 + O_2 )
                        \\;\,
                        \\mathcal{S}( O_0 + O_1 )
                        \\,
                        \\mathcal{S}( O_0 )^{-1}
                        \\,
                        \\mathcal{S}(O_0 + O_2)
                        {\, \atop \,}
                        \\right)
                        \\,.
            %p
              (The
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %mi O
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}(O)^{-1}
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}(O)
              with respect to the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              is implied to exist by the axiom “perturbation”, see remark
              %a.maruku-ref{:href => "#PerturbativeSMatrixInverse"}
              below.)
          %p
            Def.
            %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
            is due to (
            %a{:href => "causal+perturbation+theory#EpsteinGlaser73"}> Epstein-Glaser 73 (1)
            ), following (
            %a{:href => "causal+perturbation+theory#Stueckelberg49"}> Stückelberg 49-53
            ,
            = succeed ")." do
              %a{:href => "causal+perturbation+theory#BogoliubovShirkov59"} Bogoliubov-Shirkov 59
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            of an S-matrix scheme is indeed the space of
            %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
            was made explicit (in terms of axioms for the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
            %a.maruku-ref{:href => "#TimeOrderedProduct"}
            below), in (
            %a{:href => "S-matrix#BrunettiFredenhagen99"}> Brunetti-Fredenhagen 99, section 3
            ,
            = succeed "," do
              %a{:href => "S-matrix#DuetschFredenhagen04"} Dütsch-Fredenhagen 04, appendix E
            = succeed ")." do
              %a{:href => "S-matrix#HollandsWald04"} Hollands-Wald 04,around (20)
            = succeed "," do
              %a{:href => "S-matrix#Rejzner16"} Rejzner 16, around def. 6.7
            = succeed ")." do
              %a{:href => "S-matrix#Duetsch18"} Dütsch 18, section 3.3
          #PerturbativeSMatrixInverse.num_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/inverse"} invertibility
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            %p
              The mutliplicative inverse
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S(-)^{-1}
              of the perturbative
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              in def.
              %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              with respect to the
              = succeed "-product" do
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              that are non-vanishing in degree 0:
            %p If we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                    %mo +
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}(g S_{int} + j A) = 1 + \mathcal{D}(g S_{int} + j A)
            %p then
            #eq:InfverseOfPerturbativeSMatrix.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mrow
                                %mo (
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %mi 𝒮
                                %mo{:stretchy => "false"} (
                                %mi g
                                %msub
                                  %mi S
                                  %mi int
                                %mo +
                                %mi j
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %mo )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                          %mtd
                            %mo =
                            %msup
                              %mrow
                                %mo (
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %mn 1
                                %mo +
                                %mi 𝒟
                                %mo{:stretchy => "false"} (
                                %mi g
                                %msub
                                  %mi S
                                  %mi int
                                %mo +
                                %mi j
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %mo )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi r
                                %mo =
                                %mn 0
                              %mn ∞
                            %msup
                              %mrow
                                %mo (
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %mo −
                                %mi 𝒟
                                %mo{:stretchy => "false"} (
                                %mi g
                                %msub
                                  %mi S
                                  %mi int
                                %mo +
                                %mi j
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %mo )
                              %mi r
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\left(
                    {\, \atop \,}
                    \\mathcal{S}(g S_{int} + j A)
                    {\, \atop \,}
                    \\right)^{-1}
                    \&amp;=
                    \\left(
                    {\, \atop \,}
                    1 + \mathcal{D}(g S_{int} + j A)
                    {\, \atop \,}
                    \\right)^{-1}
                    \\\
                    \&amp; =
                    \\underoverset{r = 0}{\infty}{\sum}
                    \\left(
                    {\, \atop \,}
                    \-\mathcal{D}(g S_{int} + j A)
                    {\, \atop \,}
                    \\right)^r
                    \\end{aligned}
            %p
              where the sum does exist in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PolyObs
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mtext BV-BRST
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi ℏ
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mo{:stretchy => "false"} [
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} PolyObs(E_{\text{BV-BRST}})((\hbar))[ [[ g,j ] ]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}(g S_{int} + j A)
              has vanishing coefficient in zeroth order in the formal parameters
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
            %p
              This expression for the inverse of S-matrix may usefully be re-organized in terms of “rever-time ordered products” (def.
              %a.maruku-ref{:href => "#ReverseTimeOrderedProduct"}
              below), see prop.
              %a.maruku-ref{:href => "#ReverseTimOrderedProductsGiveReverseSMatrix"}
              below.
            %p
              Notice that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo −
                    %mi j
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}(-g S_{int} - j A )
              is instead the inverse with respect to the
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              %a.maruku-eqref{:href => "#eq:TimeOrderedProductsInSMatrix"} (3)
              in that
