                      %mi r
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \mathbf{X} \coloneqq \{x_1, \cdots, x_r\}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
