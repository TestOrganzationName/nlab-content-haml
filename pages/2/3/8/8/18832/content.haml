                    %msub
                      %mi O
                      %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}( O_0 + O_1 )^{-1}
              yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %mo +
                          %msub
                            %mi O
                            %mn 1
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %mo +
                          %msub
                            %mi O
                            %mn 1
                          %mo +
                          %msub
                            %mi O
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo =
                        %msub
                          %mi 𝒵
                          %mrow
                            %msub
                              %mi O
                              %mn 0
                            %mo +
                            %msub
                              %mi O
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi O
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi 𝒮
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi O
                            %mn 0
                          %mo +
                          %msub
                            %mi O
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo =
                        %msub
                          %mi 𝒵
                          %mrow
                            %msub
                              %mi O
                              %mn 0
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi O
                          %mn 2
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \= \mathcal{Z}_{ O_0 + O_1 }(  O_2 )
                    }{
                    \\underbrace{
                    \\mathcal{S}( O_0 + O_1 )^{-1}
                    \\mathcal{S}( O_0 + O_1 + O_2 )
                    }
                    }
                    \\;=\;
                    \\underset{
                    \= \mathcal{Z}_{ O_0 }( O_2 )
                    }{
                    \\underbrace{
                    \\mathcal{S}( O_0 )^{-1} \mathcal{S}( O_0 + O_2 )
                    }
                    }
                    \\,.
            %p
              This is the second line of
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:GeneratingFunctionCausalAdditivity"} (8)
          #InteractingFieldObservables.num_defn
            %h6#definition_5 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
                –
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#VacuumFree"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              be a corresponding
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              scheme according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo ∈
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} g S_{int} \in LocObs(E_{\text{BV-BRST}})[ [ \hbar, g ] ]\langle g \rangle
              be a
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              regarded as an
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} functional
            %p
              Then for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} A \in LocObs(E_{\text{BV-BRST}})[ [\hbar , g] ]
              a
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free field theory
              %a.existingWikiWord{:href => "/nlab/show/local+interacting+field+observable"} local interacting field observable
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi int
                    %mo ∈
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    A_{int} \in PolyObs(E_{\text{BV-BRST}})_{mc}[ [\hbar, g] ]
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/coefficient"} coefficient
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi j
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} j^1
              in the
              %a.existingWikiWord{:href => "/nlab/show/generating+function"} generating function
              = succeed ":" do
                %a.maruku-eqref{:href => "#eq:GeneratingFunctionInducedFromSMatrix"} (7)
            #eq:BogoliubovsFormula.maruku-equation
              %span.maruku-eq-number (9)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi A
                              %mi int
                          %mtd
                            %mo ≔
                            %mi i
                            %mi ℏ
                            %mfrac
                              %mi d
                              %mrow
                                %mi d
                                %mi j
                            %msub
                              %mrow
                                %mo (
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %msub
                                  %mi 𝒵
                                  %mrow
                                    %mi g
                                    %msub
                                      %mi S
                                      %mi int
                                %mo{:stretchy => "false"} (
                                %mi j
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %mo )
                              %mrow
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %mi j
                                    %mo =
                                    %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mi i
                            %mi ℏ
                            %mfrac
                              %mi d
                              %mrow
                                %mi d
                                %mi j
                            %msub
                              %mrow
                                %mo (
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %mi 𝒮
                                %mo{:stretchy => "false"} (
                                %mi g
                                %msub
                                  %mi S
                                  %mi int
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                                %mspace{:width => "thinmathspace"}
                                %mi 𝒮
                                %mo{:stretchy => "false"} (
                                %mi g
                                %msub
                                  %mi S
                                  %mi int
                                %mo +
                                %mi j
                                %mi A
                                %mo{:stretchy => "false"} )
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                  %mrow
                                    %mspace{:width => "thinmathspace"}
                                %mo )
                              %mrow
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %mi j
                                    %mo =
                                    %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi 𝒮
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msub
                              %mi S
                              %mi int
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mi T
                            %mrow
                              %mo (
                              %mi 𝒮
                              %mo{:stretchy => "false"} (
                              %mi g
                              %msub
                                %mi S
                                %mi int
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi A
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    A_{int}
                    \&amp;\coloneqq
                    i \hbar \frac{d}{d j}
                    \\left(
                    {\, \atop \,}
                    \\mathcal{Z}_{ g S_{int} }( j A )
                    {\, \atop \,}
                    \\right)_{\vert_{j = 0}}
                    \\\
                    \&amp; \coloneqq
                    i \hbar \frac{d}{d j}
                    \\left(
                    {\, \atop \,}
                    \\mathcal{S}(g S_{int})^{-1} \, \mathcal{S}( g S_{int} + j A )
                    {\, \atop \,}
                    \\right)_{\vert_{j = 0}}
                    \\\
                    \&amp; =
                    \\mathcal{S}(g S_{int})^{-1}
                    T\left(
                    \\mathcal{S}(g S_{int}), A
                    \\right)
                    \\,.
                    \\end{aligned}
            %p
              This expression is called
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
              = succeed ")." do
                %a{:href => "S-matrix#BogoliubovShirkov59"} Bogoliubov-Shirkov 59
            %p
              One thinks of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi int
                  %annotation{:encoding => "application/x-tex"} A_{int}
              as the
              %a.existingWikiWord{:href => "/nlab/show/deformation"} deformation
              of the
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              as the
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi int
                  %annotation{:encoding => "application/x-tex"} S_{int}
              is turned on; and speaks of an element of the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/interacting+field+algebra+of+observables"} interacting field algebra of observables
              = succeed "\u201D)" do
                %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
              %a.existingWikiWord{:href => "/nlab/show/Hadamard+vacuum+state"} Hadamard vacuum state
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle  -\rangle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VacuumFree"}
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in
              %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              and in the
              %a.existingWikiWord{:href => "/nlab/show/coupling+constant"} coupling constant
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo ⟨
                      %msub
                        %mi A
                        %mi int
                      %mo ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\left\langle
                    A_{int}
                    \\right\rangle
                    \\;\in\;
                    \\mathbb{C}[ [\hbar, g] ]
            %p
              which express the
              %a.existingWikiWord{:href => "/nlab/show/probability+amplitudes"} probability amplitudes
              that reflect the predictions of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/experiment"} experiment
          %p
            (
            %a{:href => "S-matrix#EpsteinGlaser73"}> Epstein-Glaser 73, around (74)
            ); review includes (
            %a{:href => "S-matrix#DuetschFredenhagen00"}> Dütsch-Fredenhagen 00, around (17)
            ,
            = succeed ")." do
              %a{:href => "pAQFT#Duetsch18"} Dütsch 18, around (3.212)
          #FormalPowerSeriesInteractingFieldObservables.num_example
            %h6#remark_3 Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
              in def.
              %a.maruku-ref{:href => "#InteractingFieldObservables"}
              are indeed
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in the formal parameter
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              (
              %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"}> Planck's constant
              ), as opposed to being more general
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
              %a.existingWikiWord{:href => "/nlab/show/negative+number"} negative
              powers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              (
              %a{:href => "interacting+field+observable#DuetschFredenhagen00"}> Dütsch-Fredenhagen 00, prop. 2 (ii)
              ,
              = succeed ")." do
                %a{:href => "interacting+field+observable#HawkinsRejzner16"} Hawkins-Rejzner 16, cor. 5.2
              %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              the
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              that they are defined from does involve negative powers of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
            %p
              It follows in particular that the
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
              have a
              %a.existingWikiWord{:href => "/nlab/show/classical+limit"} classical limit
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                      %mo →
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \hbar \to 0
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              itself (due to it involving negative powers of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
              constitute a
              %em
                %a.existingWikiWord{:href => "/nlab/show/formal+deformation+quantization"} formal deformation quantization
              of the
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
              of the
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+theory"} interacting field theory
              (prop.
              %a.maruku-ref{:href => "#InteractingFieldAlgebraOfObservablesIsFormalDeformationQuantization"}
              below) and are thus the more fundamental concept.
          %p
            As the name suggests, the
            %a.existingWikiWord{:href => "/nlab/show/S-matrices"} S-matrices
            in def.
            %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
            serve to express
            %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
            (example
            %a.maruku-ref{:href => "#ScatteringAmplitudeFromInteractingFieldObservables"}
            below). But by remark
            %a.maruku-ref{:href => "#FormalPowerSeriesInteractingFieldObservables"}
            the more fundamental concept is that of the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
            %a.existingWikiWord{:href => "/nlab/show/scattering+amplitudes"} scattering amplitudes
            requires the following condition on the relation between the
