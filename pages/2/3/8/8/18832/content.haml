                    %mo{:stretchy => "false"} (
                    %mi ℏ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    T_k
                    \\;\colon\;
                    \\left(
                    {\, \atop \,}
                    LocObs(E_{\text{BV-BRST}})[ [\hbar, g, j] ]
                    {\, \atop \,}
                    \\right)^{\otimes^k_{\mathbb{C}[ [\hbar, g, j] ]}}
                    \\longrightarrow
                    PolyObs(E_{\text{BV-BRST}})_{reg}((\hbar))[ [g , j] ]
            %p
              is called a
              %em renormalization condition
              if
            %ol
              %li
                %p
                  it holds for the unique
                  %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
                  away from coinciding spacetime arguments (according to prop.
                  = succeed ");" do
                    %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
              %li
                %p
                  whenever it holds for all unrestricted
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mrow
                            %mi k
                            %mo ≤
                            %mi n
                      %annotation{:encoding => "application/x-tex"} T_{k \leq n}
                  for some
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
