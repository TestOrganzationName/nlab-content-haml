                        %annotation{:encoding => "application/x-tex"} \mathbb{C}[ [\hbar, g, j] ]
                #eq:TimeOrderedProductsInSMatrix.maruku-equation
                  %span.maruku-eq-number (3)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi T
                          %mi k
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mrow
                            %mo (
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                            %mi LocObs
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi E
                              %mtext BV-BRST
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} [
