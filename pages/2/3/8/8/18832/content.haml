                              %mo{:stretchy => "false"} (
                              %msub
                                %mi A
                                %mn 1
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi int
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi A
                                %mn 2
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi int
                              %mi ⋯
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi A
                                %mi n
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi int
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
