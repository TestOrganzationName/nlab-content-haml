                              %mrow
                                %mspace{:width => "thinmathspace"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                            %mo )
                          %mrow
                            %msubsup
                              %mo ⊗
                              %mrow
                                %mi ℂ
                                %mo{:stretchy => "false"} [
                                %mo{:stretchy => "false"} [
                                %mi ℏ
                                %mo ,
                                %mi g
                                %mo ,
                                %mi j
                                %mo{:stretchy => "false"} ]
                                %mo{:stretchy => "false"} ]
                              %mi k
                        %mo ⟶
                        %mi PolyObs
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mtext BV-BRST
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi mc
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} (
                        %mi ℏ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
