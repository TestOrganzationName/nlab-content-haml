            %p is well defined and satisfies causal factorization.
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)normalization
            involves making choices, there is the freedom to impose further conditions that one may want to have satisfied. These are called
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/renormalization+conditions"} renormalization conditions
          #RenormalizationConditions.num_defn
            %h6#definition_17 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/renormalization+conditions"}> renormalization conditions
                ,
                %a.existingWikiWord{:href => "/nlab/show/protection+from+quantum+corrections"} protection from quantum corrections
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+anomalies"} quantum anomalies
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#VacuumFree"}
            %p
              Then a condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              on
              = succeed "-ary" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi k
