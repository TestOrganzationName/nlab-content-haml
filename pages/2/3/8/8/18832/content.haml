            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi supp
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi 𝒪
                    %annotation{:encoding => "application/x-tex"} supp(A) \subset \mathcal{O}
            %p
              We call
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gen
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gen(E_{\text{BV-BRST}}, \mathbf{L}_{int} )(\mathcal{O})
              the
              = succeed "." do
                %em
                  algebra of
                  %a.existingWikiWord{:href => "/nlab/show/generating+functions"} generating functions
                  for
                  %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
                  localized in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}
            %p
