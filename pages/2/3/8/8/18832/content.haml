              %a.maruku-eqref{:href => "#eq:AbstractGeneratingFunctionAlgebraIsomorphicToAnyAdiabaticSwitching"} (12)
              we may check causal localizy with respect to any choice of
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatic switching
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
