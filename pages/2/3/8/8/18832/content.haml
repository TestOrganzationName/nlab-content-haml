                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mi 𝒮
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msub
                              %mi S
                              %mi int
                            %mo{:stretchy => "false"} )
                            %mo ⋅
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi exp
                                    %mo ⋅
                                  %mrow
                                    %mo (
                                    %mstyle{:displaystyle => "false"}
                                      %mfrac
