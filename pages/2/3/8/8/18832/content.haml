                    %mo ,
                    %mi h
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    g S_{int} + j A
                    \\;\in\;
                    LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, h ] ]
            %p
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
            %p
              Recall that for each
              %a.existingWikiWord{:href => "/nlab/show/finite+multigraph"} finite multigraph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
