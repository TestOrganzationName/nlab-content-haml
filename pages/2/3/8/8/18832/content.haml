                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar, g, j] ]
                    \\otimes
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar, g, h] ]
                    \\overset{ \star_{int} }{\longrightarrow}
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar, g, j] ]
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/conjugation"} conjugation
              of the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              %a.existingWikiWord{:href => "/nlab/show/structure"} structure
              by the
              %a.existingWikiWord{:href => "/nlab/show/quantum+M%C3%B8ller+operator"} quantum Møller operator
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#MollerOperatorOnRegularPolynomialObservables"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
