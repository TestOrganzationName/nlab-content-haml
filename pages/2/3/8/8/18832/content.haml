              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/protection+from+quantum+corrections"} protects the observable against quantum corrections
            %p
              If for specified renormalization conditions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
