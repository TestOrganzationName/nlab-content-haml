                        %mo{:stretchy => "false"} [
                        %mi g
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        T_k
                        \\;\colon\;
                        \\left(
                        {\, \atop \,}
                        LocObs(E_{\text{BV-BRST}})[ [\hbar, g, j] ]\langle g, j \rangle
                        {\, \atop \,}
                        \\right)^{\otimes^k_{\mathbb{C}[ [\hbar, g, j] ]}}
                        \\longrightarrow
                        PolyObs(E_{\text{BV-BRST}})_{mc}((\hbar))[ [ g, j ] ]
                %p
                  for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                          %mo ∈
                          %mi ℕ
                        %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
                %ol
                  %li
                    %p
                      The nullary map is
                      %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
                      on the
                      %a.existingWikiWord{:href => "/nlab/show/neutral+element"} unit
                      of the
                      %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi T
