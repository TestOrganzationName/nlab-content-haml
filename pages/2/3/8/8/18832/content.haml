                      %mphantom
                        %mi AAA
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi ℏ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}
                    \\;\;\colon\;\;
                    LocObs(E_{\text{BV-BRST}})[ [\hbar , g, j] ]\langle g, j \rangle
                    \\overset{\phantom{AAA}}{\longrightarrow}
                    PolyObs(E_{\text{BV-BRST}})_{mc}((\hbar))[ [ g, j ] ]
            %p
              from
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              to
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              of the free vacuum theory, with formal parameters adjoined as indicated (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FormalParameters"}
              = succeed "\u201C)" do
                %a.existingWikiWord{:href => "/nlab/show/causal+perturbation+theory"} causal perturbation theory
            %ol
              %li
                %p
                  (
                  %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"}> perturbation
                  )
                %p
                  There exist
                  %a.existingWikiWord{:href => "/nlab/show/multilinear+map"} multi-
                  %a.existingWikiWord{:href => "/nlab/show/linear+continuous+functionals"} linear continuous functionals
                  (over
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
