              (example
              = succeed "):" do
                %a.maruku-ref{:href => "#ScatteringAmplitudeFromInteractingFieldObservables"}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
