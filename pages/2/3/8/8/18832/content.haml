                          %mtd
                            %mo :
                            %mi A
                            %mo :
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    LocObs(E_{\text{BV-BRST}})
                    \&amp;\overset{\phantom{A}:(-):\phantom{A}}{\hookrightarrow}&amp;
                    PolyObs(E_{\text{BV-BRST}})_{mc}
                    \\\
                    A &amp;\mapsto&amp; :A:
                    }
            %p
              for the inclusion of
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalObservables"}
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#PointwiseProductsOfFieldObservablesAdiabaticallySwitchedIsMicrocausal"}
              %a.existingWikiWord{:href => "/nlab/show/normal-ordered+products"} normal-ordered products
              in the
              %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              (by def.
              = succeed ")." do
                %a.maruku-ref{:href => "#NormalOrderedProductNotation"}
            %p
              We denote the
              = succeed "-product" do
                %a.existingWikiWord{:href => "/nlab/show/Wick+algebra"} Wick algebra
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⋆
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \star_H
              induced by the
              %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \Delta_H
              according to prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#PropagatorStarProduct"}
              = succeed ")" do
                %a.maruku-ref{:href => "#NormalOrderedProductNotation"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mi A
                      %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi A
                      %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %msub
                      %mi A
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A_1 A_2 \;\coloneqq\; A_1 \star_H A_2
                    \\,.
            %p
              If an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in PolyObs(E_{\text{BV-BRST}})
              has an
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              with respect to this product, we denote that by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi A
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} A^{-1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mi A
                    %mo =
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    A^{-1} A = 1
                    \\,.
            %p
              Finally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in LocObs(E_{\text{BV-BRST}})
              we write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi supp
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} supp(A) \subset \Sigma
              for its spacetime support (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SpacetimeSupport"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mo ,
                    %msub
                      %mi S
                      %mn 2
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} S_1, S_2 \subset \Sigma
              two
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
              of
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mrow
                      %mo ∨
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo ∧
                    %msub
                      %mi S
                      %mn 2
                    %mphantom
                      %mi AAA
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mtext "
                              %msub
                                %mi S
                                %mn 1
                              %mspace{:width => "thinmathspace"}
                              %mtext does not intersect the past of
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi S
                                %mn 2
                              %mtext "
                          %mtr
                            %mtd
                              %mo ⇕
                          %mtr
                            %mtd
                              %mtext "
                              %msub
                                %mi S
                                %mn 2
                              %mspace{:width => "thinmathspace"}
                              %mtext does not intersect the future of
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi S
                                %mn 1
                              %mtext "
                  %annotation{:encoding => "application/x-tex"}
                    S_1 {\vee\!\!\!\wedge} S_2
                    \\phantom{AAA}
                    \\left\{
                    \\array{
                    \\text{"}S_1 \, \text{does not intersect the past of} \, S_2\text{"}
                    \\\
                    \\Updownarrow
                    \\\
                    \\text{"}S_2 \, \text{does not intersect the future of} \, S_1\text{"}
                    }
                    \\right.
            %p
              for the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/causal+order"} causal order
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CausalOrdering"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mn 1
                    %mrow
                      %mo &gt;
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mspace{:width => "negativethinmathspace"}
                      %mo &lt;
                    %msub
                      %mi S
                      %mn 2
                    %mphantom
                      %mi AAA
                    %mtext for
                    %mphantom
                      %mi AAA
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mn 1
                            %mrow
                              %mo ∨
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mo ∧
                            %msub
                              %mi S
                              %mn 2
                        %mtr
                          %mtd
                            %mtext and
                        %mtr
                          %mtd
                            %msub
                              %mi S
                              %mn 2
                            %mrow
                              %mo ∨
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mspace{:width => "negativethinmathspace"}
                              %mo ∧
                            %msub
                              %mi A
                              %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    S_1 {\gt\!\!\!\!\lt} S_2
                    \\phantom{AAA}
                    \\text{for}
                    \\phantom{AAA}
                    \\array{
                    S_1 {\vee\!\!\!\wedge} S_2
                    \\\
                    \\text{and}
                    \\\
                    S_2 {\vee\!\!\!\wedge} A_1
                    }
            %p
              for
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
                  separation
          %p
            Being concerned with
            %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbation theory
            means mathematically that we consider
            %em
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            in
            %a.existingWikiWord{:href => "/nlab/show/deformation"} deformation
            parameters
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℏ
                %annotation{:encoding => "application/x-tex"} \hbar
            (“
            %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"}> Planck's constant
            ”) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            (“
            %a.existingWikiWord{:href => "/nlab/show/coupling+constant"}> coupling constant
            ”), also in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            (“
            %a.existingWikiWord{:href => "/nlab/show/source+field"}> source field
            ”), see also remark
            = succeed "." do
              %a.maruku-ref{:href => "#AsymptoticSeriesObservables"}
          #FormalParameters.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
                of
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/perturbative+QFT"} perturbative QFT
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              according to def.
              = succeed "." do
                %a.maruku-ref{:href => "#VacuumFree"}
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                        %mo ,
                        %msub
                          %mi k
                          %mn 2
                        %mo ,
                        %msub
                          %mi k
                          %mn 3
                        %mo ∈
                        %mi ℕ
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %msup
                      %mi ℏ
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %msup
                      %mi g
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %msup
                      %mi j
                      %mrow
                        %msup
                          %mi k
                          %mn 3
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j ] ]
                    \\;\coloneqq\;
                    \\underset{ k_1, k_2, k_3 \in \mathbb{N}}{\prod}
                    LocObs(E_{\text{BV-BRST}})\langle \hbar^{k_1} g^{k_2} j^{k^3}\rangle
            %p
              for the space of
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in three formal
              %a.existingWikiWord{:href => "/nlab/show/variables"} variables
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℏ
                      %annotation{:encoding => "application/x-tex"} \hbar
                  (“
                  %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"}> Planck's constant
                  ”),
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  (“
                  %a.existingWikiWord{:href => "/nlab/show/coupling+constant"}> coupling constant
                  ”)
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi j
                      %annotation{:encoding => "application/x-tex"} j
                  (“
                  %a.existingWikiWord{:href => "/nlab/show/source+field"}> source field
                  ”)
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in the
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+spaces"} topological vector spaces
              of the
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              polynomial
              %a.existingWikiWord{:href => "/nlab/show/local+observables"} local observables
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free field
              theory (def.
              = succeed ");" do
                %a.maruku-ref{:href => "#LocalObservables"}
              %a.existingWikiWord{:href => "/nlab/show/off-shell"} off-shell
              %a.existingWikiWord{:href => "/nlab/show/microcausal+polynomial+observables"} microcausal polynomial observables
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#MicrocausalObservable"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                        %mo ,
                        %msub
                          %mi k
                          %mn 2
                        %mo ,
                        %msub
                          %mi k
                          %mn 3
                        %mo ∈
                        %mi ℕ
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo{:stretchy => "false"} ⟨
                    %msup
                      %mi ℏ
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %msup
                      %mi g
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %msup
                      %mi j
                      %mrow
                        %msup
                          %mi k
                          %mn 3
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar, g, j ] ]
                    \\;\coloneqq\;
                    \\underset{ k_1, k_2, k_3 \in \mathbb{N}}{\prod}
                    PolyObs(E_{\text{BV-BRST}})_{mc}\langle \hbar^{k_1} g^{k_2} j^{k^3}\rangle
                    \\,.
            %p Similary
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AAA
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    LocObs(E_{\text{BV-BRST}})[ [ \hbar, g  ] ]
                    \\,,
                    \\phantom{AAA}
                    PolyObs(E_{\text{BV-BRST}})[ [ \hbar, g  ] ]
            %p
              denotes the subspace for which no powers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              appear, etc.
            %p Accordingly
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    C^\infty_{cp}(\Sigma) \langle g \rangle
            %p
              denotes the vector space of
              %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
              on
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              tensored with the vector space spanned by a single copy of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi sw
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    g_{sw} \in C^\infty_{cp}(\Sigma)\langle g \rangle
            %p
              may be regarded as
              = succeed "-dependent" do
                %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              = succeed "\u201D" do
                %a.existingWikiWord{:href => "/nlab/show/coupling+constants"} coupling constants
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
                  couplings
            %p Similarly then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j ] ]\langle g , j \rangle
            %p
              is the subspace of those formal power series that are at least linear in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
