                    \\right\rangle
                    \\;=\;
                    \\frac{\delta}{\delta j_{sw}(x)}
                    W(j_{sw} = 0)
                    \\,.
            %p
              Assume then that there exists a corresponding functional
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(\Phi)
              of the
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                    %mo ∈
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Phi \in \Gamma_{\Sigma}(E_{\text{BV-BRST}})
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %a.existingWikiWord{:href => "/nlab/show/Legendre+transform"} Legendre transform
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              in that it satisfies the functional version of the defining equation of Legendre transforms (first derivatives are
              %a.existingWikiWord{:href => "/nlab/show/inverse+functions"} inverse functions
              of each other, see
              = succeed "):" do
                %a{:href => "Legendre+transformation#eq:DerivativesOfLegendreTransformsAreInverseFunctions"} this equation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi δ
                      %mrow
                        %mi δ
                        %mi Φ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi Γ
                    %mrow
                      %mo (
                      %mfrac
                        %mi δ
                        %mrow
                          %mi δ
                          %msub
                            %mi j
                            %mi sw
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                      %mi W
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mi j
                      %mi sw
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\delta }{\delta \Phi(x)}
                    \\Gamma
                    \\left(
                    \\frac{\delta}{\delta j_{sw}(y)} W
                    \\right)
                    \\;=\;
                    \\delta(x,y) j_{sw}(x)
                    \\,.
            %p
              By
              %a.maruku-eqref{:href => "#eq:WFunctionalDerivative"} (24)
              this implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mi δ
                      %mrow
                        %mi δ
                        %mi Φ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mi Γ
                    %mrow
                      %mo (
                      %mrow
                        %mo ⟨
                        %mstyle{:mathvariant => "bold"}
                          %mi Φ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi int
                        %mo ⟩
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\delta }{\delta \Phi(x)}
                    \\Gamma
                    \\left(
                    \\left\langle \mathbf{\Phi}(x)_{int} \right\rangle  \right)
                    \\;=\;
                    0
                    \\,.
            %p
              This may be read as a quantum version of the
              %a.existingWikiWord{:href => "/nlab/show/principle+of+extremal+action"} principle of extremal action
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#PrincipleOfExtremalAction"}
              %a.existingWikiWord{:href => "/nlab/show/field+histories"} field histories
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Φ
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Phi(x)
              %a.existingWikiWord{:href => "/nlab/show/vacuum+expectation+values"} vacuum expectation values
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mstyle{:mathvariant => "bold"}
                      %mi Φ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi int
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} \langle \mathbf{\Phi}(x)_{int}\rangle
              of their corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/interacting+quantum+field+observables"} interacting quantum field observables
            %p
              Beware, (as in remark
              = succeed ")" do
                %a.maruku-ref{:href => "#TerminologyForEffectiveAction"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi Φ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(\Phi)
              as the
              = succeed "," do
                %em effective action
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Legendre+transform"} Legendre transform
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi j
                        %mi sw
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(j_{sw})
          %p
            The perspective of the
            %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
            gives a transparent picture of the order of quantum effects involved in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
            %a.maruku-ref{:href => "#FeynmanDiagramLoopOrder"}
            below. In order to state this conveniently, we invoke two basic concepts from
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/graph+theory"} graph theory
          #GraphPlanar.num_defn
            %h6#definition_23 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/planar+graphs"} planar graphs
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/trees"} trees
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/finite+multigraph"} finite multigraph
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Graphs"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/planar+graph"} planar graph
              if it admits an
              %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
              into the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/plane"} plane
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/finite+multigraph"} finite multigraph
              is called a
              %em
                %a.existingWikiWord{:href => "/nlab/show/tree"} tree
              if for any two of its
              %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
              there is at most one
              %a.existingWikiWord{:href => "/nlab/show/path"} path
              of
              %a.existingWikiWord{:href => "/nlab/show/edges"} edges
              connecting them, these are examples of planar graphs. We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi tree
                    %mo ⊂
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{G}_{tree}
                    \\subset
                    \\mathcal{G}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+multigraphs"} finite multigraphs
              with
              %a.existingWikiWord{:href => "/nlab/show/linear+order"} linearly orrdered
              %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Graphs"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/trees"} trees
          #FeynmanDiagramLoopOrder.num_prop
            %h6#proposition_18 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/loop+order"} loop order
                and
                %a.existingWikiWord{:href => "/nlab/show/tree+level"} tree level
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InPerturbationTheoryActionEffective"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              also in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi eff
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_{eff}(g,j)
                    \\;\in\;
                    PolyObs(E_{\text{BV-BRST}})[ [ \hbar, g, j ] ]
                    \\,.
            %p and in particular
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo ⟨
                      %msub
                        %mi S
                        %mi eff
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℂ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\langle
                    S_{eff}(g,j)
                    \\right\rangle
                    \\;\in\;
                    \\mathbb{C}[ [ \hbar, g, j] ]
                    \\,.
            %p
              Moreover, the contribution to the effective action in the
              %a.existingWikiWord{:href => "/nlab/show/classical+limit"} classical limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                    %mo →
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \hbar \to 0
              is precisely that of
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              of those
              %a.existingWikiWord{:href => "/nlab/show/finite+multigraphs"} finite multigraphs
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FeynmanPerturbationSeriesAwayFromCoincidingPoints"}
              %a.existingWikiWord{:href => "/nlab/show/trees"} trees
              (def.
              = succeed ");" do
                %a.maruku-ref{:href => "#GraphPlanar"}
              = succeed "-contribution:" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/tree+level"} tree level
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi eff
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi ℏ
                        %mo =
                        %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %mi ℏ
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi Γ
                        %mo ∈
                        %msub
                          %mi 𝒢
                          %mi conn
                        %mo ∩
                        %msub
                          %mi 𝒢
                          %mi tree
                    %mi Γ
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi g
                      %msub
                        %mi S
                        %mi int
                      %mo +
                      %mi j
                      %mi A
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mo =
                          %mn 1
                        %mrow
                          %mi ν
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S_{eff}(g,j)\vert_{\hbar = 0}
                    \\;=\;
                    i \hbar
                    \\underset{\Gamma \in \mathcal{G}_{conn} \cap \mathcal{G}_{tree}}{\sum}
                    \\Gamma\left( (g S_{int} + j A)_{i = 1}^{\nu(\Gamma)} \right)
                    \\,.
            %p
              Finally, a
              %a.existingWikiWord{:href => "/nlab/show/finite+multigraph"} finite multigraph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#Graphs"}
              %a.existingWikiWord{:href => "/nlab/show/planar+graph"} planar
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GraphPlanar"}
              %a.existingWikiWord{:href => "/nlab/show/connected+graph"} connected
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ConnectedGraphs"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℏ
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\hbar^{L(\Gamma)}
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} L(\Gamma) \in \mathbb{N}
              is the number of
              %em
                %a.existingWikiWord{:href => "/nlab/show/faces"} faces
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %em number of loops
              of the diagram; here usually called the
              %em
                %a.existingWikiWord{:href => "/nlab/show/loop+order"} loop order
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
            %p
              (Beware the terminology clash with
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/graph+theory"} graph theory
              %a.existingWikiWord{:href => "/nlab/show/tadpoles"} tadpoles
              in remark
              = succeed ".)" do
                %a.maruku-ref{:href => "#Tadpoles"}
          .proof
            %h6#proof_20 Proof
            %p
              By def.
              %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
              the explicit
              = succeed "-dependence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mrow
                      %mo (
                      %msub
                        %mi S
                        %mi int
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %mfrac
                      %mn 1
                      %mrow
                        %mi k
                        %mo !
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mi ℏ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                    %mi T
                    %mo{:stretchy => "false"} (
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mi S
                            %mi int
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi S
                            %mi int
                        %mo ⏟
                      %mrow
                        %mi k
                        %mspace{:width => "thinmathspace"}
                        %mtext factors
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}
                    \\left(
                    S_{int}
                    \\right)
                    \\;=\;
                    \\underset{k \in \mathbb{N}}{\sum}
                    \\frac{1}{k!}
                    \\frac{1}{(i \hbar)^k}
                    T( \underset{k \, \text{factors}}{\underbrace{S_{int}, \cdots,  S_{int}}} )
            %p
              and by prop.
              %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
              the further
              = succeed "-dependence" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℏ
                    %annotation{:encoding => "application/x-tex"} \hbar
              %a.existingWikiWord{:href => "/nlab/show/time-ordered+product"} time-ordered product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(\cdots)
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %mo ,
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi prod
                    %mo ∘
                    %mi exp
                    %mrow
                      %mo (
                      %mi ℏ
                      %mrow
                        %mo ⟨
                        %msub
                          %mi Δ
                          %mi F
                        %mo ,
                        %mfrac
                          %mi δ
                          %mrow
                            %mi δ
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                        %mo ⊗
                        %mfrac
                          %mi δ
                          %mrow
                            %mi δ
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                        %mo ⟩
                      %mo )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %mo ⊗
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    T(S_{int}, S_{int})
                    \\;=\;
                    prod \circ
                    \\exp\left(
                    \\hbar
                    \\left\langle
                    \\Delta_F,
                    \\frac{\delta}{\delta \mathbf{\Phi}}
                    \\otimes
                    \\frac{\delta}{\delta \mathbf{\Phi}}
                    \\right\rangle
                    \\right)
                    ( S_{int} \otimes S_{int} )
                    \\,,
            %p
              By the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+rules"} Feynman rules
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FeynmanPerturbationSeriesAwayFromCoincidingPoints"}
            %ol
              %li
                %p
                  each
                  %a.existingWikiWord{:href => "/nlab/show/vertex"} vertex
                  of a Feynman diagram contributes a power
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℏ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \hbar^{-1}
                  to its Feynman amplitude;
              %li
                %p
                  each
                  %a.existingWikiWord{:href => "/nlab/show/edge"} edge
                  of a Feynman diagram contributes a power
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℏ
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \hbar^{+1}
                  to its Feynman amplitude.
            %p If we write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    E(\Gamma), V(\Gamma) \;\in\; \mathbb{N}
            %p
              for the total number of
              %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/edges"} edges
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo ∈
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \Gamma \in \mathcal{G}
              contributes precisely at order
            #eq:GeneralFeynmanDiagramhbarContribution.maruku-equation
              %span.maruku-eq-number (25)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℏ
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi V
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hbar^{E(\Gamma) - V(\Gamma)}
                    \\,.
            %p
              So far this holds for arbitrary
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              is
              %a.existingWikiWord{:href => "/nlab/show/connected+graph"} connected
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ConnectedGraphs"}
              %a.existingWikiWord{:href => "/nlab/show/planar+graph"} planar
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#GraphPlanar"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/Euler%27s+formula"} Euler's formula
              asserts that
            #eq:ConnectedPlanarGraphEulerCharacteristic.maruku-equation
              %span.maruku-eq-number (26)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    E(\Gamma) - V(\Gamma)
                    \\;=\;
                    L(\Gamma) - 1
                    \\,.
            %p
              Hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℏ
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \hbar^{L(\Gamma)- 1}
              is the order of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              at which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              contributes to the
              %a.existingWikiWord{:href => "/nlab/show/scattering+matrix"} scattering matrix
              expressed as the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
            %p
              But the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:ExpansionEffectiveAction"} (22)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℏ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \hbar^1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℏ
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi V
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mn 1
                    %mo =
                    %msup
                      %mi ℏ
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hbar^{E(\Gamma) - V(\Gamma) + 1} = \hbar^{L(\Gamma)}
                    \\,.
            %p
              This proves the second claim on
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/loop+order"} loop order
            %p
              The first claim, due to the extra factor of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              in the definition of the effective action, is equivalent to saying that the Feynman amplitude of every
              %a.existingWikiWord{:href => "/nlab/show/connected+graph"} connected
              %a.existingWikiWord{:href => "/nlab/show/finite+multigraph"} finite multigraph
              contributes powers in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              of order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ≥
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \geq -1
              and contributes at order
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℏ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \hbar^{-1}
              precisely if the graph is a tree.
            %p
              Observe that a
              %a.existingWikiWord{:href => "/nlab/show/connected+graph"} connected
              %a.existingWikiWord{:href => "/nlab/show/finite+multigraph"} finite multigraph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \nu \in \mathbb{N}
              vertices (necessarily
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \nu \geq 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \nu-1
              edges and precisely
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \nu - 1
              edges if it is a tree.
            %p
              To see this, consecutively remove edges from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              as long as possible while retaining connectivity. When this process stops, the result must be a connected tree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \Gamma'
              %a.existingWikiWord{:href => "/nlab/show/connected+graph"} connected
              %a.existingWikiWord{:href => "/nlab/show/planar+graph"} planar graph
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} L(\Gamma') = 0
              %a.existingWikiWord{:href => "/nlab/show/Euler%27s+formula"} Euler's formula
              %a.maruku-eqref{:href => "#eq:ConnectedPlanarGraphEulerCharacteristic"} (26)
              implies that that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} E(\Gamma') = V(\Gamma') -1
            %p
              This means that the connected multigraph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              in general has a Feynman amplitude of order
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℏ
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi V
                        %mo{:stretchy => "false"} (
                        %mi Γ
                        %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi ℏ
                      %mrow
                        %mover
                          %mover
                            %mrow
                              %mi E
                              %mo{:stretchy => "false"} (
                              %mi Γ
                              %mo{:stretchy => "false"} )
                              %mo −
                              %mi E
                              %mo{:stretchy => "false"} (
                              %mi Γ
                              %mo ′
                              %mo{:stretchy => "false"} )
                            %mo ⏞
                          %mrow
                            %mo ≥
                            %mn 0
                        %mo +
                        %mover
                          %mover
                            %mrow
                              %mi E
                              %mo{:stretchy => "false"} (
                              %mi Γ
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mo −
                              %mi V
                              %mo{:stretchy => "false"} (
                              %mi Γ
                              %mo{:stretchy => "false"} )
                            %mo ⏞
                          %mrow
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\hbar^{E(\Gamma) - V(\Gamma)}
                    \=
                    \\hbar^{ \overset{\geq 0}{\overbrace{E(\Gamma) - E(\Gamma')}} + \overset{= -1}{\overbrace{E(\Gamma') - V(\Gamma)}}  }
            %p
              and precisely if it is a tree its Feynman amplitude is of order
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℏ
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \hbar^{-1}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#VacuumDiagrams
            %strong Vacuum diagrams
          %p
            With the
            %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
            and the
            %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
            in hand, it is now immediate to see that there is a general contribution by
            %a.existingWikiWord{:href => "/nlab/show/vacuum+diagrams"} vacuum diagrams
            (def.
            %a.maruku-ref{:href => "#VacuumDiagram"}
            below) in the
            %a.existingWikiWord{:href => "/nlab/show/scattering+matrix"} scattering matrix
            which, in a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vacuum+stability"} stable vacuum state
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                  %mo{:stretchy => "false"} (
                  %mi g
                  %msub
                    %mi S
                    %mi int
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{S}(g S_{int})
            in
            %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
          #VacuumDiagram.num_defn
            %h6#definition_24 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/vacuum+diagrams"}> vacuum diagrams
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#VacuumFree"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} g S_{int} + j A \;\in\; LocObs(E_{\text{BV-BRST}})[ [ \hbar , g , j] ]\langle g,j \rangle
              be a
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              regarded as an
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              = succeed "." do
                %a.maruku-ref{:href => "#VerticesAndFieldSpecies"}
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/Feynman+diagram"} Feynman diagram
              all whose vertices are internal vertices (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FeynmanDiagram"}
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/vacuum+diagram"} vacuum diagram
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒢
                      %mi vac
                      %mi Feyn
                    %mo ⊂
                    %msup
                      %mi 𝒢
                      %mi Feyn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{G}^{Feyn}_{vac}
                    \\subset
                    \\mathcal{G}^{Feyn}
            %p
              for the subset of
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of vacuum diagrams among the set of isomorphism classes of all Feynman diagrams, def.
              = succeed "." do
                %a.maruku-ref{:href => "#FeynmanDiagram"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝒢
                      %mrow
                        %mi conn
                        %mo ,
                        %mi vac
                      %mi Feyn
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi 𝒢
                      %mi conn
                      %mi Feyn
                    %mo ∩
                    %msubsup
                      %mi 𝒢
                      %mi vac
                      %mi Feyn
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝒢
                      %mi Feyn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{G}^{Feyn}_{conn,vac}
                    \\;\coloneqq\;
                    \\mathcal{G}^{Feyn}_{conn}
                    \\cap
                    \\mathcal{G}^{Feyn}_{vac}
                    \\;\subset\;
                    \\mathcal{G}^{Feyn}
            %p
              for the subset of
              %a.existingWikiWord{:href => "/nlab/show/isomorphism+classes"} isomorphism classes
              of Feynman diagrams which are both vacuum diagrams as well as
              %a.existingWikiWord{:href => "/nlab/show/connected+graphs"} connected graphs
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#ConnectedGraphs"}
            %p Finally write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi vac
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi Γ
                            %mo ,
                            %mi vertlab
                            %mo ,
                            %mi edgelab
                            %mo{:stretchy => "false"} )
                        %mrow
                          %mrow
                            %mo ∈
                            %msub
                              %mi 𝒢
                              %mrow
                                %mi conn
                                %mo ,
                                %mi vac
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ,
                    %mi vertlab
                    %mo ,
                    %mi edgelab
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi mc
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    S_{eff,vac}(g)
                    \\;\coloneqq\;
                    \\underset{ { (\Gamma,vertlab,edgelab) } \atop { \in \mathcal{G}_{conn,vac} } }{\sum}
                    (\Gamma,vertlab, edgelab)(g S_{int})
                    \\;\in\;
                    PolyObs(E_{\text{BV-BRST}})_{mc}[ [ \hbar , g ] ]
            %p
              for the sub-series of that for the
              %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#InPerturbationTheoryActionEffective"}
          .num_example
            %h6#example_9 Example
            %p
              %strong
                (2-vertex
                %a.existingWikiWord{:href => "/nlab/show/vacuum+diagram"} vacuum diagram
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/QED"} QED
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/vacuum+diagram"} vacuum diagram
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VacuumDiagram"}
              = succeed "-vertices" do
                %a.existingWikiWord{:href => "/nlab/show/electron-photon+interaction"} electron-photon interaction
              %a.existingWikiWord{:href => "/nlab/show/quantum+electrodynamics"} quantum electrodynamics
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianQED"}
            %center
              %img{:src => "https://ncatlab.org/nlab/files/QEDVacuumDiagram.png", :width => "200"}/
          #SMatrixVacuumContribution.num_example
            %h6#example_10 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/vacuum+diagram"}> vacuum diagram
                \-contribution to
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/S-matrices"} S-matrices
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#VacuumFree"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo +
                    %mi j
                    %mi A
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} g S_{int} + j A \;\in\; LocObs(E_{\text{BV-BRST}})[ [ \hbar , g , j] ]\langle g,j \rangle
              be a
              %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              regarded as an
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
              = succeed "." do
                %a.maruku-ref{:href => "#VerticesAndFieldSpecies"}
            %p
              Then the
              = succeed "-expansion" do
                %a.existingWikiWord{:href => "/nlab/show/Feynman+perturbation+series"} Feynman perturbation series
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#FeynmanPerturbationSeries"}
              = succeed "-term" do
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                  %annotation{:encoding => "application/x-tex"} g S_{int}
              alone (no
              = succeed "-contribution)" do
                %a.existingWikiWord{:href => "/nlab/show/source+field"} source field
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              that are labeled by
              %a.existingWikiWord{:href => "/nlab/show/vacuum+diagrams"} vacuum diagrams
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#VacuumDiagram"}
              = succeed ")" do
                %a.maruku-ref{:href => "#LogarithmEffectiveAction"}
              %a.existingWikiWord{:href => "/nlab/show/effective+action"} effective action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi eff
                        %mo ,
                        %mi vac
                  %annotation{:encoding => "application/x-tex"} S_{eff,vac}
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#VacuumDiagram"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi 𝒮
                            %mo{:stretchy => "false"} (
                            %mi g
                            %msub
                              %mi S
                              %mi int
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %msub
                              %mi exp
                              %mo ⋅
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mrow
                                    %mi i
                                    %mi ℏ
                              %msub
                                %mi S
                                %mrow
                                  %mi eff
                                  %mo ,
                                  %mi vac
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo ,
                              %mi j
                              %mo{:stretchy => "false"} )
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi Γ
                                %mo ∈
                                %msub
                                  %mi 𝒢
