                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mi int
                    %mo ∈
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
