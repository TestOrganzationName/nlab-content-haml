            %p
              then the corresponding
              %em
                %a.existingWikiWord{:href => "/nlab/show/quantum+M%C3%B8ller+operator"} quantum Møller operator
              on
              %a.existingWikiWord{:href => "/nlab/show/regular+polynomial+observables"} regular polynomial observables
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℛ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo ⟶
                    %mi PolyObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi reg
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{R}^{-1}
                    \\;\colon\;
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar , g, j] ]
                    \\longrightarrow
                    PolyObs(E_{\text{BV-BRST}})_{reg}[ [\hbar, g, j] ]
            %p
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
              of
              %a.existingWikiWord{:href => "/nlab/show/Bogoliubov%27s+formula"} Bogoliubov's formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℛ
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %msub
                      %mo ⋆
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⋆
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{R}^{-1}
                    \\;\coloneqq\;
                    \\mathcal{S}(S_{int})^{-1}
                    \\star_H
                    (\mathcal{S}(S_{int}) \star_F (-))
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi exp
                      %mi 𝒯
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                          %mrow
                            %mi i
                            %mi ℏ
                      %msub
                        %mi S
                        %mi int
                      %mo )
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}(S_{int}) = \exp_{\mathcal{T}}\left( \tfrac{-1}{i \hbar} S_{int} \right)
              is the
              %a.existingWikiWord{:href => "/nlab/show/perturbative+S-matrix"} perturbative S-matrix
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#OnRegularObservablesPerturbativeSMatrix"}
            %p
              This indeed lands in
              %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
              in
              %a.existingWikiWord{:href => "/nlab/show/Planck%27s+constant"} Planck's constant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℏ
                  %annotation{:encoding => "application/x-tex"} \hbar
              (by remark
              = succeed ")," do
                %a.maruku-ref{:href => "#PowersInPlancksConstant"}
              %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
              as the
              %a.existingWikiWord{:href => "/nlab/show/perturbative+S-matrix"} perturbative S-matrix
              does (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#OnRegularObservablesPerturbativeSMatrix"}
            %p Hence the inverse map is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℛ
