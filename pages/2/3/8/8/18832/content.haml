            %h6#proof_9 Proof
            %p This is immediate from unwinding the definitions.
          #ReverseCausalFactorizationOfReverseTimeOrderedProducts.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong
                (reverse
                %a.existingWikiWord{:href => "/nlab/show/causal+factorization"} causal factorization
                of
                = succeed ")" do
