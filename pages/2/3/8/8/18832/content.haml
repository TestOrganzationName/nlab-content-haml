                %a.maruku-ref{:href => "#FeynmanPerturbationSeries"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/scattering+matrix"} scattering matrix
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                    %mrow
                      %mo (
                      %msub
                        %mi S
                        %mi int
                      %mo )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo ∈
                        %mi ℕ
                    %mfrac
                      %mn 1
                      %mrow
                        %mi k
                        %mo !
                    %mfrac
                      %mn 1
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mi ℏ
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                    %mi T
                    %mo{:stretchy => "false"} (
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mi S
                            %mi int
                          %mo ,
                          %mi ⋯
                          %mo ,
                          %msub
                            %mi S
                            %mi int
                        %mo ⏟
                      %mrow
                        %mi k
                        %mspace{:width => "thinmathspace"}
                        %mtext factors
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}
                    \\left(
                    S_{int}
                    \\right)
                    \=
                    \\underset{k \in \mathbb{N}}{\sum}
                    \\frac{1}{k!}
                    \\frac{1}{(i \hbar)^k}
                    T( \underset{k \, \text{factors}}{\underbrace{S_{int}, \cdots , S_{int}}} )
            %p
              of a given
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi int
                  %annotation{:encoding => "application/x-tex"} L_{int}
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
              are the summands in an expansion of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/time-ordered+products"} time-ordered products
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi ⋯
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(\cdots)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TimeOrderedProduct"}
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              with itself, which, away from coincident vertices, is given by the
              %a.existingWikiWord{:href => "/nlab/show/star+product"} star product
              of the
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \Delta_F
              (prop.
              = succeed ")," do
                %a.maruku-ref{:href => "#TimeOrderedProductAwayFromDiagonal"}
              %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
              contraction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %mo ,
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi prod
                    %mo ∘
                    %mi exp
                    %mrow
                      %mo (
                      %mi ℏ
                      %mo ∫
                      %msubsup
                        %mi Δ
                        %mi F
                        %mrow
                          %mi a
                          %mi b
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mfrac
                        %mi δ
                        %mrow
                          %mi δ
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi Φ
                            %mi a
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mfrac
                        %mi δ
                        %mrow
                          %mi δ
                          %mstyle{:mathvariant => "bold"}
                            %mi Φ
                          %mo{:stretchy => "false"} (
                          %mi y
                          %mo{:stretchy => "false"} )
                      %mo )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi int
                    %mo ⊗
                    %msub
                      %mi S
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    T(S_{int}, S_{int})
                    \\;=\;
                    prod \circ \exp
                    \\left(
                    \\hbar
                    \\int \Delta_{F}^{a b}(x,y)
                    \\frac{\delta}{\delta \mathbf{\Phi}^a(x)}
                    \\otimes
                    \\frac{\delta}{\delta \mathbf{\Phi}(y)}
                    \\right)
                    ( S_{int} \otimes S_{int} )
                    \\,.
            %p
              Each
              %a.existingWikiWord{:href => "/nlab/show/edge"} edge
              in a
              %a.existingWikiWord{:href => "/nlab/show/Feynman+diagram"} Feynman diagram
              corresponds to a factor of a
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                      %mo{:stretchy => "false"} (
                      %munder
                        %munder
                          %mrow
                            %msub
                              %mi S
                              %mi int
                            %mi ⋯
                            %msub
                              %mi S
                              %mi int
                          %mo ⏟
                        %mrow
                          %mi k
                          %mspace{:width => "thinmathspace"}
                          %mtext factors
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} T( \underset{k \, \text{factors}}{\underbrace{S_{int} \cdots S_{int}}} )
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/distribution+of+two+variables"} distribution of two variables
              %a.existingWikiWord{:href => "/nlab/show/vertex"} vertex
              corresponds to a factor of the
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mi i
                    %annotation{:encoding => "application/x-tex"} x_i
            %p
              For example
              %a.existingWikiWord{:href => "/nlab/show/quantum+electrodynamics"} quantum electrodynamics
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianQED"}
              %a.existingWikiWord{:href => "/nlab/show/Gaussian-averaged+Lorenz+gauge"} Gaussian-averaged Lorenz gauge
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#NLGaugeFixingOfElectromagnetism"}
              = succeed "):" do
                %a.maruku-ref{:href => "#FieldSpeciesQED"}
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
                  modelling the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/electron"} electron
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                  called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/electron+propagator"} electron propagator
                  (def.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#FeynmanPropagatorForDiracOperatorOnMinkowskiSpacetime"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mphantom
                          %mi AAAA
                        %mtext electron propagator
                      %annotation{:encoding => "application/x-tex"}
                        \\Delta \phantom{AAAA} \text{electron propagator}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/electromagnetic+field"} electromagnetic field
                  modelling the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/photon"} photon
                  %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                  called the
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/photon+propagator"} photon propagator
                  (prop.
                  = succeed ")," do
                    %a.maruku-ref{:href => "#PhotonPropagatorInGaussianAveragedLorenzGauge"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mphantom
                          %mi AAAA
                        %mtext photon propagator
                      %annotation{:encoding => "application/x-tex"}
                        G \phantom{AAAA} \text{photon propagator}
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/electron-photon+interaction"} electron-photon interaction
                  %a.maruku-eqref{:href => "#eq:ElectronPhotonInteractionLocalLagrangian"} (?)
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi L
                          %mi int
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %munder
                            %mrow
                              %mi i
                              %mi g
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi γ
                                %mi μ
                              %msup
                                %mo{:stretchy => "false"} )
                                %mi α
                              %msub
                                %mrow
                                %mi β
                            %mo ⏟
                          %mtext interaction
                        %mspace{:width => "thinmathspace"}
                        %munder
                          %munder
                            %mover
                              %mrow
                                %msub
                                  %mi ψ
                                  %mi α
                              %mo ¯
                            %mo ⏟
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mtext incoming
                                %mrow
                                  %mtext electron
                            %mrow
                              %mtext field
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %munder
                            %mrow
                              %msub
                                %mi a
                                %mi μ
                            %mo ⏟
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mspace{:width => "thinmathspace"}
                                %mrow
                                  %mtext photon
                            %mrow
                              %mtext field
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %munder
                            %mrow
                              %msup
                                %mi ψ
                                %mi β
                            %mo ⏟
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mtext outgoing
                                %mrow
                                  %mtext electron
                            %mrow
                              %mtext field
                      %annotation{:encoding => "application/x-tex"}
                        L_{int}
                        \\;=\;
                        \\underset{
                        \\text{interaction}
                        }{
                        \\underbrace{
                        i g
                        (\gamma^\mu)^\alpha{}_\beta
                        }
                        }
                        \\,
                        \\underset{
                        { \text{incoming} \atop \text{electron}  }
                        \\atop
                        \\text{field}
                        }{\underbrace{\overline{\psi_\alpha}}}
                        \\;
                        \\underset{
                        {
                        \\,
                        \\atop
                        \\text{photon}
                        }
                        \\atop
                        \\text{field}
                        }{\underbrace{a_\mu}}
                        \\;
                        \\underset{
                        {\text{outgoing} \atop \text{electron} }
                        \\atop
                        \\text{field}
                        }{\underbrace{\psi^\beta}}
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Feynman+diagram"} Feynman diagram
              for the
              %a.existingWikiWord{:href => "/nlab/show/electron-photon+interaction"} electron-photon interaction
              alone is
            %center
              %img{:src => "https://ncatlab.org/nlab/files/InteractionVertexOfQED.jpg", :width => "150"}/
            %p
              where the solid lines correspond to the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/electron"} electron
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/photon"} photon
              %a.existingWikiWord{:href => "/nlab/show/product+of+distributions"} product of distributions
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#HoermanderCriterionForProductOfDistributions"}
              = succeed "-notation," do
                %a.existingWikiWord{:href => "/nlab/show/generalized+function"} generalized function
              = succeed ")" do
                %a.maruku-ref{:href => "#SomeNonSingularTemperedDistributions"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi ℏ
                            %mrow
                              %mn 3
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mo −
                              %mn 1
                        %mo ⏟
                      %mtext loop order
                    %munder
                      %munder
                        %mrow
                          %mi i
                          %mi g
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi γ
                            %mi μ
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi α
                          %msub
                            %mrow
                            %mi β
                        %mo ⏟
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mtext electron-photon
                        %mrow
                          %mtext interaction
                    %mspace{:width => "thinmathspace"}
                    %mo .
                    %mspace{:width => "thinmathspace"}
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mover
                              %mrow
                                %mi Δ
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo ,
                                %mi x
                                %mo{:stretchy => "false"} )
                              %mo ¯
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo ,
                              %mi α
                        %mo ⏟
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mtext incoming
                            %mrow
                              %mtext electron
                        %mrow
                          %mtext propagator
                    %munder
                      %munder
                        %mrow
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi μ
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ⏟
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                            %mrow
                              %mtext photon
                        %mrow
                          %mtext propagator
                    %munder
                      %munder
                        %mrow
                          %mi Δ
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi β
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ⏟
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mtext outgoing
                            %mrow
                              %mtext electron
                        %mrow
                          %mtext propagator
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{
                    \\text{loop order}
                    }{
                    \\underbrace{
                    \\hbar^{3/2-1}
                    }
                    }
                    \\underset{
                    \\text{electron-photon}
                    \\atop
                    \\text{interaction}
                    }{
                    \\underbrace{
                    i g (\gamma^\mu)^\alpha{}_\beta
                    }
                    }
                    \\,.
                    \\,
                    \\underset{
                    {\text{incoming} \atop \text{electron}}
                    \\atop
                    \\text{propagator}
                    }{
                    \\underbrace{
                    \\overline{\Delta(-,x)}_{-, \alpha}
                    }
                    }
                    \\underset{
                    {
                    \\,
                    \\atop
                    \\text{photon}
                    }
                    \\atop
                    \\text{propagator}
                    }{
                    \\underbrace{
                    G(x,-)_{\mu,-}
                    }
                    }
                    \\underset{
                    { \text{outgoing} \atop \text{electron} }
                    \\atop
