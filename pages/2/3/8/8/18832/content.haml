                          %mi Γ
                          %mo{:stretchy => "false"} )
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{S}(g S_{int} + j A)
                    \\;=\;
                    \\underset{\Gamma \in \mathcal{G}}{\sum}
                    \\Gamma\left( (g S_{int} + j A)_{i = 1}^{v(\Gamma)} \right)
            %p
              contributes with a
              %a.existingWikiWord{:href => "/nlab/show/renormalization"} ("re"-)nromalized
              %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitude"} Feynman amplitude
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
