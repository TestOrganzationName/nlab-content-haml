                            %msub
                              %mrow
                                %mo (
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                                  %mrow
                                    %mi Γ
                                    %mo ∈
                                    %mi 𝒢
                                    %mo ∖
                                    %msub
                                      %mi 𝒢
                                      %mi vac
