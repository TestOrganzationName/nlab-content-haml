                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ⟩
                    %mover
