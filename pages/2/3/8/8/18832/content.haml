                    %mi Gen
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi CausClsdSubsets
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi Algebras
                  %annotation{:encoding => "application/x-tex"}
                    Gen(E_{\text{BV-BRST}}, \mathbf{L}_{int})
                    \\;\colon\;
                    CausClsdSubsets(\Sigma)
                    \\longrightarrow
                    Algebras
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/poset"} poset
              of
              %a.existingWikiWord{:href => "/nlab/show/causally+closed+subsets"} causally closed subsets
              of
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              to the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
            %blockquote
              %p
                (extends to
                %a.existingWikiWord{:href => "/nlab/show/star+algebras"} star algebras
                if scattering matrices are chosen unitary…)
          %p
            (
            %a{:href => "S-matrix#BrunettiFredenhagen99"}> Brunetti-Fredenhagen 99, (65)-(67)
            )
          %p The key technical fact is the following:
          #IsomorphismFromChangeOfAdiabaticSwitching.num_prop
            %h6#proposition_3 Proposition
            %p
              %strong
                (localized
                %a.existingWikiWord{:href => "/nlab/show/interacting+field+observables"} interacting field observables
                independent of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatic switching
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo ′
                    %mo ,
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E_{\text{BV-BRST}}, \mathbf{L}', \Delta_H )
              be a
              %a.existingWikiWord{:href => "/nlab/show/relativistic+field+theory"} relativistic
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/vacuum"} vacuum
              according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#VacuumFree"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              be a corresponding
              %a.existingWikiWord{:href => "/nlab/show/S-matrix"} S-matrix
              scheme according to def.
              = succeed "," do
                %a.maruku-ref{:href => "#LagrangianFieldTheoryPerturbativeScattering"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi int
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}_{int}
                    \\;\in\;
                    \\Omega^{p+1,0}_\Sigma(E_{\text{BV-BRST}})[ [ \hbar , g  ] ]
            %p
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi sw
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi sp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ⟨
                    %mi g
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} g_{sw} \in C^\infty_{sp}(\Sigma)\langle g \rangle
              an
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatic switching
              the
              %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %msub
                      %mi S
                      %mrow
                        %mi int
                        %mo ,
                        %mi sw
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mi sw
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi L
                      %mi int
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi LocObs
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mtext BV-BRST
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    g S_{int,sw} \;\coloneqq\; \tau_\Sigma(g_{sw} \mathbf{L}_{int})
                    \\;\in\;
                    LocObs(E_{\text{BV-BRST}})[ [ \hbar, g, j] ]
            %p
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+observable"} local observable
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switching"} adiabatically switched
              %a.existingWikiWord{:href => "/nlab/show/interaction"} interaction
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %p
              If two such
              %a.existingWikiWord{:href => "/nlab/show/adiabatic+switchings"} adiabatic switchings
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mrow
                        %mi sw
                        %mo ,
                        %mn 1
                    %mo ,
                    %msub
                      %mi g
                      %mrow
                        %mi sw
                        %mo ,
                        %mn 2
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g_{sw,1}, g_{sw,2} \in C^\infty_{cp}(\Sigma)
              agree on a
              %a.existingWikiWord{:href => "/nlab/show/causally+closed+subset"} causally closed subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O} \;\subset\; \Sigma
            %p in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
