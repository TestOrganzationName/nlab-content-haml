                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    i_{\mathcal{O}_1, \mathcal{O}_2}
                    \\;\colon\;
                    Gen(E_{\text{BV-BRST}}, \mathbf{L}_{int})(\mathcal{O}_1)
                    \\longrightarrow
