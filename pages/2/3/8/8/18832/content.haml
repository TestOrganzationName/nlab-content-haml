                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ℏ
                    %mo ,
                    %mi g
                    %mo ,
                    %mi j
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    Gen(E_{\text{BV-BRST}}, S_{int,sw} )(\mathcal{O})
                    \\;\coloneqq\;
                    \\left\langle
                    \\mathcal{Z}_{S_{int,sw}}(j A)
                    \\;\vert\;
                    A \in LocObs(E_{\text{BV-BRST}})[ [ \hbar, g] ]
