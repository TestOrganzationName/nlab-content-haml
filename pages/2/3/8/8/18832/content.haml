                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi Γ
                        %mo ∈
                        %mi 𝒢
                    %mi Γ
                    %mrow
                      %mo (
                      %mo{:stretchy => "false"} (
                      %mi g
