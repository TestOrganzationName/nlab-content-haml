          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/3-manifolds"} 3-manifolds
          %ul
            %li#BottCattaneo98
              %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"} Alberto Cattaneo
              = succeed "," do
                %em Integral Invariants of 3-Manifolds
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/dg-ga/9710001"} arXiv:dg-ga/9710001
          %p
            On the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
          %ul
            %li#CattaneoFelder
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Giovanni+Felder"} Giovanni Felder
                = succeed "," do
                  %em A path integral approach to the Kontsevich quantization formula
                = succeed "," do
                  %a{:href => "http://dx.doi.org/10.1007/s002200000229"} doi
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/math/9902090"} math.QA/9902090
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Giovanni+Felder"} Giovanni Felder
                = succeed "," do
                  %em Poisson sigma models and deformation quantization
                %a{:href => "http://arxiv.org/abs/hep-th/0102208"} hep-th/0102208
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
