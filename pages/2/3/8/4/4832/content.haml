            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/Gerstenhaber+algebras"} Gerstenhaber algebras
          %ul
            %li#CattaneoFiorenzaLongoni06
              %a.existingWikiWord{:href => "/nlab/show/Alberto+S.+Cattaneo"}> Alberto S. Cattaneo
              ,
              = succeed "," do
