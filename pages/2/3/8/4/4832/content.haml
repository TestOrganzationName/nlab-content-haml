              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1811.07395"} arXiv:1811.07395
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/B0-12-512666-2/00434-X"} doi:10.1016/B0-12-512666-2/00434-X
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST formalism
            compatible with decomposing
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
