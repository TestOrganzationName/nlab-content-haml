                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Klaas+Landsman"} Klaas Landsman
              %p
                %a{:href => "http://arxiv.org/abs/math/0003023"}> math.SG/0003023
                \.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Giovanni+Felder"} Giovanni Felder
                = succeed "," do
                  %em On the AKSZ formulation of the Poisson sigma model
                = succeed "&rbrack;" do
                  %a{:href => "http://arxiv.org/abs/math/0102108"} math.QA/0102108
          %p
