            %a.existingWikiWord{:href => "/nlab/show/Vassiliev+invariants"} Vassiliev invariants
            as
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/correlators"} correlators
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+space+of+points"} configuration space
            %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
            of
            %a.existingWikiWord{:href => "/nlab/show/wedge+products"} wedge products
            of
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+propagators"} Chern-Simons propagators
            assigned to
            %a.existingWikiWord{:href => "/nlab/show/edges"} edges
            of
            %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
            in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/graph+complex"} graph complex
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                , Paolo Cotta-Ramusino, Riccardo Longoni,
                = succeed "," do
                  %em Configuration spaces and Vassiliev classes in any dimension
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/math/9910139"} arXiv:math/9910139
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                , Paolo Cotta-Ramusino, Riccardo Longoni:
                = succeed "," do
                  %em Algebraic structures on graph cohomology
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/math/0307218"} arXiv:math/0307218
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/string+topology"} string topology
            and
            %a.existingWikiWord{:href => "/nlab/show/BV-formalism"} BV-formalism
            for
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+field+theories"} topological field theories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alberto+S.+Cattaneo"}> Alberto S. Cattaneo
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Juerg+Froehlich"} Juerg Froehlich
              = succeed "," do
                %em Topological Field Theory Interpretation of String Topology
              %strong 240
              (2003) 397–421 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/s00220-003-0917-2"}> doi:10.1007/s00220-003-0917-2
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/math/0202176"} arXiv:math/0202176
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"} deformation quantization
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
              ,
              = succeed "," do
                %em From topological field theory to deformation quantization and reduction
              = succeed "&rbrack;" do
                %a{:href => "http://www.math.uzh.ch/fileadmin/math/preprints/icm.pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/Poisson+algebras"} Poisson algebras
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
            to
            %a.existingWikiWord{:href => "/nlab/show/graded+vector+spaces"} graded vector spaces
