                            %mo •
                      %mo ×
                      %mi V
                    %annotation{:encoding => "application/x-tex"} (V/G)_\bullet = G^{\times_{\bullet}} \times V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ♯
