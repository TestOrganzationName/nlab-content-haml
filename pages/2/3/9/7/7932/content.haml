                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .num_prop
            %h6#proposition Proposition
            %p
              Every
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi V
                    %mo ×
                    %mi G
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \rho : V \times G \to V
              has a classifying morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mi ρ
                    %mo :
                    %mi V
                    %mo ⫽
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{c}_\rho : V \sslash G \to \mathbf{B}G
              in that there is a
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi V
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi V
                            %mo ⫽
                            %mi G
                          %mtd
                            %mover
                              %mo →
                              %mover
                                %mi ρ
                                %mo ¯
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V
                    \\\
                    \\downarrow
                    \\\
                    V \sslash G &amp;\stackrel{\overline{\rho}}{\to}&amp; \mathbf{B}G
                    }
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              is the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              regarded as the corresponding
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              modulated by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
