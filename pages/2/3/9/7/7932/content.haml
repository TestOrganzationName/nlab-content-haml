              %a.existingWikiWord{:href => "/nlab/show/hom+groupoid"} hom groupoid
              of the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"} slice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
