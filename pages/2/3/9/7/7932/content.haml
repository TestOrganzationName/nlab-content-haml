                  %a{:href => "#infinitesimally_actions_of_algebroids"}
                    Infinitesimally: actions of
                    = succeed "-algebroids" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi L
