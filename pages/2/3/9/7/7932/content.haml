                                  %mi g
                          %mtr
                            %mtd
                              %mi ρ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mo ↦
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi g
                          %mtr
                            %mtd
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi ρ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo =
                              %mi ρ
                              %mo{:stretchy => "false"} (
                              %mi ϕ
                              %mo{:stretchy => "false"} (
                              %mi s
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_\bullet
                    \\;\colon\;
                    \\left(
                    \\array{
                    s
                    \\\
                    \\downarrow^{\mathrlap{g}}
                    \\\
                    \\rho(s)(g)
                    }
                    \\right)
                    \\mapsto
                    \\left(
                    \\array{
                    \\phi(s)
                    \\\
                    \\downarrow^{\mathrlap{g}}
                    \\\
                    \\phi(\rho(s)(g)) &amp; = \rho(\phi(s))(g)
