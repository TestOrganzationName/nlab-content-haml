                          %annotation{:encoding => "application/x-tex"} L_\infty
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#model_category_presentation"} Model category presentation
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
              %ul
                %li
                  %a{:href => "#general"} General
                %li
                  %a{:href => "#ReferencesForDiscreteGeometry"} For discrete geometry
                %li
                  %a{:href => "#ForActionsOfTopologicalGroups"} For actions of topological groups
          %h2#idea Idea
          %p
            The notion of
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-action
            is the notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/action"} action
            (
            %a.existingWikiWord{:href => "/nlab/show/module"}> module
            \/
            %a.existingWikiWord{:href => "/nlab/show/representation"}> representation
            ) in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theory
            %a.existingWikiWord{:href => "/nlab/show/algebra"} algebra
            to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
          %p
            Notably a
            %a.existingWikiWord{:href => "/nlab/show/monoid+object+in+an+%28%E2%88%9E%2C1%29-category"} monoid object in an (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            may
            %em act
            on another object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            by a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊗
                  %mi N
                  %mo →
                  %mi N
                %annotation{:encoding => "application/x-tex"} A \otimes N \to N
            which satisfies an action property up to
            %a.existingWikiWord{:href => "/nlab/show/coherence+law"} coherent
            higher
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
          %p
            If the
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-representation"} ∞-representation
          %h2#definition Definition
          %p
            We discuss the actions of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            in an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %a{:href => "#NSS"} NSS
            %a.existingWikiWord{:href => "/nlab/show/groupoid+%E2%88%9E-actions"} groupoid ∞-actions
            see there.)
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ∈
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \in Grp(\mathbf{H})
            be an
            %a.existingWikiWord{:href => "/nlab/show/group+object+in+an+%28%E2%88%9E%2C1%29-category"} group object in an (∞,1)-category
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %mi ⋯
                    %mover
                      %mover
                        %mover
                          %mo ⟶
                          %mo ⟶
                        %mo ⟶
                      %mo ⟶
                    %mi G
                    %mo ×
                    %mi G
                    %mover
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mo ⟶
                    %mi G
                    %mover
                      %mo ⟶
                      %mo ⟶
                    %mo *
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\cdots
                  \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}}
                  G \times G \stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}} G \stackrel{\longrightarrow}{\longrightarrow} *
                  \\right)
          %p
            satisfying the groupoidal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Segal+conditions"} Segal conditions
          %p
            hence an
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
          .num_defn
            %h6#definition_2 Definition
            %p
              An
              %strong action
              (or
              = succeed "," do
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} V \in \mathbf{H}
              is a
              %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
              which is equivalent to one of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi ⋯
                      %mover
                        %mover
                          %mover
                            %mo ⟶
                            %mo ⟶
                          %mo ⟶
                        %mo ⟶
                      %mi V
                      %mo ×
                      %mi G
                      %mo ×
                      %mi G
                      %mover
                        %mover
                          %mo ⟶
                          %mo ⟶
                        %mo ⟶
                      %mi V
                      %mo ×
                      %mi G
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mi p
                              %mn 1
                        %mover
                          %mo ⟶
                          %mi ρ
                      %mi V
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\cdots
                    \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}}
                    V \times G \times G \stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}} V \times G \stackrel{\overset{\rho}{\longrightarrow}}{\underset{p_1}{\longrightarrow}} V
                    \\right)
            %p such that the projection maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mover
                              %mover
                                %mover
                                  %mo ⟶
                                  %mo ⟶
                                %mo ⟶
                              %mo ⟶
                          %mtd
                            %mi V
                            %mo ×
                            %mi G
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %mover
                                %mo ⟶
                                %mo ⟶
                              %mo ⟶
                          %mtd
                            %mi V
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                              %mover
                                %mo ⟶
                                %mi ρ
                          %mtd
                            %mi V
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi ⋯
                          %mtd
                            %mover
                              %mover
                                %mover
                                  %mo ⟶
                                  %mo ⟶
                                %mo ⟶
                              %mo ⟶
                          %mtd
                            %mi G
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %mover
                                %mo ⟶
                                %mo ⟶
                              %mo ⟶
                          %mtd
                            %mi G
                          %mtd
                            %mover
                              %munder
                                %mo ⟶
                                %mrow
                              %mover
                                %mo ⟶
