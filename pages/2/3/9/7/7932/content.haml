              and the full subcategory of the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"} slice (2,1)-category
              of
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              on the
              = succeed "." do
