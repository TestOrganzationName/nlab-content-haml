                                %mn 2
                        %mtd
                        %mtd
                          %mo *
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \ast
                  \\\
                  \&amp; {}^{\mathllap{g_1}}\nearrow &amp;&amp; \searrow^{\mathrlap{g_2}}
                  \\\
                  \\ast &amp;&amp; \underset{g_1 \cdot g_2}{\longrightarrow} &amp;&amp; \ast
                  }
                  \\,.
          #Action1Groupoid.num_defn
            %h6#definition_7 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and an
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo ×
                    %mi G
                    %mo ⟶
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \colon S \times G \longrightarrow S
            %p
              then the corresponding
              %em
                %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ≔
                    %mrow
                      %mo (
                      %mi S
                      %mo ×
                      %mi G
                      %mover
                        %munder
                          %mo ⟶
                          %mi ρ
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi p
                              %mn 1
                      %mi S
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    (S//G)_\bullet
                    \\coloneqq
                    \\left(
                    S\times G
                    \\stackrel{\overset{p_1}{\longrightarrow}}{\underset{\rho}{\longrightarrow}}
                    S
                    \\right)
            %p
              with
              %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              given by the product in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              are the elements of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mover
                      %mo ⟶
                      %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} s \stackrel{}{\longrightarrow } t
              are labeled by elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g\in G
              and are such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo =
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} t = \rho(s)(g)
          %p Schematically:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo •
