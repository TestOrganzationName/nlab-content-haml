              = succeed "." do
                %em
                  %a{:href => "Borel+model+structure#RelationToSliceOverSimplicialClassifyingSpace"} Borel model structure – Relation to the slice over the simplicial classifying space
          .num_remark
            %h6#remark Remark
            %p
              A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo ∈
                    %msub
                      %mi Act
                      %mstyle{:mathvariant => "bold"}
                        %mi H
