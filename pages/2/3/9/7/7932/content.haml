              = succeed "." do
                %a{:href => "n-image#nImagePreservesProducts"} this proposition
              %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
