                    \\right)
                    \\,.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of the morphism in prop.
              %a.maruku-ref{:href => "#MapFromActionGroupoidOnSetBackToBG"}
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalent
              to the set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi S
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mi ρ
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S &amp;\longrightarrow&amp; S//G
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p_\rho}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              In the presentation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (S//G)_\bullet
              of def.
              = succeed "," do
                %a.maruku-ref{:href => "#Action1Groupoid"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} p_\rho
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
              = succeed "." do
                %a.maruku-ref{:href => "#MapFromActionGroupoidOnSetBackToBG"}
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi ρ
                  %annotation{:encoding => "application/x-tex"} p_\rho
              are equivalent to the ordinary fibers of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi ρ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_\rho)_\bullet
              computed in the 1-category of 1-groupoids. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mi ρ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_\rho)_\bullet
              is the identity on the labels of the morphisms in this presentation, this ordinary fiber is precisely the sub-groupoid of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (S//G)_\bullet
              consisting of only the identity morphismss, hence is the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              regarded as a groupoid.
          %p Conversely, the following construction extract a group action from a homotopy fiber sequence of groupoids of this form.
          #ActionMapFromFiberSequenceSetToGroupoidToBG.num_defn
            %h6#definition_8 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
              of
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S &amp;\stackrel{i}{\longrightarrow}&amp; E
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
            %p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalent
              to a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on this set as follows.
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+product"} homotopy fiber product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %munder
                      %mo ×
                      %mi E
                    %mi S
                    %mover
                      %munder
                        %mo ⟶
                        %mrow
                      %mover
                        %mo ⟶
                        %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"}
                    S \underset{E}{\times} S
                    \\stackrel{\overset{}{\longrightarrow}}{\underset{}{\longrightarrow}}
                    S
            %p
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              with itself. By the
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              applied to the total homotopy pullback diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                            %munder
                              %mo ×
                              %mi E
                            %mi S
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi S
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi i
                        %mtr
                          %mtd
                            %mi S
                          %mtd
                            %mover
                              %mo ⟶
                              %mi i
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi S
                            %mo ×
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                          %mtd
                            %mi S
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S \underset{E}{\times} S &amp;\longrightarrow&amp; S
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{i}}
                    \\\
                    S &amp;\stackrel{i}{\longrightarrow}&amp; E
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    \\ast &amp;\longrightarrow&amp; \mathbf{B}G
                    }
                    \\;\;\;\;
                    \\simeq
                    \\;\;\;\;
                    \\array{
                    S\times G &amp;\stackrel{p_1}{\longrightarrow}&amp; S
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    G &amp;\stackrel{}{\longrightarrow}&amp; \ast
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\ast &amp;\longrightarrow&amp; \mathbf{B}G
                    }
            %p
              there is a canonical
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+groupoids"} equivalence of groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %munder
                      %mo ×
                      %mi E
                    %mi S
                    %mo ≃
                    %mi S
                    %mo ×
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    S \underset{E}{\times} S \simeq S \times G
            %p
              such that one of the two canonical maps from the fiber product to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is projection on the first factor. The
              %em other
              map under this equivalence we denote by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ×
                    %mi G
                    %mover
                      %munder
                        %mo ⟶
                        %mi ρ
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi p
                            %mn 1
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \times G
                    \\stackrel{\overset{p_1}{\longrightarrow}}{\underset{\rho}{\longrightarrow}}
                    S
                    \\,.
          .num_remark
            %h6#remark_9 Remark
            %p
              The functor
