                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V_1 \sslash G &amp;&amp;\stackrel{}{\to}&amp;&amp; V_2 \sslash G
                    \\\
                    \&amp; {}_{\mathllap{\overline{\rho_1}}}\searrow &amp;&amp; \swarrow_{\mathrlap{\overline{\rho_2}}}
