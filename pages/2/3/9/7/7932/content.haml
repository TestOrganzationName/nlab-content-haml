                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} S_2
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
              between the set of action
              %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              (“
              %a.existingWikiWord{:href => "/nlab/show/intertwiners"}> intertwiners
              ”)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
