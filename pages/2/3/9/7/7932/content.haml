                    %mi η
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo ♯
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
