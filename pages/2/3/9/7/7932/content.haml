                          %mtd
                            %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\cdots
                    \&amp;\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}}&amp;
                    V \times G \times G
                    \&amp;\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}&amp;
                    V \times G
                    \&amp;\stackrel{\overset{\rho}{\longrightarrow}}{\underset{p_1}{\longrightarrow}}&amp;
                    V
                    \\\
                    \&amp;&amp; \downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \\cdots
                    \&amp;\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}}&amp;
                    G \times G
                    \&amp;\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}&amp;
                    G
                    \&amp;\stackrel{\overset{}{\longrightarrow}}{\underset{}{\longrightarrow}}&amp;
                    *
                    }
            %p
              constitute a morphism of groupoid objects
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⫽
                      %mi G
                      %mo →
                      %mo *
                      %mo ⫽
                      %mi G
                    %annotation{:encoding => "application/x-tex"} V\sslash G \to *\sslash G
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of such actions is the slice of groupoid objects over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ⫽
                    %mi G
                  %annotation{:encoding => "application/x-tex"} *\sslash G
              on these objects.
          %p
            There is an equivalent formulation which does not invoke the notion of
            %a.existingWikiWord{:href => "/nlab/show/groupoid+object+in+an+%28%E2%88%9E%2C1%29-category"} groupoid object in an (∞,1)-category
            explicitly. This is based on the fundamental fact, discussed at
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            constitutes an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo :
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msubsup
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo ≥
                      %mn 1
                    %mrow
                      %mo *
                      %mo{:stretchy => "false"} /
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{B} : Grp(\mathbf{H}) \to \mathbf{H}^{*/}_{\geq 1}
                  \\,.
          %p
            form
            %a.existingWikiWord{:href => "/nlab/show/group+objects+in+an+%28%E2%88%9E%2C1%29-category"} group objects in an (∞,1)-category
            to the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/connected+object+in+an+%28%E2%88%9E%2C1%29-topos"} connected
            %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
