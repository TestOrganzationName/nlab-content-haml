                      \\vdash \sum_{\mathbf{c} : \mathbf{B}G} V(\mathbf{c}) : Type
              %p
                is the
                %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⫽
                      %mi G
                    %annotation{:encoding => "application/x-tex"} V\sslash G
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                by
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊢
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo :
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi Type
                    %annotation{:encoding => "application/x-tex"}
                      \\vdash \prod_{\mathbf{c} : \mathbf{B}G} V(\mathbf{c}) : Type
              %p
                is the collection of
                %a.existingWikiWord{:href => "/nlab/show/invariants"} invariants
                (
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fixed+points"}> homotopy fixed points
                ) of the action.
          %p
            And for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                  %mo ,
                  %msub
                    %mi V
                    %mn 2
                %annotation{:encoding => "application/x-tex"} V_1, V_2
            two actions we have
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
                over the
                %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent
                %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊢
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo :
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mo{:stretchy => "false"} (
