                    \\,.
          %h2#NotionsInHigherRepresentationTheory Notions in higher representation theory
          %p
            We discuss some basic
            %a.existingWikiWord{:href => "/nlab/show/representation+theory"} representation theoretic
            notions of
            = succeed "-actions." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            In summary, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo ⊢
                  %mi V
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi c
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Type
                %annotation{:encoding => "application/x-tex"} \mathbf{c} : \mathbf{B}G \vdash V(\mathbf{c}) : Type
            an action of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊢
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi c
                          %mo :
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mi V
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi c
                      %mo{:stretchy => "false"} )
