                          %mtd
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msub
                                  %mi g
                                  %mn 1
                                %msub
                                  %mi g
                                  %mn 2
                          %mtd
                          %mtd
                            %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi s
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi g
                              %mn 1
                            %msub
                              %mi g
                              %mn 2
                            %mo{:stretchy => "false"} )
                    %mo }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (S//G)_\bullet =
                  \\left\{
                  \\array{
                  \&amp;&amp; \rho(s)(g)
                  \\\
                  \&amp; {}^{\mathllap{g_1}}\nearrow &amp;&amp; \searrow^{\mathrlap{g_2}}
                  \\\
                  s &amp;&amp; \underset{g_1 g_2}{\longrightarrow} &amp;&amp; \rho(s)(g_1 g_2)
                  }
                  \\right\}
                  \\,.
          .num_example
            %h6#example Example
            %p
              For the unique and trivial
