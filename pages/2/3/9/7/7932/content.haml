                      %mi p
                      %mrow
                        %msub
                          %mi ρ
                          %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G Act(\rho_1,\rho_2)
                    \\simeq
                    Grpd_{/\mathbf{B}G}(p_{\rho_1}, p_{\rho_2})
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              One quick way to see this is to use, via the discussion at
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"} slice (infinity,1)-category
              %a.existingWikiWord{:href => "/nlab/show/hom-groupoid"} hom-groupoid
              in the slice is given by the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              of unsliced hom-groupoids
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Grpd
                              %mrow
                                %mo{:stretchy => "false"} /
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi p
                              %mrow
                                %msub
                                  %mi ρ
                                  %mn 1
                            %mo ,
                            %msub
                              %mi p
                              %mrow
                                %msub
                                  %mi ρ
                                  %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi S
                              %mn 1
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ,
                            %msub
                              %mi S
                              %mn 2
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Grpd
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi S
                                    %mn 1
                                  %mo{:stretchy => "false"} /
                                  %mo{:stretchy => "false"} /
                                  %mi G
                                  %mo ,
                                  %msub
                                    %mi p
                                    %mrow
                                      %msub
                                        %mi ρ
                                        %mn 2
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi Grpd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi S
                              %mn 1
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi G
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Grpd_{/\mathbf{B}G}(p_{\rho_1}, p_{\rho_2})
                    \&amp;\longrightarrow&amp;
                    Grpd(S_1//G, S_2//G)
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{Grpd(S_1//G,p_{\rho_2})}}
                    \\\
                    \\ast &amp;\stackrel{}{\longrightarrow}&amp; Grpd(S_1//G, \mathbf{B}G)
                    }
                    \\,.
            %p
              Now since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mrow
                        %msub
                          %mi ρ
                          %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"} (p_{\rho_2})_\bullet
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/isofibration"} isofibration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Grpd
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mrow
                          %msub
                            %mi ρ
                            %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Grpd((S_1//G)_\bullet, (p_{\rho_2})_\bullet)
              %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              in the 1-categorical slice. This consists of functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo •
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mn 1
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi G
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo •
                  %annotation{:encoding => "application/x-tex"}
                    \\phi_\bullet \colon (S_1//G)_\bullet \longrightarrow (S_1//G)_\bullet
            %p
              which strictly preserves the
              = succeed "-labels" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ϕ
                      %mo •
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo (
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi s
                          %mtr
                            %mtd
