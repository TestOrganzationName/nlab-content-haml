          %h4#AutomorphismAction Automorphism action
          #AutomorphAction.num_defn
            %h6#definition_10 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
