                %a.existingWikiWord{:href => "/nlab/show/fiber+%E2%88%9E-bundle"} fiber ∞-bundle
          #DefinitionInTypeTheory.num_remark
            %h6#remark_3 Remark
            %p
              In the form of def.
              %a.maruku-ref{:href => "#GActionByFiberSequence"}
              = succeed "-actions" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.existingWikiWord{:href => "/nlab/show/internal+language"} internal language
              of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              is simply a
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              with fiber
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ⊢
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Type
                    %mspace{:width => "thinmathspace"}
