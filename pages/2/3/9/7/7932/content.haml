                  %annotation{:encoding => "application/x-tex"} \sharp_n
              to this yields a simplicial object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
