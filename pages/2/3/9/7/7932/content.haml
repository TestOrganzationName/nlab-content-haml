                      (V_1(\mathbf{c}) \to V_2(\mathbf{c})) : Type
              %p
                is the
                %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                of
                %em all
                functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 1
                      %mo →
                      %msub
                        %mi V
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} V_1 \to V_2
                by the
                %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
          %h3#Invariants Invariants
          #TypeOfInvariants.num_defn
            %h6#definition_4 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/invariants"} invariants
              (
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fixed+points"}> homotopy fixed points
              ) of a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              are the
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
              of the morphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ⫽
                      %mi G
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} V \sslash G \to \mathbf{B}G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Invariants
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mo →
                        %mo *
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ⫽
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Invariants(V) = \prod_{\mathbf{B}G \to *} (V \sslash G \to \mathbf{B}G)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mo →
                        %mo *
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \prod_{\mathbf{B}G \to *} : \mathbf{H}_{/\mathbf{B}G} \to \mathbf{H}
              is the
              %a.existingWikiWord{:href => "/nlab/show/direct+image"} direct image
              of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/base+change+geometric+morphism"} base change geometric morphism
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              %a.existingWikiWord{:href => "/nlab/show/syntax"} syntax
              for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ⊢
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Type
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{c} : \mathbf{B}G \vdash V(\mathbf{c}) : Type
            %p
              an action as in remark
              = succeed "," do
                %a.maruku-ref{:href => "#DefinitionInTypeTheory"}
              %a.existingWikiWord{:href => "/nlab/show/invariants"} invariants
              is the
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊢
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Type
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\vdash \prod_{\mathbf{c} : \mathbf{B}G} V(\mathbf{c}) : Type
                    \\,.
          .num_remark
            %h6#remark_4 Remark
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/internal+limit"} internal limit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the
              %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mi Type
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \colon \mathbf{B}G \to Type
                    \\,.
            %p
              See at
              = succeed "." do
                %em
                  %a{:href => "internal+%28co-%29limit#BorelConstructionHomotopyQuotients"} internal limit – Examples – Homotopy Invariants
          %h3#Quotients Coinvariants / Quotients
          %p
            From def.
            %a.maruku-ref{:href => "#GActionByFiberSequence"}
            we read off:
          .num_defn
            %h6#definition_5 Definition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of a
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ⊢
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Type
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{c} : \mathbf{B}G \vdash V(\mathbf{c}) : Type
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum"} dependent sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊢
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mi V
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Type
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\vdash \sum_{\mathbf{c} : \mathbf{B}G} V(\mathbf{c}) : Type
                    \\,.
          .num_remark
            %h6#remark_5 Remark
            %p
              This is the
              %a.existingWikiWord{:href => "/nlab/show/internal+colimit"} internal colimit
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              of the
              %a.existingWikiWord{:href => "/nlab/show/internal+diagram"} internal diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:lspace => "verythinmathspace"} :
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo →
                    %mi Type
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\rho \colon \mathbf{B}G \to Type
                    \\,.
            %p
              See at
              = succeed "." do
                %em
                  %a{:href => "internal+%28co-%29limit#BorelConstructionHomotopyQuotients"} internal limit – Examples – Homotopy Coinvariants
          %h3#CartesianClosedMonoidalStructure Conjugation actions
          .num_remark
            %h6#remark_6 Remark
            %p
              By def.
              = succeed "," do
                %a.maruku-ref{:href => "#GActionByFiberSequence"}
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Act
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Act_{\mathbf{H}}(G)
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              and in particular is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+%28%E2%88%9E%2C1%29-category"} cartesian closed (∞,1)-category
          %p
            We describe here aspects of the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            and
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            of
            = succeed "-actions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          .num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 2
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V_1, \rho_1), (V_2, \rho_2) \in Act(G)
              their
              %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
              is a
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} V_1
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_2
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
          .proof
            %h6#proof Proof
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi V
                              %mi i
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi V
                              %mi i
                            %mo ⫽
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mover
                                    %mi ρ
                                    %mo{:stretchy => "false"} ¯
                                  %mi i
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V_i &amp;\to&amp; V_i \sslash G
                    \\\
                    \&amp;&amp; \downarrow^{\bar \rho_i}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
              exhibiting the two actions.
            %p
              Along the lines of the discussion at
              %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+category"} locally cartesian closed category
              we find that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mn 2
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (V_1, \rho_1) \times (V_2, \rho_2) \in Act(G)
              is given in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
              by the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %msub
                      %mover
                        %mi ρ
                        %mo{:stretchy => "false"} ¯
                      %mn 1
                    %mo ×
                    %msub
                      %mover
                        %mi ρ
                        %mo{:stretchy => "false"} ¯
                      %mn 2
                    %mo ≃
                    %msub
                      %mi V
                      %mn 1
                    %mo ⫽
                    %mi G
                    %msub
                      %mo ×
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %msub
                      %mi V
                      %mn 2
                    %mo ⫽
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\sum_{\mathbf{B}G}
                    \\bar \rho_1 \times
                    \\bar \rho_2
                    \\simeq
                    V_1\sslash G \times_{\mathbf{B}G} V_2 \sslash G
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi V
                              %mn 1
                            %mo ×
                            %msub
                              %mi V
                              %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi V
                              %mn 1
                            %mo ⫽
                            %mi G
                            %msub
                              %mo ×
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %msub
                              %mi V
                              %mn 2
                            %mo ⫽
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mrow
                                    %msub
                                      %mi ρ
                                      %mn 1
                                    %mo ×
                                    %msub
                                      %mi ρ
                                      %mn 2
                                  %mo ¯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    V_1 \times V_2 &amp;\to&amp; V_1\sslash G \times_{\mathbf{B}G} V_2 \sslash G
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{\overline{ \rho_1 \times \rho_2 }}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
                    \\,.
            %p
              Here the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              on the left is identified as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                    %mo ×
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_1 \times V_2
              by using that
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limits"} (∞,1)-limits
              commute over each other.
          #InternalHomAction.num_prop
            %h6#proposition_3 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ρ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo ∈
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho_1, \rho_2 \in Act(G)
              their
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi ρ
                      %mn 1
                    %mo ,
                    %msub
                      %mi ρ
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msub
                      %mi Act
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} [\rho_1, \rho_2] \in Act_{\mathbf{H}}(G)
              is a
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi V
                        %mn 1
                      %mo ,
                      %msub
                        %mi V
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} [V_1, V_2] \in \mathbf{H}
          .proof
            %h6#proof_2 Proof
            %p Taking fibers
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi pt
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %mo *
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"}
                    pt_{\mathbf{B}G}^* : \mathbf{H}_{/\mathbf{B}G} \to \mathbf{H}
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
              of an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
              %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+functor"} cartesian closed functor
              (see the
              %em
                %a{:href => "cartesian+closed+functor#Examples"} Examples
              there for details). Therefore it preserves
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/exponential+objects"} exponential objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi pt
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                              %mo *
                            %mo{:stretchy => "false"} [
                            %msub
                              %mover
                                %mi ρ
                                %mo{:stretchy => "false"} ¯
                              %mn 1
                            %mo ,
                            %msub
                              %mover
                                %mi ρ
                                %mo{:stretchy => "false"} ¯
                              %mn 2
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %msubsup
                              %mi pt
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                              %mo *
                            %msub
                              %mover
                                %mi ρ
                                %mo{:stretchy => "false"} ¯
                              %mn 1
                            %mo ,
                            %msubsup
                              %mi pt
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                              %mo *
                            %msub
                              %mover
                                %mi ρ
                                %mo{:stretchy => "false"} ¯
                              %mn 2
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi V
                              %mn 1
                            %mo ,
                            %msub
                              %mi V
                              %mn 2
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    pt_{\mathbf{B}G}^* [\bar \rho_1, \bar \rho_2]
                    \&amp;
                    \\simeq
                    [pt_{\mathbf{B}G}^* \bar \rho_1, pt_{\mathbf{B}G}^* \bar \rho_2]
                    \\\
                    \&amp; \simeq [V_1, V_2]
                    \\end{aligned}
                    \\,.
          .num_remark
            %h6#remark_7 Remark
            %p The above internal-hom action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi V
                              %mn 1
                            %mo ,
                            %msub
                              %mi V
                              %mn 2
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi V
                              %mn 1
                            %mo ⫽
                            %mi G
                            %msub
                              %mo ×
                              %mrow
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %mi G
                            %msub
                              %mi V
                              %mn 2
                            %mo ⫽
                            %mi G
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mover
                                  %mrow
                                    %mo{:stretchy => "false"} [
                                    %msub
                                      %mi ρ
                                      %mn 1
                                    %mo ,
                                    %msub
                                      %mi ρ
                                      %mn 2
                                    %mo{:stretchy => "false"} ]
                                  %mo ¯
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    [V_1,V_2] &amp;\to&amp; V_1 \sslash G \times_{\mathbf{B}G} V_2 \sslash G
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{\overline{[\rho_1,\rho_2]}}}
                    \\\
                    \&amp;&amp; \mathbf{B}G
                    }
            %p
              encodes the
              %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi V
                      %mn 1
                    %mo ,
                    %msub
                      %mi V
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [V_1, V_2]
              by pre- and post-composition of
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                    %mo →
                    %msub
                      %mi V
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} V_1 \to V_2
              with the
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} V_1
              and on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi V
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} V_2
            %p
              See also at
              %em
                %a{:href => "#ConjugationActions"} Conjugation actions
              below.
          %h3#internal_object_of_homomorphisms Internal object of homomorphisms
          .num_remark
            %h6#remark_8 Remark
            %p
              The
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
              %a.maruku-ref{:href => "#TypeOfInvariants"}
              of the conjugation action, prop.
              %a.maruku-ref{:href => "#InternalHomAction"}
              are the action
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
              = succeed ".)" do
                %a{:href => "#ConjugationActions"} Examples - Conjugation actions
          %p Therefore
          .num_defn
            %h6#definition_6 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi ρ
                        %mo{:stretchy => "false"} ¯
                      %mi i
                    %mo :
                    %msub
                      %mi V
                      %mi i
                    %mo ⫽
                    %mi G
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \bar \rho_i : V_i \sslash G \to \mathbf{B}G
              two
              = succeed "-actions," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %strong object of homomorphisms
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %mo →
                        %mo *
                    %mo{:stretchy => "false"} [
                    %msub
                      %mover
                        %mi ρ
                        %mo{:stretchy => "false"} ¯
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi ρ
                        %mo{:stretchy => "false"} ¯
                      %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\prod_{\mathbf{B}G \to *}[\bar \rho_1, \bar \rho_2]
                    \\in \mathbf{H}
                    \\,.
            %p
              In the
              %a.existingWikiWord{:href => "/nlab/show/syntax"} syntax
              of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊢
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi c
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %msub
                      %mi V
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi V
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi c
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Type
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\vdash \prod_{\mathbf{c} : \mathbf{B}G}
                    V_1(\mathbf{c}) \to V_2(\mathbf{c})
                    \: Type
                    \\,.
          %h3#stabilizer_groups Stabilizer groups
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/stabilizer+group"} stabilizer group
          %h3#Linearization Linearization
          %p
            We discuss
            %em linearization
            of
            = succeed "-actions" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohesion"} differential cohesion
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo{:lspace => "verythinmathspace"} :
                  %mo *
                  %mo →
                  %mi V
                %annotation{:encoding => "application/x-tex"} 0 \colon \ast \to V
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            be an
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi V
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  V &amp;\longrightarrow&amp; V/G
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{B}G
                  }
          %p
            such that this action preserves the point of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %a.existingWikiWord{:href => "/nlab/show/invariant"} invariant
            of the action. This means equivalently that there is a lift as given by the diagonal morphism in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mover
                            %mo ⟶
                            %mn 0
                        %mtd
                          %mi V
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\ast &amp;\stackrel{0}{\longrightarrow}&amp; V &amp;\longrightarrow &amp; V/G
                  \\\
                  \&amp; \searrow&amp; &amp; \nearrow&amp; \downarrow
                  \\\
                  \&amp;&amp; \ast &amp;\longrightarrow&amp; \mathbf{B}G
                  }
          %p
            which in turn means that the action factors through an action of the
            %a.existingWikiWord{:href => "/nlab/show/stabilizer+group"} stabilizer group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Stab
                    %mi G
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Stab_G(0)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi Stab
                            %mi G
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mi G
                        %mtd
                          %mo ⟶
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\ast &amp;\longrightarrow&amp;  \mathbf{B}Stab_G(0)
                  \\\
                  \\downarrow &amp;\nearrow&amp; \downarrow &amp; \searrow
                  \\\
                  \\mathbf{B}G &amp;\longrightarrow&amp; V/G &amp;\longrightarrow&amp; \mathbf{B}G
                  }
          %p
            (using that the left morphism is a
            %a.existingWikiWord{:href => "/nlab/show/1-epimorphism"} 1-epimorphism
            and the right morphism a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/1-monomorphism"} 1-monomorphism
          %p
            It follows by the
            %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
            the top squares in the following diagram is a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo *
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mn 0
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi V
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\ast &amp;\longrightarrow&amp; \ast/G
                  \\\
                  {}^{\mathllap{0}}\downarrow &amp;&amp; \downarrow
                  \\\
                  V &amp;\longrightarrow&amp; V/G
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\ast &amp;\longrightarrow&amp; \mathbf{B}G
                  }
          %p
            exhibiting that the
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            restricts to the trivial action on the point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi inf
                %annotation{:encoding => "application/x-tex"} \int_{inf}
            denote the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+shape+modality"} infinitesimal shape modality
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+factorization+system"} orthogonal factorization system
            (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi inf
                %annotation{:encoding => "application/x-tex"} \int_{inf}
            \-equivalences,
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/formally+etale+morphisms"} formally etale morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo *
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msubsup
                            %mi 𝔻
                            %mn 0
                            %mi V
                        %mtd
                          %mo ⟶
                        %mtd
                          %msubsup
                            %mi 𝔻
                            %mn 0
                            %mi V
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi V
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi V
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\ast &amp;\longrightarrow&amp; \ast/G
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\mathbb{D}^V_0 &amp;\longrightarrow&amp; \mathbb{D}^V_0/G
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  V &amp;\longrightarrow&amp; V/G
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\ast &amp;\longrightarrow&amp; \mathbf{B}G
                  }
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝔻
                    %mn 0
                    %mi V
                %annotation{:encoding => "application/x-tex"} \mathbb{D}^V_0
            is the
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+disk"} infinitesimal disk
            around
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p Here the cartesian subdiagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi 𝔻
                            %mn 0
                            %mi V
                        %mtd
                          %mo ⟶
                        %mtd
                          %msubsup
                            %mi 𝔻
                            %mn 0
                            %mi V
                          %mo{:stretchy => "false"} /
                          %mi G
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo *
                        %mtd
                          %mo ⟶
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbb{D}^V_0 &amp;\longrightarrow&amp; \mathbb{D}^V_0/G
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  \\ast &amp;\longrightarrow&amp; \mathbf{B}G
                  }
          %p
            hence exhibits a
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔻
                      %mn 0
                      %mi V
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}^V_0
          %p
            Any
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
