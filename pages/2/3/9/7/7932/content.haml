                    %mi Aut
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi 𝔻
                    %mn 0
                    %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \to GL(V) \coloneqq \mathbf{Aut}(\mathbb{D}^V_0)
            to the
            %a.existingWikiWord{:href => "/nlab/show/automorphism+infinity-group"} automorphism infinity-group
            of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+disk"} infinitesimal disk
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            of the
            %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            at 0.
          %h2#examples Examples
          %h3#ExamplesPermutationRepresentations Discrete group actions on sets
          %p
            As the simplest special case, we discuss how the traditional concept of
            %a.existingWikiWord{:href => "/nlab/show/discrete+groups"} discrete groups
            acting on a
            %a.existingWikiWord{:href => "/nlab/show/sets"} sets
            (“
            %a.existingWikiWord{:href => "/nlab/show/permutation+representations"}> permutation representations
            ”) is recoverd from the above general abstract concepts.
          %p
            Write
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            for the
            %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            %a.existingWikiWord{:href => "/nlab/show/full+sub-%28infinity%2C1%29-category"} full sub-(infinity,1)-category
            of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            on the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/1-truncated+objects"} 1-truncated objects
          %p We write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
