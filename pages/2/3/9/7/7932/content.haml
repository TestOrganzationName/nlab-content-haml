                    \\downarrow
                    \\\
                    V \sslash \mathbf{Aut}(V) &amp;\to&amp; \mathbf{B} \mathbf{Aut}(V)
                    }
          %h4#ConjugationActions Conjugation actions
          %p
            We discuss the simple case of the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
            of
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/permutation+representations"} permutation representations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            an ordinary
            %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
            as a simple illustration of the internal hom of
            = succeed "-actions," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "." do
              %a.maruku-ref{:href => "#InternalHomAction"}
          %p This example spells out everything completely in components:
          .num_example
            %h6#example_2 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathbf{H} =
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in Grp(\infty Grpd)
              be an ordinary
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ,
                    %mi Σ
                    %mo ,
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V, \Sigma, X
              be
              %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              equipped with
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              (
              %a.existingWikiWord{:href => "/nlab/show/permutation+representations"}> permutation representations
              ).
            %p
              In this case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              is simply the set of
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f : \Sigma \to X
              of sets. Its
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "-actions" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \sigma \in \Sigma
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    g(f)(\sigma) = g(f(g^{-1}(\sigma)))
                    \\,,
            %p
              (where we write generically
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g(-)
              for the given action on the set specified implicitly by the type of the argument).
            %p
              Hence a morphism of
              = succeed "-actions" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi V
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\phi : V \to [\Sigma,X]
            %p
              is a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              of the underlying sets such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ∈
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V \in V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \in G
              and all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \sigma \in \Sigma
              we have
            #eq:Equation1.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\phi(g(v))(\sigma) = g(\phi(v)(g^{-1}(\sigma))
                    \\,.
            %p On the other hand, a morphism of actions
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %mi V
                    %mo ×
                    %mi Σ
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\psi : V \times \Sigma \to X
            %p is a function of the underlying sets, such that for all these terms we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\psi(g(v), g(\sigma)) = g(\psi(v,\sigma))
            %p which is equivalent to
            #eq:Equation2.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi(g(v), \sigma) = g(\psi(v,g^{-1}(\sigma)))
                    \\,.
            %p
              Comparison of
              %a.maruku-eqref{:href => "#eq:Equation1"} (1)
              and
              %a.maruku-eqref{:href => "#eq:Equation2"} (2)
              shows that the identification
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\psi(v,\sigma) \coloneqq \phi(v)(\sigma)
            %p
              establishes a
              %a.existingWikiWord{:href => "/nlab/show/natural+equivalence"} natural equivalence
              (a
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              of sets in this case)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Act
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi Act
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo ×
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Act_{\mathbf{H}}(G)(V, [\Sigma,X])
                    \\simeq
                    Act_{\mathbf{H}}(G)(V \times \Sigma, X)
                    \\,,
            %p
              showing how
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
              is indeed the
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              of
              = succeed "-actions." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          .num_remark
            %h6#remark_10 Remark
            %p
              Generally, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/discrete+%E2%88%9E-group"} discrete ∞-group
              we have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %msub
                      %mi Grpd
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                    %mo ≃
                    %mn ∞
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\infty Grpd_{/\mathbf{B}G}
                    \\simeq
                    \\infty Func(\mathbf{B}G, \infty Grpd)
            %p
              (by the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Act
                      %mrow
                        %mn ∞
                        %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo ,
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Act_{\infty Grpd}(G)
                    \\simeq
                    \\infty Func(\mathbf{B}G, \infty Grpd)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-permutation+representations"} ∞-permutation representations
          %h4#GeneralCovariance General covariance
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
            be a
            %a.existingWikiWord{:href => "/nlab/show/moduli+infinity-stack"} moduli infinity-stack
            for field in a
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \Sigma \in \mathbf{H}
            be the corresponding
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/worldvolume"} worldvolume
          %p
            We have the automorphism action, def.
            %a.maruku-ref{:href => "#AutomorphAction"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Σ
                        %mtd
                          %mo →
                        %mtd
                          %mi Σ
                          %mo ⫽
                          %mstyle{:mathvariant => "bold"}
                            %mi Aut
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mstyle{:mathvariant => "bold"}
                            %mi Aut
                          %mo{:stretchy => "false"} (
                          %mi Σ
                          %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\Sigma &amp;\to&amp; \Sigma \sslash \mathbf{Aut}(\Sigma)
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{B} \mathbf{Aut}(\Sigma)
                  }
                  \\,.
          %p
            The slice
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mstyle{:mathvariant => "bold"}
                        %mi Aut
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Act
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\mathbf{Aut}(\Sigma)} = Act_{\mathbf{H}}(\mathbf{Aut}(\Sigma))
            is the context of types which are
            %em
              %a.existingWikiWord{:href => "/nlab/show/general+covariance"} generally covariant
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            On
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            consider the trivial
            = succeed "-action," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Aut
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{Aut}(\Sigma)
            = succeed "." do
              %a.maruku-ref{:href => "#TrivialAction"}
            %a.maruku-ref{:href => "#InternalHomAction"}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo ⫽
                  %mstyle{:mathvariant => "bold"}
                    %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mo{:stretchy => "false"} [
                  %mi Σ
                  %mo ⫽
                  %mstyle{:mathvariant => "bold"}
                    %mi Aut
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi X
                  %mo ×
