                    %annotation{:encoding => "application/x-tex"} \mathbf{H} \,=\, Grpd_\infty
              = succeed "\u201D," do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+%28infinity%2C1%29-topos+theory"}
                  fundamental theorem of
                  = succeed "-topos" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
