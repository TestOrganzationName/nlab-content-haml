                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ♯
                      %mi n
                    %mi G
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mo ×
                          %mo •
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ♯
                      %mi n
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ((\sharp_n V)/(\sharp_n G))_\bullet = (\sharp_n G)^{\times_{\bullet}} \times (\sharp_n V)
              which exhibits the desired action.
          .proof
            %h6#proof_8 Proof
            %p
              Generally, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi B
                    %mo →
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} A:B\to Type
              be any
              %a.existingWikiWord{:href => "/nlab/show/dependent+type"} dependent type
              family (speaking
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %msub
                          %mo ♯
                          %mi n
                    %mo :
                    %msub
                      %mo ♯
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mi B
                    %mo →
                    %mi Type
                  %annotation{:encoding => "application/x-tex"} A^{\sharp_n} : \sharp_{n+1} B \to Type
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mrow
                        %msub
                          %mo ♯
                          %mi n
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi η
