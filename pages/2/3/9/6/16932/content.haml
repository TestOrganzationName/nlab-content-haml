          %h2#references References
          %p Original articles:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hans+Reissner"}> Hans Reissner
              ,
              = succeed "," do
                %em Über die Eigengravitation des elektrischen Feldes nach der Einstein’schen Theorie
              = succeed "," do
