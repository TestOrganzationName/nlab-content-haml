                            %mn 2
                        %msup
                          %mi R
                          %mo □
                      %annotation{:encoding => "application/x-tex"} \;\;\;G_4 = \tfrac{1}{2} R^{\Box}
              %li
                %p
                  our 7-flux density absorbs a combinatoiral factor of
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
