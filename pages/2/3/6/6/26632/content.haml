          %title 11d-SuGra from Super C-Field Flux Quantization
          %h2#11DSugraFromSuperCFieldFluxQuantization 11d-SuGra from Super C-Field Flux Quantization
          %p
            We discuss (Thm.
            %a.maruku-ref{:href => "#11dSuGraEOMFromSuperFluxIdentity"}
            below, following
            = succeed ")" do
              %a{:href => "D=11+supergravity#GiotopoulosSatiSchreiber24"} GSS24, §3
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            of
            %a.existingWikiWord{:href => "/nlab/show/D%3D11+supergravity"} D=11 supergravity
            — on an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 11
                    %mo{:stretchy => "false"} |
                    %mstyle{:mathvariant => "bold"}
                      %mn 32
                  %annotation{:encoding => "application/x-tex"} 11\vert\mathbf{32}
            = succeed "-free" do
              %a.existingWikiWord{:href => "/nlab/show/super-torsion"} super-torsion
            %a.existingWikiWord{:href => "/nlab/show/super+spacetime"} super spacetime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with
            %a.existingWikiWord{:href => "/nlab/show/super+vielbein"} super vielbein
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi e
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (e,\psi)
            (the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/graviton"} graviton
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/gravitino"} gravitino
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
            %a.existingWikiWord{:href => "/nlab/show/duality-symmetric+higher+gauge+theory"} duality-symmetric
            %a.existingWikiWord{:href => "/nlab/show/differential+form+on+a+supermanifold"} super-
            %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} C-field
            %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi G
                      %mn 4
                      %mi s
                    %mo ,
                    %msubsup
                      %mi G
                      %mn 7
                      %mi s
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %msubsup
                      %mi Ω
                      %mi dR
                      %mn 7
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (G_4^s, G_7^s) \,\in\, \Omega^4_{dR}(X) \times \Omega^7_{dR}(X)
          %ol
            %li
              %p
                satisfy their
                %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
              #eq:SuperFluxBianchiIdentity.maruku-equation
                %span.maruku-eq-number (1)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} d
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi G
                              %mn 4
                              %mi s
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mn 0
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} d
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi G
                              %mn 7
                              %mi s
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %msubsup
                              %mi G
                              %mn 4
                              %mi s
                            %mspace{:width => "thinmathspace"}
                            %msubsup
                              %mi G
                              %mn 4
                              %mi s
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{array}{l}
                      \\mathrm{d} \, G_4^s \;=\; 0
                      \\\
                      \\mathrm{d} \, G_7^s \;=\; \tfrac{1}{2} G_4^s \, G_4^s
                      \\end{array}
            %li
              %p
                are on any super-
                %a.existingWikiWord{:href => "/nlab/show/chart"} chart
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \hookrightarrow X
                of the locally supersymmetric form
              #eq:LocalFormOfSuperFluxDensities.maruku-equation
                %span.maruku-eq-number (2)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "left", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %msubsup
                              %mi G
                              %mn 4
                              %mi s
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 4
                                  %mo !
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi G
                              %mn 4
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                                %mi ⋯
                                %msub
                                  %mi a
                                  %mn 4
                            %msup
                              %mi e
                              %mrow
                                %msub
                                  %mi a
                                  %mn 1
                            %mi ⋯
                            %msup
                              %mi e
                              %mrow
                                %msub
                                  %mi a
                                  %mn 4
                            %mspace{:width => "thinmathspace"}
                            %mo −
                            %mspace{:width => "thinmathspace"}
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mover
                              %mi ψ
                              %mo ¯
                            %msub
                              %mi Γ
                              %mrow
                                %msub
                                  %mi a
