                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(e(x))
              %a.existingWikiWord{:href => "/nlab/show/adjoint+modalities"} adjoint modalities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
