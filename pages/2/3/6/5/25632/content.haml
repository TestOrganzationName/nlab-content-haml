                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "265.812209", "xlink:href" => "#STxcda95aZLVdbgwsuMypJFE_3k=-glyph7-1", :y => "50.790659"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "273.000014", "xlink:href" => "#STxcda95aZLVdbgwsuMypJFE_3k=-glyph6-2", :y => "50.790659"}
