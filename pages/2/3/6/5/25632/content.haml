                    %use{:x => "249.753284", "xlink:href" => "#STxcda95aZLVdbgwsuMypJFE_3k=-glyph3-4", :y => "48.620331"}
                  %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                    %use{:x => "253.865418", "xlink:href" => "#STxcda95aZLVdbgwsuMypJFE_3k=-glyph5-2", :y => "48.620331"}
