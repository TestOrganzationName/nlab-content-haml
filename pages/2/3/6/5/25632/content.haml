                = succeed "," do
                  %em The Grothendieck construction for model categories
                %strong 281
                (2015) 1306-1363 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1404.1852"}> arXiv:1404.1852
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.aim.2015.03.031"} 10.1016/j.aim.2015.03.031
              %blockquote
                %p
                  (in the context of
