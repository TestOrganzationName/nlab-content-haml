                    %use{:x => "140.22717", "xlink:href" => "#STxcda95aZLVdbgwsuMypJFE_3k=-glyph4-1", :y => "77.371551"}
              where the horizontal maps are the given hom-isomorphisms (see
              = succeed ")." do
                %a{:href => "adjoint+functor#eq:HomIsomorphismForAdjointFunctors"} there
            %p
              Such pairs of conjugate transformation
              %a.existingWikiWord{:href => "/nlab/show/composition"} compose
              via composition of their component
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              (cf.
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            #eq:CatAdjCD.maruku-equation
              %span.maruku-eq-number (3)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mi adj
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cat_{adj}(\mathcal{C},\mathcal{D})
            %p whose
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint+functors"} left adjoint functors
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mo →
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{C} \to \mathcal{D}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  are the conjugate transformations between these
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  is the composition of component
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
            %p
          %p
          #UniqueConjugateMate.num_prop
            %h6 Proposition
            %p
              Given a pair of pairs of adjunctions as in
              %a.maruku-eqref{:href => "#eq:PairOfPairsOfAdjointFunctors"} (1)
              and given (just)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              as in
              %a.maruku-eqref{:href => "#eq:PairOfTransformations"} (2)
              then there exists a unique
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              as in
              %a.maruku-eqref{:href => "#eq:PairOfTransformations"} (2)
              such that the conjugacy condition
              %a.maruku-eqref{:href => "#eq:ConjugacyConditionOnAdjoints"} (?)
              holds.
            %p
              In other words, the evident
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cat
                      %mi adj
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cat_{adj}(\mathcal{C},\,\mathcal{D})
              %a.maruku-eqref{:href => "#eq:CatAdjCD"} (3)
              to the
              %a.existingWikiWord{:href => "/nlab/show/hom-category"} hom-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Cat(\mathcal{C},\,\mathcal{D})
              (i.e. the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              exhibiting a
              = succeed "-inclusion:" do
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            #eq:FullInclusionOfConjugateTransformations.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒟
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi Cat
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Cat
                      %mi adj
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Cat
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C},\,\mathcal{D} \,\in\, Obj(Cat)
                    \\;\;\;\;\;\;
                    \\vdash
                    \\;\;\;\;\;\;
                    Cat_{adj}(\mathcal{C},\,\mathcal{D})
                    \\hookrightarrow
                    Cat(\mathcal{C},\,\mathcal{D})
                    \\,.
            %p
          \&amp;lbrack;
          %a{:href => "#MacLane71"}> Mac Lane (1971), p. 98
          \&amp;rbrack;
          %p
            In fact:
          #ConjugacyMeansMated.num_prop
            %h6 Proposition
            %p
              %strong (conjugate pairs are mates)
              %br/
              The conjugacy condition
              %a.maruku-eqref{:href => "#eq:ConjugacyConditionOnAdjoints"} (?)
              means equivalently that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              are
              %em
                %a.existingWikiWord{:href => "/nlab/show/mates"} mates
              in the sense of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/2-category+theory"} 2-category theory
          This is
          %a{:href => "#MacLane71"} MacLane (1971) IV.7 Thm. 2 (6), p. 98
          (not using the “
          %a.existingWikiWord{:href => "/nlab/show/mate"}> mate
          ”-terminology, though, which is due to
          = succeed ")." do
            %a{:href => "mate#KellyStreet06"} Kelly &amp; Street 2006
          %p
            Moreover:
          #HorizontalCompositionOfConjugateTransformations.num_prop
            %h6 Proposition
            %p
              Conjugacy of transformations is compatible with
              %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)\cdot(-)
              of
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              as
              %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
              in
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              (“
              %a.existingWikiWord{:href => "/nlab/show/whiskering"}> whiskering
              ”), so that
              %a.maruku-eqref{:href => "#eq:FullInclusionOfConjugateTransformations"} (4)
              extends to a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/horizontal+composition"} horizontal composition
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi 𝒟
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi ℰ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi Cat
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ⊢
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Cat
                              %mi adj
                            %mo{:stretchy => "false"} (
                            %mi 𝒟
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi ℰ
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %msub
                              %mi Cat
                              %mi adj
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi 𝒟
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mi Cat
                              %mi adj
                            %mo{:stretchy => "false"} (
                            %mi 𝒞
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi ℰ
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo ,
                            %mi ρ
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mo{:stretchy => "false"} (
                            %mi λ
                            %mo ′
                            %mo ,
                            %mi ρ
                            %mo ′
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi λ
                            %mo ′
                            %mo ⋅
                            %mi λ
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi ρ
                            %mo ⋅
                            %mi ρ
                            %mo ′
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}
                    ,\,
                    \\mathcal{D}
                    ,\,
                    \\mathcal{E}
                    \\;\in\;
                    Cat
                    \\;\;\;\;\;\;\;\;\;\;
                    \\vdash
                    \\;\;\;\;\;\;\;\;\;\;
                    \\array{
                    Cat_{adj}(\mathcal{D},\,\mathcal{E})
                    \\times
                    Cat_{adj}(\mathcal{C},\,\mathcal{D})
                    \&amp;\overset{}{\longrightarrow}&amp;
                    Cat_{adj}(\mathcal{C},\,\mathcal{E})
                    \\\
                    \\big(
                    (\lambda, \rho)
