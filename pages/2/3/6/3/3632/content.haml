                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h2#definition Definition
          .num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presentable (∞,1)-category
              the subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo ≤
                        %mi n
                  %annotation{:encoding => "application/x-tex"} C_{\leq n}
              of
              %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+in+an+%28%E2%88%9E%2C1%29-category"} n-truncated objects
              is a
              %a.existingWikiWord{:href => "/nlab/show/reflective+%28%E2%88%9E%2C1%29-subcategory"} reflective (∞,1)-subcategory
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mrow
                        %mo ≤
                        %mi n
                    %mover
                      %mo ↪
                      %mover
                        %mo ←
                        %mrow
