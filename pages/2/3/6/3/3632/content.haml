                    %mo →
                    %mi ⋯
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    X \to \cdots \to X_2 \to X_1 \to X_0
            %p
              such that each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X \to X_n
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              as
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              = succeed "-truncation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, def. 5.5.6.23
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong Postnikov pretower
              is a pre-tower
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi X
                      %mn 2
                    %mo →
                    %msub
                      %mi X
                      %mn 1
                    %mo →
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \to X_2 \to X_1 \to X_0
            %p
              (no initial
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              on the left!) which exhibits each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              as the
              = succeed "-truncation" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} X_{n+1}
            %p
              We say
              %strong Postnikov towers converge
              in the ambient
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              if the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              from Postnikov towers to Postnikov pretowers is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, def. 5.5.6.23
            ).
          %h2#examples Examples
          %h3#in_
            In
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \infty Grpd
          %p
            When the archetypical
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            is
            %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} presented
            by the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleton
            endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbf{cosk}_{n+1}
            on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
          %p
            The unit of the adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi tr
                    %mi n
                  %mo ⊣
                  %msub
                    %mi cosk
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (tr_n \dashv cosk_n)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi τ
                    %mi n
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mrow
                  %mi X
                  %mo →
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi cosk
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{\tau}_n : \mathbf{}X \to \mathbf{cosk}_n(X)
          %p
            sends an
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            to its
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/truncated"} truncation
          %p Discussion of this can be found for instance in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dan+Kan"} Dan Kan
                %em An obstruction theory for diagrams of simplicial sets
                (
                %a{:href => "http://www.nd.edu/~wgd/Dvi/ObstructionTheoryForDiagrams.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Duskin"} John Duskin
                %em
                  Simplicial matrices and the nerves of weak
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                , TAC
                %strong 9
                no. 2, (2002). (
                %a{:href => "http://www.emis.de/journals/TAC/volumes/9/n10/9-10abs.html"}> web
                )
          %h3#in_lie_groupoids
            In
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p …
          %h3#in_rings
            In
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            The Postnikov tower of a connective
            %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
            is a sequence of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/square-zero+extensions"} square-zero extensions
            %a{:href => "#Basterra99"} Basterra 99
            and
            %a{:href => "#LurieAlgebra"} Lurie “Higher Algebra”, section 8.4
            (the result is due to
            = succeed ")." do
              %a{:href => "#Kriz93"} Kriz
          %h3#in_simplicial_commutative_rings In simplicial commutative rings
          %p
            (A special case of the above:) The Postnikov tower of a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+commutative+ring"} simplicial commutative ring
            is a sequence of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/square-zero+extensions"} square-zero extensions
            = succeed "." do
              %a{:href => "#TVHAGII"} Toen-Vezzosi
          %h2#properties Properties
          %h3#criteria_for_convergence Criteria for convergence
          %p We discuss conditions that ensure that Postnikov towers converge.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              In an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              which is
              %em locally
              of finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+dimension"} homotopy dimension
          %p
            This is (
            %a{:href => "#Lurie"}> Lurie, prop. 7.2.1.10
            ).
          %h2#relation_to_other_concepts Relation to other concepts
          %ul
            %li
              %p
                At least if the ambient
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
                %a.existingWikiWord{:href => "/nlab/show/locally+contractible+%28%E2%88%9E%2C1%29-topos"} locally contractible (∞,1)-topos
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}
                = succeed "-functor" do
                  %a.existingWikiWord{:href => "/schreiber/show/path+%E2%88%9E-groupoid"} path ∞-groupoid
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mo :
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mo →
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{\Pi} : \mathbf{H} \to \mathbf{H}
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi Π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \to \mathbf{\Pi}_n(X)
                into the Postnikov tower of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbf{\Pi}(X)
                form the
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower+in+an+%28%E2%88%9E%2C1%29-topos"} Whitehead tower in the (∞,1)-topos
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                      %annotation{:encoding => "application/x-tex"} \mathbf{H}
                  of the object
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                In the context of
                %a.existingWikiWord{:href => "/nlab/show/nonabelian+cohomology"} nonabelian cohomology
                in
                = succeed "es" do
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Whitehead+principle+of+nonabelian+cohomology"} Whitehead principle of nonabelian cohomology
          %h2#references References
          %p Section 6.5…
          %ul
            %li#Lurie
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p
            For
            = succeed "-rings:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %ul
            %li#LurieAlgebra
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
          %p and in more classical language, section 8 of
          %ul
            %li#Basterra99
              %p
                %span.newWikiWord>
                  M. Basterra
                  %a{:href => "/nlab/new/M.+Basterra"} ?
                ,
                = succeed "," do
                  %em Andre-Quillen cohomology of commutative S-algebras
            %li#Kriz93
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Kriz"}> Igor Kriz
                ,
                = succeed "," do
                  %em
                    Towers of
                    = succeed "-ring" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi E
                              %mn ∞
                          %annotation{:encoding => "application/x-tex"} E_\infty
          %p
            For
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+commutative+rings"} simplicial commutative rings
          %ul
            %li#TVHAGII
              %a.existingWikiWord{:href => "/nlab/show/Bertrand+Toen"}> Bertrand Toen
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Gabriele+Vezzosi"} Gabriele Vezzosi
              = succeed "," do
                %em Homotopical Algebraic Geometry II: geometric stacks and applications
