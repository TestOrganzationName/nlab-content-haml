                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{R}Hom_C(f,c) : SSet \to SSet
            %p is a weak equivalence.
            %p
              An
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                \-localization of an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              is an
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat c
              and an
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo →
                      %mover
                        %mi c
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} c \to \hat c
            %p
              An
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                \-localization of a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi c
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} f : c \to d
              is a pair of
              = succeed "-localizations" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo →
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} c \to \hat c
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo →
                    %mover
                      %mi d
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} d \to \hat d
              of objects, and a commuting square
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi c
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi d
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mover
                              %mi c
                              %mo{:stretchy => "false"} ^
                          %mtd
                            %mo →
                          %mtd
                            %mover
                              %mi d
                              %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    c &amp;\stackrel{f}{\to}&amp; d
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\hat c &amp;\to &amp; \hat d
                    }
                    \\,.
          %h3#PropInModCat Properties
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} left proper model categories
            there is an equivalent stronger characterization of
            = succeed "-locality" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo ↪
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i : A \hookrightarrow B
          .num_prop
            %h6#proposition Proposition
            %p
              %strong
                (characterization of
                = succeed "-local" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} left proper
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ⊂
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S \subset Mor(C)
            %p
              Then a cofibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi A
                    %mo ↪
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i : A \hookrightarrow B
              is an
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              the morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C(B,X) \to C(A,X)
            %p
              is an acyclic fibration in the standard
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
          .num_remark
            %h6#remark Remark
            %p
              Notice that this is stronger than the statement that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{R}Hom(B,X) \to \mathbf{R}Hom(A,X)
              is a weak equivalence not only in that it asserts in addition a fibration, but also in that it deduces this without first passing to a cofibrant replacement of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          .proof
            %h6#proof Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, lemma A.3.7.1
            %p
              The proof makes use of the following general construction: for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f : A \to B
              any morphism let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ∅
                    %mo ↪
                    %mi A
                    %mo ′
                    %mover
                      %mo →
                      %mo ≃
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \emptyset \hookrightarrow A' \stackrel{\simeq}{\to} A
              be a cofibrant replacement, factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ′
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A' \to B
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ′
                    %mover
                      %mo ↪
                      %mrow
                        %mi i
                        %mo ′
                    %mi B
                    %mo ′
                    %mover
                      %mo →
                      %mo ≃
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A' \stackrel{i'}{\hookrightarrow} B' \stackrel{\simeq}{\to} B
              and consider the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                            %mo ′
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %mi i
                                %mo ′
                          %mtd
                            %mi B
                            %mo ′
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %mo ∈
                                  %mi W
                          %mtd
                          %mtd
                            %msub
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi g
                                  %mo ∈
                                  %mi W
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi f
                                  %mo ′
                                  %mo ∈
                                  %mi W
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                          %mtd
                            %mi A
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi A
                                %mo ′
                            %mi B
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mi j
                                %mo ∈
                                %mi W
                          %mtd
                            %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A' &amp;\stackrel{i'}{\hookrightarrow}&amp; B'
                    \\\
                    \\downarrow^{\mathrlap{f \in W}}
                    \&amp;&amp; \downarrow_{\mathrlap{g\in W}}
                    \&amp;
                    \\searrow^{\mathrlap{f' \in W}}
                    \\\
                    A &amp;\stackrel{}{\hookrightarrow}&amp; A \coprod_{A'} B
                    \&amp;\stackrel{j \in W}{\to}&amp;
                    B
                    }
                    \\,.
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} left properness
              the pushout
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              of the weak equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              along the cofibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} i'
              is again a weak equivalence and by
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} 2-out-of-3
              the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is a weak equivalence.
            %p
              Now assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is an
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i^* : C(B,X) \to C(A,X)
              is an acyclic Kan fibration for all fibrant
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              it follows from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              being a cofibration and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              being fibrant that this is a Kan fibration. So it remains to show that it is a
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mrow
                        %mi i
                        %mo ′
                      %mo *
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ′
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ′
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    ({i'}^* : C(B',X) \to C(A',X))
                    \\simeq
                    (\mathbf{R}Hom(B,X) \to \mathbf{R}Hom(A,X))
            %p
              on the cofibrant replacement is a weak equivalence, by the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed "-local," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} i'
              is still a cofibration.
            %p
              By homming the entire diagram above into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(-,X)
              sends
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi A
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi A
                                %mo ′
                            %mi B
                            %mo ′
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo ′
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mi q
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mo{:stretchy => "false"} (
                                  %mi W
                                  %mo ∩
                                  %mi fib
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mi SSet
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mrow
                                %msup
                                  %mrow
                                    %mi i
                                    %mo ′
                                  %mo *
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mo{:stretchy => "false"} (
                                  %mi W
                                  %mo ∩
                                  %mi fib
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mi SSet
                        %mtr
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi A
                            %mo ′
                            %mo ,
                            %mi X
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C(A \coprod_{A'} B', X)
                    \&amp;\to&amp;
                    C(B',X)
                    \\\
                    {}^{q}\downarrow^{\mathrlap{\in (W\cap fib)_{SSet}}}
                    \&amp;&amp;
                    {}^{{i'}^*}\downarrow^{\mathrlap{\in (W\cap fib)_{SSet}}}
                    \\\
                    C(A,X)
                    \&amp;\to&amp;
                    C(A',X)
                    }
            %p
              in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
              is an acyclic fibration, being the pullback of an acyclic fibration.
            %p
              To show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mo *
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i^*: C(B,X) \to C(A,X)
              is a weak equivalence it suffices to show that all its fibers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi i
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i^*)^{-1})(t)
              over elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                    %mo :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} t : A \to X
              are
              %a.existingWikiWord{:href => "/nlab/show/contractible"} contractible
              = succeed "es." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi q
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} q^{-1}(t)
              by precomposition with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mrow
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi A
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi A
                                %mo ′
                            %mi B
                            %mo ′
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi j
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; A
                    \\\
                    \&amp; {}\swarrow
                    \&amp;&amp; \searrow
                    \\\
                    A \coprod_{A'} B' &amp;&amp;\stackrel{j}{\to}&amp;&amp; B
                    }
            %p
              in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+an+over+category"} model structure on the undercategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:stretchy => "false"} /
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A/C
              is a weak equivalence between cofibrant objects (because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ↪
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A \hookrightarrow B
              is a cofibration by assumption and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi A
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %mi A
                        %mo ′
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} A \to A \coprod_{A'} B'
              as being the pushout of the cofibration
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} i'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(j,X)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                  %annotation{:encoding => "application/x-tex"} j
              is the image under the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/SSet"} SSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              of a weak equivalence between cofibrant objects mapping into a fibrant object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi A
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mi t
                        %mtr
                          %mtd
                            %mi A
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mrow
                                %mi A
                                %mo ′
                            %mi B
                            %mo ′
                          %mtd
                            %mover
                              %mo →
                              %mi j
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; A
                    \\\
                    \&amp; \swarrow &amp; \downarrow &amp; \searrow^{t}
                    \\\
                    A \coprod_{A'} B'
                    \&amp;\stackrel{j}{\to}&amp;
                    B
                    \&amp;\to&amp;
                    X
                    }
            %p
              and hence, by the general properties of
              %a{:href => "http://ncatlab.org/nlab/show/%28infinity,1%29-categorical+hom-space#enriched_homs_between_cofibrantfibrant_objects_6"} enriched homs between cofibrant/fibrant objects
              a weak equivalence.
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi j
                        %mo *
                      %mo :
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi i
                        %mo *
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ≃
                      %msup
                        %mi q
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi t
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j^* : (i^*)^{-1}(t) \stackrel{\simeq}{\to} q^{-1}(t)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi i
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (i^*)^{-1}(t)
              is contractible.
            %p This proves the first part of the statement. For the converse statement, assume now that…
          %h2#saturated_class_of_morphisms Saturated class of morphisms
          %p
            Every morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is
            = succeed "-local." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            There are two notions of saturation in the literature. Following
            %a{:href => "#CasacubertaFrei2000"} Casacuberta, Frei 2000
            we distinguish them as internal and external. Internal saturation of a class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of morphisms is simply the class of all
            = succeed "-local" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of morphisms is the class of all morphisms which are inverted in the category of fractions (localization) at class
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            In both variants, the collection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            of morphisms is called
            %strong saturated
            if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            coincides with its saturation.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is contained in its external saturation which is in turn contained in its internal saturation; the external and internal saturation coincide if the localization in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            has either left or right adjoint (coreflective or reflective case).
          %h2#remarks Remarks
          %ul
            %li
              a
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
              as well as a
              %a.existingWikiWord{:href => "/nlab/show/reflective+%28%E2%88%9E%2C1%29-subcategory"} reflective (∞,1)-subcategory
              can be realized as the full (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-)subcategory on
              = succeed "-local" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the collection of morphisms sent by the corresponding
              %a.existingWikiWord{:href => "/nlab/show/localization+of+an+%28%E2%88%9E%2C1%29-category"} localization of an (∞,1)-category
              to equivalences. For details on this see the discussion at
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} geometric embedding
          %h2#references References
          %p Local objects are treated, under the name of left-closed objects, in I.4.1 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Gabriel"}> Pierre Gabriel
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michel+Zisman"} Michel Zisman
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Calculus+of+fractions+and+homotopy+theory"} Calculus of fractions and homotopy theory
              = succeed "," do
                %em Ergebnisse der Mathematik und ihrer Grenzgebiete
              = succeed "," do
                %a{:href => "https://link.springer.com/book/10.1007/978-3-642-85844-4"} doi:10.1007/978-3-642-85844-4
              = succeed "&rbrack;" do
                %a{:href => "https://web.math.rochester.edu/people/faculty/doug/otherpapers/GZ.pdf"} pdf
          %p A classical textbook reference is section 3.2 of
          %ul
            %li
              Hirschhorn,
              %em Model categories and their localization
          %p
            A useful reference with direct ties to the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            story in the background is section A.3.7 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
          %p 1-categorical picture
          %ul
            %li#CasacubertaFrei2000
              %p
                %a.existingWikiWord{:href => "/nlab/show/Carles+Casacuberta"}> Carles Casacuberta
                , Armin Frei,
                = succeed "," do
                  %em On saturated classes of morphisms
                = succeed ":4" do
                  %strong 7
                %a{:href => "https://www2.math.ethz.ch/EMIS/journals/TAC/volumes/7/n4/n4.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Carles+Casacuberta"}> Carles Casacuberta
                , Georg Peschke, Markus Pfenniger,
                = succeed "," do
                  %em On orthogonal pairs in categories and localization
                = succeed ":1" do
                  %strong 142
          %p
            Relation to the categorical
            %a.existingWikiWord{:href => "/nlab/show/shape+theory"} shape theory
          %ul
            %li
              Luciano Stramaccia,
              = succeed "," do
                %em Orthogonality, saturation and shape
              %a{:href => "https://hrcak.srce.hr/file/27927"} pdf
