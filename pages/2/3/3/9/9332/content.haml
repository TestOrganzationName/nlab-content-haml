            %p
              For an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo →
                    %msup
                      %mi Δ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} S \to \Delta^{op}
              and a
              %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
              in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+quasicategories"} model structure for quasicategories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %mo →
                    %msubsup
                      %mi Tens
                      %mi S
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} q \colon \mathcal{C}^\otimes \to Tens_S^\otimes
              exhibiting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes
              as an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/family+of+%28%E2%88%9E%2C1%29-operads"} family of (∞,1)-operads
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Alg
                      %mrow
                        %mo{:stretchy => "false"} /
                        %msub
                          %mi Tens
                          %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi Alg
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Alg_{/Tens_S}(\mathcal{C})
                    \\to
                    Alg_S(\mathcal{C})
                    \\,.
          %p
            (
            %a{:href => "#Lurie"}> Lurie, prop. 4.3.4.17
            ).
          #NotationForTensGt.num_defn
            %h6#definition_notation_3 Definition (Notation)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mn 1
                    %mo →
                    %msup
                      %mi Δ
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \Delta^1 \to \Delta^{op}
              be the map that picks the morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                    %mo ↪
                    %msup
                      %mi Δ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \{0,2\} \hookrightarrow \Delta^2
              in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              %a.maruku-ref{:href => "#NotationForTensS"}
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tens
                      %mo &gt;
                      %mo ⊗
                    %mo ≔
                    %msubsup
                      %mi Tens
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                      %mo ⊗
                    %mo ≔
                    %msup
                      %mi Tens
                      %mo ⊗
                    %munder
                      %mo ×
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %msup
                      %mi Δ
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Tens^\otimes_{\gt}
                    \\coloneqq
                    Tens_{\Delta^1}^\otimes
                    \\coloneqq
                    Tens^\otimes \underset{\Delta^{op}}{\times} \Delta^1
                    \\,.
          %p
            (
            %a{:href => "#Lurie"}> Lurie, notation 4.3.5.1
            )
          #BilinearInfinityMap.num_remark
            %h6#remark_3 Remark
            %p
              The
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tens
                      %mo &gt;
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} Tens^\otimes_{\gt}
              of def.
              %a.maruku-ref{:href => "#NotationForTensGt"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
              of
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-operads"} (∞,1)-operads
              which exhibits bilinear maps as follows:
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-algebra+over+an+%28%E2%88%9E%2C1%29-operad"} ∞-algebra over an (∞,1)-operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Tens
                      %mo &gt;
                      %mo ⊗
                    %msub
                      %mo ×
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo →
                    %msup
                      %mi 𝒞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \gamma_1 \colon Tens^\otimes_{\gt} \times_{\Delta^1} \{1\} \to \mathcal{C}^\otimes
              is equivalently a bimodule
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %msub
                      %mrow
                      %mrow
                        %mi A
                        %mo ′
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi C
                        %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    X \in {}_{A'} Mod(\mathcal{C})_{C'}
                    \\,,
            %p
              while an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi γ
                      %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Tens
                      %mo &gt;
                      %mo ⊗
                    %msub
                      %mo ×
                      %mrow
                        %msup
                          %mi Δ
                          %mn 1
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo →
                    %msup
                      %mi 𝒞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \gamma_0 \colon Tens^\otimes_{\gt} \times_{\Delta^1} \{0\} \to \mathcal{C}^\otimes
              is equivalently a pair of bimodules
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo ∈
                    %msub
                      %mrow
                      %mi A
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi B
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi N
                      %mn 2
                    %mo ∈
                    %msub
                      %mrow
                      %mi B
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_1 \in {}_A Mod(\mathcal{C})_B
                    \\;\;, \;\;
                    N_2 \in {}_B Mod(\mathcal{C})_C
                    \\,.
            %p
              An extension of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi γ
                      %mn 0
                    %mo ,
                    %msub
                      %mi γ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\gamma_0, \gamma_1)
              through the correspondence hence to a map of
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28%E2%88%9E%2C1%29-operads"} generalized (∞,1)-operads
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Tens
                      %mo &gt;
                      %mo ⊗
                    %mo →
                    %msup
                      %mi 𝒞
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} Tens^\otimes_{\gt} \to \mathcal{C}^\otimes
              is equivalently a pair of
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebra"} A-∞ algebra
              maps
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi A
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} A \to A'
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi B
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} B \to B'
              together with a bilinear map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mn 1
                      %mo ⊗
                      %msub
                        %mi N
                        %mn 2
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} N_1 \otimes N_2 \to X
          %p ([Lurie, beginning of 4.3.4]).
          #RelativeTensorProduct.num_defn
            %h6#definition_3 Definition
            %p
              (
              %strong>
                relative tensor product of
                = succeed "-bimodules" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %mo →
                    %msup
                      %mi 𝒪
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} q \colon \mathcal{C}^\otimes \to \mathcal{O}^\otimes
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fibration+of+%28%E2%88%9E%2C1%29-operads"} fibration of (∞,1)-operads
              %a.existingWikiWord{:href => "/nlab/show/generalized+%28%E2%88%9E%2C1%29-operads"} generalized (∞,1)-operads
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Tens
                      %mo &gt;
                      %mo ⊗
                    %mo →
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F \colon Tens_{\gt}^\otimes \to \mathcal{C}^{\otimes}
                    \\,.
            %p
              This exhibits three
              %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+algebras"} A-∞ algebras
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi i
                      %mo ≔
                      %mi F
                      %msub
                        %mo{:stretchy => "false"} |
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mi i
                          %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} A_i \coloneqq F|_{\{i\}}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi N
                      %mn 1
                    %mo ,
                    %msub
                      %mi N
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi F
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 2
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (N_1, N_2) = F|_{[2]}
            %p
              over
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} A_0
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A_1
              and over
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} A_1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} A_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo =
                    %mi F
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} N = F|_{[1]}
              over
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} A_0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} A_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              exhibits the
              %strong
                relative
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+%E2%88%9E-modules"} tensor product of ∞-modules
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} N_1
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} N_2
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} A_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ≃
                    %msub
                      %mi N
                      %mn 1
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi A
                          %mn 1
                    %msub
                      %mi N
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    N \simeq N_1 \otimes_{A_1} N_2
            %p
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is an operadic
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          %p
            (
            %a{:href => "#Lurie"}> Lurie, def. 4.3.5.3
            ).
          #TensorProductFunctor.num_remark
            %h6#remark_4 Remark
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mo ⊗
                    %mo →
                    %msup
                      %mi Assoc
                      %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^\otimes \to Assoc^\otimes
              exhibit a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+%28%E2%88%9E%2C1%29-category"} monoidal (∞,1)-category
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              has
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects+in+an+%28%E2%88%9E%2C1%29-category"} simplicial objects
              and the tensor product preserves these separately in each argument.
            %p
              Then the tensor product of
              = succeed "-modules" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
              %a.maruku-ref{:href => "#RelativeTensorProduct"}
              extends to an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi BMod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo ×
                      %mrow
                        %mi Alg
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                    %mi BMod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi BMod
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    BMod(\mathcal{C})
                    \\underset{Alg(\mathcal{C})}{\times}
                    BMod(\mathcal{C})
                    \\to
                    BMod(\mathcal{C})
                    \\,.
          %p
            (
            %a{:href => "#Lurie"}> Lurie, example 4.3.5.11
            )
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-bimodules"}> (∞,1)-bimodules
              ,
              %span.newWikiWord
                (∞,2)-category of (∞,1)-bimodules
                %a{:href => "/nlab/new/%28%E2%88%9E%2C2%29-category+of+%28%E2%88%9E%2C1%29-bimodules"} ?
          %h2#references References
          %p Section 4.3.5 of
          %ul#Lurie
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
