            regarded as a
            %a.existingWikiWord{:href => "/nlab/show/Lie+2-group"} Lie 2-group
            and thus canonically as an
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            object in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            in the following. Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi String
                %annotation{:encoding => "application/x-tex"} \mathbf{B}String
            for its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                %annotation{:encoding => "application/x-tex"} Spin
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            = succeed ")." do
              %a{:href => "http://nlab.mathforge.org/nlab/show/smooth+infinity-groupoid#StrictLie2Groups"} here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mn 6
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi Smooth
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^6 U(1) \in Smooth \infty Grpd
            be the
            %a{:href => "http://nlab.mathforge.org/nlab/show/smooth+infinity-groupoid#CircleLienGroup"} circle Lie 7-group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
