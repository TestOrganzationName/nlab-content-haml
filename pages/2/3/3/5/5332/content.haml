                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}^7 U(1)
            its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
          %p
            At
            %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+theory+in+Smooth%E2%88%9EGrpd"} Chern-Weil theory in Smooth∞Grpd
            the following statement is proven (
            %a{:href => "#FSS"}> FSS
            ).
          .un_prop
            %h6#proposition Proposition
            %p
              The image under
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
              of the canonical
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra 7-cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
