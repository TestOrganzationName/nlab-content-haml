                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    Fivebrane_{diff,tw}(X) &amp;\to&amp; H_{diff}^8(X)
                    \\\
