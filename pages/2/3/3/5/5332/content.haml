                      %mi 𝔰𝔬
                    %annotation{:encoding => "application/x-tex"} \mathfrak{so}
          #DifferentialStringStructure.un_def
            %h6#definition_2 Definition
            %p
              For any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} X \in
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
              %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} 6-groupoid
              of
              %strong differential fivebrane-structures
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              –
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
