            %p
              whose image under the
              %a{:href => "http://nlab.mathforge.org/nlab/show/Euclidean-topological%20infinity-groupoid#GeometricHomotopy"} the fundamental ∞-groupoid (∞,1)-functor/ geometric realization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo :
                    %mi Smooth
                    %mn ∞
                    %mi Grpd
                    %mo →
                  %annotation{:encoding => "application/x-tex"} \Pi : Smooth \infty Grpd \to
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              is the ordinary second fractional
              %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 6
                    %msub
                      %mi p
                      %mn 2
                    %mo :
                    %mi B
                    %mi String
                    %mo →
                    %msup
                      %mi B
                      %mn 8
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{1}{6}p_2 : B String \to B^8 \mathbb{Z}
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive%20(infinity,1)-topos#ChernWeilTheory"} refined differential characteristic class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mn 1
                      %mn 6
                    %msub
                      %mover
                        %mstyle{:mathvariant => "bold"}
                          %mi p
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo :
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %mi conn
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi String
                    %mo{:stretchy => "false"} )
