                  %div
                    %p
                      %a{:href => "/nlab/edit/physicscontents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %ul
                %li
                  %a{:href => "#global_gauge_group"} Global gauge group
                %li
                  %a{:href => "#local_gauge_groups"} Local gauge groups
              %li
                %a{:href => "#Properties"} Properties
              %ul
                %li
                  %a{:href => "#NotARedundancy"} Not a redundancy
              %li
                %a{:href => "#Examples"} Examples
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
              %ul
                %li
                  %a{:href => "#global_gauge_group_2"} Global gauge group
                %li
                  %a{:href => "#local_gauge_group"} Local gauge group
                %li
                  %a{:href => "#local_gauging_of_global_symmetries_in_quantum_gravity"} Local gauging of global symmetries in quantum gravity
          %h2#idea Idea
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            by a
            %em
              %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
            one means a “
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            of
            = succeed "\u201D," do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformations"} gauge transformations
          %ul
            %li
              %p
                A
                %em local gauge group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is the
                %a.existingWikiWord{:href => "/nlab/show/structure+group"} structure group
                of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/principal+bundles"} principal bundles
                which serve as topological sectors of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/gauge+fields"} gauge fields
                or of their
                %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundles"} fiber bundles
                which serve as topological sectors of other
                %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} fields
                (cf.
                = succeed ")." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/fiber+bundles+in+physics"} fiber bundles in physics
            %li
              %p
                A
                %em global gauge group
                is a group of
                %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
                that
                %a.existingWikiWord{:href => "/nlab/show/group+action"} acts
                as the
                %a.existingWikiWord{:href => "/nlab/show/global+symmetry"} global symmetry
                group on the (
                %a.existingWikiWord{:href => "/nlab/show/local+net"} local net
                of)
                %a.existingWikiWord{:href => "/nlab/show/observables"} observables
                of a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
          %p Moreover, in a kind of combination of these two cases, some authors in mathematical physics say that:
          %ul
            %li
              The
              %em gauge group of a (principal) fiber bundle
              is its
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} automorphism group
              over its base space.
          %p
            For for instance if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is the
            %a.existingWikiWord{:href => "/nlab/show/trivial+bundle"} trivial
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            over a space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(X,G)
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/functions"} functions
            %a.existingWikiWord{:href => "/nlab/show/maps"} maps
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with values in the
            %em local
            gauge group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            Notably after
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            the gauge group in the first sense does
            %em not
            become a gauge group in the second sense. On the contrary, observables in quantum field theory are required
            %em not
            to depend on gauge transformations in the first sense, and part of what makes quantization of
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            nontrivial is to find among all potential candidate observables those that actually are invariant under gauge transformations, i.e. under isomorphisms of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
            in the configuration space of the gauge theory.
          %h3#global_gauge_group Global gauge group
          %p
            The concept of gauge groups is most prominent in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            %a.existingWikiWord{:href => "/nlab/show/physical+system"} physical system
            is the
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            of transformations of the mathematical model of the system that do not correspond to any measurable
            %a.existingWikiWord{:href => "/nlab/show/physics"} physical
            effects. In this sense, nontrivial gauge groups arise from redundancies of the mathematical description. Gauge groups are a central ingredient of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/AQFT"} AQFT
            gauge groups are introduced via a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/net+of+C-star-systems"} net of C-star-systems
          %h3#local_gauge_groups Local gauge groups
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            and other
            %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
            the
            %em gauge groups
            is the structure group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            of the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            on which the
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
          %p
            Local gauge groups are visible in the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+mechanics"} Lagrangian
            approach to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            is a function by
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/BV-BRST+formalism"} BV-BRST formalism
          %h2#Properties Properties
          %h3#NotARedundancy Not a redundancy
          %p
            Sometimes one sees the statement being made that gauge symmetry in theories of
            %a.existingWikiWord{:href => "/nlab/show/physics"} physics
            is just a sign of a
            %em redundancy
            in the theory, since, after all, gauge equivalent configurations are equivalent.
          %p
            But, instead, there is genuine information contained in the gauge group of a physical theory: it encodes the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            of the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            of configurations; or in other words: the higher
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configurations
            of the system.
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+object"} Infinitesimally
            this is given by the
            %a.existingWikiWord{:href => "/nlab/show/BRST+complex"} BRST complex
            of the system, and the nature of the gauge group controls its higher
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cohomology groups
            %a.existingWikiWord{:href => "/nlab/show/quantum+anomalies"} quantum anomalies
            (as discussed there) of the system. This is clearly not redundant information.
          %p
            Abstractly speaking, the idea that symmetry is
            %em just
            a redundancy is a mistake of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            of
            %a.existingWikiWord{:href => "/nlab/show/configuration+space"} configurations
            – where different configurations are related by
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/gauge+transformation"} gauge transformation
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            space of configurations modulo gauge transformations is the
            %a.existingWikiWord{:href => "/nlab/show/decategorification"} decategorification
            of the groupoid. More technically speaking, it is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncation
            \. It computes the 0-th
            %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            and forgets all the higher homotopy groups.
          %p While there is indeed some information extracted by this process, that about the gauge equivalence classes of configurations, other information is lost.
          %p
            Physically speaking, notably the
            %em locality
            of field theory would break down if one insisted on always passing to gauge equivalence classes of configurations.
          %p
            For instance in a finite
            %a.existingWikiWord{:href => "/nlab/show/QFT"} QFT
            such as
            %a.existingWikiWord{:href => "/nlab/show/Dijkgraaf-Witten+theory"} Dijkgraaf-Witten theory
            with gauge group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
            is the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/connected"} connected
            %em locally
            every configuration of DW-theory is gauge equivalent to every other: namely the field configurations are
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            these are all equivalent to the trivial principal bundle
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ×
                    %mi G
                  %annotation{:encoding => "application/x-tex"} U \times G
          %p
            Entirely analogous comments apply to more interesting theories such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential refinement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi P
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn} := [P_1(-),\mathbf{B}G]
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G
            (see
            %em
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
            for details). Again, this cannot be reconstructed from its decategorification and if one insisted on passing to gauge equivalence classes of configurations then either Yang-Mills theory would no longer appear as a local QFT, or else it would have just the the globally trivial configurations.
          %p
            To say this more precisely, here instead of “
            %a.existingWikiWord{:href => "/nlab/show/moduli+space"}> moduli space
            ” we should be saying “
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"}> moduli stack
            ”. The mathematical theory of
            %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
            is the theory that deals with systems that are both
            %em local
            (in that global configurations are glued together from local data) as well as equipped with (gauge) symmetries. In that more refined language of
            %a.existingWikiWord{:href => "/nlab/show/higher+topos+theory"} higher topos theory
            one would find and say that the
            %a.existingWikiWord{:href => "/nlab/show/0-truncated"} 0-truncation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %msub
                    %mi G
                    %mi conn
                %annotation{:encoding => "application/x-tex"} \mathbf{B}G_{conn}
            is the
            %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            of gauge equivalence classes of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+form"} Lie algebra valued differential form
            = succeed "es," do
              %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            %a.existingWikiWord{:href => "/nlab/show/instanton"} instanton
            solutions from the theory, which are known to crucially encode information about the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum theory
          %p
            That all said, one should note that in
            %em higher
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            redundancies may appear after all. This is related to the fact that in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            the notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/resolution"}> resolution
              s
            becomes relevant: there are higher
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            %a.existingWikiWord{:href => "/nlab/show/equivalence+in+an+%28infinity%2C1%29-category"} equivalent
            to simpler moduli stacks.
          %p
            For instance if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} U(1) \to \hat G \to G
            is a
            %a.existingWikiWord{:href => "/nlab/show/central+extension"} central extension
            of the gauge group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
            denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U(1) \to \hat G)
            (see
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/crossed+module"} crossed module
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Courant+sigma-model"} Courant sigma-model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U(1) \to \hat G)
            is in fact equivalent to ordinary
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U(1) \to \hat G)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (U(1) \to \hat G)
            or else of its
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            (now a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/infinity-stack"} 2-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbf{B}(U(1) \to \hat G)
            are the same as that of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
          %p
            But even in such a situation, these redundant
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (U(1) \to \hat G) \to (U(1) \to 1) = \mathbf{B}U(1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            this constitutes an
            %a.existingWikiWord{:href => "/nlab/show/infinity-anafunctor"} 2-anafunctor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mover
                            %mi G
                            %mo{:stretchy => "false"} ^
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mn 2
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{B}(U(1) \to \hat G)
                  \&amp;\to&amp;
                  \\mathbf{B}^2 U(1)
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  \\mathbf{B}G
                  }
                  \\,.
          %p
            This structure exhibits a
            %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            of
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/group+extension"} group extension
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat G
          %p
            A famous example of this in
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            comes from the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \hat G \to G
            is the projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi PU
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U(n) \to PU(n)
            from the
            %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/projective+unitary+group"} projective unitary group
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PU
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PU(n)
            %a.existingWikiWord{:href => "/nlab/show/twisted+bundle"} twisted bundle
            representing a class in
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            as it appears on the worldvolume of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/D-brane"} D-brane
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}U(1)
            = succeed "(" do
              %a.existingWikiWord{:href => "/nlab/show/Kalb-Ramond+field"} Kalb-Ramond field
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            %em twist
            that twists the bundle and prevents it from being a configuration in genuine
            = succeed "-gauge" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(n)
          %h2#Examples Examples
          %p
            We list examples of local gauge groups and
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groups"} ∞-groups
            for various higher
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gauge+theories"} gauge theories
          %ul
            %li
              %p
                the gauge group of
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
                is the given
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
                this is the
                %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi SU
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ×
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SU(3) \times SU(2) \times U(1)
            %li
              %p
                the local gauge group of
                %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
                on a
                %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/Poincare+group"} Poincare group
            %li
              %p
                the gauge
                %a.existingWikiWord{:href => "/nlab/show/2-group"} 2-group
                of the
                %a.existingWikiWord{:href => "/nlab/show/Kalb-Ramond+field"} Kalb-Ramond field
                is the
                %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle 2-group
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B} U(1) = (U(1) \to 1)
            %li
              %p
                the gauge
                %a.existingWikiWord{:href => "/nlab/show/3-group"} 3-group
                of the
                %a.existingWikiWord{:href => "/nlab/show/supergravity+C-field"} supergravity C-field
                is the
                %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle 3-group
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mn 2
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mn 1
                        %mo →
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}^2 U(1) = (U(1) \to 1 \to 1)
            %li
              %p
                the gauge group of abelian
                %a.existingWikiWord{:href => "/nlab/show/higher+dimensional+Chern-Simons+theory"} higher dimensional Chern-Simons theory
                in dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 4
                      %mi k
                      %mo +
                      %mn 3
                    %annotation{:encoding => "application/x-tex"} 4 k+3
                is the
                %a.existingWikiWord{:href => "/nlab/show/circle+n-group"} circle (2k+1)-group
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mrow
                            %mn 2
                            %mi k
                        %mi U
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbf{B}^{2k} U(1)
            %li
              %p
                the 7-dimensional “
                %a.existingWikiWord{:href => "/nlab/show/differential+fivebrane+structure"}> fivebrane Chern-Simons theory
                ” has as gauge 2-group the
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/string+2-group"} string 2-group
            %li
              %p
                the symmetry group of
                %a.existingWikiWord{:href => "/nlab/show/string+field+theory"} string field theory
                is some
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                that is not an
                = succeed "-group" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p
                an
                %a.existingWikiWord{:href => "/schreiber/show/%E2%88%9E-Chern-Simons+theory"} ∞-Chern-Simons theory
                has in general not only a gauge
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
                but an
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
                of symmetries:
              %ul
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/Poisson+sigma-model"} Poisson sigma-model
                    has as gauge groupoid the
                    %a.existingWikiWord{:href => "/nlab/show/symplectic+groupoid"} symplectic groupoid
                    that is the
                    %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
                    of the given
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/Poisson+Lie+algebroid"} Poisson Lie algebroid
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/Courant+sigma-model"} Courant sigma-model
                    has as gauge
                    %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
                    the
                    %a.existingWikiWord{:href => "/nlab/show/symplectic+infinity-groupoid"} symplectic 2-groupoid
                    that integrates the given
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/Courant+Lie+2-algebroid"} Courant Lie 2-algebroid
                %li
                  %p
                    generally, the
                    %a.existingWikiWord{:href => "/nlab/show/AKSZ+sigma-model"} AKSZ sigma-model
                    in grade
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                    has as gauge
                    = succeed "-groupoid" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn ∞
                          %annotation{:encoding => "application/x-tex"} \infty
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/symplectic+infinity-groupoid"} symplectic Lie n-groupoid
