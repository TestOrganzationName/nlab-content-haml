          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#definitions"} Definitions
              %ul
                %li
                  %a{:href => "#between_topological_spaces"} Between topological spaces
                %li
                  %a{:href => "#between_schemes"} Between schemes
                %li
                  %a{:href => "#between_locales"} Between locales
                %li
                  %a{:href => "#between_toposes"} Between toposes
              %li
                %a{:href => "#related_concepts"} Related concepts
