                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \circ_{a,b,c} : C(b,c) \otimes C(a,b) \to C(a,c)
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
