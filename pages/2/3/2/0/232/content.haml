                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mo ∘
                                %mrow
                                  %mi a
                                  %mo ,
                                  %mi b
                                  %mo ,
                                  %mi b
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo ←
                            %mrow
                              %msub
                                %mo ∘
                                %mrow
                                  %mi a
                                  %mo ,
                                  %mi a
                                  %mo ,
                                  %mi b
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi a
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↑
                            %mrow
                              %msub
                                %mi j
                                %mi b
                              %mo ⊗
                              %msub
                                %mi Id
                                %mrow
                                  %mi C
                                  %mo{:stretchy => "false"} (
                                  %mi a
                                  %mo ,
                                  %mi b
                                  %mo{:stretchy => "false"} )
                        %mtd
                          %msub
                            %mo ↗
                            %mi l
                        %mtd
                        %mtd
