                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi I
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C(b,b)\otimes C(a,b)
                  \&amp;\stackrel{\circ_{a,b,b}}{\to}&amp;
                  C(a,b)
                  \&amp;\stackrel{\circ_{a,a,b}}{\leftarrow}&amp;
                  C(a,b) \otimes C(a,a)
                  \\\
                  \\uparrow^{j_b \otimes Id_{C(a,b)}}
                  \&amp; \nearrow_{l}&amp;&amp; {}_r\nwarrow&amp;
                  \\uparrow^{Id_{C(a,b)}\otimes j_a}
                  \\\
                  I \otimes C(a,b)
                  \&amp;&amp;&amp;&amp;
                  C(a,b) \otimes I
                  }
          %p
            this says that composition is
            = succeed "." do
              %em unital
          %p
            A monoidal category over which one intends to do enriched category theory may be referred to as a
            = succeed ";" do
              %em base of enrichment
            = succeed "." do
              %a{:href => "#InBicat"} enrichment in a bicategory
          %p
            In practice, one often takes a (monoidal) base of enrichment to be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/B%C3%A9nabou+cosmos"} Bénabou cosmos
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/functor+categories"} functor categories
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tensor+products+of+enriched+categories"} tensor products of enriched categories
            %a.existingWikiWord{:href => "/nlab/show/ends"} ends
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/coends"} coends
            %a.existingWikiWord{:href => "/nlab/show/limits"} limits
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
          %h4#enrichment_through_lax_monoidal_functors Enrichment through lax monoidal functors
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a monoidal category, then an alternative way of viewing a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            together with a (lax)
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo =
                  %msub
                    %mi Φ
                    %mi d
                %annotation{:encoding => "application/x-tex"} \Phi = \Phi_d
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mi op
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi yon
                        %mi V
                  %msup
                    %mi Set
                    %mi V
                  %mover
                    %mo →
                    %mi d
                  %msup
                    %mi Set
                    %mrow
                      %mi X
                      %mo ×
                      %mi X
                %annotation{:encoding => "application/x-tex"} V^{op} \stackrel{yon_V}{\to} Set^{V} \stackrel{d}{\to} Set^{X \times X}
          %p
            where the codomain is identified with the monoidal category of spans on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hom(X, X)
            in the
            %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            of
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/span"} span
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi d
                  %mo :
                  %mi X
                  %mo ×
                  %mi X
                  %mo →
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, d: X \times X \to V)
            under the ordinary definition, the corresponding monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                %annotation{:encoding => "application/x-tex"} \Phi
            takes an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi V
                    %mi op
                %annotation{:encoding => "application/x-tex"} V^{op}
            to the span
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi v
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                  %mo :
                  %mo =
                  %msub
                    %mi hom
                    %mi V
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi(v)_{x, y} := \hom_V(v, d(x, y))
          %p Under the composition law, we get a natural map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ′
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ⊗
                  %mi v
                  %mo ′
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi comp
                      %mo{:stretchy => "false"} )
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ⊗
                  %mi v
                  %mo ′
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hom(v, d(x, y)) \times \hom(v', d(y, z)) \to \hom(v \otimes v', d(x, y) \otimes d(y, z)) \stackrel{\hom(1, comp)}{\to} \hom(v \otimes v', d(x, z))
          %p
            which gives the tensorial constraint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ⊗
                  %mi v
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi(v) \circ \Phi(v') \to \Phi(v \otimes v')
            for a monoidal functor; the identity law similarly gives the unit constraint.
          %p
            Conversely, by using a Yoneda-style argument, such a monoidal functor structure on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo =
                  %msub
                    %mi Φ
                    %mi d
                %annotation{:encoding => "application/x-tex"} \Phi = \Phi_d
            induces an
            = succeed "-enrichment" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Alternatively, we can equivalently describe a
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mi V
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %mi X
                      %mo ×
                      %mi X
                %annotation{:encoding => "application/x-tex"} Set^V \to Set^{X \times X}
          %p
            since bicontinuous functors of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mi V
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %mi X
                      %mo ×
                      %mi X
                %annotation{:encoding => "application/x-tex"} Set^V \to Set^{X \times X}
            are precisely those of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mi d
                %annotation{:encoding => "application/x-tex"} Set^d
            for some function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo :
                    %mi X
                    %mo ×
                    %mi X
                    %mo →
                    %mi V
                  %annotation{:encoding => "application/x-tex"} d: X \times X \to V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+category"} Cauchy complete
          %h3#enrichment_in_a_bicategory Enrichment in a bicategory
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bicategory"} bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            for horizontal (1-cell) composition (written in Leibniz order). A
            %a.existingWikiWord{:href => "/nlab/show/category+enriched+in+a+bicategory"} category enriched in the bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            consists of a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            together with
          %ul
            %li
              A function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi X
                      %mo →
                      %msub
                        %mi B
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} p: X \to B_0
            %li
              A function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo :
                      %mi X
                      %mo ×
                      %mi X
                      %mo →
                      %msub
                        %mi B
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \hom: X \times X \to B_1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi p
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \hom(x, y): p(x) \to p(y)
            %li
              A function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∘
                      %mo :
                      %mi X
                      %mo ×
                      %mi X
                      %mo ×
                      %mi X
                      %mo →
                      %msub
                        %mi B
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \circ: X \times X \times X \to B_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∘
                        %mrow
                          %mi x
                          %mo ,
                          %mi y
                          %mo ,
                          %mi z
                      %mo :
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \circ_{x, y, z}: \hom(y, z) \otimes \hom(x, y) \to \hom(x, z)
            %li
              A function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo :
                      %mi X
                      %mo →
                      %msub
                        %mi B
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} j: X \to B_2
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mi x
                      %mo :
                      %msub
                        %mn 1
                        %mrow
                          %mi p
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mo →
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j_x: 1_{p(x)} \to \hom(x, x)
          %p
            such that the associativity and unitality diagrams, as written above, commute. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a monoidal category, we can view it as a 1-object bicategory by working with its
            %a.existingWikiWord{:href => "/nlab/show/delooping#delooping_of_higher_structures"} delooping
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            coincides with the notion of enrichment in the bicategory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi M
                  %annotation{:encoding => "application/x-tex"} \mathbf{B} M
          %p
            If
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            are sets which come equipped with enrichments in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f: X \to Y
            such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi Y
                    %mo ∘
                    %mi f
                    %mo =
                    %msub
                      %mi p
                      %mi X
                  %annotation{:encoding => "application/x-tex"} p_Y \circ f = p_X
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo :
                    %mi X
                    %mo ×
                    %mi X
                    %mo →
                    %msub
                      %mi B
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} f_1: X \times X \to B_2
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi hom
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi hom
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_1(x, y): \hom_X(x, y) \to \hom_Y(f(x), f(y))
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∘
                  %annotation{:encoding => "application/x-tex"} \circ
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                %annotation{:encoding => "application/x-tex"} j
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          %p
            Categories enriched in bicategories were originally introduced by
            %a.existingWikiWord{:href => "/nlab/show/B%C3%A9nabou"} Bénabou
            under the name
            = succeed "." do
              %strong polyad
            %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} many-object generalisations
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            enriched in a bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is precisely a monad in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has one object.
          %h3#InDoubleCat Enrichment in a double category
          %p
            It is also natural to generalize further to categories enriched in a (possibly weak)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/double+category"} double category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is a double category, then a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %strong enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{X}
            consists of a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            together with
          %ul
            %li
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(x)
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
            %li
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x,y\in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(x, y)\colon p(x) \to p(y)
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
            %li
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ,
                      %mi z
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x,y,z\in X
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mi hom
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo ,
                                  %mi y
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %mi hom
                                  %mo{:stretchy => "false"} (
                                  %mi y
                                  %mo ,
                                  %mi z
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi z
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ‖
                            %mtd
                            %mtd
                              %msub
                                %mo ∘
                                %mrow
                                  %mi x
                                  %mo ,
                                  %mi y
                                  %mo ,
                                  %mi z
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ‖
                          %mtr
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %mi hom
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo ,
                                  %mi z
                                  %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi z
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{p(x) &amp; \overset{hom(x,y)}{\to} &amp; p(y) &amp; \overset{hom(y,z)}{\to} &amp; p(z) \\
                      \\Vert &amp;&amp; \circ_{x,y,z} &amp;&amp; \Vert\\
                      p(x) &amp;&amp; \underset{hom(x,z)}{\to} &amp;&amp; p(z)}
            %li
              for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x\in X
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mi id
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ‖
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ‖
                          %mtr
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %mi hom
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo ,
                                  %mi x
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{p(x) &amp; \overset{id}{\to} &amp; p(x)\\
                      \\Vert &amp;&amp; \Vert\\
                      p(x) &amp; \underset{hom(x,x)}{\to} &amp; p(x)}
          %p
            satisfying analogues of the associativity and unit conditions. Note that is is exactly the same as a category enriched in the horizontal bicategory of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            play no role in the definition. However, they
            %em do
            play a role when it comes to define functors between
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi X
                %annotation{:encoding => "application/x-tex"} \mathbf{X}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi Y
                %annotation{:encoding => "application/x-tex"} \mathbf{Y}
            are
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mstyle{:mathvariant => "bold"}
                    %mi X
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Y
                %annotation{:encoding => "application/x-tex"} f\colon \mathbf{X}\to \mathbf{Y}
            consists of:
          %ul
            %li
              a function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f\colon X\to Y
            %li
              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
              a vertical arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi p
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi p
                      %mi Y
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f_x\colon p_X(x) \to p_Y(f(x))
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
            %li
              for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x,y\in X
              a 2-cell in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi hom
                                    %mi X
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo ,
                                  %mi y
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mo
                                %mrow
                                  %msub
                                    %mi f
                                    %mi x
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                                  %msub
                                    %mi f
                                    %mi y
                          %mtr
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %msub
                                    %mi hom
                                    %mi Y
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %mi f
                                  %mo{:stretchy => "false"} (
                                  %mi y
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi p
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} (
                              %mi y
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{p(x) &amp; \overset{hom_X(x,y)}{\to} &amp; p(y)\\
                      ^{f_x}\downarrow &amp;&amp; \downarrow^{f_y}\\
                      p(f(x))&amp; \underset{hom_Y(f(x),f(y))}{\to} &amp; p(f(y))}
          %p
            satisfying suitable equations. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is vertically discrete, i.e. just a bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            with no nonidentity vertical arrows, then this is just the same as a
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            this notion of functor is more general and natural.
          %h3#other_bases_of_enrichment Other bases of enrichment
          %p
            It is possible to generalise the above further to enrichment in
            %a.existingWikiWord{:href => "/nlab/show/virtual+double+categories"} virtual double categories
            (see
            = succeed ")," do
              %a{:href => "#Leinster02"} Leinster (2002)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
          %p Other kinds of enrichment:
          %ul
            %li
              Enrichment in a
              %a.existingWikiWord{:href => "/nlab/show/closed+category"} closed category
              (though this is subsumed by enrichment in a (closed) multicategory).
            %li
              Enrichment in a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/skew-monoidal+category"} skew-monoidal category
          %h2#BaseChange Change of enriching category
          %p
            Also called “change of base”, this typically refers to a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            between bases of enrichment
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} V \to W
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "-Cat," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cat
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} Cat \to W
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat
            to be transferred to constructions in
            = succeed "-Cat," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          %h3#passage_between_ordinary_categories_and_enriched_categories Passage between ordinary categories and enriched categories
          %p
            Every
            = succeed "-enriched" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/underlying+ordinary+category"} underlying ordinary category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C_0(x,y) = K(I, hom(x,y))
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is the unit object of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi K
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} K(I, -): K \to Set
            has a left adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ⋅
                  %mi I
                  %mo :
                  %mi Set
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} - \cdot I: Set \to K
            (taking a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to the tensor, aka the
            %a.existingWikiWord{:href => "/nlab/show/power"} copower
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⋅
                    %mi I
                  %annotation{:encoding => "application/x-tex"} S \cdot I
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            can be regarded as enriched in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            by forming the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi hom
                  %mi Set
                  %mover
                    %mo →
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ⋅
                      %mi I
                  %mi K
                %annotation{:encoding => "application/x-tex"} Ob(C) \times Ob(C) \stackrel{\hom}{\to} Set \stackrel{-\cdot I}{\to} K
          %p
            These two operations form
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            relating the
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            to the 2-category
            = succeed "-Cat." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
          %h3#lax_monoidal_functors Lax monoidal functors
          %p
            More generally, any (lax)
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi K
                  %mo →
                  %mi L
                %annotation{:encoding => "application/x-tex"} F: K \to L
            between monoidal categories can be regarded as a “
            %a.existingWikiWord{:href => "/nlab/show/change+of+enriching+category"}> change of base
            ”. By applying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            to its hom-objects, any category enriched over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            gives rise to one enriched over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
            from
            = succeed "-Cat" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-Cat," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            = succeed "-Prof" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            = succeed "-Prof;" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
            %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-category+equipped+with+proarrows"} 2-category equipped with proarrows
          %p
            Moreover, this operation is itself functorial from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi MonCat
                %annotation{:encoding => "application/x-tex"} MonCat
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} 2Cat
            %a.existingWikiWord{:href => "/nlab/show/monoidal+adjunction"} monoidal adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ⇄
                  %mi L
                %annotation{:encoding => "application/x-tex"} K\rightleftarrows L
            gives rise to a
            %a.existingWikiWord{:href => "/nlab/show/2-adjunction"} 2-adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mi Cat
                  %mo ⇄
                  %mi L
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} K Cat\rightleftarrows L Cat
            (and also for profunctors). The adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo ⇄
                  %mi K
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} Cat \rightleftarrows K Cat
            described above is a special case of this arising from the adjunction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ⋅
                    %mi I
                    %mo :
                    %mi Set
                    %mo ⇄
                    %mi K
                    %mo :
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} -\cdot I: Set \rightleftarrows K : K(I,-)
          %p
            This and further properties of such “
            %a.existingWikiWord{:href => "/nlab/show/change+of+enriching+category"}> change of base
            ” are explored in
            %a{:href => "#Crutwell14"} Crutwell 14
          %h2#TensorProductOfEnrichedCategories Tensor product of enriched categories
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
            %strong V-enriched categories
            (see
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/enriched+product+category"} enriched product category
            %strong
              %a.existingWikiWord{:href => "/nlab/show/VCat"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mi Cat
                    %annotation{:encoding => "application/x-tex"} V Cat
            of V-enriched categories itself a symmetric monoidal category. In fact V-Cat is even a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+2-category"} symmetric monoidal 2-category
            = succeed "." do
              %a{:href => "#Kelly82"} Kelly (1982), p. 12
          %h2#enrichment_versus_internalization Enrichment versus internalization
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enrichment+versus+internalisation"} enrichment versus internalisation
          %h2#Examples Examples
          %ul
            %li
              %p
                A category enriched in
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
            %li
              %p
                A category enriched in
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/dg-category"} dg-category
            %li
              %p
                A category enriched in
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
                is called a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicial category
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
              %p
                Beware: the term ‘simplicial category’ is also used to mean a category
                %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
                simplicial sets. In fact, a category enriched in simplicial sets is a special case of a category internal to simplicial sets, namely one where the simplicial set of objects is discrete.
            %li
              %p
                A category enriched in
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
              %p
                Again beware: the term ‘topological category’ is perhaps more commonly used to mean a category
                %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
                Top. People also use it for
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/topological+concrete+category"} topological concrete category
            %li
              %p
                A category enriched in
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
            %li
              %p
                A category enriched in
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/strict+%282%2C1%29-category"} strict (2,1)-category
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/strict+n-category"} strict n-category
                is a category enriched over strict
                = succeed "-categories." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} n \to \infty
                this leads to
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/strict+omega-category"} strict omega-categories
            %li
              %p
                An
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/algebroid"} algebroid
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/linear+category"} linear category
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Vect
                    %annotation{:encoding => "application/x-tex"} Vect
                is the category of vector spaces over some fixed
                %a.existingWikiWord{:href => "/nlab/show/field"} field
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                and call a category enriched over Vect a
                = succeed "." do
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
                    \-linear category
            %li
              %p
                More generally, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                is any
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mspace{:width => "thinmathspace"}
                    %annotation{:encoding => "application/x-tex"} K\,
                %a.existingWikiWord{:href => "/nlab/show/Mod"} Mod
                is sometimes called a
                = succeed "-linear" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
            %li
              %p
                In particular, taking
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                to be
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
                (the ring of
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                %a.existingWikiWord{:href => "/nlab/show/ringoid"} ringoid
                (or
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Ab-enriched+category"} Ab-enriched category
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
            %li
              %p
                A (Lawvere)
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
                is a category enriched over the poset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo ≥
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([0, \infty], \geq)
                of extended positive real numbers, where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                      %annotation{:encoding => "application/x-tex"} +
            %li
              %p
                An
                %a.existingWikiWord{:href => "/nlab/show/ultrametric+space"} ultrametric space
                is a category enriched over the poset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn ∞
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo ≥
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} ([0, \infty], \geq)
                of extended positive real numbers, where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi max
                      %annotation{:encoding => "application/x-tex"} \max
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
                is a category enriched over the category of
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/truth+value"} truth value
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/logical+conjunction"} conjunction
            %li
              %p
                An
                %a.existingWikiWord{:href => "/nlab/show/apartness+relation"} apartness space
                is a
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                enriched over the opposite of the category of truth values, where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/disjunction"} disjunction
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
                over some group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                may be modeled by a category enriched over the
                %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete category
                on the set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                is the group operation. Not every such category determines a torsor, however; it must be nonempty as well as
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Cauchy+complete+category"} Cauchy complete
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/F-categories"} F-categories
                are categories enriched over a subcategory of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Cat
                          %mo →
                      %annotation{:encoding => "application/x-tex"} Cat^{\to}
                %a.existingWikiWord{:href => "/nlab/show/M-categories"} M-categories
                are categories enriched over a subcategory of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Set
                          %mo →
                      %annotation{:encoding => "application/x-tex"} Set^{\to}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/2-categories+with+contravariance"} 2-categories with contravariance
                (and generalizations such as
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/3-categories+with+contravariance"} 3-categories with contravariance
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tangent+bundle+categories"} tangent bundle categories
                can be described as a certain kind of enriched category with certain
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/powers"} powers
                %a{:href => "#Garner2018"} Garner 2018
                for details.
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lawvere+theories"} Lawvere theories
                can be represented as enriched categories as well; see
                %a{:href => "#Garner2014"} Garner 2013
                and
                %a{:href => "#GarnerPower2017"} Garner and Power 2017
                for details.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/B%C3%A9nabou+cosmos"} Bénabou cosmos
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+poset"} enriched poset
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+groupoid"} enriched groupoid
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+presheaf"} enriched presheaf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+monad"} enriched monad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+bicategory"} enriched bicategory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/category+enriched+over+a+bicategory"} category enriched over a bicategory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+enriched+categories"} model structure on enriched categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+monoidal+category"} enriched monoidal category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+enriched+category"}> cartesian closed enriched category
                ,
                %a.existingWikiWord{:href => "/nlab/show/locally+cartesian+closed+enriched+category"} locally cartesian closed enriched category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+%28%E2%88%9E%2C1%29-category"} enriched (∞,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/enriched+type"} enriched type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/magnitude+of+an+enriched+category"} magnitude of an enriched category
          %h2#references References
          %p
            The idea that it is worthwhile to replace
            %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
            by “
            %a.existingWikiWord{:href => "/nlab/show/hom-objects"}> hom-objects
            ” (in some sense) is perhaps first present in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              , §24 of:
              %em Categorical algebra
              Bulletin of the American Mathematical Society 71.1 (1965): 40-106.
          %p The earliest accounts of enriched categories were given independently in:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"}> Jean Bénabou
                ,
                = succeed "," do
                  %em Catégories relatives
                %strong 260
                (1965) 3824-3827 &amp;lbrack;
                %a{:href => "https://gallica.bnf.fr/ark:/12148/bpt6k4019v/f37.item"}> gallica
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Marie+Maranda"}> Jean-Marie Maranda
                ,
                = succeed "," do
                  %em Formal categories
                %strong 17
                (1965) 758-801 &amp;lbrack;
                %a{:href => "https://doi.org/10.4153/CJM-1965-076-0"}> doi:10.4153/CJM-1965-076-0
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://www.cambridge.org/core/services/aop-cambridge-core/content/view/A7C463460EB8CAC64C2CA340F870CF80/S0008414X00039729a.pdf/formal-categories.pdf"} pdf
          %p
            (both of which also introduce the notion of
            %em
              %a.existingWikiWord{:href => "/nlab/show/strict+2-categories"} strict 2-categories
            as the example of
            = succeed "-enriched" do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
          %p though Kelly also gave an account for enrichment in arbitrary categories (then deducing necessary structure on a tensor product):
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gregory+Maxwell+Kelly"}> Gregory Maxwell Kelly
              \.
              = succeed "." do
                %em Tensor products in categories
              %strong 2
              1 (1965) 15-37 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0021-8693(65)90022-0"}> doi:10.1016/0021-8693(65)90022-0
              \&amp;rbrack;
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Fred+Linton"}> Fred Linton
              \.
              = succeed "." do
                %em Autonomous categories and duality of functors
          %p
            Enrichment in a
            %a.existingWikiWord{:href => "/nlab/show/multicategory"} multicategory
            was first suggested in:
          %ul
            %li#Lambek69
              %a.existingWikiWord{:href => "/nlab/show/Joachim+Lambek"}> Joachim Lambek
              ,
              = succeed "," do
                %em Deductive Systems and Categories II: Standard constructions and closed categories
              %a.existingWikiWord{:href => "/nlab/show/Peter+Hilton"} Peter Hilton
              (eds.)
              = succeed "," do
                %em Category Theory, Homology Theory and their Applications I
              %strong 86
              Springer 1969 (
              %a{:href => "https://doi.org/10.1007/BFb0079385"}> doi:10.1007/BFb0079385
              ,
              = succeed ")" do
                %a{:href => "https://link.springer.com/content/pdf/10.1007/BFb0079385.pdf"} pdf
          %p Textbook accounts:
          %ul
            %li#Kelly82
              %p
                %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
                ,
                = succeed "," do
                  %em Basic concepts of enriched category theory
                = succeed "," do
                  %strong 64
                %strong 10
                (2005) 1-136 &amp;lbrack;
                %a{:href => "https://www.cambridge.org/de/academic/subjects/mathematics/logic-categories-and-sets/basic-concepts-enriched-category-theory?format=PB&isbn=9780521287029"}> ISBN:9780521287029
                ,
                = succeed "," do
                  %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10abs.html"} tac:tr10
                = succeed "&rbrack;" do
                  %a{:href => "http://www.tac.mta.ca/tac/reprints/articles/10/tr10.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
                , Chapter 6 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Handbook+of+Categorical+Algebra"} Handbook of Categorical Algebra
                    Vol 2: Categories and Structures
                = succeed "," do
                  %strong 50
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1017/CBO9780511525865"} doi:10.1017/CBO9780511525865
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                \:
                = succeed "," do
                  %em Basic concepts of enriched category theory
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Categorical+Homotopy+Theory"} Categorical Homotopy Theory
                = succeed "," do
                  %a{:href => "https://emilyriehl.github.io/files/cathtpy.pdf"} pdf
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1017/CBO9781107261457"} doi:10.1017/CBO9781107261457
            %li#JohnsonYau20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Niles+Johnson"}> Niles Johnson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Donald+Yau"} Donald Yau
                = succeed "," do
                  %em 2-Dimensional Categories
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/2002.06055"} arXiv:2002.06055
                = succeed ")" do
                  %a{:href => "https://oxford.universitypressscholarship.com/view/10.1093/oso/9780198871378.001.0001/oso-9780198871378"} doi:10.1093/oso/9780198871378.001.0001
          %p Also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Francis+Borceux"}> Francis Borceux
              , I. Stubbe,
              %em Short introduction to enriched categories
              (
              %a{:href => "http://www-lmpa.univ-littoral.fr/~stubbe/PDF/EnrichedCatsKLUWER.pdf"}> pdf
              )
          %p
            With an eye towards application in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %ul
            %li#Richter19
              %a.existingWikiWord{:href => "/nlab/show/Birgit+Richter"}> Birgit Richter
              , Section 9 of:
              = succeed "," do
                %em From categories to homotopy theory
              = succeed "," do
                %a{:href => "https://doi.org/10.1017/9781108855891"} doi:10.1017/9781108855891
              = succeed "," do
                %a{:href => "https://www.math.uni-hamburg.de/home/richter/catbook.html"} book webpage
              = succeed ")" do
                %a{:href => "https://www.math.uni-hamburg.de/home/richter/bookdraft.pdf"} pdf
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/change+of+enriching+category"} change of enriching category
            is in
          %ul
            %li#Crutwell14
              %a.existingWikiWord{:href => "/nlab/show/Geoff+Cruttwell"}> Geoff Cruttwell
              , chapter 4 of
              = succeed "," do
                %em Normed spaces and the Change of Base for Enriched Categories
              = succeed ")" do
                %a{:href => "http://pages.cpsc.ucalgary.ca/~gscruttw/publications/thesis4.pdf"} pdf
          %p Vista of some modern generalizations is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tom+Leinster"}> Tom Leinster
                ,
                = succeed "," do
                  %em Generalized enrichment for categories and multicategories
                %a{:href => "http://arxiv.org/abs/math.CT/9901139"} math.CT/9901139
            %li#Leinster02
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tom+Leinster"}> Tom Leinster
                ,
                = succeed "," do
                  %em Generalized enrichment of categories
                %strong 168
                (2002), no. 2-3, 391-406,
                %a{:href => "http://arxiv.org/abs/math.CT/0204279"} math.CT/0204279
            %li
              %p
                John Armstrong,
                %em
                  %a{:href => "http://unapologetic.wordpress.com/2007/08/13/enriched-categories/"} Enriched categories
          %p Further examples are discussed in
          %ul
            %li#Garner2013
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
                ,
                = succeed "," do
                  %em Lawvere theories, finitary monads and Cauchy-completion
                %a{:href => "https://arxiv.org/abs/1307.2963"} arxiv
            %li#GarnerPower2017
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"} Richard Garner
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/John+Power"} John Power
                = succeed "," do
                  %em An enriched view on the extended finitary monad–Lawvere theory correspondence
              %p
                (
                %a{:href => "https://arxiv.org/abs/1707.08694"} arXiv:1707.08694
            %li#Garner2018
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
                ,
                = succeed "," do
                  %em An embedding theorem for tangent categories
                = succeed "," do
                  %a{:href => "https://www.sciencedirect.com/science/article/pii/S0001870817303122"} doi
                %a{:href => "https://arxiv.org/abs/1704.08386"} arxiv
          %p
            On enrichment in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/virtual+double+categories"} virtual double categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Soichiro+Fujii"}> Soichiro Fujii
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stephen+Lack"} Stephen Lack
              %em The familial nature of enrichment over virtual double categories
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2507.05529"}> arXiv:2507.05529
              \&amp;rbrack;
          %p On enrichment in more general structures:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Christian+Lair"}> Christian Lair
              ,
              = succeed "," do
                %em Systèmes tensoriels et systèmes enrichis
