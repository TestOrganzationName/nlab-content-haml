          %h2#idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{}{\to} \Sigma
            %em
              space of
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            is like a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} \Sigma
          %p
            Formally this is given by the
            %em
              %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            construction. See at
            %em
              %a{:href => "section#InTermsOfDependentProduct"} section – In terms of dependent product
            and at
            = succeed "." do
              %em
                %a{:href => "dependent%20product#RelationToSpacesOfSections"} dependent product – In terms of spaces of sections
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            be a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            (for instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/SmoothSet"} SmoothSet
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            (for instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathbf{H} =
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo [
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi p
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi Σ
                    %mo ]
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Σ
                %annotation{:encoding => "application/x-tex"}
                  \\left[
                  \\,\,
                  \\array{
                  E
                  \\\
                  {}^{\mathllap{p}}\downarrow
                  \\\
                  \\Sigma
                  }
                  \\right]
                  \\;\colon\;
                  \\mathbf{H}_{/\Sigma}
          %p
            a
            %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{H}
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/slice+topos"} slice topos
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/slice+%28%E2%88%9E%2C1%29-topos"} slice (∞,1)-topos
          %p
            Then the
            %em space of sections
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
            of this bundle is the
            %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Γ
                    %mi Σ
                  %mi E
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi Σ
                  %mi E
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"}
                  \\Gamma_\Sigma E
                  \\coloneqq
                  \\prod_{\Sigma} E
                  \\;\in\; \mathbf{H}
          %p
            hence the image of the bundle under the
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Σ
                    %mo *
                %annotation{:encoding => "application/x-tex"} \Sigma_\ast
            in the
            %a.existingWikiWord{:href => "/nlab/show/base+change"} base change
            %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Σ
                  %munderover
                    %mover
                      %mo ⟵
                      %mrow
                        %msup
                          %mi Σ
                          %mo *
                    %munder
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Σ
                          %mo *
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mi Σ
                          %mo !
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                  %mo ,
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{H}_{/\Sigma}
                  \\underoverset
                  {\underset{\Sigma_\ast}{\longrightarrow}}
                  {\overset{\Sigma_!}{\longrightarrow}}
                  {\overset{\Sigma^\ast}{\longleftarrow}}
                  \\mathbf{H}
                  ,.
          %p
            By
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            this means that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} U \in \mathbf{H}
            a test object, then a
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⟶
                  %msub
                    %mi Γ
                    %mi Σ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  U \longrightarrow \Gamma_\Sigma(E)
          %p
            is equivalently a morphism in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi H
                    %mrow
                      %mo{:stretchy => "false"} /
                      %mi Σ
                %annotation{:encoding => "application/x-tex"} \mathbf{H}_{/\Sigma}
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo ×
                  %mi U
                  %mo =
                  %msup
                    %mi Σ
                    %mo *
                  %mi U
                  %mo ⟶
                  %mi E
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Sigma \times U = \Sigma^\ast U \longrightarrow E
                  \\,.
          %p
            This is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi E
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msub
                                  %mi ϕ
                                  %mi U
                          %mo ↗
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi p
                      %mtr
                        %mtd
                          %mi U
                          %mo ×
                          %mi Σ
                        %mtd
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mi pr
                                %mn 2
                        %mtd
                          %mi Σ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; E
                  \\\
                  \&amp; {}^{\mathllap{\phi_U}}\nearrow &amp; \downarrow^{\mathrlap{p}}
                  \\\
                  U \times \Sigma
                  \&amp;\underset{pr_2}{\longrightarrow}&amp;
                  \\Sigma
                  }
                  \\,,
          %p
            where the right and bottom morphisms are fixed, and where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ϕ
                    %mi U
                %annotation{:encoding => "application/x-tex"} \phi_U
            (and the
            %a.existingWikiWord{:href => "/nlab/show/2-cell"} 2-cell
            filling the diagram) is, manifestly, the
            = succeed "-parameterized" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
          %h2#properties Properties
          %h3#topological_vector_space_structure Topological vector space structure
          #TVSStructureOnSpacesOfSmoothSections.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+space"} Fréchet
                %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
                on spaces of smooth sections of a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+vector+bundle"} smooth vector bundle
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
              %a.existingWikiWord{:href => "/nlab/show/space+of+sections"} of smooth sections
              consider the
              %a.existingWikiWord{:href => "/nlab/show/seminorms"} seminorms
              indexed by a
              %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} K \subset \Sigma
              and a
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} N \in \mathbb{N}
              and given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi Γ
                              %mi Σ
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msubsup
                                  %mi p
                                  %mi K
                                  %mi N
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn ∞
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi Φ
                          %mtd
                            %mo ↦
                          %mtd
                            %munder
                              %mi max
                              %mrow
                                %mi n
                                %mo ≤
                                %mi N
                            %mrow
                              %mo (
                              %munder
                                %mi sup
                                %mrow
                                  %mi x
                                  %mo ∈
                                  %mi K
                              %mrow
                                %mo{:stretchy => "false"} |
                                %msup
                                  %mo ∇
                                  %mi n
                                %mi Φ
                                %mo{:stretchy => "false"} (
                                %mi x
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} |
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\Gamma_\Sigma(E) &amp;\overset{p_K^N}{\longrightarrow}&amp;
                    [0,\infty)
                    \\\
                    \\Phi &amp;\mapsto&amp;  \underset{n \leq N}{max} \left( \underset{x \in K}{sup} {\vert \nabla^n \Phi(x)\vert}\right) \,,
                    }
            %p
              where on the right we have the
              %a.existingWikiWord{:href => "/nlab/show/absolute+values"} absolute values
              of the
              %a.existingWikiWord{:href => "/nlab/show/covariant+derivatives"} covariant derivatives
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Φ
                  %annotation{:encoding => "application/x-tex"} \Phi
              for any fixed choice of
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and
              %a.existingWikiWord{:href => "/nlab/show/norm"} norm
              on the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+bundles"} tensor product of vector bundles
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi T
                        %mo *
                      %mi Σ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msubsup
                            %mo ⊗
                            %mi Σ
                            %mi n
                      %msub
                        %mo ⊗
                        %mi Σ
                      %mi E
                    %annotation{:encoding => "application/x-tex"} (T^\ast \Sigma)^{\otimes_\Sigma^n} \otimes_\Sigma E
            %p
              This makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_\Sigma(E)
              a
              %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+space"} Fréchet
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} K \subset \Sigma
              any
              %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
              then the sub-space of sections
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi K
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %msub
                      %mi Γ
                      %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma_{\Sigma,K}(E) \hookrightarrow \Gamma_\Sigma(E)
            %p
              of sections whose
              %a.existingWikiWord{:href => "/nlab/show/support"} support
              is inside
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9chet+space"} Fréchet
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+spaces"} topological vector spaces
              with the induced
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspaces"} closed subspaces
          %p
            (
            %a{:href => "#Baer14"}> Bär 14, 2.1, 2.2
            )
          %h3#extension_of_sections Extension of sections
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Whitney+extension+theorem"} Whitney extension theorem
            (
            %a{:href => "Whitney+extension+theorem#RobertsSchmeding18"}> Roberts-Schmediung 18
            ).
          %h2#examples Examples
          %ul
            %li
              The space of section of an universal
              %a.existingWikiWord{:href => "/nlab/show/associated+infinity-bundle"} associated infinity-bundle
              is the space of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coinvariants"} homotopy coinvariants
              of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/infinity-action"} infinity-action
              (see there for more).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/dependent+product"} dependent product
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twisted cohomology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/space+of+states+%28in+geometric+quantization%29"} space of states (in geometric quantization)
          %h2#references References
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/topological+vector+space"} topological vector space
            on spaces of smooth sections is discussed in
          %ul
            %li#BrunettiFredenhagenRibeiro12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Romeo+Brunetti"}> Romeo Brunetti
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Klaus+Fredenhagen"} Klaus Fredenhagen
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pedro+Ribeiro"} Pedro Ribeiro
                %em Algebraic Structure of Classical Field Theory I: Kinematics and Linearized Dynamics for Real Scalar Fields
                (
                %a{:href => "https://arxiv.org/abs/1209.2148"}> arXiv:1209.2148
                ,
                = succeed ")" do
                  %a{:href => "http://inspirehep.net/record/1185123/"} spire
            %li#Baer14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christian+B%C3%A4r"}> Christian Bär
                ,
                = succeed "," do
                  %em Green-hyperbolic operators on globally hyperbolic spacetimes
                = succeed "," do
                  %a{:href => "http://dx.doi.org/10.1007/s00220-014-2097-7"} doi
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1310.0738"} arXiv:1310.0738
