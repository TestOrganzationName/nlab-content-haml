                %annotation{:encoding => "application/x-tex"} (\chi,\psi)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo :
                  %mi 𝔟
