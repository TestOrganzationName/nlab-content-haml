                %mrow
                  %mi ψ
                  %mo :
                  %mi 𝔟
                  %mo →
                  %mi Der
                  %mo{:stretchy => "false"} (
                  %mi 𝔨
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \psi:\mathfrak{b}\to Der(\mathfrak{k})
            are
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                        %mtd
                          %mi χ
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi b
                            %mn 1
                          %mo ,
                          %msub
                            %mi b
                            %mn 2
                          %mo{:stretchy => "false"} ]
                          %mo ∧
                          %msub
                            %mi b
                            %mn 3
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi χ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi b
                            %mn 1
                          %mo ∧
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi b
                            %mn 2
                          %mo ,
                          %msub
                            %mi b
                            %mn 3
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mi χ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi b
                            %mn 2
                          %mo ∧
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi b
                            %mn 1
                          %mo ,
                          %msub
                            %mi b
                            %mn 3
                          %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                          %mi ψ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi b
                            %mn 3
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi χ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi b
                            %mn 1
                          %mo ∧
                          %msub
                            %mi b
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi ψ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi b
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi χ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi b
                            %mn 2
                          %mo ∧
                          %msub
                            %mi b
                            %mn 3
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mi ψ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi b
                            %mn 2
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi χ
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi b
                            %mn 1
                          %mo ∧
                          %msub
                            %mi b
                            %mn 3
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  \&amp; \chi([b_1,b_2]\wedge b_3)-\chi(b_1\wedge [b_2,b_3])+\chi(b_2\wedge[b_1,b_3])
                  \\\&amp; = \psi(b_3)(\chi(b_1\wedge b_2))-\psi(b_1)(\chi(b_2\wedge b_3))+\psi(b_2)(\chi(b_1\wedge b_3))
                  \\end{aligned}
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mn 1
                  %mo ,
                  %msub
                    %mi b
                    %mn 2
                  %mo ,
                  %msub
                    %mi b
                    %mn 3
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} b_1,b_2,b_3\in B
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi ad
                    %mi 𝔨
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ∧
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  [\psi(a),\psi(b)]=\psi([a,b])+ad_{\mathfrak{k}}(\chi(a\wedge b))
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ,
                  %mi b
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} a,b\in B
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ad
                    %mi 𝔨
                  %mo :
                  %mi 𝔨
                  %mo →
                  %mi Int
                  %mo{:stretchy => "false"} (
                  %mi 𝔨
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ad_{\mathfrak{k}}:\mathfrak{k}\to Int(\mathfrak{k})
            is the canonical map into inner automorphisms
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo ,
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k\mapsto [k,]
          %h2#schreiers_theory_for_lie_algebras Schreier’s theory for Lie algebras
          %p
            %a.existingWikiWord{:href => "/nlab/show/Otto+Schreier"} Otto Schreier
            (1926) and Eilenberg-Mac Lane (late 1940-s) developed a theory of nonabelian
            %a.existingWikiWord{:href => "/nlab/show/group+extension"} extensions of abstract groups
            leading to the low dimensional nonabelian group cohomology. For Lie algebras, the theory can be developed in the same manner. One tries to classify
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+extension"} extensions of Lie algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mi 𝔨
                  %mover
                    %mo →
                    %mi i
                  %mi 𝔤
                  %mover
                    %mo →
                    %mi p
                  %mi 𝔟
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  0\to \mathfrak{k}
                  \\overset{i}\to \mathfrak{g}\overset{p}\to\mathfrak{b}\to 0
          %p
            %strong Theorem.
            To every Lie algebra extension as above, and a choice of
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo :
                  %mi 𝔟
                  %mo →
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \sigma:\mathfrak{b}\to\mathfrak{g}
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔟
                %annotation{:encoding => "application/x-tex"} \mathfrak{b}
            with values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔨
                %annotation{:encoding => "application/x-tex"} \mathfrak{k}
            as follows: set
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 1
                  %mo ∧
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi b
                    %mn 1
                  %mo ,
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} [
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \chi(b_1\wedge b_2):=-\sigma([b_1,b_2])+[\sigma(b_1),\sigma(b_2)]
          %p
            and define
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi 𝔤
                  %mo →
                  %mi Der
                  %mo{:stretchy => "false"} (
                  %mi 𝔨
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi:\mathfrak{g}\to Der(\mathfrak{k})
            by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi g
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \phi(g)(k):=[g,k]
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %mo =
                    %mi ϕ
                    %mo ∘
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \psi:=\phi\circ\sigma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\chi,\psi)
            is a nonabelian 2-cocycle on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔟
                %annotation{:encoding => "application/x-tex"} \mathfrak{b}
            with values in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔨
                  %annotation{:encoding => "application/x-tex"} \mathfrak{k}
          %p
            %strong Theorem. (cocycle crossed product of Lie algebras)
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi χ
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\chi,\psi)
            be a factor system as above. Then define a
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "-vector" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔟
                  %mo ⊕
                  %mi 𝔨
                %annotation{:encoding => "application/x-tex"} \mathfrak{b}\oplus\mathfrak{k}
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 1
                  %mo ,
                  %msub
                    %mi k
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 2
                  %mo ,
                  %msub
                    %mi k
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi b
                    %mn 1
                  %mo ,
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi χ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 1
                  %mo ∧
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi k
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo −
                  %mi ψ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi b
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi k
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi k
                    %mn 1
                  %mo ,
                  %msub
                    %mi k
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  [(b_1,k_1),(b_2,k_2)] = ([b_1,b_2],\chi(b_1\wedge b_2)+\psi(b_1)(k_2)-\psi(b_2)(k_1)+[k_1,k_2])
          %p Then
          %p
            (i)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo ,
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [,]
            is a antisymmetric and satisfies the Jacobi identity, i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi 𝔟
                  %mo ⊕
                  %mi 𝔨
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo ,
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}:=(\mathfrak{b}\oplus\mathfrak{k},[,])
            is an
            = succeed "-Lie" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            (ii)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} k\mapsto (0,k)
            defines an embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi 𝔨
                  %mo →
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} i:\mathfrak{k}\to\mathfrak{g}
            of Lie algebras and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi b
                %annotation{:encoding => "application/x-tex"} (b,k)\mapsto b
            is a surjective homomorphism of Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi 𝔤
                  %mo →
                  %mi 𝔟
                %annotation{:encoding => "application/x-tex"} p:\mathfrak{g}\to\mathfrak{b}
            whose kernel is the Lie ideal
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mo ⊕
                    %mi 𝔨
                    %mo ⊂
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} i(\mathfrak{k})=0\oplus\mathfrak{k}\subset\mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mi 𝔨
                  %mover
                    %mo →
                    %mi i
                  %mi 𝔤
                  %mover
                    %mo →
                    %mi p
                  %mi 𝔟
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0\to\mathfrak{k}\overset{i}\to\mathfrak{g}\overset{p}\to\mathfrak{b}\to 0
            is an extension of the base Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔟
                %annotation{:encoding => "application/x-tex"} \mathfrak{b}
            by the kernel Lie algebra
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔨
                  %annotation{:encoding => "application/x-tex"} \mathfrak{k}
          %p
            (iii) If the 2-cocycle is obtained from a Lie algebra extension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %mi 𝔨
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                  %msub
                    %mi 𝔤
                    %mn 0
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi p
                        %mn 0
                  %mi 𝔟
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0\to \mathfrak{k}\overset{i_0}\to \mathfrak{g}_0\overset{p_0}\to\mathfrak{b}\to 0
            and an arbitrary
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \sigma_0
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} p_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi can
                    %mi σ
                  %mo :
                  %msub
                    %mi 𝔤
                    %mn 0
                  %mo →
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} can_\sigma:\mathfrak{g}_0\to\mathfrak{g}
            given by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g\mapsto (p(g),-\sigma(p(g))+g)
            is well-defined and a Lie algebra isomorphism such that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi can
                      %mi σ
                    %mo ∘
                    %msub
                      %mi i
                      %mn 0
                    %mo =
                    %mi i
                  %annotation{:encoding => "application/x-tex"} can_\sigma\circ i_0=i
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 0
                    %mo =
                    %mi p
                    %mo ∘
                    %msub
                      %mi can
                      %mi σ
                  %annotation{:encoding => "application/x-tex"} p_0=p\circ can_\sigma
          %p In addition to the problem of extensions, nonabelian 2-cocycles appear in a more general problem of liftings of Lie algebras.
          %h2#AbstractDefinition Abstract definition
          %p
            We claim that the above definition of nonabelian Lie algebra cocycles may be understood naturally in terms of the general notion of
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            and in particular is the image of the story of
            %a.existingWikiWord{:href => "/nlab/show/nonabelian+group+cohomology"} nonabelian group cohomology
            under Lie differentiation:
          .standout
            %p The following observation is not in the literature.
          .un_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Lie
                  %annotation{:encoding => "application/x-tex"} \infty Lie
              be the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E-algebra"} L-∞-algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ,
                    %mi 𝔨
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}, \mathfrak{k}
              be
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              with coefficients in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔨
                  %annotation{:encoding => "application/x-tex"} \mathfrak{k}
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi H
                      %mi nonab
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo ,
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi π
                      %mn 0
                    %mn ∞
                    %mi Lie
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo ,
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    H^2_{nonab}(\mathfrak{g}, \mathfrak{k})
                    \\simeq
                    \\pi_0 \infty Lie(\mathfrak{g}, Der(\mathfrak{k}))
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Der(\mathfrak{k})
              is the
              %a.existingWikiWord{:href => "/nlab/show/strict+Lie+2-algebra"} strict Lie 2-algebra
              of derivations on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔨
                    %annotation{:encoding => "application/x-tex"} \mathfrak{k}
            %p More in detail:
            %ul
              %li
                %p
                  nonabelian degree 2 Lie algebra cocycles
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo ,
                        %mi ξ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\psi,\xi)
                  are in natural bijections with morphisms
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                        %mo →
                        %mi Der
                        %mo{:stretchy => "false"} (
                        %mi 𝔨
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\mathfrak{g} \to Der(\mathfrak{k})
              %li
                %p
                  coboundaries
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                  between cocycles
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ψ
                          %mn 1
                        %mo ,
                        %msub
                          %mi ξ
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\psi_1,\xi_1)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ψ
                          %mn 2
                        %mo ,
                        %msub
                          %mi ξ
                          %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\psi_2,\xi_2)
                  correspond to homotopies between these
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                                %mo ↗
                                %msup
                                  %mo ↘
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi ψ
                                        %mn 1
                                      %mo ,
                                      %msub
                                        %mi χ
                                        %mn 1
                                      %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mi 𝔤
                              %mtd
                                %msup
                                  %mo ⇓
                                  %mi η
                              %mtd
                                %mi Der
                                %mo{:stretchy => "false"} (
                                %mi 𝔨
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                              %mtd
                                %mo ↘
                                %msup
                                  %mo ↗
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mo{:stretchy => "false"} (
                                      %msub
                                        %mi ψ
                                        %mn 2
                                      %mo ,
                                      %msub
                                        %mi χ
                                        %mn 2
                                      %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp; \nearrow\searrow^{\mathrlap{(\psi_1,\chi_1)}}
                        \\\
                        \\mathfrak{g}
                        \&amp;\Downarrow^{\eta}&amp;
                        Der(\mathfrak{k})
                        \\\
                        \&amp; \searrow\nearrow^{\mathrlap{(\psi_2,\chi_2)}}
                        }
                %p
                  and this correspondence is precise if we take the homotopy to be induced from the “standard
                  = succeed "\u201D," do
                    %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
          .proof
            %h6#proof Proof
            %p
              Checking this is a straightforward matter of unwinding the definitions of morphisms of
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            %p Which is what we indicate.
            %p
              We model
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Lie
                  %annotation{:encoding => "application/x-tex"} \infty Lie
              as usual a subcategory of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree dga
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              by its
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CE
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            %p
              For the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              itself with Lie bracket
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo :
                    %mi 𝔤
                    %mo ∧
                    %mi 𝔤
                    %mo →
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} [-,-] : \mathfrak{g} \wedge \mathfrak{g} \to \mathfrak{g}
              this is the
              %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree dga
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) =
                    (\wedge^\bullet \mathfrak{g}^* , \; d = [-,-]^* )
                    \\,,
            %p
              where the differential is on generators the dual of the Lie bracket,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mo :
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo →
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ∧
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} [-,-]^* : \mathfrak{g}^* \to \mathfrak{g}^* \wedge \mathfrak{g}^*
              extended as a graded derivation to all of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo •
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^*
            %p
              For any
              %a.existingWikiWord{:href => "/nlab/show/strict+Lie+2-algebra"} strict Lie 2-algebra
              coming from a
              %a.existingWikiWord{:href => "/nlab/show/differential+crossed+module"} differential crossed module
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔥
                      %mn 1
                    %mover
                      %mo →
                      %mi δ
                    %msub
                      %mi 𝔥
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathfrak{h}_1 \stackrel{\delta}{\to} \mathfrak{h}_1)
              with action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %msub
                      %mi 𝔥
                      %mn 1
                    %mo →
                    %mi der
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔥
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho : \mathfrak{h}_1 \to der(\mathfrak{h}_2)
              – that we think of in the following as equivalently a linear map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %msub
                      %mi 𝔥
                      %mn 1
                    %mo ⊗
                    %msub
                      %mi 𝔥
                      %mn 2
                    %mo →
                    %msub
                      %mi 𝔥
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \rho : \mathfrak{h}_1 \otimes \mathfrak{h}_2 \to \mathfrak{h}_2
              – the
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔥
                      %mn 2
                    %mover
                      %mo →
                      %mi δ
                    %msub
                      %mi 𝔥
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo (
                      %msup
                        %mo ∧
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi 𝔥
                        %mn 1
                        %mo *
                      %mo ⊕
                      %msubsup
                        %mi 𝔥
                        %mn 2
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi d
                        %mi δ
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{h}_2 \stackrel{\delta}{\to} \mathfrak{h}_1)
                    \=
                    \\left(
                    \\wedge^\bullet ( \mathfrak{h}_1^* \oplus \mathfrak{h}_2^* )
                    ,
                    \\;
                    d_{\delta}
                    \\right)
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔥
                      %mn 1
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{h}_1^*
              in degree 1 and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔥
                      %mn 2
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mathfrak{h}_2^*
              in degree 2, and with the differential given on degree 1 generators by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi δ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msubsup
                          %mi 𝔥
                          %mn 1
                          %mo *
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %msub
                          %mi 𝔥
                          %mn 1
                      %mo *
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msup
                      %mi δ
                      %mo *
                    %mo :
                    %msubsup
                      %mi 𝔥
                      %mn 1
                      %mo *
                    %mo →
                    %msubsup
                      %mi 𝔥
                      %mn 1
                      %mo *
                    %mo ∧
                    %msubsup
                      %mi 𝔥
                      %mn 1
                      %mo *
                    %mo ⊕
                    %msubsup
                      %mi 𝔥
                      %mn 2
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    d_\delta |_{\mathfrak{h}_1^*} = [-,-]_{\mathfrak{h}_1}^* + \delta^*
                    \: \mathfrak{h}_1^* \to
                    \\mathfrak{h}_1^* \wedge \mathfrak{h}_1^*
                    \\oplus
                    \\mathfrak{h}_2^*
            %p and on degree 2 generators by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi δ
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msubsup
                          %mi 𝔥
                          %mn 2
                          %mo *
                    %mo =
                    %msup
                      %mi ρ
                      %mo *
                    %mo :
                    %msubsup
                      %mi 𝔥
                      %mn 2
                      %mo *
                    %mo →
                    %msubsup
                      %mi 𝔥
                      %mn 1
                      %mo *
                    %mo ⊗
                    %msubsup
                      %mi 𝔥
                      %mn 2
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    d_\delta |_{\mathfrak{h}_2^*} = \rho^*
                    \:
                    \\mathfrak{h}_2^* \to \mathfrak{h}_1^* \otimes \mathfrak{h}_2^*
                    \\,.
            %p
              The case of the derivation
              %a.existingWikiWord{:href => "/nlab/show/strict+Lie+2-algebra"} strict Lie 2-algebra
              of a Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔨
                  %annotation{:encoding => "application/x-tex"} \mathfrak{k}
              is the special case of this for
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mover
                      %mo →
                      %mi ad
                    %mi der
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Der(\mathfrak{k}) = (\mathfrak{k} \stackrel{ad}{\to} der(\mathfrak{k}))
                    \\,.
            %p Now a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi χ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝔤
                    %mo →
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (\psi, \chi) : \mathfrak{g} \to Der(\mathfrak{k})
            %p
              of
              = succeed "-Lie" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ψ
                      %mo *
                    %mo ,
                    %msup
                      %mi χ
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) \leftarrow CE(Der(\mathfrak{k})) :
                    (\psi^*, \chi^*)
            %p
              of
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            %p
              Morphisms of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
            %p So the underlying maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ←
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi 𝔥
                      %mn 1
                      %mo *
                    %mo ⊕
                    %msubsup
                      %mi 𝔥
                      %mn 2
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ψ
                      %mo *
                    %mo ,
                    %msup
                      %mi χ
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^\bullet \mathfrak{g}^*
                    \\leftarrow
                    \\wedge^\bullet (\mathfrak{h}_1^* \oplus \mathfrak{h}_2^*)
                    \:
                    (\psi^* , \chi^*)
            %p come from linear maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ←
                    %msubsup
                      %mi 𝔥
                      %mn 1
                      %mo *
                    %mo :
                    %msup
                      %mi ψ
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{g}^* \leftarrow \mathfrak{h}_1^* : \psi^*
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ∧
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ←
                    %msubsup
                      %mi 𝔥
                      %mn 2
                      %mo *
                    %mo :
                    %msup
                      %mi χ
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{g}^* \wedge \mathfrak{g}^* \leftarrow \mathfrak{h}_2^* : \chi^*
            %p i.e. form linear maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo :
                    %mi 𝔤
                    %mo →
                    %mi der
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\psi : \mathfrak{g} \to der(\mathfrak{k})
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo :
                    %mi 𝔤
                    %mo ∧
                    %mi 𝔤
                    %mo →
                    %mi 𝔨
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi : \mathfrak{g} \wedge \mathfrak{g} \to \mathfrak{k}
                    \\,.
            %p This is the underlying data of the nonabelian 2-cocycle. Now the respect for the differentials on the Chevalley-Eilenberg algebras will give the cocycle condition:
            %p
              let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi 𝔥
                      %mn 2
                      %mo *
                    %mo ⊂
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔥
                      %mn 1
                    %mo →
                    %msub
                      %mi 𝔥
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \mathfrak{h}_2^* \subset CE(\mathfrak{h}_1 \to \mathfrak{h}_2)
              be any degree 2 element, then respect for the differential implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo{:stretchy => "false"} (
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ψ
                                  %mo *
                                %mo ,
                                %msup
                                  %mi χ
                                  %mo *
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi ρ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mrow
                                %msub
                                  %mi d
                                  %mi 𝔤
                                %mo =
                                %mo{:stretchy => "false"} [
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo ,
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %msup
                                  %mo{:stretchy => "false"} ]
                                  %mo *
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi d
                                    %mi δ
                        %mtr
                          %mtd
                            %mi ω
                            %mo{:stretchy => "false"} (
                            %mi ξ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ψ
                                  %mo *
                                %mo ,
                                %msup
                                  %mi χ
                                  %mo *
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi ω
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\omega(\chi([-,-],-))
                    \=
                    \\omega(\rho(\psi(-)(\chi(-,-))))
                    \&amp;\stackrel{(\psi^*, \chi^*)}{\leftarrow}&amp; \omega(\rho(-)(-)))
                    \\\
                    \\uparrow^{d_\mathfrak{g} = [-,-]^*} &amp;&amp; \uparrow^{\mathrlap{d_{\delta}}}
                    \\\
                    \\omega(\xi(-,-))
                    \&amp;\stackrel{(\psi^*, \chi^*)}{\leftarrow}&amp;
                    \\omega
                    }
                    \\,.
            %p
              Since this has to hold for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ω
                    %annotation{:encoding => "application/x-tex"} \omega
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\chi([-,-],-) = \rho(\psi(-)\chi(-,-))
            %p (both sides here regarded as elements of a graded Grassmann algebra as indicated above, so with all antisymmetrization on the arguments implicit).
            %p
              Similarly, for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %msubsup
                      %mi 𝔥
                      %mn 1
                      %mo *
                    %mo ⊂
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝔥
                      %mn 1
                    %mo →
                    %msub
                      %mi 𝔥
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda \in \mathfrak{h}_1^* \subset CE(\mathfrak{h}_1 \to \mathfrak{h}_2)
              be any degree 1 element, then respect for the differential implies that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi λ
                            %mo{:stretchy => "false"} (
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi λ
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ]
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi λ
                            %mo{:stretchy => "false"} (
                            %mi ad
                            %mo{:stretchy => "false"} (
                            %mi χ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                          %mtd
                            %mi λ
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mrow
                                %msub
                                  %mi 𝔥
                                  %mn 1
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mi λ
                            %mo{:stretchy => "false"} (
                            %mi ad
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↑
                        %mtr
                          %mtd
                            %mi λ
                            %mo{:stretchy => "false"} (
                            %mi ψ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mrow
                                %mo{:stretchy => "false"} (
                                %msup
                                  %mi ψ
                                  %mo *
                                %mo ,
                                %msup
                                  %mi χ
                                  %mo *
                                %mo{:stretchy => "false"} )
                          %mtd
                            %mi λ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\lambda(\psi([-,-]))
                    \=
                    \\lambda([\psi(-), \psi(-)])
                    +
                    \\lambda(ad(\chi(-,-)))
                    \&amp;\stackrel{}{\leftarrow}&amp;  \lambda([-,-]_{\mathfrak{h}_1}) + \lambda(ad(-))
                    \\\
                    \\uparrow &amp;&amp; \uparrow
                    \\\
                    \\lambda(\psi(-))
                    \&amp;\stackrel{(\psi^* , \chi^*)}{\leftarrow}&amp;
                    \\lambda
                    }
                    \\,.
            %p
              Again, this has to hold for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi λ
                    %annotation{:encoding => "application/x-tex"} \lambda
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                    %mo +
                    %mi ad
                    %mo{:stretchy => "false"} (
                    %mi ξ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\psi([-,-])
                    \=
                    [\psi(-),\psi(-)]
                    +
                    ad(\xi(-,-))
                    \\,.
            %p
              This shows that morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo →
                    %mi Der
                    %mo{:stretchy => "false"} (
                    %mi 𝔨
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \to Der(\mathfrak{k})
              are in bijection to the nonabelian cocycles.
            %p
              It remains to show that the homotopies map to coboundaries. For that we may take in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                    %mi Lie
                  %annotation{:encoding => "application/x-tex"} \infty Lie
              the standard
              %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
              of some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              to be
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g})\otimes CE(\mathfrak{g})
                    \\leftarrow
                    C^\bullet(\Delta^1)\otimes CE(\mathfrak{g})
                    \\leftarrow
                    CE(\mathfrak{g})
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C^\bullet(\Delta^1)
              is the
              %a.existingWikiWord{:href => "/nlab/show/semifree+dga"} semifree dga
              of cochains on the cellular 1-
              %a.existingWikiWord{:href => "/nlab/show/simplex"}> simplex
              , i.e.
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo ∧
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} ⟨
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} ⟩
                    %mo ⊕
                    %mo{:stretchy => "false"} ⟨
                    %mi c
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi d
                    %mi a
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi d
                    %mi b
                    %mo =
                    %mi d
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C^\bullet(\Delta^1) =
                    (\wedge^\bullet (\langle a,b \rangle \oplus \langle c \rangle)
                    , d a = - d b = d c
                    )
                    \\,,
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ,
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a,b
              generators in degree 0 and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              in degree 1. Using this, write out the data implied by a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              that is a
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↖
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msubsup
                                    %mi ψ
                                    %mn 1
                                    %mo *
                                  %mo ,
                                  %msubsup
                                    %mi χ
                                    %mn 1
                                    %mo *
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mi C
                              %mo •
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Δ
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ←
                              %mi η
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi Der
                            %mo{:stretchy => "false"} (
                            %mi 𝔨
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↑
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msubsup
                                    %mi ψ
                                    %mn 2
                                    %mo *
                                  %mo ,
                                  %msubsup
                                    %mi χ
                                    %mn 2
                                    %mo *
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi CE
                            %mo{:stretchy => "false"} (
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    CE(\mathfrak{g})
                    \\\
                    \\downarrow &amp; \nwarrow^{\mathrlap{(\psi_1^*, \chi_1^*)}}
                    \\\
                    C^\bullet(\Delta^1)\otimes CE(\mathfrak{g})
                    \&amp;\stackrel{\eta}{\leftarrow}&amp;
                    CE(Der(\mathfrak{k}))
                    \\\
                    \\uparrow &amp; \swarrow_{\mathrlap{(\psi_2^*, \chi_2^*)}}
                    \\\
                    CE(\mathfrak{g})
                    }
            %p along the above lines.
            %p
              Notice that in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi dgAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"} dgAlg^{op}
              every object is cofibrant, so that this is indeed a left homotopy. See
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Lie+algebra+cohomology"} ∞-Lie algebra cohomology
              for more on this.
          %h2#references References
          %p On original source is
          %ul
            %li
              G. Hochschild,
              = succeed "," do
                %em Lie algebra kernels and cohomology
              = succeed "," do
                %strong 76
          %p
            The notation/exposition in sections 2 and 3 is adapted from personal notes of Z. Škoda (1997). A systematic theory has been many times partly rediscovered from soon after the Eilenberg–Mac Lane work on group extension, among first by Hochschild and then by many others till nowdays. Here is a recent online account emphasising parallels with
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dmitri+Alekseevsky"}> Dmitri Alekseevsky
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Peter+Michor"} Peter Michor
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/math/0005042"} math.DG/0005042
          %p
            A more conceptual picture is in a work of
            %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"} Danny Stevenson
            which extends also to its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+2-algebra"} Lie 2-algebra
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Danny+Stevenson"}> Danny Stevenson
              , Lie 2-algebras and the geometry of gerbes, Unni Namboodiri Lectures 2006
              %a{:href => "http://math.ucr.edu/home/baez/namboodiri/stevenson_maclane.pdf"} slides
          %p There is also
          %ul
            %li
              N. Inassaridze, E. Khmaladze, M. Ladra,
              %em Non-abelian cohomology and extensions of Lie algebras
              Journal of Lie Theory
              %strong 18
              (2008) 413–432 (
              %a{:href => "http://www.rmi.acnet.ge/~khmal/PAPERS/LieTheory2008.pdf"}> pdf
              )
