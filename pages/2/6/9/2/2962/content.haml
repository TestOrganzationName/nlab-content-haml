                  %mi 𝔟
                  %mo →
                  %mi 𝔨
                %annotation{:encoding => "application/x-tex"} \chi: \mathfrak{b}\wedge \mathfrak{b}\to\mathfrak{k}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
