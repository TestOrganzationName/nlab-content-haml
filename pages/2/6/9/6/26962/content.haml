          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#constructions"} Constructions
              %ul
                %li
                  %a{:href => "#for_real_numbers"} For real numbers
                %li
                  %a{:href => "#mixtures_of_probability_measures"} Mixtures of probability measures
                %li
                  %a{:href => "#in_terms_of_monad_algebras"} In terms of monad algebras
              %li
                %a{:href => "#examples"} Examples
              %li
                %a{:href => "#see_also"} See also
          %h2#idea Idea
          %p
            %em Convex mixtures
            are to
            %a.existingWikiWord{:href => "/nlab/show/convex+combinations"} convex combinations
            as
            %a.existingWikiWord{:href => "/nlab/show/integrals"} integrals
            are to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sums"} sums
          %p
            In other words, convex mixtures are given by
            %a.existingWikiWord{:href => "/nlab/show/integration"} integrating
            a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            with respect to a
            %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            whose total normalization is one (hence, a
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
          %p
            The concept is used in
            %a.existingWikiWord{:href => "/nlab/show/analysis"} analysis
            and
            %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
            as a generalization of midpoints, as well as in
            %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
            to take
            %a.existingWikiWord{:href => "/nlab/show/expectation+values"} expectation values
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/random+variables"} random variables
          %p
            In terms of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
            and other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/probability+monads"} probability monads
          %h2#constructions Constructions
          %h3#for_real_numbers For real numbers
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/measurable+space"} measurable space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:lspace => "verythinmathspace"} :
                  %mi X
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} f \colon X\to\mathbb{R}
            as an
            %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed collection
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
            = succeed "," do
              %em average
            = succeed ":" do
              %em midpoint
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo +
                      %mi …
                      %mo +
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\frac{f(x_1)+\dots+f(x_n)}{n}
          %p
            More generally, given a
            %a.existingWikiWord{:href => "/nlab/show/probability+distribution"} probability distribution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "," do
              %em weighted average
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{x\in X} f(x)\,p(x) .
          %p
            The resulting number is a convex combination of the numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)
          %p
            Convex mixtures generalize this to the infinite case: if the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/measurable+function"} measurable
            %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/integral"} integral
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_X f(x) \,p(d x) \,.
          %p
            One can view the resulting value as a mixture, analogous to a convex combination, of the points
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f(x)
            %a.existingWikiWord{:href => "/nlab/show/pushforward+measure"} pushforward measure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mo *
                  %mi p
                %annotation{:encoding => "application/x-tex"} f_*p
            on
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
          %p
            In the language of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
            %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
            of the
            %a.existingWikiWord{:href => "/nlab/show/random+variable"} random variable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            on the
            %a.existingWikiWord{:href => "/nlab/show/probability+space"} probability space
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,p)
          %p
            A very similar construction can be given by replacing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            with a generic Banach space, using
            = succeed "." do
              %span.newWikiWord
                Bochner integrals
                %a{:href => "/nlab/new/Bochner+integrals"} ?
          %h3#mixtures_of_probability_measures Mixtures of probability measures
          %p
            Given measurable spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi Y
                %annotation{:encoding => "application/x-tex"} P Y
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            %a.existingWikiWord{:href => "/nlab/show/sigma-algebra"} sigma-algebra
            (see
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi P
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f:X\to P Y
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/Markov+kernel"} Markov kernel
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} k_f:X\to Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            (seen as a kernel from the one-point space): for every measurable subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ∫
                    %mi X
                  %msub
                    %mi k
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} |
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_X f(x)(B)\,p(d x) \;=\; \int_X k_f(B|x)\,p(d x) .
          %p
            In other words, mixtures of measures are equivalently compositions in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Stoch"} category of Markov kernels
          %p
            In particular, taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to be the identity (i.e. nonparametrically), a mixture of probability measures on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is given by integrating a
            %em probability measure over probability measures
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ∈
                    %mi P
                    %mi P
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \pi\in P P Y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mo ∫
                    %mi PY
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi π
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  B \;\mapsto\; \int_{PY} q(B) \, \pi(d q) .
          %p
            This is equivalently the multiplication of the
            %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
            and of most
            %a.existingWikiWord{:href => "/nlab/show/probability+monads"} probability monads
            (more below).
          %h3#in_terms_of_monad_algebras In terms of monad algebras
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
            is the most general
            %a.existingWikiWord{:href => "/nlab/show/monad+of+probability+measures"} monad of probability measures
            on the category of measurable spaces.
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+a+monad"} Algebras
            of the Giry monad, therefore, can be interpreted exactly as spaces where one can form arbitrary convex mixtures. This is analogous to how
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/convex+spaces"} convex spaces
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/distribution+monad"} distribution monad
          %p
            In particular, mixtures of probability measures can be seen as instances of the multiplication of the Giry monad, or more generally, as compositions of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Markov+kernels"} Markov kernels
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+morphisms"} Kleisli morphisms
            of the Giry monad, and hence their composition is defined in terms of the monad multiplication.
          %p
            Similar notions of mixture can be given using other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/probability+monads"} probability monads
            %em convex
            mixture, one needs a form of normalization.
          %h2#examples Examples
          %ul
            %li
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
              %a.existingWikiWord{:href => "/nlab/show/random+variable"} random variable
              is a convex mixture.
            %li
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/physics"} physics
              %span.newWikiWord
                center of mass
                %a{:href => "/nlab/new/center+of+mass"} ?
              of non-discrete bodies.
            %li
              The multiplication of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/probability+monads"} probability monads
            %li
              The
              %a.existingWikiWord{:href => "/nlab/show/ergodic+decomposition+theorem"} ergodic decomposition theorem
              says that in some cases, every
              %a.existingWikiWord{:href => "/nlab/show/invariant+measure"} invariant measure
              is a convex mixture of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ergodic+measure"} ergodic ones
            %li
              A special case of the above is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/de+Finetti%27s+theorem"} de Finetti's theorem
              %a.existingWikiWord{:href => "/nlab/show/exchangeability"} exchangeable probability measure
              is a convex mixture of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/iid+measures"} iid ones
          %h2#see_also See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Lebesgue+integral"}> Lebesgue integral
              ,
              = succeed "," do
                %span.newWikiWord
                  Bochner integral
                  %a{:href => "/nlab/new/Bochner+integral"} ?
              %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
            %li
              %a.existingWikiWord{:href => "/nlab/show/convex+space"}> convex space
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/convex+combination"} convex combination
              %a.existingWikiWord{:href => "/nlab/show/mean"} mean
            %li
              %a.existingWikiWord{:href => "/nlab/show/probability+monad"}> probability monad
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
              %a.existingWikiWord{:href => "/nlab/show/distribution+monad"} distribution monad
            %li
              %a.existingWikiWord{:href => "/nlab/show/ergodic+decomposition+theorem"}> ergodic decomposition theorem
              ,
              %a.existingWikiWord{:href => "/nlab/show/de+Finetti+theorem"} de Finetti theorem
          .property
            category:
            = succeed "," do
              %a.category_link{:href => "/nlab/all_pages/probability"} probability
            = succeed "," do
              %a.category_link{:href => "/nlab/all_pages/analysis"} analysis
            %a.category_link{:href => "/nlab/all_pages/functional+analysis"} functional analysis
