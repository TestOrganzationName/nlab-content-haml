                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X)
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/finite+object"} finite object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            would correspond to a
            = succeed "-set," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Y
                      %mstyle{:scriptlevel => "0"}
                        %mo ′
                  %annotation{:encoding => "application/x-tex"} Y^\prime
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is a finite covering of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            then the homomorphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(X)
            to the finite group of transformations of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            factors through the profinite completion of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X)
          %h3#remarks Remarks
          %p
            This idea of using covering spaces or their analogue in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔼
                %annotation{:encoding => "application/x-tex"} \mathbb{E}
            raises several important points:
          %ul
            %li
              these are
              = succeed "." do
                %em
                  homotopy theoretic results, but no paths (no
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sheaf+and+topos+theory"} sheaf theory
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/pro-representable+functor"} pro-representable functor
              %a.existingWikiWord{:href => "/nlab/show/shape+theory"} shape theory
              and
          %p
            %a.existingWikiWord{:href => "/nlab/show/strong+shape+theory"}> strong shape theory
            , although not by using exactly Grothendieck’s fundamental group,
          %p
            nor using sheaf theory. (See below for more on this connection and such sources as
            = succeed "," do
              %em Lisica and Mardešić
            = succeed "," do
              %em Edwards and Hastings
            = succeed "," do
              %em Cordier and Porter
            %em Mardešić and Segal
            for more information on Shape and Strong Shape).
          %ul
            %li
              As no paths are used, these methods can also be applied to ‘non-spaces’, e.g.
              %a.existingWikiWord{:href => "/nlab/show/locale"} locales
              and possibly to their non-commutative analogues,
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quantale"} quantales
          %p
            For instance, classically one could consider a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            and an algebraic closure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            and then choose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            to be a category of étale algebras over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi 𝔼
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi Gal
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} /
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(\mathbb{E}) \cong Gal(K/k)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "es." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            is seen as being part of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Galois+theory"} Galois theory
            = succeed "." do
              %em vice versa
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Pursuing+Stacks"} Letter to L. Breen
            %em NOT to Quillen as is sometimes claimed.
            More on that at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group+of+an+%E2%88%9E-stack"} homotopy group of an ∞-stack
          %ul
            %li
              This underlines the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X)
              classifies
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo &gt;
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} i \gt 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_i(X)
              does not seem to classify anything other than maps from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"} S^i
              into
              = succeed "!" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .query
            %p
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike
              \: From a higher-categorical perspective, the reason
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_1(X)
              classifies covering spaces is that covering spaces are fibrations with discrete fibers, and so are classified by functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \Pi_\infty(X)\to Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
              is a 1-category, any such functors factors through the 1-categorical reflection of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn ∞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_\infty(X)
              %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_1(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_i(X)
              but
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mi i
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_i(X)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              whose fibers are homotopy
              = succeed "-types." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (i-1)
            %p
              Does a topos have a fundamental groupoid? A fundamental
              = succeed "-groupoid?" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              = succeed "-groupoid?" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            %p
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim
              \: I am not an expert on the ‘not enough points’ case, but do know that a long time ago people generalised to a fundamental groupoid. (I think it was a preprint from Montpellier in which I saw this, but I know it was also taken up by others in (?) the 1970s. More recently Marta Bunge and Eduardo Dubuc have published on this and look at at Eduardo’s:
            %p http://arxiv.org/abs/0706.1771
            %p
              %a.existingWikiWord{:href => "/nlab/show/David+Corfield"}> David
              \: The paper
              %a{:href => "http://lanl.arxiv.org/abs/math/0407507"} Higher Monodromy
              shows what the fundamental 2-groupoid classifies.
            %p
              %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"}> Mike
              \: Just looking at the abstract of
              = succeed "," do
                %em Higher Monodromy
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} i=2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gpd
                  %annotation{:encoding => "application/x-tex"} Gpd
              of 1-types. They don’t seem to treat the topos case, though.
          %h2#higher_categorical_generalization Higher categorical generalization
          %p
            One may consider the
            %a.existingWikiWord{:href => "/nlab/show/vertical+categorification"} vertical categorification
            of this situation from the notion of
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            to that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group+of+an+%E2%88%9E-stack"}> homotopy group of an ∞-stack
              \.
          %h2#references References
          %p The above was taken from an article:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"}> Tim Porter
              , Abstract Homotopy Theory, the interaction of category theory and homotopy theory , Cubo Matematica Educacional, 5, (2003), 115–165.
          %p
            Fundamental groups of toposes are already on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/SGA4"} SGA4
            %em
              Exercice 2.7.5. and its relations with
              %a.existingWikiWord{:href => "/nlab/show/etale+topos"} etale topos
              are on Expose VIII Proposition 2.1
          %p
            The general construction of the first geometric homotopy group of objects in a
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            is in section 8.4 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Johnstone"}> Peter Johnstone
              ,
              %em Topos theory
          %p A discussion of the fundamental groupoid for a general topos is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"}> Eduardo Dubuc
              ,
              %em The fundamental progroupoid of a general topos
              (
              %a{:href => "http://arxiv.org/abs/0706.1771"}> arXiv
              )
          %p A discussion for “locally simply connected” toposes is in
          %ul#BarrDiaconescu
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Barr"}> Michael Barr
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Radu+Diaconescu"} Radu Diaconescu
              %em On locally simply connected toposes and their fundamental groups
              (
              %a{:href => "http://www.numdam.org/item?id=CTGDC_1981__22_3_301_0"}> NUMDAM
              )
          %p Other references are
          %ul
            %li
              %p D.A. Edwards and H. M. Hastings, (1976), Čech and Steenrod homotopy theories with applications to geometric topology, Lecture Notes in Maths. 542, Springer-Verlag.
            %li
              %p J.T. Lisica and S. Mardešić, Coherent prohomotopy and strong shape theory, Glasnik Mat. 19(39) (1984) 335-399.
            %li
              %p
                J.-M. Cordier and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"} Tim Porter
            %li
              %p
                S. Mardešić and J. Segal, (1982)
                = succeed "," do
                  %em Shape Theory
            %li
              %p
                S. Mardešić,
                = succeed "," do
                  %em Strong Shape and Homology
            %li
              %p On categorical Galois theory
              %ul
                %li F. Borceux and G. Janelidze, (2001), Galois Theories, Cambridge Studies in Advanced Mathematics, 72, Cambridge University Press.
            %li
              %p and for a more traditional approach:
              %ul
                %li A. Douady and R. Douady, (1977) Algébre et Théories Galoisiennes, Cedic / F. Nathan.
            %li
              %p
                For the link with
                %a.existingWikiWord{:href => "/nlab/show/locale"} locale
                theory
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/Andre+Joyal"} Andre Joyal
                  and M. Tierney, (1984), An extension of the Galois theory of Grothendieck, Mem. Amer. Math. Soc. 309.
            %li
              %p When we have no paths, in internal case, one may find the article of Pataraia useful (beware many typoses, but the article is dense with content):
              %ul
                %li
                  D. Pataraia, Internal categories in the left exact cosimplicial category. Georgian Math. J. 4 (1997), No. 6, 533-556. (
                  %a{:href => "http://www.emis.de/journals/GMJ/vol4/contents.htm"}> link
                  )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Luis+Javier+Hern%C3%A1ndez-Paricio"}> Luis Javier Hernández-Paricio
                ,
                = succeed "(" do
                  %em Fundamental pro-groupoids and covering projections
                = succeed ")" do
                  %a{:href => "http://matwbn.icm.edu.pl/ksiazki/fm/fm156/fm15611.pdf"} pdf
        .revisedby
