                    %annotation{:encoding => "application/x-tex"} ]
          %p Review:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Steve+Y.+Oudot"}> Steve Y. Oudot
              ,
              = succeed "," do
                %em Persistence Theory: From Quiver Representations to Data Analysis
              %strong 209
              AMS (2015)
