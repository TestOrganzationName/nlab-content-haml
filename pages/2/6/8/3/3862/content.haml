          %h2#DeterminantLineBundles Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            be two
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mi dim
                  %mi V
                  %mo =
                  %mi dim
                  %mi W
                %annotation{:encoding => "application/x-tex"} n = dim V = dim W
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mi V
                  %mo →
                  %mi W
                %annotation{:encoding => "application/x-tex"}
                  T : V \to W
          %p
            a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear map
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mi n
                  %mi V
                %annotation{:encoding => "application/x-tex"} \wedge^n V
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mi n
                  %mi W
                %annotation{:encoding => "application/x-tex"} \wedge^n W
            for the
            %em top exterior power
            of these vector spaces, the skew-symmetrized
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/tensor+algebra"} tensor power
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            %a.existingWikiWord{:href => "/nlab/show/lines"} lines
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            induces a linear map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mi T
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mo ∧
                    %mi n
                  %mi V
                  %mo →
                  %msup
                    %mo ∧
                    %mi n
                  %mi W
                %annotation{:encoding => "application/x-tex"}
                  det T \colon \wedge^n V\to \wedge^n W
          %p
            between these lines. This is the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %mi W
                %annotation{:encoding => "application/x-tex"} V = W
            (being of the same finite dimension, both are necessarily
            %a.existingWikiWord{:href => "/nlab/show/isomorphic"} isomorphic
            but not necessarily canonically so) then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mi T
                  %mo :
                  %msup
                    %mo ∧
                    %mi n
                  %mi V
                  %mo →
                  %msup
                    %mo ∧
                    %mi n
                  %mi V
                %annotation{:encoding => "application/x-tex"} det T : \wedge^n V \to \wedge^n V
            is a linear
            %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphism
            of a 1-dimensional vector space and, by the equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi End
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mi n
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi k
                %annotation{:encoding => "application/x-tex"}
                  End(\wedge^n V) \simeq k
          %p
            of such endomorphisms with the
            %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mi T
                  %mo ∈
                  %mi k
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  det T \in k
                  \\,.
          %p
            This is the standard meaning of the
            %strong determinant
            of a linear endomorphism.
          %p Notice that the determinant construction:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mover
                    %mo →
                    %mi T
                  %mi W
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %msup
                    %mo ∧
                    %mi n
                  %mi V
                  %mover
                    %mo →
                    %mrow
                      %mi det
                      %mi T
                  %msup
                    %mo ∧
                    %mi n
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  det : (V \stackrel{T}{\to} W) \mapsto (\wedge^n V \stackrel{det T}{\to} \wedge^n W)
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            from the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Vect"} Vect
            to itself
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo :
                  %mi Vect
                  %mo →
                  %mi Vect
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  det : Vect \to Vect
                  \\,.
          %p#AnySuchFunctor
            Any such functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Vect
                  %mo →
                  %mi Vect
                %annotation{:encoding => "application/x-tex"} F \colon Vect \to Vect
            with certain continuity assumptions induces an endo-functor on the category of
            %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi VectBund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} VectBund(X)
            over any
            %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            (see
            = succeed ")." do
              %a{:href => "topological+vector+bundle#FiberwiseOperations"} there
          %p
            Concretely, if a vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E \to X
            is given by a
            %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech cocycle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi C
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi g
                                %mrow
                                  %mi i
                                  %mi j
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi GL
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mi Vect
                      %mtr
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mo ≃
                      %mtr
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  C(U_i) &amp;\stackrel{(g_{i j})}{\to}&amp; \mathbf{B} GL(n) &amp;\to&amp; Vect
                  \\\
                  \\downarrow^{\mathrlap{\simeq}}
                  \\\
                  X
                  }
          %p
            with respect to an
            %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi U
                    %mi i
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{U_i \to X\}
            (see
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
            and
            %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
            for details), hence by transition functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi g
                    %mrow
                      %mi i
                      %mi j
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo ,
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (g_{i j} \in C(U_i \cap U_j, GL(n)))
          %p
            with values in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mo :
                  %mi VectBund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi VectBund
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} det : VectBund(X) \to VectBund(X)
            is the bundle with transition functions the determinants of these transition functions
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi det
                  %msub
                    %mi g
                    %mrow
                      %mi i
                      %mi j
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo ∩
                  %msub
                    %mi U
                    %mi j
                  %mo ,
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi k
                    %mo ×
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  (det g_{i j} \in C(U_i \cap U_j, GL(1) \simeq k^\times))
                  \\,.
          %p
            This are the transition functions for the bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ∧
                    %mo •
                  %mi E
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \wedge^\bullet E \to X
            which is fiberwise the top exterior power of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \to X
            %strong
              %a.existingWikiWord{:href => "/nlab/show/determinant+line"} determinant line
              bundle
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %h2#properties Properties
          .un_prop
            %h6#proposition Proposition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo :
                    %mi X
                    %mover
                      %mo ←
                      %mo ≃
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E : X \stackrel{\simeq}{\leftarrow} C(U_i) \stackrel{g_{i j}}{\to} \mathbf{B} U(n)
            %p
              be a
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              (to which is canonically
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              a rank-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundle"} complex vector bundle
              %a.existingWikiWord{:href => "/nlab/show/characteristic+class"} characteristic class
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi det
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %msup
                      %mi H
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [det E] \in H^2(X, \mathbb{Z})
            %p
              of its determinant
              %a.existingWikiWord{:href => "/nlab/show/circle+bundle"} circle bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mi E
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mover
                      %mo ←
                      %mo ≃
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mi det
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    det E
                    \\colon
                    X \stackrel{\simeq}{\leftarrow} C(U_i) \stackrel{det g_{i j}}{\to} \mathbf{B} U(1)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi det
                    %mi E
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %msub
                      %mi c
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [det E] = c_1(E)
                    \\,.
            %p
              Moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g_{i j}, A_i)
              is the data of a
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \nabla)
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi det
                    %msub
                      %mi g
                      %mrow
                        %mi i
                        %mi j
                    %mo ,
                    %mi tr
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (det g_{i j}, tr A_i)
              (where we take the
              %a.existingWikiWord{:href => "/nlab/show/trace"} trace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi tr
                    %mo :
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi 𝔲
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} tr : \mathfrak{u}(n) \to \mathfrak{u}(1)
              on the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              of the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} line bundle with connection
              that refines the first Chern-class to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
              %a.existingWikiWord{:href => "/nlab/show/Chern-Weil+homomorphism"} Chern-Weil homomorphism
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mo ∇
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E, \nabla)
              induced by the canonical unary
              %a.existingWikiWord{:href => "/nlab/show/invariant+polynomial"} invariant polynomial
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔲
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{u}(n)
          %p
            An explicit version of this statement is for instance in (
            %a{:href => "#GriffithsHarris"}> GriffithsHarris, p. 414
            ).
          %p
            One can now look at operators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo :
                  %mi E
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} T:E\to F
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ,
                  %mi F
                %annotation{:encoding => "application/x-tex"} E,F
            are vector bundles of rank
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and the induced operators
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mi n
                  %mi T
                  %mo :
                  %msup
                    %mi Λ
                    %mi n
                  %mi E
                  %mo →
                  %msup
                    %mi Λ
                    %mi n
                  %mi F
                %annotation{:encoding => "application/x-tex"} \Lambda^n T : \Lambda^n E\to \Lambda^n F
            which can be considered as elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi det
                    %mi T
                    %mo ∈
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Λ
                      %mi n
                    %mi E
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo ⊗
                    %msup
                      %mi Λ
                      %mi n
                    %mi F
                  %annotation{:encoding => "application/x-tex"} det T\in (\Lambda^n E)^*\otimes\Lambda^n F
          %p
            Even more important is the case of when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is replaced by an appropriate
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/moduli+space+of+connections"} moduli space of connections
          %h2#examples Examples
          %h3#quillens_determinant_line_bundle Quillen’s determinant line bundle
          %p
            There is a specific version called
            %strong Quillen’s determinant line bundle
            which is certain
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            over the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space+of+complex+structures"} moduli space of complex structures
            on a fixed smooth vector bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            over a fixed
            %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mi d
                  %mover
                    %mi z
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∂
                    %mi z
                  %mo +
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D = d\bar{z}(\partial_z+\alpha(z))
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha(z)
            is a smooth matrix valued function. The set of such operators is an affine space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            whose underlying vector space is the space of
            = succeed "-End-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (0,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mrow
                        %mn 0
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi End
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^{0,1} (End M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi D
                  %mo =
                  %mi λ
                  %mo{:stretchy => "false"} (
                  %mi Ker
                  %mi D
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo ⊗
                  %mi λ
                  %mo{:stretchy => "false"} (
                  %mi Coker
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{L}_D = \lambda(Ker D)^*\otimes \lambda(Coker D)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            is taking the top exterior power. Now one has a family
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mi D
                %annotation{:encoding => "application/x-tex"} \mathcal{L}_D
            depending on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            = succeed "." do
              %strong determinant line bundle
          %p
            If we had a trivialization of the Quillen’s determinant line bundle, then we could identify every section with a holomorphic function on the base space, hence a holomorphic rule giving a number to a Cauchy-Riemann operator. For this one restricts first to the component consisting of the operators with the zero Fredholm index. Next, one considers the corresponding
            %a.existingWikiWord{:href => "/nlab/show/Laplace+operator"} Laplace operator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mo *
                  %mi D
                %annotation{:encoding => "application/x-tex"} D^* D
            and its
            %a.existingWikiWord{:href => "/nlab/show/functional+determinant"} functional determinant
            related to the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/zeta+function+of+an+elliptic+differential+operator"} zeta function of an elliptic differential operator
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/analytic+torsion"} analytic torsion
          %h3#determinant_bundle_on_the_grassmannian Determinant bundle on the Grassmannian
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gr
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Gr_k(V)
            be the
            %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
            of
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ⊂
                  %mi V
                %annotation{:encoding => "application/x-tex"} W\subset V
            be a point in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gr
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Gr_k(V)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi W
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Lambda^k(W)
            its top exterior power; it is a fiber of the bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Det
                %annotation{:encoding => "application/x-tex"} Det
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Gr
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gr_k(V)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Det
                %annotation{:encoding => "application/x-tex"} Det
            has no non-zero holomorphic global sections. Consider its dual
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Det
                    %mo *
                %annotation{:encoding => "application/x-tex"} Det^*
            with fiber
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Λ
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi W
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo *
                %annotation{:encoding => "application/x-tex"} \Lambda^k(W)^*
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Γ
                      %mi hol
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Det
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msup
                      %mi Λ
                      %mi k
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi V
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma_{hol}(Det^*) \cong \Lambda^k(V^*)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %msub
                    %mi V
                    %mo +
                  %mo ⊕
                  %msub
                    %mi V
                    %mo −
                %annotation{:encoding => "application/x-tex"} V= V_+\oplus V_-
            is a separable Hilbert space equipped with a polarization, see chapter 7 and especially 7.7 in the Pressley-Segal book listed below.
          %h3#comparing_quillens_and_segals_determinant_line_bundles Comparing Quillen’s and Segal’s determinant line bundles
          %p
            The determinant line bundle of Quillen is in fact related to a variant of Segal’s determinant bundle on the “semiinfinite” Grassmannian. Namely one considers instead
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gr
                    %mi cpt
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Gr_{cpt}(H)
            which is the set (space eventually) of closed supspaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ⊂
                  %mi H
                %annotation{:encoding => "application/x-tex"} W\subset H
            where the projection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo →
                  %msub
                    %mi H
                    %mo +
                %annotation{:encoding => "application/x-tex"} W\to H_+
            is
            %a.existingWikiWord{:href => "/nlab/show/Fredholm+operator"} Fredholm
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo →
                  %msub
                    %mi H
                    %mo −
                %annotation{:encoding => "application/x-tex"} W\to H_-
            is
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/compact+operator"} compact
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Det
                %annotation{:encoding => "application/x-tex"} Det
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Gr
                      %mi cpt
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gr_{cpt}(H)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gr
                    %mi cpt
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Gr_{cpt}(H)
            is not a homogeneous space. Now there is a span of maps with contractible fibers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Gr
                    %mi cpt
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo ←
                  %mi ℬ
                  %mo →
                  %mi Fred
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mo +
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Gr_{cpt}(H)\leftarrow \mathcal{B}\to Fred(H_+).
          %p
            The Quillen’s determinant line bundle is defined in general on the whole
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fred
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi H
                    %mo +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fred(H_+)
            and its pullback to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℬ
                %annotation{:encoding => "application/x-tex"} \mathcal{B}
            is isomorphic to the pullback of the determinant bundle on
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Gr
                      %mi cpt
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gr_{cpt}(H)
          %h3#pfaffian_line_bundle Pfaffian line bundle
          %p
            In dimensîon
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 8
                  %mi k
                  %mo +
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 8k+2
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            the determinant line bundle has a canonîcal square root line bundle, the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Pfaffian+line+bundle"} Pfaffian line bundle
          %h3#from_fermionic_path_integrals From fermionic path integrals
          %p
            See at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/fermionic+path+integral"} fermionic path integral
          %h3#relation_to_theta_function Relation to theta function
          %p
            the determinant of the Dirac operator is, up to choice of isomorphism, the
            = succeed "-section" do
              %a.existingWikiWord{:href => "/nlab/show/theta+function"} theta function
            = succeed ")." do
              %a{:href => "#Freed87"} Freed 87, pages 30-31
          %h3#relation_to_vacuum_energy_partition_function Relation to vacuum energy, partition function
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/vacuum+energy"} vacuum energy
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/density+bundle"} density bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pseudoscalar"} pseudoscalar
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/theta+function"} theta function
          %div
            %p
              The following table lists classes of examples of
              %a.existingWikiWord{:href => "/nlab/show/square+roots"} square roots
              of
              %a.existingWikiWord{:href => "/nlab/show/line+bundles"} line bundles
            %table
              %thead
                %tr
                  %th line bundle
                  %th square root
                  %th choice corresponds to
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/canonical+bundle"} canonical bundle
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Theta+characteristic"} Theta characteristic
                  %td{:style => "text-align: left;"}
                    over
                    %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
                    and
                    %a.existingWikiWord{:href => "/nlab/show/Hermitian+manifold"} Hermitian manifold
                    (e.g.
                    %a.existingWikiWord{:href => "/nlab/show/K%C3%A4hler+manifold"}> Kähler manifold
                    ):
                    %a.existingWikiWord{:href => "/nlab/show/spin+structure"} spin structure
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/density+bundle"} density bundle
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/half-density+bundle"} half-density bundle
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/canonical+bundle"} canonical bundle
                    of
                    %a.existingWikiWord{:href => "/nlab/show/Lagrangian+submanifold"} Lagrangian submanifold
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/metalinear+structure"} metalinear structure
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/metaplectic+correction"} metaplectic correction
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/determinant+line+bundle"} determinant line bundle
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Pfaffian+line+bundle"} Pfaffian line bundle
                  %td{:style => "text-align: left;"}
                %tr
                  %td{:style => "text-align: left;"}
                    quadratic
                    %a.existingWikiWord{:href => "/nlab/show/secondary+intersection+pairing"} secondary intersection pairing
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/partition+function"} partition function
                    of
                    %a.existingWikiWord{:href => "/nlab/show/self-dual+higher+gauge+theory"} self-dual higher gauge theory
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/integral+Wu+structure"} integral Wu structure
          %h2#references References
          %p The relation between determinant line bundles and the first Chern class is stated explicitly for instance on p. 414 of
          %ul#GriffithsHarris
            %li
              Griffiths and Harris,
              %em Principles of algebraic geometry
          %p Literature on determinant line bundles of infinite-dimensional bundles includes the following:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Quillen"}> D.G. Quillen
                ,
                = succeed "," do
                  %em Determinants of Cauchy-Riemann operators over a Riemann surface
                %strong 19
                (1985), 37-41, (
