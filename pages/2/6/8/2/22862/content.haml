                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mover
                              %mi W
                              %mo ¯
                            %mi G
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi undrlng
                            %mo ∘
                            %mi DK
                            %mo{:stretchy => "false"} (
