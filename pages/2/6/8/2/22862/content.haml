                        %mi G
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %mi sSet
                      %annotation{:encoding => "application/x-tex"} [S,\overline{W}G] \in sSet
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/cofibrant+objects"} cofibrant objects
                  (like every object in the
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            %p
              the chain of hom-isomorphisms of
              %a.existingWikiWord{:href => "/nlab/show/derived+adjunctions"} derived adjunctions
              in
              %a.maruku-eqref{:href => "#eq:TransgressionDecomposed"} (12)
              is covered (through the
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              by
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              that defines the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category of a model category
              according to
              = succeed ")" do
                %a{:href => "homotopy+category+of+a+model+category#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"} this Lemma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is the
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              over its
              %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} elements
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi k
                    %mo{:stretchy => "false"} ]
                    %mo ∈
                    %mi el
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta[k] \in el(X)
              (
              %a{:href => "simplicial+set#SimplicialSetIsColimitOfItsSimplices"}> this Prop.
              ) and that the
              = succeed "-theoretic" do
                %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
              %a.existingWikiWord{:href => "/nlab/show/hom+functors"} hom functors
              turn this colimit, in their first argument, into a
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              (
              %a{:href => "hom-functor+preserves+limits#HomFunctorPreservesLimits"}> this Prop.
              ), we find that the composite in
              %a.maruku-eqref{:href => "#eq:TransgressionDecomposed"} (12)
