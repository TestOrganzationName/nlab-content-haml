          %h3#products_of_simplices Products of simplices
          %p
            Some basic facts about
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/products+of+simplicial+sets"} products of simplicial sets
          %p
          #NonDegenerateSimplicesInProductOfSimplices.num_prop
            %h6 Proposition
            %p
              %strong
                (non-degenerate
                = succeed "-simplices" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p+q)
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi p
                        %mo{:stretchy => "false"} ]
                        %mo ×
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi q
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[p] \times \Delta[q]
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ,
                    %mi q
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p,q \,\in\, \mathbb{N}
              the non-degenerate simplices in the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianProductOfSimplicialSetsIsComponentwise"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta[p] \times \Delta[q]
            %p
              of standard
              %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
              in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              correspond, under the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
            #eq:GenericSimplexInProductOfSimplices.maruku-equation
              %span.maruku-eq-number (8)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo +
                    %mi q
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi σ
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi p
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta[p+q]
                    \\xrightarrow{\;\; \sigma \;\;}
                    \\Delta[p] \times \Delta[q]
            %p which satisfy the following equivalent conditions:
            %ul
              %li
                %p
                  as
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  of
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/posets"} posets
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/strictly+monotone"} strictly monotone
              %li
                %p
                  as
                  %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo +
                        %mi q
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (p+q)
                  %a.existingWikiWord{:href => "/nlab/show/elements"} elements
                  they are
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi p
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (p,q)
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/shuffles"} shuffles
              %li
                %p
                  as
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                  of
                  %a.existingWikiWord{:href => "/nlab/show/finitely+generated+object"} finitely generated
                  %a.existingWikiWord{:href => "/nlab/show/categories"} categories
                  they take generating morphisms to generating morphisms;
            %p
