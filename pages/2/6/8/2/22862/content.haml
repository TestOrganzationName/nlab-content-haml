                    {el\big([S,\overline{W}G]\big)}
                    }
                    }
                    {\longleftarrow}
                    }{\lim}
                    \\,
                    sSet
                    \\Big(
                    \\Delta[k],
                    \\,
                    \\big[S, undrlng \circ DK(A[n]) \big]
                    \\Big)
                    \\\
                    \&amp; \;\simeq\;
                    \\underset{
                    \\underset{
                    \\mathclap{
                    {\Delta[k] \in}
                    \\atop
                    {el\big([S,\overline{W}G]\big)}
                    }
                    }
                    {\longleftarrow}
                    }{\lim}
                    \\,
                    Ch_+
                    \\Big(
                    N_\bullet \circ \mathbb{Z}
                    \\big(
                    S \times \Delta[k]
                    \\big),
                    \\,
                    A[n]
                    \\Big)
                    \\\
                    \&amp; \;\xrightarrow{EZ_S}\;
                    \\underset{
                    \\underset{
                    \\mathclap{
                    {\Delta[k] \in}
                    \\atop
                    {el\big([S,\overline{W}G]\big)}
                    }
                    }
                    {\longleftarrow}
                    }{\lim}
                    \\,
                    Ch_+
                    \\Big(
                    N_\bullet \circ \mathbb{Z}(S)
                    \\,\otimes\,
                    N_\bullet \circ \mathbb{Z}(\Delta[k]),
                    \\,
                    A[n]
                    \\Big)
                    \\\
                    \&amp; \;\simeq\;
                    \\underset{
                    \\underset{
                    \\mathclap{
                    {\Delta[k] \in}
                    \\atop
                    {el\big([S,\overline{W}G]\big)}
                    }
                    }
                    {\longleftarrow}
                    }{\lim}
                    \\,
                    sSet
                    \\Big(
                    \\Delta[k],
                    \\,
                    undrlng \circ DK
                    \\big(
                    A[n] \oplus A[n-1]
                    \\big)
                    \\Big)
                    \\\
                    \&amp; \;\simeq\;
                    sSet
                    \\Big(
                    \\underset{
                    \\underset{
                    \\mathclap{
                    {\Delta[k] \in}
                    \\atop
                    {el\big([S,\overline{W}G]\big)}
                    }
                    }
                    {\longrightarrow}
                    }{\lim}
                    \\Delta[k],
                    \\,
                    undrlng \circ DK
                    \\big(
                    A[n] \oplus A[n-1]
                    \\big)
                    \\Big)
                    \\\
                    \&amp; \;\simeq\;
                    sSet
                    \\Big(
                    [S,\overline{W}G],
                    \\,
                    undrlng \circ DK
                    \\big(
                    A[n] \oplus A[n-1]
                    \\big)
                    \\Big)
                    \\,.
                    \\end{aligned}
            %p
              This is manifestly the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo ,
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} sSet\big( [S,\overline{W}G], - \big)
              of the correct morphism
              %a.maruku-eqref{:href => "#eq:ComparisonMorphismFromFreeLoopSpaceViaEilenbergZilber"} (11)
              from Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#FreeLoopSpaceOfEMSpaceIdentifiedViaEilenbergZilber"}
          %h2#references References
          %p The transgression map is alluded to in
          %ul
            %li#DijkgraafWitten90
              %a.existingWikiWord{:href => "/nlab/show/Robbert+Dijkgraaf"}> Robbert Dijkgraaf
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Edward+Witten"} Edward Witten
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/files/DW.pdf", :title => "Topological Gauge Theories and Group Cohomology"} Topological Gauge Theories and Group Cohomology
              %strong 129
              (1990) 393 (
              %a{:href => "https://projecteuclid.org/journals/communications-in-mathematical-physics/volume-129/issue-2/Topological-gauge-theories-and-group-cohomology/cmp/1104180750.full"}> euclid:cmp/1104180750
              )
          %p
            An indication of a proof, implicitly using ingredients of the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+map"} Eilenberg-Zilber map
            (re-discovered under the name “Parmesan map”):
          %ul
            %li#Willerton08
              %a.existingWikiWord{:href => "/nlab/show/Simon+Willerton"}> Simon Willerton
              , Section 1 of:
              = succeed "," do
                %em The twisted Drinfeld double of a finite group via gerbes and finite groupoids
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/math/0503266"} arXiv:math/0503266
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.2140/agt.2008.8.1419"} doi:10.2140/agt.2008.8.1419
          %p
            The transgression formula itself (without derivation) is also considered, in a context of
            %a.existingWikiWord{:href => "/nlab/show/twisted+equivariant+K-theory"} twisted
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orbifold+K-theory"} orbifold K-theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alejandro+Adem"}> Alejandro Adem
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yongbin+Ruan"} Yongbin Ruan
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Bin+Zhang"} Bin Zhang
                = succeed "," do
                  %em A Stringy Product on Twisted Orbifold K-theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0605534"} arXiv:math/0605534
                = succeed ")" do
                  %a{:href => "www.morfismos.cinvestav.mx/Portals/morfismos/SiteDocs/Articulos/Volumen11/No2/Zhang/arz.pdf"} Morfismos pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Tu"}> Jean-Louis Tu
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ping+Xu"} Ping Xu
                = succeed "," do
                  %em The ring structure for equivariant twisted K-theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0604160"} arXiv:math/0604160
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1515/CRELLE.2009.077"} doi:10.1515/CRELLE.2009.077
          %p
            and specifically in the context of equivariant
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Tate+K-theory"} Tate K-theory
          %ul
            %li#Dove19
              %a.existingWikiWord{:href => "/nlab/show/Thomas+Dove"}> Thomas Dove
              ,
              %em Twisted Equivariant Tate K-Theory
              (
              %a{:href => "https://arxiv.org/abs/1912.02374"}> arXiv:1912.02374
              )
          %p
            Generalization to Real
            = succeed "-equivariant" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twists
            of
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/KR-theory"} KR-theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Behrang+Noohi"}> Behrang Noohi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Matthew+B.+Young"} Matthew B. Young
              = succeed "," do
                %em Twisted loop transgression and higher Jandl gerbes over finite groupoids
              %strong 22
              (2022) 1663-1712 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1910.01422"}> arXiv:1910.01422
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.2140/agt.2022.22.1663"} doi:10.2140/agt.2022.22.1663
          %p
            The above discussion and proof that transgression is essentially the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            out of the circle into the cocycle-as-a-functor is taken from:
          %ul
            %li#SatiSchreiber22
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Cyclification+of+Orbifolds"} Cyclification of Orbifolds
              %strong 405
              67 (2024) &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/s00220-023-04929-w"}> doi:10.1007/s00220-023-04929-w
              ,
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/2212.13836"} arXiv:2212.13836
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/schreiber/show/cyclic+loop+spaces+2022"} talk
          %p following earlier observations in:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Zoran+%C5%A0koda"} Zoran Škoda
              %a{:href => "https://arxiv.org/pdf/1004.2472.pdf#page=37"} §8.2
              \&amp;
              %a{:href => "https://arxiv.org/pdf/1004.2472.pdf#page=47"} §9.6.2
              of:
              %em Categorified symmetries
