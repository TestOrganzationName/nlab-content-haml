                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p
          #OrdinaryCohomology.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"}> ordinary cohomology
                )
              %br/
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi sSet
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \in Ho(sSet)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Ab
                  %annotation{:encoding => "application/x-tex"} A \,\in\, Ab
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
