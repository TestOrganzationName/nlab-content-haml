                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    H^n_{grp}(G;\, A)
                    \\;\simeq\;
                    H^n(B G;\, A)
                    \\,.
            %p
          %p
          .proof
            %h6 Proof
            %p
            %p
              By the
              %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphisms
