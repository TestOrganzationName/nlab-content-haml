          %p
            This Prop.
            = succeed "," do
              %a.maruku-ref{:href => "#GroupCohomologyIsOrdinaryCohomologyOfClassifyingSpace"}
            %a.maruku-ref{:href => "#DeloopingGroupoidAndSimplicialClassifyingSpaceOfFiniteGroup"}
            justifies the following definition:
          %p
          #GroupoidCohomology.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/groupoid+cohomology"}> groupoid cohomology
                )
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
