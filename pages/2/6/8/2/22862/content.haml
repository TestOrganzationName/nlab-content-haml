                      %mi undrlg
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    B^n A \,=\, K(A,n)
                    \\,\coloneqq\,
                    underlg \circ DK(A[n])
                    \\;\;\;
                    \\in
                    \\;
                    sAb
                    \\xrightarrow{ Loc_{\mathrm{W}}}
                    Ho(sAb)
                    \\xrightarrow{undrlg}
                    Ho(sSet)
            %p
              for (the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              of) the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              – here constructed as the
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              of the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
              which is the image under the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+construction"} Dold-Kan construction
              of the
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
              that is concentrated on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
