          %p
          #GroupCohomologyIsOrdinaryCohomologyOfClassifyingSpace.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
                is
                %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} G \,\in\,
              %a.existingWikiWord{:href => "/nlab/show/Groups"} Groups
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} A \,\in\,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/AbelianGroups"} AbelianGroups
              %a.existingWikiWord{:href => "/nlab/show/group+cohomology"} group cohomology
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GroupCohomology"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
