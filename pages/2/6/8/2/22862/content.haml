            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/group+cohomology"}> group cohomology
                )
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
