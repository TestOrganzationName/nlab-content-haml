                  %div
                    %p
                      %a{:href => "/nlab/edit/infinity-Chern-Simons+theory+-+contents"} Edit this sidebar
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %ul
                %li
                  %a{:href => "#general"} General
                %li
                  %a{:href => "#ProblemsInTheNonPerturbativeRegime"} Problems in the non-perturbative regime
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
