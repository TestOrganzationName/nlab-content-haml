          %h2#idea Idea
          %p
            Day’s reflection theorem &amp;lbrack;
            %a{:href => "#Day72"}> Day (1972)
            \&amp;rbrack; gives conditions under which a
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            of a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+closed+category"} symmetric monoidal closed category
            is closed under
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/internal+homs"} internal homs
          %p
            One memorable consequence of the theorem is that the subcategory is closed under
            %a.existingWikiWord{:href => "/nlab/show/internal+homs"} internal homs
            if the
            %a.existingWikiWord{:href => "/nlab/show/reflector"} reflector
            is symmetric
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal
          %h2#statement_and_proof Statement and Proof
          %p
          .num_theorem
            %h6 Theorem
            %p
              (Day) Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %mi C
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} R: C \to D
              be a
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              with
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:lspace => "verythinmathspace"} :
                      %mi D
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} L \colon D \to C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              with tensor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                  %annotation{:encoding => "application/x-tex"} \otimes
              and internal hom
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-, -]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ,
                    %mi d
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} d, d'
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                        %mo{:stretchy => "false"} [
                        %mi d
                        %mo ,
                        %mi R
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} [
                        %mi d
                        %mo ,
                        %mi R
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi R
                        %mi L
                        %mo{:stretchy => "false"} [
                        %mi d
                        %mo ,
                        %mi R
                        %mi c
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} u[d, R c] \colon [d, R c] \to R L[d, R c]
                  is an isomorphism;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi u
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:lspace => "verythinmathspace"} :
                        %mo{:stretchy => "false"} [
                        %mi R
                        %mi L
                        %mi d
                        %mo ,
                        %mi R
                        %mi c
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mo{:stretchy => "false"} [
                        %mi d
                        %mo ,
                        %mi R
                        %mi c
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [u, 1] \colon [R L d, R c] \to [d, R c]
                  is an isomorphism;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo ⊗
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ⊗
                        %mi d
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mi L
                        %mi d
                        %mo ⊗
                        %mi d
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L(u \otimes 1) \colon L(d \otimes d') \to L(R L d \otimes d')
                  is an isomorphism;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo ⊗
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ⊗
                        %mi d
                        %mo ′
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi R
                        %mi L
                        %mi d
                        %mo ⊗
                        %mi R
                        %mi L
                        %mi d
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L(u \otimes u) \colon L(d \otimes d') \to L(R L d \otimes R L d')
                  is an isomorphism.
            %p
          %p Some remarks before the proof:
          %ul
            %li
              %p
                (a) Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                is fully faithful, the
                %a.existingWikiWord{:href => "/nlab/show/monad"} monad
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mi L
                    %annotation{:encoding => "application/x-tex"} R L
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idempotent
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo :
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} R: C \to D
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                are unique when they exist. This makes algebra structure on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} property
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ≅
                      %mi R
                      %mi c
                    %annotation{:encoding => "application/x-tex"} d \cong R c
                for some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
