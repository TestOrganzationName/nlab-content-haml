          .num_cor
            %h6 Corollary
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                  %annotation{:encoding => "application/x-tex"} L
              is a strong
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric monoidal functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [d, c]
              is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          %p
          .proof
            %h6 Proof
            %p
              Full faithfulness of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is equivalent to the
