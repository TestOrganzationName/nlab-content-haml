                = succeed "&rbrack;" do
                  %a{:href => "http://math.uchicago.edu/~may/PAPERS/40.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henning+Hauschild"}> Henning Hauschild
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Stefan+Waner"} Stefan Waner
                = succeed "," do
