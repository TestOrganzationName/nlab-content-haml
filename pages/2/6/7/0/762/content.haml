          %h2#definition Definition
          %p
            A
            %strong filtered topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo *
                %annotation{:encoding => "application/x-tex"} X_*
            is a
            %a.existingWikiWord{:href => "/nlab/show/filtered+object"} filtered object
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
          %ol
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %msub
                        %mi X
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} X=X_\infty
            %li
              %p
                equipped with a
                %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                of
                %a.existingWikiWord{:href => "/nlab/show/subspaces"} subspaces
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo *
                      %mo :
                      %mo =
                      %mspace{:width => "1em"}
                      %msub
                        %mi X
                        %mn 0
                      %mo ⊆
                      %msub
                        %mi X
                        %mn 1
                      %mo ⊆
                      %mi ⋯
                      %mo ⊆
                      %msub
                        %mi X
                        %mi n
                      %mo ⊆
                      %mi ⋯
                      %mo ⊆
                      %msub
                        %mi X
                        %mn ∞
                      %mo .
                    %annotation{:encoding => "application/x-tex"} X_*:= \quad X_0 \subseteq X_1 \subseteq \cdots \subseteq X_n \subseteq \cdots \subseteq X_\infty.
          %p
            A filtered space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo *
                %annotation{:encoding => "application/x-tex"} X_*
            is called a
            %strong
              %a.existingWikiWord{:href => "/nlab/show/connected+filtered+space"} connected filtered space
            if it satisfies the following condition:
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                %annotation{:encoding => "application/x-tex"} (\phi)_0
            \: The function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 0
                  %msub
                    %mi X
                    %mn 0
                  %mo →
                  %msub
                    %mi π
                    %mn 0
                  %msub
                    %mi X
                    %mi r
                %annotation{:encoding => "application/x-tex"} \pi_0X_0  \to \pi_0 X_r
            induced by inclusion is surjective for all
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r \geq 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i \geq 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ϕ
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi π
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi r
                  %mo ,
                  %msub
                    %mi X
                    %mi i
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} (\phi_i): \pi_i(X_r,X_i,v)=0
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo &gt;
                  %mi i
                %annotation{:encoding => "application/x-tex"} r \gt i
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msub
                      %mi X
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} v \in X_0
          %p There are two other forms of this condition which are useful under different circumstances.
          %h2#examples Examples
          %ol
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with its filtration by
