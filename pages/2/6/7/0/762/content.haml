                      %annotation{:encoding => "application/x-tex"} X^n
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/configuration+space+of+points"} configuration space of points
                is filtered by number of points.
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/free+construction"} free
                %a.existingWikiWord{:href => "/nlab/show/topological+monoid"} topological monoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi X
                    %annotation{:encoding => "application/x-tex"} F X
                on a
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                filtered by the length of words. Given a
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,x)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi X
                    %annotation{:encoding => "application/x-tex"} F X
                and identifying
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                with the identity of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mi X
                      %annotation{:encoding => "application/x-tex"} F X
                %em
                  %a.existingWikiWord{:href => "/nlab/show/James+construction"} James construction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J(X,x)
                (
                %a{:href => "#James55"}> James 55
                ).
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/James+construction"} James construction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} J(X,x)
                may be constructed
                %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy-theoretically
                (
                %a{:href => "#Brunerie13"}> Brunerie 13
                ,
                = succeed ")." do
                  %a{:href => "#Brunerie17"} Brunerie 17
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                a finite
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+complex"} simplicial complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,A)
                a pair of spaces, its
                %em polyhedral product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi K
                    %annotation{:encoding => "application/x-tex"} (X,A)^K
                is defined as the union
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                        %mrow
                          %mi σ
                          %mo ∈
                          %mi S
                          %mo{:stretchy => "false"} (
                          %mi K
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi σ
                    %annotation{:encoding => "application/x-tex"} \bigcup_{\sigma\in S(K)}(X,A)^\sigma
                as a subspace of the Cartesian product
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi X
                          %mrow
                            %mi V
                            %mo{:stretchy => "false"} (
                            %mi K
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X^{V(K)}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi σ
                      %mo ∈
                      %mi S
