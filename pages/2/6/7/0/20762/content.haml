                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V X
            = succeed "," do
              %strong A-topology
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Alexandrov+topology"} Alexandrov topology
            = succeed "." do
              %a{:href => "#bogachev2"} Bogachev, section 8.10.iv
            %a.existingWikiWord{:href => "/nlab/show/specialization+preorder"} specialization preorder
            is again the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stochastic+order"} stochastic order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            forms a submonad of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
