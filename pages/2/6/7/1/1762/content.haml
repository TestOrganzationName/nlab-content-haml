          %title
          %p
            Ross Street is a major member of the Australian school of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category theory
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Gregory Maxwell Kelly
          %ul
            %li
              %a{:href => "http://www.maths.mq.edu.au/~street"} homepage
          %p
            His most important works include works in
            = succeed "-," do
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            = succeed "-," do
              %a.existingWikiWord{:href => "/nlab/show/fibred+category"} fibred category
            = succeed "-theory," do
              %a.existingWikiWord{:href => "/nlab/show/descent"} descent
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/orientals"} orientals
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-category"} weak higher category
            %a.existingWikiWord{:href => "/nlab/show/braided+categories"} braided categories
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantum+groups"} quantum groups
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Tannaka+duality"} Tannaka reconstruction
            %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebra
            (e.g. formal theory of
            = succeed "s)," do
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
            %a.existingWikiWord{:href => "/nlab/show/coherence+theorems"} coherence theorems
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/tricategories"} tricategories
          %h2#selected_writings Selected writings
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/lax+functors"} lax functors
          %ul
            %li
              R. Street,
              = succeed "," do
                %em Two constructions on lax functors
              %a{:href => "http://www.numdam.org/item?id=CTGDC_1972__13_3_217_0"} numdam
          %p
            On the
            %a.existingWikiWord{:href => "/nlab/show/2-category+theory"} 2-category theory
            of
            %a.existingWikiWord{:href => "/nlab/show/monads"} monads
            and their
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Moore+categories"} Eilenberg-Moore categories
          %ul
            %li#Street72
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
              ,
              = succeed "," do
                %em The formal theory of monads
              %strong 2
              2 (1972) 149-168 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/0022-4049(72)90019-9"}> doi:10.1016/0022-4049(72)90019-9
              \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cosmoi"} cosmoi
          %ul
            %li#Street74
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                %em Elementary cosmoi I.
                in
                = succeed "," do
                  %em Category Seminar
                = succeed "," do
                  %strong 420
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/BFb0063103"} doi:10.1007/BFb0063103
            %li#Street80
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                = succeed "," do
                  %em Cosmoi of internal categories
                %strong 258
                2 (1980) 271-318 &amp;lbrack;
                %a{:href => "https://doi.org/10.2307/1998059"}> doi:10.2307/1998059
                \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/sketches"} sketches
            in the generality of
            %a.existingWikiWord{:href => "/nlab/show/internalization"} internalization
            into
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/2-categories"} 2-categories
          %ul
            %li#Street76
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                %em Complete objects relative to a theory
                (1976) &amp;lbrack;
                %a{:href => "http://science.mq.edu.au/~street/Sketch.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Street-CompleteObjects.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                ,
                %em Pointwise extensions and sketches in bicategories
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1409.6427"}> arXiv:1409.6427
                \&amp;rbrack;
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topos+theory"} topos theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
              ,
              = succeed "," do
                %em A survey of topos theory
              = succeed "," do
                %a{:href => "http://www.math.mq.edu.au/~street/ToposSurvey.pdf"} pdf
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Street-SurveyToposTheory.pdf", :title => "pdf"} pdf
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
            of
            %a.existingWikiWord{:href => "/nlab/show/stacks"} stacks
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/2-sheaves"} 2-sheaves
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                \:
                = succeed "," do
                  %em Characterization of bicategories of stacks
                = succeed "," do
                  %em Category Theory
                = succeed "," do
                  %strong 962
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/BFb0066909"} doi:10.1007/BFb0066909
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"}> Ross Street
                \:
                = succeed "," do
                  %em Two-dimensional sheaf theory
                %strong 23
                3 (1982) 251-270 [
                %a{:href => "https://doi.org/10.1016/0022-4049(82)90101-3"}> doi:10.1016/0022-4049(82)90101-3
                ]
          %p
            Introducing the notion of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+categories"} braided monoidal categories
          %ul
            %li#JoyalStreet85
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
                = succeed "," do
                  %em Braided monoidal categories
                %em Macquarie Math Reports
                %strong 85-0067
                (1985) &amp;lbrack;
                %a{:href => "http://web.science.mq.edu.au/~street/BMC850067.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/JoyalStreet-BraidedMonoidal85.pdf", :title => "pdf"} pdf
            %li#JoyalStreet86
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
                = succeed "," do
                  %em Braided monoidal categories
                %em Macquarie Math Reports
                %strong 860081
                (1986) &amp;lbrack;
                %a{:href => "http://maths.mq.edu.au/~street/JS1.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/JoyalStreet-BraidedMonoidal.pdf", :title => "pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
                = succeed "," do
                  %em Braided tensor categories
                %strong 102
                (1993) 20-78 &amp;lbrack;
                %a{:href => "https://doi.org/10.1006/aima.1993.1055"}> doi:10.1006/aima.1993.1055
                \&amp;rbrack;
          %p
            On the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/2-category+of+adjunctions"} 2-category of adjunctions
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Stephen+Schanuel"}> Stephen Schanuel
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
              = succeed "," do
                %em The free adjunction
              %a.existingWikiWord{:href => "/nlab/show/Cahiers"} Cahiers
              de topologie et géométrie différentielle catégoriques,
              %strong 27
              1 (1986) 81-83 &amp;lbrack;
              %a{:href => "https://www.numdam.org/item/CTGDC_1986__27_1_81_0"}> numdam:CTGDC_1986__27_1_81_0
              \&amp;rbrack;
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/flexible+limits"} flexible limits
          %ul
            %li#BirdKellyPowerStreet89
              %a.existingWikiWord{:href => "/nlab/show/Greg+J.+Bird"}> Greg J. Bird
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/John+Power"} John Power
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
              = succeed "," do
                %em Flexible limits for 2-categories
              %strong 61
