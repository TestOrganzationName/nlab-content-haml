                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p
            This yields an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                  %mo :
                  %mi 𝒢
                  %mo →
                  %mi 𝒳
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O} : \mathcal{G} \to \mathcal{X}
                  \\,.
          %p
            We think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as being a concrete space
            %em co-probebale
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            (we can map from the concrete
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            into objects of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
          %p
            Such an
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒪
                %annotation{:encoding => "application/x-tex"} \mathcal{O}
            is a
            %em consistent
            collection of coprobes if coprobes with values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            may be reconstructed from co-probes with values in pieces of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
          %p More precisely:
          .un_def
            %h6#definition Definition
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
                \-structure,
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"} StSp, def. 1.2.8
            %p
              An
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo :
                    %mi 𝒢
                    %mo →
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} : \mathcal{G} \to \mathcal{X}
              is a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
                \-valued structure sheaf
              on the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              if
            %ul
              %li
                %p
                  it preserves finite
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              %li
                %p
                  and sends covering coproducts
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                          %mi i
                        %msub
                          %mi U
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi U
                      %annotation{:encoding => "application/x-tex"} (\coprod_i U_i) \to U
                  to
                  = succeed "s." do
                    %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
            %p
              A pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{X}, \mathcal{O})
              of an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{X}
              equipped with
              = succeed "-valued" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒪
                    %mo :
                    %mi 𝒢
                    %mo →
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \mathcal{O} : \mathcal{G} \to \mathcal{X}
              we call a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-topos"} structured (∞,1)-topos
          %p In summary:
          .standout
            %p
              A
              %strong
                concrete
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                modeled on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              is
            %ul
              %li
                %p
                  an
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒳
                      %annotation{:encoding => "application/x-tex"} \mathcal{X}
                  (“of
                  = succeed "-stacks" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                  = succeed "\u201D)" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  equipped with a
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒢
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}
                  in the form of a finite limits and cover preserving functor
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒪
                          %mo :
                          %mi 𝒢
                          %mo →
                          %mi 𝒳
                        %annotation{:encoding => "application/x-tex"} \mathcal{O} : \mathcal{G} \to \mathcal{X}
          %p
            The fundamental
            %strong example
            for
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-topos"} structured (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            themselves, which are canonically equipped with a
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
          .un_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"}> StSp, thm. 2.1.1
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi 𝒢
                    %mo →
                    %mi 𝒢
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f : \mathcal{G} \to \mathcal{G}'
              be a morphism of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometry+%28for+structured+%28infinity%2C1%29-toposes%29"} geometries
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo :
                    %mi ℒ
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℒ
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^* : \mathcal{L}Top(\mathcal{G}) \to \mathcal{L}Top(\mathcal{G}')
              admits a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo :
                    %mi ℒ
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ←
                    %mi ℒ
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msubsup
                      %mi Spec
                      %mi 𝒢
                      %mrow
                        %mi 𝒢
                        %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    f^*
                    \:
                    \\mathcal{L}Top(\mathcal{G}')
                    \\stackrel{\leftarrow}{\to}
                    \\mathcal{L}Top(\mathcal{G})
                    \:
                    Spec_{\mathcal{G}}^{\mathcal{G}'}
            %p
              called the
              = succeed "." do
                %strong relative spectrum functor
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/geometry+%28for+structured+%28infinity%2C1%29-toposes%29"} geometry
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mi disc
                %annotation{:encoding => "application/x-tex"} \mathcal{G}_{disc}
            for the
            %a.existingWikiWord{:href => "/nlab/show/geometry+%28for+structured+%28infinity%2C1%29-toposes%29"} geometry
            obtained from this by forgetting its
            %a.existingWikiWord{:href => "/nlab/show/coverage"} Grothendieck topology
            and instead using the discrete topology where only equivalences cover.
          %p
            Notice that we may identify
            = succeed "-structures" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi disc
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_{disc}
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            = succeed "-preserving" do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi 𝒢
                    %mi disc
                    %mi op
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \mathcal{G}_{disc}^{op} \to \infty Grpd
            with
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/ind-object"} ind-object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒢
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}^{op}
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/pro-object"} pro-object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pro
                  %mo{:stretchy => "false"} (
                  %mi 𝒢
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi ℒ
                  %mi Top
                  %mo{:stretchy => "false"} (
                  %mi 𝒢
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Pro(\mathcal{G})
                  \\hookrightarrow
                  \\mathcal{L}Top(\mathcal{G})^{op}
                  \\,.
          .un_def
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"}> StSp, def. 2.1.2
                )
            %p
              The composite
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spec
                      %mi 𝒢
                    %mo :
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ↪
                    %mi ℒ
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi 𝒢
                      %mi disc
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msubsup
                          %mi Spec
                          %mi 𝒢
                          %mrow
                            %msub
                              %mi 𝒢
                              %mi disc
                    %mi ℒ
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Spec^{\mathcal{G}}
                    \:
                    Pro(\mathcal{G})^{op}
                    \\hookrightarrow
                    \\mathcal{L}Top(\mathcal{G}_{disc})
                    \\stackrel{Spec_{\mathcal{G}}^{\mathcal{G}_{disc}}}{\to}
                    \\mathcal{L}Top(\mathcal{G})
            %p
              we call the
              %strong absolute spectrum functor
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} abstract nonsense
            is reassuring, but we want a more concrete definition of what such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Spec
                    %mi 𝒢
                  %mi U
                %annotation{:encoding => "application/x-tex"} Spec^{\mathcal{G}} U
            is like:
          .un_def
            %h6#definition_3 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"}> StSp, def. 2.2.9
                )
            %p
              For every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} U \in \mathcal{G}
              there is naturally induced a
              %a.existingWikiWord{:href => "/nlab/show/coverage"} topology
              on the
              %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Pro
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi U
                    %annotation{:encoding => "application/x-tex"} Pro(\mathcal{G})/U
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mi U
                    %mo :
                    %mo =
                    %msub
                      %mi Sh
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Spec U := Sh_{(\infty,1)}(Pro(\mathcal{G})/U)
                    \\,,
            %p
              naturally to be thought of as the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              of
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
              %em
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
              \.
            %p
              This is canonically equipped with a
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mrow
                        %mi Spec
                        %mi X
                    %mo :
                    %mi 𝒢
                    %mo →
                    %mi Spec
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{O}_{Spec X}
                    \:
                    \\mathcal{G} \to Spec X
                    \\,.
          %p And this is indeed the concrete underlying space produced by the absolute spectrum functor:
          .un_theorem
            %h6#theorem_2 Theorem
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"}> StSp, prop. 2.2.11, thm. 2.2.12
                )
            %p
              For every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∈
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} U \in \mathcal{G}
              the pair
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Spec
                    %mi U
                    %mo ,
                    %msub
                      %mi 𝒪
                      %mrow
                        %mi Spec
                        %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Spec U, \mathcal{O}_{Spec U})
              is indeed a
              %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-topos"} structured (∞,1)-topos
              and is indeed equivalent to the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Spec
                      %mi 𝒢
                    %mi U
                  %annotation{:encoding => "application/x-tex"} Spec^{\mathcal{G}} U
              defined more abstractly above.
          %p
            %strong Example
            For
