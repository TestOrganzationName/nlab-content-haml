            with the standard
            %a.existingWikiWord{:href => "/nlab/show/coverage"} topology
            we have that 0-localic
            = succeed "-structured" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
