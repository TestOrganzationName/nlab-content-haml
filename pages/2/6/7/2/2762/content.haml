            (which happens to be an ordinary
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            the set of closed
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} n-form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
