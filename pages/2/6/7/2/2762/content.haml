          %h3#spaces_locally_like_model_spaces_generalized_schemes Spaces locally like model spaces: generalized schemes
          %p
            We have seen that
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-topos"} structured (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            that are well-behaved in that at least they do have an “underlying topological structure” in the form of an underlying
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
          %p
            In parts this is desireable: many objects that one would naturally build out of the objects in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Σ
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [\Sigma,X]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                %annotation{:encoding => "application/x-tex"} \mathcal{G}
            but do live happily in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mi Top
                    %mo{:stretchy => "false"} (
                    %mi 𝒢
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}Top(\mathcal{G})^{op}
          %p
            But in many situations one would like to regard
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
            = succeed "es" do
              %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-topos"} structured (∞,1)-topos
            %em locally
            equivalent to objects in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}
          .un_def
            %h6#definition_4 Definition
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Structured+Spaces"} StSp, def. 2.3.9
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-topos"} structured (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %mi 𝒪
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{X}, \mathcal{O})
              is a
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
                \-generalized scheme
              if
            %ul
              %li
                %p
                  there exists a collection
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi V
                          %mi i
                        %mo ∈
                        %mi 𝒳
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{V_i \in \mathcal{X}\}
              %li
                %p such that
                %ul
                  %li
                    %p
                      this covers
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒳
                          %annotation{:encoding => "application/x-tex"} \mathcal{X}
                      in that the canonical morphism
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                              %mi i
                            %msub
                              %mi V
                              %mi i
                            %mo{:stretchy => "false"} )
                            %mo →
                            %msub
                              %mo *
                              %mi 𝒳
                          %annotation{:encoding => "application/x-tex"}
                            (\coprod_i V_i) \to {*}_{\mathcal{X}}
                    %p
                      to the
                      %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                      in
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒳
                          %annotation{:encoding => "application/x-tex"} \mathcal{X}
                      is an
                      %a.existingWikiWord{:href => "/nlab/show/effective+epimorphism"} effective epimorphism
                  %li
                    %p
                      the
                      = succeed "es" do
                        %a.existingWikiWord{:href => "/nlab/show/structured+%28%E2%88%9E%2C1%29-topos"} structured (∞,1)-topos
                      %br/
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi 𝒳
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi V
                              %mi i
                            %mo ,
                            %mi 𝒪
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi V
                                  %mi i
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (\mathcal{X}/V_i, \mathcal{O}|_{V_i})
                      induced by the
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi V
                              %mi i
                          %annotation{:encoding => "application/x-tex"} V_i
                      are model spaces in that there exists
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msub
                              %mi U
                              %mi i
                            %mo ∈
                            %mi 𝒢
                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"} \{U_i \in \mathcal{G}\}
                      and equivalences
                    .maruku-equation
                      %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi 𝒳
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi V
                              %mi i
                            %mo ,
                            %mi 𝒪
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi V
                                  %mi i
                            %mo{:stretchy => "false"} )
                            %mo ≃
                            %msup
                              %mi Spec
                              %mi 𝒢
                            %msub
                              %mi U
                              %mi i
                          %annotation{:encoding => "application/x-tex"}
                            (\mathcal{X}/V_i, \mathcal{O}|_{V_i})
                            \\simeq
                            Spec^{\mathcal{G}} U_i
          %p
            %strong Examples
          %blockquote
            %p
              %strong warning
              the following statements really pertain to pregeometries, not geometries. for the moment this here is glossing over the difference between the two. See
              %a.existingWikiWord{:href => "/nlab/show/geometry+%28for+structured+%28%E2%88%9E%2C1%29-toposes%29"} geometry (for structured (∞,1)-toposes)
              for the details.
          %ul
            %li
              %p
                ordinary smooth
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/manifold"} manifold
                %a.existingWikiWord{:href => "/nlab/show/n-localic+%28infinity%2C1%29-topos"} 0-localic
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Diff"} Diff
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+scheme"} generalized scheme
            %li
              %p
                ordinary
                %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
                are those
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi CRing
                          %mi fin
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                      %annotation{:encoding => "application/x-tex"} (CRing^{fin})^{op}
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+scheme"} generalized scheme
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
                is
          %p
            %a.existingWikiWord{:href => "/nlab/show/n-localic+%28infinity%2C1%29-topos"} 0-localic
            and whose
            %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
            is
            %a.existingWikiWord{:href => "/nlab/show/n-truncated+object+of+an+%28infinity%2C1%29-category"} 0-truncated
            ([Structured Spaces|StSp, prop. 4.2.9]])
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Deligne-Mumford+stack"}> Deligne-Mumford stack
                s are 1-localic
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi CRing
                          %mi fin
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mi et
                          %mi op
                      %annotation{:encoding => "application/x-tex"} (CRing^{fin})_{et}^{op}
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+scheme"} generalized scheme
            %li
              %p
                This last statement is then the basis for calling a general
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi CRing
                          %mi fin
                        %msubsup
                          %mo{:stretchy => "false"} )
                          %mi et
                          %mi op
                      %annotation{:encoding => "application/x-tex"} (CRing^{fin})_{et}^{op}
                %a.existingWikiWord{:href => "/nlab/show/generalized+scheme"} generalized scheme
                a
                %strong derived Deligne-Mumford stack
            %li
              %p
                Finally, to make contact with the application to the derived moduli stack of derived elliptic curves, it seems that in
                %a.existingWikiWord{:href => "/nlab/show/Spectral+Schemes"} Spectral Schemes
                a derived Deligne-Mumford stack (with derived in the sense of having replaced ordinary commutative rings by
                = succeed "s)" do
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi E
                          %mn ∞
                        %msup
                          %mi Ring
                          %mi fin
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                      %annotation{:encoding => "application/x-tex"} (E_\infty Ring^{fin})^{op}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+scheme"} generalized scheme
          %h2#the_derived_moduli_space_of_elliptic_curves The derived moduli space of elliptic curves
          %p
            With the above machinery for
            %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
            in hand, we now set out to describe the particular application that we are interested in: the study of the derived
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curve"} derived elliptic curve
          %h3#derived_elliptic_curves Derived elliptic curves
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curve"} derived elliptic curve
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ↦
                  %mi E
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  A \mapsto E(A)
          %h3#the_derived_moduli_stack The derived moduli stack
          %p
            Lurie’s discussion of the derived moduli stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℳ
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mi Der
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{M}_{1,1}, \mathcal{O}^{Der})
            is more than a re-interpretation of the Goerss-Miller-Hopkins theorem. It is in particular a re-derivation of this result, from the following perspective
          .standout
            %p
              %strong the central statement, conceptually
            %p
              %strong Input
              We have the
              = succeed "-probeable" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi E
                        %mn ∞
                      %mi Ring
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} (E_\infty Ring)^{op}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo :
                    %mi R
                    %mo ↦
                    %mo{:stretchy => "false"} {
                    %mi derived
                    %mspace{:width => "thickmathspace"}
                    %mi elliptic
                    %mspace{:width => "thickmathspace"}
                    %mi curves
                    %mspace{:width => "thickmathspace"}
                    %mi over
                    %mspace{:width => "thickmathspace"}
                    %mi R
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Sh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn ∞
                    %msup
                      %mi Ring
                      %mi op
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (E : R \mapsto \{derived\;elliptic\;curves\;over\;R\})
                    \\in Sh(E_\infty Ring^{op})
                    \\,.
            %p
              %strong> Question
              \: Does this happen to even be a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                      %msup
                        %mi Ring
                        %mi op
                    %annotation{:encoding => "application/x-tex"} E_\infty Ring^{op}
              = succeed "?" do
                %a.existingWikiWord{:href => "/nlab/show/generalized+scheme"} generalized scheme
            %p
              %strong Answer
              Yes. It is actually a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/derived+Deligne-Mumford+stack"} derived Deligne-Mumford stack
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℳ
                    %mrow
                      %mn 1
                      %mo ,
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \mathcal{M}_{1,1}
            be the ordinary
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
          %p
            Using constructions in
            %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"} elliptic cohomology
            we may associate to each
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                    %mo :
                    %mi Spec
                    %mi R
                    %mo →
                    %mi 𝒳
                  %annotation{:encoding => "application/x-tex"} \phi : Spec R \to \mathcal{X}
            %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi ϕ
                %annotation{:encoding => "application/x-tex"} E_\phi
            – the multiplicative spectrum that represents the elliptic cohomology theory given by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          %p
            This gives an
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝒪
                    %mi Der
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo :
                  %mi Spec
                  %mi R
                  %mo →
                  %mi 𝒳
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %msub
                    %mi E
                    %mi ϕ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{O}^{Der} : (\phi : Spec R \to \mathcal{X}) \mapsto
                  E_\phi
                  \\,.
          %p
            %strong Question
            What, if anything, is this derived stack a derived
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of?
          %h3#the_classification_of_derived_elliptic_curves the classification of derived elliptic curves
          %p
            The big theorem is that the derived space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi 𝒳
                  %mo ,
                  %msup
                    %mi 𝒪
                    %mi Der
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathcal{X}, \mathcal{O}^{Der})
            classifies derived elliptic curves over
            = succeed "-rings" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} E_\infty
          %p This is the theorem that we said above we wanted to consider, stated now a little bit more precisely.
          .un_theorem
            %h6#theorem_3 Theorem
            %p
              %strong (J. Lurie)
            %p For
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  any
                  %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
              %li
                %p
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E(A)
                  is the space of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/derived+elliptic+curve"} derived elliptic curve
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  (the realization of the topological category of elliptic curves over
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                        %annotation{:encoding => "application/x-tex"} A
            %p we have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Hom
                    %mo{:stretchy => "false"} (
                    %mi Spec
                    %mi A
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi 𝒳
                    %mo ,
                    %msup
                      %mi 𝒪
                      %mi Der
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi E
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom(Spec A, (\mathcal{X}, \mathcal{O}^{Der}))
                    \\simeq
                    E(A)
            %p
              naturally in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
          .proof
            %h6#proof Proof
            %p Jacob Lurie writes that the proof proceeds alonmg these steps. Details will be discussed in the next session.
            %ol
              %li
                %p
                  consider the presheaf of preoriented ellitptic curves
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi A
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} E'(A)
                  first
              %li
                %p observe that this restricted to ordinary rings produces the ordinary moduli stack
              %li
                %p
                  notice that every oo-stack with good deformation theory that restricts this way is a derived Deligne-Mumford stack
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi 𝒳
                        %mo ,
                        %mi 𝒪
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathcal{X}, \mathcal{O}')
                  that assigns connective
                  = succeed "-rings" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi E
                            %mn ∞
                        %annotation{:encoding => "application/x-tex"} E_\infty
              %li
                %p
                  let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                      %annotation{:encoding => "application/x-tex"} \omega
                  be the line bundle on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℳ
                          %mrow
                            %mn 1
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathcal{M}_{1,1}
                  regarded as a coheren sheaf. There is then from the preorientation of the universal curve over
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ℳ
                        %mo ,
                        %mi 𝒪
                        %mo ′
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\mathcal{M}, \mathcal{O}')
                  a morphism
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo :
                        %mi ω
                        %mo →
                        %msub
                          %mi π
                          %mn 2
                        %mi 𝒪
                        %mo ′
                      %annotation{:encoding => "application/x-tex"}
                        \\beta : \omega \to \pi_2 \mathcal{O}'
              %li
                %p
                  let
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}
                  be the sheaf obtained from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒪
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} \mathcal{O}'
                  by inverting
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                      %annotation{:encoding => "application/x-tex"} \beta
              %li
                %p show that
                %ol
                  %li
                    %p
                      for
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                            %mo =
                            %mn 2
                            %mi k
                          %annotation{:encoding => "application/x-tex"} n = 2 k
                      we have an isomorphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi ω
                              %mi k
                            %mo →
                            %msub
                              %mi π
                              %mrow
                                %mn 2
                                %mi k
                            %mi 𝒪
                          %annotation{:encoding => "application/x-tex"} \omega^k \to \pi_{2 k}\mathcal{O}
                  %li
                    %p
                      for
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                            %mo =
                            %mn 2
                            %mi k
                            %mo +
                            %mn 1
                          %annotation{:encoding => "application/x-tex"} n = 2 k + 1
                      we have an isomorphism
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 0
                            %mo →
                            %msub
                              %mi π
                              %mrow
                                %mn 2
                                %mi k
                                %mo +
                                %mn 1
                            %mi 𝒪
                          %annotation{:encoding => "application/x-tex"} 0 \to \pi_{2k +1}\mathcal{O}
                    %p strategy: reduce to neighbourhood of a point
              %li
                %p notice that this implies the desired statement
