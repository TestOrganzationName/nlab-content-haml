                %circle#svg_32298_6{:cx => "339", :cy => "198", :fill => "none", :r => "50", :stroke => "#7f007f", "stroke-width" => "2"}
                %ellipse#svg_32298_7{:cx => "428", :cy => "198", :fill => "none", :rx => "25", :ry => "50", :stroke => "#7f007f", "stroke-width" => "2"}
                %ellipse#svg_32298_8{:cx => "492", :cy => "198", :fill => "none", :rx => "9", :ry => "50", :stroke => "#7f007f", "stroke-width" => "2"}
