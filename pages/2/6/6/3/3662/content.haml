                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
              %foreignobject#svg_32298_14{"font-size" => "16", :height => "20", :width => "48", :x => "335", :y => "280"}
                %math{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
          %p
            We then reparametrise these in
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            so that
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            and
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                %annotation{:encoding => "application/x-tex"} \beta
            are flat (but without sitting instants) at the appropriate end-points (
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} s = 1
            for
            = succeed "," do
              %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} s = 0
            for
            = succeed ")." do
              %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi sin
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha(1,t) = (0,\sin(2 \pi t))
            which is thinly homotopic to the zero map. Similarly,
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi sin
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi π
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \beta(0,t) = (0,-\sin(2\pi t))
            which is, again, thinly homotopic to the zero map. So
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha(1,t) = \beta(0,t)
            but even with the reparametrisation, there is no way to lift the concatenation,
            = succeed "," do
              %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo #
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \alpha # \beta
            = succeed "." do
              %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mn 1
                    %mi M
                  %annotation{:encoding => "application/x-tex"} P^1 M
          %p
            If we include a sitting instant at the concatentation point then it is possible to concatentate these paths. This is because the quotient sets are themselves path-connected, so there is a smooth path between
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha(1,t)
            and
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \beta(0,t)
            which lies wholly within the space of paths thinly homotopic to the zero map. While we “sit” at the concatenation point in
            = succeed "," do
              %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mn 1
                    %mi M
                  %annotation{:encoding => "application/x-tex"} P^1 M
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \alpha(1,t)
            to
            = succeed "." do
              %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi t
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \beta(0,t)
          %h3#frlicher_structure Frölicher Structure
          %p
            The Frölicher structure on
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mn 1
                  %mi M
                %annotation{:encoding => "application/x-tex"} P^1 M
            is determined by the fact that smooth functions
            %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mn 1
                  %mi M
                  %mo →
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} P^1 M \to \mathbb{R}
            are those functions that compose to smooth functions
            = succeed "." do
              %math#mathml_8de4d29321bda94cd361c4b419afdd232cc629df_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi M
                    %mo →
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} P M \to \mathbb{R}
