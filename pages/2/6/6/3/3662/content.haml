                %path{:d => "m0,0l10,5l-10,5l5,-5l-5,-5z", :fill => "#000000"}
            %g
              %title Layer 1
              %line#svg_32298_1{:fill => "none", :stroke => "#000000", "stroke-width" => "2", :x1 => "51", :x2 => "451", :y1 => "148", :y2 => "148"}
              %circle#svg_32298_2{:cx => "51", :cy => "98", :fill => "none", :r => "50", :stroke => "#0000ff", "stroke-width" => "2"}
              %ellipse#svg_32298_3{:cx => "140", :cy => "98", :fill => "none", :rx => "25", :ry => "50", :stroke => "#0000ff", "stroke-width" => "2"}
