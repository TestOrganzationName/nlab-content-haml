                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,g)
              %em
                %a.existingWikiWord{:href => "/nlab/show/Laplace-Beltrami+operator"} Laplace-Beltrami operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              is the
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              on the space of
              %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %msup
                      %mi C
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi Ω
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f \in C^\infty(X) = \Omega^0(X)
              given by the formula
            #eq:LaplaceOperatorViaHodgeDeRhamCalculus.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo ⋆
                    %mi d
                    %mo ⋆
                    %mi d
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta f
                    \\;\coloneqq\;
                    \\star d \star d f
                    \\,,
            %p where
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi Ω
                          %mrow
                            %mo •
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d \;\colon\; \Omega^\bullet(X) \to \Omega^{\bullet + 1}(X)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                  (depending only on the
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⋆
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %msup
                          %mi Ω
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msup
                          %mi Ω
                          %mrow
                            %mi dim
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                            %mo −
                            %mo •
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \star \;\colon\; \Omega^\bullet(X) \to \Omega^{dim(X)-\bullet}(X)
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi g
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (X,g)
                  (this is where the dependence on the
                  %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
                  enters).
            %p
              The same formula makes sense more generally for
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifolds"} pseudo-Riemannian manifolds
              %em
                %a.existingWikiWord{:href => "/nlab/show/wave+operator"} wave operator
              instead of the Laplace operator, and to use the symbol
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo □
                  %annotation{:encoding => "application/x-tex"} \Box
              instead of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              (at least for flat
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifolds"} pseudo-Riemannian manifolds
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
          #LaplaceOperatorInComponents.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/coordinate"}> coordinate
                \-expression of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Laplace+operator"} Laplace operator
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U \subset X
              is a
              %a.existingWikiWord{:href => "/nlab/show/chart"} chart
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %a.existingWikiWord{:href => "/nlab/show/coordinate+functions"} coordinate functions
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi x
                        %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi U
                      %mo →
                      %mi ℝ
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x^i \colon U \to \mathbb{R}\}
              %a.maruku-eqref{:href => "#eq:LaplaceOperatorViaHodgeDeRhamCalculus"} (1)
              is equivalently given by the following component-expression:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %msub
                      %mi f
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi U
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi sgn
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                      %msqrt
                        %mrow
                          %mo |
                          %mi det
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi g
                            %mrow
                              %mi i
                              %mi j
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo |
                    %msub
                      %mo ∂
                      %mi i
                    %mrow
                      %mo (
                      %msqrt
                        %mrow
                          %mo |
                          %mi det
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi g
                            %mrow
                              %mi i
                              %mi j
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo |
                      %msup
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %msub
                        %mo ∂
                        %mi j
                      %mi f
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta f_{\vert U}
                    \\;=\;
                    \\frac{
                    sgn(g)
                    }{
                    \\sqrt{
                    \\left\vert
                    det\big( (g_{i j})  \big)
                    \\right\vert
                    }
                    }
                    \\partial_i
                    \\left(
                    \\sqrt{
                    \\left\vert
                    det\big( (g_{i j})  \big)
                    \\right\vert
                    }
                    g^{i j}
                    \\partial_j
                    f
                    \\right)
                    \\,,
          %p Here:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} sgn(g)
                is the
                %a.existingWikiWord{:href => "/nlab/show/signature+of+a+quadratic+form"} signature
                of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi sgn
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} sgn(g) = +1
                    for
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifolds"} Riemannian manifolds
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi sgn
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} sgn(g) = -1
                    for
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifolds"} pseudo-Riemannian manifolds
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mi i
                      %mo ≔
                      %mfrac
                        %mo ∂
                        %mrow
                          %mo ∂
                          %msup
                            %mi x
                            %mi i
                    %annotation{:encoding => "application/x-tex"} \partial_i \coloneqq \frac{\partial}{\partial x^i}
                denotes the
                %a.existingWikiWord{:href => "/nlab/show/partial+derivative"} partial derivative
                by the coordinate
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi x
                          %mi i
                      %annotation{:encoding => "application/x-tex"} x^i
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (g_{i j})
                is the
                %a.existingWikiWord{:href => "/nlab/show/square+matrix"} square matrix
                of components of the
                %a.existingWikiWord{:href => "/nlab/show/metric+tensor"} metric tensor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                in the given
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coordinate+chart"} coordinate chart
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mi d
                      %msup
                        %mi x
                        %mi i
                      %mo ⊗
                      %mi d
                      %msup
                        %mi x
                        %mi j
                    %annotation{:encoding => "application/x-tex"}
                      g
                      \\;=\;
                      g_{i j}
                      d x^i \otimes d x^j
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi det
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} det\big( (g_{i j}) \big)
                is the
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
                of this
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo |
                        %mi det
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi g
                          %mrow
                            %mi i
                            %mi j
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo |
                    %annotation{:encoding => "application/x-tex"} \left\vert det\big( (g_{i j}) \big)\right\vert
                its
                %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
                (taking this is irrelevant for
                %a.existingWikiWord{:href => "/nlab/show/Riemannian+manifolds"} Riemannian manifolds
                but necessary for
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifolds"} pseudo-Riemannian manifolds
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msqrt
                        %mrow
                          %mo |
                          %mi det
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi g
                            %mrow
                              %mi i
                              %mi j
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mo |
                    %annotation{:encoding => "application/x-tex"} \sqrt{\left\vert det\big( (g_{i j}) \big)\right\vert}
                is the
                %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
                %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
                of that;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi g
                        %mrow
                          %mi i
                          %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (g^{i j})
                is the corresponding
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/inverse+matrix"} inverse matrix
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
                is used throughout, meaing that a
                %a.existingWikiWord{:href => "/nlab/show/sum"} sum
                over repeated indices is understood.
          .proof
            %h6#proof Proof
            %p Using
            %ol
              %li
                %p
                  the component formula for the
                  %a.existingWikiWord{:href => "/nlab/show/de+Rham+differential"} de Rham differential
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo =
                          %mi d
                          %msup
                            %mi x
                            %mi i
                          %msub
                            %mo ∂
                            %mi i
                        %annotation{:encoding => "application/x-tex"} d = d x^i \partial_i
              %li
                %p
                  the component formula for the
                  %a.existingWikiWord{:href => "/nlab/show/Hodge+star+operator"} Hodge star operator
                  (see
                  = succeed ")" do
                    %a{:href => "Hodge+star+operator#eq:ComponentFormulaForHodgeStar"} there
            %p we compute as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo ⋆
                            %mi d
                            %mo ⋆
                            %mi d
                            %mi f
                          %mtd
                            %mo =
                            %mo ⋆
                            %mi d
                            %mo ⋆
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∂
                              %mi j
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mi d
                            %msup
                              %mi x
                              %mi j
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ⋆
                            %mi d
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mstyle{:mathcolor => "green"}
                                    %mo{:stretchy => "false"} (
                                    %mi D
                                    %mo −
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                                    %mo !
                              %msqrt
                                %mrow
                                  %mo |
                                  %mi det
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi g
                                    %mrow
                                      %mi i
                                      %mi j
                                  %mo{:stretchy => "false"} )
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mo |
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi g
                                %mrow
                                  %mi i
                                  %mi j
                              %mo{:stretchy => "false"} (
                              %msub
                                %mo ∂
                                %mi j
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ϵ
                                %mrow
                                  %mi i
                                  %mstyle{:mathcolor => "green"}
                                    %msub
                                      %mi k
                                      %mn 2
                                    %mi ⋯
                                    %msub
                                      %mi k
                                      %mi D
                              %mi d
                              %msup
                                %mi x
                                %mstyle{:mathcolor => "green"}
                                  %msub
                                    %mi k
                                    %mn 2
                              %mo ∧
                              %mi ⋯
                              %mo ∧
                              %mi d
                              %msup
                                %mi x
                                %mstyle{:mathcolor => "green"}
                                  %msub
                                    %mi k
                                    %mi D
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo ⋆
                            %msub
                              %mo ∂
                              %mstyle{:mathcolor => "magenta"}
                                %msub
                                  %mi k
                                  %mn 1
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mn 1
                                  %mstyle{:mathcolor => "green"}
                                    %mo{:stretchy => "false"} (
                                    %mi D
                                    %mo −
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                                    %mo !
                              %msqrt
                                %mrow
                                  %mo |
                                  %mi det
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi g
                                    %mrow
                                      %mi i
                                      %mi j
                                  %mo{:stretchy => "false"} )
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mo |
                              %mspace{:width => "thinmathspace"}
                              %msup
                                %mi g
                                %mrow
                                  %mi i
                                  %mi j
                              %mo{:stretchy => "false"} (
                              %msub
                                %mo ∂
                                %mi j
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi ϵ
                                %mrow
                                  %mi i
                                  %mstyle{:mathcolor => "green"}
                                    %msub
                                      %mi k
                                      %mn 2
                                    %mi ⋯
                                    %msub
                                      %mi k
                                      %mi D
                              %mi d
