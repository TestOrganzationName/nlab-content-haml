          %p
            There are
            = succeed "-ring" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %msub
                    %mi A
                    %mi f
                %annotation{:encoding => "application/x-tex"} f_A: A\to A_f
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mi A
                    %mo :
                    %mrow
                      %mo {
                      %mrow
                        %mtable{:columnalign => "left left", :displaystyle => "false"}
                          %mtr
                            %mtd
