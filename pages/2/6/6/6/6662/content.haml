                          %mi p
                  %annotation{:encoding => "application/x-tex"}
                    R
                    \\overset{\Delta_p}{\longrightarrow}
                    (R \wedge \cdots \wedge R)^{t C_p}
                    \\overset{prod^{t C_p}}{\longrightarrow}
                    R^{t C_p}
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
