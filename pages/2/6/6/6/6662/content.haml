                        %mi k
                  %mi k
                %annotation{:encoding => "application/x-tex"} X^{(p)}:X\otimes_{k,f_k} k
            which satisfies
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
