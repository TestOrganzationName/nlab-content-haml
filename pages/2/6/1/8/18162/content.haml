                %annotation{:encoding => "application/x-tex"} A \to X \;\;\;\,&amp;solb;\,\;\;\; \Lambda_\infty\to \{o\}
            implies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi X
