            The separating neighbourhoods
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊃
                  %mi F
                %annotation{:encoding => "application/x-tex"} U\supset F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ⊃
                  %mi B
                %annotation{:encoding => "application/x-tex"} V\supset B
            are the preimages under the diagonal arrow of the open subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msub
                    %mi e
                    %mi F
                  %mo ↔
                  %msub
                    %mi e
                    %mi U
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"}
