                                    %mi x
                                    %mo{:stretchy => "false"} )
                                  %mtd
                                    %mo{:stretchy => "false"} |
                                  %mtd
                                    %mi otherwise
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  f'
                  \&amp;\colon&amp;
                  S
                  \&amp;\longrightarrow&amp;
                  {[0,1]}
                  \\\
                  \&amp;&amp;
                  x
                  \&amp;\mapsto&amp;
                  \\left\{
                  \\array{
                  0 &amp;\vert&amp; x \in F
                  \\\
                  1 &amp;\vert&amp; x \in G
                  \\\
                  f(x) &amp;\vert&amp; otherwise
                  }
                  \\right.
                  }
          %p
            Notice that sets separated by a function must be separated by closed neighbourhoods (the preimages of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi ϵ
                  %mo ,
                  %mi ϵ
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [-\epsilon, \epsilon]
            and
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo −
                    %mi ϵ
                    %mo ,
                    %mn 1
                    %mo +
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1-\epsilon, 1+\epsilon]
          %p
            %br/
          %h2#SeparationAxiomsAsLiftingProperties Separation axioms as lifting properties
          %p
            In all of the following definitions,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} {X}
            is a topological space.
          %p
            We shall use the symbol “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi ⧄
                %annotation{:encoding => "application/x-tex"} &amp;solb;
            ” to denote the
            %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
            of one map against another (compare
            = succeed "):" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Joyal-Tierney+calculus"} Joyal-Tierney calculus
          %p
            So for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mover
                    %mo →
                    %mi ϕ
                  %mi T
                %annotation{:encoding => "application/x-tex"} S \xrightarrow{\phi} T
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo →
                    %mi f
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \xrightarrow{f} Y
            a
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            of
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            between topological spaces, we write
          .maruku-equation
