                                    %mi x
                                    %mo ∈
                                    %mi F
                                %mtr
                                  %mtd
                                    %msub
                                      %mi e
                                      %mi G
                                  %mtd
                                    %mo{:stretchy => "false"} |
                                  %mtd
                                    %mi x
                                    %mo ∈
                                    %mi G
                                %mtr
                                  %mtd
                                    %mi f
                                    %mo{:stretchy => "false"} (
                                    %mi x
                                    %mo{:stretchy => "false"} )
                                  %mtd
                                    %mo{:stretchy => "false"} |
                                  %mtd
                                    %mi otherwise
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  f'
                  \&amp;\colon&amp;
                  S
                  \&amp;\longrightarrow&amp; [0,1]\vee_{\{0,1\}} \{0'\leftrightarrow 0, 1\leftrightarrow 1\}
                  \\\
                  \&amp;&amp;
                  x
                  \&amp;\mapsto&amp;
                  \\left\{
                  \\array{
                  e_F &amp;\vert&amp; x \in F
                  \\\
                  e_G &amp;\vert&amp; x \in G
                  \\\
                  f(x) &amp;\vert&amp; otherwise
                  }
                  \\right.
                  }
          %h3#precisely_separated_by_a_function Precisely separated by a function
          %p
            Finally, we say that two disjoint subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            are
            %strong separated by a function
            if there exists a continuous
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            on the space that maps precisely
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          #eq:ConditionForPreciseSeparationByAFunction.maruku-equation
            %span.maruku-eq-number (11)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo ∃
                    %mrow
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mi S
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi R
                  %mrow
                    %mo (
                    %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∧
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\underset
                  {f \,\colon\, S \to \mathbf{R}}
                  {\exists}
                  \\left(
                  F \,=\, f^{-1}(\{0\})
                  \\;\;\wedge\;\;
                  G \,=\, f^{-1}(\{1\})
                  \\right)
          %p
            Equivalently, we may assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            takes values in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ⊆
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} [0,1]\subseteq \mathbb{R}
          %p
