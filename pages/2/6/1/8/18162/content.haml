            %path{:d => "M -2.487469 2.868884 C -2.03233 1.149031 -1.01896 0.33334 -0.000711219 -0.000987087 C -1.019567 -0.336544 -2.03293 -1.146753 -2.486221 -2.870272 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(0.78082, -0.62465, -0.62465, -0.78082, 86.26947, 40.70191)"}
            %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
              %use{:x => "46.285", "xlink:href" => "#zW8EqYI3rm0xAZUSWTbtXqGCGhE=-glyph-5-2", :y => "63.863"}
          %p
            %br/
          %h2#BackgroundAndNotation Background and notation
          %p
            In order to economically define and denote the
            %a.existingWikiWord{:href => "/nlab/show/finite+topological+spaces"} finite topological spaces
            which will appear in the
            %a.existingWikiWord{:href => "/nlab/show/lifting+problems"} lifting problems
            discussed below, we may encode them through their
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/specialization+order"} specialization order
          %p
            Recall that the
            %a.existingWikiWord{:href => "/nlab/show/specialisation+preorder"} specialisation preorder
            on the
            %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            of points of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is the
            %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
            whose
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/order+relation"} order relation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x, y \in X
          #eq:SpecializationPreorder.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mspace{:width => "thinmathspace"}
                  %mo ≤
                  %mspace{:width => "thinmathspace"}
                  %mi y
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mtext iff
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %mi cl
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  x \,\leq\, y
                  \\;\;\;\;\;\;\text{ iff }\;\;\;\;\;\;
                  x \,\in\, cl(y)
                  \\,,
          %p where the right hand side means that the following two equivalent conditions hold:
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                is in the
                %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
            %li
              %p
                every
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                which contains
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                also contains
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
          %p#ProsetsAsCategories
            We may regard these
            %a.existingWikiWord{:href => "/nlab/show/preordered+sets"} preordered sets
            equivalently as (
            %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin
            and
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/categories"} categories
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are the points of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                reflect the order relation:
              %p
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x, y \,\in\, X
                there exists a unique morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mspace{:width => "thinmathspace"}
                      %mo ←
                      %mspace{:width => "thinmathspace"}
                      %mi x
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mtext iff
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi y
                      %mspace{:width => "thinmathspace"}
                      %mo ≤
                      %mspace{:width => "thinmathspace"}
                      %mi x
                      %mspace{:width => "thickmathspace"}
                    %annotation{:encoding => "application/x-tex"}
                      y \,\leftarrow\, x
                      \\;\;\;\text{ iff }\;\;\;
                      y \,\leq\, x\;
              %p
                (the mnemonic: view the arrow head of “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ←
                    %annotation{:encoding => "application/x-tex"} \leftarrow
                ” as a “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo &lt;
                    %annotation{:encoding => "application/x-tex"} \lt
                ”-symbol)
          %p
            For a
            %a.existingWikiWord{:href => "/nlab/show/finite+topological+space"} finite topological space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/specialisation+preorder"} specialisation preorder
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(X)
            – or equivalently the corresponding category, which we shall conceptually conflate with the pre-ordering – uniquely determines the topology:
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo ⊂
                  %mi X
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} C \,\subset X\,
            is
            %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed
            iff the following equivalent conditions hold:
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                %a.existingWikiWord{:href => "/nlab/show/downward+closed+subset"} downward closed
                in the specialization order;
            %li
              %p
                there are no morphisms going out of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                in the corresponding category.
          %p
            Accordingly, we may and will denote
            %a.existingWikiWord{:href => "/nlab/show/finite+topological+spaces"} finite topological spaces
            by showing the
            %a.existingWikiWord{:href => "/nlab/show/graph"} graph
            containing their points with a system of arrows indicating the generating
            %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
            in their corresponding
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/specialization+preorder"} specialization preorder
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/thin+category"} category
          %p
            In doing so, often it will be convenient to show multiple copies of the
            %em same
            object, i.e. the same point. Noticing that in the
            %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
            corresponding to a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            between two objects does
            %em not imply
            their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/equality"} equality
          %ul
            %li
              %p
                ‘
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo =
                    %annotation{:encoding => "application/x-tex"} =
                ’ denotes an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            %li
              %p
                ‘
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ↔
                    %annotation{:encoding => "application/x-tex"} \leftrightarrow
                ’ denotes an
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %p
                (hence, because the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⇆
                      %annotation{:encoding => "application/x-tex"} \leftrightarrows
          %p#BasicExamplesForNotation For example:
          %table
            %thead
              %tr
                %th
                  %a.existingWikiWord{:href => "/nlab/show/finite+topological+space"} finite topological space
                %th
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                %th
                  %a.existingWikiWord{:href => "/nlab/show/specialization+order"} specialization order
                %th as picture
            %tbody
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
                  %br/
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Dsc
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} Dsc\big(\{ 0,1 \}\big)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                        %mspace{:width => "thickmathspace"}
                        %mo ∅
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %annotation{:encoding => "application/x-tex"} \Big\{\; \varnothing,\, \{0\},\, \{1\},\, \{0,1\} \;\Big\}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mphantom
                          %mo ←
                        %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %annotation{:encoding => "application/x-tex"} \Big\{\; 0 \phantom{\leftarrow} 1 \;\Big\}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %menclose{:notation => "box"}
                          %mrow
                            %mo{:stretchy => "false"} {
                            %menclose{:notation => "box"}
                              %mn 0
                            %mo ,
                            %menclose{:notation => "box"}
                              %mn 1
                            %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \boxed{\{\boxed{0},\boxed{1}\}}
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
                  %br/
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sierp
                      %annotation{:encoding => "application/x-tex"} Sierp
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                        %mspace{:width => "thickmathspace"}
                        %mo ∅
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %annotation{:encoding => "application/x-tex"} \Big\{\; \varnothing,\, \{0\},\, \{0,1\} \;\Big\}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mo →
                        %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %annotation{:encoding => "application/x-tex"} \Big\{\; 0 \rightarrow 1 \;\Big\}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %menclose{:notation => "box"}
                          %mrow
                            %mo{:stretchy => "false"} {
                            %menclose{:notation => "box"}
                              %mn 0
                            %mo →
                            %mn 1
                            %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \boxed{\{\boxed{0}\rightarrow 1\}}
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/codiscrete+space"} codiscrete space
                  %br/
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CoDsc
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %annotation{:encoding => "application/x-tex"} CoDsc\big( \{0,1\} \big)
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                        %mspace{:width => "thickmathspace"}
                        %mo ∅
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %annotation{:encoding => "application/x-tex"} \Big\{\; \varnothing,\, \{0,1\}  \;\Big\}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mo ↔
                        %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %annotation{:encoding => "application/x-tex"} \Big\{\; 0 \leftrightarrow 1 \;\Big\}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %menclose{:notation => "box"}
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ↔
                            %mn 1
                            %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \boxed{\{0\leftrightarrow 1\}}
              %tr
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
                  %br/
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                        %mo ∅
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo{:stretchy => "false"} }
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %annotation{:encoding => "application/x-tex"} \Big\{ \varnothing,\, \{0\} = \{1\}  \;\Big\}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                        %mspace{:width => "thickmathspace"}
                        %mn 0
                        %mo =
                        %mn 1
                        %mspace{:width => "thickmathspace"}
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                      %annotation{:encoding => "application/x-tex"} \Big\{\; 0 = 1 \;\Big\}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %menclose{:notation => "box"}
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \boxed{*}
          %p#NoArrowsFromClosedPoints
            Notice here how in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mo →
                  %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \big\{\; 0 \rightarrow 1 \;\}
            the point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            is not
            %a.existingWikiWord{:href => "/nlab/show/closed+point"} closed
            (as there do emanate arrows form it) while the point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} {1}
            is
            %a.existingWikiWord{:href => "/nlab/show/closed+point"} closed
            (as no arrows emanate from it).
          %p
            Under this identitification of
            %a.existingWikiWord{:href => "/nlab/show/finite+topological+spaces"} finite topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with
            %a.existingWikiWord{:href => "/nlab/show/preordered+sets"} preordered sets
            regarded as
            %a.existingWikiWord{:href => "/nlab/show/thin+categories"} thin categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(X)
            %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
            between topological spaces correspond to
            %a.existingWikiWord{:href => "/nlab/show/functors"} functors
            between their specialization preorders:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                    %mstyle{:mathcolor => "blue"}
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mtext continuous function betw.
                        %mrow
                          %mtext finite topological spaces
                      %mpadded{:lspace => "-50%width", :width => "0"}
                        %mphantom
                          %mrow
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %msub
                                      %mo{:stretchy => "false"} |
                                      %mrow
                                        %msub
                                          %mo{:stretchy => "false"} |
                                          %mrow
                                            %msub
                                              %mo{:stretchy => "false"} |
                                              %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mtext corresponds to
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mrow
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %mi Spec
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                      %mi Spec
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %mstyle{:mathcolor => "blue"}
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mtext functor between
                        %mrow
                          %mtext specialization orders
                      %mpadded{:lspace => "-50%width", :width => "0"}
                        %mphantom
                          %mrow
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mo{:stretchy => "false"} |
                                  %mrow
                                    %msub
                                      %mo{:stretchy => "false"} |
                                      %mrow
                                        %msub
                                          %mo{:stretchy => "false"} |
                                          %mrow
                                            %msub
                                              %mo{:stretchy => "false"} |
                                              %mo{:stretchy => "false"} |
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\overset{
                  \\color{blue}
                  {
                  \\text{continuous function betw.}
                  \\atop
                  \\text{finite topological spaces}
                  }
                  \\mathclap{\phantom{\vert_{\vert_{\vert_{\vert_{\vert_{\vert}}}}}}}
                  }{
                  X \xrightarrow{f} Y
                  }
                  \\;\;\;\;\;\;\;\;\;
                  \\text{corresponds to}
                  \\;\;\;\;\;\;\;\;\;
                  \\overset{
                  \\color{blue}
                  {
                  \\text{functor between}
                  \\atop
                  \\text{ specialization orders }
                  }
                  \\mathclap{\phantom{\vert_{\vert_{\vert_{\vert_{\vert_{\vert}}}}}}}
                  }{
                  Spec(X) \xrightarrow{Spec(f)} Spec(Y)
                  }
                  \\mathrlap{\,.}
          %p
            With specialization orders denoted by their generating graphs as before, and using that there is at most one morphism for every ordered pair of objects, we may specify such functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spec(f)
            simply by labeling each object in their
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            by the same symbol as its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
          %p For example
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %mspace{:width => "thinmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo →
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %mspace{:width => "thinmathspace"}
                  %mn 0
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mn 1
                  %mspace{:width => "thinmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"}
                  \\big\{\, 0 \,\big\}
                  \\;\;\;
                  \\xrightarrow{\phantom{---}}
                  \\;\;\;
                  \\big\{\, 0,\, 1  \,\big\}
          %p
            is to denote the
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            between
            %a.existingWikiWord{:href => "/nlab/show/specialization+orders"} specialization orders
            of
            %a.existingWikiWord{:href => "/nlab/show/discrete+spaces"} discrete spaces
            with a single and with two elements, respectively, which takes the point denoted “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            ” on the left to the point denoted by the same symbol “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            ” on the right.
          %p#NotationForFiniteTopologicalSpaces In this notation, the following shows the canonical functors between the four examples of specialization orders from the above list:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mphantom
                        %mo ←
                      %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                    %mstyle{:mathcolor => "blue"}
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mtext discrete space
                        %mrow
                          %mphantom
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo →
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mrow
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mo →
                      %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                    %mstyle{:mathcolor => "blue"}
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mtext Sierpinski space
                        %mrow
                          %mphantom
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo →
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mrow
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mo ↔
                      %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                    %mstyle{:mathcolor => "blue"}
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mtext codiscrete space
                        %mrow
                          %mphantom
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo →
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mrow
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                      %mspace{:width => "thickmathspace"}
                      %mn 0
                      %mo =
                      %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                    %mstyle{:mathcolor => "blue"}
                      %mfrac{:linethickness => "0"}
                        %mrow
                          %mtext point space
                        %mrow
                          %mphantom
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mpadded{:width => "0"}
                    %mrow
                      %mspace{:width => "thinmathspace"}
                      %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\overset{
                  \\color{blue}
                  {
                  \\text{discrete space}
                  \\atop
                  \\phantom{-}
                  }
                  }{
                  \\Big\{\;
                  0
                  \\phantom{\leftarrow}
                  1
                  \\;\Big\}
                  }
                  \\;\;\xrightarrow{\phantom{---}}\;\;
                  \\overset{
                  \\color{blue}
                  {
                  \\text{Sierpinski space}
                  \\atop
                  \\phantom{-}
                  }
                  }{
                  \\Big\{\;
                  0
                  \\rightarrow
                  1
                  \\;\Big\}
                  }
                  \\;\;\xrightarrow{\phantom{---}}\;\;
                  \\overset{
                  \\color{blue}
                  {
                  \\text{codiscrete space}
                  \\atop
                  \\phantom{-}
                  }
                  }{
                  \\Big\{\;
                  0
                  \\leftrightarrow
                  1
                  \\;\Big\}
                  }
                  \\;\;\xrightarrow{\phantom{---}}\;\;
                  \\overset{
                  \\color{blue}
                  {
                  \\text{point space}
                  \\atop
                  \\phantom{-}
                  }
                  }{
                  \\Big\{\;
                  0
                  \=
                  1
                  \\;\Big\}
                  }
                  \\mathrlap{\,.}
          %p#ExampleMapIdentifyingThreePoints
            Notice here the role of the equality sign: In the denotation of a functor as above, arrows may be sent to equality signs (but not the other way around): This corresponds to the corresponding
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            “gluing” these points, in that it is (at least locally) the
            %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
            onto the
            %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient
            by the subset of points that are being identified.
          %p For example, the following denotes the functor corresponding to a map that “glues” three points to each other:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo {
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi U
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi V
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi x
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi b
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo }
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mo →
                    %mphantom
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo −
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi U
                          %mtd
                            %mstyle{:mathcolor => "red"}
                              %mo =
                          %mtd
                            %mi x
                          %mtd
                            %mstyle{:mathcolor => "red"}
                              %mo =
                          %mtd
                            %mi V
                        %mtr
                          %mtd
                          %mtd
                            %mo ↙
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi a
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi b
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo }
                %annotation{:encoding => "application/x-tex"}
                  \\left\{
                  \\;\;
                  \\array{
                  \&amp; &amp; U &amp;&amp; &amp;&amp; V
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  a &amp;&amp; &amp;&amp; x &amp;&amp; &amp;&amp; b
                  }
                  \\;\;
                  \\right\}
                  \\;\;\;\;\;\;\;\;
                  \\xrightarrow{\phantom{------}}
                  \\;\;\;\;\;\;\;\;
                  \\left\{
                  \\;\;
                  \\array{
                  \&amp;&amp; U  &amp;\color{red}=&amp; x &amp;\color{red}=&amp; V
                  \\\
                  \&amp; \swarrow &amp; &amp;&amp; &amp;&amp; &amp; \searrow
                  \\\
                  a &amp; &amp; &amp;&amp;  &amp;&amp;  &amp;&amp;   b
                  }
                  \\;\;
                  \\right\}
          %p In this notation, the open subsets of the domain are
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} {
                  %mi U
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi V
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ,
                  %mi U
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi V
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi U
                  %mo ,
                  %mi x
                  %mo ,
                  %mi V
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ,
                  %mi U
                  %mo ,
                  %mi x
                  %mo ,
                  %mi V
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{\{U\}, \{V\}, \{a,U\}, \{V,b\}, \{U,x,V\}\},\{a,U,x,V,b\}\}
          %p
            In the codomain, points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            are closed, and the only point left is open.
          %h2#SeparationOfSubsets Separation of subsets
          %p
            Here we describe how topological separation of
            %em
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            may be expressed in terms of factorizations of their joint
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+function"} characteristic function
          %p
            In all of the following,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            denotes a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mspace{:width => "thickmathspace"}
                  %mo ⊂
                  %mspace{:width => "thickmathspace"}
                  %mi S
                %annotation{:encoding => "application/x-tex"}
                  F,\,G \;\subset\; S
          %p
            a
            %a.existingWikiWord{:href => "/nlab/show/pair"} pair
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
          %h3#disjoint Disjoint
          %p
            We say that a pair of subsets is
            %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
            if their
            %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
            is
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
          #eq:APairOfDisjointSubsets.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo ⊂
                  %mspace{:width => "thinmathspace"}
                  %mi S
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi F
                  %mo ∩
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mo ∅
                %annotation{:encoding => "application/x-tex"}
                  F,\, G \,\subset\, S
                  \\,,
                  \\;\;\;\;
                  F \cap G \,=\, \varnothing
          %p
            This situation
            %a.maruku-eqref{:href => "#eq:APairOfDisjointSubsets"} (3)
            may equivalently be expressed by a
            %em
              %a.existingWikiWord{:href => "/nlab/show/characteristic+function"} characteristic
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            to the
            %a.existingWikiWord{:href => "/nlab/show/codiscrete+topological+space"} codiscrete topological space
            of 3 elements. We will suggestively denote these three elements by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi F
                  %annotation{:encoding => "application/x-tex"} e_F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi G
                %annotation{:encoding => "application/x-tex"} e_G
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mo ∅
                  %annotation{:encoding => "application/x-tex"} e_\varnothing
            %a{:href => "#BackgroundAndNotation"} above
            notation the codiscrete topology on them reads like this:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CoDisc
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi e
                    %mi F
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi e
                    %mi F
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi e
                    %mo ∅
                  %mo{:stretchy => "false"} }
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msub
                    %mi e
                    %mi F
                  %mo ↔
                  %msub
                    %mi e
                    %mi G
                  %mo ↔
                  %msub
                    %mi e
                    %mo ∅
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CoDisc
                  \\big(
                  \\{ e_F ,\, e_F ,\, e_{\varnothing} \}
                  \\big)
                  \\;\;
                  \=
                  \\;\;
                  \\big\{
                  e_F \leftrightarrow e_G \leftrightarrow e_\varnothing
                  \\big\}
                  \\,.
          %p
            Namely, any function to such a
            %a.existingWikiWord{:href => "/nlab/show/codiscrete+space"} codiscrete space
            is continuous, and any function to the set with 3 elements partitions its
            %a.existingWikiWord{:href => "/nlab/show/domain"} domain
            into the
            %a.existingWikiWord{:href => "/nlab/show/disjoint"} disjoint
            %a.existingWikiWord{:href => "/nlab/show/preimages"} preimages
            of these three elements, which we may regard as a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi G
                %annotation{:encoding => "application/x-tex"} F, G
            of
            %a.existingWikiWord{:href => "/nlab/show/disjoint+subsets"} disjoint subsets
            and their
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∖
                    %mo{:stretchy => "false"} {
                    %mi F
                    %mo ∪
                    %mi G
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S \setminus \{F \cup G\}
          #eq:CharacteristicFunctionForPairOfDIsjointSubsets.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi S
                            %mrow
                              %mi F
                              %mo ,
                              %mi G
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mi S
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                          %msub
                            %mi e
                            %mi F
                          %mo ↔
                          %msub
                            %mi e
                            %mi G
                          %mo ↔
                          %msub
                            %mi e
                            %mo ∅
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi x
                        %mtd
                          %mo ↦
                        %mtd
                          %mrow
                            %mo {
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi e
                                      %mi F
                                  %mtd
                                    %mo{:stretchy => "false"} |
                                  %mtd
                                    %mi x
                                    %mo ∈
                                    %mi F
                                %mtr
                                  %mtd
                                    %msub
                                      %mi e
                                      %mi G
                                  %mtd
                                    %mo{:stretchy => "false"} |
                                  %mtd
                                    %mi x
                                    %mo ∈
                                    %mi G
                                %mtr
                                  %mtd
                                    %msub
                                      %mi e
                                      %mo ∅
                                  %mtd
                                    %mo{:stretchy => "false"} |
                                  %mtd
                                    %mi otherwise
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  S_{F,G}
                  \&amp;\colon&amp;
                  S
                  \&amp;\longrightarrow&amp;
                  \\big\{
                  e_F \leftrightarrow e_G \leftrightarrow e_{\varnothing}
                  \\big\}
                  \\\
                  \&amp;&amp;
                  x
                  \&amp;\mapsto&amp;
                  \\left\{
                  \\array{
                  e_F &amp;\vert&amp; x \in F
                  \\\
                  e_G &amp;\vert&amp; x \in G
                  \\\
                  e_\varnothing &amp;\vert&amp; otherwise
                  }
                  \\right.
                  }
          %p
            We may now encode topological separation properties of the two subsets in terms of factorizations (hence liftings) of this their
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+function"} characteristic function
          %p
            Often
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            will be points (identified with their
            %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
            subsets); in that case, one usually says
            %em distinct
            in place of
            = succeed "." do
              %em disjoint
          %p
            Often
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            will be closed sets; notice that disjoint closed sets are automatically separated, while a closed set and a point, if disjoint, are automatically topologically disjoint.
          %p
            To express the assumption that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is closed, we may modify the topology on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi e
                    %mi F
                  %mo ,
                  %msub
                    %mi e
                    %mo ∅
                  %mo ,
                  %msub
                    %mi e
                    %mi G
                %annotation{:encoding => "application/x-tex"} \{e_F,e_{\varnothing}, e_G
            and make the points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi F
                %annotation{:encoding => "application/x-tex"} e_F
            and/or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi e
                    %mi G
                %annotation{:encoding => "application/x-tex"} e_G
            closed as appropriate.
          %h3#TopologicallyDisjoint Topologically disjoint
          %p
            We say that a disjoint pair of subsets
            %a.maruku-eqref{:href => "#eq:APairOfDisjointSubsets"} (3)
            is
            %strong topologically disjoint
            if there exists a
            %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            of one set that is
            %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
            from the other set:
          #eq:PairOfTopologicallyDisjointSubsets.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi G
                  %mspace{:width => "thickmathspace"}
                  %mtext are topologically disjoint
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %munder
                    %mo ∃
                    %mrow
                      %mi U
                      %munder
                        %mo ⊇
                        %mpadded{:lspace => "-50%width", :width => "0"}
                          %mi nbhd
                      %mi F
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi U
                  %mo ∩
                  %mi G
                  %mo =
                  %mo ∅
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi or
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %munder
                    %mo ∃
                    %mrow
                      %mi V
                      %munder
                        %mo ⊇
                        %mpadded{:lspace => "-50%width", :width => "0"}
                          %mi nbhd
                      %mi G
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi F
                  %mo ∩
                  %mi V
                  %mo =
                  %mo ∅
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F, G \;\text{are topologically disjoint}
                  \\;\;\;\;\;\;\;\;\;
                  \\Leftrightarrow
                  \\;\;\;\;\;\;\;\;\;
                  \\Big(
                  \\underset
                  {
                  U \underset{\mathclap{nbhd}}{\supseteq} F
                  }
                  {\exists}
                  \\;\;
                  U \cap G = \varnothing
                  \\Big)
                  \\;\;or\;\;
                  \\Big(
                  \\underset
                  {
                  V \underset{\mathclap{nbhd}}{\supseteq} G
                  }
                  {\exists}
                  \\;\;
                  F \cap V = \varnothing
                  \\Big)
                  \\,.
          %p (Notice that topologically disjoint sets must be disjoint.)
          %p
            The topological separation condition
            %a.maruku-eqref{:href => "#eq:PairOfTopologicallyDisjointSubsets"} (5)
            on a pair of disjoint subsets means equivalently that their
