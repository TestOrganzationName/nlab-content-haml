                  %mo →
                  %msub
                    %mi Λ
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f \;\;\;\,&amp;solb;\,\;\;\; \Lambda_2\to \Lambda_1
            implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi ⧄
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Λ
                    %mrow
                      %mn 2
                      %mi n
                  %mo →
                  %msub
                    %mi Λ
                    %mi n
                %annotation{:encoding => "application/x-tex"} f \;\;\;\,&amp;solb;\,\;\;\; \Lambda_{2n}\to \Lambda_n
            and, passing to the limit,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Λ
                      %mn ∞
                    %mo →
                    %msub
                      %mi Λ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} f \;\;\;\,&amp;solb;\,\;\;\; \Lambda_\infty\to \Lambda_1
          %p
            Iterating the lifting property
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 4
                %annotation{:encoding => "application/x-tex"} T_4
            implies that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Λ
                    %mn ∞
                  %mo →
                  %msub
                    %mi Λ
                    %mn 1
                  %mo ∈
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi Λ
                    %mn 2
                  %mo →
                  %msub
                    %mi Λ
                    %mn 1
                  %msup
                    %mo{:stretchy => "false"} }
                    %mi lr
                  %mo .
                %annotation{:encoding => "application/x-tex"} \Lambda_\infty\to  \Lambda_1 \in \{ \Lambda_2 \to \Lambda_1\}^{lr}.
          %p
            The standard arguments from the proof of Urysohn lemma give the following relation between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Λ
                    %mn ∞
                %annotation{:encoding => "application/x-tex"} \Lambda_\infty
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi R
                  %annotation{:encoding => "application/x-tex"} \mathbf{R}
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %msub
                        %mo ∨
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi e
                        %mi F
                      %mo ↔
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo ↔
                      %msub
                        %mi e
                        %mi G
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} {[0,1]}\vee_{\{0,1\}} \{e_F\leftrightarrow 0, 1\leftrightarrow e_G\}
                are retracts of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Λ
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} \Lambda_\infty
            %li
              %p
                The map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Λ
                        %mn ∞
                      %mo →
                      %msub
                        %mi Λ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Lambda_\infty\to \Lambda_1
                factors as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Λ
