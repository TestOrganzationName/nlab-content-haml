              %path{:d => "M -2.487439 2.868539 C -2.030407 1.145883 -1.018689 0.333383 0.0008425 0.00135125 C -1.018689 -0.334586 -2.030407 -1.147086 -2.487439 -2.869742 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 79.44447, 10.41932)"}
              %path{:d => "M 34.277344 25.799656 L 34.277344 -16.887844 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 95.75, 53.702)"}
              %path{:d => "M -2.48481 2.867281 C -2.031685 1.148531 -1.019966 0.336031 -0.000435 0.00009375 C -1.019966 -0.335844 -2.031685 -1.148344 -2.48481 -2.871 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(0, 1, 1, 0, 130.02725, 70.82856)"}
              %path{:d => "M -74.601562 -36.419094 L -27.875 -36.419094 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 95.75, 53.702)"}
              %path{:d => "M -2.486254 2.867544 C -2.033129 1.148794 -1.02141 0.336294 -0.00187875 0.00035625 C -1.02141 -0.335581 -2.033129 -1.148081 -2.486254 -2.870737 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 68.11516, 90.12145)"}
              %path{:d => "M -74.601562 -29.309719 L 7.664062 25.534031 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-dasharray" => "3.34735 1.91277", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 95.75, 53.702)"}
              %path{:d => "M -2.486021 2.86716 C -2.032089 1.146633 -1.019079 0.335109 0.000441318 -0.00186424 C -1.020175 -0.335547 -2.032134 -1.149199 -2.4883 -2.868625 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(0.832, -0.55469, -0.55469, -0.832, 103.61188, 28.03385)"}
              %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                %use{:x => "54.962", "xlink:href" => "#aRdoqPVabL9VLVF49tD1Fmy5_tA=-glyph-5-1", :y => "52.643"}
          %p
            Indeed, the disjoint closed subsets are the preimges of the closed points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            under the bottom horizontl arrow, and their separating neighbourhoods are the preimages of open subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %munder
                    %mrow
                    %mi x
                  %mo ↙
                  %mover
                    %mrow
                    %mi U
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"}
                  \\big\{\underset{x}{}{\swarrow}
                  \\overset{U}{}\big\}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                    %mover
                      %mrow
                      %mi V
                    %mo ↘
                    %munder
                      %mrow
                      %mi y
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                  %annotation{:encoding => "application/x-tex"} \big\{\overset{V}{}{\searrow}\underset{y}{}\big\}
          %p
            In fact, by
            %a.existingWikiWord{:href => "/nlab/show/Urysohn%27s+lemma"} Urysohn's lemma
            a space is normal if and only if any two disjoint closed sets can be separated by a continuous function, i.e.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⟶
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi ⧄
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %msub
                    %mo ∨
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ′
                  %mo ↔
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ↔
                  %mn 1
                  %mo ′
                  %mo{:stretchy => "false"} }
                  %mo ⟶
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo =
                  %mn 0
                  %mo ′
                  %mo ↘
                  %msub
                    %mi e
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                  %mo ↙
                  %mn 1
                  %mo =
                  %mn 1
                  %mo ′
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\emptyset \longrightarrow  {X}
                  \\;\;\;\,&amp;solb;\,\;\;\;
                  [0,1]\vee_{\{0,1\}} \{0'\leftrightarrow 0, 1\leftrightarrow 1'\}
                  \\longrightarrow  \{0=0'{\searrow}e_{[0,1]}{\swarrow}1=1'\}
          %p
            Here in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %msub
                    %mo ∨
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ′
                  %mo ↔
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo ↔
                  %mn 1
                  %mo ′
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} [0,1]\vee_{\{0,1\}} \{0'\leftrightarrow 0, 1\leftrightarrow 1'\}
            the points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ′
                  %mo ,
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0',0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo ′
                %annotation{:encoding => "application/x-tex"} 1,1'
            are topologically indistinguishable,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0,1]
            goes to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} e_{[0,1]}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo ′
                %annotation{:encoding => "application/x-tex"} 0,0'
            map to point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo =
                    %mn 0
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} 0=0'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo ′
                %annotation{:encoding => "application/x-tex"} 1,1'
            map to point
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo =
                    %mn 1
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} 1=1'
          %h3#normal_hausdorff_spaces_
            Normal Hausdorff spaces (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mn 4
                %annotation{:encoding => "application/x-tex"} T_4
            )
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is normal Hausdorff, or T4, if it is both T1 and normal. Every normal Hausdorff space is both Tychonoff and normal regular.
          %h3#completely_normal_spaces Completely normal spaces
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %em completely or heriditarily normal
            if any two separated sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            are separated by neighbourhoods
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ⊃
                  %mi A
                %annotation{:encoding => "application/x-tex"} U\supset A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo ⊃
                  %mi B
                %annotation{:encoding => "application/x-tex"} V\supset B
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            do not intersect, i.e.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⟶
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi ⧄
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} {
                  %munder
                    %mrow
                    %mi X
                  %mo ↙
                  %mover
                    %mrow
                    %mrow
                      %mi A
                      %mo ↔
                      %mi U
                  %mo ↘
                  %munder
                    %mrow
                    %mrow
                      %mi U
                      %mo ′
                  %mo ↙
                  %mover
                    %mrow
                    %mi W
                  %mo ↘
                  %munder
                    %mrow
                    %mrow
                      %mi V
                      %mo ′
                  %mo ↙
                  %mover
                    %mrow
                    %mrow
                      %mi V
                      %mo ↔
                      %mi B
                  %mo ↘
                  %munder
                    %mrow
                    %mi X
                  %mo{:stretchy => "false"} }
                  %mo ⟶
                  %mo{:stretchy => "false"} {
                  %mi U
                  %mo =
                  %mi U
                  %mo ′
                  %mo ,
                  %mi V
                  %mo ′
                  %mo =
                  %mi V
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\emptyset \longrightarrow  {X}
                  \\;\;\;\,&amp;solb;\,\;\;\;
                  \\{
                  \\underset{X}{}{\swarrow}
                  \\overset{A\leftrightarrow U}{}
                  {\searrow} \underset{U'}{}{\swarrow}
                  \\overset{W}{} {\searrow}
                  \\underset{V'}{}{\swarrow}
                  \\overset{V\leftrightarrow B}{}{\searrow}
                  \\underset{X}{} \} \longrightarrow  \{U=U',V'=V\}
          %p Every completely normal space is also normal.
          %p
            It is easy to check that a closed inclusion into a heridarily normal space has the same lifting property. As left lifting property is stable under colimits, this implies that a filtered colimit (transfinite composition) of heriditarily normal spaces is heriditarily normal. Compare this argument to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimits+of+normal+spaces"} colimits of normal spaces
          %h3#perfectly_normal_spaces Perfectly normal spaces
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %a.existingWikiWord{:href => "/nlab/show/perfectly+normal+topological+space"} perfectly normal
            if any two disjoint closed sets are precisely separated by a continuous function, i.e.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mo ⟶
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi ⧄
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ↙
                  %mi X
                  %mo ↘
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\emptyset\longrightarrow {X}
                  \\;\;\;\,&amp;solb;\,\;\;\;
                  [0,1]\longrightarrow \{0{\swarrow}X{\searrow}1\}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0,1)
            goes to the open point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            goes to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            goes to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
          %p Every perfectly normal space is also completely normal.
          %h2#applications Applications.
          %p The following notation and terminology helps to discuss applications.
          %h3#quillen_negation Quillen negation
          %p
            For a class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            of morphisms in a category, its
            %em left Quillen negation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mi ⧄
                      %mi l
                %annotation{:encoding => "application/x-tex"} P^{&amp;solb; l}
            with respect to the lifting property, respectively its
            %em right Quillen negation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi P
                      %mrow
                        %mi ⧄
                        %mi r
                  %annotation{:encoding => "application/x-tex"} P^{&amp;solb; r}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi P
                    %mrow
                      %mi ⧄
                      %mi l
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi i
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mo :
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mo ∀
                  %mi p
                  %mo ∈
                  %mi P
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi i
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi ⧄
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %msup
                    %mi P
                    %mrow
                      %mi ⧄
                      %mi r
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi p
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mo :
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mo ∀
                  %mi i
                  %mo ∈
                  %mi P
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi i
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi ⧄
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi p
                  %mo{:stretchy => "false"} }
                  %mo ,
                  %msup
                    %mi P
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} lr
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi P
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} lrl
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} rlr
                  %mo ,
                  %mo .
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P^{&amp;solb; l} := \{ i \,\,:\,\, \forall p\in P\,\, i\;\;\;\,&amp;solb;\,\;\;\; p\},
                  P^{&amp;solb;r} := \{ p \,\,:\,\, \forall i\in P\,\, i\;\;\;\,&amp;solb;\,\;\;\; p\}, P^\lr:=(P^\lrl)^\rlr,..
          %p
            As the terminology might suggest, taking the Quillen negation of a class/property
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is a simple way to define a class of morphisms excluding non-isomorphisms from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %h3#good_behaviour_under_colimits Good behaviour under (co)limits
          %p Reformulations in terms of lifting properties clarify behaviour with respect to (co)limits, as notions defined by lifting properties are closed under (co)limits.
          %p
            For example, as remarked above, it is easy to check that a closed inclusion into a heridarily normal space has the same lifting property; this is not true for the lifting property defining normality. Hence, filtered colimit (transfinite composition) of closed inclusions of heriditarily normal spaces is heriditarily normal. Compare this argument to what is given in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/colimits+of+normal+spaces"} colimits of normal spaces
          %p
            The same argument proves the
            = succeed "." do
              %a{:href => "Tychonoff+theorem#ProofViaTaimanovTheoremAndLiftingProperties"} Tychonoff theorem that a product of compact spaces is compact
          %h3#reflection_and_weak_factorisation_systems Reflection and weak factorisation systems
          %p
            Lifting properties give rise to reflection and weak factorisation systems. For example, each map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mi o
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} X\to\{o\}
            decomposes as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi T
                        %mi i
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi rl
                  %mi X
                  %mo ′
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi T
                        %mi i
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi l
                  %mo{:stretchy => "false"} {
                  %mi o
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} X \xrightarrow{(T_i)^{&amp;solb;rl}} X'\xrightarrow{(T_i)^{&amp;solb;l}}\{o\}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mi i
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (T_i)
            denotes the morphism appearing in the definition of axiom
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mi i
                  %annotation{:encoding => "application/x-tex"} T_i
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mn 0
                    %mo ,
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i0,1
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/separation+axioms#Reflection"} separation axioms#Reflection
          %p
            In terms of Quillen negation we can understand the
            %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+space#kSpacesAreTheColimitsInTopOfCompactHausdorffSpaces"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              \-coreflection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi kTop
                    %mo →
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} kTop\to Top
              from the category of compactly generated spaces
            as follows.
          %p
            Let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi CHaus
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo =
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mo ∅
                    %mo →
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mo :
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi K
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mtext is compact Hausdorff
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} (CHaus)=\big(\{0,1\}\to\{0=1\}\cup\{\varnothing\to K\,\,:\,\,K\,\,\text{is compact Hausdorff}\,\}\big)
          %p
            First notice it holds
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi CHaus
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi ⧄
                            %mi r
                    %mi X
                  %annotation{:encoding => "application/x-tex"} k(X) \xrightarrow{(CHaus)^{&amp;solb;r}}X
          %p
            Now consider a decomposition of a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∅
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \varnothing\to X
            as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∅
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi CHaus
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi rl
                  %msub
                    %mi X
                    %mrow
                      %mi c
                      %mo .
                      %mi g
                      %mo .
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi CHaus
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi r
                  %mi X
                %annotation{:encoding => "application/x-tex"} \varnothing \xrightarrow{(CHaus)^{&amp;solb;rl}} X_{c.g.}\xrightarrow{(CHaus)^{&amp;solb;r}}X
          %p such that the latter arrow is injective.
          %p
            It is easy to see that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi c
                      %mo .
                      %mi g
                      %mo .
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi CHaus
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi r
                  %mi X
                %annotation{:encoding => "application/x-tex"} X_{c.g.}\xrightarrow{(CHaus)^{&amp;solb;r}}X
            means that a subspace of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi c
                      %mo .
                      %mi g
                %annotation{:encoding => "application/x-tex"} X_{c.g}
            is closed whenever it is closed in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and its intersection with every compact Hausdorff subsets of (the original topology on)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is closed (in the original topology on
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi c
                      %mo .
                      %mi g
                      %mo .
                %annotation{:encoding => "application/x-tex"} X_{c.g.}
            has all the same closed sets and possibly more, hence all the same open sets and possibly more.
          %p On the other hand,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∅
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi CHaus
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi rl
                  %msub
                    %mi X
                    %mrow
                      %mi c
                      %mo .
                      %mi g
                      %mo .
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi ⧄
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi CHaus
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi ⧄
                          %mi r
                  %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\varnothing \xrightarrow{(CHaus)^{&amp;solb;rl}} X_{c.g.}
                  \\,\,\,&amp;solb;\,\,\,\,
                  k(X)
                  \\xrightarrow{(CHaus)^{&amp;solb;r}}X
          %p
            hence the obvious map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi c
                      %mo .
                      %mi g
                      %mo .
                  %mo →
                  %mi k
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X_{c.g.}\to k(X)
            is continuous.
          %p
            Hence,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mrow
                      %mi c
                      %mo .
                      %mi g
                      %mo .
                %annotation{:encoding => "application/x-tex"} X_{c.g.}
            is isomorphic to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} k(X)
          %p
            Compare our proof of the following lemmas with the one given in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subspace+topology#pushout"} subspace topology#pushout
          #pushout.num_lemma
            %h6#lemma Lemma
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              of any (closed/open) subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo ↪
                    %mi B
                  %annotation{:encoding => "application/x-tex"} i \colon A \hookrightarrow B
              along any
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} f \colon A \to C
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo :
                      %mi C
                      %mo ↪
                      %mi D
                    %annotation{:encoding => "application/x-tex"} j: C \hookrightarrow D
          #transfinite.num_lemma
            %h6#lemma_2 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                  %annotation{:encoding => "application/x-tex"} \kappa
              be an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
              %a.existingWikiWord{:href => "/nlab/show/preorder"} preorder
              category, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi κ
                    %mo →
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} F: \kappa \to Top
              be a functor that preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/directed+colimits"} directed colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ≤
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(i \leq j)
              is a (closed/open) subspace inclusion for each morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≤
                    %mi j
                  %annotation{:encoding => "application/x-tex"} i \leq j
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mi colim
                      %mrow
                        %mi i
                        %mo ∈
                        %mi κ
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(0) \to colim_{i \in \kappa} F(i)
              is also a (closed/open) inclusion.
          %p
          .proof
            %h6 Proof
            %p This follows from the fact that being a (closed/open) inclusion is a left lifting property:
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi ∅
                        %mo ⟶
                        %mo{:stretchy => "false"} {
                        %mi o
                        %mo{:stretchy => "false"} }
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi rr
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo ↔
                        %mi y
                        %mo →
                        %mi c
                        %mo{:stretchy => "false"} }
                        %mo ⟶
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo =
                        %mi y
                        %mo =
                        %mi c
                        %mo{:stretchy => "false"} }
                        %msup
                          %mo{:stretchy => "false"} }
                          %mi l
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo ↔
                        %mi y
                        %mo ←
                        %mi c
                        %mo{:stretchy => "false"} }
                        %mo ⟶
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo =
                        %mi y
                        %mo =
                        %mi c
                        %mo{:stretchy => "false"} }
                        %msup
                          %mo{:stretchy => "false"} }
                          %mi l
                      %annotation{:encoding => "application/x-tex"} (\emptyset\longrightarrow \{o\})^{rr}=\{\{x\leftrightarrow y\rightarrow c\}\longrightarrow\{x=y=c\}\}^l=\{\{x\leftrightarrow y\leftarrow c\}\longrightarrow\{x=y=c\}\}^l
                  is the class of subsets, i.e. injective maps
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ↪
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A\hookrightarrow B
                  where the topology on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is induced from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo{:stretchy => "false"} {
                        %mi z
                        %mo ↔
                        %mi x
                        %mo ↔
                        %mi y
                        %mo →
                        %mi c
                        %mo{:stretchy => "false"} }
                        %mo ⟶
                        %mo{:stretchy => "false"} {
                        %mi z
                        %mo =
                        %mi x
                        %mo ↔
                        %mi y
                        %mo =
                        %mi c
                        %mo{:stretchy => "false"} }
                        %msup
                          %mo{:stretchy => "false"} }
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} lrl
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mo{:stretchy => "false"} {
                        %mi c
                        %mo{:stretchy => "false"} }
                        %mo ⟶
                        %mo{:stretchy => "false"} {
                        %mi o
                        %mo →
                        %mi c
                        %mo{:stretchy => "false"} }
                        %msup
                          %mo{:stretchy => "false"} }
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} lr
                      %annotation{:encoding => "application/x-tex"} \{ \{z\leftrightarrow  x\leftrightarrow  y\rightarrow c\}\longrightarrow\{z=x\leftrightarrow  y=c\} \}^\lrl  = \{\{c\}\longrightarrow \{o\rightarrow c\}\}^\lr
                  is the class of closed inclusions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊂
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A\subset B
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is closed
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo{:stretchy => "false"} {
                        %mi z
                        %mo ↔
                        %mi x
                        %mo ↔
                        %mi y
                        %mo ←
                        %mi c
                        %mo{:stretchy => "false"} }
                        %mo ⟶
                        %mo{:stretchy => "false"} {
                        %mi z
                        %mo =
                        %mi x
                        %mo ↔
                        %mi y
                        %mo =
                        %mi c
                        %mo{:stretchy => "false"} }
                        %msup
                          %mo{:stretchy => "false"} }
                          %mo{:lspace => "0em", :rspace => "thinmathspace"} lrl
                      %annotation{:encoding => "application/x-tex"} \{ \{z\leftrightarrow  x\leftrightarrow  y\leftarrow c\}\longrightarrow\{z=x\leftrightarrow  y=c\} \}^\lrl
                  is the class of open inclusions
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ⊂
                        %mi B
                      %annotation{:encoding => "application/x-tex"} A\subset B
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                  is open
            %p
          %h3#urysohn_lemma_and_tietze_extension_theorem Urysohn lemma and Tietze extension theorem.
          %p
            We now explain how to view the standard proof of the
            %a.existingWikiWord{:href => "/nlab/show/Urysohn+lemma"} Urysohn lemma
            in terms of lifting properties.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Λ
                    %mi n
                  %mo =
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %munder
                    %mrow
                    %mrow
                      %msub
                        %mi c
                        %mn 0
                  %mo ↙
                  %mover
                    %mrow
                    %mrow
                      %msub
                        %mi o
                        %mn 1
                  %mo ↘
                  %mi ⋯
                  %mo ↙
                  %mover
                    %mrow
                    %mrow
                      %msub
                        %mi o
                        %mi n
                  %mo ↘
                  %munder
                    %mrow
                    %mrow
                      %msub
                        %mi c
                        %mi n
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"}
                  \\Lambda_n=\big\{
                  \\underset{c_0}{} \swarrow
                  \\overset{o_1}{} \searrow \cdots \swarrow
                  \\overset{o_n}{} \searrow
                  \\underset{c_n}{} \big\}
            for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n\geq 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Λ
                    %mrow
                      %mn 2
                      %mo{:stretchy => "false"} (
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi Λ
                    %mrow
                      %mn 2
                      %mi n
                %annotation{:encoding => "application/x-tex"} \Lambda_{2({n+1})}\to \Lambda_{2n}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mrow
                      %mn 2
                      %mi i
                  %mo ↦
                  %msub
                    %mi c
                    %mi i
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi o
                    %mrow
                      %mn 2
                      %mi i
                      %mo +
                      %mn 1
                  %mo ,
                  %msub
                    %mi c
                    %mrow
                      %mn 2
                      %mi i
                      %mo +
                      %mn 1
                  %mo ,
                  %msub
                    %mi o
                    %mrow
                      %mn 2
                      %mi i
                      %mo +
                      %mn 2
                  %mo ↦
                  %msub
                    %mi o
                    %mi i
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mn 0
                  %mo ≤
                  %mi i
                  %mo ≤
                  %mi n
                  %mo −
                  %mn 1
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi c
                    %mrow
                      %mn 2
                      %mi n
                  %mo ↦
                  %msub
                    %mi c
                    %mi n
                  %mo ,
                %annotation{:encoding => "application/x-tex"} c_{2i}\mapsto c_i,\,\,\, o_{2i+1},c_{2i+1},o_{2i+2}\mapsto o_i,\,\,\, 0\leq i\leq n-1,\,\,\,c_{2n}\mapsto c_n,
          %p
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Λ
                    %mn ∞
                  %mo =
                  %msub
                    %mi lim
                    %mrow
                      %mi n
                      %mo →
                      %mn ∞
                  %msub
                    %mi Λ
                    %mrow
                      %msup
                        %mn 2
                        %mi n
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \Lambda_\infty=\lim_{n\to\infty} \Lambda_{2^n},
            be the limit in the category of topological spaces.
          %p
            In this notation normality (T4) is defined by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∅
                    %mo →
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thinmathspace"}
                    %mi ⧄
                    %mspace{:width => "thinmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Λ
                      %mn 2
                    %mo →
                    %msub
                      %mi Λ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \varnothing \to X \;\;\;\,&amp;solb;\,\;\;\; \Lambda_2\to \Lambda_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi ⧄
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Λ
