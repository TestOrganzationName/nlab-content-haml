                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mo ↘
                        %munder
                          %mrow
                          %mi V
                        %mo ↙
                        %mover
                          %mrow
                          %menclose{:notation => "box"}
                            %mi y
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    {[0,1]}\vee_{\{0,1\}} \{x\leftrightarrow 0, 1\leftrightarrow y\}
                    \\to
                    \\{\boxed{\overset{\boxed{x}}{}{\searrow}\underset{U}{}{\swarrow}\overset{\boxed{X}}{}
                    }\!\!\!\!\!\!\!
                    \\boxed{
                    {\,\,\,\,\,\,\searrow}\underset{V}{}{\swarrow}\overset{\boxed{y}}{}
                    }
                    \\}
          %h3#regular_spaces Regular spaces
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is
            %a.existingWikiWord{:href => "/nlab/show/regular+topological+space"} regular
            if, given any point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} {x}
            and closed subset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} {x}
            does not belong to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .maruku-equation
