                  %annotation{:encoding => "application/x-tex"} A \to X \;\;\;\,&amp;solb;\,\;\;\; [0,1]\vee_{\{0,1\}} \{e_F\leftrightarrow 0, 1\leftrightarrow e_G\}\to \{o\}
          %p
