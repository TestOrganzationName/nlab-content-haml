                        %mrow
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi e
                        %mi F
                      %mo ↔
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo ↔
                      %msub
                        %mi e
                        %mi G
                      %mo{:stretchy => "false"} }
                      %mo →
                      %msub
                        %mi Λ
                        %mn 2
                      %mo →
                      %msub
                        %mi Λ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \Lambda_\infty\to   {[0,1]}\vee_{\{0,1\}} \{e_F\leftrightarrow 0, 1\leftrightarrow e_G\}\to \Lambda_2 \to \Lambda_1
          %p
            Item (1) implies that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo →
                  %mi X
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thinmathspace"}
                  %mi ⧄
                  %mspace{:width => "thinmathspace"}
                  %mspace{:width => "thickmathspace"}
