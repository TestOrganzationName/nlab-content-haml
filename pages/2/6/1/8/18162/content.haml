          %p
            The separating closed neighbourhoods
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi U
                    %mo{:stretchy => "false"} ¯
                  %mo ⊃
                  %mi F
                %annotation{:encoding => "application/x-tex"} \bar U\supset F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi V
                    %mo{:stretchy => "false"} ¯
                  %mo ⊃
                  %mi B
                %annotation{:encoding => "application/x-tex"} \bar V\supset B
            are the preimages under the diagonal arrow of the closed neighbourhoods
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msub
                    %mi e
                    %mi F
                  %mo ↔
                  %msub
                    %mi e
                    %mi U
                  %mo →
                  %msub
                    %mi e
                    %mover
                      %mi U
                      %mo{:stretchy => "false"} ¯
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"}
                  \\big\{
                  e_F
                  \\leftrightarrow
                  e_U \rightarrow
                  e_{\bar U} \big\}
            of point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi F
                  %annotation{:encoding => "application/x-tex"} e_F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %msub
                    %mi e
                    %mover
                      %mi V
                      %mo{:stretchy => "false"} ¯
                  %mo ←
                  %msub
                    %mi e
                    %mi V
                  %mo ↔
                  %msub
                    %mi e
                    %mi G
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                %annotation{:encoding => "application/x-tex"}
                  \\big\{
                  e_{\bar V}
                  \\leftarrow
                  e_V
                  \\leftrightarrow
                  e_G
                  \\big\}
            of point
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi G
                  %annotation{:encoding => "application/x-tex"} e_G
          %h3#separated_by_a_function Separated by a function
          %p
            We say that two disjoint subsets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            are
            %strong separated by a function
            if there exists a continuous
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            on the space that maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                %annotation{:encoding => "application/x-tex"} 0
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            to
