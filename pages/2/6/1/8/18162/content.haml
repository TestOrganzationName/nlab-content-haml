                %annotation{:encoding => "application/x-tex"}
                  f_{e.d.}:= \boxed{
                  \\boxed{{}^{\boxed{u}}\!\! \searrow_{\,c_1}} \,\,\, \boxed{{}_{c_2}\swarrow^{\boxed{v}}}
