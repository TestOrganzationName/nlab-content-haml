                        %mspace{:width => "thinmathspace"}
                        %mspace{:width => "thinmathspace"}
                        %mo ↘
                        %munder
                          %mrow
                          %mi F
                  %mo{:stretchy => "false"} }
                  %mo ⟶
                  %mo{:stretchy => "false"} {
                  %mover
                    %mrow
                    %menclose{:notation => "box"}
                      %mrow
                        %mi x
                        %mo =
                        %mi X
                        %mo =
                        %mi U
                  %mo ↘
                  %munder
                    %mrow
                    %mi F
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\{x\} \longrightarrow  {X}
                  \\;\;\;\,&amp;solb;\,\;\;\;
                  \\{
                  \\boxed{
                  \\boxed{
                  \\overset{\boxed{x}}{}
                  \\searrow
                  \\underset{X}{} \swarrow
                  \\overset{\boxed{U}}{}
                  }\!\!\!\!\!\!\!
                  {\,\,\,\,\,\,\searrow\underset{F}{} }
                  }
                  \\}
                  \\longrightarrow
