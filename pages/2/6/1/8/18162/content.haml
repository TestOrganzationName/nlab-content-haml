          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi S
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} f:S\to [0,1]
            in a separating function as above, we may take the diagonal arrow defined as
          #eq:CharacteristicFunctiontoRForPairOfDIsjointSubsets.maruku-equation
            %span.maruku-eq-number (12)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi f
                          %mo ′
                        %mtd
                          %mo{:lspace => "verythinmathspace"} :
                        %mtd
                          %mi S
                        %mtd
                          %mo ⟶
                        %mtd
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi x
                        %mtd
                          %mo ↦
                        %mtd
                          %mrow
                            %mo {
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %mn 0
                                  %mtd
                                    %mo{:stretchy => "false"} |
                                  %mtd
                                    %mi x
                                    %mo ∈
                                    %mi F
                                %mtr
                                  %mtd
                                    %mn 1
                                  %mtd
                                    %mo{:stretchy => "false"} |
                                  %mtd
                                    %mi x
                                    %mo ∈
                                    %mi G
                                %mtr
                                  %mtd
                                    %mi f
