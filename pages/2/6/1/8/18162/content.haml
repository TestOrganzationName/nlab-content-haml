          %h3#TopologicallySeparated Topologically separated
          %p
            We say that a disjoint pair of subsets
            %a.maruku-eqref{:href => "#eq:APairOfDisjointSubsets"} (3)
            is
            %strong separated
            if each set has a
            %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
            that is
            %a.existingWikiWord{:href => "/nlab/show/disjoint+subset"} disjoint
            from the other set:
          #eq:PairOfSeparatedSubsets.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ,
                  %mi G
                  %mspace{:width => "thickmathspace"}
                  %mtext are topologically disjoint
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⇔
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %munder
                    %mo ∃
                    %mrow
                      %mi U
                      %munder
                        %mo ⊇
                        %mpadded{:lspace => "-50%width", :width => "0"}
                          %mi nbhd
                      %mi F
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi U
                  %mo ∩
                  %mi G
                  %mo =
                  %mo ∅
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi and
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %munder
                    %mo ∃
                    %mrow
                      %mi V
                      %munder
                        %mo ⊇
                        %mpadded{:lspace => "-50%width", :width => "0"}
                          %mi nbhd
                      %mi G
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mi F
                  %mo ∩
                  %mi V
                  %mo =
                  %mo ∅
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  F, G \;\text{are topologically disjoint}
                  \\;\;\;\;\;\;\;\;\;
                  \\Leftrightarrow
                  \\;\;\;\;\;\;\;\;\;
                  \\Big(
                  \\underset
                  {
                  U \underset{\mathclap{nbhd}}{\supseteq} F
                  }
                  {\exists}
                  ,\;
                  U \cap G = \varnothing
                  \\Big)
                  \\;\;and\;\;
                  \\Big(
                  \\underset
                  {
                  V \underset{\mathclap{nbhd}}{\supseteq} G
                  }
                  {\exists}
                  ,\;
                  F \cap V = \varnothing
                  \\Big)
                  \\,.
          %p (Notice that separated sets must be topologically disjoint and disjoint.)
          %p
