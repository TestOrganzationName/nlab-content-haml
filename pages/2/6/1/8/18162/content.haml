          %p
            Every completely Hausdorff space is also
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mn 2
                  %mfrac
                    %mn 1
                    %mn 2
                %annotation{:encoding => "application/x-tex"} T2\frac{1}{2}
            because there is a surjection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %msub
                      %mo ∨
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ↔
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ↔
                    %mi y
                    %mo{:stretchy => "false"} }
                    %mo →
                    %mo{:stretchy => "false"} {
                    %menclose{:notation => "box"}
                      %mrow
                        %mover
                          %mrow
                          %menclose{:notation => "box"}
                            %mi x
                        %mo ↘
                        %munder
                          %mrow
                          %mi U
                        %mo ↙
                        %mover
                          %mrow
                          %menclose{:notation => "box"}
                            %mi X
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %mspace{:width => "negativethinmathspace"}
                    %menclose{:notation => "box"}
                      %mrow
