                            %mi d
                            %mo .
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi l
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \varnothing \xrightarrow{ (f_{e.d.})^l } S
          %p
            In fact there is a proper morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi f
                    %mi proper
                %annotation{:encoding => "application/x-tex"} f_{proper}
            of finite spaces such that for compact Hausdorff spaces it holds
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi f
                          %mi proper
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi lr
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \xrightarrow { (f_{proper})^{lr} } X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi f
                    %mi proper
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi lr
                %annotation{:encoding => "application/x-tex"} (f_{proper})^{lr}
            is a class of proper maps containing (necessarily proper) maps of compact Hausdorff spaces.
