          %p
            Namely, now
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuity
            restricts the top map to be such that neither
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi x
                    %mi i
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %mi X
                %annotation{:encoding => "application/x-tex"} x_i \in\; X
            is contained in an
            %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
            that does not contain the other (this is the usual way to state the axiom): For if it were, then the
            %a.existingWikiWord{:href => "/nlab/show/pre-image"} pre-image
            of that open subset would be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mi i
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thinmathspace"}
                    %mo ⊂
                    %mspace{:width => "thinmathspace"}
                    %mi CoDsc
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \{x_i\} \,\subset\, CoDsc\big( \{0,1\} \big)
            %em not
            open
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:OpenSubsetsOfTheCodiscreteSpaceOnTwoElements"} (1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                %annotation{:encoding => "application/x-tex"} X_1
            is a
            %a.existingWikiWord{:href => "/nlab/show/T0-space"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} T_0
              \-space
            then any such top map must be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
          %p
            Note that
            %a.existingWikiWord{:href => "/nlab/show/codiscrete+space"} codiscrete space
            with two points is a simple example of not a
            = succeed "-space." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} T_0
          %p
            %br/
          %p Proceeding in this manner, one sees that the property
          %ul
            %li
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/T1-space"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi T
                            %mn 1
                        %annotation{:encoding => "application/x-tex"} T_1
                    \-space
          %p
            means equivalently that its unique map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mo *
                %annotation{:encoding => "application/x-tex"} X \to \ast
            to the
            %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
            has the
            %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
            against the unique map from the
            %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sierp
                  %annotation{:encoding => "application/x-tex"} Sierp
            = succeed "-space." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi Sierp
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi Opens
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi Sierp
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} {
                  %mo ∅
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo{:stretchy => "false"} }
                  %mo ,
