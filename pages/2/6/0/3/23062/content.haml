                %semantics
                  %mrow
                    %mn 1
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} 1 \subset G
              the result is the topological
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
          %p
          #GCWComplexesAreCofibrant.num_cor
            %h6 Corollary
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/G-CW+complex"} G-CW complex
              (being, by definition, a special
              %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
              in the generating cofibrations
              = succeed ")" do
                %a.maruku-eqref{:href => "#eq:GeneratingCofibrations"} (1)
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
              in the fine equivariant model structure.
          %p
            The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi TopSp
                    %mi Qu
                %annotation{:encoding => "application/x-tex"} TopSp_{Qu}
            enrichment of Prop.
            %a.maruku-ref{:href => "#BasicPropertiesOfTheFineModelStructure"}
            in fact underlies a model enrichment of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mi Act
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi TopSp
                    %mi Qu
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi fine
                %annotation{:encoding => "application/x-tex"} G Act(TopSp_{Qu})_{fine}
            over itself:
          %p
          #MonoidalModelCategoryStructure.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian
                %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
                structure)
              %br/
              The model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi TopSp
                      %mi Qu
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi fine
                  %annotation{:encoding => "application/x-tex"} G Act\big( TopSp_{Qu}\big)_{fine}
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#FineModelStructureOnGSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian
              %a.existingWikiWord{:href => "/nlab/show/monoidal+model+category"} monoidal model category
              in that it satisfies the
              %a.existingWikiWord{:href => "/nlab/show/pushout-product+axiom"} pushout-product axiom
              with respect to
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of (
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+space"}> cgwh
              )
              = succeed "-spaces." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          (Observe that the
          %a.existingWikiWord{:href => "/nlab/show/unit+axiom"} unit axiom
          is automatic, by
          = succeed "," do
            %a{:href => "monoidal+model+category#CaseOfCofibrantTensorUnit"} this Prop.
          %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
          – which here is the
          %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
          equipped with the
          %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial action
          – is clearly a
          = succeed "," do
            %a.existingWikiWord{:href => "/nlab/show/G-CW+complex"} G-CW complex
          = succeed "," do
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo ≃
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi G
                %annotation{:encoding => "application/x-tex"} \ast \simeq G/G
          = succeed "," do
            %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
          = succeed ".)" do
            %a.maruku-ref{:href => "#GCWComplexesAreCofibrant"}
          .proof
            %h6 Proof
            %p
              Prop.
              %a.maruku-ref{:href => "#MonoidalModelCategoryStructure"}
              seems to have been
              %a.existingWikiWord{:href => "/nlab/show/folklore"} folklore
              statement, based on the fact that the
              %a.existingWikiWord{:href => "/nlab/show/equivariant+triangulation+theorem"} equivariant triangulation theorem
              implies that
              %a.existingWikiWord{:href => "/nlab/show/products"} products
              of
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi H
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo ×
                    %mspace{:width => "thinmathspace"}
                    %mi G
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi H
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} G/H_2 \,\times\, G/H_2
              admit an
              = succeed "-structure" do
                %a.existingWikiWord{:href => "/nlab/show/G-CW+complex"} G-CW complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is assumed to be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
              have the structure of
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              with
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/group+actions"} group actions
              = succeed "," do
                %a{:href => "#DHLPS19"} DHLPS 2019, Prop. 1.1.3 (iii)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/proper+equivariant+homotopy+theory"} proper equivariant homotopy theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is not just a Lie group but a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              = succeed "-cofibrations\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞ℴ𝓂
                    %annotation{:encoding => "application/x-tex"} \mathcal{Com}
              = succeed "-cofibrations\u201D" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a{:href => "#DHLPS19"} DHLPS 19, Def. 1.1.2
              agree, since
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspaces+of+compact+Hausdorff+spaces+are+equivalently+compact+subspaces"} closed subspaces of compact Hausdorff spaces are equivalently compact subspaces
          %p
            Prop.
            %a.maruku-ref{:href => "#MonoidalModelCategoryStructure"}
            immediately implies (by
            = succeed "):" do
              %a{:href => "monoidal+model+category#InternalHomQuillenAdjunction"} this general Prop.
          #InternalHomQuillenAdjunction.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi G
                    %mi Act
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi TopSp
                      %mi Qu
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi fine
                  %annotation{:encoding => "application/x-tex"} X \,\in\, G Act\big(TopSp_{Qu}\big)_{fine}
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              which assigns
              %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
              out of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/conjugation+action"} conjugation action
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              together with the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of taking the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              (the
              %a.existingWikiWord{:href => "/nlab/show/k-ification"} k-ified
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/diagonal+action"} diagonal action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mi Act
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi TopSp
                      %mi Qu
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi fine
                    %munderover
                      %mrow
                        %msub
                          %mo ⊥
                          %mpadded{:width => "0"}
                            %mi Qu
                      %munder
                        %mo ⟶
                        %mrow
                          %mi Maps
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟵
                        %mrow
                          %mi X
                          %mo ×
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                    %mi G
                    %mi Act
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi TopSp
                      %mi Qu
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi fine
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo .
                  %annotation{:encoding => "application/x-tex"}
                    G Act\big( TopSp_{Qu}\big)_{fine}
                    \\underoverset
                    {\underset{Maps(X,-)}{\longrightarrow}}
                    {\overset{X \times (-)}{\longleftarrow}}
                    {\bot_{\mathrlap{Qu}}}
                    G Act\big( TopSp_{Qu}\big)_{fine}
                    \\mathrlap{\,.}
            %p
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Borel+model+structure"} Borel model structure
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
          %h2#references References
          %p The model structure itself was first discussed in:
          %ul
            %li#DwyerKan84
              %a.existingWikiWord{:href => "/nlab/show/William+Dwyer"}> William Dwyer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
              = succeed "," do
                %em Singular functors and realization functors
              = succeed ")" do
                %a{:href => "https://doi.org/10.1016/1385-7258(84)90016-7"} doi:10.1016/1385-7258(84)90016-7
          %p Further properties, such as cofibrant generation, properness, and topological enrichment and are established in:
          %ul
            %li#Guillou06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bert+Guillou"}> Bert Guillou
                , Prop. 3.12 in:
                = succeed "," do
                  %em A short note on models for equivariant homotopy theory
                = succeed "," do
                  %a{:href => "http://www.math.uiuc.edu/~bertg/EquivModels.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/GuillouEquivariantHomotopy.pdf", :title => "pdf"} pdf
            %li#Fausk08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Halvard+Fausk"}> Halvard Fausk
                , Prop. 2.11 in:
                = succeed "," do
                  %em Equivariant homotopy theory for pro-spectra
                = succeed "," do
                  %a{:href => "http://dx.doi.org/10.2140/gt.2008.12.103"} doi:10.2140/gt.2008.12.103
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math/0609635"} arXiv:math/0609635
            %li#GuillouMayRubin13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bertrand+Guillou"}> Bertrand Guillou
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+May"} Peter May
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rubin"} Jonathan Rubin
                = succeed "," do
                  %em Enriched model categories in equivariant contexts
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1307.4488"} arXiv:1307.4488
                = succeed ")" do
                  %a{:href => "https://dx.doi.org/10.4310/HHA.2019.v21.n1.a10"} doi:10.4310/HHA.2019.v21.n1.a10
            %li#Stephan13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marc+Stephan"}> Marc Stephan
                ,
                = succeed "," do
                  %em On equivariant homotopy theory for model categories
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/1308.0856"} arXiv:1308.0856
                = succeed ")" do
                  %a{:href => "https://dx.doi.org/10.4310/HHA.2016.v18.n2.a10"} doi:10.4310/HHA.2016.v18.n2.a10
            %li#Schwede18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
                , Prop. B.7 in:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Global+homotopy+theory"} Global homotopy theory
                %strong 34
                Cambridge University Press, 2018 (
                %a{:href => "https://doi.org/10.1017/9781108349161"}> doi:10.1017/9781108349161
                ,
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1802.09382"} arXiv:1802.09382
          %p
            In addition, the monoidal model category structure is made explicit (in the generality of
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/proper+equivariant+homotopy+theory"} proper equivariant homotopy theory
          %ul
            %li#DHLPS19
              %a.existingWikiWord{:href => "/nlab/show/Dieter+Degrijse"}> Dieter Degrijse
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Markus+Hausmann"} Markus Hausmann
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Wolfgang+L%C3%BCck"} Wolfgang Lück
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Irakli+Patchkoria"} Irakli Patchkoria
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"} Stefan Schwede
              = succeed "," do
                %em Proper equivariant stable homotopy theory
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1908.00779"} arXiv:1908.00779
          %p
            For more see
            %a{:href => "Elmendorf's+theorem#References"} the references
            at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Elmendorf%27s+theorem"} Elmendorf's theorem
