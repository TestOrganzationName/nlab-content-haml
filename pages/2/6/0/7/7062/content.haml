                %annotation{:encoding => "application/x-tex"} P(x)
            indexed by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi 𝕀
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{I}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/heterogeneous+identification+types"} heterogeneous identification types
            %a.existingWikiWord{:href => "/nlab/show/inductive+family"} inductive family
            of types or by using
            = succeed "." do
