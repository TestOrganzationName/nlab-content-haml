                  %annotation{:encoding => "application/x-tex"} J(t, x, x, \mathrm{refl}_A(x)) \equiv t(x)
            %p
          %p
          .proof
            %h6 Proof
            %p
              By path induction on the type family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi{:mathvariant => "normal"} toId
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(f(0), f(1), \mathrm{toId}_A(f))
              indexed by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} f:\mathbb{I} \to A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %mi 𝕀
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi f
                        %mo :
                        %mi 𝕀
                        %mo →
                        %mi A
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
