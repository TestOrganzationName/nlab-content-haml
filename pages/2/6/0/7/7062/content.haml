                  %annotation{:encoding => "application/x-tex"} \mathrm{inv}_{j(0), j(1)}(p):j(1) =_\mathbb{I} j(0)
              ,
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} refl
