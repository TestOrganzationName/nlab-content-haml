                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            implies that there are identities
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi β
