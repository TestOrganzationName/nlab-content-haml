                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %mi 𝕀
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} type
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathbb{I} \; \mathrm{type}}
          %p Introduction rules for the interval type:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
