          %h2#idea Idea
          %p
            The
            %em interval type
            is an
            %a.existingWikiWord{:href => "/nlab/show/axiom"} axiomatization
            of the cellular
            %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
            in the context of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %h2#definition Definition
          %p
            As a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
          %pre
            %code
              :preserve
                Inductive Interval : Type
                  | left : Interval
                  | right : Interval
                  | segment : Id Interval left right          %p
            This says that the type is inductive constructed from two
            %a.existingWikiWord{:href => "/nlab/show/terms"} terms
            in the interval, whose
            %a.existingWikiWord{:href => "/nlab/show/semantics"} interpretation
            is as the endpoints of the interval, together with a term in the
            %a.existingWikiWord{:href => "/nlab/show/identity+type"} identity type
            of paths between these two terms, which interprets as the 1-cell of the interval
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi left
                  %mover
                    %mo →
                    %mi segment
                  %mi right
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  left \stackrel{segment}{\to} right
                  \\,.
          %h3#induction_principle Induction principle
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/induction+principle"} induction principle
            for the interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            says that for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi I
                  %mo →
                  %mi Type
                %annotation{:encoding => "application/x-tex"} P:I\to Type
            equipped with point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi left
                  %mo ′
                  %mo :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi left
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} left' : P(left)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi right
                  %mo ′
                  %mo :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi right
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} right' : P(right)
            and a
            %a.existingWikiWord{:href => "/nlab/show/dependent+identification"} dependent identification
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi segment
                    %mo ′
                    %mo :
                    %mi left
                    %mo ′
                    %msubsup
                      %mo =
                      %mi P
                      %mi segment
                    %mi right
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} segment':left'=_P^{segment} right'
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mi I
                      %mo{:stretchy => "false"} )
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f:\prod_{(x:I)} P(x)
            such that:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi left
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi left
                  %mo ′
                  %mspace{:width => "2em"}
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi right
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi right
                  %mo ′
                  %mspace{:width => "2em"}
                  %msub
                    %mi apd
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi segment
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi segment
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f(left)=left' \qquad f(right)=right' \qquad apd_f(segment) = segment'
          %p
            and for every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi I
                  %mo ⊢
                  %mi g
                  %mo :
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo :
                      %mi I
                      %mo{:stretchy => "false"} )
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} y:I \vdash g:\prod_{(x:I)} P(x)
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi I
                  %mo ⊢
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi left
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi left
                  %mo ′
                  %mspace{:width => "2em"}
                  %mi y
                  %mo :
                  %mi I
                  %mo ⊢
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi right
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi right
                  %mo ′
                  %mspace{:width => "2em"}
                  %mi y
                  %mo :
                  %mi I
                  %mo ⊢
                  %msub
                    %mi apd
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi segment
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi segment
                  %mo ′
                %annotation{:encoding => "application/x-tex"} y:I \vdash g(y)(left)=left' \qquad y:I \vdash g(y)(right)=right' \qquad y:I \vdash apd_{g(y)}(segment) = segment'
          %p
            there is an identification
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi I
                    %mo ⊢
                    %mi f
                    %mo =
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y:I \vdash f = g(y)
          %p
            As a special case, its
            %a.existingWikiWord{:href => "/nlab/show/recursion+principle"} recursion principle
            says that given any type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            with points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi X
                %annotation{:encoding => "application/x-tex"} x:X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mo :
                  %mi X
                %annotation{:encoding => "application/x-tex"} y:X
            and an identification
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi x
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} p:x=y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi I
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f:I \to X
            with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi left
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi x
                  %mspace{:width => "2em"}
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi right
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi y
                  %mspace{:width => "2em"}
                  %msub
                    %mi ap
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi segment
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                %annotation{:encoding => "application/x-tex"} f(left)=x\qquad f(right)=y\qquad ap_f(segment)=p
          %h3#syntax Syntax
          %p The interval type is defined by the following rules:
          %p Formation rules for the interval type:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
