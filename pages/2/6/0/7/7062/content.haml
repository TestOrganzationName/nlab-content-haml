                      %mo :
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c_0:C
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mo :
                      %mi C
                    %annotation{:encoding => "application/x-tex"} c_1:C
            %li
              %p
                identifications
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mi p
                        %mo :
                        %msub
                          %mi c
                          %mn 0
                        %msub
                          %mo =
                          %mi C
                        %msub
                          %mi c
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} c_p:c_0 =_C c_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi q
                        %mn 0
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi 𝕀
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} q_0:f(c_0) =_\mathbb{I} 0
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi q
                        %mn 1
                      %mo :
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mi q
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi 𝕀
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} q_1:f(c_q) =_\mathbb{I} 1
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} ap
                          %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mi p
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathrm{ap}_f(c_p)
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi q
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} q_0
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi q
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} q_1
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                form a square
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                      %mtd
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 0
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mover
                          %mo =
                          %mrow
                            %msub
                              %mi{:mathvariant => "normal"} ap
                              %mi f
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi c
                              %mi p
                            %mo{:stretchy => "false"} )
                      %mtd
                        %mi f
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %mtd
                    %mtr
                      %mtd
                        %msub
                          %mi q
                          %mn 0
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                        %msub
                          %mi q
                          %mn 1
                    %mtr
                      %mtd
                      %mtd
                        %mn 0
                      %mtd
                        %munder
                          %mo =
                          %mi p
                      %mtd
                        %mn 1
                      %mtd
                    %mtr
                      %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{c}
                  \&amp; f(c_0) &amp; \overset{\mathrm{ap}_{f}(c_p)}= &amp; f(c_1) &amp;  \\
                  q_0 &amp; \Vert &amp;  &amp; \Vert &amp; q_1\\
                  \&amp; 0 &amp; \underset{p}= &amp; 1 &amp; \\
                  \\end{array}
          %ul
            %li an identification saying that the square commutes
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mi p
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi p
                  %mo{:stretchy => "false"} )
                  %mo •
                  %msub
                    %mi q
                    %mn 1
                  %msub
                    %mo =
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi 𝕀
                      %mi f
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} )
                  %msub
                    %mi q
                    %mn 0
                  %mo •
                  %mi p
                %annotation{:encoding => "application/x-tex"} q_p:\mathrm{ap}_f(c_p) \bullet q_1 =_{f(c_0) =_\mathbb{I} f(c_1)} q_0 \bullet p
          %p one can construct
          %ul
            %li a function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi 𝕀
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} g:\mathbb{I} \to C
          %ul
            %li
              a homotopy witnessing that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} sec
                    %mi g
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi 𝕀
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi 𝕀
                  %mi x
                %annotation{:encoding => "application/x-tex"} \mathrm{sec}_g:\prod_{x:\mathbb{I}} f(g(x)) =_\mathbb{I} x
          %p such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mn 0
                  %mspace{:width => "1em"}
                  %msub
                    %mi{:mathvariant => "normal"} sec
                    %mi g
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi q
                    %mn 0
                  %mspace{:width => "1em"}
                  %mi g
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mn 1
                  %mspace{:width => "1em"}
                  %msub
                    %mi{:mathvariant => "normal"} sec
                    %mi g
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi q
                    %mn 1
                  %mspace{:width => "1em"}
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi g
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi c
                    %mi p
                %annotation{:encoding => "application/x-tex"} g(0) \equiv c_0 \quad \mathrm{sec}_g(0) \equiv q_0 \quad g(1) \equiv c_1 \quad \mathrm{sec}_g(1) \equiv q_1 \quad \mathrm{ap}_{g}(p) \equiv c_p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mo =
                  %mrow
                    %mo (
                    %mi λ
                    %mi x
                    %mo :
                    %mi 𝕀
                    %mo .
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mi 𝕀
                        %mi x
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} sec
                      %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi p
                    %mo )
                  %mo ≡
                  %msub
                    %mi q
                    %mi p
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{=}\left(\lambda x:\mathbb{I}.\mathrm{refl}_{f(g(x)) =_\mathbb{I} x}(\mathrm{sec}_g(x)), 0, 1, p\right) \equiv q_p
          %p
            The last condition needs some explanation. Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            is a section of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∘
                  %mi g
                %annotation{:encoding => "application/x-tex"} f \circ g
            is
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/interval+type"} interval type
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi 𝕀
                  %mo →
                  %mi 𝕀
                %annotation{:encoding => "application/x-tex"} i:\mathbb{I} \to \mathbb{I}
            with homotopy
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo :
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi x
                      %mo :
                      %mi 𝕀
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi 𝕀
                  %mi x
                %annotation{:encoding => "application/x-tex"} j:\prod_{x:\mathbb{I}} i(x) =_\mathbb{I} x
          %p
            we have the following square for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi 𝕀
                  %annotation{:encoding => "application/x-tex"} x:\mathbb{I}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo :
                    %mi 𝕀
                  %annotation{:encoding => "application/x-tex"} y:\mathbb{I}
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi x
                    %msub
                      %mo =
                      %mi 𝕀
                    %mi y
                  %annotation{:encoding => "application/x-tex"} q:x =_\mathbb{I} y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                      %mtd
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mover
                          %mo =
                          %mrow
                            %msub
                              %mi{:mathvariant => "normal"} ap
                              %mi i
                            %mo{:stretchy => "false"} (
                            %mi q
                            %mo{:stretchy => "false"} )
                      %mtd
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                      %mtd
                    %mtr
                      %mtd
                        %mi j
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                      %mtd
                        %mo{:stretchy => "false"} ‖
                      %mtd
                        %mi j
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                    %mtr
                      %mtd
                      %mtd
                        %mi x
                      %mtd
                        %munder
                          %mo =
                          %mi q
                      %mtd
                        %mi y
                      %mtd
                    %mtr
                      %mtd
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{c}
                  \&amp; i(x) &amp; \overset{\mathrm{ap}_{i}(q)}= &amp; i(y) &amp;  \\
                  j(x) &amp; \Vert &amp;  &amp; \Vert &amp; j(y)\\
                  \&amp; x &amp; \underset{q}= &amp; y &amp; \\
                  \\end{array}
          %p
            This
            %a.existingWikiWord{:href => "/nlab/show/commutative+square"} square commutes
            via the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/J+rule"} J rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝕀
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi 𝕀
                      %mi x
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo •
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝕀
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{i}(\mathrm{refl}_\mathbb{I}(x)) \bullet j(x) =_{i(x) =_\mathbb{I} x} j(x) \bullet \mathrm{refl}_\mathbb{I}(x)
          %p
            But
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝕀
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{i}(\mathrm{refl}_\mathbb{I}(x)) \bullet j(x)
            reduces down to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j(x)
            via
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝕀
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝕀
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{i}(\mathrm{refl}_\mathbb{I}(x)) \bullet j(x) \equiv \mathrm{refl}_\mathbb{I}(i(x)) \bullet j(x) \equiv j(x)
          %p
            and similarly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo •
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi 𝕀
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} j(x) \bullet \mathrm{refl}_\mathbb{I}(x)
            reduces down to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(x)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j(x)
          %p So the naturality square is inductively defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mo =
                  %mrow
                    %mo (
                    %mi λ
                    %mi x
                    %mo :
                    %mi 𝕀
                    %mo .
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mi 𝕀
                        %mi x
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi q
                    %mo )
                  %mo :
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mi i
                  %mo{:stretchy => "false"} (
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mrow
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi 𝕀
                      %mi y
                  %mi j
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo •
                  %mi q
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{=}\left(\lambda x:\mathbb{I}.\mathrm{refl}_{i(x) =_\mathbb{I} x}(j(x)), x, y, q\right):\mathrm{ap}_{i}(q) \bullet j(y) =_{i(x) =_\mathbb{I} y} j(x) \bullet q
          %p
            When
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ≔
                    %mi f
                    %mo ∘
                    %mi g
                  %annotation{:encoding => "application/x-tex"} i \coloneqq f \circ g
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ≔
                    %msub
                      %mi{:mathvariant => "normal"} sec
                      %mi g
                  %annotation{:encoding => "application/x-tex"} j \coloneqq \mathrm{sec}_g
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ≔
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x \coloneqq 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ≔
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} y \coloneqq 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo ≔
                    %mi p
                  %annotation{:encoding => "application/x-tex"} q \coloneqq p
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ind
                    %mo =
                  %mrow
                    %mo (
                    %mi λ
                    %mi x
                    %mo :
                    %mi 𝕀
                    %mo .
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo =
                          %mi 𝕀
                        %mi x
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} sec
                      %mi g
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi p
                    %mo )
                %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{=}\left(\lambda x:\mathbb{I}.\mathrm{refl}_{f(g(x)) =_\mathbb{I} x}(\mathrm{sec}_g(x)), 0, 1, p\right)
          %p
            which is of the same type as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mi p
                %annotation{:encoding => "application/x-tex"} q_p
            due to the
            %a.existingWikiWord{:href => "/nlab/show/judgmental+equalities"} judgmental equalities
            in the other computation rules.
          %p
            One gets back the usual induction principle of the interval type when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ≡
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi 𝕀
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C \equiv \sum_{x:\mathbb{I}} P(x)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ≡
                  %msub
                    %mi π
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f \equiv \pi_1
            the first projection function of the dependent sum type, and one gets back the recursion principle of the interval type when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ≡
                  %mi 𝕀
                  %mo ×
                  %mi P
                %annotation{:encoding => "application/x-tex"} C \equiv \mathbb{I} \times P
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ≡
                  %msub
                    %mi π
                    %mn 1
                %annotation{:encoding => "application/x-tex"} f \equiv \pi_1
            the first projection function of the product type.
          %h3#path_types_and_identity_types Path types and identity types
          %p
            In general, functions from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕀
                %annotation{:encoding => "application/x-tex"} \mathbb{I}
            to a type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            can be thought of as the
            %a.existingWikiWord{:href => "/nlab/show/paths"} paths
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Martin-L%C3%B6f+type+theory"} Martin-Löf type theory
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕀
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \mathbb{I} \to A
            can be thought of as the
            %strong
              %a.existingWikiWord{:href => "/nlab/show/path+types"} path types
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %a.existingWikiWord{:href => "/nlab/show/topology"} topology
            paths in a (topological) space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are (continuous) functions from the unit interval, and how in
            %a.existingWikiWord{:href => "/nlab/show/cubical+type+theory"} cubical type theory
            the
            %a.existingWikiWord{:href => "/nlab/show/cubical+paths"} cubical paths
            are a kind of function type out of the pre-defined interval pre-type.
          %p
            The recursion principle of the interval type allows for paths to be defined from a given
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/identification"} identification
            %a.existingWikiWord{:href => "/nlab/show/function+application+to+identifications"} function application to identifications
            allows for identifications to be defined from a given path:
          %p
          .num_theorem
            %h6 Theorem
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/identification"} identification
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi b
                  %annotation{:encoding => "application/x-tex"} q:a =_A b
              between two terms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a:A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} b:A
              of a type
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              has an associated path
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi{:mathvariant => "normal"} rec
                        %mi 𝕀
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi 𝕀
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}}(a, b, p):\mathbb{I} \to A
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi β
                        %mi 𝕀
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} rec
                        %mi 𝕀
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi A
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \beta_\mathbb{I}^0(a, b, q):\mathrm{rec}_{\mathbb{I}}(a, b, q)(0) =_A a
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi β
                        %mi 𝕀
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} rec
                        %mi 𝕀
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi A
                      %mi b
                    %annotation{:encoding => "application/x-tex"} \beta_\mathbb{I}^1(a, b, q):\mathrm{rec}_{\mathbb{I}}(a, b, q)(1) =_A b
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi β
                        %mi 𝕀
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msub
                        %mi{:mathvariant => "normal"} ap
                        %mrow
                          %msub
                            %mi{:mathvariant => "normal"} rec
                            %mi 𝕀
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo ,
                          %mi b
                          %mo ,
                          %mi q
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mrow
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo =
                            %mi A
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %msubsup
                        %mi β
                        %mi 𝕀
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo •
                      %mi q
                      %mo •
                      %msubsup
                        %mi β
                        %mi 𝕀
                        %mi p
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi q
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \beta_\mathbb{I}^p(a, b, q):\mathrm{ap}_{\mathrm{rec}_{\mathbb{I}}(a, b, q)}(p) =_{f(0) =_A f(1)} \beta_\mathbb{I}^0(a, b, q) \bullet q \bullet \beta_\mathbb{I}^p(a, b, q)^{-1}
            %p where
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msub
                          %mi{:mathvariant => "normal"} rec
                          %mi 𝕀
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi q
                        %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %msub
                      %mo =
                      %mi 𝕀
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi A
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\mathrm{rec}_{\mathbb{I}}(a, b, q)}:(0 =_\mathbb{I} 1) \to (f(0) =_A f(1))
            %p
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/function+application+to+identities"} function application to identities
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi b
                    %msub
                      %mo =
                      %mi A
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)\bullet(-):(a =_A b) \times (b =_A c) \to (a =_A c)
            %p
              is concatenation of identities (i.e.
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/transitivity"} transitivity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi b
                    %msub
                      %mo =
                      %mi A
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)^{-1}:(a =_A b) \to (b =_A a)
            %p
              is the inverse of identities (i.e.
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/symmetry"} symmetry
          %p
          .num_theorem
            %h6 Theorem
            %p
              Given a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} q:\mathbb{I} \to A
              and terms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a:A
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} b:A
              with identities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi a
                    %mo :
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mi A
                    %mi a
                  %annotation{:encoding => "application/x-tex"} \delta_a:q(0) =_A a
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi b
                      %mo :
                      %mi q
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo =
                        %mi A
                      %mi b
                    %annotation{:encoding => "application/x-tex"} \delta_b:q(1) =_A b
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi δ
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo •
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo •
                    %msub
                      %mi δ
                      %mi b
                    %mo :
                    %mi a
                    %msub
                      %mo =
                      %mi A
                    %mi b
                  %annotation{:encoding => "application/x-tex"} \delta_a^{-1} \bullet \mathrm{ap}_{q}(p) \bullet \delta_b:a =_{A} b
            %p
          %p
            The path version of
            %a.existingWikiWord{:href => "/nlab/show/reflexivity"} reflexivity
            of an element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} x:A
            is represented by the
            %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant function
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \lambda i:\mathbb{I}.x:\mathbb{I} \to A
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+application+to+identifications"} function application to identifications
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} ap
                    %mrow
                      %mi λ
                      %mi i
                      %mo :
                      %mi 𝕀
                      %mo .
                      %mi x
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi j
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo ≡
                  %msub
                    %mi{:mathvariant => "normal"} refl
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{ap}_{\lambda i:\mathbb{I}.x}(i, j, q) \equiv \mathrm{refl}_A(x)
          %p
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ,
                  %mi j
                  %mo :
                  %mi 𝕀
                %annotation{:encoding => "application/x-tex"} i, j:\mathbb{I}
            and
            = succeed "." do
