                  %msub
                    %mo =
                    %mrow
                      %mi A
                      %mo →
                      %mi B
                  %mi f
                %annotation{:encoding => "application/x-tex"} \beta_{k'}^0:k'(0) =_{A \to B} f
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi β
                      %mrow
                        %mi k
                        %mo ′
                      %mn 1
                    %mo :
                    %mi k
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \beta_{k'}^1:k'(1) =_{A \to B} g
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/function+extensionality"} function extensionality
          %h3#relation_to_propositional_truncations  Relation to propositional truncations
          %p
            An interval type is the
            %a.existingWikiWord{:href => "/nlab/show/propositional+truncation"} propositional truncation
            of the
            %a.existingWikiWord{:href => "/nlab/show/type+of+booleans"} type of booleans
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟚
                  %annotation{:encoding => "application/x-tex"} \mathbb{2}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟚
                  %annotation{:encoding => "application/x-tex"} \mathbb{2}
          %ul
            %li
