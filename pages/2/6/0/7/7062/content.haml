                        %mo ′
                      %mn 1
                    %mo :
                    %mi k
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo =
                      %mrow
                        %mi A
                        %mo →
                        %mi B
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \beta_{k'}^1:k'(1) =_{A \to B} g
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msubsup
                    %mi β
                    %mrow
                      %mi k
                      %mo ′
                    %mn 0
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
