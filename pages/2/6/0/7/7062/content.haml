            %p
              such that for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo :
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x:A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %mi 𝕀
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi t
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{ind}_{\mathbb{I} \to A}(t, \lambda i:\mathbb{I}.x) \equiv t(x):C(\lambda i:\mathbb{I}.x)
            %p since by definition of constant function and reflexivity, one has
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mi i
                    %mo :
                    %mi 𝕀
                    %mo .
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %mi λ
                        %mi i
                        %mo :
                        %mi 𝕀
                        %mo .
                        %mi x
                    %mo{:stretchy => "false"} (
                    %mi 𝓅
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} refl
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lambda i:\mathbb{I}.x)(0) \equiv x \quad (\lambda i:\mathbb{I}.x)(1) \equiv x \quad \mathrm{ap}_{\lambda i:\mathbb{I}.x}(\mathcal{p}) \equiv \mathrm{refl}_A(x)
            %p We define
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %msub
                      %mi{:mathvariant => "normal"} ind
                      %mrow
                        %mi 𝕀
                        %mo →
                        %mi A
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo ,
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J(t, x, y, p) \equiv \mathrm{ind}_{\mathbb{I} \to A}(t, \mathrm{rec}_\mathbb{I}^A(x, y, p))
            %p
              since by interval recursion one has a path
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝕀
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_\mathbb{I}^A(x, y, p):\mathbb{I} \to A
              such that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi x
                    %mspace{:width => "1em"}
                    %msubsup
                      %mi{:mathvariant => "normal"} rec
                      %mi 𝕀
                      %mi A
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi y
                    %mspace{:width => "1em"}
                    %msub
                      %mi{:mathvariant => "normal"} ap
                      %mrow
                        %msubsup
                          %mi{:mathvariant => "normal"} rec
                          %mi 𝕀
                          %mi A
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi 𝓅
                    %mo{:stretchy => "false"} )
                    %mo ≡
                    %mi p
                  %annotation{:encoding => "application/x-tex"} \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)(0) \equiv x \quad \mathrm{rec}_{\mathbb{I}}^{A}(x, y, p)(1) \equiv y \quad \mathrm{ap}_{\mathrm{rec}_\mathbb{I}^{A}(x, y, p)}(0, 1, \mathcal{p}) \equiv p
            %p
          %h3#relation_to_dependent_identity_types Relation to dependent identity types
          %p
            Given a type
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi A
                    %mo ⊢
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x:A \vdash B(x)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                  %mo :
                  %mi A
                %annotation{:encoding => "application/x-tex"} a_0:A
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mo :
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a_1:A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %msub
                      %mi a
                      %mn 0
                    %msub
                      %mo =
                      %mi A
                    %msub
                      %mi a
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} q:a_0 =_A a_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi b
                    %mn 0
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 0
