                    %mi 𝒜
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi{:mathvariant => "normal"} W
                      %mi che
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_{dg}
                    \\big(
                    \\mathbf{Ch}_\bullet(\mathcal{A})
                    \\big)
                    \\;\;
                    \\simeq
                    \\;\;
                    N Ch_\bullet(\mathcal{A})[\mathrm{W}^{-1}_{che}]
                    \\,.
            %p
          \&amp;lbrack;
          %a{:href => "#Lurie17"}> Lurie (2017), Prop. 1.3.4.5
          \&amp;rbrack;
          %p
            Similarly:
          .num_prop
            %h6 Proposition
            %p
              Given
