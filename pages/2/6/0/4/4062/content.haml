            %p
          %p
          #TerminologyOfMates.num_defn
            %h6 Definition
            %p
              The 2-cells
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              in prop.
              %a.maruku-ref{:href => "#MateBijection"}
              are called
              %strong mates
              \&amp;lbrack;
              %a{:href => "#KellyStreet06"}> Kelly &amp; Street (2006) p. 87
              ;
              = succeed "&rbrack;" do
                %a{:href => "#Leinster04"} Leinster (2004), pp. 150
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/conjugate+transformation+of+adjoints"} conjugates
              = succeed "," do
                %a{:href => "#MacLane71"} MacLane (1971), p. 98
              %a.maruku-ref{:href => "#ConjugateTransformationOfAdjoints"}
              below) with respect to the adjunctions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⊣
                    %mi u
                  %annotation{:encoding => "application/x-tex"} f \dashv u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo ⊣
                    %mi u
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f' \dashv u'
              (and to the 1-cells
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
          %h2#properties Properties
          %h3#general General
          .num_prop
            %h6#proposition Proposition
            %p
              Strict
              %a.existingWikiWord{:href => "/nlab/show/2-functors"} 2-functors
              preserve adjunctions and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pasting+diagrams"} pasting diagrams
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo →
                    %mi J
                  %annotation{:encoding => "application/x-tex"} F \colon K \to J
              is a 2-functor and if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} \lambda
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              are mates wrt
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⊣
                    %mi u
                  %annotation{:encoding => "application/x-tex"} f \dashv u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo ⊣
                    %mi u
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f' \dashv u'
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} F \lambda
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} F \mu
              are mates wrt
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi f
                    %mo ⊣
                    %mi F
                    %mi u
                  %annotation{:encoding => "application/x-tex"} F f \dashv F u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi f
                    %mo ′
                    %mo ⊣
                    %mi F
                    %mi u
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} F f' \dashv F u'
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                    %annotation{:encoding => "application/x-tex"} J
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo{:lspace => "verythinmathspace"} :
                    %mi F
                    %mo ⇒
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \alpha \colon F \Rightarrow G
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/2-natural+transformation"} 2-natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi b
                    %mo ∘
                    %mi F
                    %mi f
                    %mo =
                    %mi G
                    %mi f
                    %mo ∘
                    %msub
                      %mi α
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \alpha_b \circ F f = G f \circ \alpha_a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi a
                    %mo ∘
                    %mi F
                    %mi u
                    %mo =
                    %mi G
                    %mi u
                    %mo ∘
                    %msub
                      %mi α
                      %mi b
                  %annotation{:encoding => "application/x-tex"} \alpha_a \circ F u = G u \circ \alpha_b
              are mates wrt
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mi f
                    %mo ⊣
                    %mi F
                    %mi u
                  %annotation{:encoding => "application/x-tex"} F f \dashv F u
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mi f
                      %mo ⊣
                      %mi G
                      %mi u
                    %annotation{:encoding => "application/x-tex"} G f \dashv G u
          %h3#naturality Naturality
          %p
            There are two
            %a.existingWikiWord{:href => "/nlab/show/double+categories"} double categories
            with objects those of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/adjoint+pairs"} adjoint pairs
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            and horizontal arrows 1-cells of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            above, while in the other they are those of the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            there is a double category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Adj
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Adj(K)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            as 2-cells.
          %p
            What this means is that, for example, the mate of a square coming from a
            %a.existingWikiWord{:href => "/nlab/show/pasting+diagram"} pasting diagram
            is given by pasting the mates of the individual 2-cells (whenever this makes sense).
          %p
            In the double category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Adj
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Adj(K)
            %a.existingWikiWord{:href => "/nlab/show/companion"} companion
            (the left adjoint) and a
            %a.existingWikiWord{:href => "/nlab/show/conjoint"} conjoint
            (the right adjoint). (In fact, in some sense it is the universal double category constructed from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            with this property.) Therefore, it is equivalent to a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/2-category+equipped+with+proarrows"} 2-category equipped with proarrows
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Adj
                    %mi V
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi K
                %annotation{:encoding => "application/x-tex"} L \colon Adj_V(K) \to K
            from the 2-category of objects, adjunctions and mate-pairs in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            that sends an adjunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ⊣
                  %mi u
                %annotation{:encoding => "application/x-tex"} f \dashv u
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+fully+faithful+2-functor"} locally fully faithful
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mi f
                %annotation{:encoding => "application/x-tex"} L f
            has a right adjoint in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            by definition; this gives the more traditional definition of a proarrow equipment.
          %h2#Examples Examples
          %p
          #ConjugateTransformationOfAdjoints.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/conjugate+transformation+of+adjoints"}> conjugate transformation of adjoints
                )
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊣
                    %mi U
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F \dashv U \colon D \to C
              be an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              in the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} A \colon * \to C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mi D
                  %annotation{:encoding => "application/x-tex"} X \colon * \to D
              be
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              considered as
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              out of the
              %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} *
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ⊣
                    %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %mo *
                    %mo →
                    %mo *
                  %annotation{:encoding => "application/x-tex"} 1 \dashv 1 \colon * \to *
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ⊣
                    %mi U
                  %annotation{:encoding => "application/x-tex"} F \dashv U
              yields the
              %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mi A
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≅
                    %mspace{:width => "thickmathspace"}
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi U
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    D(F A,\, X) \;\cong\; C(A,\, U X)
            %p
              and the pasting operations as above yield the notion of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/conjugate+transformation+of+adjoints"} conjugate transformation of adjoints
              = succeed ")" do
                %a{:href => "#MacLane71"} MacLane (1971), p. 98
            %p
              Moreover, the naturality of the mate correspondence yields
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturality
              of the bijection.
          .num_example
            %h6#example Example
            %p
              If the ambient
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              of a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \otimes)
              in that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ≃
                    %msub
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo ⊗
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    K \simeq \mathbf{B}_\otimes \mathcal{C}
            %p
              then an
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a pair of
              %a.existingWikiWord{:href => "/nlab/show/dual+objects"} dual objects
              and the mate-construction is the construction of
              %a.existingWikiWord{:href => "/nlab/show/dual+morphisms"} dual morphisms
              between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dualizable+objects"} dualizable objects
          .num_example
            %h6#example_2 Example
            %p
              Suppose given a
              %a.existingWikiWord{:href => "/nlab/show/commutative+square"} commutative square
              (up to
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              = succeed "s:" do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %msup
                                  %mi f
                                  %mo *
                          %mtd
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mrow
                                %msup
                                  %mi g
                                  %mo *
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msup
                                  %mi k
                                  %mo *
                        %mtr
                          %mtd
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msup
                                  %mi h
                                  %mo *
                          %mtd
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ &amp; \overset{f^*}{\to} &amp; \\
                    ^{g^*}\downarrow &amp;&amp; \downarrow^{k^*}\\
                    \&amp; \underset{h^*}{\to} &amp; }
            %p
              in which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^*
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi h
                      %mo *
                  %annotation{:encoding => "application/x-tex"} h^*
              have
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"} f_!
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mo !
                    %annotation{:encoding => "application/x-tex"} h_!
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Wirthm%C3%BCller+context"} Wirthmüller context
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              that makes the square commute
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mo *
                    %msup
                      %mi f
                      %mo *
                    %mo →
                    %msup
                      %mi h
                      %mo *
                    %msup
                      %mi g
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    k^* f^* \to h^* g^*
            %p has a mate
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mo !
                    %msup
                      %mi k
                      %mo *
                    %mo →
                    %msup
                      %mi g
                      %mo *
                    %msub
                      %mi f
                      %mo !
                  %annotation{:encoding => "application/x-tex"}
                    h_! k^* \to g^* f_!
            %p defined as the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mo !
                    %msup
                      %mi k
                      %mo *
                    %mover
                      %mo →
                      %mi η
                    %msub
                      %mi h
                      %mo !
                    %msup
                      %mi k
                      %mo *
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mi f
                      %mo !
                    %mover
                      %mo →
                      %mo ≅
                    %msub
                      %mi h
                      %mo !
                    %msup
                      %mi h
                      %mo *
                    %msup
                      %mi g
                      %mo *
                    %msub
                      %mi f
                      %mo !
                    %mover
                      %mo →
                      %mi ϵ
                    %msup
                      %mi g
                      %mo *
                    %msub
                      %mi f
                      %mo !
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    h_! k^* \overset{\eta}{\to} h_! k^* f^* f_! \overset{\cong}{\to} h_! h^* g^* f_! \overset{\epsilon}{\to} g^* f_!
                    \\,.
            %p
              One says that the original square satisfies the
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Beck-Chevalley+condition"} Beck-Chevalley condition
              if this mate is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
          %h2#multivariable_mates Multi-variable mates
          %p
            There is a version of the mate correspondence that applies to
            %a.existingWikiWord{:href => "/nlab/show/two-variable+adjunctions"} two-variable adjunctions
            and
            = succeed "-variable" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a{:href => "#CGR"} Cheng-Gurski-Riehl
          %p
            The relationship between two of the adjoints in a multivariable adjunction can be described as a
            = succeed ":" do
              %strong parametrized adjunction
            = succeed "." do
              %a{:href => "https://golem.ph.utexas.edu/category/2012/11/parametrized_mates_and_multiva.html"} parametrized mates
          %h2#references References
          %p
            The example of
            %a.existingWikiWord{:href => "/nlab/show/conjugate+transformation+of+adjoints"} conjugate transformation of adjoints
            (but without the terminology of “mates”)
          %ul
            %li#MacLane71
              %a.existingWikiWord{:href => "/nlab/show/Saunders+MacLane"}> Saunders MacLane
              , p. 98 of:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Categories+Work"} Categories for the working mathematician
              = succeed "&rbrack;" do
                %a{:href => "https://link.springer.com/book/10.1007/978-1-4757-4721-8"} doi:10.1007/978-1-4757-4721-8
          %p The explicit notion of mates may be officially due to
          %ul
            %li#KellyStreet06
              %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"}> Max Kelly
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ross+Street"} Ross Street
              = succeed "," do
                %em Review of the elements of 2-categories
              %strong 420
              (1974) &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/BFb0063101"}> doi:10.1007/BFb0063101
              \&amp;rbrack;
          %p and is reviewed in:
          %ul
            %li#Leinster04
              %a.existingWikiWord{:href => "/nlab/show/Tom+Leinster"}> Tom Leinster
              , Section 6.1, pp. 150 in:
              = succeed "," do
                %em Higher operads, higher categories
              = succeed "," do
                %strong 298
              = succeed "," do
                %a{:href => "http://arxiv.org/abs/math.CT/0305049"} math.CT/0305049
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1017/CBO9780511525896"} doi:10.1017/CBO9780511525896
          %p Further review and discussion:
          %ul
            %li#CGR
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eugenia+Cheng"}> Eugenia Cheng
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nick+Gurski"} Nick Gurski
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"} Emily Riehl
                = succeed "," do
                  %em Multivariable adjunctions and mates
                %strong 13
                (2014), 337–396,
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/is013012007jkt250"} doi:10.1017/is013012007jkt250
                = succeed "." do
                  %a{:href => "http://arxiv.org/abs/1208.4520"} arXiv:1208.4520
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Emily+Riehl"}> Emily Riehl
                ,
                %em Parametrized mates and multivariable adjunctions
                = succeed "." do
                  %a{:href => "https://golem.ph.utexas.edu/category/2012/11/parametrized_mates_and_multiva.html"} blog post
          %p#ReferencesGeneralizationtoBicategories
            Discussion in the generalization of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aaron+Lauda"}> Aaron Lauda
                , §3 of
                = succeed "," do
                  %em Frobenius algebras and ambidextrous adjunctions
                %strong 16
                04 (2006) 84-122 &amp;lbrack
                %a{:href => "http://www.tac.mta.ca/tac/volumes/16/4/16-04abs.html"}> tac:16-04
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Shulman"} Michael Shulman
                = succeed "," do
                  %em Enriched categories as a free cocompletion
                %strong 289
                (2016) Pages 1-94,
                = succeed "," do
                  %a{:href => "https://doi.org/10.1016/j.aim.2015.11.012"} doi:10.1016/j.aim.2015.11.012
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1301.3191"} arXiv:1301.3191
            %li#JohnsonYau20
              %p
                %a.existingWikiWord{:href => "/nlab/show/Niles+Johnson"}> Niles Johnson
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Donald+Yau"} Donald Yau
                = succeed "," do
                  %em 2-Dimensional Categories
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/2002.06055"} arXiv:2002.06055
                = succeed "&rbrack;" do
                  %a{:href => "https://oxford.universitypressscholarship.com/view/10.1093/oso/9780198871378.001.0001/oso-9780198871378"} doi:10.1093/oso/9780198871378.001.0001
