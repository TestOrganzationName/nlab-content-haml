          #MateBijection.num_prop
            %h6 Proposition
            %p
              %strong (mate bijection)
              %br/
              Given a
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjoint pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mo ⊣
                    %mi u
                    %mo{:lspace => "verythinmathspace"} :
                    %mi b
                    %mo →
                    %mi a
                  %annotation{:encoding => "application/x-tex"} (\eta,\epsilon) \colon f \dashv u \colon b \to a
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi η
                    %mo ′
                    %mo ,
                    %mi ϵ
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi f
                    %mo ′
                    %mo ⊣
                    %mi u
                    %mo ′
                    %mo{:lspace => "verythinmathspace"} :
                    %mi b
                    %mo ′
                    %mo →
                    %mi a
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} (\eta',\epsilon') \colon f' \dashv u' \colon b' \to a'
              , and
              %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-cells
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo{:lspace => "verythinmathspace"} :
                    %mi a
                    %mo →
                    %mi a
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} x \colon a \to a'
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo{:lspace => "verythinmathspace"} :
                      %mi b
                      %mo →
                      %mi b
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} y \colon b \to b'
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ′
                    %mi x
                    %mo ,
                    %mi y
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi a
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mi u
                    %mo ,
                    %mi u
                    %mo ′
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(a,b')(f' x,y f) \cong K(b,a')(x u,u' y)
            %p
              given by
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              with the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              of one adjunction and the
