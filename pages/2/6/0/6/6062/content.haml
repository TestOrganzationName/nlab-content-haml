          %h3#OndgLieAlgebras On dg-Lie algebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            0.
          #dgLieAlgebraCategory.num_defn
            %h6#definition Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %mo ∈
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} dgLieAlg_k \in Cat
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          #ModelStructureOnDgLieAlgebras.num_prop
            %h6#proposition Proposition
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgLieAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} dgLieAlg_k
              carries a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure in which
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
                  are the degreewise
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/surjective+maps"} surjective maps
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
            %p
              on the underlying
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              %a.existingWikiWord{:href => "/nlab/show/transferred+model+structure"} transferred model structure
              of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+chain+complexes"} model structure on chain complexes
              along the
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
              to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
          %p
            (
            %a{:href => "#Pridham"}> Pridham, lemma 3.24
            )
          %p
            We call this the
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-Lie+algebras"} model structure on dg-Lie algebras
          #SendingDGLieAlgebraToDgCoalgebra.num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %mo →
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \;\colon\;  dgLieAlg_k \to dgCoCAlg_k
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              which sends a
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo ,
                    %mi d
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathfrak{g},d,[-,-])
              to the
              %a.existingWikiWord{:href => "/nlab/show/dg-coalgebra"} dg-coalgebra
              whose underlying
              %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
              is free on the underlying
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              and whose
              %a.existingWikiWord{:href => "/nlab/show/coderivation"} coderivation
              is given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi v
                      %mn 1
                    %mo ↦
                    %mi d
                    %msub
                      %mi v
                      %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \colon v_1 \mapsto d v_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \colon (v_1, v_2) \mapsto [v_1, v_2]
            %p and then extended as a coderivation.
            %p
              (The
              %em Chevalley-Eilenberg
              dg-coalgebra.)
          #LeftAdjointFromDgCoAlgToDgAlg.num_prop
            %h6#proposition_2 Proposition
            %p
              The functor from def.
              %a.maruku-ref{:href => "#SendingDGLieAlgebraToDgCoalgebra"}
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi dgCoCAlg
                      %mi k
                    %mo →
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L} \;\colon\;   dgCoCAlg_k \to dgLieAlg_k
                    \\,.
          %p
            (
            %a{:href => "#Quillen69"}> Quillen 69, App. B6
            ,
            = succeed "," do
              %a{:href => "#Hinich98"} Hinich98, 1.2.1, 2.2.5
            = succeed ")." do
              %a{:href => "#Pridham"} Pridham, def. 3.23
          .num_remark
            %h6#remark Remark
            %p
              If one thinks of a
              %a.existingWikiWord{:href => "/nlab/show/dg-coalgebra"} dg-coalgebra
              as presenting a a derived formal space, as discuss
              %a{:href => "#SheavesOverCosimplicialInfinitesimallyThickenedPoints"} below
              then its image under
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℒ
                    %annotation{:encoding => "application/x-tex"} \mathcal{L}
              = succeed "," do
                %a.maruku-ref{:href => "#LeftAdjointFromDgCoAlgToDgAlg"}
              = succeed "." do
                %em tangent dg-Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℒ
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}
              is also called the
              = succeed "." do
                %strong tangent Lie algebra functor
          %p
            (
            %a{:href => "#Hinich98"}> Hinich98, 1.2.1
            )
          %h3#OndgCoalgebras On dg-coalgebras
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic"} characteristic
            0.
          #DGCoalgebrasCategory.num_defn
            %h6#definition_3 Definition
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgCoCAlg
                      %mi k
                    %mo ∈
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} dgCoCAlg_k \in Cat
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of co-commutative counital
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
              %a.existingWikiWord{:href => "/nlab/show/dg-coalgebras"} dg-coalgebras
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          #ModelStructureOnCocommutativeDGCoalgebras.num_prop
            %h6#proposition_3 Proposition
            %p
              There exists a
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} dgCoCAlg_k
              for which
            %ul
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                  are the morphisms that are degreewise
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/injections"} injections
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                  are the morphisms
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                  whose corresponding morphisms of
                  %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℒ
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathcal{L}(f)
                  = succeed "," do
                    %a.maruku-ref{:href => "#LeftAdjointFromDgCoAlgToDgAlg"}
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                  on the underlying
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
          %p
            (
            %a{:href => "#Hinich98"}> Hinich98, theorem 3.1
            ) See also (
            %a{:href => "#Pridham"}> Pridham, lemma 3.25
            ).
          %p
            We call this the
            = succeed "." do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-coalgebras"} model structure on dg-coalgebras
          #OndgCoAlgWEs.num_remark
            %h6#remarkwarning_4 Remark/Warning
            %p
              Beware that the class of weak equivalences in prop.
              %a.maruku-ref{:href => "#ModelStructureOnCocommutativeDGCoalgebras"}
              is
              %em not
              that of quasi-isomorphisms on the chain complexes underlying the dg-coalgebras.
          %p But they form a sub-class:
          #dgLieQIsTodgCoAlgs.num_prop
            %h6#proposition_4 Proposition
            %p The Chevalley-Eilenberg functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %mo →
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C} \;\colon\;  dgLieAlg_k \to dgCoCAlg_k
            %p
              from def.
              %a.maruku-ref{:href => "#SendingDGLieAlgebraToDgCoalgebra"}
              sends
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              on the
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              underlying
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
              to
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
              on the chain complexes underlying their Chevalley-Eilenberg
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dg-coalgebras"} dg-coalgebras
          %p
            (
            %a{:href => "#Lurie"}> Lurie, prop. 2.2.6
            )
          #QuillenEquivalenceBetweendgLieAnddgCoCAlg.num_prop
            %h6#proposition_5 Proposition
            %p
              The pair of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi ℒ
                    %mo ⊣
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi dgLie
                      %mi k
                    %mover
                      %munder
                        %mo →
                        %mi 𝒞
                      %mover
                        %mo ←
                        %mi ℒ
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    (\mathcal{L} \dashv \mathcal{C})
                    \\;\colon\;
                    dgLie_k
                    \\stackrel{\overset{\mathcal{L}}{\leftarrow}}{\underset{\mathcal{C}}{\to}}
                    dgCoCAlg_k
            %p
              from prop.
              %a.maruku-ref{:href => "#LeftAdjointFromDgCoAlgToDgAlg"}
              constitutes a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              between the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-Lie+algebras"} model structure on dg-Lie algebras
              = succeed "," do
                %a.maruku-ref{:href => "#ModelStructureOnDgLieAlgebras"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-coalgebras"} model structure on dg-coalgebras
              = succeed "." do
                %a.maruku-ref{:href => "#ModelStructureOnCocommutativeDGCoalgebras"}
          %p
            (
            %a{:href => "#Hinich98"}> Hinich 1998, theorem 3.2
            )
          .num_remark
            %h6#remark_2 Remark
            %p
              Since every object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgCoCAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} dgCoCAlg_k
              is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
              and every object in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgLie
                      %mi k
                  %annotation{:encoding => "application/x-tex"} dgLie_k
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mi ℒ
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi dgCoCAlg
                      %mi k
                    %mo →
                    %msub
                      %mi dgCocAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}\mathcal{L}
                    \\colon
                    dgCoCAlg_k
                    \\to
                    dgCocAlg_k
            %p
              is already its
              %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              and the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo →
                    %mi 𝒞
                    %mi ℒ
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{g} \to \mathcal{C}\mathcal{L}\mathfrak{g}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
              that exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mi ℒ
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}\mathcal{L}\mathfrak{g}
              as a
              %a.existingWikiWord{:href => "/nlab/show/fibrant+resolution"} fibrant resolution
              and moreover, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              was already fibrant, hence by prop.
              %a.maruku-ref{:href => "#LInfinityAlgebraIsFibrantObjectIndgFormalSpace"}
              below an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              %strong strictification
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
              is an
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
              strictly (not just up to a
              %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              measured by the trinary bracket) and in which the “Jacobiator identity” holds strictly, etc.
          %h3#SheavesOverCosimplicialInfinitesimallyThickenedPoints On simplicial presheaves over cosimplicial formal spaces
          .num_defn
            %h6#definition_4 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi InfThPoint
                    %mo ↪
                    %msup
                      %mi Alg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    InfThPoint \hookrightarrow Alg^{op}
            %p
              for the category of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              %a.existingWikiWord{:href => "/nlab/show/Artin+algebras"} Artin algebras
              (“Weil alebras” in the language of
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+differential+geometry"} synthetic differential geometry
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi cInfThPoint
                    %mo ↪
                    %msup
                      %mi sAlg
                      %mi op
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Alg
                      %mi op
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi Δ
                  %annotation{:encoding => "application/x-tex"}
                    cInfThPoint \hookrightarrow sAlg^{op} \simeq (Alg^{op})^{\Delta}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              on
              %a.existingWikiWord{:href => "/nlab/show/simplicial+algebras"} simplicial algebras
              on those which are
              %a.existingWikiWord{:href => "/nlab/show/Artin+algebra"} Artinian
              (or “Weil” ): the category of
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
          .num_defn
            %h6#definition_5 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FormalSpace
                    %mo ≔
                    %msup
                      %mi Fun
                      %mi lex
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi InfThPoints
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    FormalSpace \coloneqq Fun^{lex}(InfThPoints^{op}, Set)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              over
              %a.existingWikiWord{:href => "/nlab/show/infinitesimally+thickened+points"} infinitesimally thickened points
              on those given by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+exact+functors"} left exact functors
          %p
            In (
            %a{:href => "#Pridham"}> Pridham
            ) this is def. 1.18.
          #DerivedFormalSpace.num_defn
            %h6#definition_6 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DerivedFormalSpace
                    %mo ≔
                    %msup
                      %mi Fun
                      %mi lex
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi cInfThPoints
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    DerivedFormalSpace \coloneqq Fun^{lex}(cInfThPoints^{op}, sSet)
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the category of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              over
              %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
              infinitesimally thickened points on those given by
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/left+exact+functors"} left exact functors
          %p
            In (
            %a{:href => "#Pridham"}> Pridham
            ) this is def. 1.32.
          .num_theorem
            %h6#theorem Theorem
            %p
              There exists a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DerivedFormalSpace
                  %annotation{:encoding => "application/x-tex"} DerivedFormalSpace
              whose
            %ul
              %li
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                are those morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                which are
                %a.existingWikiWord{:href => "/nlab/show/local+morphisms"} local morphisms
                with respect to quasi-smooth maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} p \colon E \to Y
                in the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
                of the
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
            %p (…)
          %p
            This is (
            %a{:href => "#Pridham"}> Pridham, def. 2.7, theorem 2.14
            )
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Between quasi-smooth objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi DerivedFormalSpace
                  %annotation{:encoding => "application/x-tex"} DerivedFormalSpace
              the weak equivalences are precisely the morphisms which are
              %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
              of simplicial sets over each object in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi cInfThPoint
                    %annotation{:encoding => "application/x-tex"} cInfThPoint
          %p
            This is (
            %a{:href => "#Pridham"}> Pridham, cor. 2.16
            ).
          %h3#OnDgInfinitesimallyThickenedPoints On dg formal spaces
          .num_defn
            %h6#definition_7 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              be a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              which is
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/noetherian+ring"} noetherian
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/local+ring"} local
                  with
                %ol
                  %li
                    %p
                      maximal ideal
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi μ
                          %annotation{:encoding => "application/x-tex"} \mu
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/residue+field"} residue field
                      = succeed "." do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi k
                            %annotation{:encoding => "application/x-tex"} k
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ArtCAlg
                      %mi Λ
                  %annotation{:encoding => "application/x-tex"}
                    ArtCAlg_{\Lambda}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of commutative
              %a.existingWikiWord{:href => "/nlab/show/local+Artin+algebras"} local Artin algebras
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              whose residue field is also
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
          %p
            %a{:href => "#Pridham"} Pridham, 1.2
          .num_example
            %h6#example Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \mu = 0
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo =
                    %mi k
                  %annotation{:encoding => "application/x-tex"} \Lambda = k
              and we just write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ArtCAlg
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    ArtCAlg_k
                    \\,.
          %p
            In all of the following this is assumed to be the case, with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/characteristic+zero"} characteristic zero
          %p
            (
            %a{:href => "#Pridham"}> Pridham, below def. 3.3
            )
          #dgFormalSpace.num_defn
            %h6#definition_8 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi dgArtCAlg
                      %mi k
                    %mo ∈
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    dgArtCAlg_k \in Cat
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/supercommutative+superalgebra"} graded-commutative
              %a.existingWikiWord{:href => "/nlab/show/Artin+algebra"} Artin
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              with
              %a.existingWikiWord{:href => "/nlab/show/residue+field"} residue field
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgArtCAlg
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"}
                    Pro(dgArtCAlg_k) \in Cat
            %p
              for its category of
              %a.existingWikiWord{:href => "/nlab/show/pro-objects"} pro-objects
              and write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dgFormalSpace
                    %mo ≔
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgArtCAlg
                      %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    dgFormalSpace \coloneqq Pro(dgArtCAlg_k)^{op}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of that.
          %p
            This is (
            %a{:href => "#Pridham"}> Pridham, def. 3.1
            ) following (
            %a{:href => "#Manetti02"}> Manetti 02
            ).
          #OnProAlg.num_remark
            %h6#remark_3 Remark
            %p
              While it so happens that every
              %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
              and
              %a.existingWikiWord{:href => "/nlab/show/dg-coalgebra"} dg-coalgebra
              is the
              %a.existingWikiWord{:href => "/nlab/show/filtered+colimit"} filtered colimit
              of its
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              subalgebras (see at
              = succeed ")," do
                %em
                  %a{:href => "coalgebra#AsFilteredColimits"} coalgebra – As filtered colimits
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/algebras"} algebras
              %a.existingWikiWord{:href => "/nlab/show/linear+dual"} linear dual
              of a general coalgebra is a
              %a.existingWikiWord{:href => "/nlab/show/filtered+limit"} filtered limit
              of finite-dimensional algebras, hence a
              %a.existingWikiWord{:href => "/nlab/show/pro-object"} pro-object
              in finite dimensional algebras. This is the reason for the appearance of
              %a.existingWikiWord{:href => "/nlab/show/pro-objects"} pro-objects
              in def.
              = succeed "." do
                %a.maruku-ref{:href => "#dgFormalSpace"}
          #ModelStructureOnDgFormalSpace.num_prop
            %h6#proposition_7 Proposition
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              structure on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Pro
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi dgArtinCAlg
                        %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Pro(dgArtinCAlg_k)
              %a.maruku-ref{:href => "#dgFormalSpace"}
              – hence an
              %a.existingWikiWord{:href => "/nlab/show/opposite+model+category"} opposite model structure
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dgFormalSpaces
                  %annotation{:encoding => "application/x-tex"} dgFormalSpaces
              – whose
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              are those morphisms that are
              %a.existingWikiWord{:href => "/nlab/show/local+morphisms"} local morphisms
              relative to quasi-smooth maps in the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
              of the
              %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
              over their codomain.
          %p
            This is (
            %a{:href => "#Pridham"}> Pridham, prop. 4.36
            ).
          #ChevalleyEilenbergAlgebraConstruction.num_defn
            %h6#definition_9 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                    %mover
                      %mo →
                      %mrow
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgArtinCAlg
                      %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    CE
                    \\;\colon\;
                    L_\infty Alg \stackrel{}{\to} Pro(dgArtinCAlg_k)^{op}
            %p
              for the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              which regards an
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebra"} L-infinity algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              as a
              %a.existingWikiWord{:href => "/nlab/show/dg-coalgebra"} dg-coalgebra
              by prop.
              %a.maruku-ref{:href => "#LInfinityAlgebraIsQuasiFreeDgCoalgebra"}
              and then forms the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} linear dual
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
              %strong
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              (a pro-dg-algebra according to def.
              = succeed ")." do
                %a.maruku-ref{:href => "#dgFormalSpace"}
          #LInfinityAlgebraIsFibrantObjectIndgFormalSpace.num_prop
            %h6#proposition_8 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
              \-algebras are precisely the
              %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dgFormalSpace
                  %annotation{:encoding => "application/x-tex"} dgFormalSpace
              (hence in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg+cocommutative+coalgebras"} model structure on dg cocommutative coalgebras
              = succeed "):" do
                %a{:href => "#Pridham"} Pridham Cor. 4.56
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of def.
              = succeed "," do
                %a.maruku-ref{:href => "#ChevalleyEilenbergAlgebraConstruction"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                    %mover
                      %mo →
                      %mi CE
                    %mi Pro
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgArtinCAlg
                      %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo ≃
                    %mi dgFormalSpace
                  %annotation{:encoding => "application/x-tex"}
                    L_\infty Alg
                    \\stackrel{CE}{\to}
                    Pro(dgArtinCAlg_k)^{op}
                    \\simeq
                    dgFormalSpace
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              onto its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/essential+image"} essential image
              %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dgFormalSpace
                    %annotation{:encoding => "application/x-tex"} dgFormalSpace
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi dgFormalSpace
                      %mi fib
                    %mo ↪
                    %mi dgFormalSpace
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    CE
                    \\;\colon\;
                    L_\infty Alg
                    \\stackrel{\simeq}{\to}
                    dgFormalSpace_{fib}
                    \\hookrightarrow
                    dgFormalSpace
                    \\,.
          %p
            This is proven inside the proof of (
            %a{:href => "#Pridham"}> Pridham, prop. 4.42
            ).
          #CategoryOfFibrantObjectsLInfinity.num_remark
            %h6#remark_4 Remark
            %p
              Prop.
              %a.maruku-ref{:href => "#LInfinityAlgebraIsFibrantObjectIndgFormalSpace"}
              shows in particular that the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} L_\infty Alg
              of prop/def.
              %a.maruku-ref{:href => "#LInfinityAlgebraIsQuasiFreeDgCoalgebra"}
              carries the structure of a
              %em
                %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              that presents the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              of
              = succeed "-algebras." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              presented by the underlying
              %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
              in that we have an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
              between the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localizations"} simplicial localizations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi W
                    %mo{:stretchy => "false"} (
                    %mi dgFormalSpace
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi L
                      %mi W
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    L_W(dgFormalSpace)
                    \\simeq
                    L_W(L_\infty Alg)
                    \\,.
          %p
            The following proposition characterizes the structure of this
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
          #LInfinityAlgebrasAsACategoryOfFibrantObjects.num_prop
            %h6#proposition_9 Proposition
            %p
              The induced structure of a
              %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                    %mi Alg
                  %annotation{:encoding => "application/x-tex"} L_\infty Alg
              under the inclusion of prop.
              %a.maruku-ref{:href => "#LInfinityAlgebraIsFibrantObjectIndgFormalSpace"}
              has
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                  are precisely the maps that are
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphisms"} quasi-isomorphisms
                  on the underlying chain complexes;
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
                  include in particular the maps that are surjections on the underlying chain complexes.
          .proof
            %h6#proof Proof
            %p
              The first statement is proven in the proof of (
              %a{:href => "#Pridham"}> Pridham, prop. 4.42
              ).
            %p
              The second statement follows by (
              %a{:href => "#Pridham"}> Pridham, def. 4.34
              ) with the existence of the model structure on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dgFormalSpaces
                    %annotation{:encoding => "application/x-tex"} dgFormalSpaces
            %blockquote
              %p Should spell out how this follows, using lifting.
