                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed ")" do
              %a.maruku-ref{:href => "#LInfinityAlgebraIsQuasiFreeDgCoalgebra"}
            = succeed ")." do
              %a{:href => "#Dolgushev07"} Dolgushev 07, section 5
          %p
            More generally, a description of the full
            %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} derived hom space
            between two
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            %a.maruku-ref{:href => "#CategoryOfFibrantObjectsLInfinity"}
            from the description of
            = succeed "." do
              %a{:href => "category+of+fibrant+objects#DerivedHomSpaces"} derived hom-spaces in categories of fibrant objects
          %h3#HomotopyFiberProducts Homotopy fiber products
          %p
            Recognizing
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+products"} homotopy fiber products
            in any of the model structure above can be a bit subtle. A recognition principle of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
            over abelian
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed ")," do
              %a{:href => "infinity-Lie+algebra+cohomology#Extensions"} ∞-Lie algebra extensions
            = succeed ")." do
              %a{:href => "#FiorenzaRogersSchreiber13"} Fiorenza-Rogers-Schreiber 13, theorem 3.1.13
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/relation+between+L-%E2%88%9E+algebras+and+dg-Lie+algebras"} relation between L-∞ algebras and dg-Lie algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-coalgebras"} model structure on dg-coalgebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-Lie+algebras"} model structure on dg-Lie algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+Lie+algebras"} model structure on simplicial Lie algebras
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+operad"}> L-∞ operad
                ,
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+algebras+over+an+operad"} model structure on algebras over an operad
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/deformation+theory"} deformation theory
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Lie+differentiation"} Lie differentiation
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/deformation+context"} deformation context
          %h2#references References
          %p Precursors for 2-reduced dg-algebras are dicussed in
          %ul
            %li#Quillen69
              %a.existingWikiWord{:href => "/nlab/show/Dan+Quillen"}> Dan Quillen
              ,
              = succeed "," do
                %em Rational homotopy theory
              = succeed "," do
                %a{:href => "http://www.jstor.org/stable/1970725"} jstor:1970725
              = succeed ")" do
                %a{:href => "http://www.math.northwestern.edu/~konter/gtrs/rational.pdf"} pdf
          %p
            The homotopy-theoretic nature of
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %ul
            %li#Kontsevich94
              %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
              ,
              %em Topics in algebra — deformation theory
              Lecture Notes (1994) (
              %a{:href => "http://www.math.brown.edu/&#8764;abrmovic/kontsdef.ps"}> ps
              )
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %a.existingWikiWord{:href => "/nlab/show/structures"} structures
            on
            %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebras over operads
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
          %ul
            %li#Hinich97
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Hinich"}> Vladimir Hinich
              ,
              = succeed "," do
                %em Homological algebra of homotopy algebras
              %strong 25
              10 (1997) 3291-3323 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/q-alg/9702015"}> arXiv:q-alg/9702015
              ,
              = succeed "," do
                %a{:href => "https://doi.org/10.1080/00927879708826055"} doi:10.1080/00927879708826055
              = succeed ")&rbrack;" do
                %a{:href => "http://arxiv.org/abs/math/0309453"} arXiv:math/0309453
          %p
            The full model structure on
            %a.existingWikiWord{:href => "/nlab/show/dg-coalgebras"} dg-coalgebras
            (in characteristic 0) as a
            %a.existingWikiWord{:href => "/nlab/show/model+structure+for+L-infinity+algebras"}
              model structure for
              = succeed "-algebras" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
            and the
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            between
            %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
            as well as the interpretation in terms of formal
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/L-infinity+algebras"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msub
                        %mi L
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} L_\infty
                \-algebras
          %ul
            %li#Hinich98
              %a.existingWikiWord{:href => "/nlab/show/Vladimir+Hinich"}> Vladimir Hinich
              ,
              = succeed "," do
                %em DG coalgebras as formal stacks
              %strong 162
              2 (2001) 209-250 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math/9812034"}> arXiv:9812034
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/S0022-4049(00)00121-3"} doi:10.1016/S0022-4049(00)00121-3
          %p Also:
          %ul
            %li#Valette14
              Theorem 2.1 in:
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bruno+Vallette"} Bruno Vallette
              = succeed "," do
                %em Homotopy theory of homotopy algebras
              = succeed ":2" do
                %strong 70
              %a{:href => "https://10.5802/aif.3322"} doi
              %a{:href => "https://zbmath.org/?q=an:1335.18001"} Zbl:1335.18001
              %a{:href => "https://arxiv.org/abs/1411.5533"} arXiv:1411.5533
          %p
            The structure of a
            %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
            on connective
            %a.existingWikiWord{:href => "/nlab/show/finite+type"} finite type
            = succeed "-algebras:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %ul
            %li#Rogers18
              %a.existingWikiWord{:href => "/nlab/show/Christopher+L.+Rogers"}> Christopher L. Rogers
              ,
              = succeed "," do
                %em
                  An explicit model for the homotopy theory of finite type Lie
                  = succeed "-algebras" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1809.05999"} arXiv:1809.05999
              = succeed ")" do
                %a{:href => "https://doi.org/10.2140/agt.2020.20.1371"} doi:10.2140/agt.2020.20.1371
          %p
            (For relation to
            %a{:href => "#Valette14"} Valette 14
            see
            = succeed ")" do
              %a{:href => "#Rogers18"} Rogers 18, below Theorem 5.9
          %p In
          %ul
            %li#Lurie
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Formal+Moduli+Problems"} Formal Moduli Problems
          %p
            the relation to
            = succeed "-stacks" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p More model category theoretic developments relating various of the previous approaches and generalizing to arbitrary characteristic are in
          %ul
            %li#Pridham
              %a.existingWikiWord{:href => "/nlab/show/Jonathan+Pridham"}> Jonathan Pridham
              ,
              = succeed "," do
                %em Unifying derived deformation theories
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/0705.0344"} arXiv:0705.0344
          %p in parts based on
          %ul
            %li#Manetti02
              %a.existingWikiWord{:href => "/nlab/show/Marco+Manetti"}> Marco Manetti
              ,
              = succeed "," do
                %em Extended deformation functors
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/math/9910071"} arXiv:math/9910071
          %p
            A useful summary of that paper is given in the
            = succeed "," do
              %a{:href => "http://poisson.phc.unipi.it/~maggiolo/wp-content/uploads/2008/12/WDTII_Pridham.pdf"} notes
          %p
            A discussion of
            %a.existingWikiWord{:href => "/nlab/show/path+space+objects"} path space objects
            for
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
          %ul
            %li#Dolgushev07
              Vasiliy A. Dolgushev,
              %em Erratum to: “A Proof of Tsygan’s Formality Conjecture for an Arbitrary Smooth Manifold”
              (
              %a{:href => "http://arxiv.org/abs/math/0703113"}> arXiv:math/0703113
              )
          %p
            A discussion of
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
            of morphisms to abelian
            = succeed "-algebras" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} L_\infty
            = succeed ")" do
              %a{:href => "infinity-Lie+algebra+cohomology#Extensions"} ∞-Lie algebra extensions
          %ul
            %li#FiorenzaRogersSchreiber13
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Chris+Rogers"} Chris Rogers
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/L-%E2%88%9E+algebras+of+local+observables+from+higher+prequantum+bundles"} L-∞ algebras of local observables from higher prequantum bundles
              (
              %a{:href => "http://arxiv.org/abs/1304.6292"}> arXiv:1304.6292
              )
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Berglund"}> Alexander Berglund
              ,
              = succeed "," do
                %em Rational homotopy theory of mapping spaces via Lie theory for L-infinity algebras
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/1110.6145"} arXiv:1110.6145
              = succeed ")" do
                %a{:href => "https://dx.doi.org/10.4310/HHA.2015.v17.n2.a16"} doi:10.4310/HHA.2015.v17.n2.a16
        .revisedby
