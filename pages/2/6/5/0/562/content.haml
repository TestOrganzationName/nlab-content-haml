                %path{:d => "M -2.486966 2.870229 C -2.032787 1.149608 -1.019835 0.336611 0.00212883 -0.000606803 C -1.021327 -0.33394 -2.031828 -1.146318 -2.484569 -2.869586 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.799403,0.592415,0.592415,-0.799403,95.963501,112.72091)"}
                %path{:d => "M 74.3125 108.460938 L 91.777344 108.460938 L 91.777344 97.832031 L 74.3125 97.832031 Z M 74.3125 108.460938 ", :style => " stroke:none;fill-rule:nonzero;fill:rgb(100%,100%,100%);fill-opacity:1;"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "76.873039", "xlink:href" => "#t_pf165XCL7aQfxUkuJPz3gsyZA=-glyph3-1", :y => "105.900797"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "82.958686", "xlink:href" => "#t_pf165XCL7aQfxUkuJPz3gsyZA=-glyph4-2", :y => "105.900797"}
                %path{:d => "M 26.982373 -56.813582 L 65.957053 -56.813582 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:butt;stroke-linejoin:miter;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.995037,0,0,-0.995037,101.182789,66.831663)"}
                %path{:d => "M -2.485076 2.868859 C -2.033617 1.149387 -1.020778 0.332835 -0.000086969 -0.000852362 C -1.020778 -0.33454 -2.033617 -1.147166 -2.485076 -2.870563 ", :style => "fill:none;stroke-width:0.47818;stroke-linecap:round;stroke-linejoin:round;stroke:rgb(0%,0%,0%);stroke-opacity:1;stroke-miterlimit:10;", :transform => "matrix(0.995037,0,0,-0.995037,167.050868,123.362433)"}
                %path{:d => "M 136.105469 129.890625 L 159.214844 129.890625 L 159.214844 116.835938 L 136.105469 116.835938 Z M 136.105469 129.890625 ", :style => " stroke:none;fill-rule:nonzero;fill:rgb(100%,100%,100%);fill-opacity:1;"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "138.665834", "xlink:href" => "#t_pf165XCL7aQfxUkuJPz3gsyZA=-glyph4-3", :y => "125.344816"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "145.178352", "xlink:href" => "#t_pf165XCL7aQfxUkuJPz3gsyZA=-glyph5-10", :y => "125.344816"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "148.455009", "xlink:href" => "#t_pf165XCL7aQfxUkuJPz3gsyZA=-glyph4-4", :y => "125.344816"}
                %g{:style => "fill:rgb(0%,0%,0%);fill-opacity:1;"}
                  %use{:x => "153.377457", "xlink:href" => "#t_pf165XCL7aQfxUkuJPz3gsyZA=-glyph5-11", :y => "125.344816"}
            %p
          %p
          #GrothendieckFibration.num_defn
            %h6 Definition
            %p
              %strong (Grothendieck fibration)
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℰ
                    %mo →
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} P \colon \mathcal{E} \to \mathcal{B}
              is a
              %em fibration
              if for all
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} y \in \mathcal{E}
              and
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 0
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi x
                        %mn 0
                      %mo →
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_0 \colon x_0 \to P(y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f \colon x \to y
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianMorphism"}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi f
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} P(f) = f_0
              %br/
          %p
            Such
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is also called a “cartesian lifting” of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(f)
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(f)
            is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/cleavage"} cleavage
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
          %p
          .num_remark
            %h6 Remark
            %p
              %strong (weakly cartesian morphisms)
              %br/
              We say that a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is
              %a.existingWikiWord{:href => "/nlab/show/prefibered+category"} weakly cartesian
              if it has the property of a Cartesian morphism (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartesianMorphism"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            %p
              One can prove that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              is a fibration (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#GrothendieckFibration"}
            %p
              In a fibration, every weakly cartesian lifting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi f
                  %annotation{:encoding => "application/x-tex"} P f
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              is in fact cartesian (as one can show by combining the
              %a.existingWikiWord{:href => "/nlab/show/universal+properties"} universal properties
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and of a given cartesian lifting to
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                    %annotation{:encoding => "application/x-tex"} e
            %p
              Some sources say “cartesian” and “strongly cartesian” instead of “weakly cartesian” and “cartesian,” respectively. If weakly cartesian liftings exist but weakly cartesian arrows are
              %em not
              necessarily closed under composition, one sometimes speaks of a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/prefibered+category"} prefibered category
          %p
          #MorphismOfFibrations.num_defn
            %h6 Definition
            %p
              %strong
                (morphism of fibrations –
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/fibered+functor"} fibered functor
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} P'
              fibrations (Def.
              = succeed ")," do
                %a.maruku-ref{:href => "#GrothendieckFibration"}
              %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              of
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              of the form
            #eq:DiagramForFiberedFunctor.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℰ
                            %mo ′
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℰ
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mrow
                                    %mi P
                                    %mo ′
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtd
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msup
                                  %mrow
                                  %mi P
                        %mtr
                          %mtd
                            %mi ℬ
                            %mo ′
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi ℬ
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathcal{E}'
                    \&amp;
                    \\longrightarrow
                    \&amp;
                    \\mathcal{E}
                    \\\
                    \\mathllap{{}^{P'}}\big\downarrow
                    \&amp;&amp;
                    \\big\downarrow
                    \\mathrlap{{}^{P}}
                    \\\
                    \\mathcal{B}'
                    \&amp; \longrightarrow &amp;
                    \\mathcal{B}
                    }
            %p
              is a
              %em morphism of fibrations
              (also called a
              %em cartesian square
              or
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/fibred+functor"} fibred functor
              = succeed ")." do
                %a.maruku-ref{:href => "#CartesianMorphism"}
              %br/
          %p
          #TwoMorphismOfFibrations.num_defn
            %h6 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                of fibrations –
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/fibered+natural+transformation"} fibered natural transformation
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
              (or
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/fibered+natural+transformation"} fibered natural transformation
              = succeed ")" do
                %a.maruku-ref{:href => "#MorphismOfFibrations"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:DiagramForFiberedFunctor"} (1)
          %p
          .num_remark
            %h6 Remark
            %p
              If the functor on base categories is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity
              = succeed ")" do
                %a.maruku-ref{:href => "#TwoMorphismOfFibrations"}
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              between total categories which is “vertical” in that its component morphisms lie in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
          %h2#fibrations_versus_pseudofunctors Fibrations versus pseudofunctors
          %p
            Given a fibration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p:E\to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi B
                    %mi op
                  %mo →
                  %mi Cat
                %annotation{:encoding => "application/x-tex"} B^{op}\to Cat
            by sending each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo ∈
                  %mi B
                %annotation{:encoding => "application/x-tex"} b\in B
            to the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi b
                  %mo =
                  %msup
                    %mi p
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E_b = p^{-1}(b)
            of objects mapping onto
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            and morphisms mapping onto
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi b
                  %annotation{:encoding => "application/x-tex"} 1_b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi a
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} f:a\to b
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and an object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo ∈
                    %msub
                      %mi E
                      %mi b
                  %annotation{:encoding => "application/x-tex"} e\in E_b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi e
                  %mo ′
                  %mo →
                  %mi e
                %annotation{:encoding => "application/x-tex"} \phi:e'\to e
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            and call its
            %a.existingWikiWord{:href => "/nlab/show/source"} source
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} (
                    %mi e
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f^*(e)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            into a functor
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi b
                    %mo →
                    %msub
                      %mi E
                      %mi a
                  %annotation{:encoding => "application/x-tex"} E_b \to E_a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            %a.existingWikiWord{:href => "/nlab/show/strict+2-equivalence+of+2-categories"} strict 2-equivalence of 2-categories
            between
          %ul
            %li
              %p
                fibrations over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Id
                          %mi B
                      %annotation{:encoding => "application/x-tex"} Id_B
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi id
                          %mrow
                            %msub
                              %mi Id
                              %mi B
                      %annotation{:encoding => "application/x-tex"} id_{Id_B}
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/pseudofunctors"} pseudofunctors
                of the form
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi B
                          %mi op
                        %mo →
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} B^{op}\to Cat
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pseudonatural+transformations"} pseudonatural transformations
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/modifications"} modifications
          %p
            In fact, this is an instance of the general theory of representability for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalized+multicategories"} generalized multicategories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            whose pseudoalgebras are pseudofunctors
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi B
                      %mi op
                    %mo →
                    %mi Cat
                  %annotation{:encoding => "application/x-tex"} B^{op}\to Cat
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} E\to B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi T
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{T}
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Cat
                  %mo{:stretchy => "false"} /
                  %mi B
                %annotation{:encoding => "application/x-tex"} Cat/B
            which is
            %a.existingWikiWord{:href => "/nlab/show/lax-idempotent+2-monad"} colax-idempotent
            and whose pseudoalgebras are precisely the fibrations.
          %p
            This correspondence also generalizes to the correspondence between arbitrary functors over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            and
            %a.existingWikiWord{:href => "/nlab/show/displayed+categories"} displayed categories
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo →
                    %mi Prof
                  %annotation{:encoding => "application/x-tex"} B\to Prof
          %h2#fibrations_versus_presheaves_of_categories Fibrations versus presheaves of categories
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            is an equivalence of
            %a.existingWikiWord{:href => "/nlab/show/bicategories"} bicategories
            from the bicategory of presheaves of categories to the bicategory of Grothendieck fibrations.
          %p
            As explained there, this equivalence, interpreted as a functor between 1-categories, has both a left and a right adjoint (which are equivalent in the bicategorical context). Roughly speaking, the left adjoint strictifies a Grothendieck fibration by adding formal pullbacks of objects, which themselves pullback strictly, whereas the right adjoint strictifies a Grothendieck fibration by equipping object with a functorial choice of a pullback for each possible morphism. See
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            for more details.
          %p
            These two adjunctions can be turned into
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
            between
            %a.existingWikiWord{:href => "/nlab/show/cartesian+fibrations"} cartesian fibrations
            and
            %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
            of
            %a.existingWikiWord{:href => "/nlab/show/marked+simplicial+sets"} marked simplicial sets
            on the
            %a.existingWikiWord{:href => "/nlab/show/quasicategory"} quasicategory
            given by the
            %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/straightening+functor"} straightening functor
            for more details.
          %h2#remarks Remarks
          %ul
            %li
              %p
                Fibrations are a “nonalgebraic” structure, since the base change functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
                are determined by universal properties, hence uniquely up to isomorphism. By contrast, pseudofunctors are an “algebraic” structure, since the functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f^*
                are specified, together with the necessary coherence data and axioms; the latter come for free in a fibration because of the universal property.
            %li
              %p
                A
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/stack"} stack
          %h2#examples Examples
          %p
