                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} VBun
                    %annotation{:encoding => "application/x-tex"} \VBun
              denote the category whose
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              are
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Man
                    %mo ×
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Man
                  %annotation{:encoding => "application/x-tex"} (M,V)\in\Man\times\Man
              of
              %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo :
                    %mi V
                    %mo ⟶
                    %mi M
                  %annotation{:encoding => "application/x-tex"} q:V\longrightarrow M
              is a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi M
                      %mn 1
                    %mo ,
                    %msub
                      %mi V
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi M
                      %mn 2
                    %mo ,
                    %msub
                      %mi V
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M_{1},V_{1})\longrightarrow (M_{2},V_{2})
              is a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/commutative+square"} commutative square
