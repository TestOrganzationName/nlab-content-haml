          %p
            Let’s suppose that observer
            %em A
            finds particle 1 is aligned with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{a}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} →
                    %mo +
                  %annotation{:encoding => "application/x-tex"} \vec{a}+
            %em B
            finds particle 2 is aligned with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi b
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{b}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi b
                      %mo{:stretchy => "false"} →
                    %mo +
                  %annotation{:encoding => "application/x-tex"} \vec{b}+
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mi i
                %annotation{:encoding => "application/x-tex"} N_{i}
            is positive semi-definite we must be able to construct relations like, for instance,
          #eq:APositivityCondition.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi N
                    %mn 3
                  %mo +
                  %msub
                    %mi N
                    %mn 4
                  %mo ≤
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi N
                    %mn 3
                  %mo +
                  %msub
                    %mi N
                    %mn 7
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi N
                    %mn 4
                  %mo +
                  %msub
                    %mi N
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  N_{3} + N_{4} \le (N_{3} + N_{7}) + (N_{4} + N_{2}).
          %p
            Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(\vec{a}+;\vec{b}+)
            be the probability that, in a random selection,
            %em A
            finds particle 1 to be
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo +
                %annotation{:encoding => "application/x-tex"} \vec{a}+
            and
            %em B
            finds particle 2 to be
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi b
                      %mo{:stretchy => "false"} →
                    %mo +
                  %annotation{:encoding => "application/x-tex"} \vec{b}+
          #eq:Populations1.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi N
                        %mn 3
                      %mo +
                      %msub
                        %mi N
                        %mn 4
                      %mo{:stretchy => "false"} )
                    %mrow
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                        %mn 8
                      %msub
                        %mi N
                        %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P(\vec{a}+;\vec{b}+) = \frac{(N_{3} + N_{4})}{\sum_{i}^{8}N_{i}}.
          %p Similarly we have
          #eq:Populations2.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi N
                        %mn 2
                      %mo +
                      %msub
                        %mi N
                        %mn 4
                      %mo{:stretchy => "false"} )
                    %mrow
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                        %mn 8
                      %msub
                        %mi N
                        %mi i
                %annotation{:encoding => "application/x-tex"}
                  P(\vec{a}+;\vec{c}+) = \frac{(N_{2} + N_{4})}{\sum_{i}^{8}N_{i}}
          %p and
          #eq:Populations3.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi N
                        %mn 3
                      %mo +
                      %msub
                        %mi N
                        %mn 7
                      %mo{:stretchy => "false"} )
                    %mrow
                      %munderover
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mi i
                        %mn 8
                      %msub
                        %mi N
                        %mi i
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P(\vec{c}+;\vec{b}+) = \frac{(N_{3} + N_{7})}{\sum_{i}^{8}N_{i}}.
          %p
            The positivity condition
            %a.maruku-eqref{:href => "#eq:APositivityCondition"} (3)
            then becomes
          #eq:WignerFormOfBellInequality.maruku-equation
            %span.maruku-eq-number (7)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                  %mo ≤
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P(\vec{a}+;\vec{b}+) \le P(\vec{a}+;\vec{c}+) + P(\vec{c}+;\vec{b}+).
          %p This is Wigner’s form of Bell’s inequality.
          %h4#violations_and_geometry Violations and geometry
          %p
            As we mentioned before, we have used purely classical reasoning to derive the two forms of Bell’s inequality that we have thusfar encountered. Recall that the context within which the above were derived was the Stern-Gerlach experiment are we are measuring along axes of the magnetic field. As such, there are angles between these various axes. Thus the quantum mechanically-derived probabilities corresponding to
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:Populations1"} (4)
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:Populations2"} (5)
            %a.maruku-eqref{:href => "#eq:Populations3"} (6)
            are
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi sin
                    %mn 2
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %msub
                          %mi θ
                          %mi ab
                      %mn 2
                    %mo )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  P(\vec{a}+;\vec{b}+) = \frac{1}{2}sin^{2}\left(\frac{\theta_{ab}}{2}\right),
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi sin
                    %mn 2
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %msub
                          %mi θ
                          %mi ac
                      %mn 2
                    %mo )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  P(\vec{a}+;\vec{c}+) = \frac{1}{2}sin^{2}\left(\frac{\theta_{ac}}{2}\right),
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ;
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi sin
                    %mn 2
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %msub
                          %mi θ
                          %mi cb
                      %mn 2
                    %mo )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  P(\vec{c}+;\vec{b}+) = \frac{1}{2}sin^{2}\left(\frac{\theta_{cb}}{2}\right),
          %p
            respectively. Bell’s inequality,
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:WignerFormOfBellInequality"} (7)
          #eq:AnotherFormOfBellInequality.maruku-equation
            %span.maruku-eq-number (8)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi sin
                    %mn 2
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %msub
                          %mi θ
                          %mi ab
                      %mn 2
                    %mo )
                  %mo ≤
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi sin
                    %mn 2
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %msub
                          %mi θ
                          %mi ac
                      %mn 2
                    %mo )
                  %mo +
                  %mfrac
                    %mn 1
                    %mn 2
                  %msup
                    %mi sin
                    %mn 2
                  %mrow
                    %mo (
                    %mfrac
                      %mrow
                        %msub
                          %mi θ
                          %mi cb
                      %mn 2
                    %mo )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1}{2}sin^{2}\left(\frac{\theta_{ab}}{2}\right) \le \frac{1}{2}sin^{2}\left(\frac{\theta_{ac}}{2}\right) + \frac{1}{2}sin^{2}\left(\frac{\theta_{cb}}{2}\right).
          %p
            From a geometric point of view, this inequality is not always possible. For example, suppose, for simplicity that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{a}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi b
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{b}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{c}
            lie in a plane and suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{c}
            bisects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{a}
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi b
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{b}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi θ
                            %mi ab
                          %mo =
                          %mn 2
                          %mi θ
                        %mtd
                          %mtext and
                        %mtd
                          %msub
                            %mi θ
                            %mi ac
                          %mo =
                          %msub
                            %mi θ
                            %mi cb
                          %mo =
                          %mi θ
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\theta_{ab} = 2\theta &amp; \text{ and } &amp; \theta_{ac}=\theta_{cb}=\theta.
                  }
          %p
            Then
            %a.maruku-eqref{:href => "#eq:AnotherFormOfBellInequality"} (8)
            is violated for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo &lt;
                    %mi θ
                    %mo &lt;
                    %mfrac
                      %mi π
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} 0 \lt \theta \lt \frac{\pi}{2}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi θ
                    %mo =
                    %mfrac
                      %mi π
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} \theta = \frac{\pi}{4}
            %a.maruku-eqref{:href => "#eq:AnotherFormOfBellInequality"} (8)
            would become
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0.500
                  %mo ≤
                  %mn 0.292
                %annotation{:encoding => "application/x-tex"} 0.500 \le 0.292
            which is absurd!
          %h3#CompactReformulation Compact reformulation
          %p
            A transparent and compact way to derive the actual
            %a.existingWikiWord{:href => "/nlab/show/inequality"} inequality
            of
            %a{:href => "#Bell64"} Bell 1964
            (adjusting the original argument only slightly for mathematical elegance) is reviewed in
            = succeed "," do
              %a{:href => "#Khrennikov08"} Khrennikov 2008, §10.1
          %p
          .num_prop
            %h6 Proposition
            %p Given
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/probability+space"} probability space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Λ
                        %mo ,
                        %mi d
                        %mi ρ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Lambda, d\rho)
                  with
              %li
                %p
                  three
                  %a.existingWikiWord{:href => "/nlab/show/random+variables"} random variables
                  taking values in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mo ±
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{\pm 1\}
                  (regarded inside the
                  = succeed "):" do
                    %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                #eq:TheRandomVariables.maruku-equation
                  %span.maruku-eq-number (9)
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi S
                          %mi i
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo ⟶
                        %mo{:stretchy => "false"} {
                        %mo ±
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mo ↪
                        %mi ℝ
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                        %mi i
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo ,
                        %mn 3
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"}
                        S_i
                        \\;\colon\;
                        X \longrightarrow \{\pm 1\}
                        \\hookrightarrow
                        \\mathbb{R}
                        \\,,
                        \\;\;\;\;
                        i\,\in\, \{1,2,3\}
            %p
              then the
              %a.existingWikiWord{:href => "/nlab/show/correlation+functions"} correlation functions
            #eq:TheCorrelations.maruku-equation
              %span.maruku-eq-number (10)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi S
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi S
                      %mi j
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mi Λ
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi S
                      %mi j
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\langle S_{i} \, S_j\rangle
                    \\;\coloneqq\;
                    \\int_{\Lambda}
                    \\;
                    S_i(\lambda)
                    \\,
                    S_j(\lambda)
                    \\;
                    d\rho(\lambda)
            %p
              satisfy this
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/inequality"} inequality
            #eq:TheInequality.maruku-equation
              %span.maruku-eq-number (11)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi S
                      %mn 1
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} ⟩
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi S
                      %mn 3
                    %msub
                      %mi S
                      %mn 2
                    %mo{:stretchy => "false"} ⟩
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mo −
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi S
                      %mn 1
                    %msub
                      %mi S
                      %mn 3
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big\vert
                    \\langle S_1 S_2\rangle
                    \-
                    \\langle S_3 S_2\rangle
                    \\big\vert
                    \\;\leq\;
                    1 - \langle S_1 S_3\rangle
                    \\,.
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo |
                  %annotation{:encoding => "application/x-tex"} \left\vert-\right\vert
              denotes the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/absolute+value"} absolute value
          .proof
            %h6 Proof
            %p
              Recall that the
              %a.existingWikiWord{:href => "/nlab/show/expectation+value"} expectation value
              of a random variable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi Λ
                    %mo ⟶
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} P \,\colon\, \Lambda \longrightarrow \mathbb{R}
              is given by its
              %a.existingWikiWord{:href => "/nlab/show/Lebesgue+integral"} Lebesgue integral
              against the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mi P
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mi Λ
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\langle P \rangle
                    \\;\coloneqq\;
                    \\int_\Lambda P(\lambda) \, d\rho(\lambda)
                    \\,,
            %p
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} d\rho
              being a
              %a.existingWikiWord{:href => "/nlab/show/probability+measure"} probability measure
              implies the normalization
            #eq:NormalizationOfProbability.maruku-equation
              %span.maruku-eq-number (12)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mn 1
                    %mo{:stretchy => "false"} ⟩
                    %mspace{:width => "thickmathspace"}
                    %mo ≡
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mo ∫
                      %mi Λ
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\langle 1 \rangle
                    \\;\equiv\;
                    \\int_\Lambda 1 \, d\rho(\lambda)
                    \\;=\;
                    1
                    \\,.
            %p
              Moreover, the assumption
              %a.maruku-eqref{:href => "#eq:TheRandomVariables"} (9)
              that the random variables
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi i
                  %annotation{:encoding => "application/x-tex"} S_i
              take values in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo ±
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{\pm 1\}
              immediately implies for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mspace{:width => "thinmathspace"}
                    %mi in
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mn 3
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} i,j \,in\, \{1,2,3\}
              that
            #eq:IdempotencyOfTheRandomVariables.maruku-equation
              %span.maruku-eq-number (13)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ⋅
                    %msub
                      %mi S
                      %mi i
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext i.e.
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo ∀
                      %mrow
                        %mi λ
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %mi Λ
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mo ±
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big( S_i \cdot S_i \big) \,=\, 1
                    \\,,
                    \\;\;\;\;
                    \\text{i.e.}
                    \\;\;\;
                    \\underset{\lambda \,\in\, \Lambda}{\forall}
                    S_i(\lambda) \, S_i(\lambda)
                    \\,=\,
                    (\pm 1)^2
                    \\,=\,
                    1
                    \\,.
            %p
              Together this implies – by repeatedly using the
              %a.existingWikiWord{:href => "/nlab/show/Cauchy-Schwarz+inequality"} Cauchy-Schwarz inequality
              – the bounds:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi S
                      %mi i
                    %mo{:stretchy => "false"} ⟩
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi S
                      %mi i
                    %msub
                      %mi S
                      %mi j
                    %mo{:stretchy => "false"} ⟩
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\big\vert
                    \\langle S_i \rangle
                    \\big\vert
                    \\;\leq\;
                    1
                    \\,,
                    \\;\;\;\;\;\;\;
                    \\big\vert
                    \\langle S_i S_j\rangle
                    \\big\vert
                    \\;\leq\;
                    1
            %p and thus, in particular:
            #eq:BoundOnCorrelations.maruku-equation
              %span.maruku-eq-number (14)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mo{:stretchy => "false"} ⟨
                    %mi P
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi S
                      %mi i
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi S
                      %mi j
                    %mo{:stretchy => "false"} ⟩
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mspace{:width => "thickmathspace"}
                    %mo ≤
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mo{:stretchy => "false"} ⟨
                    %mi P
                    %mo{:stretchy => "false"} ⟩
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\big\vert
                    \\langle
                    P \, S_i \, S_j
                    \\rangle
                    \\big\vert
                    \\;\leq\;
                    \\big\vert
                    \\langle
                    P
                    \\rangle
                    \\big\vert
                    \\,,
            %p
              for any
              %a.existingWikiWord{:href => "/nlab/show/random+variable"} random variable
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mspace{:width => "thinmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thinmathspace"}
                      %mi Λ
                      %mo →
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} P \,\colon\, \Lambda \to \mathbb{R}
            %p Using these (evident) ingredients, we directly compute as follows
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "left left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi S
                            %mn 1
                          %msub
                            %mi S
                            %mn 2
                          %mo{:stretchy => "false"} ⟩
                          %mo −
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi S
                            %mn 3
                          %msub
                            %mi S
                            %mn 2
                          %mo{:stretchy => "false"} ⟩
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                        %mtd
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                          %msub
                            %mo ∫
                            %mi Λ
                          %msub
                            %mi S
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi S
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mi d
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msub
                            %mo ∫
                            %mi Λ
                          %msub
                            %mi S
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi S
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mi d
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                        %mtd
                          %mtext by
                          %mspace{:width => "thickmathspace"}
                          %mtext
                            %a.maruku-eqref{:href => "#eq:TheCorrelations"} (10)
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                          %msub
                            %mo ∫
                            %mi Λ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %msub
                            %mi S
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mo −
                          %msub
                            %mi S
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi S
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mi d
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                        %mtd
                          %mtext by linearity of the integral
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                          %msub
                            %mo ∫
                            %mi Λ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mn 1
                          %mo −
                          %msub
                            %mi S
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi S
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %msub
                            %mi S
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi S
                            %mn 2
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mi d
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                        %mtd
                          %mtext by
                          %mspace{:width => "thickmathspace"}
                          %mtext
                            %a.maruku-eqref{:href => "#eq:IdempotencyOfTheRandomVariables"} (13)
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo ≤
                          %mspace{:width => "thickmathspace"}
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                          %msub
                            %mo ∫
                            %mi Λ
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                          %mn 1
                          %mo −
                          %msub
                            %mi S
                            %mn 1
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi S
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mspace{:width => "thinmathspace"}
                          %mi d
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi λ
                          %mo{:stretchy => "false"} )
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                        %mtd
                          %mtext by
                          %mspace{:width => "thickmathspace"}
                          %mtext
                            %a.maruku-eqref{:href => "#eq:BoundOnCorrelations"} (14)
                      %mtr
                        %mtd
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mn 1
                          %mo −
                          %mo{:stretchy => "false"} ⟨
                          %msub
                            %mi S
                            %mn 1
                          %msub
                            %mi S
                            %mn 3
                          %mo{:stretchy => "false"} ⟩
                        %mtd
                          %mtext by
                          %mspace{:width => "thickmathspace"}
                          %mtext
                            %a.maruku-eqref{:href => "#eq:NormalizationOfProbability"} (12)
                          %mspace{:width => "thickmathspace"}
                          %mtext and
                          %mspace{:width => "thickmathspace"}
                          %mtext
                            %a.maruku-eqref{:href => "#eq:TheCorrelations"} (10)
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ll}
                    \\big\vert
                    \\langle S_1 S_2\rangle
                    \-
                    \\langle S_3 S_2\rangle
                    \\big\vert
                    \&amp;
                    \\\
                    \\;=\;
                    \\Big\vert
                    \\int_{\Lambda}
                    S_1(\lambda) \, S_2(\lambda)
                    \\,
                    d\rho(\lambda)
                    \-
                    \\int_{\Lambda}
                    S_3(\lambda) \, S_2(\lambda)
                    \\,
                    d\rho(\lambda)
                    \\Big\vert
                    \&amp;
                    \\text{by}\;\text{
                    %a.maruku-eqref{:href => "#eq:TheCorrelations"}> (10)
                    }
                    \\\
                    \\;=\;
                    \\Big\vert
                    \\int_{\Lambda}
                    \\big(
                    S_1(\lambda)
                    \-
                    S_3(\lambda)
                    \\big)
                    \\,
                    S_2(\lambda)
                    \\,
                    d\rho(\lambda)
                    \\Big\vert
                    \&amp;
                    \\text{by linearity of the integral}
                    \\\
                    \\;=\;
                    \\Big\vert
                    \\int_{\Lambda}
                    \\big(
                    1
                    \-
                    S_1(\lambda) \, S_3(\lambda)
                    \\big)
                    S_1(\lambda) \, S_2(\lambda)
                    \\,
                    d\rho(\lambda)
                    \\Big\vert
                    \&amp;
                    \\text{by}\;\text{
                    %a.maruku-eqref{:href => "#eq:IdempotencyOfTheRandomVariables"}> (13)
                    }
                    \\\
                    \\;\leq\;
                    \\Big\vert
                    \\int_{\Lambda}
                    \\big(
                    1
                    \-
                    S_1(\lambda) \, S_3(\lambda)
                    \\big)
                    \\,
                    d\rho(\lambda)
                    \\Big\vert
                    \&amp;
                    \\text{by}\;\text{
                    %a.maruku-eqref{:href => "#eq:BoundOnCorrelations"}> (14)
                    }
                    \\\
                    \\;=\;
                    1 - \langle S_1 S_3\rangle
                    \&amp;
                    \\text{by}\;\text{
                    %a.maruku-eqref{:href => "#eq:NormalizationOfProbability"}> (12)
                    }\;\text{and}\; \text{
                    %a.maruku-eqref{:href => "#eq:TheCorrelations"}> (10)
                    }
                    \\end{array}
            %p
