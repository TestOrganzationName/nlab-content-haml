                        %mtd
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi a
                            %mo{:stretchy => "false"} →
                          %mo +
                          %mo ,
                          %mover
                            %mi b
                            %mo{:stretchy => "false"} →
                          %mo −
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\text{ Particle 1 } &amp; &amp; \text{ Particle 2 } \\
                  (\vec{a}+,\vec{b}-) &amp; \leftrightarrow &amp; (\vec{a}-,\vec{b}+) \\
                  (\vec{a}+,\vec{b}+) &amp; \leftrightarrow &amp; (\vec{a}-,\vec{b}-) \\
                  (\vec{a}-,\vec{b}-) &amp; \leftrightarrow &amp; (\vec{a}+,\vec{b}+) \\
                  (\vec{a}-,\vec{b}+) &amp; \leftrightarrow &amp; (\vec{a}+,\vec{b}-)
                  }
          %p
            There is a very important assumption implied here. Suppose a particular pair belongs to the first grouping, that is if an observer
            %em A
            decides to measure the spin along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{a}
            for particle 1, he or she
            %em necessarily
            obtains a plus sign (corresponding to it being aligned with
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi a
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{a}
            %em regardless
            of any measurement observer
            %em B
            may make on particle 2. This is the principle of locality:
            = succeed "\u2019s" do
              %em A
            = succeed "\u2019s" do
              %em B
          %h4#wigners_derivation Wigner’s derivation
          %p
            Now suppose we introduce a third axis,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{c}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ,
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                  %mo +
                  %mo ,
                  %mover
                    %mi c
                    %mo{:stretchy => "false"} →
                  %mo −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\vec{a}+,\vec{b}+,\vec{c}-)
            corresponding to being aligned if measured on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi a
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{a}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi b
                    %mo{:stretchy => "false"} →
                %annotation{:encoding => "application/x-tex"} \vec{b}
            and anti-aligned on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} →
                  %annotation{:encoding => "application/x-tex"} \vec{c}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
