                      %mtr
                        %mtd
                          %msub
                            %mi N
                            %mn 7
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi a
                            %mo{:stretchy => "false"} →
                          %mo −
                          %mo ,
                          %mover
                            %mi b
                            %mo{:stretchy => "false"} →
