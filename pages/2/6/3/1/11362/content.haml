            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G(X)
            is the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                  %mo ×
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbb{N} \times X
            equipped with the ordinal product or
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lexicographic+order"} lexicographic order
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} \mathbb{N}
            with the set of integers greater than or equal to
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                  %mo :
                  %msub
                    %mi ℝ
                    %mrow
                      %mo ≥
                      %mn 1
                  %mo →
                  %msub
                    %mi ℕ
                    %mrow
                      %mo ≥
                      %mn 2
                  %mo ×
                  %msub
                    %mi ℝ
                    %mrow
                      %mo ≥
                      %mn 1
                %annotation{:encoding => "application/x-tex"} \xi: \mathbb{R}_{\geq 1} \to \mathbb{N}_{\geq 2} \times \mathbb{R}_{\geq 1}
          %p
            where
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo{:stretchy => "false"} (
