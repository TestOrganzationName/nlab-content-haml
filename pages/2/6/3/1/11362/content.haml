                  %mrow
                    %msub
                      %mi ℝ
                      %mrow
                        %mo ≥
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\geq 1}
              the terminal
              = succeed "-coalgebra." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
