          #PavPratt.num_theorem
            %h6#theorem_3 Theorem
            %p
              %strong
                (
                %a{:href => "#PP"}> Pavlovic-Pratt
                )
              The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
