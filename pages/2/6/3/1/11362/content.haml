            %a.existingWikiWord{:href => "/nlab/show/lexicographic+order"} lexicographically ordered
            according to the convention given in this
            %a{:href => "/nlab/show/lexicographic+order#antidictionary"} remark
            (where initial segments of words
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            are
            %em greater
            than
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
          %p
            On the other hand, we have an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ξ
                  %mo :
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℕ
                    %mo +
                  %mo ×
                  %mstyle{:mathvariant => "bold"}
                    %mi Q
