                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi Q
                %annotation{:encoding => "application/x-tex"} \xi:\; (\mathbb{N}_+ \times \mathbf{Q}) + 1 \to \mathbf{Q}
          %p
            where for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ∈
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \ast \in 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \xi(\ast) = \infty
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi n
                    %mo +
                    %mn 1
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi r
