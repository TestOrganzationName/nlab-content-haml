                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
          %h3#rationals_as_initial_algebra Rationals as initial algebra
          %p
            Now let
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi r
                    %mo ∈
                    %mi ℚ
                    %mo :
                    %mi r
                    %mo &gt;
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ∪
                    %mo{:stretchy => "false"} {
                    %mn ∞
                    %mo{:stretchy => "false"} }
