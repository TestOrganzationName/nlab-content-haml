                      %mn 1
                      %mo −
                      %mfrac
                        %mn 1
                        %mrow
                          %msub
                            %mi a
                            %mn 2
                          %mo +
                          %mn 1
                          %mo −
                          %mfrac
                            %mn 1
                            %mrow
                              %msub
                                %mi a
                                %mn 3
                              %mo +
                              %mn 1
                              %mo −
                              %mi ⋯
                %annotation{:encoding => "application/x-tex"} a_0 + 1 - \frac{1}{a_1 + 1 - \frac{1}{a_2 + 1 - \frac{1}{a_3 + 1 - \cdots}}}
          %p evaluates.
          %h2#rational_tangles Rational tangles
          %p Among the many uses of continued fractions, we mention a quite remarkable one due to John H. Conway.
          .num_defn
            %h6#definition Definition
            %p
              A
              %em rational tangle
              is a subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              of the 3-disk
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} D^3
              obtained by embedding two arcs
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi α
                      %mn 1
                    %mo ,
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi I
                    %mo +
                    %mi I
                    %mo →
                    %msup
                      %mi D
                      %mn 3
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} (\alpha_1, \alpha_2): I + I \to D^3,
            %p
              with endpoints on the boundary
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %msup
                        %mi D
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \partial D^3
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mn 3
                    %mo ,
                    %mi T
                    %mo =
                    %msub
                      %mi α
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo +
                    %msub
                      %mi α
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (D^3, T = \alpha_1(I) + \alpha_2(I))
              is homeomorphic to the pair
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi D
                        %mn 2
                      %mo ×
                      %mi I
                      %mo ,
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (D^2 \times I, \{x, y\} \times I)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo ∈
                    %msup
                      %mi D
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} x, y \in D^2
              distinct points. Two rational tangles
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ,
                    %mi T
                  %annotation{:encoding => "application/x-tex"} S, T
              are
              %em isotopic
              if there exists an orientation-preserving homeomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mn 3
                    %mo ,
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mn 3
                    %mo ,
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (D^3, S) \to (D^3, T)
              that is the identity on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∂
                      %msup
                        %mi D
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \partial D^3
          %p
            Conventionally, rational tangles (or more general 2-tangles) are exhibited by tangle diagrams placed within a disk (with appropriate over- and under-crossings), say a unit disk
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi z
                    %mo{:stretchy => "false"} |
                  %mo ≤
                  %mn 1
                %annotation{:encoding => "application/x-tex"} {|z|} \leq 1
            in the complex plane, with endpoints situated at primitive
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mn 8
                    %mi th
                %annotation{:encoding => "application/x-tex"} 8^{th}
            roots of unity
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi k
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi i
                    %mi π
                    %mo{:stretchy => "false"} /
                    %mn 8
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \exp((2k+1)i\pi/8)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0]
          %ul
            %li
              %p “Turn” (rotate the disk through 90 degrees counterclockwise),
            %li
              %p “Twist” (insert a “horizontal” twist that interchanges NE and SE, which can be a positive twist or a negative twist depending on convention).
          .num_theorem
            %h6#theorem_5 Theorem
            %p
              %strong (Conway)
              The set of isotopy classes of rational tangles is in bijection with the set of rational elements
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo ∈
                      %mi ℚ
                      %mo ∪
                      %mo{:stretchy => "false"} {
                      %mn ∞
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} q \in \mathbb{Q} \cup \{\infty\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [q]
              is the isotopy class corresponding to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                    %annotation{:encoding => "application/x-tex"} q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [-1/q]
              is the class corresponding to a turn of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi q
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [q]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo +
                    %mi q
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [1+q]
              is the class corresponding to a positive twist of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi q
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [q]
          %p
            In particular, every rational tangle can be brought back to the trivial tangle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [0]
            by a series of (positive) twists and turns, and every rational tangle is isotopic to the tangle obtained by applying a 180 degree counterclockwise turn to it. A very readable account of this result may be found in an article by Kauffman and Lambropoulou,
            = succeed "." do
              %a{:href => "http://arxiv.org/pdf/math/0311499.pdf"} here
          %p
            It should be remarked that the twist and turn operations correspond to group elements in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi PSL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSL_2(\mathbb{Z})
            (cf. the article
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Moebius+transformation"} Moebius transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mn 3
                  %mo →
                  %msub
                    %mi PSL
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B_3 \to PSL_2(\mathbb{Z})
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mn 3
                %annotation{:encoding => "application/x-tex"} B_3
            is the braid group on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 3
                %annotation{:encoding => "application/x-tex"} 3
            strands):
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi turn
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                          %mtd
                            %mn 0
                    %mo )
                  %mo ,
                  %mspace{:width => "2em"}
                  %mi pos
                  %mo .
                  %mi twist
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mn 1
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  turn = \left(
                  \\array{
                  0 &amp; 1 \\
                  \-1 &amp; 0
                  }\right), \qquad pos.twist = \left(
                  \\array{
                  1 &amp; 1 \\
                  0 &amp; 1
                  }\right)
          %p
            John Baez asks a question about this in
            = succeed "," do
              %a{:href => "http://math.ucr.edu/home/baez/week228.html"} TWF228
            = succeed "." do
              %a{:href => "http://math.ucr.edu/home/baez/week229.html"} TWF229
            = succeed "." do
              %a{:href => "http://golem.ph.utexas.edu/category/2014/04/the_modular_flow_on_the_space.html#c046316"} here
          %p
            David Corfield speculates at the
            %a{:href => "http://golem.ph.utexas.edu/category/2011/01/coalgebraic_tangles.html"} Café
            that the infinite tangles mentioned by
            = succeed "," do
              %a{:href => "#KL"} Kauffman and Lambropoulou
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi R
                %annotation{:encoding => "application/x-tex"} \mathbf{R}
            as a coalgebraic completion of the initial algebra
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi Q
                  %annotation{:encoding => "application/x-tex"} \mathbf{Q}
            = succeed ")." do
              %a.maruku-ref{:href => "#initial"}
          %h2#the_calkinwilf_and_sternbrocot_trees The Calkin-Wilf and Stern-Brocot trees
          %p The Calkin-Wilf tree is an infinite complete binary tree whose vertices are in 1-to-1 correspondence with the positive rational numbers. The tree may be defined inductively by the following very simple recipe (Calkin &amp; Wilf, 2000):
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo{:stretchy => "false"} /
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1/1
              is at the top of the tree, and
            %li
              each vertex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} /
                    %mi j
                  %annotation{:encoding => "application/x-tex"} i/j
              has two children: its left child is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo +
                    %mi j
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i/(i+j)
              and its right child is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo +
                    %mi j
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi j
                  %annotation{:encoding => "application/x-tex"} (i+j)/j
          %p For example, the first four levels of the Calkin-Wilf tree are:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 1
                    %mrow
                      %mfrac
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %mrow
                          %mfrac
                            %mrow
                              %mn 1
                              %mo{:stretchy => "false"} /
                              %mn 3
                            %mrow
                              %mn 1
                              %mo{:stretchy => "false"} /
                              %mn 4
                              %mspace{:width => "1em"}
                              %mn 4
                              %mo{:stretchy => "false"} /
                              %mn 3
                          %mspace{:width => "1em"}
                          %mfrac
                            %mrow
                              %mn 3
                              %mo{:stretchy => "false"} /
                              %mn 2
                            %mrow
                              %mn 3
                              %mo{:stretchy => "false"} /
                              %mn 5
                              %mspace{:width => "1em"}
                              %mn 5
                              %mo{:stretchy => "false"} /
                              %mn 2
                      %mspace{:width => "1em"}
                      %mfrac
                        %mrow
                          %mn 2
                          %mo{:stretchy => "false"} /
                          %mn 1
                        %mrow
                          %mfrac
                            %mrow
                              %mn 2
                              %mo{:stretchy => "false"} /
                              %mn 3
                            %mrow
                              %mn 2
                              %mo{:stretchy => "false"} /
                              %mn 5
                              %mspace{:width => "1em"}
                              %mn 5
                              %mo{:stretchy => "false"} /
                              %mn 3
                          %mspace{:width => "1em"}
                          %mfrac
                            %mrow
                              %mn 3
                              %mo{:stretchy => "false"} /
                              %mn 1
                            %mrow
                              %mn 3
                              %mo{:stretchy => "false"} /
                              %mn 4
                              %mspace{:width => "1em"}
                              %mn 4
                              %mo{:stretchy => "false"} /
                              %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1/1}{
                  \\frac{1/2}{
                  \\frac{1/3}{1/4\quad 4/3}
                  \\quad
                  \\frac{3/2}{3/5\quad 5/2}}
                  \\quad
                  \\frac{2/1}{
                  \\frac{2/3}{2/5\quad 5/3}
                  \\quad
                  \\frac{3/1}{3/4\quad 4/1}}}
          %p
            Remarkably, every positive rational number appears exactly once in the tree, and so performing a breadth-first traversal (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} /
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 3
                  %mo ,
                  %mn 3
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo ,
                  %mi …
                %annotation{:encoding => "application/x-tex"} 1/1, 1/2, 2/1, 1/3, 3/2, \dots
            ) gives an enumeration of the positive rationals with no double-counting. In fact, Calkin and Wilf proved that the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %mrow
                      %mi b
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{b(n)}{b(n+1)}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} b(n)
            is the number of ways of writing the integer
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            as a sum of powers of 2, each power being used at most twice.
          %p
            By locating a positive rational
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            in the Calkin-Wilf tree and describing the path to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            from the root as a sequence of binary choices, one generates a string of bits which may be interpreted as an “uncompressed” representation of the continued fraction of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            equivalently as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mi L
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mfrac
                            %mn 1
                            %mrow
                              %mn 1
                              %mo +
                              %mfrac
                                %mn 1
                                %mi x
                      %mtr
                        %mtd
                          %mi R
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 1
                          %mo +
                          %mi x
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  L(x) &amp;= \frac{1}{1 + \frac{1}{x}} \\
                  R(x) &amp;= 1 + x
                  \\end{aligned}
          %p from which it follows that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msup
                            %mi L
                            %mi a
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mfrac
                            %mn 1
                            %mrow
                              %mi a
                              %mo +
                              %mfrac
                                %mn 1
                                %mi x
                      %mtr
                        %mtd
                          %msup
                            %mi R
                            %mi a
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mi a
                          %mo +
                          %mi x
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  L^a(x) &amp;= \frac{1}{a + \frac{1}{x}} \\
                  R^a(x) &amp;= a + x
                  \\end{aligned}
          %p
            Now, suppose a positive rational
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            has continued fraction
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi a
                      %mn 0
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi n
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [a_0,\dots,a_n]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is odd (we allow for
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} a_n = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            in the Calkin-Wilf tree begins by taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi n
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} a_n - 1
            steps to the left, followed by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} a_{n-1}
            steps to the right,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mrow
                      %mi n
                      %mo −
                      %mn 2
                %annotation{:encoding => "application/x-tex"} a_{n-2}
            steps to the left, and so on, ending with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 0
                %annotation{:encoding => "application/x-tex"} a_0
            steps to the right. In other words,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mo =
                  %msup
                    %mi R
                    %mrow
                      %msub
                        %mi a
                        %mn 0
                  %msup
                    %mi L
                    %mrow
                      %msub
                        %mi a
                        %mn 1
                  %mi …
                  %msup
                    %mi R
                    %mrow
                      %msub
                        %mi a
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                  %msup
                    %mi L
                    %mrow
                      %msub
                        %mi a
                        %mi n
                      %mo −
                      %mn 1
                  %mn 1
                %annotation{:encoding => "application/x-tex"} q = R^{a_0}L^{a_1}\dots R^{a_{n-1}} L^{a_n-1} 1
          %p For example:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %mn 2
                          %mo{:stretchy => "false"} /
                          %mn 5
                        %mtd
                          %mo =
                          %mi LLR
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mfrac
                            %mn 1
                            %mrow
                              %mn 2
                              %mo +
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 1
                                  %mo +
                                  %mn 1
                      %mtr
                        %mtd
                          %mn 12
                          %mo{:stretchy => "false"} /
                          %mn 7
                        %mtd
                          %mo =
                          %mi RLRRL
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mn 1
                          %mo +
                          %mfrac
                            %mn 1
                            %mrow
                              %mn 1
                              %mo +
                              %mfrac
                                %mn 1
                                %mrow
                                  %mn 2
                                  %mo +
                                  %mfrac
                                    %mn 1
                                    %mrow
                                      %mn 1
                                      %mo +
                                      %mfrac
                                        %mn 1
                                        %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  2/5 &amp; = LLR(1) = \frac{1}{2 + \frac{1}{1 + 1}} \\
                  12/7 &amp;= RLRRL(1) = 1 + \frac{1}{1 + \frac{1}{2 + \frac{1}{1 + \frac{1}{1}}}}
                  \\end{aligned}
          %p
            Finally, the Calkin-Wilf tree gives a simple algebraic characterization of the positive rationals, namely as an initial object in the category of pointed modules for the free monoid on two elements
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi L
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{L,R\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℚ
                    %mo +
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}^+ \to X
            sending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                  %annotation{:encoding => "application/x-tex"} q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            on the Calkin-Wilf tree, and then retrace the path from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and applying the actions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} L : X \to X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo :
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} R : X \to X
            as appropriate.
          %p The Calkin-Wilf tree was first described in a 2000 paper by Neil Calkin and Herbert Wilf, “Recounting the rationals”, but is closely related to the much older Stern-Brocot tree, another arrangement of the positive rationals with the special property that the values are ordered from left to right. Here are the first four levels of the Stern-Brocot tree:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 1
                    %mrow
                      %mfrac
                        %mrow
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %mrow
                          %mfrac
                            %mrow
                              %mn 1
                              %mo{:stretchy => "false"} /
                              %mn 3
                            %mrow
                              %mn 1
                              %mo{:stretchy => "false"} /
                              %mn 4
                              %mspace{:width => "1em"}
                              %mn 2
                              %mo{:stretchy => "false"} /
                              %mn 5
                          %mspace{:width => "1em"}
                          %mfrac
                            %mrow
                              %mn 2
                              %mo{:stretchy => "false"} /
                              %mn 3
                            %mrow
                              %mn 3
                              %mo{:stretchy => "false"} /
                              %mn 5
                              %mspace{:width => "1em"}
                              %mn 3
                              %mo{:stretchy => "false"} /
                              %mn 4
                      %mspace{:width => "1em"}
                      %mfrac
                        %mrow
                          %mn 2
                          %mo{:stretchy => "false"} /
                          %mn 1
                        %mrow
                          %mfrac
                            %mrow
                              %mn 3
                              %mo{:stretchy => "false"} /
                              %mn 2
                            %mrow
                              %mn 4
                              %mo{:stretchy => "false"} /
                              %mn 3
                              %mspace{:width => "1em"}
                              %mn 5
                              %mo{:stretchy => "false"} /
                              %mn 3
                          %mspace{:width => "1em"}
                          %mfrac
                            %mrow
                              %mn 3
                              %mo{:stretchy => "false"} /
                              %mn 1
                            %mrow
                              %mn 5
                              %mo{:stretchy => "false"} /
                              %mn 2
                              %mspace{:width => "1em"}
                              %mn 4
                              %mo{:stretchy => "false"} /
                              %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\frac{1/1}{
                  \\frac{1/2}{
                  \\frac{1/3}{1/4\quad 2/5}
                  \\quad
                  \\frac{2/3}{3/5\quad 3/4}}
                  \\quad
                  \\frac{2/1}{
                  \\frac{3/2}{4/3\quad 5/3}
                  \\quad
                  \\frac{3/1}{5/2\quad 4/1}}}
          %p
            In fact, each tree may be obtained from the other by reversing the paths from the root (e.g.,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mo{:stretchy => "false"} /
                  %mn 5
                  %mo =
                  %mi LLR
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} 2/5 = LLR(1)
            is reached from the root of the Stern-Brocot tree by going down left twice and then right once).
          %h2#constructive_aspects Constructive aspects
          %p
            The construction of a continued fraction from an arbitrary
            %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
            relies on the
            %a.existingWikiWord{:href => "/nlab/show/limited+principle+of+omniscience"} limited principle of omniscience
            to define the
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/floor"} floor
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %a.existingWikiWord{:href => "/nlab/show/rational+number"} rational number
            and
            %a.existingWikiWord{:href => "/nlab/show/irrational+number"} irrational number
            (as well as
            %a.existingWikiWord{:href => "/nlab/show/convergence"} convergence
            in the real numbers), we have that a continued fraction (involving
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
          %p
            Now, just because a real number has an expansion as a continued fraction, that doesn't mean that it must be rational or irrational. In general, a continued fraction expansion (according to the coalgebraic formulation) is given by a
            %a.existingWikiWord{:href => "/nlab/show/stream"} stream
            of natural numbers, and a stream is not necessarily finite (so a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/list"} list
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
            %em if
            it has a continued fraction; even this is not constructively valid without the continued fraction.
          %h2#references References
          %ul#KL
            %li
              %p
                Wikipedia,
                %em
                  %a{:href => "http://en.wikipedia.org/wiki/Continued_fraction"} Continued fraction
            %li
              %p
                Claude Brezinski,
                = succeed "," do
                  %em Continued fractions and Padé approximants
                = succeed ")" do
                  %a{:href => "http://www.amazon.com/Continued-Fractions-Pade-Approximants-Brezinski/dp/0444881697"} vendor
            %li
              %p
                A. Ya. Khinchin,
                = succeed "," do
                  %em Continued fractions
            %li
              %p
                Ilan Vardi,
                = succeed "," do
                  %em Continued fractions from Euclid to the present day
                = succeed ")" do
                  %a{:href => "http://chronomaitre.org/ContinuedFractions.pdf"} web
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Louis+Kauffman"} Louis Kauffman
                and Sofia Lambropoulou,
                = succeed "," do
                  %em On the classification of rational tangles
                = succeed ")." do
                  %a{:href => "http://arxiv.org/pdf/math/0311499.pdf"} web
          %p Dan Piponi wrote a series of posts on his blog “A Neighborhood of Infinity”, using the programming language Haskell to illustrate some of the connections between continued fractions, rational tangles and linear operators:
          %ul
            %li
              Dan Piponi, “Untangling with Continued Fractions” (
              %a{:href => "http://blog.sigfpe.com/2008/08/untangling-with-continued-fractions.html"}> Part 0
              ,
              = succeed "," do
                %a{:href => "http://blog.sigfpe.com/2008/08/untangling-with-continued-fractions_16.html"} Part 1
              = succeed "," do
                %a{:href => "http://blog.sigfpe.com/2008/08/untangling-with-continued-fractions_23.html"} Part 2
              = succeed "," do
                %a{:href => "http://blog.sigfpe.com/2008/08/untangling-with-continued-fractions_31.html"} Part 3
              = succeed "," do
                %a{:href => "http://blog.sigfpe.com/2008/09/untangling-with-continued-fractions.html"} Part 4
              = succeed ")." do
                %a{:href => "http://blog.sigfpe.com/2008/10/untangling-with-continued-fractions.html"} Part 5
          %p The material on half-open intervals as terminal coalgebras was first given by Pavlović and Pratt,
          %ul#PP
            %li
              %a.existingWikiWord{:href => "/nlab/show/Dusko+Pavlovic"} Dusko Pavlovic
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Vaughan+Pratt"} Vaughan Pratt
              = succeed "," do
                %em On coalgebras of real numbers
              = succeed ")" do
                %a{:href => "http://www.sciencedirect.com/science/article/pii/S1571066105802725?np=y"} web
          %p
            A type-theoretic formalization of the rationals in
            %a.existingWikiWord{:href => "/nlab/show/Coq"} Coq
            based on the Stern-Brocot/Calkin-Wilf representation is described in:
          %ul
            %li
              Milad Niqui and Yves Bertot,
              = succeed "," do
                %em QArith: Coq Formalisation of Lazy Rational Arithmetic
              = succeed ")" do
                %a{:href => "http://hal.inria.fr/inria-00077041/"} web
          %p Their library includes two implementations of the field operations: 1. a “strict” implementation (in the programming languages sense) in which the operations are performed by first converting continued fractions to ordinary fractions, applying the usual algorithms for arithmetic, and then converting back, and 2. a “lazy” implementation operating directly on continued fractions, in which the operations only need to inspect a portion of the input stream in order to determine a portion of the output stream. This latter approach is based on ideas originally due to Gosper:
          %ul
            %li
              Bill Gosper,
              = succeed "," do
                %a{:href => "http://hack.org/mc/writings/hackerdom/hakmem/cf.html"} “Continued fraction arithmetic”
              = succeed ".)" do
                %a{:href => "http://www.tweedledum.com/rwg/cfup.htm"} this unpublished note
          .footnotes
            %hr/
            %ol
              %li#fn:1
                %p
                  For rational numbers, there are two continued fraction representations, agreeing up to say
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi a
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                        %annotation{:encoding => "application/x-tex"} a_{n-1}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mi n
                        %mo &gt;
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} a_n \gt 1
                  in one case and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi a
                          %mi n
                        %mo −
                        %mn 1
                        %mo ,
                        %msub
                          %mi a
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                        %mo =
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} a_n - 1, a_{n+1} = 1
                  in the other (since after all
                  = succeed ")." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi a
                            %mi n
                          %mo =
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi a
                            %mi n
                          %mo −
                          %mn 1
                          %mo{:stretchy => "false"} )
                          %mo +
                          %mn 1
                          %mo{:stretchy => "false"} /
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} a_n = (a_n - 1) + 1/1
                  %a{:href => "#fnref:1", :rev => "footnote"} ↩
