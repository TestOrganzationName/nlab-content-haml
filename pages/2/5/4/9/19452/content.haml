                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \emptyset
                    is the tip of a
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                    %a.existingWikiWord{:href => "/nlab/show/cone"} cone
                    (Remark
                    = succeed ")" do
                      %a.maruku-ref{:href => "#LimitingCones"}
                    %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
                    on
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .proof
              %h6#proof_2 Proof
              %p
                First let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \emptyset
                be an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                %a.existingWikiWord{:href => "/nlab/show/cone"} cone
                over the identity functor
              #eq:InitialObjectCone.maruku-equation
                %span.maruku-eq-number (53)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi const
                                %mi ∅
                            %mtd
                              %mphantom
                                %mi AA
                            %mtd
                            %mtd
                            %mtd
                              %mi ∅
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msup
                                      %mi i
                                      %mi ∅
                              %mo ⇓
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msubsup
                                      %mi i
                                      %mrow
                                        %msub
                                          %mi c
                                          %mn 1
                                      %mi ∅
                              %mo ↙
                            %mtd
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msubsup
                                      %mi i
                                      %mrow
                                        %msub
                                          %mi c
                                          %mn 2
                                      %mi ∅
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mi 𝒞
                            %mtd
                            %mtd
                              %msub
                                %mi c
                                %mn 1
                            %mtd
                            %mtd
                              %munder
                                %mo ⟶
                                %mi f
                            %mtd
                            %mtd
                              %msub
                                %mi c
                                %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      const_{\emptyset}&amp;\phantom{AA}&amp; &amp;&amp; \emptyset
                      \\\
                      {}^{\mathllap{i^{\emptyset}}}\Downarrow &amp;&amp; &amp; {}^{\mathllap{i^{\emptyset}_{c_1}}}\swarrow &amp;&amp; \searrow^{\mathrlap{i^{\emptyset}_{c_2}}}
                      \\\
                      id_{\mathcal{C}} &amp;&amp; c_1 &amp;&amp; \underset{f}{\longrightarrow} &amp;&amp; c_2
                      }
              %p
                We need to show that that every other cone
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mi x
                    %annotation{:encoding => "application/x-tex"} i^x
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi const
                                %mi x
                            %mtd
                              %mphantom
                                %mi AA
                            %mtd
                            %mtd
                            %mtd
                              %mi x
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msup
                                        %mi i
                                        %mi x
                              %mo ⇓
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mrow
                                  %msubsup
                                    %mi i
                                    %mrow
                                      %msub
                                        %mi c
                                        %mn 1
                                    %mi x
                              %mo ↙
                            %mtd
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msubsup
                                      %mi i
                                      %mrow
                                        %msub
                                          %mi c
                                          %mn 2
                                      %mi x
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mi 𝒞
                            %mtd
                            %mtd
                              %msub
                                %mi c
                                %mn 1
                            %mtd
                            %mtd
                              %munder
                                %mo ⟶
                                %mi f
                            %mtd
                            %mtd
                              %msub
                                %mi c
                                %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      const_{x}&amp;\phantom{AA}&amp; &amp;&amp; x
                      \\\
                      {}^{\mathllap{\mathllap{i^x}}}\Downarrow &amp;&amp; &amp; {}^{i^x_{c_1}}\swarrow &amp;&amp; \searrow^{\mathrlap{i^x_{c_2}}}
                      \\\
                      id_{\mathcal{C}} &amp;&amp; c_1 &amp;&amp; \underset{f}{\longrightarrow} &amp;&amp; c_2
                      }
              %p
                factors uniquely through
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi i
                          %mi ∅
                      %annotation{:encoding => "application/x-tex"} i^\emptyset
              %p
                First of all, since the cones are over the identity functor, there is the component
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi i
                          %mi ∅
                          %mi x
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi x
                        %mo →
                        %mi ∅
                      %annotation{:encoding => "application/x-tex"} i^x_{\emptyset} \;\colon\; x \to \emptyset
              %p
                To see that this is the unique morphism of cones, consider any morphism of cones
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi j
                          %mi ∅
                          %mi x
                      %annotation{:encoding => "application/x-tex"} j^x_\emptyset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi i
                        %mi c
                        %mi x
                      %mo =
                      %msubsup
                        %mi i
                        %mi c
                        %mi ∅
                      %mo ∘
                      %msubsup
                        %mi j
                        %mi ∅
                        %mi x
                    %annotation{:encoding => "application/x-tex"} i^x_c = i^\emptyset_c  \circ j^x_\emptyset
                for all
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                        %mo ∈
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} c = \emptyset
                yields
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msubsup
                                %mi i
                                %mi ∅
                                %mi x
                            %mtd
                              %mo =
                              %munder
                                %munder
                                  %mrow
                                    %msubsup
                                      %mi i
                                      %mi ∅
                                      %mi ∅
                                  %mo ⏟
                                %mrow
                                  %mo =
                                  %msub
                                    %mi id
                                    %mi ∅
                              %mo ∘
                              %msubsup
                                %mi j
                                %mi ∅
                                %mi x
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %msubsup
                                %mi j
                                %mi ∅
                                %mi x
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      i^x_\emptyset
                      \&amp; =
                      \\underset{ = id_\emptyset }{\underbrace{i^\emptyset_{\emptyset}}} \circ j^x_{\emptyset}
                      \\\
                      \&amp; = j^x_\emptyset
                      \\,,
                      \\end{aligned}
              %p
                where under the brace we used that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \emptyset
                is initial. This proves that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} i^\emptyset
                is the limiting cone.
              %p
                For the converse, assume now that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} i^\emptyset
                is a limiting cone over the identity functor, with labels as in
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:InitialObjectCone"} (53)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \emptyset
                is an initial object.
              %p
                Now the cone condition applied for any object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} x \in \mathcal{C}
                over the morphims
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ≔
                      %msubsup
                        %mi i
                        %mi x
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} f \coloneqq i^\emptyset_x
                says that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi i
                        %mi x
                        %mi ∅
                      %mo ∘
                      %msubsup
                        %mi i
                        %mi ∅
                        %mi ∅
                      %mo =
                      %msubsup
                        %mi i
                        %mi x
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"}
                      i^{\emptyset}_x \circ i^\emptyset_\emptyset = i^\emptyset_x
              %p
                which means that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi i
                        %mi ∅
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} i^\emptyset_\emptyset
                constitutes a morphism of cones from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} i^\emptyset
                to itself. But since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} i^\emptyset
                is assumed to be a limiting cone, and since the
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \emptyset
                is of course also a morphism of cones from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi i
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} i^\emptyset
                to itsely, we deduce that
              #eq:iemptyemptyIsIdempty.maruku-equation
                %span.maruku-eq-number (54)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi i
                        %mi ∅
                        %mi ∅
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi id
                        %mi ∅
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      i^\emptyset_\emptyset
                      \\;=\;
                      id_{\emptyset}
                      \\,.
              %p
                Now consider any morphism of the form
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ∅
                        %mover
                          %mo →
                          %mi f
                        %mi x
                      %annotation{:encoding => "application/x-tex"} \emptyset \overset{f}{\to} x
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ∅
                        %mover
                          %mo →
                          %mrow
                            %msubsup
                              %mi i
                              %mi x
                              %mi ∅
                        %mi x
                      %annotation{:encoding => "application/x-tex"} \emptyset \overset{i^\emptyset_x}{\to} x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \emptyset
                we need to show that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo =
                        %msubsup
                          %mi i
                          %mi x
                          %mi ∅
                      %annotation{:encoding => "application/x-tex"} f = i^\emptyset_x
              %p
                Indeed, the cone condition of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi i
                        %mi x
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} i^\emptyset_x
                applied to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                now yields
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msubsup
                                %mi i
                                %mi x
                                %mi ∅
                            %mtd
                              %mo =
                              %mi f
                              %mo ∘
                              %munder
                                %munder
                                  %mrow
                                    %msubsup
                                      %mi i
                                      %mi ∅
                                      %mi ∅
                                  %mo ⏟
                                %mrow
                                  %mo =
                                  %msub
                                    %mi id
                                    %mi ∅
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi f
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      i^\emptyset_x
                      \&amp; =
                      f \circ \underset{ = id_{\emptyset} }{\underbrace{i^\emptyset_\emptyset}}
                      \\\
                      \&amp; =
                      f\,,
                      \\end{aligned}
              %p
                where under the brace we used
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:iemptyemptyIsIdempty"} (54)
            #LimitsOfPresheavesAreComputedObjectwise.num_example
              %h6#example_3 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/limits+of+presheaves+are+computed+objectwise"}> limits of presheaves are computed objectwise
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                and write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Set]
                for its
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#CategoryOfPresheaves"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                be a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                and consider any
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒟
                      %mo ⟶
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi 𝒟
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      F \;\colon\; \mathcal{D} \longrightarrow [\mathcal{C}^{op}, \mathcal{D}]
                      \\,,
              %p
                hence a
                = succeed "-shaped" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                in the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              %p Then
              %ol
                %li
                  %p
                    The
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Limits"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                    exists, and is the
                    %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
                    which over any
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                    is given by the
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                    in
                    %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                    of the values of the presheaves at
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi c
                          %annotation{:encoding => "application/x-tex"} c
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo (
                            %munder
                              %mi lim
                              %munder
                                %mo ⟵
                                %mrow
                                  %mi d
                                  %mo ∈
                                  %mi 𝒟
                            %mi F
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo )
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %munder
                            %mi lim
                            %munder
                              %mo ⟵
                              %mrow
                                %mi d
                                %mo ∈
                                %mi 𝒟
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\left(
                          \\underset{\underset{d \in \mathcal{D}}{\longleftarrow}}{\lim}
                          F(d)
                          \\right)(c)
                          \\;\simeq\;
                          \\underset{\underset{d \in \mathcal{D}}{\longleftarrow}}{\lim}
                          F(d)(c)
                %li
                  %p
                    The
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Limits"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                    exists, and is the
                    %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
                    which over any
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                    is given by the
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                    in
                    %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                    of the values of the presheaves at
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi c
                          %annotation{:encoding => "application/x-tex"} c
