                            %mtd
                              %mi Z
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\longrightarrow&amp; Z \times_f X
                      \\\
                      {}^{\mathllap{i}}_{\mathllap{\in K}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\mathrlap{f^* p}}}
                      \\\
                      B &amp;\stackrel{g}{\longrightarrow}&amp; Z
                      }
              %p
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
                %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
                composite with the pullback square from above to obtain the commuting diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Z
                              %msub
                                %mo ×
                                %mi f
                              %mi X
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi i
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msup
                                      %mi f
                                      %mo *
                                    %mi p
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi p
                          %mtr
                            %mtd
                              %mi B
                            %mtd
                              %mover
                                %mo ⟶
                                %mi g
                            %mtd
                              %mi Z
                            %mtd
                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\longrightarrow&amp; Z \times_f X &amp;\longrightarrow&amp; X
                      \\\
                      {}^{\mathllap{i}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f^* p}}
                      \&amp;&amp; \downarrow^{\mathrlap{p}}
                      \\\
                      B &amp;\stackrel{g}{\longrightarrow}&amp; Z &amp;\stackrel{f}{\longrightarrow}&amp; Y
                      }
                      \\,.
              %p
                By the right lifting property of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi i
                            %mtd
                              %msup
                                %mrow
                                %mover
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi f
                                    %mi g
                                    %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} ^
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi p
                          %mtr
                            %mtd
                              %mi B
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi f
                                  %mi g
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\longrightarrow&amp; X
                      \\\
                      \\downarrow^{\mathrlap{i}} &amp;{}^{\hat {(f g)}}\nearrow&amp;  \downarrow^{\mathrlap{p}}
                      \\\
                      B &amp;\stackrel{f g}{\longrightarrow}&amp; Y
                      }
                      \\,.
              %p
                By the
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of the
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                this gives rise to the lift
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat g
                in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi Z
                              %msub
                                %mo ×
                                %mi f
                              %mi X
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mover
                                  %mi g
                                  %mo{:stretchy => "false"} ^
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msup
                                      %mi f
                                      %mo *
                                    %mi p
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi p
                          %mtr
                            %mtd
                              %mi B
                            %mtd
                              %mover
                                %mo ⟶
                                %mi g
                            %mtd
                              %mi Z
                            %mtd
                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; Z \times_f X &amp;\longrightarrow&amp; X
                      \\\
                      \&amp;{}^{\hat g} \nearrow&amp; \downarrow^{\mathrlap{f^* p}}
                      \&amp;&amp; \downarrow^{\mathrlap{p}}
                      \\\
                      B &amp;\stackrel{g}{\longrightarrow}&amp; Z &amp;\stackrel{f}{\longrightarrow}&amp; Y
                      }
                      \\,.
              %p
                In order for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat g
                to qualify as the intended lift of the total diagram, it remains to show that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Z
                              %msub
                                %mo ×
                                %mi f
                              %mi X
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi i
                            %mtd
                              %msup
                                %mrow
                                %mover
                                  %mi g
                                  %mo{:stretchy => "false"} ^
                              %mo ↗
                          %mtr
                            %mtd
                              %mi B
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\longrightarrow&amp; Z \times_f X
                      \\\
                      \\downarrow^{\mathrlap{i}} &amp; {}^{\hat g}\nearrow
                      \\\
                      B
                      }
              %p
                commutes. To do so we notice that we obtain two
                %a.existingWikiWord{:href => "/nlab/show/cones"} cones
                with tip
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              %ul
                %li
                  %p one is given by the morphisms
                  %ol
                    %li
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                            %mo →
                            %mi Z
                            %msub
                              %mo ×
                              %mi f
                            %mi X
                            %mo →
                            %mi X
                          %annotation{:encoding => "application/x-tex"} A \to Z \times_f X \to X
                    %li
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                            %mover
                              %mo →
                              %mi i
                            %mi B
                            %mover
                              %mo →
                              %mi g
                            %mi Z
                          %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\to} B \stackrel{g}{\to} Z
                  %p with universal morphism into the pullback being
                  %ul
                    %li
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                            %mo →
                            %mi Z
                            %msub
                              %mo ×
                              %mi f
                            %mi X
                          %annotation{:encoding => "application/x-tex"} A \to Z \times_f X
                %li
                  %p the other by
                  %ol
                    %li
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                            %mover
                              %mo →
                              %mi i
                            %mi B
                            %mover
                              %mo →
                              %mover
                                %mi g
                                %mo{:stretchy => "false"} ^
                            %mi Z
                            %msub
                              %mo ×
                              %mi f
                            %mi X
                            %mo →
                            %mi X
                          %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\to} B \stackrel{\hat g}{\to} Z \times_f X \to X
                    %li
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi A
                            %mover
                              %mo →
                              %mi i
                            %mi B
                            %mover
                              %mo →
                              %mi g
                            %mi Z
                          %annotation{:encoding => "application/x-tex"} A \stackrel{i}{\to} B \stackrel{g}{\to} Z
                      \.
                  %p with universal morphism into the pullback being
                  %ul
                    %li
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                        %semantics
                          %mrow
                            %mi A
