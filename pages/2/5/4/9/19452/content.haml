                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Q
                        %mi f
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi i
                    %annotation{:encoding => "application/x-tex"} j_{Q Y}\circ (Q_f)_i
                are
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopic
                to each other, and since their domain is cofibrant, then by lemma
                %a.maruku-ref{:href => "#LeftHomotopyWithCofibrantDomainImpliesRightHomotopyAndDually"}
                they are also
                %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopic
                by a right homotopy
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi Q
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mi κ
                            %mtd
                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi P
                              %mi Q
                              %mi Y
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                                    %mo ∩
                                    %mi Cof
