                    %mo ,
                    %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathcal{C},W)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HomotopyCategoryOfACategoryWithWeakEquivalences"}
              %em more
              morphisms than just those in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
