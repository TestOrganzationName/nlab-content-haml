                        %mi 𝒞
                        %mi op
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi p
                          %mphantom
                            %mi AA
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
