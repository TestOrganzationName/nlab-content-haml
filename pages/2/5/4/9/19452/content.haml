            %p Some terminology:
            #CommutingDiagram.num_defn
              %h6#definition_2 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"}> commuting diagram
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Categories"}
                %a.existingWikiWord{:href => "/nlab/show/directed+graph"} directed graph
                with
                %a.existingWikiWord{:href => "/nlab/show/edges"} edges
                labeled by
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                of the category is called a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                if for any two
                %a.existingWikiWord{:href => "/nlab/show/vertices"} vertices
                any two ways of passing along edges from one to the other yields the same
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                of the corresponding
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
              %p
                For example, a
                %em commuting triangle
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo =
                      %mi h
                      %mo ∘
                      %mi g
                      %mphantom
                        %mi AAAAAA
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi g
                              %mo ↙
