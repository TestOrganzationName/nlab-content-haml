            #BetweenCofibFibLeftAndRightHomotopyAreEquivalentEquivalenceRelations.num_prop
              %h6#proposition_4 Proposition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a cofibrant object in a
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
                %a.existingWikiWord{:href => "/nlab/show/relations"} relations
                of
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %msub
                        %mo ⇒
                        %mi L
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f \Rightarrow_L g
                and of
                %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopy
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %msub
                        %mo ⇒
                        %mi R
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f \Rightarrow_R g
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LeftAndRightHomotopyInAModelCategory"}
                %a.existingWikiWord{:href => "/nlab/show/hom+set"} hom set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hom
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom(X,Y)
                coincide and are both
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+relations"} equivalence relations
            .proof
              %h6#proof_7 Proof
              %p
                That both relations coincide under the (co-)fibrancy assumption follows directly from lemma
                = succeed "." do
                  %a.maruku-ref{:href => "#LeftHomotopyWithCofibrantDomainImpliesRightHomotopyAndDually"}
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/symmetric+relation"} symmetry
                and
                %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"} reflexivity
                of the relation is obvious.
              %p
                That right homotopy (hence also left homotopy) with domain
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a
                %a.existingWikiWord{:href => "/nlab/show/transitive+relation"} transitive relation
                follows from using example
                %a.maruku-ref{:href => "#ComposedPathSpaceObjects"}
                to compose path space objects.
            %h3#TheHomotopyCategory The homotopy category
            %p
              We discuss the construction that takes a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              = succeed "," do
                %a.maruku-ref{:href => "#ModelCategory"}
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              into actual
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            #HomotopyCategoryOfAModelCategory.num_defn
              %h6#definition_9 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"}> homotopy category of a model category
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                = succeed "." do
                  %a.maruku-ref{:href => "#ModelCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
                for the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                whose
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                    are those objects of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    which are both
                    %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant
                    and
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                    are the
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
                    of morphisms of
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                    of morphism under the equivalence relation of prop.
                    = succeed ";" do
                      %a.maruku-ref{:href => "#BetweenCofibFibLeftAndRightHomotopyAreEquivalentEquivalenceRelations"}
              %p
                and whose
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                operation is given on representatives by composition in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %p
