                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %mi 𝕃
                                  %munder
                                    %mi lim
                                    %mo ⟶
                                  %mphantom
                                    %mi AA
                          %mtr
                            %mtd
                              %mover
                                %mo ⟵
