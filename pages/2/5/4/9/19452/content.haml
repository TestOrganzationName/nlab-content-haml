                              %mo{:stretchy => "false"} (
                              %mi 𝒞
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      I_{Top^{\ast/}}^{\mathcal{C}}
                      \\;\coloneqq\;
                      \\left\{
                      y(c) \wedge (S^{n-1}_+ \overset{(\iota_n)_+}{\longrightarrow} D^n_+)
                      \\right\}_{{n \in \mathbb{N},} \atop {c \in Obj(\mathcal{C})}}
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
