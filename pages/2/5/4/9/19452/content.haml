                  %semantics
                    %mrow
                      %mi A
                      %mo ⊗
                      %msub
                        %mi C
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} A \otimes C_2
                always exists and is the free module over the tensor product in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                of the two generators:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊗
                      %msub
                        %mi C
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⊗
                        %mi A
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊗
                      %msub
                        %mi C
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi A
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi C
                        %mn 1
                      %mo ⊗
                      %msub
                        %mi C
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (A \otimes C_1) \otimes_A (A \otimes C_2)
