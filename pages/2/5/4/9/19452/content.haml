                = succeed "," do
                  %a.maruku-ref{:href => "#MappingTopologicalSpaceIsExponentialObject"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                of def.
                = succeed "." do
                  %a.maruku-ref{:href => "#TopologicalInterval"}
            .num_example
              %h6#example_28 Example
              %p
                The endpoint inclusion into the standard interval, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalInterval"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi I
                    %annotation{:encoding => "application/x-tex"} X^I
                of def.
                %a.maruku-ref{:href => "#TopologicalPathSpace"}
                factor the
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                through the inclusion of constant paths and the endpoint evaluation of paths:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %msup
                            %mi X
                            %mrow
                              %mi I
                              %mo →
                              %mo *
                      %msup
                        %mi X
                        %mi I
                      %mover
                        %mo ⟶
                        %mrow
                          %msup
                            %mi X
                            %mrow
                              %mo *
                              %mo ⊔
                              %mo *
                              %mo →
                              %mi I
                      %mi X
                      %mo ×
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Delta_X
                      \\;\colon\;
                      X \stackrel{X^{I \to \ast}}{\longrightarrow} X^I \stackrel{X^{\ast \sqcup \ast \to I}}{\longrightarrow} X \times X
                      \\,.
              %p
                This is the
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
                to example
                = succeed "." do
                  %a.maruku-ref{:href => "#TopologicalInterval"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopologicalPathSpaceIsGoodPathSpaceObject"}
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi X
                            %mrow
                              %mi I
                              %mo →
                              %mo *
                        %annotation{:encoding => "application/x-tex"} X^{I \to \ast}
                    is a
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi X
                            %mrow
                              %mo *
                              %mo ⊔
                              %mo *
                              %mo →
                              %mi I
                        %annotation{:encoding => "application/x-tex"} X^{\ast \sqcup \ast \to I}
                    is a
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %p
                So while in general the
                %a.existingWikiWord{:href => "/nlab/show/diagonal"} diagonal
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \Delta_X
                is far from being an
                %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                or even just a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
                may be thought of as replacing
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            #RightHomotopy.num_defn
              %h6#definition_37 Definition
