                          %mi 𝒟
                          %mo ′
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi lim
                        %mi 𝒟
                      %msub
                        %mi F
                        %mrow
                          %mi 𝒟
                          %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      lim F \simeq lim_{\mathcal{D}}  (lim_{\mathcal{D}'} F_{\mathcal{D}} )
                      \\simeq
                      lim_{\mathcal{D}'}  (lim_{\mathcal{D}} F_{\mathcal{D}'} )
              %p
                is an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .proof
              %h6#proof_7 Proof
              %p
                Since the
                = succeed "-construction" do
                  %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                functor to the
                %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant
                = succeed "-functor," do
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                %em
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoints+preserve+limits"} right adjoints preserve limits
                (Prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#AdjointsPreserveCoLimits"}
            %p
              See
              %em
                %a.existingWikiWord{:href => "/nlab/show/limits+and+colimits+by+example"} limits and colimits by example
              for what formula
              %a.maruku-eqref{:href => "#eq:ComparisonMorphismForCommutingLimits"} (55)
              says for instance for the special case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo =
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} =
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            .num_remark
              %h6#remark_2 Remark
              %p
                %strong (general non-commutativity of limits with colimits)
              %p
                In general limits do
                %em not
                commute with
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/commutativity+of+limits+and+colimits"} commutativity of limits and colimits
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            #PointwiseExpressionOfLeftAdjoints.num_prop
              %h6#proposition_4 Proposition
              %p
                %strong
                  (pointwise expression of
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoints"} left adjoints
                  in terms of
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                  over
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/comma+categories"} comma categories
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo ⟶
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} R \;\colon\; \mathcal{C} \longrightarrow \mathcal{D}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Functors"}
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒟
                      %mo ⟶
