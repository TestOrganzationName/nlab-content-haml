                      \\;\coloneqq\;
                      \\left\{
                      y(c)\cdot (D^n \overset{(id, \delta_0)}{\longrightarrow} D^n \times I)
                      \\right\}_{{n \in \mathbb{N},} \atop {c \in Obj(\mathcal{C})}}
              %p
                for the sets of morphisms given by
                %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TensoringAndPoweringOfTopologicallyEnrichedCopresheaves"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopologicallyEnrichedFunctorsToTopk"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopologicalGeneratingCofibrations"}
                = succeed ")," do
                  %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi cg
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} (Top_{cg})_{Quillen}
