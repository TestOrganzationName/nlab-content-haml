                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %msub
                        %mi W
                        %mi cl
                      %mo ∩
                      %msub
                        %mi Cof
                        %mi cl
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Cof_{cl} \Box (W_{cl} \cap Cof_{cl}) \subset W_{cl}\cap Cof_{cl}
                      \\,.
            .proof
