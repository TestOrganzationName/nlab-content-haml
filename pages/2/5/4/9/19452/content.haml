                    %annotation{:encoding => "application/x-tex"} f\in K
                and is hence in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                        %mi Proj
                      %annotation{:encoding => "application/x-tex"} K Proj
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
            %p
              An immediate consequence of prop.
              %a.maruku-ref{:href => "#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}
              is this:
            #SaturationOfGeneratingCofibrations.num_prop
              %h6#corollary Corollary
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
