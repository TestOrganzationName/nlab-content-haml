                of a
                %a.existingWikiWord{:href => "/nlab/show/partially+ordered+set"} partially ordered set
                via
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:RelationsAsMorphismInPartiallyOrderedSet"} (1)
              %p
