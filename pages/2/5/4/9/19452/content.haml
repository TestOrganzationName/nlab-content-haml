                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/local+morphisms"} local morphisms
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
              %p
                Thus the essentially unique factorization of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
