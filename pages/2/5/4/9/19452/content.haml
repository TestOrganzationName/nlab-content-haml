                          %mo ,
                          %msub
                            %mi i
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mi X
                      %mo ×
                      %mi I
                      %mo ⟶
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      X \sqcup X
