            #ProjectiveModelStructureOnNSequencesOfTopologicalSpaces.num_example
              %h6#example_45 Example
              %p
                Write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℕ
                        %mo ≤
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}^{\leq}
                for the
                %a.existingWikiWord{:href => "/nlab/show/poset"} poset
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#PosetsWosetTosetsAndOrdinals"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/natural+numbers"} natural numbers
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                (with at most one morphism from any given object to any other given object) that looks like
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℕ
                        %mo ≤
                      %mo =
                      %mrow
                        %mo {
                        %mn 0
                        %mo →
                        %mn 1
                        %mo →
                        %mn 2
                        %mo →
                        %mn 3
                        %mo →
                        %mi ⋯
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{N}^{\leq}
                      \=
                      \\left\{
                      0 \to 1 \to 2 \to 3 \to \cdots
                      \\right\}
                      \\,.
              %p
                Regard this as a
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
                with the, necessarily,
                %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topology
                on its
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              %p
                Then a
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functor"} topologically enriched functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi ℕ
                        %mo ≤
                      %mo ⟶
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"}
                      X_\bullet
                      \\;\colon\;
                      \\mathbb{N}^{\leq}
                      \\longrightarrow
                      Top_{cg}
              %p
                is just a plain functor and is equivalently a sequence of
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                (morphisms in
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi cg
                      %annotation{:encoding => "application/x-tex"} Top_{cg}
                = succeed ")" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cotower"} cotower
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mn 0
                      %msub
                        %mi X
                        %mn 1
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mn 1
                      %msub
                        %mi X
                        %mn 2
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mn 2
                      %msub
                        %mi X
                        %mn 3
                      %mo ⟶
                      %mi ⋯
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      X_0
                      \\overset{f_0}{\longrightarrow}
                      X_1
                      \\overset{f_1}{\longrightarrow}
                      X_2
                      \\overset{f_2}{\longrightarrow}
                      X_3
                      \\longrightarrow
                      \\cdots
                      \\,.
              %p
                It is immediate to check that those sequences
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
