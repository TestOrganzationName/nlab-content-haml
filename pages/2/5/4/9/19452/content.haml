                      Hom_{\mathcal{V}}\left(1,
                      \\left(
                      \\underset{c \in \mathcal{C}}{\int}
                      \\big[ F(c),G(c) \big]
                      \\right)
                      \\right)
                      \\;\simeq\;
                      Hom_{[\mathcal{C}, \mathcal{V}]}(F,G)
                      \\,.
            .proof
              %h6#proof_9 Proof
              %p
                The underlying pointed set functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒱
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒱
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{V}}(1,-)\colon \mathcal{V}\to Set
                %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                all
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                %a.existingWikiWord{:href => "/nlab/show/hom-functors+preserve+limits"} hom-functors preserve limits
                (Prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#HomFunctorPreservesLimits"}
                %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
                diagram in
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒱
                      %mrow
                        %mo (
                        %mn 1
                        %mo ,
                        %mrow
                          %mo (
                          %munder
                            %mo ∫
                            %mrow
                              %mi c
                              %mo ∈
                              %mi 𝒞
                          %mo{:stretchy => "false"} [
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi G
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} ]
                          %mo )
                        %mo )
                      %mover
                        %mo ⟶
                        %mi equ
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi c
                          %mo ∈
                          %mi 𝒞
                      %msub
                        %mi Hom
                        %mi 𝒱
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %munderover
                        %mphantom
                          %mi AAAAAAAA
                        %munder
                          %mo ⟶
                          %mrow
                            %munder
                              %mo ⊔
                              %mrow
                                %mi c
                                %mo ,
                                %mi d
                            %mi U
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi ρ
                                %mo{:stretchy => "false"} ˜
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi c
                                %mo ,
                                %mi d
                                %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mover
                          %mo ⟶
                          %mrow
                            %munder
                              %mo ⊔
                              %mrow
                                %mi c
                                %mo ,
                                %mi d
                            %mi U
                            %mo{:stretchy => "false"} (
                            %msub
                              %mover
                                %mi ρ
                                %mo{:stretchy => "false"} ˜
                              %mrow
                                %mi d
                                %mo ,
                                %mi c
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi c
                          %mo ,
                          %mi d
                          %mo ∈
                          %mi 𝒞
                      %msub
                        %mi Hom
                        %mi 𝒱
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{V}}\left(1,
                      \\left(
                      \\underset{c\in \mathcal{C}}{\int}
