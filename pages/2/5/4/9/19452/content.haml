            .num_remark
              %h6#remark_33 Remark
              %p
                Since every object in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi cg
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} (Top_{cg})_{Quillen}
                and in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} )
