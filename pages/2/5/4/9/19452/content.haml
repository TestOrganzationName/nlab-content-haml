                      %mi X
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{Top}(X,Y) \simeq Hom_{Top_{cg}}(X, k(Y))
                      \\,.
              %p
                This means equivalently that the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#kfication"}
                %a.maruku-ref{:href => "#kTop"}
                forms an pair of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ⟵
                          %mi k
                        %mo ↪
                      %mi Top
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Top_{cg}
                      \\underoverset
                      {\underset{k}{\longleftarrow}}
                      {\hookrightarrow}
                      {\bot}
                      Top
                      \\,.
