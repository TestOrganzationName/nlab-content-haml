                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} X \in Top_{cg}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo ∈
                        %mo{:stretchy => "false"} [
                        %mi 𝒞
                        %mo ,
                        %msub
                          %mi Top
                          %mi cg
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} F \in [\mathcal{C}, Top_{cg}]
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                between
              %ol
                %li
                  %p
                    morphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                          %mo{:stretchy => "false"} (
