                    %annotation{:encoding => "application/x-tex"} (\mathcal{C},W,Cof,Fib)
            #MorphismIsWeakEquivalenceIfIsoInHomotopyCategoryForQuillen.num_prop
              %h6#proposition_6 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                  of
                  %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                  inverts precisely the
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ModelCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo ⟶
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma \;\colon\; \mathcal{C} \longrightarrow Ho(\mathcal{C})
                be its
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                functor (def.
                = succeed "," do
                  %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
                = succeed ")." do
                  %a.maruku-ref{:href => "#UniversalPropertyOfHomotopyCategoryOfAModelCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is a
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                precisely if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma(f)
                is an
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "Simplicial+homotopy+Theory"} Goerss-Jardine 96, II, prop 1.14
            %p
              While the construction of the homotopy category in def.
              %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
              combines the restriction to good (fibrant/cofibrant) objects with the passage to
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of morphisms, it is often useful to consider intermediate stages:
            #FullSubcategoriesOfFibrantCofibrantObjects.num_defn
