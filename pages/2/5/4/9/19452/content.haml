                    with respect to
                    %a.existingWikiWord{:href => "/nlab/show/Cech+covers"} Cech covers
            .proof
              %h6#proof_2 Proof
              %p
                By
                %a.maruku-eqref{:href => "#eq:HomObjectOfEnrichedFunctorCategoryViaEnd"} (58)
                the hom-groupoid is computed as the
                %a.existingWikiWord{:href => "/nlab/show/end"} end
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Grpd
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mo (
