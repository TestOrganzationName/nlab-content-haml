                            %mover
                              %mi F
                              %mo{:stretchy => "false"} ˜
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \kappa \colon \tilde F_1 \Rightarrow \tilde F_2
                    making the evident diagram of natural isomorphisms commute.
            #UniversalPropertyOfHomotopyCategoryOfAModelCategory.num_theorem
              %h6#theorem Theorem
              %p
                %strong
                  (convenient
                  %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mrow
                          %mi P
                          %mo ,
                          %mi Q
                    %annotation{:encoding => "application/x-tex"} \gamma_{P,Q}
                in def.
                %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
                (for any choice of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                      %annotation{:encoding => "application/x-tex"} Q
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
                as indeed being the
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                of the underlying
                %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
                at its weak equivalences, in the sense of def.
                = succeed ":" do
                  %a.maruku-ref{:href => "#HomotopyCategoryOfACategoryWithWeakEquivalences"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi 𝒞
                            %mtd
                              %mo =
                            %mtd
                              %mi 𝒞
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi γ
                                      %mrow
                                        %mi P
                                        %mo ,
                                        %mi Q
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi γ
                          %mtr
                            %mtd
                              %mi Ho
                              %mo{:stretchy => "false"} (
                              %mi 𝒞
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                            %mtd
                              %mi 𝒞
                              %mo{:stretchy => "false"} [
                              %msup
                                %mi W
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathcal{C} &amp;=&amp; \mathcal{C}
                      \\\
                      {}^{\mathllap{\gamma_{P,Q}}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\gamma}}
                      \\\
                      Ho(\mathcal{C}) &amp;\simeq&amp; \mathcal{C}[W^{-1}]
                      }
                      \\,.
            %p
              (
              %a{:href => "model+category#Quillen67"}> Quillen 67, I.1 theorem 1
              )
            #ProofOfUniversalPropertyOfHomotopyCategoryOfAModelCategory.proof
              %h6#proof_11 Proof
              %p
                First, to see that that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mrow
                          %mi P
                          %mo ,
                          %mi Q
                    %annotation{:encoding => "application/x-tex"} \gamma_{P,Q}
                indeed takes weak equivalences to isomorphisms: By
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagrams"} commuting diagrams
                shown in the proof of lemma
                = succeed "," do
                  %a.maruku-ref{:href => "#ConstructionOfLocalizationFunctorForModelCategoryIsWellDefined"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mi Q
                      %mi f
                    %annotation{:encoding => "application/x-tex"} P Q f
                is a weak equivalence if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %munderover
                                %mo ⟵
                                %mo ≃
                                %mrow
                                  %msub
                                    %mi p
                                    %mi X
                            %mtd
                              %mi Q
                              %mi X
                            %mtd
                              %munderover
                                %mo ⟶
                                %mo ≃
                                %mrow
                                  %msub
                                    %mi j
                                    %mrow
                                      %mi Q
                                      %mi X
                            %mtd
                              %mi P
                              %mi Q
                              %mi X
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi f
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mi Q
                                    %mi f
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mi P
                                    %mi Q
                                    %mi f
                          %mtr
                            %mtd
                              %mi Y
                            %mtd
                              %munderover
                                %mo ⟵
                                %mrow
                                  %msub
                                    %mi p
                                    %mi y
                                %mo ≃
                            %mtd
                              %mi Q
                              %mi Y
                            %mtd
                              %munderover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi j
                                    %mrow
                                      %mi Q
                                      %mi Y
                                %mo ≃
                            %mtd
                              %mi P
                              %mi Q
                              %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X &amp;\underoverset{\simeq}{p_X}{\longleftarrow}&amp; Q X &amp;\underoverset{\simeq}{j_{Q X}}{\longrightarrow}&amp; P Q X
                      \\\
                      {}^{\mathllap{f}}\downarrow &amp;&amp; \downarrow^{\mathrlap{Q f}} &amp;&amp; \downarrow^{\mathrlap{P Q f}}
                      \\\
                      Y &amp;\underoverset{p_y}{\simeq}{\longleftarrow}&amp; Q Y &amp;\underoverset{j_{Q Y}}{\simeq}{\longrightarrow}&amp; P Q Y
                      }
              %p
                With this the “Whitehead theorem for model categories”, lemma
                = succeed "," do
                  %a.maruku-ref{:href => "#WhiteheadTheoremInModelCategories"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mi Q
                      %mi f
                    %annotation{:encoding => "application/x-tex"} P Q f
                represents an isomorphism in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
              %p
                Now let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒞
                      %mo ⟶
                      %mi D
                    %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}\longrightarrow D
                be any functor that sends weak equivalences to isomorphisms. We need to show that it factors as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi 𝒞
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mi F
                            %mtd
                            %mtd
                              %mi D
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi γ
                              %mo ↘
                            %mtd
                              %msup
                                %mo ⇓
                                %mi ρ
                            %mtd
                              %msub
                                %mo ↗
                                %mpadded{:width => "0"}
                                  %mover
                                    %mi F
                                    %mo{:stretchy => "false"} ˜
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi Ho
                              %mo{:stretchy => "false"} (
                              %mi 𝒞
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathcal{C} &amp;&amp; \overset{F}{\longrightarrow} &amp;&amp; D
                      \\\
                      \&amp; {}_{\mathllap{\gamma}}\searrow &amp;\Downarrow^{\rho}&amp; \nearrow_{\mathrlap{\tilde F}}
                      \\\
                      \&amp;&amp; Ho(\mathcal{C})
                      }
              %p
                uniquely up to unique
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} Q
                in def.
                = succeed "," do
                  %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mrow
                          %mi P
                          %mo ,
                          %mi Q
                    %annotation{:encoding => "application/x-tex"} \gamma_{P,Q}
                is the identity on the
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of fibrant-cofibrant objects. It follows that if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde F
                exists at all, it must satisfy for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \stackrel{f}{\to} Y
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                both fibrant and cofibrant that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\tilde F([f]) \simeq F(f)
                      \\,,
              %p
                (hence in particular
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi F
                          %mo{:stretchy => "false"} ˜
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi γ
                          %mrow
                            %mi P
                            %mo ,
                            %mi Q
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mi P
                        %mi Q
                        %mi f
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tilde F(\gamma_{P,Q}(f)) = F(P Q f)
              %p
                But by def.
                %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
                that already fixes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde F
                on all of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde F
                there exists any
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
                filling the diagram above.
              %p
                To that end, apply
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                to the above
