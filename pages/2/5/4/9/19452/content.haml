                    that make a commuting triangle (Def.
                    = succeed "):" do
                      %a.maruku-ref{:href => "#CommutingDiagram"}
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mn 2
                          %mo ∘
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi f
                            %mn 1
                          %mphantom
                            %mi AAAAAA
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi c
                              %mtr
                                %mtd
                                %mtd
                                  %msup
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 1
                                  %mo ↙
                                %mtd
                                %mtd
                                  %msup
                                    %mo ↘
                                    %mpadded{:width => "0"}
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 2
                              %mtr
                                %mtd
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi X
                                    %mn 1
                                  %mo{:stretchy => "false"} )
                                %mtd
                                %mtd
                                  %munder
                                    %mo ⟶
