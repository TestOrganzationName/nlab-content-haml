                      %mi A
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} q \colon A \to Q
                be any other morphism with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
