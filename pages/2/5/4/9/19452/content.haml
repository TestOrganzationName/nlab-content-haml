                              %mo ,
                              %mstyle{:mathvariant => "bold"}
                                %mi Y
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                              %msub
                                %mi Hom
                                %mrow
                                  %mo{:stretchy => "false"} [
                                  %msup
                                    %mi 𝒞
                                    %mi op
