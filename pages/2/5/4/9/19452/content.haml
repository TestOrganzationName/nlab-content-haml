                          %mi R
                        %mover
                          %mo ⟵
                          %mi L
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{D}
                      \\underoverset
                      {\underset{R}{\longrightarrow}}{\overset{L}{\longleftarrow}}{\bot}
                      \\mathcal{C}
              %p
                according to Def.
                = succeed "," do
                  %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
                %a.existingWikiWord{:href => "/nlab/show/adjunction+units"} adjunction units
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
