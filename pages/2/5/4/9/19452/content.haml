                      }
                      \\,.
              %p
                here the top pushout is the one from example
                = succeed "." do
                  %a.maruku-ref{:href => "#TopologicalnSphereIsPushoutOfBoundaryOfnBallInclusionAlongItself"}
            #JTopRelativeCellComplexesAreWeakHomotopyEquivalences.num_lemma
              %h6#lemma_19 Lemma
              %p
                Every
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
                (def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopologicalCCellComplex"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                = succeed "." do
                  %a.maruku-ref{:href => "#WeakHomotopyEquivalenceOfTopologicalSpaces"}
            .proof
              %h6#proof_48 Proof
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⟶
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mo =
                      %msub
                        %munder
                          %mi lim
                          %mo ⟵
                        %mrow
                          %mi β
                          %mo ≤
                          %mi α
                      %msub
                        %mi X
                        %mi β
                    %annotation{:encoding => "application/x-tex"} X \longrightarrow \hat X = \underset{\longleftarrow}{\lim}_{\beta \leq \alpha} X_\beta
                be a
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
              %p
                First observe that with the elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                      %mo ↪
                      %msup
                        %mi D
                        %mi n
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} D^n \hookrightarrow D^n \times I
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
                being
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
                for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                (by example
                = succeed ")," do
                  %a.maruku-ref{:href => "#ProjectionFromStandardCylinderIsHomotopyEquivalence"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi β
                      %mo ⟶
                      %msub
                        %mi X
                        %mrow
                          %mi β
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} X_{\beta} \longrightarrow X_{\beta + 1}
                in the relative cell complex is also a homotopy equivalence. We make this fully explicit:
              %p
                By definition, such a stage is a
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msup
                                %mi D
                                %mrow
                                  %msub
                                    %mi n
                                    %mi i
                            %mtd
                              %mo ⟶
                            %mtd
                              %msub
                                %mi X
                                %mi β
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %munder
                                      %mo ⊔
                                      %mrow
                                        %mi i
                                        %mo ∈
                                        %mi I
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ,
                                    %msub
                                      %mi δ
                                      %mn 0
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi po
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msup
                                %mi D
                                %mrow
                                  %msub
                                    %mi n
                                    %mi i
                              %mo ×
                              %mi I
                            %mtd
                              %mo ⟶
                            %mtd
                              %msub
                                %mi X
                                %mrow
                                  %mi β
                                  %mo +
                                  %mn 1
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\underset{i \in I}{\sqcup} D^{n_i}
                      \&amp;\longrightarrow&amp;
                      X_\beta
                      \\\
                      {}^{\mathllap{\underset{i \in I}{\sqcup} (id, \delta_0)} }\downarrow
                      \&amp;(po)&amp;
                      \\downarrow
                      \\\
                      \\underset{i \in I}{\sqcup} D^{n_i} \times I
                      \&amp;\longrightarrow&amp;
                      X_{\beta + 1}
                      }
                      \\,.
              %p
                Then the fact that the projections
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mrow
                          %msub
                            %mi n
                            %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi D
                        %mrow
