                  –
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/codescent"} codescent
              %p
                For
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
                regarded as a
                %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
                (Example
                = succeed ")," do
                  %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                a
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Coverage"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
