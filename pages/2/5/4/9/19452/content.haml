              %p
                The following are examples of
                %a.existingWikiWord{:href => "/nlab/show/cosmoi"} cosmoi
                (Def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#Cosmos"}
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Sh
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C})
                    the
                    %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Sheaf"}
                    %a.existingWikiWord{:href => "/nlab/show/site"} site
                    (Def.
                    = succeed ")" do
