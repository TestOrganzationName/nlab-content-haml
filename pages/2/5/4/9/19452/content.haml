                        %mo *
                    %annotation{:encoding => "application/x-tex"} Disc \simeq p^\ast
                is the
                %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant
                = succeed "-assigning" do
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                = succeed ")" do
                  %a.maruku-ref{:href => "#UniquenessOfAdjoints"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
