                      \&amp;\stackrel{X_{1,2}}{\to}&amp; X_2
                      \&amp;\to&amp; \cdots
                      \\\
                      \&amp; \searrow &amp; \downarrow &amp; \swarrow &amp; \cdots
                      \\\
                      \&amp;&amp;
                      X_\alpha
                      }
                      \\,.
            %p
              We now turn to the discussion of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/exponential+objects"} exponential objects
            #CompactOpenTopology.num_defn
              %h6#definition_30 Definition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                a
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                (in that for every point, every
                %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                contains a
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                neighbourhood), the
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi Y
                      %mo ∈
                      %mi Top
                    %annotation{:encoding => "application/x-tex"}
                      X^Y \in Top
              %p
                is the
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %ul
                %li
                  %p
                    whose underlying set is the set
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi Top
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Hom_{Top}(Y,X)
                    of
                    %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Y
                            %mo →
                            %mi X
                          %annotation{:encoding => "application/x-tex"} Y \to X
                %li
                  %p
                    whose
                    %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                    are
                    %a.existingWikiWord{:href => "/nlab/show/unions"} unions
                    of
                    %a.existingWikiWord{:href => "/nlab/show/finitary+intersections"} finitary intersections
                    of the following
                    %a.existingWikiWord{:href => "/nlab/show/topological+base"} subbase
                    elements of standard open subsets:
                  %p
                    the standard open subset
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi U
                            %mi K
                          %mo ⊂
                          %msub
                            %mi Hom
                            %mi Top
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} U^K \subset Hom_{Top}(Y,X)
                    for
                  %ul
                    %li
                      %p
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi K
                              %mo ↪
                              %mi Y
                            %annotation{:encoding => "application/x-tex"} K \hookrightarrow Y
                        a
                        %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
                        subset
                    %li
                      %p
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi U
                              %mo ↪
                              %mi X
                            %annotation{:encoding => "application/x-tex"} U \hookrightarrow X
                        an
                        %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                  %p
                    is the subset of all those
                    %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                    that fit into a
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                    of the form
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi K
                                %mtd
                                  %mo ↪
                                %mtd
                                  %mi Y
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                %mtd
                                  %msup
                                    %mo{:stretchy => "false"} ↓
                                    %mpadded{:width => "0"}
                                      %mi f
                              %mtr
                                %mtd
                                  %mi U
                                %mtd
                                  %mo ↪
                                %mtd
                                  %mi X
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          K &amp;\hookrightarrow&amp; Y
                          \\\
                          \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                          \\\
                          U &amp;\hookrightarrow&amp; X
                          }
                          \\,.
              %p
                Accordingly this is called the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
                on the set of functions.
              %p
                The construction extends to a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mi Top
                        %mi lc
                        %mi op
                      %mo ×
                      %mi Top
                      %mo ⟶
                      %mi Top
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (-)^{(-)} \;\colon\; Top_{lc}^{op} \times Top \longrightarrow Top
                      \\,.
            #MappingTopologicalSpaceIsExponentialObject.num_prop
              %h6#proposition_29 Proposition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                a
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                (in that for each point, each open neighbourhood contains a
                %a.existingWikiWord{:href => "/nlab/show/compact+subset"} compact
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
                %strong
                  topological
                  %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} X^Y
                from def.
                %a.maruku-ref{:href => "#CompactOpenTopology"}
                is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/exponential+object"} exponential object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} (-)^Y
                is
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                to the product functor
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ×
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Y \times (-)
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi Top
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo ×
                      %mi Y
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi Hom
                        %mi Top
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo ,
                      %msup
                        %mi X
                        %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{Top}(Z \times Y, X) \simeq Hom_{Top}(Z, X^Y)
              %p
                between continuous functions out of any
                %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                with any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                      %mo ∈
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Z \in Top
                and continuous functions from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
                into the mapping space.
            %p
              A proof is spelled out
              %a{:href => "compact-open+topology#GivesExponentialObject"} here
              (or see e.g.
              = succeed ")." do
                %a{:href => "#AguilarGitlerPrieto02"} Aguilar-Gitler-Prieto 02, prop. 1.3.1
            #UseOfHausdorffnessInCOTopology.num_remark
              %h6#remark_16 Remark
              %p
                In the context of prop.
                %a.maruku-ref{:href => "#MappingTopologicalSpaceIsExponentialObject"}
                it is often assumed that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is also a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff topological space
            #ProblemWithExponentialsInTop.num_remark
              %h6#remark_17 Remark
              %p
                Proposition
                %a.maruku-ref{:href => "#MappingTopologicalSpaceIsExponentialObject"}
                fails in general if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is not locally compact. Therefore the plain category
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                of all topological spaces is not a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+closed+category"} Cartesian closed category
              %p
                This is no problem for the construction of the homotopy theory of topological spaces as such, but it becomes a technical nuisance for various constructions that one would like to perform within that homotopy theory. For instance on general
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
                the
                %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                is in general not
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              %p
                On the other hand, without changing any of the following discussion one may just pass to a more
                %a.existingWikiWord{:href => "/nlab/show/convenient+category+of+topological+spaces"} convenient category of topological spaces
                such as notably the
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                      %mo ↪
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top_{cg} \hookrightarrow Top
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#kTop"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+closed+category"} Cartesian closed
                = succeed "." do
                  %a{:href => "#ModelStructureOnCompactlyGeneratedTopologicalSpaces"} below
            %h3#homotopy_2 Homotopy
            %p
              The fundamental concept of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              is clearly that of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              this is about
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} contiunous
              deformations of
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              parameterized by the standard interval:
            #TopologicalInterval.num_defn
              %h6#definition_31 Definition
              %p Write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ≔
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo ↪
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      I \coloneqq [0,1] \hookrightarrow \mathbb{R}
              %p
                for the standard
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+interval"} topological interval
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                %a.existingWikiWord{:href => "/nlab/show/connected+topological+space"} connected
                %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                of the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
              %p Equipped with the canonical inclusion of its two endpoints
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo ⊔
                      %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi δ
                            %mn 0
                          %mo ,
                          %msub
                            %mi δ
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %mi I
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∃
                          %mo !
                      %mo *
                    %annotation{:encoding => "application/x-tex"}
                      \\ast \sqcup \ast \stackrel{(\delta_0,\delta_1)}{\longrightarrow} I \stackrel{\exists !}{\longrightarrow} \ast
              %p
                this is the standard
                %a.existingWikiWord{:href => "/nlab/show/interval+object"} interval object
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∈
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} X \in Top
                %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mi I
                      %annotation{:encoding => "application/x-tex"} X\times I
                = succeed "," do
                  %a.maruku-ref{:href => "#ProductTopologicalSpace"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/codiagonal"} codiagonal
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∇
                        %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mo ⊔
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} (
                          %mi id
                          %mo ,
                          %msub
                            %mi δ
                            %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mo{:stretchy => "false"} (
                          %mi id
                          %mo ,
                          %msub
                            %mi δ
                            %mn 1
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mi X
                      %mo ×
                      %mi I
                      %mo ⟶
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\nabla_X
                      \\;\colon\;
                      X \sqcup X
                      \\stackrel{((id,\delta_0),(id,\delta_1))}{\longrightarrow}
                      X \times I
                      \\longrightarrow
                      X
                      \\,.
            #LeftHomotopy.num_defn
              %h6#definition_32 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/left+homotopy"}> left homotopy
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f,g\colon X \longrightarrow Y
                two
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                between
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X,Y
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mo ⇒
                        %mi L
                      %mspace{:width => "thinmathspace"}
                      %mi g
                    %annotation{:encoding => "application/x-tex"}
                      \\eta \colon f \,\Rightarrow_L\, g
              %p
                is a
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mo ×
                      %mi I
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      \\eta \;\colon\; X \times I \longrightarrow Y
              %p
                out of the standard
                %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
                over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalInterval"}
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                of the form
              %div{:style => "float:right;margin:0 10px 10px 0;"}
                %img{:src => "http://www.ncatlab.org/nlab/files/AHomotopy.jpg", :width => "400"}/
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ,
                                    %msub
                                      %mi δ
                                      %mn 0
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                              %mi X
                              %mo ×
                              %mi I
                            %mtd
                              %mover
                                %mo ⟶
                                %mi η
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ,
                                    %msub
                                      %mi δ
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %msub
                                %mo ↗
                                %mpadded{:width => "0"}
                                  %mi g
                          %mtr
                            %mtd
                              %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X
                      \\\
                      {}^{\mathllap{(id,\delta_0)}}\downarrow &amp; \searrow^{\mathrlap{f}}
                      \\\
                      X \times I &amp;\stackrel{\eta}{\longrightarrow}&amp; Y
                      \\\
                      {}^{\mathllap{(id,\delta_1)}}\uparrow &amp; \nearrow_{\mathrlap{g}}
                      \\\
                      X
                      }
                      \\,.
              %p
                (graphics grabbed from J. Tauber
                = succeed ")" do
                  %a{:href => "http://jtauber.com/blog/2005/07/01/path_homotopy/"} here
            #PathsAsLeftHomotopyBetweenPoints.num_example
              %h6#example_24 Example
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x,y \in X
                be two of its points, regarded as functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo ⟶
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x,y \colon \ast \longrightarrow X
                from the point to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %a.maruku-ref{:href => "#LeftHomotopy"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi δ
                                      %mn 0
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mi x
                          %mtr
                            %mtd
                              %mi I
                            %mtd
                              %mover
                                %mo ⟶
                                %mi η
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi δ
                                      %mn 1
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %msub
                                %mo ↗
                                %mpadded{:width => "0"}
                                  %mi y
                          %mtr
                            %mtd
                              %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\ast
                      \\\
                      {}^{\mathllap{\delta_0}}\downarrow &amp; \searrow^{\mathrlap{x}}
                      \\\
                      I &amp;\stackrel{\eta}{\longrightarrow}&amp; Y
                      \\\
                      {}^{\mathllap{\delta_1}}\uparrow &amp; \nearrow_{\mathrlap{y}}
                      \\\
                      \\ast
                      }
                      \\,.
              %p
                This is simply a continuous path in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                whose endpoints are
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
            %p For instance:
            #StandardContractionOfStandardInterval.num_example
              %h6#example_25 Example
              %p Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi const
                        %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi I
                      %mo ⟶
                      %mo *
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi δ
                            %mn 0
                      %mi I
                    %annotation{:encoding => "application/x-tex"}
                      const_0 \;\colon\; I \longrightarrow \ast \overset{\delta_0}{\longrightarrow} I
              %p
                be the
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                from the standard interval
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} I = [0,1]
                to itself that is constant on the value 0. Then there is a left homotopy, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#LeftHomotopy"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi id
                        %mi I
                      %mo ⇒
                      %msub
                        %mi const
                        %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\eta \;\colon\; id_I \Rightarrow const_0
              %p given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi x
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo −
                      %mi t
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\eta(x,t) \coloneqq x(1-t)
                      \\,.
            %p
              A key application of the concept of left homotopy is to the definition of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            #HomotopyGroupsOftopologicalSpaces.num_defn
              %h6#definition_33 Definition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_0(X)
                of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                = succeed "," do
                  %strong 0-th homotopy set
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
                %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LeftHomotopy"}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo{:lspace => "verythinmathspace"} :
                        %mo *
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                (example
                = succeed ")." do
                  %a.maruku-ref{:href => "#PathsAsLeftHomotopyBetweenPoints"}
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                this extends to a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mn 0
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Top
                      %mo ⟶
                      %mi Set
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\pi_0 \colon Top \longrightarrow Set
                      \\,.
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≥
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n \geq 1
                and for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
                any point, then the
                = succeed "th" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_n(X,x)
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                at
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                is the
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %ul
                %li
                  %p
                    whose underlying
                    %a.existingWikiWord{:href => "/nlab/show/set"} set
                    is the set of
                    = succeed "-" do
                      %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
                    %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                    of maps
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi I
                            %mi n
                          %mo ⟶
                          %mi X
                        %annotation{:encoding => "application/x-tex"} I^n \longrightarrow X
                    that take the
                    %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi I
                            %mi n
                        %annotation{:encoding => "application/x-tex"} I^n
                    to
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
                    and where the left homotopies
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi η
                        %annotation{:encoding => "application/x-tex"} \eta
                    are constrained to be constant on the boundary;
                %li
                  %p
                    whose
                    %a.existingWikiWord{:href => "/nlab/show/group"} group
                    product operation takes
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi α
                          %mo{:lspace => "verythinmathspace"} :
                          %msup
                            %mi I
                            %mi n
                          %mo →
                          %mi X
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [\alpha \colon I^n \to X]
                    and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi β
                          %mo{:lspace => "verythinmathspace"} :
                          %msup
                            %mi I
                            %mi n
                          %mo →
                          %mi X
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [\beta \colon I^n \to X]
                    to
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi α
                          %mo ⋅
                          %mi β
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [\alpha \cdot \beta]
                    with
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ⋅
                      %mi β
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi I
                        %mi n
                      %mover
                        %mo ⟶
                        %mo ≃
                      %msup
                        %mi I
                        %mi n
                      %munder
                        %mo ⊔
                        %mrow
                          %msup
                            %mi I
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                      %msup
                        %mi I
                        %mi n
                      %mover
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi α
                          %mo ,
                          %mi β
                          %mo{:stretchy => "false"} )
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\alpha \cdot \beta
                      \\;\colon\;
                      I^n
                      \\stackrel{\simeq}{\longrightarrow}
                      I^n \underset{I^{n-1}}{\sqcup} I^n
                      \\stackrel{(\alpha,\beta)}{\longrightarrow}
                      X
                      \\,,
              %p
                where the first map is a
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
                from the unit
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/cube"} cube
                to the
                = succeed "-cube" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %msub
                          %mi x
                          %mn 2
                        %mo ,
                        %msub
                          %mi x
                          %mn 3
                        %mo ,
                        %mi ⋯
                        %mo{:stretchy => "false"} )
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %msub
                          %mi x
                          %mn 2
                        %mo ,
                        %msub
                          %mi x
                          %mn 3
                        %mo ,
                        %mi ⋯
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (x_1, x_2, x_3, \cdots) \mapsto (2 x_1, x_2, x_3, \cdots)
              %p
                By
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
                          %mo •
                          %mo ≥
                          %mn 1
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ⟶
                      %msup
                        %mi Grp
                        %mrow
                          %msub
                            %mi ℕ
                            %mrow
                              %mo ≥
                              %mn 1
                    %annotation{:encoding => "application/x-tex"}
                      \\pi_{\bullet \geq 1}
                      \\;\colon\;
                      Top^{\ast/}
                      \\longrightarrow
                      Grp^{\mathbb{N}_{\geq 1}}
              %p
                from
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
                to
                %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/groups"} groups
            %p
              Notice that often one writes the value of this functor on a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              as
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                      %mo =
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f_\ast = \pi_\bullet(f)
            .num_remark
              %h6#remark_18 Remark
              %p
                At this point we don’t go further into the abstract reason why def.
                %a.maruku-ref{:href => "#HomotopyGroupsOftopologicalSpaces"}
                yields group structure above degree 0, which is that
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/positive+dimension+spheres+are+H-cogroup+objects"} positive dimension spheres are H-cogroup objects
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Brown+representability+theorem"} Brown representability theorem
                %em
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#BrownRepresentabilityTheorem"} Brown representability theorem
                in
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+S"} Part S
            #HomotopyEquivalence.num_defn
              %h6#definition_34 Definition
              %p
                %strong
                  (
