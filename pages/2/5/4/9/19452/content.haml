                                %mi 𝒞
                                %mi op
                              %mo ,
                              %mi sSet
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} (
                              %munder
                                %mi lim
                                %mo ⟶
                              %mi C
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} }
                              %mo{:stretchy => "false"} )
                              %mo ,
