                                      %mrow
                                        %mi L
                                        %mo{:stretchy => "false"} (
                                        %mi c
                                        %mo{:stretchy => "false"} )
                                  %mo ˜
                                %mo ˜
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mover
                                %mrow
                                  %mi c
                                  %mover
                                    %mo →
                                    %mrow
                                      %msub
                                        %mi η
                                        %mi c
                                  %mi R
                                  %mo{:stretchy => "false"} (
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo{:stretchy => "false"} )
                                  %mo{:stretchy => "false"} )
                                %mo ˜
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi η
                                    %mi c
                                  %mo{:stretchy => "false"} )
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi R
                              %mo{:stretchy => "false"} (
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi ϵ
                                    %mrow
                                      %mi L
                                      %mo{:stretchy => "false"} (
                                      %mi c
                                      %mo{:stretchy => "false"} )
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
