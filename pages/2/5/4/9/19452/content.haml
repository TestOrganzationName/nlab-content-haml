                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X,Y
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopy
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %msub
                        %mo ⇒
                        %mi R
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f \Rightarrow_R g
                is a
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mo ⟶
                      %msup
                        %mi Y
                        %mi I
                    %annotation{:encoding => "application/x-tex"}
                      \\eta \;\colon\; X \longrightarrow Y^I
              %p
                into the
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalPathSpace"}
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi f
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↑
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msup
