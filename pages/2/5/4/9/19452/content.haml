                    %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Tychonoff+product"} Tychonoff product
              %p
                In the case that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \times Y
                %a.existingWikiWord{:href => "/nlab/show/basis+for+a+topology"} sub-basis
                for the product topology is given by the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
                of the open subsets of (a basis for) each factor space.
            #EqualizerInTop.num_example
              %h6#example_18 Example
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/equalizer"} equalizer
                of two
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f, g \colon X \stackrel{\longrightarrow}{\longrightarrow} Y
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
                is the equalizer of the underlying functions of sets
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi eq
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msub
                        %mi S
                        %mi X
                      %mover
                        %munder
                          %mo ⟶
                          %mi g
                        %mover
                          %mo ⟶
                          %mi f
                      %msub
                        %mi S
                        %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      eq(f,g)
                      \\hookrightarrow
                      S_X
                      \\stackrel{\overset{f}{\longrightarrow}}{\underset{g}{\longrightarrow}}
                      S_Y
              %p
                (hence the largets subset of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi X
                    %annotation{:encoding => "application/x-tex"} S_X
                on which both functions coincide) and equipped with the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
                = succeed "." do
                  %a.maruku-ref{:href => "#TopologicalSubspace"}
            #CoequalizerInTop.num_example
              %h6#example_19 Example
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
                of two
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f, g \colon X \stackrel{\longrightarrow}{\longrightarrow} Y
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
                is the coequalizer of the underlying functions of sets
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mi X
                      %mover
                        %munder
                          %mo ⟶
                          %mi g
                        %mover
                          %mo ⟶
                          %mi f
                      %msub
                        %mi S
                        %mi Y
                      %mo ⟶
                      %mi coeq
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      S_X
                      \\stackrel{\overset{f}{\longrightarrow}}{\underset{g}{\longrightarrow}}
                      S_Y
                      \\longrightarrow
                      coeq(f,g)
              %p
                (hence the
                %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
                by the
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                generated by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ∼
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f(x) \sim g(x)
                for all
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
                = succeed "." do
                  %a.maruku-ref{:href => "#QuotientTopology"}
            #PushoutInTop.num_example
              %h6#example_20 Example
              %p For
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mi g
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi f
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\overset{g}{\longrightarrow}&amp; Y
                      \\\
                      {}^{\mathllap{f}}\downarrow
                      \\\
                      X
                      }
              %p
                two
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                out of the same
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/domain"} domain
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                under this diagram is also called the
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mi g
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi f
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mo *
                                    %mi f
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                              %msub
                                %mo ⊔
                                %mi A
                              %mi Y
                              %mspace{:width => "thinmathspace"}
                              %mo .
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\overset{g}{\longrightarrow}&amp; Y
                      \\\
                      {}^{\mathllap{f}}\downarrow &amp;&amp; \downarrow^{\mathrlap{g_\ast f}}
                      \\\
                      X &amp;\longrightarrow&amp; X \sqcup_A Y
                      \\,.
                      }
                      \\,.
              %p
                (Here
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mo *
                      %mi f
                    %annotation{:encoding => "application/x-tex"} g_\ast f
                is also called the pushout of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                %em
                  %a.existingWikiWord{:href => "/nlab/show/base+change"} cobase change
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                along
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
              %p
                This is equivalently the
                %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
                of the two morphisms from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                to the
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                (example
                = succeed "):" do
                  %a.maruku-ref{:href => "#DisjointUnionOfTopologicalSpacesIsCoproduct"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mi X
                      %mo ⊔
                      %mi Y
                      %mo ⟶
                      %mi X
                      %msub
                        %mo ⊔
                        %mi A
                      %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      A
                      \\stackrel{\longrightarrow}{\longrightarrow}
                      X \sqcup Y
                      \\longrightarrow
                      X \sqcup_A Y
                      \\,.
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                is an inclusion, one also writes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %msub
                        %mo ∪
                        %mi f
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \cup_f Y
                and calls this the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attaching space
              %div{:style => "float:left;margin:0 10px 10px 0;"}
                %img{:src => "http://ncatlab.org/nlab/files/AttachingSpace.jpg", :width => "450"}/
              %p
                By example
                %a.maruku-ref{:href => "#CoequalizerInTop"}
                the
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attaching space
                is the
                %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %msub
                        %mo ⊔
                        %mi A
                      %mi Y
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ⊔
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %annotation{:encoding => "application/x-tex"}
                      X \sqcup_A Y \simeq (X\sqcup Y)/\sim
              %p
                of the
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                subject to the
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                which identifies a point in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with a point in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                if they have the same pre-image in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              %p
                (graphics from
                = succeed ")" do
                  %a{:href => "#AguilarGitlerPrieto02"} Aguilar-Gitler-Prieto 02
              %p
                Notice that the defining
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of this colimit means that completing the
                %a.existingWikiWord{:href => "/nlab/show/span"} span
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\longrightarrow&amp; Y
                      \\\
                      \\downarrow
                      \\\
                      X
                      }
              %p
                to a
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Z
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\longrightarrow&amp; Y
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      X &amp;\longrightarrow&amp; Z
                      }
              %p is equivalent to finding a morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %munder
                        %mo ⊔
                        %mi A
                      %mi Y
                      %mo ⟶
                      %mi Z
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      X \underset{A}{\sqcup} Y \longrightarrow Z
                      \\,.
            #QuotientSpaceAsPushout.num_example
              %h6#example_21 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A\hookrightarrow X
                a
                %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                inclusion, example
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalSubspace"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo ↪
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi po
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                              %mo{:stretchy => "false"} /
                              %mi A
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\hookrightarrow&amp; X
                      \\\
                      \\downarrow &amp;(po)&amp; \downarrow
                      \\\
                      \\ast &amp;\longrightarrow&amp; X/A
                      }
              %p
                is the
                %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
                or
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cofiber"} cofiber
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo{:stretchy => "false"} /
                        %mi A
                      %annotation{:encoding => "application/x-tex"} X/A
            #TopologicalnSphereIsPushoutOfBoundaryOfnBallInclusionAlongItself.num_example
              %h6#example_22 Example
              %p
                An important special case of example
                = succeed ":" do
                  %a.maruku-ref{:href => "#PushoutInTop"}
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                write
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi D
                            %mi n
                          %mo ≔
                          %mo{:stretchy => "false"} {
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} →
                          %mo ∈
                          %msup
                            %mi ℝ
                            %mi n
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:stretchy => "false"} |
                            %mo ≤
                            %mn 1
                          %mo{:stretchy => "false"} }
                          %mo ↪
                          %msup
                            %mi ℝ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} D^n \coloneqq \{ \vec x\in \mathbb{R}^n | \; {\vert \vec x \vert \leq 1}\} \hookrightarrow \mathbb{R}^n
                    for the standard topological
                    %a.existingWikiWord{:href => "/nlab/show/n-disk"} n-disk
                    (equipped with its
                    %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
                    as a subset of
                    = succeed ");" do
                      %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi S
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mo =
                          %mo ∂
                          %msup
                            %mi D
                            %mi n
                          %mo ≔
                          %mo{:stretchy => "false"} {
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} →
                          %mo ∈
                          %msup
                            %mi ℝ
                            %mi n
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mover
                              %mi x
                              %mo{:stretchy => "false"} →
                            %mo{:stretchy => "false"} |
                            %mo =
                            %mn 1
                          %mo{:stretchy => "false"} }
                          %mo ↪
                          %msup
                            %mi ℝ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} S^{n-1} = \partial D^n \coloneqq \{ \vec x\in \mathbb{R}^n | \; {\vert \vec x \vert = 1}\} \hookrightarrow \mathbb{R}^n
                    for its
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              %p
                Notice that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} S^{-1} = \emptyset
                and that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 0
                        %mo =
                        %mo *
                        %mo ⊔
                        %mo *
                      %annotation{:encoding => "application/x-tex"} S^0 = \ast \sqcup \ast
              %p Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi n
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ⟶
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"}
                      i_n \colon S^{n-1}\longrightarrow D^n
              %p
                be the canonical inclusion of the standard
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (n-1)-sphere
                as the
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                of the standard
                %a.existingWikiWord{:href => "/nlab/show/n-disk"} n-disk
                (both regarded as
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                with their
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
                as subspaces of the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              %div{:style => "float:left;margin:0 10px 10px 0;"}
                %img{:src => "http://ncatlab.org/nlab/files/GluingHemispheres.jpg", :width => "400"}/
              %p
                Then the colimit in
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                under the diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi i
                            %mi n
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi i
                            %mi n
                      %msup
                        %mi D
                        %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      D^n \overset{i_n}{\longleftarrow} S^{n-1} \overset{i_n}{\longrightarrow}
                      D^n
                      \\,,
              %p
                i.e. the
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi n
                    %annotation{:encoding => "application/x-tex"} i_n
                along itself, is the
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mi n
                      %annotation{:encoding => "application/x-tex"} S^n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi i
                                    %mi n
                            %mtd
                              %msup
                                %mi D
                                %mi n
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi i
                                      %mi n
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi po
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msup
                                %mi D
                                %mi n
                            %mtd
                              %mo ⟶
                            %mtd
                              %msup
                                %mi S
                                %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      S^{n-1} &amp;\overset{i_n}{\longrightarrow}&amp; D^n
                      \\\
                      {}^{\mathllap{i_n}}\downarrow &amp;(po)&amp; \downarrow
                      \\\
                      D^n &amp;\longrightarrow&amp; S^n
                      }
                      \\,.
              %p (graphics from Ueno-Shiga-Morita 95)
            %p
              Another kind of colimit that will play a role for certain technical constructions is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
            #PosetsWosetTosetsAndOrdinals.num_defn
              %h6#definition_28 Definition
              %p
                A
                %em
                  %a.existingWikiWord{:href => "/nlab/show/partial+order"} partial order
                is a
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                equipped with a
                %a.existingWikiWord{:href => "/nlab/show/relation"} relation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≤
                    %annotation{:encoding => "application/x-tex"} \leq
                such that for all elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ,
                      %mi b
                      %mo ,
                      %mi c
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} a,b,c \in S
              %p
                1) (
                %a.existingWikiWord{:href => "/nlab/show/reflexive+relation"}> reflexivity
                )
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ≤
                        %mi a
                      %annotation{:encoding => "application/x-tex"} a \leq a
              %p
                2) (
                %a.existingWikiWord{:href => "/nlab/show/transitive+relation"}> transitivity
                ) if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≤
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \leq b
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ≤
                      %mi c
                    %annotation{:encoding => "application/x-tex"} b \leq c
                then
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ≤
                        %mi c
                      %annotation{:encoding => "application/x-tex"} a \leq c
              %p
                3) (
                %a.existingWikiWord{:href => "/nlab/show/antisymmetric+relation"}> antisymmetry
                ) if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≤
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a\leq b
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} b
                      %mo ≤
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \b \leq a
                then
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo =
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a = b
              %p
                This we may and will equivalently think of as a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                with
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                the elements of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                and a unique morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo →
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a \to b
                precisely if
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ≤
                        %mi b
                      %annotation{:encoding => "application/x-tex"} a\leq b
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                between their corresponding categories.
              %p
                A
                %em
                  %a.existingWikiWord{:href => "/nlab/show/bottom+element"} bottom element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \bot
                in a partial order is one such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊥
                      %mo ≤
                      %mi a
                    %annotation{:encoding => "application/x-tex"} \bot \leq a
                for all a. A
                %em
                  %a.existingWikiWord{:href => "/nlab/show/top+element"} top element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊤
                    %annotation{:encoding => "application/x-tex"} \top
                is one for wich
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi a
                        %mo ≤
                        %mo ⊤
                      %annotation{:encoding => "application/x-tex"} a \leq \top
              %p
                A partial order is a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/total+order"} total order
                if in addition
              %p
                4) (
                %a.existingWikiWord{:href => "/nlab/show/total+relation"}> totality
                ) either
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ≤
                      %mi b
                    %annotation{:encoding => "application/x-tex"} a\leq b
                or
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ≤
                        %mi a
                      %annotation{:encoding => "application/x-tex"} b \leq a
              %p
                A total order is a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/well+order"} well order
                if in addition
              %p
                5) (
                %a.existingWikiWord{:href => "/nlab/show/well-founded+relation"}> well-foundedness
                ) every non-empty subset has a least element.
              %p
                An
                %em
                  %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
                is the
                %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
                of a well-order.
              %p
                The
                %em
                  %a.existingWikiWord{:href => "/nlab/show/successor"} successor
                of an ordinal is the class of the well-order with a
                %a.existingWikiWord{:href => "/nlab/show/top+element"} top element
                freely adjoined.
              %p
                A
                %em
                  %a.existingWikiWord{:href => "/nlab/show/limit+ordinal"} limit ordinal
                is one that is not a successor.
            #ExamplesOfOrdinals.num_example
              %h6#example_23 Example
              %p
                The finite ordinals are labeled by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ≤
                        %mn 1
                        %mo ≤
                        %mn 2
                        %mi ⋯
                        %mo ≤
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{0 \leq 1 \leq 2 \cdots \leq n-1\}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n+1)
                is the successor of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ω
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} (
                        %mi ℕ
                        %mo ,
                        %mo ≤
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \omega = [(\mathbb{N}, \leq)]
            #TransfiniteComposition.num_defn
              %h6#definition_29 Definition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ⊂
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I \subset Mor(\mathcal{C})
                be a
                %a.existingWikiWord{:href => "/nlab/show/class"} class
                of its morphisms.
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                an
                %a.existingWikiWord{:href => "/nlab/show/ordinal"} ordinal
                (regarded as a
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                = succeed "-indexed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                      %annotation{:encoding => "application/x-tex"} \alpha
                %em transfinite sequence
                of elements in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is a
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi α
                      %mo ⟶
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      X_\bullet
                      \\;\colon\;
                      \\alpha \longrightarrow \mathcal{C}
              %p such that
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mo •
                        %annotation{:encoding => "application/x-tex"} X_\bullet
                    takes all
                    %a.existingWikiWord{:href => "/nlab/show/successor"} successor
                    morphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi β
                          %mover
                            %mo →
                            %mo ≤
                          %mi β
                          %mo +
                          %mn 1
                        %annotation{:encoding => "application/x-tex"} \beta \stackrel{\leq}{\to} \beta + 1
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi α
                        %annotation{:encoding => "application/x-tex"} \alpha
                    to elements in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                        %annotation{:encoding => "application/x-tex"} I
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mrow
                              %mi β
                              %mo ,
                              %mi β
                              %mo +
                              %mn 1
                          %mo ∈
                          %mi I
                        %annotation{:encoding => "application/x-tex"}
                          X_{\beta,\beta + 1} \in I
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mo •
                        %annotation{:encoding => "application/x-tex"} X_\bullet
                    is
                    %em continuous
                    in that for every nonzero
                    %a.existingWikiWord{:href => "/nlab/show/limit+ordinal"} limit ordinal
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi β
                            %mo &lt;
                            %mi α
                          %annotation{:encoding => "application/x-tex"} \beta \lt \alpha
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mo •
                        %annotation{:encoding => "application/x-tex"} X_\bullet
                    restricted to the
                    %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full-subdiagram
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %mi γ
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %mi γ
                          %mo ≤
                          %mi β
                          %mo{:stretchy => "false"} }
                        %annotation{:encoding => "application/x-tex"} \{\gamma \;|\; \gamma \leq \beta\}
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimiting cocone
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mo •
                        %annotation{:encoding => "application/x-tex"} X_\bullet
                    restricted to
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mi γ
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} |
                            %mspace{:width => "thickmathspace"}
                            %mi γ
                            %mo &lt;
                            %mi β
                            %mo{:stretchy => "false"} }
                          %annotation{:encoding => "application/x-tex"} \{\gamma \;|\; \gamma \lt \beta\}
              %p
                The corresponding
                %strong transfinite composition
                is the induced morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                      %mo ⟶
                      %msub
                        %mi X
                        %mi α
                      %mo ≔
                      %munder
                        %mi lim
                        %mo ⟶
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"}
                      X_0 \longrightarrow X_\alpha \coloneqq \underset{\longrightarrow}{\lim}X_\bullet
              %p
                into the
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                of the diagram, schematically:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi X
