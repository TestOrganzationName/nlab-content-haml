            #UnderlyingSetOfInternalHomIsHomSet.num_example
              %h6#example_14 Example
              %p
                %em
                  (underlying set of
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  is
                  = succeed ")*" do
                    %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
                a
                %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
                (Def.
