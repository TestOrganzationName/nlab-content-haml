            #CoendFormulaForPresheavesOfSets.num_example
              %h6#example_8 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/coend"} coend
                  formula for left
                  %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
                  of ordinary
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
                to be
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                      %mo =
                    %annotation{:encoding => "application/x-tex"} \mathcal{V} =
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                = succeed "," do
                  %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
                %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopEnrichedCategory"}
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Categories"}
                = succeed "," do
                  %a.maruku-ref{:href => "#SetEnrichedCategoriesArePlainCategories"}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
                %a.existingWikiWord{:href => "/nlab/show/enriched+presheaves"} enriched presheaves
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#EnrichedPresheaf"}
                %a.existingWikiWord{:href => "/nlab/show/presheaves"} presheaves
                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#CategoryOfPresheaves"}
              %p
                Then for any plain
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Functors"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
