                                %mrow
                                  %mphantom
                                    %mi AA
                                  %mi γ
                                  %mphantom
                                    %mi AA
                            %mtd
                              %mi Ho
                              %mo{:stretchy => "false"} (
                              %mi CombModCat
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
