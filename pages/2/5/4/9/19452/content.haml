                are
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
                = succeed "," do
                  %a.maruku-ref{:href => "#SmallObjectArgument"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                factors as an
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} I_{Top}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalCCellComplex"}
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalCellComplex"}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
