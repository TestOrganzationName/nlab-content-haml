                          %mn 1
                      %mo →
                      %msub
                        %mi X
                        %mi β
                    %annotation{:encoding => "application/x-tex"} X_{\beta + 1} \to X_\beta
                as a strict left inverse to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi β
                        %mo →
                        %msub
