                      \\,.
            %p
              The following is a general fact about closure of morphisms defined by lifting properties which we prove in generality below as prop.
              = succeed "." do
                %a.maruku-ref{:href => "#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}
            #SerreFibrationHasRightLiftingAgainstJTopRelativeCellComplexes.num_prop
              %h6#proposition_31 Proposition
              %p
                A
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                %a.maruku-ref{:href => "#SerreFibration"}
                has the
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                against all
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                (see remark
                = succeed ")" do
                  %a.maruku-ref{:href => "#RetractsOfMorphisms"}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
                (def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
                = succeed ")." do
                  %a.maruku-ref{:href => "#TopologicalCellComplex"}
            %p
              The following statement is foreshadowing the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequences+of+homotopy+groups"} long exact sequences of homotopy groups
              (
              %a{:href => "#LongSequences"}> below
              ) induced by any
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              %a{:href => "HomotopyFiberSequences"} below
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#LongExactSequeceOfHomotopyGroups"}
            #SerreFibrationGivesExactSequenceOfHomotopyGroups.num_prop
              %h6#proposition_32 Proposition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow Y
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                = succeed "," do
                  %a.maruku-ref{:href => "#SerreFibration"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} y \colon \ast \to Y
                be any point and write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi y
                      %mover
                        %mo ↪
                        %mi ι
                      %mi X
                      %mover
                        %mo ⟶
                        %mi f
                      %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      F_y \overset{\iota}{\hookrightarrow} X \overset{f}{\longrightarrow} Y
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                inclusion over that point. Then for every choice
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
                of lift of the point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
                through
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mi y
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi ι
                            %mo *
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi f
                            %mo *
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\pi_{\bullet}(F_y, x)
                      \\overset{\iota_\ast}{\longrightarrow}
                      \\pi_\bullet(X, x)
                      \\overset{f_\ast}{\longrightarrow}
                      \\pi_\bullet(Y)
              %p
                is
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact
                %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_\ast
                is canonically identified with the
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ι
                          %mo *
                      %annotation{:encoding => "application/x-tex"} \iota_\ast
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ker
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi f
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi im
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ι
                        %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      ker(f_\ast) \simeq im(\iota_\ast)
                      \\,.
            .proof
              %h6#proof_49 Proof
              %p
                It is clear that the image of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \iota_\ast
                is in the kernel of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo *
                    %annotation{:encoding => "application/x-tex"} f_\ast
                (every sphere in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi y
                      %mo ↪
                      %mi X
                    %annotation{:encoding => "application/x-tex"} F_y\hookrightarrow X
                becomes constant on
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
              %p
                For the converse, let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi α
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [\alpha]\in \pi_{\bullet}(X,x)
                be represented by some
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo{:lspace => "verythinmathspace"} :
                        %msup
                          %mi S
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \alpha \colon S^{n-1} \to X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi α
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\alpha]
                is in the kernel of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                      %annotation{:encoding => "application/x-tex"} f_\ast
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                    %annotation{:encoding => "application/x-tex"} \alpha
                fits into a
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mover
                                %mo ⟶
                                %mi α
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                              %msup
                                %mi D
                                %mi n
                            %mtd
                              %mover
                                %mo ⟶
                                %mi κ
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      S^{n-1} &amp;\overset{\alpha}{\longrightarrow}&amp; X
                      \\\
                      \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                      \\\
                      D^n &amp;\overset{\kappa}{\longrightarrow}&amp; Y
                      }
                      \\,,
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
                is the contracting homotopy witnessing that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                        %mo{:stretchy => "false"} [
                        %mi α
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} f_\ast[\alpha] = 0
              %p
                Now since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                is a lift of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                      %annotation{:encoding => "application/x-tex"} y
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi κ
                      %mo ⇒
                      %msub
                        %mi const
                        %mi y
                    %annotation{:encoding => "application/x-tex"}
                      \\eta  \;\colon\; \kappa \Rightarrow const_y
              %p as follows:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mover
                                %mo ⟶
                                %mi α
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi ι
                                      %mi n
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mi D
                                %mi n
                            %mtd
                              %mover
                                %mo ⟶
                                %mi κ
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ,
                                    %msub
                                      %mi δ
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi id
                          %mtr
                            %mtd
                              %msup
                                %mi D
                                %mi n
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %msub
                                    %mi δ
                                    %mn 0
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %msup
                                %mi D
                                %mi n
                              %mo ×
                              %mi I
                            %mtd
                              %mover
                                %mo ⟶
                                %mi η
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mi y
                            %mtd
                            %mtd
                              %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; S^{n-1} &amp;\overset{\alpha}{\longrightarrow}&amp; X
                      \\\
                      \&amp;&amp; {}^{\mathllap{\iota_n}}\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                      \\\
                      \&amp;&amp; D^n &amp;\overset{\kappa}{\longrightarrow}&amp; Y
                      \\\
                      \&amp;&amp; \downarrow^{\mathrlap{(id,\delta_1)}} &amp;&amp; \downarrow^{\mathrlap{id}}
                      \\\
                      D^n &amp;\overset{(id,\delta_0)}{\longrightarrow}&amp; D^n \times I &amp;\overset{\eta}{\longrightarrow}&amp; Y
                      \\\
                      \\downarrow &amp;&amp; &amp;&amp;  \downarrow
                      \\\
                      \\ast &amp;&amp; \overset{y}{\longrightarrow} &amp;&amp; Y
                      }
              %p
                (for instance: regard
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D^n
                as embedded in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} 0 \in \mathbb{R}^n
                is identified with the basepoint on the boundary of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi n
                    %annotation{:encoding => "application/x-tex"} D^n
                and set
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} →
                        %mo ,
                        %mi t
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mi κ
                        %mo{:stretchy => "false"} (
                        %mi t
                        %mover
                          %mi v
                          %mo{:stretchy => "false"} →
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \eta(\vec v,t) \coloneqq \kappa(t \vec v)
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
                of the top two squares that have appeared this way is equivalent to the following commuting square
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                            %mtd
                              %mo ⟶
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mi α
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ,
                                    %msub
                                      %mi δ
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                              %mo ×
                              %mi I
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi ι
                                    %mi n
                                  %mo ,
                                  %mi id
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %msup
                                %mi D
                                %mi n
                              %mo ×
                              %mi I
                            %mtd
                              %mover
                                %mo ⟶
                                %mi η
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      S^{n-1} &amp;\longrightarrow&amp; &amp;\overset{\alpha}{\longrightarrow}&amp; X
                      \\\
                      {}^{\mathllap{(id,\delta_1)}}\downarrow
                      \&amp;&amp;
                      \&amp;&amp; \downarrow^{\mathrlap{f}}
                      \\\
                      S^{n-1} \times I
                      \&amp;\overset{(\iota_n, id)}{\longrightarrow}&amp;
                      D^n \times I
                      \&amp;\overset{\eta}{\longrightarrow}&amp;
                      Y
                      }
                      \\,.
              %p
                Because
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is a
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                and by lemma
                %a.maruku-ref{:href => "#CylinderOverCWComplexIsJTopRelativeCellComplex"}
                and prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#SerreFibrationHasRightLiftingAgainstJTopRelativeCellComplexes"}
                %a.existingWikiWord{:href => "/nlab/show/lift"} lift
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ˜
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi S
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ×
                      %mi I
                      %mo ⟶
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\tilde \eta \;\colon\; S^{n-1} \times I \longrightarrow X
                      \\,.
              %p
                Notice that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde \eta
                is a basepoint preserving
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo =
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ˜
                      %msub
                        %mo{:stretchy => "false"} |
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \alpha = \tilde \eta|_1
                to some
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi α
                        %mo ′
                        %mo ≔
                        %mover
                          %mi η
                          %mo{:stretchy => "false"} ˜
                        %msub
                          %mo{:stretchy => "false"} |
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \alpha' \coloneqq \tilde \eta|_0
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_{n-1}(X,x)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi α
                      %mo ′
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mi α
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [\alpha'] = [\alpha]
                      \\,.
              %p
                But the new representative
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \alpha'
                has the special property that its image in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is not just trivializable, but trivialized: combining
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi η
                        %mo{:stretchy => "false"} ˜
