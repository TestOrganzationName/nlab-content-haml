                          %mo →
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} }
                            %mi i
                        %annotation{:encoding => "application/x-tex"} \{U_i \to X\}_i
                    in the given
                    %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                    on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    the induced
                    %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
