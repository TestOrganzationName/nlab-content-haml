                is an
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Isomorphism"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is called a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            #DeloopingGroupoid.num_example
              %h6#example_5 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Groupoid"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                with a single
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                the
                %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
                and
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                the group operation in
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Obj
                            %mrow
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                          %mo =
                          %mo *
                        %annotation{:encoding => "application/x-tex"} Obj_{\mathbf{B}G} = \ast
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mo *
                          %mo ,
                          %mo *
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %mi G
                        %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(\ast,\ast) \;=\; G
              %p
                In fact every
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                with precisely one object is of the form.
            .num_remark
              %h6#remark Remark
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              %p
                Even though
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Groupoid"}
                %a.existingWikiWord{:href => "/nlab/show/categories"} categories
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Categories"}
                = succeed "-theorem" do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
                for the special case of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+1-types"} homotopy 1-types
              %p
                (In applications in
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
                %a.existingWikiWord{:href => "/nlab/show/class"} class
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Obj
                        %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} Obj_{\mathcal{C}}
                of
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                is in fact a
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/small+groupoids"} small groupoids
                = succeed ")." do
                  %a.maruku-ref{:href => "#SmallCategory"}
              %p
                For this reason we will not have more to say about
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                here, and instead relegate their discussion to the section on homotopy theory, further
                = succeed "." do
                  %a{:href => "#BasicNotionsOfHomotopyTheory"} below
            %p There is a range of constructions that provide new categories from given ones:
            #OppositeCategory.num_example
              %h6#example_6 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formal duality
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                %em
                  %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
                has the same
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                as
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                is reversed. Accordingly,
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                in the
                %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
                is that in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi Obj
                            %mrow
                              %msup
                                %mi 𝒞
                                %mi op
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi Obj
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} Obj_{\mathcal{C}^{op}} \;\coloneqq\; Obj_{\mathcal{C}}
                    ;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mrow
                              %msup
                                %mi 𝒞
                                %mi op
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo ≔
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}^{op}}(X,Y) \;\coloneqq\; Hom_{\mathcal{C}}(Y,X)
                    \.
              %p
                Hence for every statementa about some
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                there is a corresponding “dual” statement about its opposite category, which is “the same but with the direction of all morphisms reversed”. This relation is known as
                %em
                  %a.existingWikiWord{:href => "/nlab/show/formal+duality"}> formal duality
                  \.
