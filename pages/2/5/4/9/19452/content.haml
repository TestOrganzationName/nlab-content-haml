                        %annotation{:encoding => "application/x-tex"} Z \in \mathcal{Z}
                    the
                    %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
                    (Example
                    = succeed ")" do
                      %a.maruku-ref{:href => "#HomFunctor"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Z
                        %annotation{:encoding => "application/x-tex"} Z
                    takes
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                    to an
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo ,
                          %mi Z
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %mi Z
                          %mo{:stretchy => "false"} )
                          %mover
                            %mo ↪
                            %mphantom
                              %mi AAA
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi Z
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          Hom_{\mathcal{C}}( f,Z )
                          \\;\colon\;
