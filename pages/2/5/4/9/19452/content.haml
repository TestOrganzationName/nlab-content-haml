                        %annotation{:encoding => "application/x-tex"} (\mathbb{L}L \dashv \mathbb{R}R)
                    is a
                    = succeed "-inclusion" do
                      %a.existingWikiWord{:href => "/nlab/show/co-reflective+subcategory"} co-reflective subcategory
                    = succeed ");" do
                      %a.maruku-ref{:href => "#ReflectiveSubcategory"}
            .proof
              %h6#proof_20 Proof
              %p
                By Prop.
                %a.maruku-ref{:href => "#QuillenAdjunctionInducesAdjunctionOnHomotopyCategories"}
                the components of the
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} counit
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝕃
                      %mi L
                      %mo ⊣
                      %mi ℝ
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{L}L \dashv \mathbb{R}R)
                are precisely the images under
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                of the
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} counit
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
