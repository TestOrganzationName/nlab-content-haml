                      %mo ⊗
                      %mi C
                      %mover
                        %mo ⟶
                        %mrow
                          %mi e
                          %mo ⊗
                          %mi id
                      %mi A
                      %mo ⊗
                      %mi C
                      %mover
                        %mo ⟶
                        %mi f
                      %mi N
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\tilde f
                      \\;\colon\;
                      C
                      \\underoverset{\simeq}{\ell_C}{\longrightarrow}
                      1 \otimes C
                      \\overset{e\otimes id}{\longrightarrow}
                      A \otimes C
                      \\overset{f}{\longrightarrow}
                      N
                      \\,,
              %p
                i.e. the restriction of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                to the unit “in”
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
                of the form (where we are now notationally suppressing the
                %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                and the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi C
                            %mtd
