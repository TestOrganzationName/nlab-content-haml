                      \\overset{\phantom{AA} p \phantom{AA}}{\longrightarrow}
                      (\mathcal{C}')^{op}
              %p
                the general formula
                %a.maruku-eqref{:href => "#eq:FormulaLeftKanExtensionByCoend"} (64)
                for
                %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
