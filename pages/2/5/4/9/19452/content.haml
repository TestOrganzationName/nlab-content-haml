                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi po
                              %mo{:stretchy => "false"} )
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                                    %mo ∩
                                    %mi Cof
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                                    %mo ∩
                                    %mi Cof
                          %mtr
                            %mtd
                              %mi id
                              %mo{:lspace => "verythinmathspace"} :
                            %mtd
                              %mi A
                              %mo ′
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                            %mtd
                              %mi X
                              %mo ′
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %mphantom
                                    %mi AA
                            %mtd
                              %mi A
                              %mo ′
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                            %mtd
                            %mtd
