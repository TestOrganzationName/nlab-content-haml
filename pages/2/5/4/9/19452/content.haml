                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#InitialAndFinalAdjointModality"}
            .proof
              %h6#proof_9 Proof
              %p
                By Prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#ProgressionOfModalitiesOnElasticTopos"}
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} X \in \mathbf{H}
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℑ
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \Im X
                    is an
                    = succeed "-" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Rh
                          %annotation{:encoding => "application/x-tex"} Rh
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/modal+object"} modal object
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Rh
                            %mi ℑ
                            %mi X
                            %mo ≃
                            %mi X
                          %annotation{:encoding => "application/x-tex"} Rh \Im X \simeq X
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℜ
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \Re X
                    is a
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/bosonic+object"} bosonic object
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mrow
                                %mi ℜ
                                %mi X
                              %mo ⇝
                            %mo ≃
                            %mi ℜ
                            %mi X
                          %annotation{:encoding => "application/x-tex"} \overset{\rightsquigarrow}{\Re X} \simeq \Re X
              %p
                The proof is directly analogous to that of Prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#ProgressionOfModalitiesOnElasticTopos"}
                = succeed ":" do
                  %a.maruku-ref{:href => "#ProgressionOfSubcategoriesOfSolidTopos"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi Rh
                              %mi ℑ
                            %mtd
                              %mo =
                              %msub
                                %mi Disc
                                %mi sup
                              %munder
                                %munder
                                  %mrow
                                    %msub
                                      %mi Π
                                      %mi sup
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                                    %msub
                                      %mi Disc
                                      %mi sup
                                  %mo ⏟
                                %mrow
                                  %mo ≃
                                  %mi id
                              %msub
                                %mi Disc
                                %mi inf
                              %msub
                                %mi Π
                                %mi inf
                              %msub
                                %mi Π
                                %mi sup
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %msub
                                %mi Disc
                                %mi sup
                              %msub
                                %mi Disc
                                %mi inf
                              %msub
                                %mi Π
                                %mi inf
                              %msub
                                %mi Π
                                %mi sup
                          %mtr
                            %mtd
                            %mtd
                              %mo =
                              %mi ℑ
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      Rh \Im
                      \&amp; =
                      Disc_{sup}
                      \\underset{
                      \\simeq id
                      }{
                      \\underbrace{
                      \\Pi_{sup} \;\; Disc_{sup}
                      }
                      }
                      Disc_{inf} \Pi_{inf} \Pi_{sup}
                      \\\
                      \&amp; \simeq
                      Disc_{sup} Disc_{inf} \Pi_{inf} \Pi_{sup}
                      \\\
                      \&amp; = \Im
                      \\end{aligned}
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mo ⇝
                              %mi ℜ
                            %mtd
                              %mo =
                              %msub
                                %mi ι
                                %mi sup
                              %munder
                                %munder
                                  %mrow
                                    %msub
                                      %mi Π
                                      %mi sup
                                    %mspace{:width => "thickmathspace"}
                                    %mspace{:width => "thickmathspace"}
                                    %msub
                                      %mi ι
                                      %mi sup
                                  %mo ⏟
                                %mrow
                                  %mo ≃
                                  %mi id
                              %msub
                                %mi ι
                                %mi inf
                              %msub
                                %mi Π
                                %mi inf
                              %msub
                                %mi Π
                                %mi sub
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %msub
                                %mi ι
                                %mi sup
                              %msub
                                %mi ι
                                %mi inf
                              %msub
                                %mi Π
                                %mi inf
                              %msub
                                %mi Π
                                %mi sub
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %mi ℜ
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      \\rightsquigarrow \Re
                      \&amp; =
                      \\iota_{sup}
                      \\underset{\simeq id}{\underbrace{
                      \\Pi_{sup} \;\; \iota_{sup}}}
                      \\iota_{inf} \Pi_{inf}\Pi_{sub}
                      \\\
