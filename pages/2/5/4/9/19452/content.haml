            #ConditionsForQuillenAdjunctionAreIndeedEquivalent.num_prop
              %h6#poposition Poposition
              %p
                The conditions in def.
                %a.maruku-ref{:href => "#QuillenEquivalence"}
                are indeed all equivalent.
            %p
              (
              %a{:href => "model+category#Quillen67"}> Quillen 67, I.4, theorem 3
              )
            .proof
              %h6#proof_21 Proof
              %p
                That
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⇔
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 1) \Leftrightarrow 2)
                follows from prop.
                %a.maruku-ref{:href => "#QuillenAdjunctionInducesAdjunctionOnHomotopyCategories"}
                (if in an adjoint pair one is an equivalence, then so is the other).
              %p
                To see the equivalence
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ⇔
                        %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 1),2) \Leftrightarrow 3)
                = succeed ")" do
                  %a{:href => "adjoint+functor#FullyFaithfulAndInvertibleAdjoints"} prop.
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                is an
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                precisely if both the
                %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
                and the
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
                are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural isomorphisms
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DerivedAdjunctionUnit"}
                %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction (co-)unit
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝕃
                      %mi L
                      %mo ⊣
                      %mi ℝ
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{L}L \dashv \mathbb{R}R)
                in the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
                = succeed "." do
                  %a.maruku-ref{:href => "#QuillenAdjunctionInducesAdjunctionOnHomotopyCategories"}
              %p
                To see that
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 4
                        %mo{:stretchy => "false"} )
                        %mo ⇒
                        %mn 3
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 4) \Rightarrow 3)
              %p
                Consider the weak equivalence
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi j
                              %mrow
                                %mi L
                                %mi X
                        %mi P
                        %mi L
                        %mi X
                      %annotation{:encoding => "application/x-tex"} L X \overset{j_{L X}}{\longrightarrow} P L X
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo ⊣
                        %mi R
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (L \dashv R)
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo ⟶
                        %mi η
                      %mi R
                      %mi L
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mi R
                          %msub
                            %mi j
                            %mrow
                              %mi L
                              %mi X
                      %mi R
                      %mi P
                      %mi L
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      X
                      \\overset{\eta}{\longrightarrow}
                      R L X
                      \\overset{R j_{L X}}{\longrightarrow}
                      R P L X
              %p
                by assumption 4) this is again a weak equivalence, which is the requirement for the
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
                in 3). Dually for
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
              %p
                To see
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mo ⇒
                        %mn 4
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} 3) \Rightarrow 4)
              %p
                Consider any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi L
                      %mi d
                      %mo →
                      %mi c
