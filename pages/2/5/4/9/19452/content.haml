                                    %mn 1
                                %mtd
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mrow
                                      %mphantom
                                        %mi AA
                                      %mi g
                                      %mphantom
                                        %mi AA
                                %mtd
                                %mtd
                                  %msub
                                    %mi X
                                    %mn 2
                              %mtr
