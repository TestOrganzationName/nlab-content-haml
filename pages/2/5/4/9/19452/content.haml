                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msup
                                %mi D
                                %mi n
                            %mtd
                              %mo ⟶
                            %mtd
                              %msup
                                %mi S
                                %mi n
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mo =
                          %mtr
                            %mtd
                              %msup
                                %mi S
                                %mi n
                            %mtd
                              %mover
                                %mo ⟶
                                %mi id
                            %mtd
                              %msup
                                %mi S
                                %mi n
                          %mtr
                            %mtd
