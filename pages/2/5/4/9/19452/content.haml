                            %msup
                              %mi 𝒞
                              %mi op
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Pi(\mathbf{Y})
                      \\;=\;
                      \\underset{\underset{\mathcal{C}^{op}}{\longrightarrow}}{\lim} \mathbf{Y}
                      \\,.
              %p
                The fact that this indeed preserves products follows from the assumption that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                has
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                %a.existingWikiWord{:href => "/nlab/show/categories+with+finite+products+are+cosifted"} categories with finite products are cosifted
                (Prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoriesWithFiniteProductsAreCosifted"}
            %p
              Example
              %a.maruku-ref{:href => "#PresheavesAdjointQuadrupleOnSiteWithTerminalObject"}
              suggests to ask for
              %a.existingWikiWord{:href => "/nlab/show/coverages"} coverages
              on categories with
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              which are such that the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              %a.maruku-eqref{:href => "#eq:PreaheafAdjointQuadruple"} (107)
              on the
              %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
              (
              %a.existingWikiWord{:href => "/nlab/show/corestriction"}> co-
              )
              %a.existingWikiWord{:href => "/nlab/show/restriction"} restricts
              to the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              %a.maruku-ref{:href => "#OneCohesiveSite"}
              states a sufficient condition for this to be the case:
            #OneCohesiveSite.num_defn
              %h6#definition_2 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+site"}> cohesive site
                  )
              %p
                We call a
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/cohesive+site"} cohesive
                if the following conditions are satisfied:
              %ol
                %li
                  %p
                    The
                    %a.existingWikiWord{:href => "/nlab/show/category"} category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
