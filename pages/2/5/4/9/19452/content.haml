                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mi F
                            %mn 0
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          F_{a,b} \;\colon\; \mathcal{C}(a,b) \longrightarrow \mathcal{D}(F_0(a), F_0(b))
                  %p
                    of
                    = succeed "," do
