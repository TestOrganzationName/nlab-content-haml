                with coreflector
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                is
                %a.existingWikiWord{:href => "/nlab/show/idempotent+monad"} idemotent
                in that there are
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphisms"} natural
                %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
