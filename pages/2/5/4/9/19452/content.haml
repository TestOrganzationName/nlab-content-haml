                    %a.maruku-ref{:href => "#PropertiesOfSheafToposes"}
                    below.
                  %p In particular:
                  %ol
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                        (Def.
                        = succeed ")" do
                          %a.maruku-ref{:href => "#CategoryOfSets"}
                        = succeed "-structure" do
                          %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
                        = succeed ")" do
                          %a.maruku-ref{:href => "#SetIsCartesianClosed"}
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo ≃
                              %mo{:stretchy => "false"} [
                              %msup
                                %mi Δ
                                %mi op
                              %mo ,
                              %mi Set
                              %mo{:stretchy => "false"} ]
                            %annotation{:encoding => "application/x-tex"} \simeq [\Delta^{op}, Set]
                        (Def.
                        = succeed "," do
                          %a.maruku-ref{:href => "#sSet"}
                        = succeed ")" do
                          %a.maruku-ref{:href => "#SimplicialSetsAsPresheavesOnTheSimplexCategory"}
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#CategoriesOfSmallCategories"}
                    = succeed "-structure" do
                      %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
                    = succeed ")." do
                      %a.maruku-ref{:href => "#GrpdIsACartesianClosedCategory"}
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#CategoriesOfSmallCategories"}
                    = succeed "-structure" do
                      %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
                    = succeed ")." do
                      %a.maruku-ref{:href => "#GrpdIsACartesianClosedCategory"}
            #ChangeOfCosmosFromVToSet.num_example
              %h6#example_13 Example
              %p
                %strong
                  underlying
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                  of an object in a
                  %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
                be a
                %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Cosmos"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo ∈
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} 1 \in \mathcal{V}
                its
                %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#MonoidalCategory"}
                %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#HomFunctor"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒱
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒱
                      %mo ⟶
                      %mi Set
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{V}}(1,-)
                      \\;\colon\;
                      \\mathcal{V}
                      \\longrightarrow
                      Set
              %p
                admits the
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                of a
                %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functor"} lax monoidal functor
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LaxMonoidalFunctor"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal
                %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                from Example
                = succeed "." do
                  %a.maruku-ref{:href => "#SetIsCartesianClosed"}
              %p
                Given
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                        %mo ∈
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} V \in \mathcal{V}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒱
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi Set
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{V}}(1,V) \;\in\; Set
              %p
                also the
                %em underlying
                set of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
            .proof
              %h6#proof_9 Proof
              %p Take the monoidal transformations (eq“MonoidalComponentsOfMonoidalFunctor) to be
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒱
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %msub
                                %mi V
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo ×
                              %msub
                                %mi Hom
                                %mi 𝒱
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %msub
                                %mi V
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo ⟶
                              %msub
                                %mi Hom
                                %mi 𝒱
                              %mo{:stretchy => "false"} (
                              %mn 1
                              %mo ,
                              %msub
                                %mi V
                                %mn 1
                              %mo ⊗
                              %msub
                                %mi V
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mn 1
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 1
                              %msub
                                %mi V
                                %mn 1
                              %mspace{:width => "thickmathspace"}
                              %mo ,
                              %mspace{:width => "thickmathspace"}
                              %mn 1
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 2
                              %msub
                                %mi V
                                %mn 2
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mtd
                              %mo ↦
                            %mtd
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mn 1
                              %mover
                                %mo →
                                %mo ≃
                              %mn 1
                              %mo ⊗
                              %mn 1
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi f
                                    %mn 1
                                  %mo ⊗
                                  %msub
                                    %mi f
                                    %mn 2
                              %msub
                                %mi V
                                %mn 1
                              %mo ⊗
                              %msub
                                %mi V
                                %mn 2
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      Hom_{\mathcal{V}}(1, V_1)
                      \\times
                      Hom_{\mathcal{V}}(1, V_2)
                      \\longrightarrow
                      Hom_{\mathcal{V}}(1, V_1 \otimes V_2)
                      \\\
                      \\big( 1 \overset{f_1}{\to} V_1\;,\; 1 \overset{f_2}{\to} V_2 \big)
                      \&amp;\mapsto&amp;
