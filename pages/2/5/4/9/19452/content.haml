                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\int_{x \in X} \delta(x,x_0) f(x)
                      \=
                      f(x_0)
                      \\,.
            %p It is this analogy that gives the name to the following statement:
            #CoendsCommuteWithEachOther.num_prop
              %h6#proposition_8 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Fubini+theorem"} Fubini theorem
                  for (co)-ends)
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
                a
                %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Cosmos"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 1
                      %mo ,
                      %msub
                        %mi 𝒞
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_1, \mathcal{C}_2
                be two
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
                %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopEnrichedCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mrow
                          %mo (
                          %msub
                            %mi 𝒞
                            %mn 1
                          %mo ×
                          %msub
                            %mi 𝒞
                            %mn 2
                          %mo )
                        %mi op
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mn 1
                      %mo ×
                      %msub
                        %mi 𝒞
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"}
                      F
                      \\;\colon\;
                      \\left(
                      \\mathcal{C}_1\times\mathcal{C}_2
                      \\right)^{op}
