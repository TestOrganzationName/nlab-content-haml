                        %mrow
                          %mphantom
                            %mrow
                              %msub
                                %mrow
                                %mi Qu
                          %msub
                            %mo ≃
                            %mi Qu
                        %munder
                          %mo ⟶
                          %mphantom
                            %mi AAAA
                        %mover
                          %mo ⟵
                          %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{S}^{op}, sSet_{Qu}]_{proj,S}
                      \\underoverset
                      {\underset{\phantom{AAAA}}{\longrightarrow}}
                      {\overset{}{\longleftarrow}}
                      {\phantom{{}_{Qu}}\simeq_{Qu}}
                      \\mathcal{C}
              %p
                between
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and the
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#BousfieldLocalizationOfModelCategories"}
                %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+simplicial+presheaves"} projective model structure on simplicial presheaves
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
            #HoCombModCat.num_defn
              %h6#definition_4 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-categories"} presentable (∞,1)-categories
              %p
                Write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CombModCat
                    %annotation{:encoding => "application/x-tex"} CombModCat
                for the
                %a.existingWikiWord{:href => "/nlab/show/very+large+category"} very large category
                whose
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CombinatorialModelCategory"}
                %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functors"} left Quillen functors
                between them (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#QuillenAdjunction"}
              %p We write
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ho%28CombModCat%29"} Ho(CombModCat)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ≔
                      %mi CombModCat
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                      %msup
                        %mi QuillenEquivs
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %annotation{:encoding => "application/x-tex"} \coloneqq CombModCat\big[ QuillenEquivs^{-1}\big]
              %p
                for its
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocalizationOfACategory"}
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#QuillenEquivalence"}
              %p We say:
              %ul
                %li
                  %p
                    an
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    in
                    %a.existingWikiWord{:href => "/nlab/show/Ho%28CombModCat%29"} Ho(CombModCat)
                    is a
                    = succeed "," do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-category"} locally presentable (∞,1)-category
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                    in
                    %a.existingWikiWord{:href => "/nlab/show/Ho%28CombModCat%29"} Ho(CombModCat)
                    is the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
                      of an
                    = succeed "-" do
                      %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-colimit"} (∞,1)-colimit
                    %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserving
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
                    %em ;
                %li
                  %p
                    an
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                    in
