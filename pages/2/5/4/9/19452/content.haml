                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{X}
                any object,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
