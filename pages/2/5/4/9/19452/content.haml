                    %annotation{:encoding => "application/x-tex"}
                      (\underset{\longrightarrow}{\lim}_i F^\circ _i)(c) \simeq \underset{\longrightarrow}{\lim}_i (F^\circ_i(c)) \;\; \in Set
              %p
                by the
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of limits and colimits. (Given a morphism of diagrams then a unique compatible morphism between their limits or colimits, respectively, is induced as the universal factorization of the morphism of diagrams regarded as a cone or cocone, respectvely, over the codomain or domain diagram, respectively).
              %p
                Hence it only remains to see that equipped with topology, these limits and colimits in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
                become limits and colimits in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi cg
                      %annotation{:encoding => "application/x-tex"} Top_{cg}
                %a.maruku-ref{:href => "#DescriptionOfLimitsAndColimitsInTop"}
                with corollary
                = succeed "." do
                  %a.maruku-ref{:href => "#kTopIsCoreflectiveSubcategory"}
            #TensoringAndPoweringOfTopologicallyEnrichedCopresheaves.num_defn
              %h6#definition_60 Definition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
