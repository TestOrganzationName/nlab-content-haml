                          %mi 𝒞
                          %mo ⟶
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"}
                          \\otimes
                          \\;\colon\;
                          \\mathcal{C} \times \mathcal{C}
                          \\longrightarrow
                          \\mathcal{C}
                  %p
                    out of the
                    %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    with itself (Example
                    = succeed ")," do
                      %a.maruku-ref{:href => "#ProductCategory"}
                    = succeed "," do
                      %strong
                        %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                %li
                  %p
                    an
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn 1
                          %mo ∈
                          %msub
