                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ,
                                    %msub
                                      %mi δ
                                      %mn 0
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ↓
