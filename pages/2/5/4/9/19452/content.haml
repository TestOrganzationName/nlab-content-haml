                      %annotation{:encoding => "application/x-tex"} I_{Top}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
            .proof
              %h6#proof_47 Proof
              %p
                There is a
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
