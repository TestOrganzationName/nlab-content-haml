                            %mn 1
                          %mi Q
                          %mi P
                          %mover
                            %mo ⟶
                            %mi ϕ
                          %msub
                            %mi R
                            %mn 2
                          %msub
                            %mi L
                            %mn 1
                          %mi Q
                          %mi P
                          %mo ⟶
                          %msub
                            %mi R
                            %mn 2
                          %mi P
                          %mi L
                          %mn 1
                          %mi Q
                          %mi P
                          %mo ⟵
                          %msub
                            %mi R
                            %mn 2
                          %mi R
                          %msub
                            %mi L
                            %mn 1
                          %mi Q
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          Ho(\phi)
                          \\;\colon\;
                          L_2 Q R_1 P
                          \\overset{}{\longleftarrow}
                          L_2 Q R_1 Q P
                          \\longrightarrow
                          L_2 R_1 Q P
                          \\overset{\phi}{\longrightarrow}
                          R_2 L_1 Q P
                          \\longrightarrow
                          R_2 P L1 Q P
                          \\longleftarrow
                          R_2 R L_1 Q
                          \\,,
                  %p
                    where the unlabeled morphisms are induced by
                    %a.existingWikiWord{:href => "/nlab/show/fibrant+resolution"} fibrant resolution
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                          %mo →
                          %mi P
                          %mi c
                        %annotation{:encoding => "application/x-tex"} c \to P c
                    and
                    %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Q
                            %mi c
                            %mo →
                            %mi c
                          %annotation{:encoding => "application/x-tex"} Q c \to c
                    = succeed ")." do
                      %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
            %p
              (
              %a{:href => "double+category+of+model+categories#Shulman07"}> Shulman 07, Theorem 7.6
              )
            #DerivedNaturalTransformationUpToIsos.num_lemma
              %h6#lemma_10 Lemma
              %p
                %strong (recognizing derived natural isomorphisms)
              %p
                For the
                %a.existingWikiWord{:href => "/nlab/show/derived+natural+transformation"} derived natural transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\phi)
                in
                %a.maruku-eqref{:href => "#eq:DerivedNaturalTransformation"} (94)
                to be invertible in the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                which is both
                %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant
                and
                %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
                the following composite
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi R
                        %mn 2
                      %mi Q
                      %msub
                        %mi L
                        %mn 1
                      %mi c
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi R
                            %mn 2
                          %msub
                            %mi p
                            %mrow
                              %msub
                                %mi L
                                %mn 1
                              %mi c
                      %msub
                        %mi R
                        %mn 2
                      %msub
                        %mi L
                        %mn 1
                      %mi c
                      %mover
                        %mo ⟶
                        %mi ϕ
                      %msub
                        %mi L
                        %mn 2
                      %msub
                        %mi R
                        %mn 1
                      %mi c
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi L
                            %mn 2
                          %msub
                            %mi j
                            %mrow
                              %msub
                                %mi R
                                %mn 1
                              %mi c
                      %msub
                        %mi L
                        %mn 2
                      %mi P
                      %msub
                        %mi R
                        %mn 1
                      %mi c
                    %annotation{:encoding => "application/x-tex"}
                      R_2 Q L_1 c
                      \\overset{ R_2 p_{L_1 c} }{\longrightarrow}
                      R_2 L_1 c
                      \\overset{\phi}{\longrightarrow}
                      L_2 R_1 c
                      \\overset{ L_2 j_{R_1 c} }{\longrightarrow}
                      L_2 P R_1 c
              %p
                (of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                with images of
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+resolution"} fibrant resolution
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolution"} cofibrant resolution
                = succeed ")" do
                  %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                (by Prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#MorphismIsWeakEquivalenceIfIsoInHomotopyCategoryForQuillen"}
            %p
              (
              %a{:href => "double+category+of+model+categories#Shulman07"}> Shulman 07, Remark 7.2
              )
            #DerivedFunctorOfLeftRightQuillenFunctor.num_example
              %h6#example_2 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                  of left-right
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Quillen+functor"} Quillen functor
              %p
                Let
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                be
                %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#ModelCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi A
                          %mi F
                          %mphantom
                            %mi A
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C} \overset{\phantom{A}F\phantom{A}}{\longrightarrow} \mathcal{C}
              %p
                be a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                that is both a
                %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
                as well as a
                %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#QuillenAdjunction"}
                %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
                in the
                %a.existingWikiWord{:href => "/nlab/show/double+category+of+model+categories"} double category of model categories
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DoubleCategoryOfModelCategories"}
              #eq:DoubleMorphismExhibitingLeftRightQuillenFunctor.maruku-equation
                %span.maruku-eq-number (95)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi 𝒞
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %mi F
                                  %mphantom
                                    %mi AA
                            %mtd
                              %mi 𝒟
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi F
                              %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mtd
                              %msup
                                %mrow
                                %mi id
                              %mo ⇙
                            %mtd
                              %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                              %msup
                                %mrow
                                %mpadded{:width => "0"}
                                  %mi id
                          %mtr
                            %mtd
                              %mi 𝒟
                            %mtd
                              %munder
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi A
                                  %mi id
                                  %mphantom
                                    %mi A
                            %mtd
                              %mi 𝒟
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathcal{C}
                      \&amp;\overset{\phantom{AA}F\phantom{AA}}{\longrightarrow}&amp;
                      \\mathcal{D}
                      \\\
                      {}^{\mathllap{F}}\Big\downarrow
                      \&amp;{}^{id}\swArrow&amp;
                      \\Big\downarrow{}^{\mathrlap{id}}
                      \\\
                      \\mathcal{D}
                      \&amp;\underset{\phantom{A}id\phantom{A}}{\longrightarrow}&amp;
                      \\mathcal{D}
                      }
              %p
                It follows that the
                %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕃
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \mathbb{L}F
                and
                %a.existingWikiWord{:href => "/nlab/show/right+derived+functor"} right derived functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}F
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %mi 𝕃
                          %mi F
                          %mo ≃
                          %mi ℝ
                          %mi F
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒟
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Ho(\mathcal{C})
                      \\overset{ \mathbb{L}F \simeq \mathbb{R}F }{\longrightarrow}
                      Ho(\mathcal{D})
                      \\,.
            %p
              (
              %a{:href => "double+category+of+model+categories#Shulman07"}> Shulman 07, corollary 7.8
              )
            .proof
              %h6#proof_19 Proof
              %p
                To see the
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝕃
                        %mi F
                        %mo ≃
                        %mi ℝ
                        %mi F
                      %annotation{:encoding => "application/x-tex"} \mathbb{L}F \simeq \mathbb{R}F
                %a.maruku-ref{:href => "#HomotopyDoublePseudofunctor"}
                this is implied once the
                %a.existingWikiWord{:href => "/nlab/show/derived+natural+transformation"} derived natural transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi id
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(id)
                of
                %a.maruku-eqref{:href => "#eq:DoubleMorphismExhibitingLeftRightQuillenFunctor"} (95)
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                %a.maruku-ref{:href => "#DerivedNaturalTransformationUpToIsos"}
                this is the case, in the present situation, if the composition of
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mi F
                      %mi c
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi p
                            %mrow
                              %mi F
                              %mi c
                      %mi F
                      %mi c
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi j
                            %mrow
                              %mi F
                              %mi c
                      %mi P
                      %mi F
                      %mi c
                    %annotation{:encoding => "application/x-tex"}
                      Q F c
                      \\overset{ p_{F c} }{\longrightarrow}
                      F c
                      \\overset{  j_{F c} }{\longrightarrow}
                      P F c
              %p
                is a weak equivalence. But this is immediate, since the two factors are weak equivalences, by definition of
                %a.existingWikiWord{:href => "/nlab/show/fibrant+resolution"} fibrant/cofibrant resolution
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
            %p
              The following is the analog of
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} co-
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategories"} reflective subcategories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ReflectiveSubcategory"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            #QuillenReflection.num_defn
              %h6#definition_19 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+reflection"}> Quillen reflection
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                be
                %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#ModelCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %munderover
                        %mrow
                          %msub
                            %mo ⊥
                            %mi Qu
                        %munder
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %mi R
                            %mphantom
                              %mi AA
                        %mover
                          %mo ⟵
                          %mi L
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}
                      \\underoverset
                      {\underset{\phantom{AA}R\phantom{AA}}{\longrightarrow}}
                      {\overset{L}{\longleftarrow}}
                      {\bot_{Qu}}
                      \\mathcal{D}
              %p
                be a
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                between them (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#QuillenAdjunction"}
              %ol
                %li
                  %p
                    a
                    %em Quillen reflection
                    if the
                    %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#DerivedAdjunctionUnit"}
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                %li
                  %p
                    a
                    %em Quillen co-reflection
                    if the
                    %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#DerivedAdjunctionUnit"}
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
            %p
              The main class of examples of
              %a.existingWikiWord{:href => "/nlab/show/Quillen+reflections"} Quillen reflections
              are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localizations"} left Bousfield localizations
              %a.maruku-ref{:href => "#BasicPropertiesOfLectBousfieldLocalizations"}
              below.
            #QuillenReflectionViaReflectionOfHomotopyCategories.num_prop
              %h6#proposition_12 Proposition
              %p
                %strong
                  (characterization of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/Quillen+reflections"} Quillen reflections
              %p Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %munderover
                        %mrow
                          %msub
                            %mo ⊥
                            %mi Qu
                        %munder
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %mi R
                            %mphantom
                              %mi AA
                        %mover
                          %mo ⟵
                          %mi L
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}
                      \\underoverset
                      {\underset{\phantom{AA}R\phantom{AA}}{\longrightarrow}}
                      {\overset{L}{\longleftarrow}}
                      {\bot_{Qu}}
                      \\mathcal{D}
              %p
                be a
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#QuillenAdjunction"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %munderover
                        %mrow
                          %msub
                            %mo ⊥
                            %mi Qu
                        %munder
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %mi ℝ
                            %mi R
                            %mphantom
                              %mi AA
                        %mover
                          %mo ⟵
                          %mrow
                            %mi 𝕃
                            %mi L
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒟
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Ho(\mathcal{C})
                      \\underoverset
                      {\underset{\phantom{AA}\mathbb{R}R\phantom{AA}}{\longrightarrow}}
                      {\overset{\mathbb{L}L}{\longleftarrow}}
                      {\bot_{Qu}}
                      Ho(\mathcal{D})
              %p
                for the induced
                %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
                of
                %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
                on the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy categories
                = succeed "." do
                  %a.maruku-ref{:href => "#QuillenAdjunctionInducesAdjunctionOnHomotopyCategories"}
              %p Then
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi L
                          %munder
                            %mo ⊣
                            %mi Qu
                          %mi R
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (L \underset{Qu}{\dashv} R)
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/Quillen+reflection"} Quillen reflection
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#QuillenReflection"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi 𝕃
                          %mi L
                          %mo ⊣
                          %mi ℝ
                          %mi R
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\mathbb{L}L \dashv \mathbb{R}R)
                    is a
                    = succeed "-inclusion" do
                      %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                    = succeed ");" do
                      %a.maruku-ref{:href => "#ReflectiveSubcategory"}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi L
                          %munder
                            %mo ⊣
                            %mi Qu
                          %mi R
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (L \underset{Qu}{\dashv} R)
                    is a
                    = succeed "]" do
                      %a.existingWikiWord{:href => "/nlab/show/Quillen+co-reflection"} Quillen co-reflection
                    = succeed ")" do
                      %a.maruku-ref{:href => "#QuillenReflection"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
