                      \\widetilde F
                      \\left(
                      \\int^{c \in \mathcal{C}} y(c) \cdot \mathbf{X}(c)
                      \\right)
                      \&amp; \coloneqq
                      \\int^{c \in \mathcal{C}} F(c) \cdot \mathbf{X}(c)
                      \\;\;\;\;\in \mathcal{D}
                      \\end{aligned}
              %p
                (where the colimit on the right is computed in
                = succeed "!)." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
