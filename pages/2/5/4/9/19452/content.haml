                          %mn 1
                        %mo +
                        %msub
                          %mi ϕ
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %msub
                          %mi ϕ
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo +
                        %msub
                          %mi ϕ
                          %mn 2
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ∈
                        %mi B
                      %annotation{:encoding => "application/x-tex"} (\phi_1 + \phi_2)(a) \coloneqq \phi_1(a) + \phi_2(b) \; \in B
              %p
                This is the archetypical case that motivates the notation “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ⊗
                    %annotation{:encoding => "application/x-tex"} \otimes
                ” for the pairing operation in a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            #GrpdIsACartesianClosedCategory.num_example
              %h6#example_4 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                  and
                  %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
                  are
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+categories"} cartesian closed categories
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoriesOfSmallCategories"}
                %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#SmallCategory"}
                = succeed "-structure" do
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartesianMonoidalCategory"}
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                given by forming
                %a.existingWikiWord{:href => "/nlab/show/product+categories"} product categories
                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#ProductCategory"}
              %p
                Inside this, the
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#FullSubcategoryOnClassOfObjects"}
                %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoriesOfSmallCategories"}
                %a.existingWikiWord{:href => "/nlab/show/small+groupoid"} small
                %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#Groupoid"}
                = succeed "-structure" do
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian monoidal category
                = succeed ")" do
                  %a.maruku-ref{:href => "#CartesianMonoidalCategory"}
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
                given by forming
                %a.existingWikiWord{:href => "/nlab/show/product+categories"} product categories
                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#ProductCategory"}
              %p
                In both cases this yields a
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#ClosedMonoidalCategory"}
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                is given by the
                %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
                construction (Example
