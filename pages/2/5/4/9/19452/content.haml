                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
