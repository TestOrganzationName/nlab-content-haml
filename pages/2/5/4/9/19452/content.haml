                      \\mathcal{C}(c,d),
                      [F(c),G(d)]
                      )
                      \\,,
              %p
                where we used Example
                %a.maruku-ref{:href => "#UnderlyingSetOfInternalHomIsHomSet"}
                to identify underlying sets of internal homs with
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
              %p
                Here the object in the middle is just the set of
                %a.existingWikiWord{:href => "/nlab/show/indexed+sets"} indexed sets
                of component morphisms
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
