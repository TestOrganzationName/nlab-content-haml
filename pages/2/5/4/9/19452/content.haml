                              %mo{:stretchy => "false"} ˜
                            %mn 2
                          %mo ,
                          %msub
                            %mi ρ
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\tilde F_2, \rho_2)
                    two such factorizations, then there is a unique
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi κ
                          %mo{:lspace => "verythinmathspace"} :
                          %msub
                            %mover
