                = succeed "." do
                  %a.maruku-ref{:href => "#BaseChangePreservesFibrationsAndWeakEquivalences"}
            %p Hence we say:
            #HomotopyFiber.num_defn
              %h6#definition_24 Definition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                its model category of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
                = succeed "." do
                  %a.maruku-ref{:href => "#ModelStructureOnSliceCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
                any morphism in its
                %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi f
                      %annotation{:encoding => "application/x-tex"} (\mathcal{C}^{\ast/})_f
                = succeed "," do
                  %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hofib
                      %mo{:stretchy => "false"} (
