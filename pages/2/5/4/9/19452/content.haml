                          %mo ⊗
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          a
                          \\;\colon\;
                          ((-)\otimes (-)) \otimes (-)
                          \\overset{\simeq}{\longrightarrow}
                          (-) \otimes ((-)\otimes(-))
                  %p
                    called the
                    = succeed "," do
                      %strong
                        %a.existingWikiWord{:href => "/nlab/show/associator"} associator
                %li#MonoidalCategoryUnitors
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℓ
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ⊗
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
