                              %mi X
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munder
                                %mo ⟶
                                %mi η
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X \sqcup X &amp;\overset{(f,g)}{\longrightarrow}&amp; Q Y
                      \\\
                      {}^{\mathllap{\in Cof}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p_Y}}_{\mathrlap{\in W \cap Fib}}
                      \\\
                      Cyl(X) &amp;\underset{\eta}{\longrightarrow}&amp; Y
                      }
                      \\,,
              %p
                which says that if two morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Q
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f, g \colon X \to Q Y
                become homotopic after postcomposition with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi Y
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Q
                        %mi X
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} p_Y \colon Q X \to Y
            %p
              We record the following fact which will be used in
              %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1-1"} part 1.1
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1-1#StableHomotopyCategoryIsTriangulated"}> here
              ):
            #RepresentingHomotopyCommutativeSquaresByCommutativeSquares.num_lemma
              %h6#lemma_8 Lemma
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#ModelCategory"}
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
                in its
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(C)
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                of squares, in the image of the
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo ⟶
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} \longrightarrow Ho(\mathcal{C})
                of a commuting square in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (i.e.: not just commuting up to homotopy).
            .proof
              %h6#proof_13 Proof
              %p Let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                              %mi B
