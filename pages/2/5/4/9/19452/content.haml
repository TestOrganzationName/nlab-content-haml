                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                              %mi Y
                            %mtd
                              %mover
                                %mo ⟶
                                %mi η
                            %mtd
                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi Z
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
