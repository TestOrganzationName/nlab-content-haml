                          %mi R
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (C \dashv R)
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#DerivedAdjunctionUnit"}
                    %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                    form the plain
                    %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
                    (Def.
                    = succeed ")." do
                      %a.maruku-ref{:href => "#AdjunctionUnitFromHomIsomorphism"}
            .proof
              %h6#proof_7 Proof
              %p
                By Def.
                = succeed "," do
                  %a.maruku-ref{:href => "#AdjunctionUnitFromHomIsomorphism"}
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
                is on cofibrant objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %msub
                        %mi 𝒞
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}_1
                given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi η
                            %mi c
                      %mi C
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %mi C
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi j
                            %mrow
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mi C
                      %mi P
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      c
                      \\overset{\eta_c}{\longrightarrow}
                      C L (c)
                      \\overset{ C(j_{L(c)}) }{\longrightarrow}
                      C P L (c)
              %p
                Here the
                = succeed "-morphism" do
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+resolution"} fibrant resolution
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mrow
                          %mi P
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j_{P(c)}
                is an
                %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibration"} acyclic cofibration
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is also a
                %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                        %mover
                          %mo →
                          %mi C
                        %msub
                          %mi 𝒞
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathcal{D} \overset{C}{\to} \mathcal{C}_2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi j
                        %mrow
                          %mi L
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(j_{L(c)})
                is an
                %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibration"} acyclic cofibration
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_2
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_2
                and therefore, by assumption, also in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_1
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
                of the second adjunction is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
