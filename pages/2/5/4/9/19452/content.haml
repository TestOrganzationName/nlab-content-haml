                      \\phantom{AAA}
                      \\text{iff}
                      \\phantom{AAA}
                      ptp_{\mathbf{B}} \;\; \text{is epi}
                      \\,.
              %p
                In one direction, assume that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
