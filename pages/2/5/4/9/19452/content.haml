                morphism
                = succeed "," do
                  %a.maruku-eqref{:href => "#eq:EvaluationMorphism"} (39)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
