                                  %mo{:stretchy => "false"} )
                                  %mo ⊗
                                  %mi N
                                %mtd
                                  %munderover
                                    %mo ⟶
                                    %mo ≃
                                    %mrow
                                      %msub
                                        %mi a
                                        %mrow
                                          %mi A
                                          %mo ,
                                          %mi A
                                          %mo ,
                                          %mi N
