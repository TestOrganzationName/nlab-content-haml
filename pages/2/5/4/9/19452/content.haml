              %p Pasting this square onto the top of the previous one yields
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi C
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi id
                                  %mo ⊗
                                  %mover
                                    %mi f
                                    %mo{:stretchy => "false"} ˜
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi N
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mi id
                                    %mo ⊗
                                    %mi e
                                    %mo ⊗
                                    %mi id
                              %mo{:stretchy => "false"} ↓
