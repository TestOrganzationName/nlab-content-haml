                          %msub
                            %mi Hom
                            %mi Set
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} )
                          %mo =
                        %annotation{:encoding => "application/x-tex"} id_X \in Hom_{Set}(X,X) =
                    %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
                    on set
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
