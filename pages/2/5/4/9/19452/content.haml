                              %mi ℕ
                              %mo ,
                          %mrow
                            %mrow
                              %mi c
                              %mo ∈
                              %mi Obj
                              %mo{:stretchy => "false"} (
                              %mi 𝒞
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      J_{Top^{\ast/}}^{\mathcal{C}}
                      \\;\coloneqq\;
                      \\left\{
                      y(c) \wedge (D^n_+ \overset{(id, \delta_0)_+}{\longrightarrow} (D^n \times I)_+)
                      \\right\}_{{n \in \mathbb{N},} \atop {c \in Obj(\mathcal{C})}}
              %p
                for the analogous construction applied to the pointed generating (acyclic) cofibrations of def.
