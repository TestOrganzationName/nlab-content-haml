                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} q = \phi
            #AAlgebra.num_defn
              %h6#definition_9 Definition
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal
                %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mi Mod
                      %mo ,
                      %msub
                        %mo ⊗
                        %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A Mod , \otimes_A , A)
                as in prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#MonoidalCategoryOfModules"}
