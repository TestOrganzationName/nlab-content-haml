                                  %mrow
                                    %mi id
                                    %mo ⊗
                                    %msup
                                      %mi r
                                      %mrow
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mn 1
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msubsup
                                %mo{:stretchy => "false"} ↓
                                %mo ≃
