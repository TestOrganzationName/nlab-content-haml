                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Categories"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable
                if there exists a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SmallCategory"}
                = succeed "-inclusion" do
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                into its
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryOfPresheaves"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ↪
                          %mtext acc
                        %mover
                          %mo ⟵
