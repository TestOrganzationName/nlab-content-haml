                            %mo ,
                            %msub
                              %mi Top
                              %mi cg
                            %mo{:stretchy => "false"} ]
                          %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{cg}]
                %li
                  %p
                    morphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ⟶
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} X \longrightarrow F(c)
                    in
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi Top
                              %mi cg
                          %annotation{:encoding => "application/x-tex"} Top_{cg}
              %p In short:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mi y
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mi X
                          %mo ⟶
                          %mi F
                        %mrow
                          %mi X
                          %mo ⟶
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
