                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{cg}^{\ast/}]
                its category of pointed topologically enriched copresheaves from example
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicallyEnrichedFunctorsToTopk"}
              %ol
                %li
                  %p Define a functor
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
