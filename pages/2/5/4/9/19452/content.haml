                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
            .num_prop
              %h6#proposition_5 Proposition
              %p
                Def.
                %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
                is well defined, in that composition of morphisms between fibrant-cofibrant objects in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                indeed passes to
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
            .proof
              %h6#proof_8 Proof
              %p
                Fix any morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \overset{f}{\to} Y
                between fibrant-cofibrant objects. Then for precomposition
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mo{:stretchy => "false"} [
                      %mi f
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Hom
                        %mrow
                          %mi Ho
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi Z
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi Hom
                        %mrow
                          %mi Ho
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi Z
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (-) \circ [f] \;\colon\; Hom_{Ho(\mathcal{C})}(Y,Z) \to Hom_{Ho(\mathcal{C}(X,Z))}
              %p
                to be well defined, we need that with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo ∼
                      %mi h
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Y
                      %mo →
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} (g\sim h)\;\colon\; Y \to Z
                also
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mi g
                        %mo ∼
                        %mi f
                        %mi h
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi X
                        %mo →
                        %mi Z
                      %annotation{:encoding => "application/x-tex"} (f g \sim f h)\;\colon\; X \to Z
                %a.maruku-ref{:href => "#BetweenCofibFibLeftAndRightHomotopyAreEquivalentEquivalenceRelations"}
                we may take the homotopy
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∼
                    %annotation{:encoding => "application/x-tex"} \sim
                to be exhibited by a right homotopy
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                        %mo{:lspace => "verythinmathspace"} :
                        %mi Y
                        %mo →
                        %mi Path
                        %mo{:stretchy => "false"} (
                        %mi Z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \eta \colon Y \to Path(Z)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi Z
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi g
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↑
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi p
                                      %mn 1
                          %mtr
                            %mtd
