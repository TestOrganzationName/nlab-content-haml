                                    %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒟
                              %mo{:stretchy => "false"} (
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi d
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munderover
                                %mo ⟶
                                %mo ≃
                                %mover
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                                  %mo ˜
                            %mtd
