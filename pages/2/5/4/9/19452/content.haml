                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi Set
                        %mi Qu
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi AAA
                                  %mi Π
                                  %mphantom
                                    %mi AAA
                          %mtr
                            %mtd
                              %mover
                                %mo ↩
