            #BaseChangePreservesFibrationsAndWeakEquivalences.num_lemma
              %h6#lemma_13 Lemma
              %p
                In a
                %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mi f
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
                = succeed "," do
                  %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi A
                                %mn 1
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                            %mtd
                              %msub
                                %mi A
                                %mn 2
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mrow
                                  %mo ∈
                                  %mi Fib
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mrow
                                  %mo ∈
                                  %mi Fib
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A_1 &amp;&amp;\stackrel{f}{\longrightarrow}&amp;&amp; A_2
                      \\\
                      \&amp; {}_{\in Fib}\searrow &amp;&amp; \swarrow_{\in Fib}
                      \\\
                      \&amp;&amp; B
                      }
              %p
                be a morphism over some object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi f
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo ′
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} u \colon B' \to B
                be any morphism in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mi f
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi u
                                %mo *
                              %msub
                                %mi A
                                %mn 1
                            %mtd
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msup
                                    %mi u
                                    %mo *
                                  %mi f
                            %mtd
                            %mtd
                              %msup
                                %mi u
                                %mo *
                              %msub
                                %mi A
                                %mn 2
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mrow
                                  %mo ∈
                                  %mi Fib
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mrow
                                  %mo ∈
                                  %mi Fib
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                              %mo ′
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      u^*A_1 &amp;&amp;\stackrel{u^* f}{\longrightarrow}&amp;&amp; u^* A_2
                      \\\
                      \&amp; {}_{\in Fib}\searrow &amp;&amp; \swarrow_{\in Fib}
                      \\\
                      \&amp;&amp; B'
                      }
              %p
                be the corresponding morphism pulled back along
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                      %annotation{:encoding => "application/x-tex"} u
              %p Then
              %ul
                %li
                  %p
                    if
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                    is a fibration then also
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi u
                            %mo *
                          %mi f
                        %annotation{:encoding => "application/x-tex"} u^* f
                    is a fibration;
                %li
                  %p
                    if
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                    is a weak equivalence then also
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi u
                            %mo *
                          %mi f
                        %annotation{:encoding => "application/x-tex"} u^* f
                    is a weak equivalence.
            %p
              (
              %a{:href => "#Brown73"}> Brown 73, section 4, lemma 1
              )
            .num_proof
              %h6#proof_29 Proof
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mi Fib
                    %annotation{:encoding => "application/x-tex"} f \in Fib
                the statement follows from the
                %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
                which says that if in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi B
                              %mo ′
                              %msub
                                %mo ×
                                %mi B
                              %msub
                                %mi A
                                %mn 1
                            %mtd
                              %mo ⟶
                            %mtd
                              %msub
                                %mi A
                                %mn 1
                          %mtr
                            %mtd
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msup
                                      %mi u
                                      %mo *
                                    %mi f
                                    %mo ∈
                                    %mi Fib
                            %mtd
                            %mtd
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mi f
                                    %mo ∈
                                    %mi Fib
                          %mtr
                            %mtd
                              %mi B
                              %mo ′
                              %msub
                                %mo ×
                                %mi B
                              %msub
                                %mi A
                                %mn 2
                            %mtd
                              %mo ⟶
                            %mtd
                              %msub
                                %mi A
                                %mn 2
                          %mtr
                            %mtd
                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                            %mtd
                            %mtd
                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                          %mtr
                            %mtd
                              %mi B
                              %mo ′
                            %mtd
                              %mover
                                %mo ⟶
                                %mi u
                            %mtd
                              %mi B
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      B' \times_B A_1 &amp;\longrightarrow&amp; A_1
                      \\\
                      \\;\;\downarrow^{\mathrlap{u^* f \in Fib}}
                      \&amp;&amp; \;\;\downarrow^{\mathrlap{f \in Fib}}
                      \\\
                      B' \times_B A_2 &amp;\longrightarrow&amp; A_2
                      \\\
                      \\;\downarrow^{\mathrlap{\in Fib}} &amp;&amp; \;\downarrow^{\mathrlap{\in Fib}}
                      \\\
                      B' &amp;\stackrel{u}{\longrightarrow}&amp; B
                      }
              %p
                the bottom and the total square are pullback squares, then so is the top square. The same reasoning applies for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %mi W
                        %mo ∩
                        %mi Fib
                      %annotation{:encoding => "application/x-tex"} f \in W \cap Fib
              %p
                Now to see the case that
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                        %mo ∈
                        %mi W
                      %annotation{:encoding => "application/x-tex"} f\in W
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi f
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}_{/B})_f
                of the
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/B}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SliceCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %msubsup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                                %mpadded{:width => "0"}
                                  %mi p
                          %mtr
                            %mtd
                              %mi B
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X
                      \\\
                      \\downarrow^{\mathrlap{p}}_{\mathrlap{\in Fib}}
                      \\\
                      B
                      }
              %p
                into
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %a.existingWikiWord{:href => "/nlab/show/diagonal+morphisms"} diagonal morphisms
                into the
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %munder
                        %mo ×
                        %mi B
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \underset{B}{\times} X
                through a weak equivalence followed by a fibration, we obtain path space objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Path
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path_B(X)
                relative to
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi Δ
                                %mi X
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mi B
                              %mspace{:width => "thickmathspace"}
                              %mo{:lspace => "verythinmathspace"} :
                            %mtd
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                            %mtd
                              %msub
                                %mi Path
                                %mi B
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi Fib
                            %mtd
                              %mi X
                              %munder
                                %mo ×
                                %mi B
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                              %mo ↘
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (\Delta_X)/B
                      \\;\colon
                      \&amp;
                      X
                      \&amp;\overset{\in W}{\longrightarrow}&amp;
                      Path_B(X)
                      \&amp;\overset{\in Fib}{\longrightarrow}&amp;
                      X \underset{B}{\times} X
                      \\\
                      \&amp; &amp; {}_{\mathllap{\in Fib}}\searrow &amp; \downarrow &amp; \swarrow_{\mathrlap{\in Fib}}
                      \\\
                      \&amp; &amp;&amp; B
                      }
                      \\,.
              %p
                With these, the
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
                (lemma
                = succeed ")" do
                  %a.maruku-ref{:href => "#FactorizationLemma"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi B
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi f
                      %annotation{:encoding => "application/x-tex"} (\mathcal{C}_{/B})_f
              %p
                (Notice that for this we do need the restriction of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/B}
                to the fibrations, because this ensures that the projections
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi X
                        %mn 1
                      %msub
                        %mo ×
                        %mi B
                      %msub
                        %mi X
                        %mn 2
                      %mo →
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} p_i \colon X_1 \times_B X_2 \to X_i
                are still fibrations, which is used in the proof of the factorization lemma (
                %a{:href => "#ProofOfFactorizationLemma"}> here
                ).)
              %p So now given any
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                            %mtd
                              %munderover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                                %mi f
                            %mtd
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X &amp;&amp; \underoverset{\in W}{f}{\longrightarrow} &amp;&amp; Y
                      \\\
                      \&amp; {}_{\mathllap{\in Fib}}\searrow &amp;&amp; \swarrow_{\mathrlap{\in Fib}}
                      \\\
                      \&amp;&amp; B
                      }
              %p
                apply the
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi f
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}_{/B})_f
                to factor it as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi W
                            %mtd
                              %msub
                                %mi Path
                                %mi B
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi Fib
                            %mtd
                              %mi Y
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                              %mo ↘
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X
                      \&amp;\overset{i \in W}{\longrightarrow}&amp;
                      Path_B(f)
                      \&amp;\overset{\in W \cap Fib}{\longrightarrow}&amp; Y
                      \\\
                      \&amp; {}_{\mathllap{\in Fib}}\searrow
                      \&amp;\downarrow&amp;
                      \\swarrow_{\mathrlap{\in Fib}}
                      \\\
                      \&amp;&amp; B
                      }
                      \\,.
              %p
                By the previous discussion it is sufficient now to show that the base change of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} B'
                is still a weak equivalence. But by the factorization lemma in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi B
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi f
                      %annotation{:encoding => "application/x-tex"} (\mathcal{C}_{/B})_f
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                is right inverse to another acyclic fibration over
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mi X
                              %mspace{:width => "thickmathspace"}
                              %mo{:lspace => "verythinmathspace"} :
                            %mtd
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi W
                            %mtd
                              %msub
                                %mi Path
                                %mi B
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi Fib
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                              %mo ↘
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      id_X
                      \\;\colon
                      \&amp;
                      X
                      \&amp;\overset{i \in W}{\longrightarrow}&amp;
                      Path_B(f)
                      \&amp;\overset{\in W \cap Fib}{\longrightarrow}&amp; X
                      \\\
                      \&amp; &amp;
                      {}_{\mathllap{\in Fib}}\searrow
                      \&amp;\downarrow&amp;
                      \\swarrow_{\mathrlap{\in Fib}}
                      \\\
                      \&amp; &amp;&amp; B
                      }
                      \\,.
              %p
                (Notice that if we had applied the factorization lemma of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \Delta_X
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi f
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
                instead of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Δ
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi B
                    %annotation{:encoding => "application/x-tex"} (\Delta_X)/B
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}_{/B})
                then the corresponding triangle on the right here would not commute.)
              %p Now we may reason as before: the base change of the top morphism here is exhibited by the following pasting composite of pullbacks:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi B
                              %mo ′
                              %munder
                                %mo ×
                                %mi B
                              %mi X
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi B
                              %mo ′
                              %munder
                                %mo ×
                                %mi B
                              %msub
                                %mi Path
                                %mi B
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⟶
                            %mtd
                              %msub
                                %mi Path
                                %mi B
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                                    %mo ∩
                                    %mi Fib
                          %mtr
                            %mtd
                              %mi B
                              %mo ′
                              %munder
                                %mo ×
                                %mi B
                              %mi X
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi B
                              %mo ′
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi B
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      B' \underset{B}{\times} X
                      \&amp;\longrightarrow&amp;
                      X
                      \\\
                      \\downarrow
                      \&amp;(pb)&amp;
                      \\downarrow
                      \\\
                      B' \underset{B}{\times} Path_B(f)
                      \&amp;\longrightarrow&amp;
                      Path_B(f)
                      \\\
                      \\downarrow
                      \&amp;(pb)&amp;
                      \\downarrow^{\mathrlap{\in W \cap Fib}}
                      \\\
                      B' \underset{B}{\times}X
                      \&amp;\longrightarrow&amp;
                      X
                      \\\
                      \\downarrow
                      \&amp;(pb)&amp;
                      \\downarrow
                      \\\
                      B'
                      \&amp;\longrightarrow&amp;
                      B
                      }
                      \\,.
              %p
                The acyclic fibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Path
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path_B(f)
                is preserved by this pullback, as is the identity
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi id
                          %mi X
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %msub
                          %mi Path
                          %mi B
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} id_X \colon X \to Path_B(X)\to X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %msub
                        %mi Path
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \to Path_B(X)
                is preserved by
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
            #InCfPullbackAlongFibrationPreservesWeakEquivalences.num_lemma
              %h6#lemma_14 Lemma
              %p
                In a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
                = succeed "," do
                  %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
            %p
              (
              %a{:href => "#Brown73"}> Brown 73, section 4, lemma 2
              )
            .proof
              %h6#proof_30 Proof
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo ′
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} u \colon B' \to B
                be a weak equivalence and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi E
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} p \colon E \to B
                be a fibration. We want to show that the left vertical morphism in the
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi E
                              %msub
                                %mo ×
                                %mi B
                              %mi B
                              %mo ′
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi B
                              %mo ′
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ⇒
                                    %mo ∈
                                    %mi W
                            %mtd
                            %mtd
                              %mspace{:width => "thickmathspace"}
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                          %mtr
                            %mtd
                              %mi E
                            %mtd
                              %mover
