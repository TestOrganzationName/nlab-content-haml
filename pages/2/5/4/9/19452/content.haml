                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DerivedHomFunctorPOnSimplicialModelCategory"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SimplicialModelCategory"}
                = succeed "," do
                  %a.maruku-ref{:href => "#SimplicialPresheavesIsProperCombinatorialSimplicial"}
              %p
                This establishes that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Π
                      %mo ⊣
                      %mi Disc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Pi \dashv Disc)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ⊣
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} coDisc
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma \dashv \coDisc)
                descent to Quillen adjunctions on the local model structure. Finally, it is immediate that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                preserves fibrant objects, and hence also
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
