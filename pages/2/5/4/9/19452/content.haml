                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi f
                      %mo →
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma \colon (\mathcal{C}^{\ast/})_f \to Ho(\mathcal{C}^{\ast/})
                (def.
                = succeed "," do
                  %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#HomotopyCategoryOfSubcategoriesOfModelCategoriesOnGoodObjects"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi fib
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mo ⟶
                      %mi fib
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} fib(p_1) \stackrel{\longrightarrow}{\longrightarrow} fib(p_2)
                induced by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                on
                %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#FiberAndCofiberInPointedObjects"}
            %p
              (
              %a{:href => "#Brown73"}> Brown 73, section 4, lemma 4
              )
            .proof
              %h6#proof_31 Proof
              %p
                First consider the pullback of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} p_2
                along
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi u
                      %annotation{:encoding => "application/x-tex"} u
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi f
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}^{\ast/}_{/B})_f
                of the
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}_{/B}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SliceCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %msubsup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                                %mpadded{:width => "0"}
                                  %mi p
                          %mtr
                            %mtd
                              %mi B
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X
                      \\\
                      \\downarrow^{\mathrlap{p}}_{\mathrlap{\in Fib}}
                      \\\
                      B
                      }
              %p
                into
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
                %a.existingWikiWord{:href => "/nlab/show/diagonal+morphisms"} diagonal morphisms
                into the
                %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %munder
                        %mo ×
                        %mi B
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \underset{B}{\times} X
                through a weak equivalence followed by a fibration, we obtain path space objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Path
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path_B(X)
                relative to
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi Δ
                                %mi X
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mi B
                              %mspace{:width => "thickmathspace"}
                              %mo{:lspace => "verythinmathspace"} :
                            %mtd
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                            %mtd
                              %msub
                                %mi Path
                                %mi B
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi Fib
                            %mtd
                              %mi X
                              %munder
                                %mo ×
                                %mi B
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                              %mo ↘
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi B
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (\Delta_X)/B
                      \\;\colon
                      \&amp;
                      X
                      \&amp;\overset{\in W}{\longrightarrow}&amp;
                      Path_B(X)
                      \&amp;\overset{\in Fib}{\longrightarrow}&amp;
                      X \underset{B}{\times} X
                      \\\
                      \&amp; &amp; {}_{\mathllap{\in Fib}}\searrow &amp; \downarrow &amp; \swarrow_{\mathrlap{\in Fib}}
                      \\\
                      \&amp; &amp;&amp; B
                      }
                      \\,.
              %p
                With these, the
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
                (lemma
                = succeed ")" do
                  %a.maruku-ref{:href => "#FactorizationLemma"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi B
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi f
                      %annotation{:encoding => "application/x-tex"} (\mathcal{C}^{\ast/}_{/B})_f
              %p
                Let then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi s
                      %msub
                        %mi Path
                        %mi B
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi X
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi p
                            %mn 0
                          %mo ,
                          %msub
                            %mi p
                            %mn 1
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi X
                        %mn 2
                      %msub
                        %mo ×
                        %mi B
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X\overset{s}{\to}Path_B(X_2)\overset{(p_0,p_1)}{\to} X_2 \times_B X_2
                be a
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X_2
                in the slice over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
                and consider the following commuting square
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                              %msub
                                %mo ′
                                %mn 1
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi s
                                  %mi f
                                  %mi t
                            %mtd
                              %msub
                                %mi Path
                                %mi B
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi X
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msubsup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi t
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msubsup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi p
                                      %mn 0
                                    %mo ,
                                    %msub
                                      %mi p
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mn 1
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo ,
                                  %mi g
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %msub
                                %mi X
                                %mn 2
                              %munder
                                %mo ×
                                %mi B
                              %msub
                                %mi X
                                %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X'_1 &amp;\overset{s f t}{\longrightarrow}&amp; Path_B(X_2)
                      \\\
                      {}^{\mathllap{t}}_{\mathllap{\in W}}\downarrow &amp;&amp; \downarrow^{\mathrlap{(p_0,p_1)}}_{\mathrlap{\in Fib}}
                      \\\
                      X_1 &amp;\overset{(f,g)}{\longrightarrow}&amp; X_2\underset{B}{\times} X_2
                      }
                      \\,.
              %p
                By factoring this through the pullback
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo ,
                      %mi g
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi p
                        %mn 0
                      %mo ,
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f,g)^\ast(p_0,p_1)
                and then applying the
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
                %a.maruku-ref{:href => "#FactorizationLemma"}
                and then
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                              %msub
                                %mo ″
                                %mn 1
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                            %mtd
                              %msub
                                %mi Path
                                %mi B
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi X
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msubsup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                                    %mo ∩
                                    %mi Fib
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi t
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msubsup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi p
                                      %mn 0
                                    %mo ,
                                    %msub
                                      %mi p
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mn 1
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo ,
                                  %mi g
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %msub
                                %mi X
                                %mn 2
                              %munder
                                %mo ×
                                %mi B
                              %msub
                                %mi X
                                %mn 2
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X''_1 &amp;\overset{}{\longrightarrow}&amp; Path_B(X_2)
                      \\\
                      {}^{\mathllap{t}}_{\mathllap{\in W\cap Fib}} \downarrow &amp;&amp; \downarrow^{\mathrlap{(p_0,p_1)}}_{\mathrlap{\in Fib}}
                      \\\
                      X_1 &amp;\overset{(f,g)}{\longrightarrow}&amp; X_2\underset{B}{\times} X_2
                      }
                      \\,.
              %p
                This makes also the morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %msub
                        %mo ″
                        %mn 1
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} X''_1 \to B
                be a fibration, so that the whole diagram may now be regarded as a diagram in the category of fibrant objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi f
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}_{/B})_f
                of the
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                      %annotation{:encoding => "application/x-tex"} B
              %p
                As such, the top horizontal morphism now exhibits a
                %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopy
                which under
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mi B
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi f
                      %mo ⟶
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \gamma_B \;\colon\; (\mathcal{C}_{/B})_f \longrightarrow Ho(\mathcal{C}_{/B})
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
                %a.existingWikiWord{:href => "/nlab/show/slice+model+structure"} slice model structure
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ModelStructureOnSliceCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi γ
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi γ
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\gamma_B(f) = \gamma_B(g)
                      \\,.
              %p
                The result then follows by observing that we have a commuting square of
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi 𝒞
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mi B
                                %mrow
                                  %mo *
                                  %mo{:stretchy => "false"} /
                              %msub
                                %mo{:stretchy => "false"} )
                                %mi f
                            %mtd
                              %mover
                                %mo ⟶
                                %mi fib
                            %mtd
                              %msup
                                %mi 𝒞
                                %mrow
                                  %mo *
                                  %mo{:stretchy => "false"} /
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi γ
                                      %mi B
                            %mtd
                              %mo ⇙
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi γ
                          %mtr
                            %mtd
                              %mi Ho
                              %mo{:stretchy => "false"} (
                              %msubsup
                                %mi 𝒞
                                %mrow
                                  %mo{:stretchy => "false"} /
                                  %mi B
                                %mrow
                                  %mo *
                                  %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Ho
                              %mo{:stretchy => "false"} (
                              %msup
                                %mi 𝒞
                                %mrow
                                  %mo *
                                  %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (\mathcal{C}^{\ast/}_{/B})_f &amp;\overset{fib}{\longrightarrow}&amp; \mathcal{C}^{\ast/}
                      \\\
                      \\downarrow^{\mathrlap{\gamma_B}} &amp;\swArrow&amp; \downarrow^{\mathrlap{\gamma}}
                      \\\
                      Ho(\mathcal{C}^{\ast/}_{/B}) &amp;\longrightarrow&amp; Ho(\mathcal{C}^{\ast/})
                      }
                      \\,,
              %p
                because, by lemma
                = succeed "," do
                  %a.maruku-ref{:href => "#BaseChangePreservesFibrationsAndWeakEquivalences"}
                = succeed "." do
                  %a.maruku-ref{:href => "#UniversalPropertyOfHomotopyCategoryOfAModelCategory"}
            %h3#HomotopyFibers Homotopy fibers
            %p
              We now discuss the homotopy-theoretic properties of the
              = succeed "-" do
