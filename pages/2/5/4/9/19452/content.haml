            #HomotopyCategoryOfACategoryWithWeakEquivalences.num_defn
              %h6#definition_11 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/localization+of+a+category"} localization of a category
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category+with+weak+equivalences"} category with weak equivalences
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                  at the weak equivalences
                is, if it exists,
              %ol
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/category"} category
                    denoted
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi W
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}]
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi γ
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mi 𝒞
                          %mo ⟶
                          %mi 𝒞
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi W
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"}
                          \\gamma \;\colon\; \mathcal{C} \longrightarrow \mathcal{C}[W^{-1}]
              %p such that
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi γ
                        %annotation{:encoding => "application/x-tex"} \gamma
                    sends weak equivalences to
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi γ
                        %annotation{:encoding => "application/x-tex"} \gamma
                    is
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal with this property
                  %p
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo{:lspace => "verythinmathspace"} :
                          %mi 𝒞
                          %mo ⟶
                          %mi D
                        %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \longrightarrow D
                    any
                    %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                    out of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    into any
                    %a.existingWikiWord{:href => "/nlab/show/category"} category
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi D
                          %annotation{:encoding => "application/x-tex"} D
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                    takes weak equivalences to
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi γ
                        %annotation{:encoding => "application/x-tex"} \gamma
                    up to a
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                        %annotation{:encoding => "application/x-tex"} \rho
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi 𝒞
                                %mtd
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mi F
                                %mtd
                                %mtd
                                  %mi D
                              %mtr
                                %mtd
                                %mtd
                                  %msub
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
