                        %mo →
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X^{\delta_0} \colon X^I \to X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo ⟶
                        %mi const
                      %msup
                        %mi X
                        %mi I
                      %mover
                        %mo ⟶
                        %mrow
                          %msup
                            %mi X
                            %mrow
                              %msub
                                %mi δ
                                %mn 0
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      X \overset{const}{\longrightarrow} X^I \overset{X^{\delta_0}}{\longrightarrow} X
              %p is already equal to the identity. The other we round, the rescaling of paths provides the required homotopy
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
