                          %mi d
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j_{C(d)}
                to be the
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
            %p
              The following is the analog in
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              of the
              %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant functor
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
              (Def.
              = succeed "):" do
                %a.maruku-ref{:href => "#Limits"}
            #HomotopyLimitQuillenAdjointTriple.num_example
              %h6#example_6 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
                  of
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+limits"} homotopy limits
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+colimits"} colimits
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#SmallCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi proj
                          %mo{:stretchy => "false"} /
                          %mi inj
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, sSet_{Qu}]_{proj/inj}
                for the projective/injective
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Prop.
                = succeed ")," do
                  %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi inj
                      %munderover
                        %mrow
                          %msub
                            %mo ≃
                            %mi Qu
                        %munder
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %mi id
                            %mphantom
                              %mi AA
                        %mover
                          %mo ⟵
                          %mrow
                            %mphantom
                              %mi AA
                            %mi id
                            %mphantom
                              %mi AA
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                      \\underoverset
                      {\underset{\phantom{AA}id\phantom{AA}}{\longrightarrow}}
                      {\overset{\phantom{AA}id\phantom{AA}}{\longleftarrow}}
                      {\simeq_{Qu}}
                      [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
              %p
                Moreover, the
                = succeed "-assigning" do
                  %a.existingWikiWord{:href => "/nlab/show/constant+functor"} constant diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟵
                        %mi const
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{C}^{op}, sSet] \overset{const}{\longleftarrow} sSet
              %p
                is clearly a
                %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functor"} left Quillen functor
                for the injective model structure, and a
                %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
                for the projective model structure.
              %p
                Together this means that in the
                %a.existingWikiWord{:href => "/nlab/show/double+category+of+model+categories"} double category of model categories
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DoubleCategoryOfModelCategories"}
                %a.existingWikiWord{:href => "/nlab/show/2-morphism"} 2-morphism
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi sSet
                                %mi Qu
                            %mtd
                              %mover
                                %mo ⟶
                                %mi const
                            %mtd
                              %mo{:stretchy => "false"} [
                              %msup
                                %mi 𝒞
                                %mi op
                              %mo ,
                              %msub
                                %mi sSet
                                %mi Qu
                              %msub
                                %mo{:stretchy => "false"} ]
                                %mi proj
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi const
                              %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mtd
                              %msub
                                %mo ⇙
                                %mpadded{:width => "0"}
                                  %mi id
                            %mtd
                              %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                              %msup
                                %mrow
                                %mpadded{:width => "0"}
                                  %mi id
