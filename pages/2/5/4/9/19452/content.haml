                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ↦
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi X
                                %mn 1
                              %mo ,
                              %msub
                                %mi Y
