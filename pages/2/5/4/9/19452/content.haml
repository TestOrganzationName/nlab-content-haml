              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                      %mo =
                      %mrow
                        %mo {
                        %msubsup
                          %mi D
                          %mo +
                          %mi n
                        %mover
                          %mo ⟶
