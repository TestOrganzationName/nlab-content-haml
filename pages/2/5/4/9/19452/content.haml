                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi 𝒟
                      %mo{:stretchy => "false"} (
