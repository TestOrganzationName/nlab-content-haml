                      \\,.
              %p
                Hence if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                has all
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coequalizers"} coequalizers
                %a.existingWikiWord{:href => "/nlab/show/category+of+modules"} category of modules
                is a
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mi Mod
                      %mo ,
                      %msub
                        %mo ⊗
                        %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A Mod, \otimes_A, A)
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#MonoidalCategoryOfModules"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#MonoidModuleOverItself"}
                %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
