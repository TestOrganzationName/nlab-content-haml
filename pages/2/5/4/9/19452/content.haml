              %p
                fitting into the diagram (where we are notationally suppressing the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/associator"} associator
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi A
                              %mo ⊗
                              %mi C
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi A
                                  %mo ⊗
                                  %mi f
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi N
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mi μ
                                    %mo ⊗
                                    %mi id
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi ρ
                          %mtr
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi C
                            %mtd
                              %munder
                                %mo ⟶
                                %mi f
                            %mtd
                              %mi N
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A \otimes A \otimes C
                      \&amp;\overset{A \otimes f}{\longrightarrow}&amp;
                      A \otimes N
                      \\\
                      {}^{\mathllap{\mu \otimes id}}\downarrow
                      \&amp;&amp;
                      \\downarrow^{\mathrlap{\rho}}
                      \\\
                      A \otimes C
                      \&amp;\underset{f}{\longrightarrow}&amp;
                      N
                      }
                      \\,.
              %p Consider the composite
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi C
                      %munderover
                        %mo ⟶
                        %mo ≃
                        %mrow
                          %msub
                            %mi ℓ
                            %mi C
