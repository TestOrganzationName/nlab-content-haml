            #GiraudTheorem.num_prop
              %h6#proposition_8 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Giraud%27s+theorem"}> Giraud's theorem
                  )
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Sheaf"}
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LocallyPresentableCategory"}
              %ol
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/universal+colimits"}> universal colimits
                    ,
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/effective+quotients"}> effective quotients
                    ,
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/disjoint+coproducts"}> disjoint coproducts
                    \.
            #SheafToposViaLexReflection.num_prop
              %h6#proposition_9 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes+are+equivalently+the+left+exact+reflective+subcategories+of+presheaf+toposes"}> sheaf toposes are equivalently the left exact reflective subcategories of presheaf toposes
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C}, \tau)
                be a
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#Coverage"}
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i \colon Sh(\mathcal{C},\tau) \hookrightarrow PSh(\mathcal{C})
                of its
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Sheaf"}
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                is a
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                inclusion (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ReflectiveSubcategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ↪
                          %mi ι
                        %mover
                          %mo ⟵
                          %mrow
                            %mphantom
                              %mi AA
                            %mi L
                            %mphantom
                              %mi AA
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Sh(\mathcal{C},\tau)
                      \\underoverset
                      {\underset{\iota}{\hookrightarrow}}
                      {\overset{\phantom{AA}L\phantom{AA}}{\longleftarrow}}
                      {\bot}
                      PSh(\mathcal{C})
              %p such that:
              %ol
                %li
                  %p
                    the inclusion
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ι
                        %annotation{:encoding => "application/x-tex"} \iota
                    is an
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/accessible+functor"} accessible functor
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Sh
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo ,
                          %mi τ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C},\tau)
                    as a
                    %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#LocallyPresentableCategory"}
                %li
                  %p
                    the reflector
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                          %mo{:lspace => "verythinmathspace"} :
                          %mi PSh
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi Sh
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} L \colon PSh(\mathcal{C})  \to Sh(\mathcal{C})
                    (which is
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Sheafification"}
                    %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
                    (“lex”) in that it
                    %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
              %p
                Conversely, every
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                arises this way. Hence
                %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                are equivalently the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/left+exact+functor"} left exact
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflectively
