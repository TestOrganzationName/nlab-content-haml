                      \&amp;&amp;
                      \\downarrow
                      \\\
                      A' &amp;\underset{f'}{\longrightarrow}&amp; B'
                      }
              %p
                as an alternative representative of the given commuting square in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
            %h3#DerivedFunctors Derived functors
            #HomotopicalFunctor.num_defn
              %h6#definition_13 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"}> homotopical functor
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                two
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
                = succeed "," do
                  %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒞
                      %mo ⟶
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C}\longrightarrow \mathcal{D}
                is called a
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
                if it sends weak equivalences to weak equivalences.
            #DerivedFunctorOfAHomotopicalFunctor.num_defn
              %h6#definition_14 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor"}> derived functor
                  )
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒞
                      %mo ⟶
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} F \colon \mathcal{C} \longrightarrow \mathcal{D}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#HomotopicalFunctor"}
                %a.existingWikiWord{:href => "/nlab/show/categories+with+weak+equivalences"} categories with weak equivalences
                whose
                %a.existingWikiWord{:href => "/nlab/show/homotopy+categories"} homotopy categories
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒟
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(\mathcal{D})
                exist (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#HomotopyCategoryOfACategoryWithWeakEquivalences"}
                = succeed "\u201D)" do
                  %a.existingWikiWord{:href => "/nlab/show/total+derived+functor"} total
                %em
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                is the functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(F)
                between these homotopy categories which is induced uniquely, up to unique isomorphism, by their universal property (def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#HomotopyCategoryOfACategoryWithWeakEquivalences"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi 𝒞
                            %mtd
                              %mover
                                %mo ⟶
                                %mi F
                            %mtd
                              %mi 𝒟
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi γ
                                      %mi 𝒞
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msub
                                %mo ⇙
                                %mo ≃
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi γ
                                      %mi 𝒟
                          %mtr
                            %mtd
                              %mi Ho
                              %mo{:stretchy => "false"} (
                              %mi 𝒞
                              %mo{:stretchy => "false"} )
                            %mtd
