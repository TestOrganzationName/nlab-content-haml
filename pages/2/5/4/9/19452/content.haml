                        %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                        obtained as the
                        %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                        over the
                        %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
                        is the
                        = succeed ":" do
                          %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                      .maruku-equation
                        %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi π
                                %mn 0
                              %munder
                                %mi lim
                                %munder
