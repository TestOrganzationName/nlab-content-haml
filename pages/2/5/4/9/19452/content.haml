                              %mi 𝒞
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      I_{Top}^{\mathcal{C}}
                      \\;\coloneqq\;
                      \\left\{
                      y(c)\cdot (S^{n-1} \overset{\iota_n}{\longrightarrow} D^n)
                      \\right\}_{{n \in \mathbb{N},} \atop {c \in Obj(\mathcal{C})}}
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi J
                        %mi Top
                        %mi 𝒞
                      %mspace{:width => "thickmathspace"}
