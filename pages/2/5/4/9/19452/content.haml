                factors through a stage
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi β
                      %mo →
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} X_\beta \to \hat X
                of order
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
