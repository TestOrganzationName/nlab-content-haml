                    %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#NaturalTransformations"}
                  #eq:MonoidalComponentsOfMonoidalFunctor.maruku-equation
                    %span.maruku-eq-number (44)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi μ
                            %mrow
                              %mi x
                              %mo ,
