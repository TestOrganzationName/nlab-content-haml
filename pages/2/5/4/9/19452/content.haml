              = succeed "." do
                %a{:href => "#MappingCones"} above
            %p
              %strong Literature
              (
              %a{:href => "#Brown73"}> Brown 73, section 4
              ).
            .num_remark
              %h6#remark_10 Remark
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
                %a.maruku-ref{:href => "#FactorizationLemma"}
                with prop.
                %a.maruku-ref{:href => "#ConeAndMappingCylinder"}
                says that the
                %a.existingWikiWord{:href => "/nlab/show/mapping+cocone"} mapping cocone
                of a morphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
                = succeed "," do
                  %a.maruku-ref{:href => "#MappingConeAndMappingCocone"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                = succeed "," do
                  %a.maruku-ref{:href => "#FiberAndCofiberInPointedObjects"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \tilde f
                of
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi f
                      %annotation{:encoding => "application/x-tex"} f
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
