                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      D^n &amp; = &amp; D^n
                      \\\
                      {}^{\mathllap{(id,\delta_0)}}\downarrow  &amp;&amp; \downarrow
                      \\\
                      D^n \times I &amp;\simeq&amp; D^{n+1}
                      }
              %p
                such that the map on the right is the inclusion of one hemisphere into the
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mrow
                            %mi n
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} D^{n+1}
                %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attaching
                two cells:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
