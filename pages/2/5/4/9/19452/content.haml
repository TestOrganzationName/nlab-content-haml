                        %mi p
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Q
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mo →
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{C}}(id_X, p_Y)/_\sim
                      \\;\colon\;
                      Hom_{\mathcal{C}}(X, Q Y)/_\sim \to Hom_{\mathcal{C}}(X,Y)/_\sim
              %p is an isomorphism, and dually that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi j
                        %mi X
                      %mo ,
                      %msub
                        %mi id
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mo →
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{C}}(j_X, id_Y)/_\sim
                      \\;\colon\;
                      Hom_{\mathcal{C}}(P X, Y)/_\sim \to Hom_{\mathcal{C}}(X,Y)/_\sim
              %p
                is an isomorphism. We discuss this for the former; the second is
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
              %p
                First, that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mi X
                      %mo ,
                      %msub
                        %mi p
                        %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(id_X, p_Y)
                is surjective is the
                %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
                in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi ∅
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Q
                              %mi Y
                          %mtr
                            %mtd
