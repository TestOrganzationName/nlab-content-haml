              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mi Mod
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ⟶
                          %mi U
                        %mover
                          %mo ⟵
                          %mi F
                      %mi 𝒞
