                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi coDisc
                      %mo{:stretchy => "false"} (
