                          %mi y
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} x,y \in \mathcal{C}
              %p satisfying the following conditions:
              %ol
                %li
                  %p
                    %strong
                      (
                      %a.existingWikiWord{:href => "/nlab/show/associativity"}> associativity
                      )
                    For all objects
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ,
                          %mi y
                          %mo ,
                          %mi z
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} x,y,z \in \mathcal{C}
                    the following
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
