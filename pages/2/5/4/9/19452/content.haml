              %p
                Dually, the
                %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"} reduced suspension
                operation, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#SuspensionAndLoopSpaceObject"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                depends on a choice of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} )
