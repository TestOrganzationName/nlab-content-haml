                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi Obj
                            %mi 𝒞
                          %mo ⟶
                          %msub
                            %mi Obj
                            %mi 𝒟
                        %annotation{:encoding => "application/x-tex"}
                          F_{Obj} \;\colon\; Obj_{\mathcal{C}} \longrightarrow Obj_{\mathcal{D}}
                %li
