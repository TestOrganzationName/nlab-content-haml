              %br/
            %p
              We now turn to a
              %strong sequence of equivalent reformulations
              of the condition of adjointness.
            #GeneralAdjunctsInTermsOfAdjunctionUnitCounit.num_prop
              %h6#proposition_3 Proposition
              %p
                %strong
                  (general
                  %a.existingWikiWord{:href => "/nlab/show/adjuncts"} adjuncts
                  in terms of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} unit/counit
              %p
                Consider a pair of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %munderover
                        %mo ⊥
                        %munder
