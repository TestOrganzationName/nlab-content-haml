                canonically becomes a left module over itself by setting
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo ≔
                        %mi μ
                      %annotation{:encoding => "application/x-tex"} \rho \coloneqq \mu
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
