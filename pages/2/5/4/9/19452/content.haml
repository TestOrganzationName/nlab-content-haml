              %p
                By the above and the proof of prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#QuillenAdjunctionInducesAdjunctionOnHomotopyCategories"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi R
                      %mo{:stretchy => "false"} )
