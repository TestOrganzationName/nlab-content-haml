                                %mi i
                              %mo{:stretchy => "false"} }
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thickmathspace"}
                              %mo ≃
                              %mspace{:width => "thickmathspace"}
                              %mo *
                            %annotation{:encoding => "application/x-tex"}
                              \\pi_0
                              \\underset{\underset{\mathcal{C}^{op}}{\longrightarrow}}{\lim}
                              C(\{U_i\})
                              \\;\simeq\;
                              \\ast
                    %li
                      %p
                        the set of
                        %a.existingWikiWord{:href => "/nlab/show/connected+components"} connected components
                        of the
                        %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                        obtained as the
                        %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                        of the
                        %a.existingWikiWord{:href => "/nlab/show/Cech+groupoid"} Cech groupoid
                        is
                        %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
                        to the set of points of
                        = succeed "," do
                          %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                            %semantics
                              %mrow
