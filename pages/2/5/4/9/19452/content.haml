              as being glued or
              %em
                %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
              form the “ordinary spaces”
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
