                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      Q X \sqcup Q X &amp;\stackrel{((Q f)_1, (Q f)_2 )}{\longrightarrow}&amp; Q Y
                      \\\
