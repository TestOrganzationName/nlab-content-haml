                      %mo ,
                      %mo ⊗
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mi Mod
                      %mo ,
                      %msub
                        %mo ⊗
                        %mi A
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      F
                      \\;\colon\;
                      (\mathcal{C}, \otimes, 1)
                      \\longrightarrow
                      (A Mod, \otimes_A, A)
                      \\,.
            .proof
              %h6#proof_6 Proof
              %p It is sufficient to show that the diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi A
                      %mo ⊗
                      %mi A
                      %munderover
                        %mphantom
                          %mi AAAA
                        %munder
                          %mo ⟶
                          %mrow
                            %mi id
                            %mo ⊗
                            %mi μ
                        %mover
                          %mo ⟶
                          %mrow
                            %mi μ
                            %mo ⊗
                            %mi id
                      %mi A
                      %mo ⊗
                      %mi A
                      %mover
                        %mo ⟶
                        %mi μ
                      %mi A
                    %annotation{:encoding => "application/x-tex"}
                      A \otimes A \otimes A
                      \\underoverset
                      {\underset{id \otimes \mu}{\longrightarrow}}
                      {\overset{\mu \otimes id}{\longrightarrow}}
                      {\phantom{AAAA}}
                      A \otimes A
                      \\overset{\mu}{\longrightarrow}
                      A
              %p
                is a
                %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
                diagram (we are notationally suppressing the
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/associators"} associators
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
