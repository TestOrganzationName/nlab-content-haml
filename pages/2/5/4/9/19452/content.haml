            #ClassesOfMorphismsInTheProjectiveModelStructureOnTopEnrichedFunctors.num_defn
              %h6#definition_62 Definition
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small
                (pointed)
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
