              %p
                is a
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                of
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c\in \mathcal{C}
                is any object, then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %munder
                          %mi lim
                          %mo ⟵
                        %mi i
                      %msub
                        %mi F
                        %mi i
                      %mo{:stretchy => "false"} )
