                = succeed ")" do
                  %a.maruku-ref{:href => "#HomotopyCategoryOfSubcategoriesOfModelCategoriesOnGoodObjects"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
