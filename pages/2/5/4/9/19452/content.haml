            .proof
              %h6#proof_77 Proof
              %p
                Given a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi X
                      %mo ⟶
                      %mi F
                    %annotation{:encoding => "application/x-tex"} \eta \colon y(c) \cdot X \longrightarrow F
                consider its component
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi c
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi X
                      %mo ⟶
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\eta_c \;\colon\; \mathcal{C}(c,c)\times X \longrightarrow F(c)
              %p
                and restrict that to the identity morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi id
                        %mi c
                      %mo ∈
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} id_c \in \mathcal{C}(c,c)
                in the first argument
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi c
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mi c
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mo ⟶
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\eta_c(id_c,-) \;\colon\; X \longrightarrow F(c)
                      \\,.
              %p
                We claim that just this
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi c
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mi c
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_c(id_c,-)
                already uniquely determines all components
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi d
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi X
                      %mo ⟶
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\eta_d \;\colon\; \mathcal{C}(c,d)\times X \longrightarrow F(d)
              %p
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi η
                      %annotation{:encoding => "application/x-tex"} \eta
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo ∈
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d \in Obj(\mathcal{C})
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                    %annotation{:encoding => "application/x-tex"} \eta
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#TopologicallyEnrichedFunctor"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %msub
                        %mi η
                        %mi c
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi X
                    %annotation{:encoding => "application/x-tex"}
                      F(-) \circ \eta_c
                      \\;\colon\;
                      \\mathcal{C}(c,d)
                      \\longrightarrow
                      F(d)^{\mathcal{C}(c,c) \times X}
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi d
                      %mo ∘
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\eta_d  \circ \mathcal{C}(c,-) \times X
                      \\;\colon\;
                      \\mathcal{C}(c,d)
                      \\longrightarrow
                      F(d)^{\mathcal{C}(c,c) \times X}
              %p
                agree. This means (remark
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopologicallyEnrichedNaturalTransformationIsTransformationOfUnderlyingFunctors"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
                of this form:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
