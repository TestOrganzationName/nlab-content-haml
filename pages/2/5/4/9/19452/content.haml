                  %a.maruku-ref{:href => "#OverInfinityCohesiveSiteCohesiveInfinityTopos"}
                %a.existingWikiWord{:href => "/nlab/show/elastic+model+topos"} elastic model topos
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#ElasticModelTopos"}
            .proof
              %h6#proof_15 Proof
              %p
                By Example
                %a.maruku-ref{:href => "#QuillenAdjointQuadrupleOfHomotopyKanExtensionAlongAdjointPair"}
                we have a
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+quadruple"} Quillen adjoint quadruple
                for the global
                %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+simplicial+presheaves"} projective model structure on simplicial presheaves
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi 𝒞
                        %mi red
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                      %munderover
                        %mrow
                          %mphantom
                            %mrow
                              %msub
                                %mrow
                                %mi Qu
                          %msub
                            %mo ⊥
                            %mi Qu
                        %mo ⟵
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi ι
                              %mi inf
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{C}^{op}_{red}, sSet_{Qu}]_{proj}
                      \\underoverset
                      {{\longleftarrow}}
                      {\overset{ \iota_{inf} }{\longrightarrow}}
                      {\phantom{{}_{Qu}}\bot_{Qu}}
                      [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi 𝒞
                        %mi red
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi inj
                      %munderover
                        %mrow
                          %mphantom
                            %mrow
                              %msub
                                %mrow
                                %mi Qu
                          %msub
                            %mo ⊥
                            %mi Qu
                        %mo ⟶
                        %mover
                          %mo ⟵
                          %mrow
                            %mi C
                            %mo =
                            %mi L
                            %mo ′
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{C}^{op}_{red}, sSet_{Qu}]_{inj}
                      \\underoverset
                      {{\longrightarrow}}
                      {\overset{C = L'}{\longleftarrow}}
                      {\phantom{{}_{Qu}}\bot_{Qu}}
                      [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi 𝒞
                        %mi red
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi inj
                      %munderover
                        %mrow
                          %mphantom
                            %mrow
                              %msub
                                %mrow
                                %mi Qu
                          %msub
                            %mo ⊥
                            %mi Qu
                        %munder
                          %mo ⟵
                          %mrow
                            %mphantom
                              %mrow
                                %mi A
                                %mo =
                            %mi R
                            %mo ′
                        %mover
                          %mo ⟶
                          %mrow
                            %mi R
                            %mo =
                            %mi C
                            %mo ′
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi inj
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{C}^{op}_{red}, sSet_{Qu}]_{inj}
                      \\underoverset
                      {\underset{\phantom{A=} R'}{\longleftarrow}}
                      {\overset{R = C'}{\longrightarrow}}
                      {\phantom{{}_{Qu}}\bot_{Qu}}
                      [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
              %p
                Here we denote
                %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
                along a functor by the same symbol as that functor, which is consistent by Prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#LeftKanExtensionPreservesRepresentableFunctors"}
              %p
                By Prop.
                %a.maruku-ref{:href => "#SimplicialPresheavesIsProperCombinatorialSimplicial"}
                all
                %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                appearing here are
                %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
                %a.maruku-ref{:href => "#BousfieldLocalizationOfModelCategories"}
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
                retains the
                %a.existingWikiWord{:href => "/nlab/show/class"} class
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                %a.maruku-ref{:href => "#RecognitionOfSimplicialQuillenAdjunction"}
                says that to see that this is also a
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+quadruple"} Quillen adjoint quadruple
                for the
                %a.existingWikiWord{:href => "/nlab/show/local+model+structure+on+simplicial+presheaves"} local model structure on simplicial presheaves
                (Prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopologicalLocalization"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                preserves
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
                %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#DerivedLocalObjects"}
              %p
                For each
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
                here this means to consider any
                %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mover
                        %mo →
                        %mrow
                      %mi X
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \overset{}{\to} X\}
                (either in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi red
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{red}
                or in
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(\{U_i\})
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CechNerve"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}
                in the global projective/injective
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi R
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi R
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      [X, R\mathbf{X}] \longrightarrow [ C(\{U_i\}), R\mathbf{X} ]
              %p
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
                = succeed "," do
                  %a.maruku-ref{:href => "#DerivedHomFunctorPOnSimplicialModelCategory"}
                %a.existingWikiWord{:href => "/nlab/show/sites"} sites
                are assumed to be
                %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-cohesive+sites"} ∞-cohesive sites
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#InfinityCohesiveSite"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(\{U_i\})
                is projectively cofibrant, and hence also injectively cofibrant, by Prop.
                = succeed "." do
                  %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
              %p
                Now by the
                = succeed "-isomorphism" do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+adjunction"} enriched adjunction
                %a.maruku-eqref{:href => "#eq:EnrichedAdjunctionIsomorphism"} (47)
                this means equivalently that
              #eq:LocalityForInfinityCohesiveSite.maruku-equation
                %span.maruku-eq-number (111)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi L
                      %mi X
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %mo{:stretchy => "false"} [
                      %mi L
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      [L X, \mathbf{X}] \longrightarrow [ L C(\{U_i\}), \mathbf{X} ]
              %p is a weak equivalence. This we now check in each of the three cases:
              %p
                For the case
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ι
                        %mi inf
                      %mo ⊣
                      %msub
                        %mi Π
                        %mi inf
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\iota_{inf} \dashv \Pi_{inf})
                we have that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi inf
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi ι
                        %mi inf
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\iota_{inf} C(\{U_i\}) \simeq C(\{\iota_{inf} U_i\})
              %p
                by the assumption that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi inf
                    %annotation{:encoding => "application/x-tex"} \iota_{inf}
                preserves fiber products of
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                %a.existingWikiWord{:href => "/nlab/show/images"} images
                of morphisms in a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi inf
                    %annotation{:encoding => "application/x-tex"} \iota_{inf}
                preserves
                = succeed "-families," do
                  %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi ι
                        %mi inf
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(\{\iota_{inf} U_i\})
                is itself the
                %a.existingWikiWord{:href => "/nlab/show/Cech+nerve"} Cech nerve
                of a covering family, and hence
                %a.maruku-eqref{:href => "#eq:LocalityForInfinityCohesiveSite"} (111)
                is a weak equivalence since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}
                is assumed to be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
              %p
                The same argument directly applies also to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Π
                          %mi inf
                        %mo ⊣
                        %msub
                          %mi Disc
                          %mi inf
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\Pi_{inf} \dashv Disc_{inf})
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mi inf
                    %annotation{:encoding => "application/x-tex"} \Pi_{inf}
                for fiber products follows already from the fact that this is a
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                (since
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/right+adjoints+preserve+limits"} right adjoints preserve limits
                = succeed ")." do
                  %a.maruku-ref{:href => "#AdjointsPreserveCoLimits"}
              %p
                In the same way, for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Disc
                        %mi inf
                      %mo ⊣
                      %msub
                        %mi Γ
                        %mi inf
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Disc_{inf} \dashv \Gamma_{inf})
                we need to check that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi Disc
                        %mi inf
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi Disc
                        %mi inf
                      %mi X
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [ C(\{Disc_{inf}U_i\}) \to Disc_{inf} X, \mathbf{X} ]
                is a weak equivalence. Now
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Disc
                        %mi inf
                    %annotation{:encoding => "application/x-tex"} Disc_{inf}
                is no longer a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/left+Kan+extension"} left Kan extension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Disc
                        %mi inf
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi Disc
                        %mi inf
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Disc_{inf}(U_i) \to Disc_{inf}(X)
                is no longer a morphism of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/representable+presheaves"} representable presheaves
                %a.maruku-eqref{:href => "#eq:LiftingOfCoversThroughPiInfInElasticSite"} (110)
                on an
                = succeed "-elastic" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Pi
                        %mi inf
                      %mo ⊣
                      %msub
                        %mi Disc
                        %mi inf
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Pi_{inf} \dashv Disc_{inf})
                that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Disc
                        %mi inf
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi Disc
                        %mi inf
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Disc_{inf}(U_i) \to Disc_{inf}(X)
                is a
                %a.existingWikiWord{:href => "/nlab/show/local+epimorphism"} local epimorphism
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#LocalEpimorphism"}
                %a.maruku-ref{:href => "#CechNerveProjectionOfLocalEpimorphismIsLocalWeakEquivalence"}
                implies that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi Disc
                        %mi inf
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msub
                        %mi Disc
                        %mi inf
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      C(\{Disc_{inf} U_i\}) \to Disc_{inf} X
              %p
                is a weak equivalence. With this, the fact (Prop.
                %a.maruku-ref{:href => "#SimplicialPresheavesIsProperCombinatorialSimplicial"}
                with Prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ExistenceOfLeftBousfieldLocalization"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi inj
                          %mo ,
                          %mi loc
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, sSet_{Qu}]_{inj, loc}
                is a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
                (Def.
