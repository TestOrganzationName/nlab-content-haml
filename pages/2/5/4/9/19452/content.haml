                      %msub
                        %mi X
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} X_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
