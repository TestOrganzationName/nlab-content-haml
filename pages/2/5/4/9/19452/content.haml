                          %mtd
                          %mtd
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mi topological
                              %mrow
                                %mi spaces
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mfrac{:linethickness => "0"}
