                = succeed "," do
                  %a.maruku-ref{:href => "#TopEnrichedCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{cg}]
                for its category of topologically enriched (co-)presheaves, and for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c\in Obj(\mathcal{C})
                write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi Top
                        %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} y(c) = \mathcal{C}(c,-) \in [\mathcal{C}, Top_k]
                for the topologically enriched functor that it represents, all according to example
                = succeed "." do
                  %a.maruku-ref{:href => "#TopologicallyEnrichedFunctorsToTopk"}
                %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
                operation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
