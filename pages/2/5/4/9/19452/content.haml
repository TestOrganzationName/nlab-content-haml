              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Now that we have seen
              %a.existingWikiWord{:href => "/nlab/show/monoidal+categories"} monoidal categories
              with various extra
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/properties"} properties
              %a.existingWikiWord{:href => "/nlab/show/functors"} functors
              which preserve these:
            #LaxMonoidalFunctor.num_defn
              %h6#definition_5 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+functors"}> monoidal functors
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
