                which are cofibrant in the projective model structure (theorem
                = succeed ")" do
                  %a.maruku-ref{:href => "#ProjectiveModelStructureOnTopologicalFunctors"}
              %ol
                %li
                  %p
                    all component morphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi f
                            %mi i
                        %annotation{:encoding => "application/x-tex"} f_i
                    are cofibrations in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
