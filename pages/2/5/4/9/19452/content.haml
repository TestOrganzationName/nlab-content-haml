                      \\Big\downarrow{}^{ \mathrlap{ id } }
                      \\\
                      [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                      \&amp;\underset{id}{\longrightarrow}&amp;
                      [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                      }
              %p
                Moreover, the
                %a.existingWikiWord{:href => "/nlab/show/derived+natural+transformation"} derived natural transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi id
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(id)
                (Prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#HomotopyDoublePseudofunctor"}
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mi const
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                      %mi const
                      %mi X
                      %mo ⟶
                      %mi P
                      %mi const
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      Q const X
                      \\overset{}{\longrightarrow}
                      const X
                      \\longrightarrow
                      P const X
              %p
                is a
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                (by Prop.
                = succeed ")," do
                  %a.maruku-ref{:href => "#DerivedNaturalTransformationUpToIsos"}
              %p
                Therefore we have a
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#QuillenAdjointTriple"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                      %munderover
                        %mrow
                          %mphantom
                            %mrow
                              %msub
                                %mrow
                                %mi Qu
                          %msub
                            %mo ⊥
                            %mi Qu
                        %mo ⟵
                        %mover
                          %mo ⟶
                          %munder
                            %mi lim
                            %mo ⟶
                      %msub
                        %mi sSet
                        %mi Qu
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{C}^{op}, sSet_{Qu}]_{proj}
                      \\underoverset
                      {{\longleftarrow}}
                      {\overset{ \underset{\longrightarrow}{\lim} }{\longrightarrow}}
                      {\phantom{{}_{Qu}}\bot_{Qu} }
                      sSet_{Qu}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
