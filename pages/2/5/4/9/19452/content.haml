                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of the coproduct, this is equivalent to a lift
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℓ
                        %mi s
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                    %annotation{:encoding => "application/x-tex"} (\ell_s)_{s\in S}
                in the original square
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi s
                                  %mo ∈
                                  %mi S
                              %msub
                                %mi A
                                %mi s
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %msup
