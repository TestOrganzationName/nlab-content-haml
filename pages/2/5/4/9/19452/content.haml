                              %mi R
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      id_{L(c)}
                      \\in
                      \&amp;
                      Hom_{\mathcal{D}}(L(c), L(c))
                      \&amp;\underoverset{\simeq}{\widetilde{(-)}}{\longrightarrow}&amp;
                      Hom_{\mathcal{C}}(c, R(L(c)))
                      \\\
