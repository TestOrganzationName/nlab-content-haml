            .proof
              %h6#proof_4 Proof
              %p
                For the first statement, consider the
                %a.existingWikiWord{:href => "/nlab/show/naturality+square"} naturality square
                %a.maruku-eqref{:href => "#eq:NaturalitySquareForAdjointnessOfFunctors"} (11)
                in the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mrow
                                  %mi L
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo{:stretchy => "false"} )
                              %mo ∈
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒟
                              %mo{:stretchy => "false"} (
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi c
                              %mo{:stretchy => "false"} )
