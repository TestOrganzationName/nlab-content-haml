                                  %mo ⊗
                                  %mi N
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mrow
                                      %mi e
                                      %mo ⊗
                                      %mi id
                                %mtd
                                  %mi A
                                  %mo ⊗
                                  %mi N
                              %mtr
                                %mtd
                                %mtd
                                  %msub
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mi ℓ
                                  %mo ↘
                                %mtd
                                  %msup
                                    %mo{:stretchy => "false"} ↓
                                    %mpadded{:width => "0"}
                                      %mi ρ
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi N
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          1 \otimes N
                          \&amp;\overset{e \otimes id}{\longrightarrow}&amp;
                          A \otimes N
                          \\\
                          \&amp; {}_{\mathllap{\ell}}\searrow
                          \&amp; \downarrow^{\mathrlap{\rho}}
                          \\\
                          \&amp;&amp; N
                          }
                          \\,,
                  %p
                    where
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℓ
                        %annotation{:encoding => "application/x-tex"} \ell
                    is the left unitor isomorphism of
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %li
                  %p
                    (action property) the following
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
