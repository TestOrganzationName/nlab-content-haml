                    %annotation{:encoding => "application/x-tex"} [\mathbb{N}^{\leq}, (Top_{cg})_{Quillen}]_{proj}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi ℕ
                        %mo ≤
                      %mo ,
