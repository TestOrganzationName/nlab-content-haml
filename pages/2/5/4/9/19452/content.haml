                                %mn 34
                              %mo ∘
                              %msub
                                %mi f
                                %mn 23
                              %mo{:stretchy => "false"} )
                              %mo ∘
                              %msub
                                %mi f
                                %mn 12
                          %msub
                            %mi X
                            %mn 4
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          X_1 \overset{f_{34} \circ (f_{23} \circ f_{12})}{\longrightarrow} X_4
                          \\;\;=\;\;
                          X_1 \overset{(f_{34} \circ f_{23}) \circ f_{12}}{\longrightarrow} X_4
                          \\,.
            %p
              The archetypical example of a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              is the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
            #CategoryOfSets.num_example
              %h6#example Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Set"}> category of all sets
                  )
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/class"} class
                of all
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                with
                %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                between them is a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Categories"}
                = succeed ":" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi Obj
                            %mi Set
                          %mo =
                          %mtext class of all sets
                        %annotation{:encoding => "application/x-tex"} Obj_{Set} = \text{class of all sets}
                    ;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi Set
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mtext set of functions from set X to set Y
                        %annotation{:encoding => "application/x-tex"} Hom_{Set}(X,Y) = \text{set of functions from set X to set Y}
                    ;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi id
                            %mi X
