                    %annotation{:encoding => "application/x-tex"} (P Q g)\circ (P Q f)
                is a lift of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∘
                      %mi f
