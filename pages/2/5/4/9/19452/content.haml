                      %mo ,
                      %msub
                        %mo ⊗
                        %mi 𝒞
                      %mo ,
                      %msub
                        %mn 1
                        %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathcal{C},\otimes_{\mathcal{C}}, 1_{\mathcal{C}})
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
