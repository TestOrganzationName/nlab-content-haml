                makes sense also when
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    is not
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/small+category"} small
                %li
                  %p and/or when a (co-)limiting cone exists only for some but not for all functors of this form.
            #TerminalObjectIsEmptyLimit.num_example
              %h6#example Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"}> terminal
                  \/
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  is
                  %a.existingWikiWord{:href => "/nlab/show/empty+category"} empty
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category"} category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \ast \in \mathcal{C}
                be an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    (Def.
                    = succeed ");" do
                      %a.maruku-ref{:href => "#InitialObject"}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                    of
                    %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                    %a.existingWikiWord{:href => "/nlab/show/empty+category"} empty
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              %p
                And
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
                (example
                = succeed "):" do
                  %a.maruku-ref{:href => "#OppositeCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \emptyset \in \mathcal{C}
                be an object. The following are equivalent:
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \emptyset
                    is an
                    %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    (Def.
                    = succeed ");" do
                      %a.maruku-ref{:href => "#InitialObject"}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \emptyset
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                    of
                    %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                    %a.existingWikiWord{:href => "/nlab/show/empty+category"} empty
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            .proof
              %h6#proof Proof
              %p
                We discuss the case of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#OppositeCategory"}
              %p
                It suffices to observe that a
                %a.existingWikiWord{:href => "/nlab/show/cone"} cone
                over the
                %a.existingWikiWord{:href => "/nlab/show/empty+category"} empty
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                (Remark
                = succeed ")" do
                  %a.maruku-ref{:href => "#LimitingCones"}
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
