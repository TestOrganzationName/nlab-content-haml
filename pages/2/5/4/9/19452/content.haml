                                %mi c
                                %mo{:stretchy => "false"} )
                                %mo ⋅
                                %mstyle{:mathvariant => "bold"}
                                  %mi X
                                %mo{:stretchy => "false"} (
                                %mi c
                                %mo{:stretchy => "false"} )
                                %mo )
