                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      F^\ast \mathbf{X}
                      \\;\coloneqq\;
                      \\mathbf{X}(F(-))
              %p
                is the operation of precomposition with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi F
                        %mo *
                    %annotation{:encoding => "application/x-tex"} F^\ast
                preserves all objectwise cofibrations/fibrations/weak equivalences in the
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
                (Prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
              %ol
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functor"} right Quillen functor
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#QuillenAdjunction"}
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} [
