                                  %mo ,
                                  %mi i
                          %msub
                            %mi U
                            %mi i
                        %annotation{:encoding => "application/x-tex"} V_j \overset{\iota_{j,i}}{\to} U_i
                    such that
                  #eq:ConditionOnCoverage.maruku-equation
                    %span.maruku-eq-number (69)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ∘
                          %msub
                            %mi ι
                            %mi j
                          %mspace{:width => "thickmathspace"}
                          %mo =
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi ι
                            %mi i
                          %mo ∘
                          %msub
                            %mi ι
                            %mrow
                              %mi j
                              %mo ,
                              %mi i
                          %mphantom
                            %mi AAAAAAA
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mi V
                                    %mi j
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mrow
                                      %msub
                                        %mi ι
                                        %mrow
                                          %mi j
                                          %mo ,
                                          %mi i
                                %mtd
                                  %msub
                                    %mi U
                                    %mi i
                              %mtr
                                %mtd
                                  %msup
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mrow
                                        %msub
                                          %mi ι
                                          %mi j
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                                %mtd
                                %mtd
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                                  %msup
                                    %mrow
                                    %mpadded{:width => "0"}
                                      %mrow
                                        %msub
                                          %mi ι
                                          %mi i
                              %mtr
                                %mtd
                                  %mi Y
                                %mtd
                                  %munder
                                    %mo ⟶
                                    %mi f
                                %mtd
                                  %mi X
                        %annotation{:encoding => "application/x-tex"}
                          f \circ \iota_j
                          \\;=\;
                          \\iota_i \circ \iota_{j,i}
                          \\phantom{AAAAAAA}
                          \\array{
                          V_j
                          \&amp;\overset{\iota_{j,i}}{\longrightarrow}&amp;
                          U_i
                          \\\
                          {}^{\mathllap{ \iota_j }}\big\downarrow
                          \&amp;&amp;
                          \\big\downarrow{}^{\mathrlap{ \iota_i}}
                          \\\
                          Y &amp;\underset{f}{\longrightarrow}&amp; X
                          }
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                equipped with a
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                is called a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/site"} site
            #CanonicalCoverageOnTopologicalSpaces.num_example
              %h6#example Example
              %p
                %strong
                  (canonical
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                  on
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                of (small)
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#ExamplesOfConcreteCategories"}
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
                %a.existingWikiWord{:href => "/nlab/show/coverings"} coverings
                are the usal
                %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
                of topological spaces.
              %p
                The condition
                %a.maruku-eqref{:href => "#eq:ConditionOnCoverage"} (69)
                on a coverage is met, since the
                %a.existingWikiWord{:href => "/nlab/show/preimages"} preimages
                of
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                under a
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                are again
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/domain"} domain
                = succeed "-condition" do
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                %a.maruku-eqref{:href => "#eq:ConditionOnCoverage"} (69)
                is immediage.
              %p
                Similarly, for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} X \in Top
                a fixed topological space, there is the
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Op(X)
                whose underlying
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                is the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/category+of+opens"} category of opens
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/thin+category"} thin category
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#PartiallyOrderedSetsAsSmallCategories"}
                %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                and subset inclusions, and whose
                %a.existingWikiWord{:href => "/nlab/show/coverings"} coverings
                are again the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
            #DifferentiablyGoodOpenCoversOfSmoothManifolds.num_example
              %h6#example_2 Example
              %p
                %strong
                  (differentiably
                  %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %a.existingWikiWord{:href => "/nlab/show/SmthMfd"} SmthMfd
                of
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#ExamplesOfConcreteCategories"}
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Coverage"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi SmthMfd
                    %annotation{:encoding => "application/x-tex"} X \in SmthMfd
                any
                %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
                of
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} D \in \mathbb{N}
                %a.existingWikiWord{:href => "/nlab/show/coverings"} coverings
                are collections of
                %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
                from the
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi D
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^D
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                whose
                %a.existingWikiWord{:href => "/nlab/show/image"} image
                is the inclusion of an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              %p
                Hence these are the usual
                %em
                  %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
                to a Cartesian space (hence to a smooth
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/open+ball"} open ball
              %p
                One may further constrain this and ask that also all the non-empty finite
                %a.existingWikiWord{:href => "/nlab/show/intersections"} intersections
                of these open balls are
                %a.existingWikiWord{:href => "/nlab/show/diffeomorphism"} diffeomorphic
                to open balls. These are the
                = succeed "." do
                  %em
                    differentiably
                    %a.existingWikiWord{:href => "/nlab/show/good+open+covers"} good open covers
              %p
                To see that these coverings satisfy the condition
                = succeed ":" do
                  %a.maruku-eqref{:href => "#eq:ConditionOnCoverage"} (69)
                %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
                along any continuous function is again an open cover, just not necessarily by patches diffeomorphic to open balls. But every open cover may be
                %em refined
                by one that is (see at
                = succeed ")," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/good+open+cover"} good open cover
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:ConditionOnCoverage"} (69)
            %p
              Example
              %a.maruku-ref{:href => "#DifferentiablyGoodOpenCoversOfSmoothManifolds"}
              is further developed in the chapters
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+sets"} smooth sets
              and
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+homotopy+types"} on smooth homotopy types
            #CompatibleElements.num_defn
              %h6#definition_2 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/matching+family"} matching family
                  –
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/descent+object"} descent object
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                equipped with a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
                %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y} \in [\mathcal{C}^{op}, Set]
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryOfPresheaves"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %p
                Given an
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                and a
                %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo {
                          %msub
                            %mi U
                            %mi i
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ι
                                %mi i
                          %mi X
                          %mo }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \left\{ U_i \overset{\iota_i}{\to} X \right\}_{i \in I}
                of it (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/matching+family"} matching family
                (of probes of
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                      %annotation{:encoding => "application/x-tex"} \mathbf{Y}
                %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ϕ
                        %mi i
                      %mo ∈
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} (\phi_i \in \mathbf{Y}(U_i))_{i \in I}
                such that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                      %mo ∈
                      %mi I
                    %annotation{:encoding => "application/x-tex"} i,j \in I
                and
                %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                of
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi κ
                            %mi i
                      %mi V
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi κ
                            %mi j
                      %msub
                        %mi U
                        %mi j
                    %annotation{:encoding => "application/x-tex"} U_i \overset{\kappa_i}{\leftarrow} V \overset{\kappa_j}{\to} U_j
                satisfying
              #eq:MatchingCondition.maruku-equation
                %span.maruku-eq-number (70)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ι
                        %mi i
                      %mo ∘
                      %msub
                        %mi κ
                        %mi i
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi ι
                        %mi j
                      %mo ∘
                      %msub
                        %mi κ
                        %mi j
                      %mphantom
                        %mi AAAAAAAA
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi V
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi κ
                                      %mi i
                              %mo ↙
                            %mtd
                            %mtd
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi κ
                                      %mi j
                          %mtr
                            %mtd
                              %msub
                                %mi U
                                %mi i
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msub
                                %mi U
                                %mi j
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi ι
                                      %mi i
                              %mo ↘
                            %mtd
                            %mtd
                              %msub
                                %mo ↙
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi ι
                                      %mi j
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                    %annotation{:encoding => "application/x-tex"}
                      \\iota_i \circ \kappa_i
                      \\;=\;
                      \\iota_j \circ \kappa_j
                      \\phantom{AAAAAAAA}
                      \\array{
                      \&amp;&amp; V
                      \\\
                      \&amp; {}^{\mathllap{\kappa_i}}\swarrow &amp;&amp; \searrow^{\mathrlap{\kappa_j}}
                      \\\
                      U_i &amp;&amp; &amp;&amp; U_j
                      \\\
                      \&amp; {}_{\mathllap{\iota_i}}\searrow &amp;&amp; \swarrow_{\mathrlap{\iota_j}}
                      \\\
                      \&amp;&amp; X
                      }
              %p we have
              #eq:GluingCondition.maruku-equation
                %span.maruku-eq-number (71)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi κ
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ϕ
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi κ
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ϕ
                        %mi j
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{Y}(\kappa_i)(\phi_i)
                      \\;=\;
                      \\mathbf{Y}(\kappa_j)(\phi_j)
                      \\,.
              %p We write
              #eq:SetOfMatching.maruku-equation
                %span.maruku-eq-number (72)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Match
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo ⊂
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi i
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi Set
                    %annotation{:encoding => "application/x-tex"}
                      Match\big(
                      \\{U_i\}_{i \in I}
                      \\,,\,
                      \\mathbf{Y}
                      \\big)
                      \\subset
                      \\underset{i}{\prod} \mathbf{Y}(U_i)
                      \\;\in\;
                      Set
              %p
                for the set of
                %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
                for the given presheaf and covering.
              %p
                This is also called the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/descent+object"} descent object
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y}
                for
                %em
                  %a.existingWikiWord{:href => "/nlab/show/descent"} descent
                along the
                %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ι
                              %mi i
                        %mi X
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} \{U_i \overset{\iota_i}{\to}X\}
            #MatchingFamiliesThatGlue.num_example
              %h6#example_3 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
                  that glue)
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                equipped with a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
                %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y} \in [\mathcal{C}^{op}, Set]
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryOfPresheaves"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %p
                Given an
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                and a
                %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo {
                          %msub
                            %mi U
                            %mi i
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ι
                                %mi i
                          %mi X
                          %mo }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \left\{ U_i \overset{\iota_i}{\to} X \right\}_{i \in I}
                of it (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Coverage"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\phi \;\in\; \mathbf{Y}(X)
              %p
                induces a
                %a.existingWikiWord{:href => "/nlab/show/matching+family"} matching family
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CompatibleElements"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ι
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\big( \mathbf{Y}(\iota_i)(\phi)  \big)_{i \in I}
                      \\,.
              %p
                (That this indeed satisfies the matching condition follows immediately by the
                %a.existingWikiWord{:href => "/nlab/show/functor"} functoriality
                of
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                      %annotation{:encoding => "application/x-tex"} \mathbf{Y}
              %p
                This construction provides a
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                of the form
              #eq:SheafComparison.maruku-equation
                %span.maruku-eq-number (73)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi Match
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{Y}(X)
                      \\longrightarrow
                      Match\big(
                      \\{U_i\}_{i \in I}
                      \\,,\,
                      \\mathbf{Y}
                      \\big)
              %p
                The matching families in the image of this function are hence those
                %a.existingWikiWord{:href => "/nlab/show/tuples"} tuples
                of probes of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y}
                by the patches
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                which
                %em glue
                to a global probe out of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            #Sheaf.num_defn
              %h6#definition_3 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                equipped with a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
                %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y} \in [\mathcal{C}^{op}, Set]
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryOfPresheaves"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %p
                The presheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} \mathbf{Y}
                is called a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
                if for every
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                and every
                %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo {
                          %msub
                            %mi U
                            %mi i
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi ι
                                %mi i
                          %mi X
                          %mo }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \left\{ U_i \overset{\iota_i}{\to} X \right\}_{i \in I}
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %em
                    all
                    %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
                    glue uniquely
                %a.maruku-eqref{:href => "#eq:SheafComparison"} (73)
                is a
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              #eq:SheafCondition.maruku-equation
                %span.maruku-eq-number (74)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mo ≃
                      %mi Match
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{Y}(X)
                      \\overset{\simeq}{\longrightarrow}
                      Match\big(
                      \\{U_i\}_{i \in I}
                      \\,,\,
                      \\mathbf{Y}
                      \\big)
                      \\,.
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#FullSubcategoryOnClassOfObjects"}
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                over a given
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
              #eq:FullSubcategoryOfSheaves.maruku-equation
                %span.maruku-eq-number (75)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Sh(\mathcal{C})
                      \\overset{\phantom{AA} \iota \phantom{AA}}{\hookrightarrow}
                      [\mathcal{C}^{op}, Set]
                      \\,.
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                which is
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EquivalenceOfCategories"}
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                is called a
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/topos"} topos
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}_2
                two such sheaf toposes, a
                %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mn 1
                      %mo →
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f \;\colon\; \mathbf{H}_1 \to \mathbf{H}_2
                between them, called a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
                is an
                %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
                of
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
              #eq:GeometricMorphism.maruku-equation
                %span.maruku-eq-number (76)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mn 1
                      %munderover
                        %mrow
                        %munder
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %msub
                              %mi f
                              %mo *
                            %mphantom
                              %mi AA
                        %mover
                          %mo ⟵
                          %mrow
                            %mphantom
                              %mi AA
                            %msup
                              %mi f
                              %mo *
                            %mphantom
                              %mi AA
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mi H
                        %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{H}_1
                      \\underoverset
                      {\underset{ \phantom{AA} f_\ast \phantom{AA} }{\longrightarrow}}
                      \\overset{ \phantom{AA} f^\ast \phantom{AA} }{\longleftarrow}
                      {}
                      \\mathbf{H}_2
              %p such that
              %ul
                %li
                  the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi f
                            %mo *
                        %annotation{:encoding => "application/x-tex"} f^\ast
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/inverse+image"} inverse image
                  %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
              %p
                Hence there is a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are
                %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
                and whose
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
            #GlobalSectionsGeometricMorphism.num_example
              %h6#example_4 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/global+sections"} global sections
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \mathbf{H}
                be a
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#Sheaf"}
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
                %a.maruku-eqref{:href => "#eq:GeometricMorphism"} (76)
                to the
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                (Example
                = succeed ")," do
                  %a.maruku-ref{:href => "#CategoryOfSets"}
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                (Def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#NaturalTransformations"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi H
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ⟶
                          %mrow
                            %mphantom
                              %mi AA
                            %mi Γ
                            %mphantom
                              %mi AA
                        %mover
                          %mo ↩
                          %mi L
                      %mi Set
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{H}
                      \\underoverset
                      {\underset{\phantom{AA}\Gamma\phantom{AA}}{\longrightarrow}}
                      {\overset{L}{\hookleftarrow}}
                      {\bot}
                      Set
                      \\,.
              %p
                Here
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                is called
                %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/global+sections"}> global sections
                    \-
                    %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .proof
              %h6#proof Proof
              %p
                Notice that every
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mo ∈
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} S \in Set
                is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo ∈
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} \ast \in Set
                (
                %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                = succeed "):" do
                  %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      S \;\simeq\; \underset{s \in S}{\coprod} \ast
                      \\,.
              %p
                Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                this
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                (Prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#AdjointsPreserveCoLimits"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is assumed to preserve
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                is the empty
                %a.existingWikiWord{:href => "/nlab/show/product"} product
                (Example
                = succeed ")," do
                  %a.maruku-ref{:href => "#TerminalObjectIsEmptyLimit"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is fixed, up to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                              %mi L
                              %mrow
                                %mo (
                                %munder
                                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                  %mrow
                                    %mi s
                                    %mo ∈
                                    %mi S
                                %mo *
                                %mo )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mrow
                                  %mi s
                                  %mo ∈
                                  %mi S
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mrow
                                  %mi s
                                  %mo ∈
                                  %mi S
                              %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      L(S)
                      \&amp; \simeq
                      L \left( \underset{s \in S}{\coprod} \ast  \right)
                      \\\
                      \&amp; \simeq
                      \\underset{s \in S}{\coprod} L(\ast)
                      \\\
                      \&amp; \simeq
                      \\underset{s \in S}{\coprod} \ast
                      }
                      \\,.
              %p
                This shows that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                exists and uniquely so, up to natural isomorphism. This implies the essential uniqueness of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                by uniqueness of adjoints (Prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#UniquenessOfAdjoints"}
            #TrivialCoverage.num_example
              %h6#example_5 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/trivial+coverage"}> trivial coverage
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#SmallCategory"}
                %em trivial coverage
                on it is the
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
                %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                families at all, meaning that the
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf condition
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Sheaf"}
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                is empty, in that
                %em every
                %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
                is a
                %a.existingWikiWord{:href => "/nlab/show/sheaf"} sheaf
                for this coverage.
              %p
                Hence the
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op},Set]
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryOfPresheaves"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi triv
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{triv}
                with trivial coverage is already the corresponding
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mrow
                        %mo (
                        %msub
                          %mi 𝒞
                          %mi triv
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Sh\left( \mathcal{C}_{triv}\right)
                      \\;\simeq\;
                      [\mathcal{C}^{op}, Set]
                      \\,.
            .num_example
              %h6#example_6 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
                  on the
                  %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                  are plain
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/sets"} sets
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#InitialCategoryAndTerminalCategory"}
                %a.existingWikiWord{:href => "/nlab/show/trivial+coverage"} trivial coverage
                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#TrivialCoverage"}
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EquivalenceOfCategories"}
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                on this
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Sheaf"}
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                (Example
                = succeed "):" do
                  %a.maruku-ref{:href => "#CategoryOfSets"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mi Set
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Sh(\ast) \;\simeq\; Set
                      \\,.
              %p
                Hence the
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
            #SheafOnATopologicalSpace.num_example
              %h6#example_7 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/sheaves+on+a+topological+space"} sheaves on a topological space
                  –
                  %a.existingWikiWord{:href => "/nlab/show/spatial+topos"} spatial
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/petit+toposes"} petit toposes
              %p
                In the literature, the concept of (pre-)sheaf (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Sheaf"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/site"} site
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %a.existingWikiWord{:href => "/nlab/show/category+of+open+subsets"} category of open subsets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Op(X)
                from Example
                = succeed "," do
                  %a.maruku-ref{:href => "#CanonicalCoverageOnTopologicalSpaces"}
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                given by the usual
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
                = succeed "\u201D" do
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+on+a+topological+space"} sheaf on this topological space
                = succeed "," do
                  %a.maruku-ref{:href => "#Sheaf"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ↪
                        %mphantom
                          %mi AA
                      %mo{:stretchy => "false"} [
                      %mi Op
                      %mo{:stretchy => "false"} (
                      %mi X
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      Sh(X)
                      \\;\coloneqq\;
                      Sh(Op(X))
                      \\overset{\phantom{AA}}{\hookrightarrow}
                      [Op(X)^{op}, Set]
                      \\,,
              %p
                for short. The
                %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
                arising this way are also called
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/spatial+toposes"} spatial toposes
            #LocalicReflection.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/localic+reflection"}> localic reflection
                  )
              %p
                The construction of
                %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves+on+a+topological+space"} categories of sheaves on a topological space
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#SheafOnATopologicalSpace"}
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                from the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                of
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                and
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                between them (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#ExamplesOfConcreteCategories"}
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
                of
                %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes"} sheaf toposes
                and
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphisms"} geometric morphisms
                between them (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#SheafOnATopologicalSpace"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Top
                      %mo ⟶
                      %mi Topos
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Sh(-)
                      \\;\colon\;
                      Top \longrightarrow Topos
                      \\,.
              %p
                Moreover, when restricted to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
                = succeed "-inclusion" do
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                = succeed ")" do
                  %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi SoberTop
                      %mover
                        %mo ↪
                        %mphantom
                          %mi AAA
                      %mi Topos
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Sh(-)
                      \\;\colon\;
                      SoberTop \overset{\phantom{AAA}}{\hookrightarrow} Topos
                      \\,.
              %p
                More generally, this holds for
                %em
                  %a.existingWikiWord{:href => "/nlab/show/locales"} locales
                (i.e. for “
                %a.existingWikiWord{:href => "/nlab/show/sober+topological+spaces"} sober topological spaces
                not necessarily supported on points”), in which case it becomes a
                = succeed "-inclusion" do
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                = succeed ")" do
                  %a.maruku-ref{:href => "#ReflectiveSubcategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Locale
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ↪
                          %mrow
                            %mphantom
                              %mi AA
                            %mi Sh
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                            %mphantom
                              %mi AA
                        %mover
                          %mo ⟵
                          %mphantom
                            %mi AAAA
                      %mi Topos
                    %annotation{:encoding => "application/x-tex"}
                      Locale
                      \\underoverset
                      {\underset{\phantom{AA} Sh(-) \phantom{AA} }{\hookrightarrow}}
                      {\overset{\phantom{AAAA}}{\longleftarrow}}
                      {\bot}
                      Topos
              %p
                This says that
                %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves+on+topological+spaces"} categories of sheaves on topological spaces
                are but a reflection of soper topological spaces (generally: locales) and nothing more, whence they are also called
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/petit+toposes"} petit toposes
            #AbelianSheaves.num_example
              %h6#example_8 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/abelian+sheaves"}> abelian sheaves
                  )
              %p
                In the literature, sometimes sheaves are understood by default as taking values not in the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/abelian+groups"} abelian groups
                %a.maruku-ref{:href => "#SheafOnATopologicalSpace"}
                this means that some authors really mean “sheaf of abelian groups of the site of opens of a topological space”, when they write just “sheaf”.
              %p
                But for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
                any
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/mathematical+structure"} mathematical structure
                = succeed "-structured" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒮
                      %annotation{:encoding => "application/x-tex"} \mathcal{S}
                = succeed "-structure" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒮
                      %annotation{:encoding => "application/x-tex"} \mathcal{S}
                %a.existingWikiWord{:href => "/nlab/show/internalization"} internal
                to the
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                according to Def.
                = succeed "." do
                  %a.maruku-ref{:href => "#Sheaf"}
                %a.existingWikiWord{:href => "/nlab/show/sheaves+of+abelian+groups"} sheaves of abelian groups
                are equivalently abelian
                %a.existingWikiWord{:href => "/nlab/show/group+objects"} group objects
                in the category of sheaves of sets as discussed here.
            #SmoothSetAnnounced.num_example
              %h6#example_9 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/smooth+sets"}> smooth sets
                  )
              %p
                Consider the
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                %a.existingWikiWord{:href => "/nlab/show/SmthMfd"} SmthMfd
                of
                %em all
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smooth+manifolds"} smooth manifolds
                = succeed "." do
                  %a.maruku-ref{:href => "#DifferentiablyGoodOpenCoversOfSmoothManifolds"}
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                over this (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Sheaf"}
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
                to the category of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/smooth+sets"} smooth sets
                = succeed ":" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+smooth+sets"} geometry of physics – smooth sets
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi SmthMfd
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mi SmoothSet
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Sh(SmthMfd) \;\simeq\; SmoothSet
                      \\,.
              %p
                This is a
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/gros+topos"} gros topos
                %a.maruku-ref{:href => "#CohesiveTopos"}
                below (a
                = succeed ")." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            #OrdinarySpacesAreGeneratorsAndRelationsForGeneralizedSpaces.num_remark
              %h6#remark_3 Remark
              %p
                %strong
                  (ordinary
                  %a.existingWikiWord{:href => "/nlab/show/spaces"} spaces
                  and their
                  %a.existingWikiWord{:href => "/nlab/show/coverings"} coverings
                  are
                  %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generators and relations
                  for
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/generalized+spaces"} generalized spaces
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Coverage"}
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}^{op}, Set]
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#TrivialCoverage"}
                %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
                of the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Prop.
                = succeed ")," do
                  %a.maruku-ref{:href => "#FreeCocompletion"}
                %a.existingWikiWord{:href => "/nlab/show/free+construction"} freely
                forming
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                (“gluing”) of objects of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %p
                In contrast, the
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                inclusion
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C}) \hookrightarrow [\mathcal{C}^{op}, Set]
                enforces
                %em relations
                between these free colimits.
              %p
                Therefore in total we may think of a
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C})
                as obtained by
                %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generators and relations
                from the
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                of its
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %ul
                %li
                  %p
                    the objects of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    are the generators;
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/coverings"} coverings
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    are the relations.
            #Sheafification.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/plus+construction"} plus construction
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#Coverage"}
                = succeed "-inclusion" do
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                %a.maruku-eqref{:href => "#eq:FullSubcategoryOfSheaves"} (75)
                of the
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Sheaf"}
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryOfPresheaves"}
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ↪
                          %mrow
                            %mphantom
                              %mi AA
                            %mi ι
                            %mphantom
                              %mi AA
                        %mover
                          %mo ⟵
                          %mi L
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Sh(\mathcal{C})
                      \\underoverset
                      {\underset{\phantom{AA} \iota \phantom{AA}}{\hookrightarrow}}
                      {\overset{ L }{\longleftarrow}}
                      {\bot}
                      [\mathcal{C}^{op}, Set]
                      \\,.
              %p
                An explicit formula for
                %a.existingWikiWord{:href => "/nlab/show/sheafification"} sheafification
                is given by applying the following “
                %a.existingWikiWord{:href => "/nlab/show/plus+construction"}> plus construction
                ”
                = succeed ":" do
                  %em twice
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                        %mo +
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo +
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      L(\mathbf{Y}) \simeq (\mathbf{Y}^+)^+
                      \\,.
              %p
                Here the
                %a.existingWikiWord{:href => "/nlab/show/plus+construction"} plus construction
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo +
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mo ⟶
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      (-)^+
                      \\;\colon\;
                      [\mathcal{C}^{op}, Set]
                      \\longrightarrow
                      [\mathcal{C}^{op}, Set]
              %p
                is given by forming
                %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                of sets of
                %a.existingWikiWord{:href => "/nlab/show/matching+families"} matching families
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CompatibleElements"}
                %a.existingWikiWord{:href => "/nlab/show/covers"} covers
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mstyle{:mathvariant => "bold"}
                          %mi Y
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo {
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi U
                          %mi i
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi ι
                              %mi i
                        %mi X
                        %mo{:stretchy => "false"} }
                        %mspace{:width => "thickmathspace"}
                        %mtext covering
                        %mspace{:width => "thickmathspace"}
                        %mo ,
                        %mi ϕ
                        %mo ∈
                        %mi Match
                        %mrow
                          %mo (
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi U
                            %mi i
                          %mo{:stretchy => "false"} }
                          %mo ,
                          %mstyle{:mathvariant => "bold"}
                            %mi Y
                          %mo )
                        %mo }
                      %mo{:stretchy => "false"} /
                      %mo ∼
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbf{Y}^+(X)
                      \\;\coloneqq\;
                      \\left\{
                      \\{U_i \overset{\iota_i}{\to} X\}
                      \\; \text{covering}
                      \\;,
                      \\phi \in Match\left( \{U_i\}, \mathbf{Y}  \right)
                      \\right\}/\sim
              %p
                under the
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
                which identifies two such
                %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
                if the two covers have a joint refinement such that the restriction of the two matching families to that joint refinement coincide.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            #InducedCoverage.num_example
              %h6#example_10 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/induced+coverage"}> induced coverage
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#Coverage"}
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %mo ↪
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{D}
                      \\hookrightarrow
                      \\mathcal{C}
              %p
                becomes a
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                itself, whose
                %a.existingWikiWord{:href => "/nlab/show/coverage"} coverage
                consists of those
                %a.existingWikiWord{:href => "/nlab/show/coverings"} coverings
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi ι
                            %mi i
                      %mi Y
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{U_i \overset{\iota_i}{\to} Y\}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                that happen to be in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                        %mo ↪
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{D} \hookrightarrow \mathcal{C}
            #DenseSubsite.num_defn
              %h6#definition_4 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/dense+subsite"}> dense subsite
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                be
                %a.existingWikiWord{:href => "/nlab/show/sites"} sites
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
                = succeed "-inclusion" do
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                = succeed ")" do
                  %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %mo ↪
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{D}
                      \\hookrightarrow
                      \\mathcal{C}
              %p
                and regard
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                as equipped with the
                %a.existingWikiWord{:href => "/nlab/show/induced+coverage"} induced coverage
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#InducedCoverage"}
              %p
                This is called a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/dense+subsite"}> dense subsite
                  \-inclusion
                if every
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                has a
                %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi ι
                            %mi i
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} }
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \{U_i \overset{\iota_i}{\to} X\}_i
                such that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                the patches are in the subcategory:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒟
                      %mo ↪
                      %mi 𝒞
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      U_i \;\in\; \mathcal{D} \hookrightarrow \mathcal{C}
                      \\,.
            #ComparisonLemma.num_prop
              %h6#proposition_3 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/comparison+lemma"}> comparison lemma
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %mover
                        %mo ↪
                        %mi ι
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{D} \overset{\iota}{\hookrightarrow} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/dense+subsite"} dense subsite
                inclusion (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#DenseSubsite"}
                %a.existingWikiWord{:href => "/nlab/show/precomposition"} precomposition
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ι
                    %annotation{:encoding => "application/x-tex"} \iota
                induces an
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EquivalenceOfCategories"}
                %a.existingWikiWord{:href => "/nlab/show/categories+of+sheaves"} categories of sheaves
                (Def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#Sheaf"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ι
                        %mo *
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mo ≃
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒟
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\iota^\ast
                      \\;\colon\;
                      Sh(\mathcal{C})
                      \\overset{\simeq}{\longrightarrow}
                      Sh(\mathcal{D})
            #RecognitionOfEpimorphisms.num_prop
              %h6#proposition_4 Proposition
              %p
                %strong
                  (recognition of
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epi-
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} mono-
                  %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/sheaves"} sheaves
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Coverage"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C})
                its
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#Sheaf"}
              %p
                Then a
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi Y
                    %annotation{:encoding => "application/x-tex"} f \;\colon\; \mathbf{X} \to \mathbf{Y}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(\mathcal{C})
                is
              %ol
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Monomorphism"}
                    %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Isomorphism"}
                    %em globally
                    in that for each object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
