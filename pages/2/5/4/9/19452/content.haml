                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mo *
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          Hom_{\mathcal{C}}(\emptyset,c) \;\simeq\; \ast
                          \\,.
            #SmallCategory.num_defn
              %h6#definition_4 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/small+category"}> small category
                  )
              %p
                If a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Categories"}
                %a.existingWikiWord{:href => "/nlab/show/class"} class
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Obj
                        %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} Obj_{\mathcal{C}}
                of
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                an actual
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                (i.e. a
                %a.existingWikiWord{:href => "/nlab/show/small+set"} small set
                instead of a
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is called a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
            %p As usual, there are some trivial examples, that are however usefully made explicit for the development of the theory:
            #InitialCategoryAndTerminalCategory.num_example
              %h6#example_3 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/initial+category"} initial category
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
              %ol
                %li
                  %p
                    The
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
                    is
                    %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                    %a.existingWikiWord{:href => "/nlab/show/category"} category
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Categories"}
                    %a.existingWikiWord{:href => "/nlab/show/class"} class
                    of
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                    is
                    %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                    %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/set"} set
                    %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                    on this object, necessarily the
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                %li
                  %p
                    The
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/initial+category"} initial category
                    or
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/empty+category"} empty category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ∅
                        %annotation{:encoding => "application/x-tex"} \emptyset
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/category"} category
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Categories"}
                    %a.existingWikiWord{:href => "/nlab/show/class"} class
                    of
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                    is the
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty set
              %p
                Clearly, these are
                %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#SmallCategory"}
            #PartiallyOrderedSetsAsSmallCategories.num_example
              %h6#example_4 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/preordered+sets"} preordered sets
                  as
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/thin+categories"} thin categories
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mo ≤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (S, \leq)
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/preordered+set"} preordered set
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                whose
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                of
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo →
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \to y
                whenever
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ≤
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x \leq y
              #eq:RelationsAsMorphismInPartiallyOrderedSet.maruku-equation
                %span.maruku-eq-number (1)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mover
                        %mo →
                        %mrow
                          %mo ∃
                          %mo !
                      %mi y
                      %mphantom
                        %mi AAA
                      %mtext precisely if
                      %mphantom
                        %mi AAA
                      %mi x
                      %mo ≤
                      %mi y
                    %annotation{:encoding => "application/x-tex"}
                      x \overset{\exists !}{\to} y
                      \\phantom{AAA}
                      \\text{precisely if}
                      \\phantom{AAA}
                      x \leq y
              %p
                Conversely, every
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
