                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi 𝒞
                          %mo ,
                          %msub
                            %mi Top
                            %mi cg
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [\mathcal{C},Top_{cg}]
                    over
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Top
                            %mi cg
                        %annotation{:encoding => "application/x-tex"} Top_{cg}
                    (Def.
                    = succeed ")." do
                      %a.maruku-ref{:href => "#TensoringAndPoweringOfTopologicallyEnrichedCopresheaves"}
                %li
                  %p Define a functor
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi Top
                            %mi cg
                          %msup
                            %mo{:stretchy => "false"} )
                            %mi op
                          %mo ×
                          %mo{:stretchy => "false"} [
                          %mi 𝒞
                          %mo ,
