                              %mi A
                              %mo ⊗
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi μ
                                  %mo ⊗
                                  %mi id
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi A
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
