                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Cof
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msubsup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                                    %mo ∩
                                    %mi Fib
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi p
                                      %mi Y
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\emptyset &amp;\longrightarrow&amp; Q Y
                      \\\
                      {}^{\mathllap{\in Cof}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p_Y}}_{\mathrlap{\in W \cap Fib}}
                      \\\
                      X &amp;\overset{f}{\longrightarrow}&amp; Y
                      }
                      \\,,
              %p
                which says that any morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \to Y
                comes from a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ^
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Q
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \hat f \colon X \to Q Y
                under postcomposition with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Q
                        %mi Y
                        %mover
                          %mo →
                          %mrow
                            %msub
                              %mi p
                              %mi Y
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Q Y \overset{p_Y}{\to} Y
              %p
                Second, that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mi X
                      %mo ,
                      %msub
                        %mi p
                        %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(id_X, p_Y)
                is injective is the lifting property in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                              %mo ⊔
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi f
                                  %mo ,
                                  %mi g
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi Q
                              %mi Y
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Cof
