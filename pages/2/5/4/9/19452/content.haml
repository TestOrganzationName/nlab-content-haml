                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %munder
                        %mo ×
                        %mi B
                      %mi C
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %mi W
                      %mi D
                      %munder
                        %mo ×
                        %mi E
                      %mi F
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      A \underset{B}{\times} C
                      \\overset{\in W}{\longrightarrow}
                      D \underset{E}{\times} F
                      \\,.
            .proof
              %h6#proof_38 Proof
              %p (The reader should draw the 3-dimensional cube diagram which we describe in words now.)
              %p
                First consider the universal morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi E
                      %munder
                        %mo ×
                        %mi F
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C \to E \underset{F}{\times} C
                and observe that it is a weak equivalence by
                %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right properness
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#RightProperModelCategory"}
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#CategoryWithWeakEquivalences"}
              %p
                Then consider the universal morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %munder
                        %mo ×
                        %mi B
                      %mi C
                      %mo →
                      %mi A
                      %munder
                        %mo ×
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi E
                      %munder
                        %mo ×
                        %mi F
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \underset{B}{\times}C \to A \underset{B}{\times}(E \underset{F}{\times}C)
                and observe that this is also a weak equivalence, since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %munder
                        %mo ×
                        %mi B
                      %mi C
                    %annotation{:encoding => "application/x-tex"} A \underset{B}{\times} C
                is the limiting cone of a homotopy pullback square by remark
                = succeed "," do
                  %a.maruku-ref{:href => "#PullbackOfFibrationWithFibrantObjectsIsHomotopyPullback"}
              %p
                Now by using the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %munder
                          %mo ×
                          %mi B
                        %mo{:stretchy => "false"} (
                        %mi E
                        %munder
                          %mo ×
                          %mi F
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi A
                        %munder
                          %mo ×
                          %mi D
                        %mo{:stretchy => "false"} (
                        %mi D
                        %munder
                          %mi F
                          %mi E
                        %mo ×
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} A \underset{B}{\times} (E \underset{F}{\times} C) \simeq A \underset{D}{\times} (D \underset{E} F{\times})
                %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right properness
                this implies that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %munder
                        %mo ×
                        %mi B
                      %mo{:stretchy => "false"} (
                      %mi E
                      %munder
                        %mo ×
                        %mi F
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi D
                      %munder
                        %mo ×
                        %mi E
                      %mi F
                    %annotation{:encoding => "application/x-tex"} A \underset{B}{\times} (E \underset{F}{\times} C)\to D \underset{E}{\times} F
                is a weak equivalence.
              %p
                With this the claim follows by
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
            %p Homotopy pullbacks satisfy the usual abstract properties of pullbacks:
            #HomotopyPullbackOfWeakEquivalences.num_prop
              %h6#proposition_24 Proposition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right proper model category
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#RightProperModelCategory"}
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                one edge is a weak equivalence, then the square is a
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
                square precisely if the opposite edge is a weak equivalence, too.
            .proof
              %h6#proof_39 Proof
              %p Consider a commuting square of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi B
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi C
                            %mtd
                              %munder
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                            %mtd
                              %mi D
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\longrightarrow&amp; B
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      C &amp;\underset{\in W}{\longrightarrow}&amp; D
                      }
                      \\,.
              %p
                To detect whether this is a homotopy pullback, by def.
                %a.maruku-ref{:href => "#HomotopyPullback"}
                and prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#ConditionsForHomotopyPullbackAreIndeedEquivalent"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi B
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                          %mtr
                            %mtd
                              %mi C
                              %munder
                                %mo ×
                                %mi D
                              %mover
                                %mi B
                                %mo{:stretchy => "false"} ^
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                            %mtd
                              %mover
                                %mi B
                                %mo{:stretchy => "false"} ^
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                          %mtr
                            %mtd
                              %mi C
                            %mtd
                              %munder
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                            %mtd
                              %mi D
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\longrightarrow&amp; B
                      \\\
                      \\downarrow &amp;&amp; \downarrow^{\mathrlap{\in W}}
                      \\\
                      C \underset{D}{\times} \hat B
                      \&amp;\overset{\in W}{\longrightarrow}&amp;
                      \\hat B
                      \\\
                      \\downarrow
                      \&amp;(pb)&amp;
                      \\downarrow^{\mathrlap{\in Fib}}
                      \\\
                      C &amp;\underset{\in W}{\longrightarrow}&amp; D
                      }
                      \\,.
              %p
                Here the morphism in the middle is a weak equivalence by
                %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right properness
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#RightProperModelCategory"}
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                that the top left comparison morphism is a weak equivalence (and so the original square is a homotopy pullback) precisely if the top morphism is a weak equivalence.
            #ClosurePropertiesOfHomotopyPullbacks.num_prop
              %h6#proposition_25 Proposition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right proper model category
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#RightProperModelCategory"}
              %ol
                %li
                  %p
                    (
                    %a.existingWikiWord{:href => "/nlab/show/pasting+law"}> pasting law
                    ) If in a
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi A
                                %mtd
                                  %mo ⟶
                                %mtd
                                  %mi B
                                %mtd
                                  %mo ⟶
                                %mtd
                                  %mi C
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                              %mtr
                                %mtd
                                  %mi D
                                %mtd
                                  %mo ⟶
                                %mtd
                                  %mi E
                                %mtd
                                  %munder
                                    %mo ⟶
                                    %mrow
                                %mtd
                                  %mi F
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          A &amp;\longrightarrow&amp; B &amp;\longrightarrow&amp; C
                          \\\
                          \\downarrow
                          \&amp;&amp;
                          \\downarrow
                          \&amp;&amp;
                          \\downarrow
                          \\\
                          D &amp;\longrightarrow&amp; E &amp;\underset{}{\longrightarrow}&amp; F
                          }
                  %p
                    the square on the right is a homotoy pullback (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#HomotopyPullback"}
                %li
                  %p
                    in the presence of
                    %a.existingWikiWord{:href => "/nlab/show/functorial+factorization"} functorial factorization
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#FunctorialFactorization"}
                  %p
                    every
                    %a.existingWikiWord{:href => "/nlab/show/retract"} retract
                    of a homotopy pullback square (in the category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi 𝒞
                            %mi f
                            %mo □
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}_f^{\Box}
                    of commuting squares in
                    = succeed ")" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi 𝒞
                              %mi f
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
            .proof
              %h6#proof_40 Proof
              %p
                For the first statement: choose a factorization of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mover
                          %mo →
                          %mrow
                            %mo ∈
                            %mi W
                        %mover
                          %mi F
                          %mo{:stretchy => "false"} ^
                        %mover
                          %mo →
                          %mrow
                            %mo ∈
                            %mi Fib
                        %mi F
                      %annotation{:encoding => "application/x-tex"} C \overset{\in W}{\to} \hat F \overset{\in Fib}{\to} F
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo →
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} ^
                      %mover
                        %mo →
                        %mrow
                          %mo ∈
                          %mi Fib
                      %mi E
                    %annotation{:encoding => "application/x-tex"} B \to \hat B \overset{\in Fib}{\to} E
                and assume that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo →
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} B \to \hat B
                is a weak equivalence, i.e. that the right square is a homotopy pullback. Now use the ordinary
                %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
                to conclude.
              %p
                For the second statement: functorially choose a factorization of the two right vertical morphisms of the squares and factor the squares through the pullbacks of the corresponding fibrations along the bottom morphisms, respectively. Now the statement that the squares are homotopy pullbacks is equivalent to their top left vertical morphisms being weak equivalences. Factor these top left morphisms functorially as cofibrations followed by acyclic fibrations. Then the statement that the squares are homotopy pullbacks is equivalent to those top left cofibrations being acyclic. Now the claim follows using that the retract of an acyclic cofibration is an acyclic cofibration (prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %h3#LongSequences Long fiber sequences
            %p
              The ordinary
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
              = succeed "," do
                %a.maruku-ref{:href => "#FiberAndCofiberInPointedObjects"}
              %em twice
              is always trivial:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo ≃
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi fib
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi X
                    %mover
                      %mo ⟶
                      %mi f
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\ast \simeq fib(fib(f)) \longrightarrow fib(f) \longrightarrow X \overset{f}{\longrightarrow} Y
                    \\,.
            %p
              This is crucially different for the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              = succeed "." do
                %a.maruku-ref{:href => "#HomotopyFiber"}
            #HomotopyFiberOfHomotopyFiberIsLooping.num_prop
              %h6#proposition_26 Proposition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mi f
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_f
                be a
                %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
                of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
                be a morphism in its
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
                = succeed "." do
                  %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
                %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
                of its
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
                = succeed "," do
                  %a.maruku-ref{:href => "#HomotopyFiber"}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C}^{\ast/})
                %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \Omega Y
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                (def.
                = succeed "," do
                  %a.maruku-ref{:href => "#SuspensionAndLoopSpaceObject"}
                = succeed "):" do
                  %a.maruku-ref{:href => "#LoopingAsFunctorOnHomotopyCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hofib
                      %mo{:stretchy => "false"} (
                      %mi hofib
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Ω
                      %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      hofib(hofib(X \overset{f}{\to}Y)) \simeq \Omega Y
                      \\,.
            .proof
              %h6#proof_41 Proof
              %p
                Assume without restriction that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \;\colon\; X \longrightarrow Y
                is already a fibration between fibrant objects in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (otherwise replace and rename). Then its homotopy fiber is its ordinary fiber, sitting in a
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                square
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi hofib
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mo ≃
                            %mtd
                              %mi F
                            %mtd
                              %mover
                                %mo ⟶
                                %mi i
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                            %mtd
                              %mo *
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      hofib(f) \simeq &amp; F &amp;\overset{i}{\longrightarrow}&amp; X
                      \\\
                      \&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                      \\\
                      \&amp; \ast &amp;\longrightarrow&amp; Y
                      }
                      \\,.
              %p
                In order to compute
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi hofib
                        %mo{:stretchy => "false"} (
                        %mi hofib
                        %mo{:stretchy => "false"} (
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} hofib(hofib(f))
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi hofib
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} hofib(i)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
                by a fibration. Using the
                %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
                %a.maruku-ref{:href => "#FactorizationLemma"}
                for this purpose yields, after a choice of
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path(X)
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi F
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                            %mtd
                              %mi F
                              %msub
                                %mo ×
                                %mi X
                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi i
                              %mo ↘
                            %mtd
                              %msubsup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi Fib
                                %mpadded{:width => "0"}
                                  %mover
                                    %mi i
                                    %mo{:stretchy => "false"} ˜
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      F &amp;\overset{\in W}{\longrightarrow}&amp; F \times_X Path(X)
                      \\\
                      \&amp;{}_{\mathllap{i}}\searrow&amp; \downarrow^{\mathrlap{\tilde i}}_{\mathrlap{\in Fib}}
                      \\\
                      \&amp;&amp; X
                      }
                      \\,.
              %p
                Hence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hofib
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} hofib(i)
                is the ordinary fiber of this map:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hofib
                      %mo{:stretchy => "false"} (
                      %mi hofib
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi F
                      %msub
                        %mo ×
                        %mi X
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi X
                      %mo *
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      hofib(hofib(f)) \simeq  F \times_X Path(X) \times_X \ast \;\;\;\; \in Ho(\mathcal{C}^{\ast/})
                      \\,.
              %p Notice that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %msub
                        %mo ×
                        %mi X
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mo *
                      %msub
                        %mo ×
                        %mi Y
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      F \times_X Path(X) \; \simeq \; \ast \times_Y Path(X)
              %p
                because of the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi F
                              %msub
                                %mo ×
                                %mi X
                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi F
                            %mtd
                              %mover
                                %mo ⟶
                                %mi i
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      F \times_X Path(X) &amp;\longrightarrow&amp; Path(X)
                      \\\
                      \\downarrow &amp;(pb)&amp; \downarrow
                      \\\
                      F &amp;\overset{i}{\longrightarrow}&amp; X
                      \\\
                      \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{f}}
                      \\\
                      \\ast &amp;\longrightarrow&amp; Y
                      }
                      \\,.
              %p Hence
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hofib
                      %mo{:stretchy => "false"} (
                      %mi hofib
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mo *
                      %msub
                        %mo ×
                        %mi Y
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi X
                      %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      hofib(hofib(f))
                      \\;\simeq\;
                      \\ast \times_Y Path(X) \times_X \ast
                      \\,.
              %p
                Now we claim that there is a choice of path space objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path(X)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path(Y)
                such that this model for the homotopy fiber (as an object in
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                diagram of the following form:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                              %msub
                                %mo ×
                                %mi Y
                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo ×
                                %mi X
                              %mo *
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo ∈
                                  %mi W
                                  %mo ∩
                                  %mi F
                          %mtr
                            %mtd
                              %mi Ω
                              %mi Y
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi Y
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo ×
                                %mi Y
                              %mi X
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Y
                              %mo ×
                              %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\ast \times_Y Path(X) \times_X \ast &amp;\longrightarrow&amp; Path(X)
                      \\\
                      \\downarrow &amp;&amp; \downarrow\mathrlap{\in W \cap F}
                      \\\
                      \\Omega Y &amp;\longrightarrow&amp; Path(Y)\times_Y X
                      \\\
                      \\downarrow &amp;(pb)&amp; \downarrow
                      \\\
                      \\ast &amp;\longrightarrow&amp;  Y \times X
                      }
                      \\,.
              %p
                By the
                %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
                and the pullback stability of acyclic fibrations, this will prove the claim.
              %p
                To see that the bottom square here is indeed a pullback, check the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                into
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %munder
                        %mo ×
                        %mrow
                          %mi Y
                          %mo ×
                          %mi X
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi Y
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \ast \underset{Y \times X}{\times} Path(Y) \times_Y X
                is a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \colon A \to Path(Y)
                and a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} b \colon A \to X
                such that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 0
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} p_0(a) = \ast
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi b
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_1(a) = f(b)
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} b = \ast
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \colon A \to Path(Y)
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 0
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} p_0(a) = \ast
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} p_1(a) = \ast
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ω
                        %mi Y
                        %mo ≔
                        %mo *
                        %munder
                          %mo ×
                          %mi Y
                        %mi Path
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %munder
                          %mo ×
                          %mi Y
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \Omega Y \coloneqq \ast \underset{Y}{\times} Path(Y) \underset{Y}{\times} \ast
              %p
                Now to construct the right vertical morphism in the top square (
                %a{:href => "model+category#Quillen67"}> Quillen 67, page 3.1
                ): Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path(Y)
                be any path space object for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Path(X)
                be given by a factorization
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi id
                        %mi X
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi i
                      %mo ∘
                      %mi f
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi id
                        %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mover
                        %mo →
                        %mrow
                          %mo ∈
                          %mi W
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %mi Fib
                      %mi X
                      %msub
                        %mo ×
                        %mi Y
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi Y
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      (id_X, \; i \circ f, \; id_X)
                      \\;\colon\;
                      X
                      \\overset{\in W}{\to}
                      Path(X)
                      \\overset{\in Fib}{\longrightarrow}
                      X \times_Y Path(Y) \times_Y X
              %p
                and regarded as a path space object of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                by further comoposing with
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi pr
                        %mn 1
                      %mo ,
                      %msub
                        %mi pr
                        %mn 3
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %msub
                        %mo ×
                        %mi Y
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi Y
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %mi Fib
                      %mi X
                      %mo ×
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (pr_1,pr_3)\colon X \times_Y Path(Y) \times_Y X \overset{\in Fib}{\longrightarrow} X \times X
                      \\,.
              %p
                We need to show that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi Y
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Path(X)\to Path(Y) \times_Y X
                is an acyclic fibration.
              %p
                It is a fibration because
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %msub
                        %mo ×
                        %mi Y
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi Y
                      %mi X
                      %mo →
                      %mi Path
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ×
                        %mi Y
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X\times_Y Path(Y) \times_Y X \to Path(Y)\times_Y X
                is a fibration, this being the pullback of the fibration
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo →
                          %mi f
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \overset{f}{\to} Y
              %p
                To see that it is also a weak equivalence, first observe that
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Path
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo ×
                          %mi Y
                        %mi X
                        %mover
                          %mo ⟶
                          %mrow
                            %mo ∈
                            %mi W
                            %mo ∩
                            %mi Fib
                        %mi X
