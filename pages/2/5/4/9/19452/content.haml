                projections. Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                    %annotation{:encoding => "application/x-tex"} Disc
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi coDisc
                    %annotation{:encoding => "application/x-tex"} coDisc
                are
                %a.existingWikiWord{:href => "/nlab/show/right+Quillen+functors"} right Quillen functors
                with respect to the global model projective model structure,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Disc(S)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi coDisc
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} coDisc(S)
                are globally projectively fibrant simplicial presheaves. Since, moreover,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(\{U_i\})
                is projectively cofibrant by assumption, and since the representables
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                are projectively cofibrant by Prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#SomeProjectivelyCofibrantSimplicialPresheaves"}
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
                reduces to that of the ordinary
                %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#EnrichedHomFunctor"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %msup
                                %mi 𝒞
                                %mi op
                              %mo ,
                              %mi sSet
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %mi Disc
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                            %mtd
                              %mo{:stretchy => "false"} [
                              %msup
                                %mi 𝒞
                                %mi op
                              %mo ,
                              %mi sSet
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} }
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi Disc
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %msup
                                %mi 𝒞
                                %mi op
                              %mo ,
                              %mi sSet
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %mi coDisc
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo ∈
                                  %mi W
                            %mtd
