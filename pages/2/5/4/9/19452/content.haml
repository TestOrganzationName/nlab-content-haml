                                %mi 𝒞
                                %mi op
                              %mo ,
                              %mi sSet
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} {
                              %msub
                                %mi U
                                %mi i
                              %mo{:stretchy => "false"} }
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi coDisc
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      [\mathcal{C}^{op}, sSet]( X, Disc(S) )
                      \&amp;\overset{\in W}{\longrightarrow}&amp;
                      [\mathcal{C}^{op}, sSet]( C(\{U_i\}), Disc(S) )
                      \\\
                      [\mathcal{C}^{op}, sSet]( X, coDisc(S) )
                      \&amp;\overset{\in W}{\longrightarrow}&amp;
                      [\mathcal{C}^{op}, sSet]( C(\{U_i\}), coDisc(S) )
                      }
              %p
                are weak equivalences. But now by the ordinary adjunction hom-isomorphism
                = succeed "," do
                  %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} [
                              %msup
                                %mi 𝒞
                                %mi op
                              %mo ,
                              %mi sSet
