                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                = succeed "," do
                  %a.maruku-ref{:href => "#LeftHomotopyOfSimplicialSets"}
                %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
