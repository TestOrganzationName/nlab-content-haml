                      %mi D
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      N A \stackrel{i}{\hookrightarrow} A
                      \\stackrel{p}{\to}
                      (C A)/(D A)
              %p
                from the normalized chain complex, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#NormalizedChainComplexOnGeneralGroup"}
                = succeed "," do
                  %a.maruku-ref{:href => "#ComplexModuloDegeneracies"}
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                of chain complexes.
            %p
              e.g. (
              %a{:href => "Moore+complex#GoerssJardine"}> Goerss-Jardine, theorem III 2.1
              ).
            #SplittingOffDegenerateCells.num_cor
              %h6#corollary_8 Corollary
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi N
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⊕
                      %msub
                        %mi D
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      C_\bullet(A) \simeq N_\bullet(A) \oplus D_\bullet(A)
              %p
                of the alternating face map complex, def.
                %a.maruku-ref{:href => "#AlternatingFaceMapComplex"}
                as a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} naturally isomorphic
                to the
                %a.existingWikiWord{:href => "/nlab/show/normalized+chain+complex"} normalized chain complex
                of def.
                %a.maruku-ref{:href => "#NormalizedChainComplexOnGeneralGroup"}
                and the second is the degenerate cells from def.
                = succeed "." do
                  %a.maruku-ref{:href => "#ComplexModuloDegeneracies"}
            .proof
              %h6#proof_89 Proof
              %p
                By prop.
                %a.maruku-ref{:href => "#NormalizedIntoModuloDegeneraciesIsIsomorpism"}
                there is an
                %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
                to the diagonal composite in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi C
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mi p
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mi A
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} (
                              %mi D
                              %mi A
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi i
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %mo ↗
                          %mtr
                            %mtd
                              %mi N
                              %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      C A &amp;\stackrel{p}{\longrightarrow}&amp; (C A)/(D A)
                      \\\
                      {}^{\mathllap{i}}\uparrow &amp; \nearrow
                      \\\
                      N A
                      }
                      \\,.
              %p
                This hence exhibits a
                %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} splitting
                of the
                %a.existingWikiWord{:href => "/nlab/show/short+exact+sequence"} short exact sequence
                given by the quotient by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mi A
                      %annotation{:encoding => "application/x-tex"} D A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mn 0
                            %mtd
                              %mo →
                            %mtd
                              %mi D
                              %mi A
                            %mtd
                              %mo ↪
                            %mtd
                              %mi C
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mi p
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mi A
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} (
                              %mi D
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mn 0
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi i
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %msub
                                %mo ↙
                                %mrow
                                  %msub
                                    %mpadded{:width => "0"}
                                      %mo ≃
                                    %mi iso
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mi N
                              %mi A
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      0 &amp;\to&amp; D A &amp;\hookrightarrow &amp; C A &amp;\stackrel{p}{\longrightarrow}&amp; (C A)/(D A) &amp;\to &amp; 0
                      \\\
                      \&amp;&amp; &amp;&amp; {}^{\mathllap{i}}\uparrow &amp; \swarrow_{\mathrlap{\simeq}_{iso}}
                      \\\
                      \&amp;&amp; &amp;&amp; N A
                      }
                      \\,.
            #EMTheorem.num_theorem
              %h6#theorem_eilenbergmaclane Theorem (Eilenberg-MacLane)
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mi A
                      %mo ↪
                      %mi C
                      %mi A
                    %annotation{:encoding => "application/x-tex"}
                      N A \hookrightarrow C A
              %p
                of the normalized chain complex, def.
                %a.maruku-ref{:href => "#NormalizedChainComplexOnGeneralGroup"}
                into the full alternating face map complex, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#AlternatingFaceMapComplex"}
                %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                and in fact a natural chain
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D_\bullet(X)
                is null-homotopic.
            %p
              (
              %a{:href => "Moore+complex#GoerssJardine"}> Goerss-Jardine, theorem III 2.4
              )
            .num_cor
              %h6#corollary_9 Corollary
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
                %a.existingWikiWord{:href => "/nlab/show/chain+map"} chain map
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi D
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (C A) \longrightarrow (C A)/(D A)
              %p
                from its alternating face maps complex, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#AlternatingFaceMapComplex"}
                = succeed "," do
                  %a.maruku-ref{:href => "#ComplexModuloDegeneracies"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            .proof
              %h6#proof_90 Proof
              %p
                Consider the pre-composition of the map with the inclusion of the normalized chain complex, def.
                = succeed "." do
                  %a.maruku-ref{:href => "#NormalizedChainComplexOnGeneralGroup"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi C
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mi p
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mi A
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} (
                              %mi D
                              %mi A
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi i
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %mo ↗
                          %mtr
                            %mtd
                              %mi N
                              %mi A
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      C A &amp;\stackrel{p}{\longrightarrow}&amp; (C A)/(D A)
                      \\\
                      {}^{\mathllap{i}}\uparrow &amp; \nearrow
                      \\\
                      N A
                      }
              %p
                By theorem
                %a.maruku-ref{:href => "#EMTheorem"}
                the vertical map is a
                %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                and by prop.
                %a.maruku-ref{:href => "#NormalizedIntoModuloDegeneraciesIsIsomorpism"}
                the composite diagonal map is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                property, it follows that also the map in question is a quasi-isomorphism.
            #ChainsOnThe1Simplex.num_example
              %h6#example_64 Example
              %p
                Consider the 1-
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[1]
                regarded as a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[\Delta[1]]
                for the
                %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
                which in each degree is the
                %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
                on the simplices in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[1]
              %p This simplicial abelian group starts out as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mrow
                        %mo (
                        %mi ⋯
                        %mover
                          %mover
                            %mover
                              %mo ⟶
                              %mo ⟶
                            %mo ⟶
                          %mo ⟶
                        %msup
                          %mi ℤ
                          %mn 4
                        %mover
                          %mover
                            %mo ⟶
                            %mo ⟶
                          %mo ⟶
                        %msup
                          %mi ℤ
                          %mn 3
                        %mover
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mo ∂
                                %mn 1
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mo ∂
                                %mn 0
                        %msup
                          %mi ℤ
                          %mn 2
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{Z}[\Delta[1]]
                      \=
                      \\left(
                      \\cdots
                      \\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}}
                      \\mathbb{Z}^4 \stackrel{\longrightarrow}{\stackrel{\longrightarrow}{\longrightarrow}}
                      \\mathbb{Z}^3 \stackrel{\overset{\partial_0}{\longrightarrow}}{\underset{\partial_1}{\longrightarrow}} \mathbb{Z}^2
                      \\right)
              %p (where we are indicating only the face maps for notational simplicity).
              %p
                Here the first
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℤ
                          %mn 2
                        %mo =
                        %mi ℤ
                        %mo ⊕
                        %mi ℤ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Z}^2 = \mathbb{Z}\oplus \mathbb{Z}
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                of two copies of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/integers"} integers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1)
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[1]
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℤ
                        %mn 2
                      %mo ≃
                      %mrow
                        %mo {
                        %mi a
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi b
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                        %mi a
                        %mo ,
                        %mi b
                        %mo ∈
                        %mi ℤ
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{Z}^2 \simeq \left\{ a \cdot (0) + b \cdot (1) | a,b \in \mathbb{Z}\right\}
                      \\,.
              %p
                The second
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℤ
                        %mn 3
                      %mo ≃
                      %mi ℤ
                      %mo ⊕
                      %mi ℤ
                      %mo ⊕
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}^3 \simeq \mathbb{Z}\oplus \mathbb{Z}\oplus \mathbb{Z}
                is the abelian group generated from the three (!) 1-simplicies in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[1]
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0\to 1)
                and the two degenerate cells
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo →
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0 \to 0)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo →
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (1 \to 1)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℤ
                        %mn 3
                      %mo ≃
                      %mrow
                        %mo {
                        %mi a
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo →
                        %mn 0
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi b
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo →
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi c
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo →
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mi c
                        %mo ∈
                        %mi ℤ
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{Z}^3 \simeq \left\{ a \cdot (0\to 0) + b \cdot (0 \to 1) + c \cdot (1 \to 1) | a,b,c \in \mathbb{Z}\right\}
                      \\,.
              %p The two face maps act on the basis 1-cells as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo →
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\partial_1 \colon (i \to j) \mapsto (i)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mn 0
                      %mo{:lspace => "verythinmathspace"} :
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo →
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\partial_0 \colon (i \to j) \mapsto (j)
                      \\,.
              %p
                Now of course most of the (infinitely!) many simplices inside
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[1]
                are degenerate. In fact the only non-degenerate simplices are the two 0-cells
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (0)
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1)
                and the 1-cell
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo →
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (0 \to 1)
                = succeed "," do
                  %a.maruku-ref{:href => "#ComplexModuloDegeneracies"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}[\Delta[1]]
                is simply this:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi D
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mrow
                        %mo (
                        %mi ⋯
                        %mo →
                        %mn 0
                        %mo →
                        %mn 0
                        %mo →
                        %mi ℤ
                        %mover
                          %mo ⟶
                          %mrow
                            %mo (
                            %mfrac{:linethickness => "0"}
                              %mrow
                                %mn 1
                              %mrow
                                %mo −
                                %mn 1
                            %mo )
                        %msup
                          %mi ℤ
                          %mn 2
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (C (\mathbb{Z}[\Delta[1]])) / D (\mathbb{Z}[\Delta[1]]))
                      \=
                      \\left(
                      \\cdots
                      \\to
                      0
                      \\to
                      0
                      \\to
                      \\mathbb{Z}
                      \\stackrel{\left(1 \atop -1\right)}{\longrightarrow}
                      \\mathbb{Z}^2
                      \\right)
                      \\,.
              %p
                Notice that alternatively we could consider the topological 1-simplex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mn 1
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta^1 = [0,1]
                and its
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sing(\Delta^1)
                in place of the smaller
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \Delta[1]
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} (
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}(Sing(\Delta^1))
                of that. The corresponding alternating face map chain complex
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} (
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C(\mathbb{Z}(Sing(\Delta^1)))
                is “huge” in that in each positive degree it has a free abelian group on uncountably many generators. Quotienting out the degenerate cells still leaves uncountably many generators in each positive degree (while every singular
                = succeed "-simplex" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
                is “thin”, only those whose parameterization is as induced by a degeneracy map are actually regarded as degenerate cells here). Hence even after normalization the singular simplicial chain complex is “huge”. Nevertheless it is quasi-isomorphic to the tiny chain complex found above.
            %p
              The statement of the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              now is the following.
            .num_theorem
              %h6#theorem_6 Theorem
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                an
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian category
                there is an
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi A
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
                      %mover
                        %mo →
                        %mo ←
                      %msubsup
                        %mi Ch
                        %mo •
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"}
                      N \;\colon\; A^{\Delta^{op}}
                      \\stackrel{\leftarrow}{\to} Ch_\bullet^+(A) \;\colon\; \Gamma
              %p between
              %ul
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/category+of+simplicial+objects"} category of simplicial objects
                    in
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                          %annotation{:encoding => "application/x-tex"} A
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of connective chain complexes
                    in
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi A
                          %annotation{:encoding => "application/x-tex"} A
              %p where
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is the
                  = succeed "/normalized" do
                    %a.existingWikiWord{:href => "/nlab/show/normalized+chains+complex"} normalized chains complex
                  %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
                  functor.
            %p
              (
              %a{:href => "Dold-Kan+correspondence#Dold58"}> Dold 58
              ,
              = succeed "," do
                %a{:href => "Dold-Kan+correspondence#Kan58"} Kan 58
              = succeed ")." do
                %a{:href => "Dold-Kan+correspondence#DoldPuppe61"} Dold-Puppe 61
            .num_theorem
              %h6#theorem_kan Theorem (Kan)
              %p
                For the case that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
                is the category
                %a.existingWikiWord{:href => "/nlab/show/Ab"} Ab
                of
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                are
                %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
                with respect to the cosimplicial chain complex
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                      %mo :
                      %mi Δ
                      %mo →
                      %msub
                        %mi Ch
                        %mo +
                      %mo{:stretchy => "false"} (
                      %mi Ab
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathbb{Z}[-]: \Delta \to Ch_+(Ab)
              %p
                that sends the standard
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
                to the normalized
                %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
                of the free simplicial abelian group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mi ℤ
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F_{\mathbb{Z}}(\Delta^n)
                on the
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mi n
                      %annotation{:encoding => "application/x-tex"} \Delta^n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi Hom
                        %mrow
                          %msubsup
                            %mi Ch
                            %mo •
                            %mo +
                          %mo{:stretchy => "false"} (
                          %mi Ab
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} (
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi k
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Gamma(V) : [k]  \mapsto
                      Hom_{Ch_\bullet^+(Ab)}(N(\mathbb{Z}(\Delta[k])), V)
                      \\,.
            %p
              This is due to (
              %a{:href => "Dold-Kan+correspondence#Kan58"}> Kan 58
              ).
            %p More explicitly we have the following
            #ExplicitUnitAndCounit.num_prop
              %h6#proposition_64 Proposition
              %ul
                %li
                  %p
                    For
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo ∈
                          %msubsup
                            %mi Ch
                            %mo •
                            %mo +
                        %annotation{:encoding => "application/x-tex"} V \in Ch_\bullet^+
                    the simplicial abelian group
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \Gamma(V)
                    is in degree
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                    given by
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi n
                          %mo =
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                              %munder
                                %mo →
                                %mi surj
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                          %msub
                            %mi V
                            %mi k
                        %annotation{:encoding => "application/x-tex"}
                          \\Gamma(V)_n = \bigoplus_{[n] \underset{surj}{\to} [k]} V_k
                  %p
                    and for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi θ
                          %mo :
                          %mo{:stretchy => "false"} [
                          %mi m
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \theta : [m] \to [n]
                    a morphism in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Δ
                        %annotation{:encoding => "application/x-tex"} \Delta
                    the corresponding map
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi n
                          %mo →
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi m
                        %annotation{:encoding => "application/x-tex"} \Gamma(V)_n \to \Gamma(V)_m
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi θ
                            %mo *
                          %mo :
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                              %munder
                                %mo →
                                %mi surj
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                          %msub
                            %mi V
                            %mi k
                          %mo →
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi m
                              %mo{:stretchy => "false"} ]
                              %munder
                                %mo →
                                %mi surj
                              %mo{:stretchy => "false"} [
                              %mi r
                              %mo{:stretchy => "false"} ]
                          %msub
                            %mi V
                            %mi r
                        %annotation{:encoding => "application/x-tex"}
                          \\theta^* : \bigoplus_{[n] \underset{surj}{\to} [k]} V_k
                          \\to
                          \\bigoplus_{[m] \underset{surj}{\to} [r]} V_r
                  %p
                    is given on the summand indexed by some
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi σ
                          %mo :
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \sigma : [n] \to [k]
                    by the composite
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi V
                            %mi k
                          %mover
                            %mo →
                            %mrow
                              %msup
                                %mi d
                                %mo *
                          %msub
                            %mi V
                            %mi s
                          %mo ↪
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi m
                              %mo{:stretchy => "false"} ]
                              %munder
                                %mo →
                                %mi surj
                              %mo{:stretchy => "false"} [
                              %mi r
                              %mo{:stretchy => "false"} ]
                          %msub
                            %mi V
                            %mi r
                        %annotation{:encoding => "application/x-tex"}
                          V_k  \stackrel{d^*}{\to} V_s \hookrightarrow \bigoplus_{[m] \underset{surj}{\to} [r]} V_r
                  %p where
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi m
                          %mo{:stretchy => "false"} ]
                          %mover
                            %mo →
                            %mi t
                          %mo{:stretchy => "false"} [
                          %mi s
                          %mo{:stretchy => "false"} ]
                          %mover
                            %mo →
                            %mi d
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"}
                          [m] \stackrel{t}{\to} [s] \stackrel{d}{\to} [k]
                  %p
                    is the
                    %a.existingWikiWord{:href => "/nlab/show/weak+factorization+system"} epi-mono factorization
                    of the composite
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi m
                            %mo{:stretchy => "false"} ]
                            %mover
                              %mo →
                              %mi θ
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mover
                              %mo →
                              %mi σ
                            %mo{:stretchy => "false"} [
                            %mi k
                            %mo{:stretchy => "false"} ]
                          %annotation{:encoding => "application/x-tex"} [m] \stackrel{\theta}{\to} [n] \stackrel{\sigma}{\to} [k]
                %li
                  %p
                    The
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Γ
                          %mi N
                          %mo →
                          %mi Id
                        %annotation{:encoding => "application/x-tex"} \Gamma N \to Id
                    is given on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mo ∈
                          %msup
                            %mi sAb
                            %mrow
                              %msup
                                %mi Δ
                                %mi op
                        %annotation{:encoding => "application/x-tex"} A \in sAb^{\Delta^{op}}
                    by the map
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %munder
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                            %mrow
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                              %munder
                                %mo →
                                %mi surj
                              %mo{:stretchy => "false"} [
                              %mi k
                              %mo{:stretchy => "false"} ]
                          %mo{:stretchy => "false"} (
                          %mi N
                          %mi A
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi k
                          %mo →
                          %msub
                            %mi A
                            %mi n
                        %annotation{:encoding => "application/x-tex"}
                          \\bigoplus_{[n] \underset{surj}{\to} [k]}
                          (N A)_k
                          \\to
                          A_n
                  %p
                    which on the
                    = succeed "mand" do
                      %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi σ
                          %mo :
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo →
                          %mo{:stretchy => "false"} [
                          %mi k
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \sigma : [n] \to [k]
                    is the composite
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %msub
                            %mi A
                            %mi k
                          %mo ↪
                          %msub
                            %mi A
                            %mi k
                          %mover
                            %mo →
                            %mrow
                              %msup
                                %mi σ
                                %mo *
                          %msub
                            %mi A
                            %mi n
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          N A_k \hookrightarrow A_k \stackrel{\sigma^*}{\to} A_n
                          \\,.
                %li
                  %p
                    The
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Id
                          %mo →
                          %mi N
                          %mi Γ
                        %annotation{:encoding => "application/x-tex"} Id \to N \Gamma
                    is on a chain complex
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
                    given by the composite of the projection
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo →
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi D
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          V \to C(\Gamma(V)) \to C(\Gamma(C))/D(\Gamma(V))
                  %p with the inverse
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi D
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi N
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          C(\Gamma(V))/D(\Gamma(V)) \to N \Gamma(V)
                  %p of
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mo ↪
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %mi D
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          N \Gamma(V) \hookrightarrow C(\Gamma(V)) \to C(\Gamma(V))/D(\Gamma(V))
                  %p
                    (which is indeed an
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                    = succeed ")." do
                      %a.existingWikiWord{:href => "/nlab/show/Moore+complex"} Moore complex
            %p
              This is spelled out in (
              %a{:href => "Moore+complex#Goerssjardine"}> Goerss-Jardine, prop. 2.2 in section III.2
              ).
            .num_prop
              %h6#proposition_65 Proposition
              %p
                With the explicit choice for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                      %mi N
                      %mover
                        %mo →
                        %mo ≃
                      %mi Id
                    %annotation{:encoding => "application/x-tex"} \Gamma N \stackrel{\simeq}{\to} Id
                as
                %a{:href => "#ExplicitUnitAndCounit"} above
                we have that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Γ
                    %annotation{:encoding => "application/x-tex"} \Gamma
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                form an
                %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Γ
                      %mo ⊣
                      %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\Gamma \dashv N)
            %p
              This is for instance (
              %a{:href => "Dold-Kan+correspondence#Weilbel"}> Weibel, exercise 8.4.2
              ).
            .num_remark
              %h6#remark_45 Remark
              %p
                It follows that with the inverse structure maps, we also have an
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                the other way round:
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi N
                        %mo ⊣
                        %mi Γ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (N \dashv \Gamma)
            %p
              Hence in conclusion the
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              allows us to regard
              %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
              (in non-negative degree) as, in particular, special
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"} Kan complexes
              and hence
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/infinity-groupoids"} infinity-groupoids
            #MooreTheorem.num_theorem
              %h6#theorem_j_c_moore Theorem (J. C. Moore)
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                underlying any
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
                (by forgetting the group structure) is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %p
              This is due to (
              %a{:href => "simplicial+group#Moore54"}> Moore, 1954
              )
            %p
              In fact, not only are the
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              fillers guaranteed to exist, but there is an algorithm that provides explicit fillers. This implies that constructions on a simplicial group that use fillers of horns can often be adjusted to be functorial by using the algorithmically defined fillers. An argument that just uses ‘existence’ of fillers can be refined to give something more ‘coherent’.
            .proof
              %h6#proof_91 Proof
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                be a simplicial group.
              %p Here is the explicit algorithm that computes the horn fillers:
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi y
                        %mn 0
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi y
                        %mrow
                          %mi k
                          %mo −
                          %mn 1
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %msub
                        %mi y
                        %mrow
                          %mi k
                          %mo +
                          %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi y
                        %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (y_0,\ldots, y_{k-1}, -,y_{k+1}, \ldots, y_n)
                give a
                %a.existingWikiWord{:href => "/nlab/show/horn"} horn
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi G
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} G_{n-1}
                = succeed "s" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi y
                          %mi i
                      %annotation{:encoding => "application/x-tex"} y_i
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1)
                simplices that fit together as if they were all but one, the
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mi th
                    %annotation{:encoding => "application/x-tex"} k^{th}
                one, of the faces of an
                = succeed "-simplex." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              %ol
                %li
                  %p
                    if
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi k
                            %mo =
                            %mn 0
                          %annotation{:encoding => "application/x-tex"} k = 0
                  %ul
                    %li
                      Let
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi w
                              %mi n
                            %mo =
                            %msub
                              %mi s
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                            %msub
                              %mi y
                              %mi n
                          %annotation{:encoding => "application/x-tex"} w_n = s_{n-1}y_n
                      and then
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi w
                              %mi i
                            %mo =
                            %msub
                              %mi w
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi s
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %msub
                              %mi d
                              %mi i
                            %msub
                              %mi w
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi s
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %msub
                              %mi y
                              %mi i
                          %annotation{:encoding => "application/x-tex"} w_i = w_{i+1}(s_{i-1}d_i w_{i+1})^{-1}s_{i-1}y_i
                      for
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi i
                              %mo =
                              %mi n
                              %mo ,
                              %mi …
                              %mo ,
                              %mn 1
                            %annotation{:encoding => "application/x-tex"} i = n, \ldots, 1
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi w
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} w_1
                      satisfies
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi d
                                %mi i
                              %msub
                                %mi w
                                %mn 1
                              %mo =
                              %msub
                                %mi y
                                %mi i
                            %annotation{:encoding => "application/x-tex"} d_i w_1 = y_i
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi i
                              %mo ≠
                              %mn 0
                            %annotation{:encoding => "application/x-tex"} i\neq  0
                %li
                  %p
                    if
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 0
                            %mo &lt;
                            %mi k
                            %mo &lt;
                            %mi n
                          %annotation{:encoding => "application/x-tex"} 0\lt k \lt n
                  %ul
                    %li
                      Let
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi w
                              %mn 0
                            %mo =
                            %msub
                              %mi s
                              %mn 0
                            %msub
                              %mi y
                              %mn 0
                          %annotation{:encoding => "application/x-tex"} w_0 = s_0 y_0
                      and
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi w
                              %mi i
                            %mo =
                            %msub
                              %mi w
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi s
                              %mi i
                            %msub
                              %mi d
                              %mi i
                            %msub
                              %mi w
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %msub
                              %mi s
                              %mi i
                            %msub
                              %mi y
                              %mi i
                          %annotation{:encoding => "application/x-tex"} w_i = w_{i-1}(s_i d_i w_{i-1})^{-1}s_i y_i
                      for
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi i
                              %mo =
                              %mn 0
                              %mo ,
                              %mi …
                              %mo ,
                              %mi k
                              %mo −
                              %mn 1
                            %annotation{:encoding => "application/x-tex"} i = 0, \ldots, k-1
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi w
                                %mi n
                              %mo =
                              %msub
                                %mi w
                                %mrow
                                  %mi k
                                  %mo −
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi s
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                              %msub
                                %mi d
                                %mi nw
                              %msub
                                %mo
                                %mrow
                                  %mi k
                                  %mo −
                                  %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %msub
                                %mi s
                                %mrow
                                  %mi n
                                  %mo −
                                  %mn 1
                              %msub
                                %mi y
                                %mi n
                            %annotation{:encoding => "application/x-tex"} w_n = w_{k-1}(s_{n-1}d_nw_{k-1})^{-1}s_{n-1}y_n
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %msub
                                %mi w
                                %mi i
                              %mo =
                              %msub
                                %mi w
                                %mrow
                                  %mi i
                                  %mo +
                                  %mn 1
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi s
                                %mrow
                                  %mi i
                                  %mo −
                                  %mn 1
                              %msub
                                %mi d
                                %mi i
                              %msub
                                %mi w
                                %mrow
                                  %mi i
                                  %mo +
                                  %mn 1
                              %msup
                                %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %msub
                                %mi s
                                %mrow
                                  %mi i
                                  %mo −
                                  %mn 1
                              %msub
                                %mi y
                                %mi i
                            %annotation{:encoding => "application/x-tex"} w_i = w_{i+1}(s_{i-1}d_{i}w_{i+1})^{-1}s_{i-1}y_i
                      = succeed "," do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi i
                              %mo =
                              %mi n
                              %mo ,
                              %mi …
                              %mo ,
                              %mi k
                              %mo +
                              %mn 1
                            %annotation{:encoding => "application/x-tex"} i = n, \ldots, k+1
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi w
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                          %annotation{:encoding => "application/x-tex"} w_{k+1}
                      gives
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi d
                              %mi i
                            %msub
                              %mi w
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                            %mo =
                            %msub
                              %mi y
                              %mi i
                          %annotation{:encoding => "application/x-tex"} d_{i}w_{k+1} = y_i
                      for
                      = succeed ";" do
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi i
                              %mo ≠
                              %mi k
                            %annotation{:encoding => "application/x-tex"} i \neq k
                %li
                  %p
                    if
