                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/coequalizer"} coequalizer
              %p
                First observe that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
                indeed coequalizes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi id
                      %mo ⊗
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} id \otimes \mu
                with
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi μ
                        %mo ⊗
                        %mi id
                      %annotation{:encoding => "application/x-tex"} \mu \otimes id
                %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
                clause in def.
                = succeed "." do
                  %a.maruku-ref{:href => "#MonoidsInMonoidalCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ⊗
                      %mi A
                      %mo ⟶
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} f \colon A \otimes A \longrightarrow Q
                any other morphism with this property, we need to show that there is a unique morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ⟶
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} \phi \colon A \longrightarrow Q
                which makes this
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
