                in presheaves.
              %p Hence it remains to see that this cone of presheaves is indeed universal.
              %p
                Now if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is any other cone over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                in the category of presheaves, then by the universal property of the pointswise limits, there is for each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                a unique morphism of cones in sets
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %munder
                        %mi lim
                        %munder
                          %mo ⟵
                          %mrow
                            %mi d
                            %mo ∈
                            %mi 𝒟
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      I(c)
                      \\longrightarrow
                      \\underset{\underset{d \in \mathcal{D}}{\longleftarrow}}{lim}
                      F(d)(c)
                      \\,.
              %p Hence there is at most one morphisms of cones of presheaves, namely if these components make all their naturality squares commute.
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi I
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi c
                                %mn 2
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⟶
                            %mtd
                              %munder
                                %mi lim
                                %munder
                                  %mo ⟵
                                  %mrow
                                    %mi d
                                    %mo ∈
                                    %mi 𝒟
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi c
                                %mn 2
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mtd
                            %mtd
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %mtr
                            %mtd
                              %mi I
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi c
                                %mn 1
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⟶
                            %mtd
                              %munder
                                %mi lim
                                %munder
                                  %mo ⟵
                                  %mrow
                                    %mi d
                                    %mo ∈
                                    %mi 𝒟
                              %mi F
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi c
                                %mn 1
                              %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      I(c_2)
                      \&amp;\longrightarrow&amp;
                      \\underset{\underset{d \in \mathcal{D}}{\longleftarrow}}{lim}
                      F(d)(c_2)
                      \\\
                      \\big\downarrow &amp;&amp; \big\downarrow
                      \\\
                      I(c_1)
                      \&amp;\longrightarrow&amp;
                      \\underset{\underset{d \in \mathcal{D}}{\longleftarrow}}{lim}
                      F(d)(c_1)
                      }
                      \\,.
              %p
                But since everything else commutes, the two ways of going around this diagram constitute two morphisms from a cone over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(-)(c_1)
                to the limit cone over
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi c
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(-)(c_1)
            #HomFunctorPreservesLimits.num_prop
              %h6#proposition Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/hom-functor+preserves+limits"}> hom-functor preserves limits
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                and write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ×
                      %mi 𝒞
                      %mo ⟶
                      %mi Set
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{C}}
                      \\;\colon\;
                      \\mathcal{C}^{op} \times \mathcal{C}
                      \\longrightarrow
                      Set
              %p
                for its
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
                %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Limits"}
                %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
                is a
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                in
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %p
                More in detail, let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℐ
                      %mo ⟶
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X_\bullet \colon \mathcal{I} \longrightarrow \mathcal{C}
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              %ol
                %li
                  %p
                    If the
                    %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %munder
                              %mi lim
                              %mo ⟵
                            %mi i
                          %msub
                            %mi X
                            %mi i
                        %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}_i X_i
                    exists in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    then for all
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
                    there is a
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mrow
                            %mo (
                            %mi Y
                            %mo ,
                            %msub
                              %munder
                                %mi lim
                                %mo ⟵
                              %mi i
                            %msub
                              %mi X
                              %mi i
                            %mo )
                          %mo ≃
                          %msub
                            %munder
                              %mi lim
                              %mo ⟵
                            %mi i
                          %mrow
                            %mo (
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mrow
                              %mo (
                              %mi Y
                              %mo ,
                              %msub
                                %mi X
                                %mi i
                              %mo )
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          Hom_{\mathcal{C}}\left(Y, \underset{\longleftarrow}{\lim}_i X_i \right)
                          \\simeq
                          \\underset{\longleftarrow}{\lim}_i \left( Hom_{\mathcal{C}}\left( Y, X_i \right) \right)
                          \\,,
                  %p
                    where on the right we have the limit over the diagram of
                    %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
                    given by
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi X
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mi ℐ
                          %mover
                            %mo ⟶
                            %mi X
                          %mi 𝒞
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi Y
                              %mo ,
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                          %mi Set
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          Hom_{\mathcal{C}}(Y,-) \circ X \;\colon\; \mathcal{I} \overset{X}{\longrightarrow} \mathcal{C} \overset{Hom_{\mathcal{C}}(Y,-)  }{\longrightarrow} Set\,.
                %li
                  %p
                    If the
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %munder
                              %mi lim
                              %mo ⟶
                            %mi i
                          %msub
                            %mi X
                            %mi i
                        %annotation{:encoding => "application/x-tex"} \underset{\longrightarrow}{\lim}_i X_i
                    exists in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    then for all
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
                    there is a
                    %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mrow
                            %mo (
                            %msub
                              %munder
                                %mi lim
                                %mo ⟶
                              %mi i
                            %msub
                              %mi X
                              %mi i
                            %mo ,
                            %mi Y
                            %mo )
                          %mo ≃
                          %msub
                            %munder
                              %mi lim
                              %mo ⟵
                            %mi i
                          %mrow
                            %mo (
                            %msub
                              %mi Hom
                              %mi 𝒞
                            %mrow
                              %mo (
                              %msub
                                %mi X
                                %mi i
                              %mo ,
                              %mi Y
                              %mo )
                            %mo )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          Hom_{\mathcal{C}}\left(\underset{\longrightarrow}{\lim}_i X_i ,Y\right)
                          \\simeq
                          \\underset{\longleftarrow}{\lim}_i \left( Hom_{\mathcal{C}}\left( X_i , Y\right) \right)
                          \\,,
                  %p
                    where on the right we have the limit over the diagram of
                    %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
                    given by
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %mi X
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %msup
                            %mi ℐ
                            %mi op
                          %mover
                            %mo ⟶
                            %mi X
                          %msup
                            %mi 𝒞
                            %mi op
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} )
                          %mi Set
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          Hom_{\mathcal{C}}(-,Y) \circ X \;\colon\; \mathcal{I}^{op} \overset{X}{\longrightarrow} \mathcal{C}^{op} \overset{Hom_{\mathcal{C}}(-,Y)  }{\longrightarrow} Set\,.
            .proof
              %h6#proof_4 Proof
              %p
                We give the proof of the first statement, the proof of the second statement is
                %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#OppositeCategory"}
              %p
                First observe that, by the very definition of
                %a.existingWikiWord{:href => "/nlab/show/limit"} limiting
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cones"} cones
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                into them are in natural bijection with the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cones
                      %mrow
                        %mo (
                        %mi Y
                        %mo ,
                        %msub
                          %mi X
                          %mo •
                        %mo )
                    %annotation{:encoding => "application/x-tex"} Cones\left(Y, X_\bullet \right)
                of cones over the diagram
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
                with tip
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Hom
                      %mrow
                        %mo (
                        %mi Y
                        %mo ,
                        %msub
                          %munder
                            %mi lim
                            %mo ⟵
                          %mi i
                        %msub
                          %mi X
                          %mi i
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mi Cones
                      %mrow
                        %mo (
                        %mi Y
                        %mo ,
                        %msub
                          %mi X
                          %mo •
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Hom\left(
                      Y,
                      \\underset{\longleftarrow}{\lim}_{i} X_i
                      \\right)
                      \\;\simeq\;
                      Cones\left(
                      Y, X_\bullet
                      \\right)
                      \\,.
              %p Hence it remains to show that there is also a natural bijection like so:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cones
                      %mrow
                        %mo (
                        %mi Y
                        %mo ,
                        %msub
                          %mi X
                          %mo •
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %munder
                          %mi lim
                          %mo ⟵
                        %mi i
                      %mrow
                        %mo (
                        %mi Hom
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %msub
                          %mi X
                          %mi i
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Cones\left(
                      Y,
                      X_\bullet
                      \\right)
                      \\;\simeq\;
                      \\underset{\longleftarrow}{\lim}_{i} \left( Hom(Y,X_i) \right)
                      \\,.
              %p Now, again by the very definition of limiting cones, a single element in the limit on the right is equivalently a cone of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mo *
                              %mtr
                                %mtd
                                %mtd
                                  %msup
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mrow
                                        %msub
                                          %mi const
                                          %mrow
                                            %msub
                                              %mi p
                                              %mi i
                                  %mo ↙
                                %mtd
                                %mtd
                                  %msup
                                    %mo ↘
                                    %mpadded{:width => "0"}
                                      %mrow
                                        %msub
                                          %mi const
                                          %mrow
                                            %msub
                                              %mi p
                                              %mi j
                              %mtr
                                %mtd
                                  %mi Hom
                                  %mo{:stretchy => "false"} (
                                  %mi Y
                                  %mo ,
                                  %msub
                                    %mi X
                                    %mi i
                                  %mo{:stretchy => "false"} )
                                %mtd
                                %mtd
                                  %munder
                                    %mo ⟶
                                    %mrow
                                      %msub
                                        %mi X
                                        %mi α
                                      %mo ∘
                                      %mo{:stretchy => "false"} (
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} )
                                %mtd
                                %mtd
                                  %mi Hom
                                  %mo{:stretchy => "false"} (
                                  %mi Y
                                  %mo ,
                                  %msub
                                    %mi X
                                    %mi j
                                  %mo{:stretchy => "false"} )
                          %mo }
                        %mrow
                          %mi i
                          %mo ,
                          %mi j
                          %mo ∈
                          %mi Obj
                          %mo{:stretchy => "false"} (
                          %mi ℐ
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi α
                          %mo ∈
                          %msub
                            %mi Hom
                            %mi ℐ
                          %mo{:stretchy => "false"} (
                          %mi i
                          %mo ,
                          %mi j
                          %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\array{
                      \&amp;&amp; \ast
                      \\\
                      \&amp; {}^{\mathllap{const_{p_i}}}\swarrow &amp;&amp; \searrow^{\mathrlap{const_{p_j}}}
                      \\\
                      Hom(Y,X_i)
                      \&amp;&amp; \underset{X_\alpha \circ (-)}{\longrightarrow} &amp;&amp;
                      Hom(Y,X_j)
                      }
                      \\right\}_{i, j \in Obj(\mathcal{I}), \alpha \in Hom_{\mathcal{I}}(i,j) }
                      \\,.
              %p
                This is equivalently for each object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ∈
                      %mi ℐ
                    %annotation{:encoding => "application/x-tex"} i \in \mathcal{I}
                a choice of morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Y
                      %mo →
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} p_i \colon Y \to X_i
                , such that for each pair of objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo ,
                      %mi j
                      %mo ∈
                      %mi ℐ
                    %annotation{:encoding => "application/x-tex"} i,j \in \mathcal{I}
                and each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo ∈
                      %msub
                        %mi Hom
                        %mi ℐ
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi j
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha \in Hom_{\mathcal{I}}(i,j)
                we have
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi α
                        %mo ∘
                        %msub
                          %mi p
                          %mi i
                        %mo =
                        %msub
                          %mi p
                          %mi j
                      %annotation{:encoding => "application/x-tex"} X_\alpha \circ p_i = p_j
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cones
                        %mrow
                          %mo (
                          %mi Y
                          %mo ,
                          %msub
                            %mi X
                            %mo •
                          %mo{:stretchy => "false"} }
                          %mo )
                      %annotation{:encoding => "application/x-tex"} Cones\left( Y, X_\bullet\} \right)
            #InitialAndTerminalObjectInTermsOfAdjunction.num_example
              %h6#example_4 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
                  and
                  %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                  in terms of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#Categories"}
              %ol
                %li
                  %p The following are equivalent:
                  %ol
                    %li
                      %p
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝒞
                            %annotation{:encoding => "application/x-tex"} \mathcal{C}
                        has a
                        %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                        (Def.
                        = succeed ");" do
                          %a.maruku-ref{:href => "#InitialObject"}
                    %li
                      %p
                        the unique
                        %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝒞
                              %mo →
                              %mo *
                            %annotation{:encoding => "application/x-tex"} \mathcal{C} \to \ast
                        (Def.
                        = succeed ")" do
                          %a.maruku-ref{:href => "#Functors"}
                        %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                        (Example
                        = succeed ")" do
                          %a.maruku-ref{:href => "#InitialCategoryAndTerminalCategory"}
                        %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                        (Def.
                        = succeed ")" do
                          %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
                      .maruku-equation
                        %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mo *
                              %munderover
                                %mo ⊥
                                %munder
                                  %mo ⟶
                                  %mrow
                                %mover
                                  %mo ⟵
                                  %mrow
                              %mi 𝒞
                            %annotation{:encoding => "application/x-tex"}
                              \\ast
                              \\underoverset
                              {\underset{}{\longrightarrow}}
                              {\overset{}{\longleftarrow}}
                              {\bot}
                              \\mathcal{C}
                  %p
                    Under this equivalence, the
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                    is identified with the image under the right adjoint of the unique object of the
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                %li
                  %p Dually, the following are equivalent:
                  %ol
                    %li
                      %p
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝒞
                            %annotation{:encoding => "application/x-tex"} \mathcal{C}
                        has an
                        %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                        (Def.
                        = succeed ");" do
                          %a.maruku-ref{:href => "#InitialObject"}
                    %li
                      %p
                        the unique
                        %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝒞
                              %mo →
                              %mo *
                            %annotation{:encoding => "application/x-tex"} \mathcal{C} \to \ast
                        to the
                        %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                        has a
                        %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                      .maruku-equation
                        %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi 𝒞
                              %munderover
                                %mo ⊥
                                %munder
                                  %mo ⟶
                                  %mrow
                                %mover
                                  %mo ⟵
                                  %mrow
                              %mo *
                            %annotation{:encoding => "application/x-tex"}
                              \\mathcal{C}
                              \\underoverset
                              {\underset{}{\longrightarrow}}
                              {\overset{}{\longleftarrow}}
                              {\bot}
                              \\ast
                  %p
                    Under this equivalence, the
                    %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                    is identified with the image under the left adjoint of the unique object of the
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
            .proof
              %h6#proof_5 Proof
              %p
                Since the unique
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                in the
                %a.existingWikiWord{:href => "/nlab/show/terminal+category"} terminal category
                is
                %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
                characterizing the
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                is directly the
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of an
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Hom
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{C}}( L(\ast) , X )
                      \\;\simeq\;
                      Hom_{\ast}( \ast, R(X) )
                      \=
                      \\ast
              %p
                or of a
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Hom
                        %mo *
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{C}}( X , R(\ast) )
                      \\;\simeq\;
                      Hom_{\ast}( L(X), \ast ) = \ast
                      \\,,
              %p respectively.
            #AdjointsPreserveCoLimits.num_prop
              %h6#proposition_2 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoints+preserve+colimits+and+right+adjoints+preserve+limits"}> left adjoints preserve colimits and right adjoints preserve limits
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi R
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒟
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} (L \dashv R) \colon \mathcal{D} \to \mathcal{C}
                be a pair of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi L
                        %annotation{:encoding => "application/x-tex"} L
                    %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                    all
                    %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Limits"}
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi R
                        %annotation{:encoding => "application/x-tex"} R
                    preserves all
                    %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Limits"}
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒟
                          %annotation{:encoding => "application/x-tex"} \mathcal{D}
            .proof
              %h6#proof_6 Proof
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo :
                      %mi I
                      %mo →
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} y : I \to \mathcal{D}
                be a
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                whose
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mrow
                          %msub
                            %mo ←
                            %mi i
                      %msub
                        %mi y
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \lim_{\leftarrow_i} y_i
                exists. Then we have a sequence of
                = succeed "s," do
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} x \in C
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi R
                              %msub
                                %mrow
                                  %munder
                                    %mi lim
                                    %mo ←
                                %mi i
                              %msub
                                %mi y
                                %mi i
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                              %msub
                                %mi Hom
                                %mi 𝒟
                              %mo{:stretchy => "false"} (
                              %mi L
                              %mi x
                              %mo ,
                              %msub
                                %mrow
                                  %munder
                                    %mi lim
                                    %mo ←
                                %mi i
                              %msub
                                %mi y
                                %mi i
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %msub
                                %mrow
                                  %munder
                                    %mi lim
                                    %mo ←
                                %mi i
                              %msub
                                %mi Hom
                                %mi 𝒟
                              %mo{:stretchy => "false"} (
                              %mi L
                              %mi x
                              %mo ,
                              %msub
                                %mi y
                                %mi i
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %msub
                                %mrow
                                  %munder
                                    %mi lim
                                    %mo ←
                                %mi i
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %mi R
                              %msub
                                %mi y
                                %mi i
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ,
                              %msub
                                %mrow
                                  %munder
                                    %mi lim
                                    %mo ←
                                %mi i
                              %mi R
                              %msub
                                %mi y
                                %mi i
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      Hom_{\mathcal{C}}(x, R {\lim_\leftarrow}_i y_i)
                      \&amp;  \simeq
                      Hom_{\mathcal{D}}(L x, {\lim_\leftarrow}_i y_i)
                      \\\
                      \&amp; \simeq
                      {\lim_\leftarrow}_i Hom_{\mathcal{D}}(L x, y_i)
                      \\\
                      \&amp; \simeq
                      {\lim_\leftarrow}_i Hom_{\mathcal{C}}( x, R y_i)
                      \\\
                      \&amp; \simeq
                      Hom_{\mathcal{C}}( x, {\lim_\leftarrow}_i R y_i)
                      \\,,
                      \\end{aligned}
              %p
                where we used the hom-isomorphism
                %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
                and the fact that any
                %a.existingWikiWord{:href => "/nlab/show/hom-functor+preserves+limits"} hom-functor preserves limits
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#HomFunctorPreservesLimits"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                the
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
                implies that we have an
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %msub
                        %mrow
                          %munder
                            %mi lim
                            %mo ←
                        %mi i
                      %msub
                        %mi y
                        %mi i
                      %mo ≃
                      %msub
                        %mrow
                          %munder
                            %mi lim
                            %mo ←
                        %mi i
                      %mi R
                      %msub
                        %mi y
                        %mi i
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      R {\lim_\leftarrow}_i y_i
                      \\simeq
                      {\lim_\leftarrow}_i R y_i
                      \\,.
              %p
                The argument that shows the preservation of colimits by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                is analogous.
            #LimitsCommuteWithLimits.num_prop
              %h6#proposition_3 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/limits+commute+with+limits"}> limits commute with limits
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}'
                be
                %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SmallCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Categories"}
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Limits"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                as well as
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                of shape
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒟
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} \mathcal{D}'
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒟
                      %mo ×
                      %mrow
                        %mi 𝒟
                        %mo ′
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{D} \times {\mathcal{D}'} \to \mathcal{C}
                a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                (hence a
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                of shape the
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                functors (via Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#GrpdIsACartesianClosedCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mi 𝒟
                        %mo ′
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi F
                            %mi 𝒟
                      %mo{:stretchy => "false"} [
                      %mi 𝒟
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                      %mphantom
                        %mi AAA
                      %mi 𝒟
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi F
                            %mrow
                              %mi 𝒟
                              %mo ′
                      %mo{:stretchy => "false"} [
                      %mrow
                        %mi 𝒟
                        %mo ′
                      %mo ,
                      %mi 𝒞
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      {\mathcal{D}'}
                      \\overset{F_{\mathcal{D}}}{\longrightarrow}
                      [\mathcal{D},\mathcal{C}]
                      \\phantom{AAA}
                      {\mathcal{D}}
                      \\overset{F_{\mathcal{D}'}}{\longrightarrow}
                      [{\mathcal{D}'},   \mathcal{C}]
              %p we have that the canonical comparison morphism
              #eq:ComparisonMorphismForCommutingLimits.maruku-equation
                %span.maruku-eq-number (55)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi lim
                      %mi F
                      %mo ≃
                      %msub
                        %mi lim
                        %mi 𝒟
                      %mo{:stretchy => "false"} (
