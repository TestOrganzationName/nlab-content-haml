                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      J_{Top^{\ast/}}
                      \=
                      \\left\{
                      D^n_+ \overset{(id, \delta_0)_+}{\longrightarrow} (D^n \times I)_+
                      \\right\}
                      \\;\;\;
