                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi I
                      %mo ,
                      %mi Top
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Top
                      %mo{:stretchy => "false"} )
