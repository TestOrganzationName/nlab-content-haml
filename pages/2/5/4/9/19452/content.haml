            #LeftHomotopyWithCofibrantDomainImpliesRightHomotopyAndDually.num_lemma
              %h6#lemma_4 Lemma
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f,g \colon X \to Y
                be two
                %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel morphisms
                in a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              %ol
                %li
                  %p
                    Let
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    be cofibrant. If there is a
                    %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %msub
                            %mo ⇒
                            %mi L
                          %mi g
                        %annotation{:encoding => "application/x-tex"} f \Rightarrow_L g
                    then there is also a
                    %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopy
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %msub
                            %mo ⇒
                            %mi R
                          %mi g
                        %annotation{:encoding => "application/x-tex"} f \Rightarrow_R g
                    (def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#LeftAndRightHomotopyInAModelCategory"}
                %li
                  %p
                    Let
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    be fibrant. If there is a
                    %a.existingWikiWord{:href => "/nlab/show/right+homotopy"} right homotopy
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %msub
                            %mo ⇒
                            %mi R
                          %mi g
                        %annotation{:encoding => "application/x-tex"} f \Rightarrow_R g
                    then there is also a
                    %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %msub
                            %mo ⇒
                            %mi L
                          %mi g
                        %annotation{:encoding => "application/x-tex"} f \Rightarrow_L g
                    with respect to any chosen cylinder object.
              %p
                In particular if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is cofibrant and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                is fibrant, then by going back and forth it follows that every left homotopy is exhibited by every cylinder object, and every right homotopy is exhibited by every path space object.
            .proof
              %h6#proof_6 Proof
              %p
                We discuss the first case, the second is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formally dual
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \eta \colon Cyl(X) \longrightarrow Y
                be the given left homotopy. Lemma
                %a.maruku-ref{:href => "#ComponentMapsOfCylinderAndPathSpaceInGoodSituation"}
                implies that we have a lift
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                    %annotation{:encoding => "application/x-tex"} h
                in the following
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
