              %h6#proof_3 Proof
              %p
                First of all, observe that we indeed have
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Functors"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⌊
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⌋
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} ⌈
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⌉
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi ℝ
                      %mo ⟶
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"}
                      \\lfloor(-)\rfloor \;,\;
                      \\lceil(-)\rceil
                      \\;\;\colon\;
                      \\mathbb{R}
                      \\longrightarrow
                      \\mathbb{Z}
              %p since floor and ceiling preserve the ordering relation.
              %p
                Now in view of the identification of
                %a.existingWikiWord{:href => "/nlab/show/preorders"} preorders
                with
                %a.existingWikiWord{:href => "/nlab/show/thin+categories"} thin categories
                in Example
                = succeed "," do
                  %a.maruku-ref{:href => "#PartiallyOrderedSetsAsSmallCategories"}
                %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
                defining
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ι
                      %mo ⊣
                      %mo{:stretchy => "false"} ⌊
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⌋
                    %annotation{:encoding => "application/x-tex"} \iota \dashv \lfloor(-)\rfloor
                says for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %munder
                          %mrow
                            %mi n
                            %mo ≤
                            %mo{:stretchy => "false"} ⌊
                            %mi x
                            %mo{:stretchy => "false"} ⌋
                          %mo ⏟
                        %mrow
                          %mo ∈
                          %mi ℤ
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⇔
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %munder
                          %mrow
                            %mi n
                            %mo ≤
                            %mi x
                          %mo ⏟
                        %mrow
                          %mo ∈
                          %mi ℝ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\underset
                      { \in \mathbb{Z}}
                      {\underbrace{n \leq \lfloor x \rfloor}}
                      \\;\;\;\Leftrightarrow\;\;\;
                      \\underset
                      { \in \mathbb{R}}
                      {\underbrace{n \leq x }}
                      \\,.
              %p
                This is clearly already the defining condition on the
                %a.existingWikiWord{:href => "/nlab/show/floor"} floor
                function
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⌊
                        %mi x
                        %mo{:stretchy => "false"} ⌋
                      %annotation{:encoding => "application/x-tex"} \lfloor x \rfloor
              %p
                Similarly, the hom-isomorphism defining
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} ⌈
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ⌉
                      %mo ⊣
                      %mi ι
                    %annotation{:encoding => "application/x-tex"} \lceil(-)\rceil \dashv \iota
                says that for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{R}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %munder
                          %mrow
                            %mo{:stretchy => "false"} ⌈
                            %mi x
                            %mo{:stretchy => "false"} ⌉
                            %mo ≤
                            %mi n
                          %mo ⏟
                        %mrow
                          %mo ∈
                          %mi ℤ
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⇔
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %munder
                        %munder
                          %mrow
                            %mi x
                            %mo ≤
                            %mi n
                          %mo ⏟
                        %mrow
                          %mo ∈
                          %mi ℝ
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\underset
                      { \in \mathbb{Z}}
                      {\underbrace{\lceil x \rceil \leq n}}
                      \\;\;\;\Leftrightarrow\;\;\;
                      \\underset
                      { \in \mathbb{R}}
                      {\underbrace{x \leq n }}
                      \\,.
              %p
                This is evidently already the defining condition on the
                %a.existingWikiWord{:href => "/nlab/show/floor"} floor
                function
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} ⌊
                        %mi x
                        %mo{:stretchy => "false"} ⌋
                      %annotation{:encoding => "application/x-tex"} \lfloor x \rfloor
              %p
                Notice that in both cases the condition of a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                in both variables, as required for an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≤
                      %mi x
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} x \leq x'
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                        %mo ′
                        %mo ≤
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n' \leq n
                %a.maruku-eqref{:href => "#eq:NaturalitySquareForAdjointnessOfFunctors"} (11)
                means, again in view of the identifications in Example
                = succeed "," do
                  %a.maruku-ref{:href => "#PartiallyOrderedSetsAsSmallCategories"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo ≤
                              %mo{:stretchy => "false"} ⌊
                              %mi x
                              %mo{:stretchy => "false"} ⌋
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⇔
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo ≤
                              %mi x
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo ⇓
                            %mtd
                            %mtd
                              %mo ⇓
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo ′
                              %mo ≤
                              %mo{:stretchy => "false"} ⌊
                              %mi x
                              %mo ′
                              %mo{:stretchy => "false"} ⌋
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⇔
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi n
                              %mo ′
                              %mo ≤
                              %mi x
                              %mo ′
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                          %mtr
                            %mtd
                              %mo ∈
                              %mi ℤ
                            %mtd
                            %mtd
                              %mo ∈
                              %mi ℝ
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (n \leq \lfloor x \rfloor) &amp;\Leftrightarrow&amp; (n \leq x)
                      \\\
                      \\Downarrow &amp;&amp; \Downarrow
                      \\\
                      (n' \leq \lfloor x' \rfloor) &amp;\Leftrightarrow&amp; (n' \leq x')
                      \\\
                      \\\
                      \\in \mathbb{Z} &amp;&amp; \in \mathbb{R}
                      }
              %p
                Here the logical implications are equivalently functions between
                %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                that are either
                %a.existingWikiWord{:href => "/nlab/show/empty+set"} empty
                or
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/singletons"} singletons
            #DiscreteTopologicalSpaces.num_example
              %h6#example_19 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/codiscrete+topological+spaces"} codiscrete topological spaces
              %p
                Consider the “
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"}> forgetful functor
                ”
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                      %mover
                        %mo ⟶
                        %mi U
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Top \overset{U}{\longrightarrow} Set
                from the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                of
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#ExamplesOfConcreteCategories"}
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryOfSets"}
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                to its underlying
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
              %p This has
              %ul
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Disc
                        %annotation{:encoding => "application/x-tex"} Disc
                    which equips a set with its
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi coDisc
                        %annotation{:encoding => "application/x-tex"} coDisc
                    which equips a set with the
                    = succeed "." do
                      %a.existingWikiWord{:href => "/nlab/show/codiscrete+topology"} codiscrete topology
              %p
                These hence form an
                %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
                (Remark
                = succeed ")" do
                  %a.maruku-ref{:href => "#AdjointTriples"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mspace{:width => "thickmathspace"}
                      %mo ⊣
                      %mspace{:width => "thickmathspace"}
                      %mi U
                      %mspace{:width => "thickmathspace"}
                      %mo ⊣
                      %mspace{:width => "thickmathspace"}
                      %mi coDisc
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Disc
                      \\;\dashv\;
                      U
                      \\;\dashv\;
                      coDisc
                      \\,.
              %p
                Hence the
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mo ⊣
                      %mi U
                    %annotation{:encoding => "application/x-tex"} Disc \dashv U
                and the
                %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊣
                      %mi coDisc
                    %annotation{:encoding => "application/x-tex"} U \dashv coDisc
                exhibit every
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
                on a given set as “in between the opposite extremes”
                %a.maruku-eqref{:href => "#eq:OppositeExtremesAdjointTriple"} (13)
                of the discrete and the co-discrete
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Disc
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mi ϵ
                      %mi X
                      %mover
                        %mo ⟶
                        %mi η
                      %mi coDisc
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Disc(U(X))
                      \\overset{\epsilon}{\longrightarrow}
                      X
                      \\overset{\eta}{\longrightarrow}
                      coDisc(U(X))
                      \\,.
            %p
            #ReExpressingMiddleFunctorInAdjointTriple.num_lemma
              %h6 Lemma
              %p
                %strong
                  (pre/post-
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                  with (
                  %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"}> co-
                  )
                  %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} unit
                  followed by
                  %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                  is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
                %br/
                If a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is the
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ⊣
                      %mi C
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mo ⟵
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %mi L
                                  %mphantom
                                    %mi AA
                          %mtr
                            %mtd
                              %munder
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %mi C
                                  %mphantom
                                    %mi AA
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"}
                      L \dashv C
                      \\;\;\colon\;\;
                      \\mathcal{C}
                      \\array{
                      \\overset{\phantom{AA} L \phantom{AA} }{\longleftarrow}
                      \\\
                      \\underset{\phantom{AA} C \phantom{AA} }{\longrightarrow}
                      }
                      \\mathcal{D}
              %p
                in a
                %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} pair
                of
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
                %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi f
                      %mi Y
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \overset{f}{\to} Y \;\;\in \mathcal{C}
                is equal to the joint operation of
                %a.existingWikiWord{:href => "/nlab/show/composition"} pre-composition
                with the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo ⊣
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (L \dashv C)
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi ϵ
                        %mi X
                        %mo ♭
                    %annotation{:encoding => "application/x-tex"} \epsilon^\flat_{X}
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#AdjunctionUnitFromHomIsomorphism"}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi L
                        %mo ⊣
                        %mi C
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (L \dashv C)
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mrow
                          %mi X
                          %mo ,
                          %mi Y
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mover
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ∘
                          %msubsup
                            %mi ϵ
                            %mi X
                            %mo ♭
                        %mo ˜
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      C_{X, Y}
                      \\;=\;
                      \\widetilde{ (-) \circ \epsilon^\flat_{X} }
                      \\,.
              %p
                Dually, if
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ⊣
                      %mi R
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %mi C
                                  %mphantom
                                    %mi AA
                          %mtr
                            %mtd
                              %munder
                                %mo ⟵
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %mi R
                                  %mphantom
                                    %mi AA
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"}
                      C \dashv R
                      \\;\;\colon\;\;
                      \\mathcal{C}
                      \\array{
