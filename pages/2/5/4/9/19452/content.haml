                      \\,,
              %p
                respectively, for the sets of morphisms obtained from the classical generating cofibrations, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalGeneratingCofibrations"}
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
                = succeed ")." do
                  %a.maruku-ref{:href => "#BasePointAdjoined"}
            #CofibrantGenerationOfPointedTopologicalSpaces.num_theorem
              %h6#theorem_3 Theorem
              %p
                The sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} I_{Top^{\ast/}}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} J_{Top^{\ast/}}
                in def.
                %a.maruku-ref{:href => "#GeneratingCofibrationsForPointedTopologicalSpaces"}
                exhibit the
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Top
                        %mi Quillen
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top^{\ast/}_{Quillen}
                of def.
                %a.maruku-ref{:href => "#ClassicalModelStructureOnPointedTopologicalSpaces"}
                as a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
                = succeed "." do
                  %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
            %p
              (This is also a special case of a general statement about cofibrant generation of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/coslice+model+structures"} coslice model structures
              = succeed ".)" do
                %a{:href => "model+structure+on+an+over+category#ModelStructureInheritsGoodProperties"} this proposition
            .proof
              %h6#proof_62 Proof
              %p
                Due to the fact that in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} J_{Top^{\ast/}}
                a basepoint is freely adjoined, lemma
                %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
                goes through verbatim for the pointed case, with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                    %annotation{:encoding => "application/x-tex"} J_{Top}
                replaced by
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mrow
                            %msup
                              %mi Top
                              %mrow
                                %mo *
                                %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} J_{Top^{\ast/}}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/point-set+topology"} point-set topology
                %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
                and lemma
                = succeed "." do
                  %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
                %a{:href => "#TheClassicalModelStructureOfTopologicalSpaces"} above
                in the proof of theorem
                = succeed "." do
                  %a.maruku-ref{:href => "#TopQuillenModelStructure"}
            %h3#ModelStructureOnCompactlyGeneratedTopologicalSpaces Model structure on compactly generated spaces
            %p
              The category
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              has the technical inconvenience that
              %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} X^Y
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CompactOpenTopology"}
              = succeed ")" do
                %a.maruku-ref{:href => "#MappingTopologicalSpaceIsExponentialObject"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              is not
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#SmashProductOfPointedObjects"}
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
                  is
                  %a.existingWikiWord{:href => "/nlab/show/associative"} associative
                  (prop.
                  %a.maruku-ref{:href => "#SmashProductInTopcgIsAssociative"}
                  below);
              %li
                %p
                  there is a concept of
                  %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functors"} topologically enriched functors
                  with values in topological spaces, to which we turn
                  = succeed ";" do
                    %a{:href => "#ModelStructureOnTopEnrichedFunctors"} below
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                  of
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
                  preserves
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/products"} products
            %p
              The first two of these are crucial for the development of
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
              in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1"} next section
            %p
              Now, since the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
              of topological spaces only cares about the
              %a.existingWikiWord{:href => "/nlab/show/CW+approximation"} CW approximation
              to any topological space (remark
              = succeed ")," do
                %a.maruku-ref{:href => "#EveryTopologicalSpaceWeaklyEquivalentToACWComplex"}
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              which still contains all
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed
            %p
              Such a full subcategory exists, the category of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
            %p
              %strong Literature
              (
              %a{:href => "#Strickland09"}> Strickland 09
              )
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            #kTop.num_defn
              %h6#definition_52 Definition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %p
                A subset
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A \subset X
                is called
                %strong compactly closed
                (or
                = succeed ")" do
                  %strong
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                    \-closed
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi K
                      %mo ⟶
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f \colon K \longrightarrow X
                out of a
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                %a.existingWikiWord{:href => "/nlab/show/Hausdorff+topological+space"} Hausdorff space
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^{-1}(A)
                is a
                %a.existingWikiWord{:href => "/nlab/show/closed+subset"} closed subset
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
              %p
                The space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is called
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+space"} compactly generated
                if its closed subsets exhaust (hence coincide with) the
                = succeed "-closed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
              %p Write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                      %mo ↪
                      %mi Top
                    %annotation{:encoding => "application/x-tex"}
                      Top_{cg} \hookrightarrow Top
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                of
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                on the compactly generated topological spaces.
            #kfication.num_defn
              %h6#definition_53 Definition
              %p Write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                      %mover
                        %mo ⟶
                        %mi k
                      %msub
                        %mi Top
                        %mi cg
                      %mo ↪
                      %mi Top
                    %annotation{:encoding => "application/x-tex"}
                      Top \overset{k}{\longrightarrow} Top_{cg} \hookrightarrow Top
              %p
                for the
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                which sends any
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X = (S,\tau)
                to the topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo ,
                      %mi k
                      %mi τ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (S, k \tau)
                with the same underlying set
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} k \tau
                the collection of all
                = succeed "-open" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi τ
                      %annotation{:encoding => "application/x-tex"} \tau
            #ContinuousFunctionsOutOfCompactlyGeneratedFactorThroughCompactlyGeneratedClosureOfCodomain.num_lemma
              %h6#lemma_24 Lemma
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %msub
                        %mi Top
                        %mi cg
                      %mo ↪
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} X \in Top_{cg} \hookrightarrow Top
                and let
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                        %mo ∈
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} Y\in Top
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      X \longrightarrow Y
              %p are also continuous when regarded as functions
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⟶
                      %mi k
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      X \longrightarrow k(Y)
              %p
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                from def.
                = succeed "." do
                  %a.maruku-ref{:href => "#kfication"}
            .proof
              %h6#proof_63 Proof
              %p
                We need to show that for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A \subset X
                a
                = succeed "-closed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f^{-1}(A) \subset X
                is closed subset.
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi K
                      %mo ⟶
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \phi \colon K \longrightarrow X
                be any continuous function out of a compact Hausdorff space
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
