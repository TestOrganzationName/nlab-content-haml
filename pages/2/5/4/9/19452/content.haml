                            %mi L
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \eta_c \;\colon\; c \to R(L(c))
                    = succeed "," do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} unit
              %p
                such that for any
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
