                            %mi n
                            %mi i
                    %annotation{:encoding => "application/x-tex"} p_{n_i} \colon D^{n_i} \times I \to D^{n_i}
                are strict left inverses to the inclusions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi id
                      %mo ,
                      %msub
                        %mi δ
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (id, \delta_0)
                gives a
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msup
                                %mi D
                                %mrow
                                  %msub
                                    %mi n
                                    %mi i
                            %mtd
                              %mo ⟶
                            %mtd
                              %msub
                                %mi X
                                %mi β
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %munder
                                      %mo ⊔
                                      %mrow
                                        %mi i
                                        %mo ∈
                                        %mi I
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ,
                                    %msub
                                      %mi δ
                                      %mn 0
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi id
                          %mtr
                            %mtd
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msup
                                %mi D
                                %mrow
                                  %msub
                                    %mi n
                                    %mi i
                              %mo ×
                              %mi I
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %munder
                                      %mo ⊔
                                      %mrow
                                        %mi i
                                        %mo ∈
                                        %mi I
                                    %msub
                                      %mi p
                                      %mrow
                                        %msub
                                          %mi n
                                          %mi i
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msup
                                %mi D
                                %mrow
                                  %msub
                                    %mi n
                                    %mi i
                            %mtd
                              %mo ⟶
                            %mtd
                              %msub
                                %mi X
                                %mi β
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\underset{i \in I}{\sqcup} D^{n_i}
                      \&amp;\longrightarrow&amp;
                      X_\beta
                      \\\
                      {}^{\mathllap{\underset{i \in I}{\sqcup} (id, \delta_0)} }\downarrow
                      \&amp;&amp;
                      \\downarrow^{\mathrlap{id}}
                      \\\
                      \\underset{i \in I}{\sqcup} D^{n_i} \times I
                      \\\
                      {}^{\mathllap{\underset{i \in I}{\sqcup} p_{n_i} }}\downarrow &amp;&amp; \downarrow
                      \\\
                      \\underset{i \in I}{\sqcup} D^{n_i}
                      \&amp;\longrightarrow&amp;
                      X_\beta
                      }
              %p
                and so the
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of the
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                (
                %a.existingWikiWord{:href => "/nlab/show/pushout"}> pushout
                )
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi β
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} X_{\beta + 1}
                gives a factorization of the identity morphism on the right through
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mrow
                          %mi β
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} X_{\beta + 1}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msup
                                %mi D
                                %mrow
                                  %msub
                                    %mi n
                                    %mi i
                            %mtd
                              %mo ⟶
                            %mtd
                              %msub
                                %mi X
                                %mi β
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %munder
                                      %mo ⊔
                                      %mrow
                                        %mi i
                                        %mo ∈
                                        %mi I
                                    %mo{:stretchy => "false"} (
                                    %mi id
                                    %mo ,
                                    %msub
                                      %mi δ
                                      %mn 0
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mrow
                          %mtr
                            %mtd
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi i
                                  %mo ∈
                                  %mi I
                              %msup
                                %mi D
                                %mrow
                                  %msub
                                    %mi n
                                    %mi i
                              %mo ×
                              %mi I
                            %mtd
                              %mo ⟶
                            %mtd
                              %msub
                                %mi X
                                %mrow
                                  %mi β
                                  %mo +
                                  %mn 1
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %munder
                                      %mo ⊔
                                      %mrow
                                        %mi i
