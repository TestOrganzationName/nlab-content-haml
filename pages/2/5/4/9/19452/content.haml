                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                to the
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                which sends a module
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi N
                      %mo ,
                      %mi ρ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (N,\rho)
                to the underlying object
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
