              %a.existingWikiWord{:href => "/nlab/show/reflective+localization"} reflective localization
              are reflections onto their
              %a.existingWikiWord{:href => "/nlab/show/full+subcategories"} full subcategories
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+objects"} local objects
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-categorical+hom-space"} hom-infinity-groupoids
            #SimplicialModelCategory.num_defn
              %h6#definition_5 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"}> simplicial model category
                  )
              %p
                An
                %em
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} sSet
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mrow
                            %mi Quillen
                        %annotation{:encoding => "application/x-tex"} {}_{Quillen}
                  %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
                or
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Categories"}
              %ol
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                    of an
                    = succeed "-" do
                      %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                    %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                    (Def.
                    %a.maruku-ref{:href => "#TopEnrichedCategory"}
                    via Example
                    = succeed ")," do
                      %a.maruku-ref{:href => "#UnderlyingCategoryOfTopEnrichedCategory"}
                    %a.existingWikiWord{:href => "/nlab/show/tensored+and+cotensored+category"} tensored and cotensored
                    over
                    %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#TensoringAndPoweringOfTopologicallyEnrichedCopresheaves"}
                  %p
                    (with
                    %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                    (Def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#sSet"}
                    %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                    of a
                    %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
                    from Prop.
                    = succeed "," do
                      %a.maruku-ref{:href => "#PropertiesOfSheafToposes"}
                    = succeed ")," do
                      %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/structure"} structure
                    of a
                    %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#ModelCategory"}
              %p such that these two structures are compatible in the following way:
              %ul
                %li
                  %p
                    for every
                    %a.existingWikiWord{:href => "/nlab/show/cofibration"} cofibration
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mover
                            %mo →
                            %mi f
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} X \overset{f}{\to} Y
                    and every
                    %a.existingWikiWord{:href => "/nlab/show/fibration"} fibration
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi A
                          %mover
                            %mo →
                            %mi g
                          %mi B
                        %annotation{:encoding => "application/x-tex"} A \overset{g}{\to} B
                    in
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    = succeed "-morphism" do
                      %a.existingWikiWord{:href => "/nlab/show/pullback+powering"} pullback powering
                    = succeed "-" do
                      %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
                  #eq:SimplicialModelCategoryComparisonMorphism.maruku-equation
                    %span.maruku-eq-number (98)
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                          %mo ⟶
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi A
                          %mo{:stretchy => "false"} )
                          %munder
                            %mo ×
                            %mrow
                              %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %mi B
                              %mo{:stretchy => "false"} )
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi Y
                          %mo ,
                          %mi B
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          \\mathcal{C}(Y,A)
                          \\longrightarrow
                          \\mathcal{C}(X,A)
                          \\underset{\mathcal{C}(X,B)}{\times}
                          \\mathcal{C}(Y,B)
                  %p
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                    (Def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#KanFibration"}
                    %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#WeakHomotopyEquivalence"}
                    %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                    in
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
            #InSimplicialModelCategoryEnrichedHomIsHomotopical.num_prop
              %h6#proposition_6 Proposition
              %p
                %strong
                  (in
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
                  %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
                  out of
                  %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant
                  into
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant
                  is
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/homotopical+functor"} homotopical functor
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#SimplicialModelCategory"}
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} Y \in \mathcal{C}
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cofibrant+object"} cofibrant object
                %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#EnrichedHomFunctor"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo ⟶
                      %msub
                        %mi sSet
                        %mi Qu
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}(Y,-)
                      \\;\colon\;
                      \\mathcal{C}
                      \\longrightarrow
                      sSet_{Qu}
              %p
                preserves
                %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/acyclic+fibrations"} acyclic fibrations
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} A \in \mathcal{C}
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fibrant+object"} fibrant object
                %a.existingWikiWord{:href => "/nlab/show/enriched+hom-functor"} enriched hom-functor
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#EnrichedHomFunctor"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ⟶
                      %msub
                        %mi sSet
                        %mi Qu
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}(-,A)
                      \\;\colon\;
                      \\mathcal{C}^{op}
                      \\longrightarrow
                      sSet_{Qu}
              %p
                sends
                %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                and
                %a.existingWikiWord{:href => "/nlab/show/acyclic+cofibrations"} acyclic cofibrations
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                to fibrations and acyclic fibrations, respectively, in the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
            .proof
              %h6#proof_4 Proof
              %p
                In the first case, consider the comparison morphism
                %a.maruku-eqref{:href => "#eq:SimplicialModelCategoryComparisonMorphism"} (98)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} X =\emptyset
                the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo =
                      %mo *
                    %annotation{:encoding => "application/x-tex"} B = \ast
                the
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#InitialObject"}
              %p
                Since
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/tensored+and+cotensored+category"} tensored and cotensored category
                %a.maruku-ref{:href => "#InTensoredCotensoredCategoryInitialObjectIsEnrichedInitial"}
                says that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi ∅
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mo *
                      %mphantom
                        %mi AA
                      %mtext and
                      %mphantom
                        %mi AA
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo *
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mi sSet
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}(\emptyset, -)
                      \\;\simeq\;
                      \\ast
                      \\phantom{AA}
                      \\text{and}
                      \\phantom{AA}
                      \\mathcal{C}(-,\ast)
                      \\;\ast\;
                      \\;\;\;
                      \\in sSet
                      \\,.
              %p This means that in the first case the comparison morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi A
                      %mo{:stretchy => "false"} )
                      %munder
                        %mo ×
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi B
                          %mo{:stretchy => "false"} )
                      %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}(Y,A)
                      \\longrightarrow
                      \\mathcal{C}(X,A)
                      \\underset{\mathcal{C}(X,B)}{\times}
                      \\mathcal{C}(Y,B)
              %p
                %a.maruku-eqref{:href => "#eq:SimplicialModelCategoryComparisonMorphism"} (98)
                becomes equal to the top morphism in the following diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi Y
                              %mo ,
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} (
                                  %mi Y
                                  %mo ,
                                  %mi g
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi Y
                              %mo ,
                              %mi B
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                            %mtd
                            %mtd
                              %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %munder
                                %mo ⟶
                                %mphantom
                                  %mi AAA
                            %mtd
                              %mo *
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\mathcal{C}(Y,A)
                      \&amp;\overset{\mathcal{C}(Y,g)}{\longrightarrow}&amp;
                      \\mathcal{C}(Y,B)
                      \\\
                      \\Big\downarrow
                      \&amp;&amp;
                      \\Big\downarrow
                      \\\
                      \\ast &amp;\underset{\phantom{AAA}}{\longrightarrow}&amp; \ast
                      }
              %p while in the second case it becomes equal to the left morphism in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi Y
                              %mo ,
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mover
                                %mo ⟶
                                %mphantom
                                  %mrow
                                    %mi 𝒞
                                    %mo{:stretchy => "false"} (
                                    %mi Y
                                    %mo ,
                                    %mi g
                                    %mo{:stretchy => "false"} )
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mi 𝒞
                                    %mo{:stretchy => "false"} (
                                    %mi f
                                    %mo ,
