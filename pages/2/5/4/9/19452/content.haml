            .proof
              %h6#proof_2 Proof
              %p We claim that
              %ol
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi Fib
                            %mi loc
                          %mo ⊂
                          %mi Fib
