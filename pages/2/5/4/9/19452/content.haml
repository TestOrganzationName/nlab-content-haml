                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-,-]
                (Prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#InternalHomBifunctor"}
                %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                in the second variable, and sends
                %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                in the first variable to limits:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %munder
                        %mi lim
                        %munder
                          %mo ⟵
                          %mrow
                            %mi j
                            %mo ∈
                            %mi 𝒥
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi j
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %munder
