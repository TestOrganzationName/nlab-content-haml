                          %mi i
                        %mo ,
                        %msub
                          %mi e
                          %mi i
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (E_i,\mu_i, e_i)
                = succeed ")" do
                  %a.maruku-ref{:href => "#BraidedMonoidalCategory"}
              %p
                Similarly one checks that for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 1
                      %mo =
                      %msub
                        %mi E
                        %mn 2
                      %mo =
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E_1 = E_2 = E
                then the unit maps
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                      %mo ≃
                      %mi E
                      %mo ⊗
                      %mn 1
                      %mover
                        %mo ⟶
                        %mrow
                          %mi id
