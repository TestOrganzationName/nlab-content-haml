                      %mo ⊗
                      %msub
                        %mi E
                        %mn 2
                      %mo ⊗
                      %msub
                        %mi E
                        %mn 1
                      %mo ⊗
                      %msub
                        %mi E
                        %mn 2
                      %mover
                        %mo ⟶
                        %mrow
                          %mi id
                          %mo ⊗
                          %msub
                            %mi τ
                            %mrow
                              %msub
                                %mi E
                                %mn 2
                              %mo ,
                              %msub
                                %mi E
                                %mn 1
                          %mo ⊗
                          %mi id
