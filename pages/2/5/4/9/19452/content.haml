            %p More generally:
            #QuillenAdjointTripleHomotopyKanExtension.num_example
              %h6#example_7 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjoint+triple"} Quillen adjoint triple
                  of
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extension
                  of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                be
                %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#SmallCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mover
                        %mo ⟶
                        %mrow
                          %mphantom
                            %mi AA
                          %mi F
                          %mphantom
                            %mi AA
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}
                      \\overset{\phantom{AA}F\phantom{AA}}{\longrightarrow}
                      \\mathcal{D}
              %p
                be a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                between them. By
                %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
                (Prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopologicalLeftKanExtensionBCoend"}
                %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched
                over
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
                %a.existingWikiWord{:href => "/nlab/show/adjoint+triple"} adjoint triple
                between
                %a.existingWikiWord{:href => "/nlab/show/categories+of+simplicial+presheaves"} categories of simplicial presheaves
                (Def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#CategoriesOfSimplicialPresheaves"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi sSet
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %munderover
                                %mo ⟶
                                %mo ⊥
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %msub
                                    %mi F
                                    %mo !
                                  %mphantom
                                    %mi AA
                          %mtr
                            %mtd
                              %munderover
                                %mo ⟵
                                %mo ⊥
                                %mrow
                                  %mphantom
                                    %mi AA
