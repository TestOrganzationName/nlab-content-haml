                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒞
                      %mo ,
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{cg}]
                its category of topologically enriched copresheaves from example
                = succeed "." do
                  %a.maruku-ref{:href => "#TopologicallyEnrichedFunctorsToTopk"}
              %ol
                %li
                  %p Define a functor
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} [
                          %mi 𝒞
                          %mo ,
                          %msub
                            %mi Top
                            %mi cg
                          %mo{:stretchy => "false"} ]
                          %mo ×
                          %msub
                            %mi Top
                            %mi cg
                          %mo ⟶
                          %mo{:stretchy => "false"} [
                          %mi 𝒞
                          %mo ,
                          %msub
                            %mi Top
                            %mi cg
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"}
                          (-)\cdot(-)
                          \\;\colon\;
                          [\mathcal{C}, Top_{cg}] \times Top_{cg}
                          \\longrightarrow
                          [\mathcal{C}, Top_{cg}]
                  %p
                    by forming objectwise
                    %a.existingWikiWord{:href => "/nlab/show/cartesian+products"} cartesian products
                    (hence
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi k
                        %annotation{:encoding => "application/x-tex"} k
                    of
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"} product topological spaces
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo ⋅
                          %mi X
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mi c
                          %mo ↦
                          %mi F
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mi X
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          F \cdot X \;\colon\; c \mapsto F(c) \times X
                          \\,.
                  %p
                    This is called the
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/tensoring"} tensoring
