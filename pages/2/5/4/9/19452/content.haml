            .proof
              %h6#proof_15 Proof
              %p
                We discuss the first case, the second is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
                %a.maruku-ref{:href => "#UniversalPropertyOfHomotopyCategoryOfAModelCategory"}
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
