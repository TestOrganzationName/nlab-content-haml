                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
                = succeed ":" do
                  %a.maruku-ref{:href => "#RightLiftingProperty"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi Cof
                            %mi cl
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi I
                            %mi Top
                          %mi Inj
                      %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f
                      \\;\colon\;
                      X
                      \\stackrel{\in Cof_{cl}}{\longrightarrow}
                      \\hat X
                      \\stackrel{\in I_{Top} Inj}{\longrightarrow}
                      Y
                      \\,.
              %p
                By lemma
                %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
                the map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \hat X \to Y
                is both a
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                as well as a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
            #ContinuousFunctionsFactorAsQuillenAcyclicCofibrationFollowedBySerreFibration.num_lemma
              %h6#lemma_22 Lemma
              %p
                Every morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f\colon X \longrightarrow Y
                in
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                factors as an acyclic classical cofibration followed by a fibration, def.
                = succeed ":" do
                  %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi W
                            %mi cl
                          %mo ∩
                          %msub
                            %mi Cof
                            %mi cl
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi Fib
                            %mi cl
                      %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f
                      \\;\colon\;
                      X
                      \\stackrel{\in W_{cl} \cap Cof_{cl}}{\longrightarrow}
                      \\hat X
                      \\stackrel{\in Fib_{cl}}{\longrightarrow}
                      Y
                      \\,.
            .proof
              %h6#proof_53 Proof
              %p
                By lemma
                %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
                the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi J
                        %mi Top
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi D
                        %mi n
                      %mo ↪
                      %msup
                        %mi D
                        %mi n
                      %mo ×
                      %mi I
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} J_{Top} = \{D^n \hookrightarrow D^n\times I\}
                of topological
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/generating+acyclic+cofibrations"} generating acyclic cofibrations
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
                %a.maruku-ref{:href => "#ClassOfMorphismsWithSmallDomains"}
                (the
                %a.existingWikiWord{:href => "/nlab/show/n-disks"} n-disks
                are
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
                = succeed "," do
                  %a.maruku-ref{:href => "#SmallObjectArgument"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                factors as an
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalCCellComplex"}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi top
                      %annotation{:encoding => "application/x-tex"} J_{top}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/injective+morphisms"} injective morphisms
                = succeed ":" do
                  %a.maruku-ref{:href => "#RightLiftingProperty"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi J
                            %mi Top
                          %mi Cell
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi J
                            %mi Top
                          %mi Inj
                      %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f
                      \\;\colon\;
                      X
                      \\stackrel{\in J_{Top} Cell}{\longrightarrow}
                      \\hat X
                      \\stackrel{\in J_{Top} Inj}{\longrightarrow}
                      Y
                      \\,.
              %p
                By definition this makes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} \hat X \to Y
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %p
                By lemma
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrationsAreRelativeCellComplexes"}
                a relative
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} I_{Top}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} X \to \hat X
                is a classical cofibration. By lemma
                %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
                it is also a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
            #LiftingPropertyInTheClassicalModelStructureOnTopologicalSpaces.num_lemma
              %h6#lemma_23 Lemma
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
                in
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                with the left morphism a classical cofibration and the right morphism a fibration, def.
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                              %mo ⟶
                            %mtd
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mfrac{:linethickness => "0"}
                                    %mrow
                                      %mrow
                                        %mi g
                                        %mo ∈
                                    %mrow
                                      %mrow
                                        %msub
                                          %mi Cof
                                          %mi cl
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mfrac{:linethickness => "0"}
                                    %mrow
                                      %mrow
                                        %mi f
                                        %mo ∈
                                    %mrow
                                      %msub
                                        %mi Fib
                                        %mi cl
                          %mtr
                            %mtd
                            %mtd
                              %mo ⟶
                            %mtd
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;\longrightarrow&amp;
                      \\\
                      {}^{\mathllap{{g \in} \atop {Cof_{cl}}}}\downarrow &amp;&amp; \downarrow^{\mathrlap{{f \in }\atop Fib_{cl}}}
                      \\\
                      \&amp;\longrightarrow&amp;
                      }
              %p
                admits a
                %a.existingWikiWord{:href => "/nlab/show/lift"} lift
                as soon as one of the two is also a classical weak equivalence.
            .proof
              %h6#proof_54 Proof
              %p
                %strong A)
                If the fibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is also a weak equivalence, then lemma
                %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
                says that it has the right lifting property against the generating cofibrations
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} I_{Top}
                %a.maruku-ref{:href => "#SaturationOfGeneratingCofibrations"}
                implies the claim.
              %p
                %strong B)
                If the cofibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                on the left is also a weak equivalence, consider any factorization into a relative
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalCCellComplex"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi J
                            %mi Top
                          %mi Cell
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi Fib
                            %mi cl
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      g \;\colon\; \stackrel{\in J_{Top} Cell}{\longrightarrow} \stackrel{\in Fib_{cl}}{\longrightarrow}
                      \\,,
              %p
                as in the proof of lemma
                = succeed "." do
                  %a.maruku-ref{:href => "#ContinuousFunctionsFactorAsQuillenAcyclicCofibrationFollowedBySerreFibration"}
                %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
                the morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi J
                            %mi Top
                          %mi Cell
                    %annotation{:encoding => "application/x-tex"} \overset{\in J_{Top} Cell}{\longrightarrow}
                is a weak homotopy equivalence, and so by
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#QuillenWeakEquivalencesSatisfyTwoOutOfThree"}
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                against the cofibration
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                itself, and so the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
                %a.maruku-ref{:href => "#RetractArgument"}
                gives that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                is a
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
                of a relative
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                %a.maruku-ref{:href => "#SaturationOfGeneratingCofibrations"}
                implies that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                has the
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                against
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
            %p Finally:
            #LiftingExhausted.num_prop
              %h6#proposition_34 Proposition
              %p
                The systems
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Cof
                        %mi cl
                      %mo ,
                      %msub
                        %mi W
                        %mi cl
                      %mo ∩
                      %msub
                        %mi Fib
                        %mi cl
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (Cof_{cl} , W_{cl} \cap Fib_{cl})
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi W
                        %mi cl
                      %mo ∩
                      %msub
                        %mi Cof
                        %mi cl
                      %mo ,
                      %msub
                        %mi Fib
                        %mi cl
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (W_{cl} \cap Cof_{cl}, Fib_{cl})
                from def.
                %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
                are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/weak+factorization+systems"} weak factorization systems
            .proof
              %h6#proof_55 Proof
              %p
                Since we have already seen the factorization property (lemma
                = succeed "," do
                  %a.maruku-ref{:href => "#FactorizationInTopQuillen"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#ContinuousFunctionsFactorAsQuillenAcyclicCofibrationFollowedBySerreFibration"}
                = succeed ")," do
                  %a.maruku-ref{:href => "#LiftingPropertyInTheClassicalModelStructureOnTopologicalSpaces"}
              %p
                For the classical fibrations this is by definition, for the the classical acyclic fibrations this is by lemma
                = succeed "." do
                  %a.maruku-ref{:href => "#AcyclicSerreFibrationsAreTheJTopFibrations"}
              %p
                The remaining statement for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Cof
                        %mi cl
                    %annotation{:encoding => "application/x-tex"} Cof_{cl}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mi cl
                      %mo ∩
                      %msub
                        %mi Cof
                        %mi cl
                    %annotation{:encoding => "application/x-tex"} W_{cl}\cap Cof_{cl}
                follows from a general argument (
                %a{:href => "cofibrantly+generated+model+category#RetractsOfCellComplexesExchaustLLPOfRLP"}> here
                ) for
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+categories"} cofibrantly generated model categories
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
              %p
                So let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
                be in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi I
                          %mi Top
                        %mi Inj
                        %mo{:stretchy => "false"} )
                        %mi Proj
                      %annotation{:encoding => "application/x-tex"} (I_{Top} Inj) Proj
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is a retract (remark
                = succeed ")" do
                  %a.maruku-ref{:href => "#RetractsOfMorphisms"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
                %a.existingWikiWord{:href => "/nlab/show/small+object"} small object
                argument as in lemma
                %a.maruku-ref{:href => "#FactorizationInTopQuillen"}
                to factor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                as
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi I
                            %mi Top
                          %mi Cell
                      %mover
                        %mi Y
                        %mo{:stretchy => "false"} ^
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi I
                            %mi Top
                          %mi Inj
                      %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f \;\colon \; X \overset{I_{Top} Cell}{\longrightarrow} \hat Y \overset{\in I_{Top} Inj}{\longrightarrow} Y
                      \\,.
              %p
                It follows that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                has the
                %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
                against
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi Y
                          %mo{:stretchy => "false"} ^
                        %mo →
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} \hat Y \to Y
                %a.existingWikiWord{:href => "/nlab/show/retract+argument"} retract argument
                (lemma
                = succeed ")" do
                  %a.maruku-ref{:href => "#RetractArgument"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mover
                          %mo →
                          %mrow
                            %mi I
                            %mi Cell
                        %mover
                          %mi Y
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} X \overset{I Cell}{\to} \hat Y
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Cof
                          %mi cl
                      %annotation{:encoding => "application/x-tex"} Cof_{cl}
              %p
                The analogous argument for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi W
                          %mi cl
                        %mo ∩
                        %msub
                          %mi Cof
                          %mi cl
                      %annotation{:encoding => "application/x-tex"} W_{cl} \cap Cof_{cl}
                %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ∈
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi J
                        %mi Top
                      %mi Inj
                      %mo{:stretchy => "false"} )
                      %mi Proj
                    %annotation{:encoding => "application/x-tex"} f \in (J_{Top} Inj) Proj
                is a retract of a
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrationsAreRelativeCellComplexes"}
                and lemma
                %a.maruku-ref{:href => "#JTopRelativeCellComplexesAreWeakHomotopyEquivalences"}
                a
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi J
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} J_{Top}
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mi Top
                      %annotation{:encoding => "application/x-tex"} I_{Top}
                = succeed "." do
                  %a.maruku-ref{:href => "#RetractPreservesIsomorphism"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is an acyclic cofibration.
            %p
              In conclusion, prop.
              %a.maruku-ref{:href => "#QuillenWeakEquivalencesSatisfyTwoOutOfThree"}
              and prop.
              %a.maruku-ref{:href => "#LiftingExhausted"}
              say that:
            #TopQuillenModelStructure.num_theorem
              %h6#theorem_2 Theorem
              %p
                The classes of morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi Top
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Mor(Top)
                of def.
                = succeed "," do
                  %a.maruku-ref{:href => "#ClassesOfMorhismsInTopQuillen"}
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi W
                            %mi cl
                          %mo =
                        %annotation{:encoding => "application/x-tex"} W_{cl} =
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalences"} weak homotopy equivalences
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Fib
                            %mi cl
                          %mo =
                        %annotation{:encoding => "application/x-tex"} Fib_{cl} =
                    %a.existingWikiWord{:href => "/nlab/show/Serre+fibrations"} Serre fibrations
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Cof
                            %mi cl
                          %mo =
                        %annotation{:encoding => "application/x-tex"} Cof_{cl} =
                    %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                    of
                    %a.existingWikiWord{:href => "/nlab/show/relative+cell+complexes"} relative cell complexes
              %p
                define a
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                structure (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ModelCategory"}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi Quillen
                      %annotation{:encoding => "application/x-tex"} Top_{Quillen}
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
                or
                %strong Serre-Quillen model structure
                \.
            %p In particular
            %ol
              %li
                %p
                  every object in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi Quillen
                      %annotation{:encoding => "application/x-tex"} Top_{Quillen}
                  is fibrant;
              %li
                %p
                  the cofibrant objects in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi Quillen
                      %annotation{:encoding => "application/x-tex"} Top_{Quillen}
                  are the
                  %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
            %p Hence in particular the following classical statement is an immediate corollary:
            #WhiteheadTheorem.num_cor
              %h6#corollary_4 Corollary
              %p
                %strong (Whitehead theorem)
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#WeakHomotopyEquivalenceOfTopologicalSpaces"}
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                that are
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphic
                to a
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
                of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
                (def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#TopologicalCellComplex"}
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                (def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#HomotopyEquivalence"}
            .proof
              %h6#proof_56 Proof
              %p
                This is the “Whitehead theorem in model categories”, lemma
                = succeed "," do
                  %a.maruku-ref{:href => "#WhiteheadTheoremInModelCategories"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} Top_{Quillen}
                via theorem
                = succeed "." do
                  %a.maruku-ref{:href => "#TopQuillenModelStructure"}
            %p
              In proving theorem
              %a.maruku-ref{:href => "#TopQuillenModelStructure"}
              we have in fact shown a bit more that stated. Looking back, all the structure of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi Quillen
                  %annotation{:encoding => "application/x-tex"} Top_{Quillen}
              is entirely induced by the set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} I_{Top}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalGeneratingCofibrations"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mi Top
                  %annotation{:encoding => "application/x-tex"} J_{Top}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TopologicalGeneratingAcyclicCofibrations"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              (Def.
              = succeed ")." do
                %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
            %p
              This phenomenon will keep recurring and will keep being useful as we construct further model categories, such as the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+pointed+topological+spaces"} classical model structure on pointed topological spaces
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#ClassicalModelStructureOnPointedTopologicalSpaces"}
              %a.existingWikiWord{:href => "/nlab/show/projective+model+structure+on+enriched+functors"} projective model structure on topological functors
              (thm.
              = succeed ")," do
                %a.maruku-ref{:href => "#ProjectiveModelStructureOnTopologicalFunctors"}
              %a.existingWikiWord{:href => "/nlab/show/model+structures+on+spectra"} model structures on spectra
              which we turn to in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1"} section on stable homotopy theory
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %h3#TheClassicalHomotopyCategory The classical homotopy category
            %p
              With the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              in hand, we now have good control over the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
            #ClassicalHomotopyCategory.num_defn
              %h6#definition_45 Definition
              %p
                The
                %strong
                  Serre-Quillen
                  %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
                is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
                = succeed "," do
                  %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi Quillen
                    %annotation{:encoding => "application/x-tex"} Top_{Quillen}
                from theorem
                = succeed ":" do
                  %a.maruku-ref{:href => "#TopQuillenModelStructure"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi Top
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi Quillen
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Ho(Top) \coloneqq Ho(Top_{Quillen})
                      \\,.
            #EveryTopologicalSpaceWeaklyEquivalentToACWComplex.num_remark
              %h6#remark_23 Remark
              %p
                From just theorem
                = succeed "," do
                  %a.maruku-ref{:href => "#TopQuillenModelStructure"}
                %a.maruku-ref{:href => "#HomotopyCategoryOfAModelCategory"}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ClassicalHomotopyCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi Quillen
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mrow
                          %mi Retract
                          %mo{:stretchy => "false"} (
                          %mi Cell
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %annotation{:encoding => "application/x-tex"}
                      Ho(Top_{Quillen}) \simeq (Top_{Retract(Cell)})/_\sim
              %p
                is the category whose objects are
                %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                of
                %a.existingWikiWord{:href => "/nlab/show/cell+complexes"} cell complexes
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopologicalCellComplex"}
                %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              %p
                Theorem
                %a.maruku-ref{:href => "#TopQuillenModelStructure"}
                in itself implies that every topological space is weakly equivalent to a
                %a.existingWikiWord{:href => "/nlab/show/retract"} retract
                of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/cell+complex"} cell complex
                = succeed "." do
                  %a.maruku-ref{:href => "#TopologicalCellComplex"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/CW+approximations"} CW approximations
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/CW+complex"} CW complex
              %p
                (Better yet, there is
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
                to the
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
                which implies a
                %em functorial
                %a.existingWikiWord{:href => "/nlab/show/CW+approximation"} CW approximation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Sing
                        %mi X
                        %mo{:stretchy => "false"} |
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∈
                          %msub
                            %mi W
                            %mi cl
                      %mi X
                    %annotation{:encoding => "application/x-tex"} {\vert Sing X\vert} \overset{\in W_{cl}}{\longrightarrow} X
                given by forming the
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                of the
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
                of
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %p
                Hence the Serre-Quillen
                %a.existingWikiWord{:href => "/nlab/show/classical+homotopy+category"} classical homotopy category
                is also equivalently the category of just the
                %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
                whith
                %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
                of
                %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
                between them
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %mi Ho
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi Top
                                %mi Quillen
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi Top
                                %mrow
                                  %mi Retract
                                  %mo{:stretchy => "false"} (
                                  %mi Cell
                                  %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} /
                                %mo ∼
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi Top
                                %mi CW
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo{:stretchy => "false"} /
                                %mo ∼
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      Ho(Top_{Quillen}) &amp; \simeq (Top_{Retract(Cell)})/_\sim
                      \\\
                      \&amp; \simeq (Top_{CW})/_{\sim}
                      \\end{aligned}
                      \\,.
              %p
                It follows that the
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of the homotopy category (theorem
                = succeed ")" do
                  %a.maruku-ref{:href => "#UniversalPropertyOfHomotopyCategoryOfAModelCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi Quillen
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mi Top
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi W
                        %mi cl
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      Ho(Top_{Quillen}) \simeq Top[W_{cl}^{-1}]
              %p
                implies that there is a bijection, up to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              %ol
                %li
                  %p
                    functors out of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Top
                            %mi CW
                        %annotation{:encoding => "application/x-tex"} Top_{CW}
                    which agree on homotopy-equivalent maps;
                %li
                  %p
                    functors out of all of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Top
                        %annotation{:encoding => "application/x-tex"} Top
                    which send weak homotopy equivalences to isomorphisms.
              %p
                This statement in particular serves to show that two different axiomatizations of
                %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
                theories are equivalent to each other. See at
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+S"} Introduction to Stable homotopy theory – S
                the section
                %em
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#GeneralizedHomologyAndCohomologyFunctors"} generalized cohomology functors
                (
                %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#HomotopyTheoreticVersionOfCohomologyFunctorDefIsEquivalent"}> this prop.
                )
              %p
                %strong Beware
                that, by remark
                = succeed "," do
                  %a.maruku-ref{:href => "#NotEveryHomotopyEquivalenceIsAWeakHomotopyEquivalence"}
                %strong not
                equivalent to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi Quillen
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Ho(Top_{Quillen})
                is the category
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hTop
                      %mo ≔
                      %mi Top
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %annotation{:encoding => "application/x-tex"}
                      hTop \coloneqq Top/_\sim
              %p
                obtained from
                %em all
                topological spaces with morphisms the homotopy classes of continuous functions. This category is “too large”, the correct homotopy category is just the genuine
                %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mi Quillen
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Top
                        %mrow
                          %mi Retract
                          %mo{:stretchy => "false"} (
                          %mi Cell
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mo ≃
                      %mi Top
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mo =
                      %mo ↪
                      %mi hTop
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Ho(Top_{Quillen})
                      \\simeq
                      (Top_{Retract(Cell)})/_\sim
                      \\simeq
                      Top/_\sim
                      \=
                      \\hookrightarrow hTop
                      \\,.
              %p
                Beware also the ambiguity of terminology: “classical homotopy category” some literature refers to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hTop
                    %annotation{:encoding => "application/x-tex"} hTop
                instead of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi Top
                          %mi Quillen
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho(Top_{Quillen})
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hTop
                    %annotation{:encoding => "application/x-tex"} hTop
                and will not mention it again.
            #TopologicalCylinderOnCWComplexIsGoodCylinderObject.num_prop
              %h6#proposition_35 Proposition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
                = succeed "." do
                  %a.maruku-ref{:href => "#TopologicalCellComplex"}
                %a.maruku-ref{:href => "#TopologicalInterval"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊔
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
