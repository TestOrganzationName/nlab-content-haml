            #QuillenAdjunctionInducesAdjunctionOnHomotopyCategories.num_prop
              %h6#proposition_10 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/derived+adjunction"}> derived adjunction
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %munderover
                        %mrow
                          %msub
                            %mrow
                            %mphantom
                              %mi Qu
                          %msub
                            %mo ⊥
                            %mi Qu
                        %munder
                          %mo ⟶
                          %mi R
                        %mover
                          %mo ⟵
                          %mi L
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} \underoverset{\underset{R}{\longrightarrow}}{\overset{L}{\longleftarrow}}{{}_{\phantom{Qu}}\bot_{Qu}}\mathcal{D}
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                = succeed "," do
                  %a.maruku-ref{:href => "#QuillenAdjunction"}
                %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
                (Def.
                = succeed "," do
                  %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
                = succeed ")" do
                  %a.maruku-ref{:href => "#LeftAndRightDerivedFunctors"}
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ⟶
                          %mrow
                            %mi ℝ
                            %mi R
                        %mover
                          %mo ⟵
                          %mrow
                            %mi 𝕃
                            %mi L
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒟
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Ho(\mathcal{C})
                      \\underoverset
                      {\underset{\mathbb{R}R}{\longrightarrow}}
                      {\overset{\mathbb{L}L}{\longleftarrow}}
                      {\bot}
                      Ho(\mathcal{D})
                      \\,.
              %p
                Moreover, the
                %a.existingWikiWord{:href => "/nlab/show/adjunction+unit"} adjunction unit
                and
                %a.existingWikiWord{:href => "/nlab/show/adjunction+counit"} adjunction counit
                of this derived adjunction are the images of the
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
                and
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DerivedAdjunctionUnit"}
                %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                functors (Theorem
                = succeed ")." do
                  %a.maruku-ref{:href => "#UniversalPropertyOfHomotopyCategoryOfAModelCategory"}
            %p
              (
              %a{:href => "model+category#Quillen67"}> Quillen 67, I.4 theorem 3
              )
            .proof
              %h6#proof_18 Proof
              %p
                For the first statement, by def.
                %a.maruku-ref{:href => "#LeftAndRightDerivedFunctorsOnModelCategories"}
                and lemma
                %a.maruku-ref{:href => "#HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory"}
                it is sufficient to see that for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X, Y \in \mathcal{C}
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                cofibrant and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                fibrant, then there is a
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              #eq:HomIsomorphismForDerivedQuillenAdjunctionOnHomotopyCategory.maruku-equation
                %span.maruku-eq-number (93)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mo ≃
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi R
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{C}}(L X , Y)/_\sim
                      \\simeq
                      Hom_{\mathcal{C}}(X, R Y)/_\sim
                      \\,.
              %p
                Since by the
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjunction isomorphism
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo ⊣
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (L \dashv R)
                such a natural bijection exists before passing to homotopy classes
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %msub
                          %mo{:stretchy => "false"} /
                          %mo ∼
                      %annotation{:encoding => "application/x-tex"} (-)/_\sim
                %a.maruku-ref{:href => "#LeftRightQuillenFunctorsPreserveCyclinderPathSpaceObjects"}
                that with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cyl(Y)
                a
                %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} Y
                = succeed "," do
                  %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} L(Cyl(Y))
                is a cylinder object for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} L(Y)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %msub
                        %mo ⇒
                        %mi L
                      %mi g
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi L
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      (f \Rightarrow_L g) \;\colon\;  L X \longrightarrow Y
              %p given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi η
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi L
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      \\eta \;\colon\; Cyl(L X) =  L Cyl(X) \longrightarrow Y
              %p are in bijection to left homotopies
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %msub
                        %mo ⇒
                        %mi L
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ˜
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mo ⟶
                      %mi R
                      %mi Y
                    %annotation{:encoding => "application/x-tex"}
