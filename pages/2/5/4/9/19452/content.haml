              %em
                %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with respect to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \Delta^\bullet
            #SingularSimplicialComplex.num_defn
              %h6#definition_70 Definition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
