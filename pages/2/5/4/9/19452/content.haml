                      }
              %p
                (using fibrant and
                %a.existingWikiWord{:href => "/nlab/show/fibrant+replacement"} fibrant/cofibrant replacement functors
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
