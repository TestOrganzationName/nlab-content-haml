                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                              %msub
                                %mo ×
                                %mi X
                              %mi Path
                              %mo ′
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi p
                                      %mn 0
                                    %mo ,
                                    %msub
                                      %mi p
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi X
                              %mo ×
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi Δ
                                  %mo ∘
                                  %msub
                                    %mi pr
                                    %mn 1
                            %mtd
                              %mi X
                              %mo ×
                              %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X
                      \&amp;\overset{i}{\longrightarrow}&amp;
                      Path(X)
                      \&amp;\stackrel{\overset{\Delta}{\longrightarrow}}{\underset{(s\circ p_0,s \circ p_0)}{\longrightarrow}}&amp;
                      Path(X)\times_X Path'(X)
                      \\\
                      \&amp;&amp; {}^{\mathllap{(p_0,p_1)}}\downarrow &amp;&amp; \downarrow^{\mathrlap{}}
                      \\\
                      \&amp;&amp; X\times X &amp;\overset{\Delta \circ pr_1}{\longrightarrow}&amp; X \times X
                      }
                      \\,.
            %h3#HomotopyPullbacks Homotopy pullbacks
            %p
              The concept of
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fibers"} homotopy fibers
              of def.
              %a.maruku-ref{:href => "#HomotopyFiber"}
              is a special case of the more general concept of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
            #RightProperModelCategory.num_defn
              %h6#definition_25 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/proper+model+category"}> proper model category
                  )
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ModelCategory"}
              %ul
                %li
                  %p
                    a
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/right+proper+model+category"} right proper model category
                    if
                    %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                    along
                    %a.existingWikiWord{:href => "/nlab/show/fibrations"} fibrations
                    preserves
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                %li
                  %p
                    a
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper model category
                    if
                    %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                    along
                    %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                    preserves
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
                %li
                  %p
                    a
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/proper+model+category"} proper model category
                    if it is both left and right proper.
            .num_example
              %h6#example_9 Example
              %p
                By lemma
                = succeed "," do
