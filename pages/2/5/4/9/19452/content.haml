                      }
                      \\,,
              %p
                where the other three squares are induced by the
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                of the pushout, as is the identification of the middle horizontal composite as the identity on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} A'
                = succeed "," do
                  %a.maruku-ref{:href => "#ClosurePropertiesOfInjectiveAndProjectiveMorphisms"}
                %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                so is the middle bottom vertical morphism.
              %p Thus the previous case now gives that the bottom left vertical morphism is a weak equivalence, and hence the total left vertical composite is.
            #RetractArgument.num_lemma
              %h6#lemma_2 Lemma
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/retract+argument"}> retract argument
                  )
              %p
                Consider a
                %a.existingWikiWord{:href => "/nlab/show/composition"} composite
                morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mover
                        %mo ⟶
                        %mi i
                      %mi A
                      %mover
                        %mo ⟶
                        %mi p
                      %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      f \;\colon\;
                      X \stackrel{i}{\longrightarrow} A \stackrel{p}{\longrightarrow} Y
                      \\,.
              %ol
                %li
                  %p
                    If
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                    has the
                    %a.existingWikiWord{:href => "/nlab/show/left+lifting+property"} left lifting property
                    against
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/retract"} retract
                    of
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                          %annotation{:encoding => "application/x-tex"} i
                %li
                  %p
                    If
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                    has the
                    %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                    against
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi i
                          %annotation{:encoding => "application/x-tex"} i
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/retract"} retract
                    of
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi p
                          %annotation{:encoding => "application/x-tex"} p
            .proof
              %h6#proof_4 Proof
              %p
                We discuss the first statement, the second is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
              %p
                Write the factorization of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                as a
                %a.existingWikiWord{:href => "/nlab/show/commuting+square"} commuting square
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mi i
                            %mtd
                              %mi A
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi f
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi p
                          %mtr
                            %mtd
                              %mi Y
                            %mtd
                              %mo =
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X &amp;\stackrel{i}{\longrightarrow}&amp; A
                      \\\
                      {}^{\mathllap{f}}\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                      \\\
                      Y &amp;= &amp; Y
                      }
                      \\,.
              %p
                By the assumed
                %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                against
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                there exists a diagonal filler
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
                making a
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mover
                                %mo ⟶
                                %mi i
                            %mtd
                              %mi A
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi f
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi g
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi p
                          %mtr
                            %mtd
                              %mi Y
                            %mtd
                              %mo =
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X &amp;\stackrel{i}{\longrightarrow}&amp; A
                      \\\
                      {}^{\mathllap{f}}\downarrow &amp;{}^{\mathllap{g}}\nearrow&amp; \downarrow^{\mathrlap{p}}
                      \\\
                      Y &amp;= &amp; Y
                      }
                      \\,.
              %p By rearranging this diagram a little, it is equivalent to
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                              %mi X
                            %mtd
                              %mo =
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi f
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi i
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mi Y
                              %mo{:lspace => "verythinmathspace"} :
                            %mtd
                              %mi Y
                            %mtd
                              %munder
                                %mo ⟶
                                %mi g
                            %mtd
                              %mi A
                            %mtd
                              %munder
                                %mo ⟶
                                %mi p
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp; X &amp;=&amp; X
                      \\\
                      \&amp; {}^{\mathllap{f}}\downarrow
                      \&amp;&amp;
                      {}^{\mathllap{i}}\downarrow
                      \\\
                      id_Y \colon &amp; Y &amp;\underset{g}{\longrightarrow}&amp; A &amp;\underset{p}{\longrightarrow}&amp;
                      Y
                      }
                      \\,.
              %p
                Completing this to the right, this yields a diagram exhibiting the required retract according to remark
                = succeed ":" do
                  %a.maruku-ref{:href => "#RetractsOfMorphisms"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi id
                                %mi X
                              %mo{:lspace => "verythinmathspace"} :
                            %mtd
                              %mi X
                            %mtd
                              %mo =
                            %mtd
                              %mi X
                            %mtd
                              %mo =
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi f
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi i
                              %mo{:stretchy => "false"} ↓
