                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo{:stretchy => "false"} /
                      %mi R
                    %annotation{:encoding => "application/x-tex"} c/R
                (by Example
                = succeed ")." do
