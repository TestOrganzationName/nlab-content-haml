                    = succeed ")." do
                      %a.maruku-ref{:href => "#PresheavesAdjointQuadrupleOnSiteWithTerminalObject"}
                %li
                  %p
                    For every
                    %a.existingWikiWord{:href => "/nlab/show/covering"} covering
                    family
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
