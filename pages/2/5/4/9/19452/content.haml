                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo →
                        %mi ϕ
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} X \overset{\phi}{\to} \mathbb{R}
                to the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                between smooth manifolds to the
                %a.existingWikiWord{:href => "/nlab/show/algebra+homomorphism"} algebra homomorphism
                that is given by
