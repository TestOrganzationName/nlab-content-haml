              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              functor of def.
              = succeed "." do
                %a.maruku-ref{:href => "#SingularSimplicialComplex"}
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              of this functor, called
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              %a.existingWikiWord{:href => "/nlab/show/n-simplices"} n-simplices
              with the standard topological
              = succeed "-simplex." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p This is an example of a general abstract phenomenon:
