                      \\coloneqq
                      \\mathbb{L}\underset{\longrightarrow}{\lim}_I
                      \\;\colon\;
                      Ho([I,Top])
                      \\longrightarrow
                      Ho(Top)
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi hocolim
