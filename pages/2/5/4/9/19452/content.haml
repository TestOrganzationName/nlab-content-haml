                                      %mrow
                                        %mo ∈
                                        %mi K
                                    %mpadded{:width => "0"}
                                      %mi f
                              %mtr
                                %mtd
                                  %msub
                                    %mi B
                                    %mi s
                                %mtd
                                  %mo ⟶
                                %mtd
                                  %mi Y
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo }
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\left\{
                      \\;\;\;\;\;\;\;\;\;
                      \\array{
                      A_s &amp;\longrightarrow&amp; X
                      \\\
                      {}^{\mathllap{i_s}}_{\mathllap{\in K Proj}}\downarrow
                      \&amp;&amp;
                      \\downarrow^{\mathrlap{f}}_{\mathrlap{\in K}}
                      \\\
                      B_s
                      \&amp;\longrightarrow&amp;
                      Y
                      }
                      \\;\;\;\;
                      \\right\}_{s\in S}
                      \\,.
              %p
                By assumption, each of these has a lift
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℓ
                          %mi s
                      %annotation{:encoding => "application/x-tex"} \ell_s
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %mo {
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mi A
                                    %mi s
                                %mtd
                                  %mo ⟶
                                %mtd
                                  %mi X
                              %mtr
                                %mtd
