                      \\,.
            %p The above discussion proves the following:
            #SmallObjectArgument.num_prop
              %h6#proposition_3 Proposition
              %p
                %strong (small object argument)
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small category
                with all small
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ⊂
                      %mi Mor
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C\subset Mor(\mathcal{C})
                of morphisms has all small domains in the sense of def.
                = succeed "," do
                  %a.maruku-ref{:href => "#ClassOfMorphismsWithSmallDomains"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
