            #ReflectiveSubcategory.num_defn
              %h6#definition_19 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Categories"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mover
                        %mo ↪
                        %mrow
                          %mphantom
                            %mi AA
                          %mi ι
                          %mphantom
                            %mi AA
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}
                      \\overset{\phantom{AA}\iota \phantom{AA}}{\hookrightarrow}
                      \\mathcal{D}
              %p
                a
                = succeed "-inclusion" do
                  %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
                Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#FullyFaithfulFunctor"}
              %ol
                %li
                  %p
                    a
