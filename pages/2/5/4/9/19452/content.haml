                      \\\
                      {}^{\mathllap{\iota_n}}\downarrow &amp;(po)&amp; \downarrow
                      \\\
                      D^n &amp;\longrightarrow&amp; X \underset{S^{n-1}}{\sqcup} D^n &amp; = X \cup_\phi D^n
                      }
              %p
                along some
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                      %annotation{:encoding => "application/x-tex"} \phi
              %p
                A continuous function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
                is called a
                %strong
                  topological
                  %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
                if it is exhibited by a (possibly infinite) sequence of cell
                %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attachments
                to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/transfinite+composition"} transfinite composition
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TransfiniteComposition"}
                %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#PushoutInTop"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %munder
                                %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                                %mi i
