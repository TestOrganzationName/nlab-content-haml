                                        %msub
                                          %mi δ
                                          %mn 1
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; Y
                      \\\
                      \&amp; {}^{\mathllap{f}}\nearrow &amp; \uparrow^{\mathrlap{X^{\delta_0}}}
                      \\\
                      X &amp;\stackrel{\eta}{\longrightarrow}&amp; Y^I
                      \\\
                      \&amp; {}_{\mathllap{g}}\searrow &amp; \downarrow^{\mathrlap{Y^{\delta_1}}}
                      \\\
                      \&amp;&amp; Y
                      }
                      \\,.
            %h3#cell_complexes Cell complexes
            %p
              We consider topological spaces that are built consecutively by
              %a.existingWikiWord{:href => "/nlab/show/attaching+space"} attaching
              basic cells.
            #TopologicalGeneratingCofibrations.num_defn
              %h6#definition_38 Definition
              %p Write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                      %mo ≔
                      %msub
                        %mrow
                          %mo {
                          %msup
                            %mi S
                            %mrow
                              %mi n
                              %mo −
                              %mn 1
                          %mover
                            %mo ↪
                            %mrow
