                      \\,.
            %p
              Also the key
              %a.existingWikiWord{:href => "/nlab/show/hom-functor+preserves+limits"} respect
              of the
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              for
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              is inherited by
              = succeed "-functors" do
                %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            #InternalHomPreservesLimits.num_prop
              %h6#proposition_3 Proposition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                  preserves
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed monoidal category
                with
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
                %a.existingWikiWord{:href => "/nlab/show/bifunctor"} bifunctor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
