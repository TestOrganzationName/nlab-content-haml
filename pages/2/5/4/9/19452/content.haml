                          %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi Quillen
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi proj
                    %annotation{:encoding => "application/x-tex"} [\mathbb{N}^{\leq}, (Top^{\ast/}_{cg})_{Quillen}]_{proj}
                from def.
                = succeed "," do
                  %a.maruku-ref{:href => "#ProjectiveModelStructureOnNSequencesOfTopologicalSpaces"}
              %ol
                %li
                  %p
                    The
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                    functor preserves fibrations between sequences of
                    %a.existingWikiWord{:href => "/nlab/show/relative+cell+complex"} relative cell complex
                    inclusions;
                %li
                  %p
                    Let
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi I
                        %annotation{:encoding => "application/x-tex"} I
                    be a
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/finite+category"} finite category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi D
                            %mo •
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo{:lspace => "verythinmathspace"} :
                          %mi I
                          %mo →
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi ℕ
                            %mo ≤
                          %mo ,
                          %msub
                            %mi Top
                            %mi cg
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} D_\bullet(-) \colon I \to [\mathbb{N}^{\leq}, Top_{cg}]
                    be a finite
                    %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                    of sequences of relative cell complexes. Then there is a
                    %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
