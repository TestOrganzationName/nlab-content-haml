                                %mi i
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi i
                              %mi X
                              %mo }
                            %mrow
                              %mi i
                              %mo ∈
                              %mi I
                        %annotation{:encoding => "application/x-tex"} \left\{ U_i \overset{\iota_i}{\to} X \right\}_{i \in I}
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    and every
                    %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Y
                          %mover
                            %mo ⟶
                            %mi f
                          %mi X
                        %annotation{:encoding => "application/x-tex"} Y \overset{f}{\longrightarrow} X
                    there exists a
                    %em refining covering
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mrow
                              %mo {
                              %msub
                                %mi V
                                %mi j
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi j
                              %mi Y
                              %mo }
                            %mrow
                              %mi j
                              %mo ∈
                              %mi J
                        %annotation{:encoding => "application/x-tex"} \left\{ V_j \overset{\iota_j}{\to} Y \right\}_{j \in J}
                    of
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi Y
                          %annotation{:encoding => "application/x-tex"} Y
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi j
                          %mo ∈
                          %mi J
                        %annotation{:encoding => "application/x-tex"} j \in J
                    there exists
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                        %annotation{:encoding => "application/x-tex"} i \in I
                    and a morphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi V
