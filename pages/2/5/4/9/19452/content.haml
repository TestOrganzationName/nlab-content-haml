                                      %mrow
                                        %mi x
                                        %mo ,
                                        %mi y
                          %mtr
                            %mtd
                              %msub
                                %mi F
                                %mn 1
                              %mo{:stretchy => "false"} (
                              %mi x
                              %msub
                                %mo ⊗
