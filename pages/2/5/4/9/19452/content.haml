                constitute a
                %a.existingWikiWord{:href => "/nlab/show/cone"} cone
                over the
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                of the
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi R
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} R(d)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
