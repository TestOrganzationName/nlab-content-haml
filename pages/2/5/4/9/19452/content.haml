            #PushoutProductInTopCGSendsCofCofToCof.num_prop
              %h6#proposition_46 Proposition
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/pushout-product"} pushout-product
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#kTop"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Cof
                        %mi cl
                      %mo □
                      %msub
                        %mi Cof
                        %mi cl
                      %mo ⊂
                      %msub
                        %mi Cof
                        %mi cl
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Cof_{cl} \Box Cof_{cl} \subset Cof_{cl}
                      \\,.
              %p If one of them is acyclic, then so is the pushout-product:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Cof
                        %mi cl
                      %mo □
                      %mo{:stretchy => "false"} (
                      %msub
