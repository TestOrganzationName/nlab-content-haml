            .proof
              %h6#proof_3 Proof
              %p
                We discuss the case of limits, the other case is
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#OppositeCategory"}
              %p
                Observe that there is a canonical
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EquivalenceOfCategories"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi 𝒟
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} Set
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mo{:stretchy => "false"} [
                      %mi 𝒟
                      %mo ×
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{D}, [\mathcal{C}^{op}, \Set]]
                      \\simeq
                      [\mathcal{D} \times \mathcal{C}^{op}, Set]
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                      %mo ×
                      %msup
                        %mi 𝒞
                        %mi op
                    %annotation{:encoding => "application/x-tex"} \mathcal{D} \times \mathcal{C}^{op}
                is the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/product+category"} product category
              %p
                This makes manifest that a
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒟
                      %mo →
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} F \;\colon\; \mathcal{D} \to [\mathcal{C}^{op}, Set]
                is equivalently a
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
