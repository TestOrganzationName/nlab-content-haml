                                %mrow
                                  %mi f
                                  %mo ′
                            %mtd
                              %mi B
                              %mo ′
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\overset{f}{\longrightarrow}&amp; B
                      \\\
                      {}^{\mathllap{a}}\downarrow
                      \&amp;&amp;
                      \\downarrow^{\mathrlap{b}}
                      \\\
                      A' &amp;\underset{f'}{\longrightarrow}&amp; B'
                      }
                      \\;\;\;\;\;
                      \\in Ho(\mathcal{C})
              %p
                be a commuting square in the homotopy category. Writing the same symbols for fibrant-cofibrant objects in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and for morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                representing these, then this means that in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                there is a
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                              %mi B
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi i
                                      %mn 1
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi b
                          %mtr
                            %mtd
                              %mi Cyl
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munder
                                %mo ⟶
                                %mi η
                            %mtd
                              %mi B
                              %mo ′
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi i
                                      %mn 0
                              %mo{:stretchy => "false"} ↑
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↑
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mi f
                                    %mo ′
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %munder
                                %mo ⟶
                                %mi a
                            %mtd
                              %mi A
                              %mo ′
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\overset{f}{\longrightarrow}&amp; B
                      \\\
                      {}^{\mathllap{i_1}}\downarrow &amp;&amp; \downarrow^{\mathrlap{b}}
                      \\\
                      Cyl(A) &amp;\underset{\eta}{\longrightarrow}&amp; B'
                      \\\
                      {}^{\mathllap{i_0}}\uparrow &amp;&amp; \uparrow^{\mathrlap{f'}}
                      \\\
                      A &amp;\underset{a}{\longrightarrow}&amp; A'
                      }
                      \\,.
              %p
                Consider the factorization of the top square here through the
                %a.existingWikiWord{:href => "/nlab/show/mapping+cylinder"} mapping cylinder
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mi f
                            %mtd
                              %mi B
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi i
                                      %mn 1
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi po
                              %mo{:stretchy => "false"} )
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi W
                          %mtr
                            %mtd
                              %mi Cyl
                              %mo{:stretchy => "false"} (
                              %mi A
                              %mo{:stretchy => "false"} )
                            %mtd
                              %munder
                                %mo ⟶
                                %mrow
                            %mtd
                              %mi Cyl
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi i
                                      %mn 0
                              %mo{:stretchy => "false"} ↑
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi η
                              %mo ↘
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                            %mtd
                              %mi B
                              %mo ′
                          %mtr
                            %mtd
                            %mtd
                              %msub
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi a
                              %mo ↘
                            %mtd
                              %msub
                                %mo{:stretchy => "false"} ↑
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mi f
                                    %mo ′
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mi A
                              %mo ′
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\overset{f}{\longrightarrow}&amp; B
                      \\\
                      {}^{\mathllap{i_1}}\downarrow &amp;(po)&amp; \downarrow^{\mathrlap{\in W}}
                      \\\
                      Cyl(A) &amp;\underset{}{\longrightarrow}&amp; Cyl(f)
                      \\\
                      {}^{\mathllap{i_0}}\uparrow &amp;{}_{\mathllap{\eta}}\searrow&amp; \downarrow^{\mathrlap{}}
                      \\\
                      A &amp;&amp; B'
                      \\\
                      \&amp; {}_{\mathllap{a}}\searrow &amp; \uparrow_{\mathrlap{f'}}
                      \\\
                      \&amp;&amp; A'
                      }
              %p
                This exhibits the composite
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi i
                            %mn 0
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} A \overset{i_0}{\to} Cyl(A) \to Cyl(f)
                as an alternative representative of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Ho
                        %mo{:stretchy => "false"} (
                        %mi 𝒞
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Ho(\mathcal{C})
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi B
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} Cyl(f) \to B'
                as an alternative representative for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                      %annotation{:encoding => "application/x-tex"} b
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                            %mtd
                              %mi Cyl
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi a
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi A
                              %mo ′
                            %mtd
                              %munder
                                %mo ⟶
                                %mrow
                                  %mi f
                                  %mo ′
                            %mtd
                              %mi B
                              %mo ′
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      A &amp;\overset{}{\longrightarrow}&amp; Cyl(f)
