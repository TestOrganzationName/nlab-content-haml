                  %p
                    This is called the
                    %strong
                      %a.existingWikiWord{:href => "/nlab/show/powering"} powering
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi 𝒞
                          %mo ,
                          %msub
                            %mi Top
                            %mi cg
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} [\mathcal{C}, Top_{cg}]
                    over
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi Top
                              %mi cg
                          %annotation{:encoding => "application/x-tex"} Top_{cg}
              %p
                Analogously, for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                a pointed
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
                = succeed "," do
                  %a.maruku-ref{:href => "#TopEnrichedCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
