                                %mtd
                                  %mo ≃
                                %mtd
                                  %mi Ho
                                  %mo{:stretchy => "false"} (
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %munder
                                    %mo ⟶
                                    %mrow
                                      %mi Ho
                                      %mo{:stretchy => "false"} (
                                      %mi F
                                      %mo{:stretchy => "false"} )
                                %mtd
                                  %mi Ho
                                  %mo{:stretchy => "false"} (
                                  %mi 𝒟
                                  %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \&amp; \mathcal{C}_c &amp;\hookrightarrow&amp; \mathcal{C} &amp;\overset{F}{\longrightarrow}&amp; \mathcal{D}
                          \\\
