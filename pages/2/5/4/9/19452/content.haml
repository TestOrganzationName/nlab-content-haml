                                  %msub
                                    %mi X
                                    %mrow
                                      %mn 0
                                      %mo ,
                                      %mn 1
                            %mtd
                              %msub
                                %mi X
                                %mn 1
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi X
                                    %mrow
                                      %mn 1
                                      %mo ,
                                      %mn 2
                            %mtd
                              %msub
                                %mi X
                                %mn 2
