                    %semantics
                      %mrow
                        %mi R
                      %annotation{:encoding => "application/x-tex"} R
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence
                  (Def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EquivalenceOfCategories"}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                        %mo ⊣
                        %mi R
                      %annotation{:encoding => "application/x-tex"} L \dashv R
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
                  (Def.
                  = succeed ")." do
                    %a.maruku-ref{:href => "#AdjointEquivalenceOfCategories"}
            #LeftAdjointFunctorPreservesEpi.num_prop
              %h6#proposition_10 Proposition
              %p
                %strong
                  (right/left
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
                  preserve
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                  %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
                  and
                  = succeed "/" do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/initial+objects"} initial objects
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
                functor (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
              %ol
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/terminal+objects"} terminal objects
                    (Def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#InitialObject"}
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/monomorphisms"} monomorphisms
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Monomorphism"}
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                functor (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#AdjointFunctorsInTermsOfNaturalBijectionOfHomSets"}
              %ol
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/initial+objects"} initial objects
                    (Def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#InitialObject"}
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
                    (Def.
                    = succeed ")." do
                      %a.maruku-ref{:href => "#Monomorphism"}
            .proof
              %h6#proof_10 Proof
              %p
                This is immediate from the adjunction hom-isomorphism
                = succeed "," do
                  %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
              %p
                We consider the first case, the second is
                %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
                (Example
                = succeed ")." do
                  %a.maruku-ref{:href => "#OppositeCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo →
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} R \;\colon\; \mathcal{C} \to \mathcal{D}
                be a
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint+functor"} right adjoint functor
                with
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi L
                      %annotation{:encoding => "application/x-tex"} L
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \ast \in \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#InitialObject"}
                %a.existingWikiWord{:href => "/nlab/show/object"} object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
                the
                %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒟
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %mo *
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{D}}(d,R(\ast)) \simeq \ast
                is a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
                we have a
                %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒹
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo ,
                              %mi R
                              %mo{:stretchy => "false"} (
                              %mo *
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mo *
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %mo *
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      Hom_{\mathcal{d}}(d,R(\ast))
                      \&amp; \simeq
                      Hom_{\mathcal{C}}(L(d), \ast)
                      \\\
                      \&amp; \simeq \ast
                      \\,,
                      \\end{aligned}
              %p
                where in the last step we used that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
                is a terminal object, by assumption.
              %p
                Next let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 1
                      %mover
                        %mo ↪
                        %mi f
                      %msub
                        %mi c
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} c_1 \overset{f}{\hookrightarrow} c_2
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} d \in \mathcal{D}
                any
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
                %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
                out of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                yields a monomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒟
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi Hom
                        %mi 𝒟
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ↪
                      %msub
                        %mi Hom
                        %mi 𝒟
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{D}}(d, R(f))
                      \\;\colon\;
                      Hom_{\mathcal{D}}(d, R(c_1))
                      \\hookrightarrow
                      Hom_{\mathcal{D}}(d, R(c_2))
                      \\,.
              %p
                Now consider the following
                %a.existingWikiWord{:href => "/nlab/show/naturality+square"} naturality square
                %a.maruku-eqref{:href => "#eq:NaturalitySquareForAdjointnessOfFunctors"} (11)
                of the adjunction hom-isomorphism
                = succeed ":" do
                  %a.maruku-eqref{:href => "#eq:HomIsomorphismForAdjointFunctors"} (10)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒟
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo ,
                              %mi R
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi c
                                %mn 1
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %msub
                                %mi c
                                %mn 1
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %msub
                                      %mi Hom
                                      %mi 𝒟
                                    %mo{:stretchy => "false"} (
                                    %mi d
                                    %mo ,
                                    %mi R
                                    %mo{:stretchy => "false"} (
                                    %mi f
                                    %mo{:stretchy => "false"} )
                                    %mo{:stretchy => "false"} )
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                            %mtd
                            %mtd
                              %msubsup
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                                %mpadded{:width => "0"}
                                  %mi mono
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi Hom
                                      %mi 𝒞
                                    %mo{:stretchy => "false"} (
                                    %mi L
                                    %mo{:stretchy => "false"} (
                                    %mi d
                                    %mo{:stretchy => "false"} )
                                    %mo ,
                                    %mi f
                                    %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒟
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo ,
                              %mi R
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi c
                                %mn 2
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ≃
                            %mtd
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi L
                              %mo{:stretchy => "false"} (
                              %mi d
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %msub
                                %mi c
                                %mn 2
                              %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      Hom_{\mathcal{D}}(d, R(c_1))
                      \&amp;\simeq&amp;
                      Hom_{\mathcal{C}}(L(d), c_1)
                      \\\
                      {}^{ \mathllap{ Hom_{\mathcal{D}}(d,R(f)) } }\big\downarrow
                      \&amp;&amp;
                      \\big\downarrow^{ \mathrlap{ Hom_{\mathcal{C}}( L(d),f ) } }_{\mathrlap{mono}}
                      \\\
                      Hom_{\mathcal{D}}(d, R(c_2))
                      \&amp;\simeq&amp;
                      Hom_{\mathcal{C}}(L(d), c_2)
                      }
              %p
                Here the right vertical
                %a.existingWikiWord{:href => "/nlab/show/function"} function
                is an
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/injective+function"} injective function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                and the definition of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒹
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi R
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{d}}(d,R(f))
                is an injection.
            %p
              But the main preservation property of
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              is that
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/adjoints+preserve+%28co-%29limits"} adjoints preserve (co-)limits
              %a.maruku-ref{:href => "#AdjointsPreserveCoLimits"}
              below, after introducing
              %a.existingWikiWord{:href => "/nlab/show/limits"} limits
              and
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              in Def.
              %a.maruku-ref{:href => "#Limits"}
              below.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Prop.
              %a.maruku-ref{:href => "#AdjointnessInTermsOfHomIsomorphismEquivalentToAdjunctionInCat"}
              says that
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              are equivalenty “
              %a.existingWikiWord{:href => "/nlab/show/adjunctions"} adjunctions
              in
              = succeed "\u201D," do
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            #Strict2Categories.num_defn
              %h6#definition_14 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/strict+2-category"}> strict 2-category
                  )
              %p
                A
                %em
                  %a.existingWikiWord{:href => "/nlab/show/strict+category"} strict category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                is
              %ol
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/class"} class
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi Obj
                              %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} Obj_{\mathcal{C}}
                    = succeed ";" do
                      %em
                        class of
                        %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                %li
                  %p
                    for each
                    %a.existingWikiWord{:href => "/nlab/show/pair"} pair
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ,
                          %mi Y
                          %mo ∈
                          %msub
                            %mi Obj
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} X,Y \in Obj_{\mathcal{C}}
                    of
                    = succeed "," do
                      %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                    %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi Y
                          %mo{:stretchy => "false"} )
                          %mo ∈
                          %mi Cat
                        %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}}(X,Y) \in Cat
                    (Def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#SmallCategory"}
                    = succeed "." do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/hom-category"} hom-category
                        from
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi X
                            %annotation{:encoding => "application/x-tex"} X
                        to
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
                              %mi Y
                            %annotation{:encoding => "application/x-tex"} Y
                  %p
                    We denote the
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                    of this
                    %a.existingWikiWord{:href => "/nlab/show/hom-category"} hom-category
                    by arrows like this:
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mover
                            %mo ⟶
                            %mi f
                          %mi Y
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ∈
                          %msub
                            %mi Obj
                            %mrow
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mi X
                              %mo ,
                              %mi Y
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          X \overset{f}{\longrightarrow} Y \;\;\in Obj_{Hom_{\mathcal{C}}(X,Y)}
                  %p
                    and call them the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                    of
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                  %p
                    and we denote the
                    %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                    in the
                    %a.existingWikiWord{:href => "/nlab/show/hom-category"} hom-category
                    by double arrows, like this:
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %munderover
                            %mrow
                              %mo ⇓
                              %msup
                                %mrow
                                %mpadded{:width => "0"}
                                  %mi ϕ
                            %munder
                              %mo ⟶
                              %mi g
                            %mover
                              %mo ⟶
                              %mi f
                          %mi Y
                        %annotation{:encoding => "application/x-tex"}
                          X
                          \\underoverset
                          {\underset{g}{\longrightarrow}}
                          {\overset{f}{\longrightarrow}}
                          {\Downarrow{}^{\mathrlap{\phi}}}
                          Y
                  %p
                    and call these the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                    of
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %li
                  %p
                    for each
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∈
                          %msub
                            %mi Obj
                            %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} X \in Obj_{\mathcal{C}}
                    a
                    %a.existingWikiWord{:href => "/nlab/show/1-morphism"} 1-morphism
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mover
                            %mo →
                            %mrow
                              %msub
