                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Limits"}
              #eq:QuillenEquivalenceInABousfLocalization.maruku-equation
                %span.maruku-eq-number (105)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
