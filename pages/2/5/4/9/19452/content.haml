                                          %mi γ
                                          %mi 𝒟
                              %mtr
                                %mtd
                                  %mi ℝ
                                  %mi F
                                  %mo{:lspace => "verythinmathspace"} :
                                %mtd
                                  %msub
                                    %mi 𝒞
                                    %mi f
