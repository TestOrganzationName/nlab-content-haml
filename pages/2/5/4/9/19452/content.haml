              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+Yoneda+lemma"} enriched Yoneda lemma
            #TopologicallyEnrichedYonedaLemma.num_prop
              %h6#proposition_50 Proposition
              %p
                %strong (topologically enriched Yoneda-lemma)
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
