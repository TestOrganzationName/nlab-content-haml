                        %mi A
                        %msub
                          %mo ⊗
                          %mi A
                        %mi A
                        %mo ≃
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A \otimes_A A \simeq A
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mn 1
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} C_1 = 1
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mn 2
                        %mo =
                        %mn 1
