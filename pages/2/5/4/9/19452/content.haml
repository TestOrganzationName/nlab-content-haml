            #KanComplexe.num_defn
              %h6#definition_77 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"}> Kan complex
                  )
              %p
                A
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                is a
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                that satisfies the
                = succeed "," do
                  %em Kan condition
              %ul
                %li
                  %p
                    which says that all
                    %a.existingWikiWord{:href => "/nlab/show/horns"} horns
                    of the simplicial set have
                    = succeed "/extend" do
                      %em fillers
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/simplices"} simplices
                %li
                  %p
                    which means equivalently that the unique homomorphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                          %mo →
                          %mi pt
                        %annotation{:encoding => "application/x-tex"} S \to pt
                    from
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                    to the
                    %a.existingWikiWord{:href => "/nlab/show/point"} point
                    (the
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                %li
                  %p
                    which means equivalently that for all
                    %a.existingWikiWord{:href => "/nlab/show/diagrams"} diagrams
                    in
                    %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                    of the form
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msup
                                    %mi Λ
                                    %mi i
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo{:stretchy => "false"} ]
                                %mtd
                                  %mo →
                                %mtd
                                  %mi S
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                              %mtr
                                %mtd
                                  %mi Δ
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo{:stretchy => "false"} ]
                                %mtd
                                  %mo →
                                %mtd
                                  %mi pt
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ↔
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msup
                                    %mi Λ
                                    %mi i
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo{:stretchy => "false"} ]
                                %mtd
                                  %mo →
                                %mtd
                                  %mi S
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                %mtd
                              %mtr
                                %mtd
                                  %mi Δ
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \\Lambda^i[n] &amp;\to&amp; S
                          \\\
                          \\downarrow &amp;&amp; \downarrow
                          \\\
                          \\Delta[n] &amp;\to&amp; pt
                          }
                          \\;\;\;
                          \\leftrightarrow
                          \\;\;\;
                          \\array{
                          \\Lambda^i[n] &amp;\to&amp; S
                          \\\
                          \\downarrow &amp;&amp;
                          \\\
                          \\Delta[n]
                          }
                  %p there exists a diagonal morphism
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msup
                                    %mi Λ
                                    %mi i
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo{:stretchy => "false"} ]
                                %mtd
                                  %mo →
                                %mtd
                                  %mi S
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                  %mo ↗
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                              %mtr
                                %mtd
                                  %mi Δ
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo{:stretchy => "false"} ]
                                %mtd
                                  %mo →
                                %mtd
                                  %mi pt
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mo ↔
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msup
                                    %mi Λ
                                    %mi i
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo{:stretchy => "false"} ]
                                %mtd
                                  %mo →
                                %mtd
                                  %mi S
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                  %mo ↗
                                %mtd
                              %mtr
                                %mtd
                                  %mi Δ
                                  %mo{:stretchy => "false"} [
                                  %mi n
                                  %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \\Lambda^i[n] &amp;\to&amp; S
                          \\\
                          \\downarrow &amp;\nearrow&amp; \downarrow
                          \\\
                          \\Delta[n] &amp;\to&amp; pt
                          }
                          \\;\;\;
                          \\leftrightarrow
                          \\;\;\;
                          \\array{
                          \\Lambda^i[n] &amp;\to&amp; S
                          \\\
                          \\downarrow &amp;\nearrow&amp;
                          \\\
                          \\Delta[n]
                          }
                  %p
                    completing this to a
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                %li
                  %p
                    which in turn means equivalently that the map from
                    = succeed "-simplices" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                          %annotation{:encoding => "application/x-tex"} n
                    = succeed "-horns" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo ,
                            %mi i
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (n,i)
                    %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi Δ
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo ,
                          %mi S
                          %mo{:stretchy => "false"} ]
                          %mspace{:width => "thinmathspace"}
                          %mo ↠
                          %mspace{:width => "thinmathspace"}
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi Λ
                            %mi i
                          %mo{:stretchy => "false"} [
                          %mi n
                          %mo{:stretchy => "false"} ]
                          %mo ,
                          %mi S
                          %mo{:stretchy => "false"} ]
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          [\Delta[n], S]\, \twoheadrightarrow \,[\Lambda^i[n],S]
                          \\,.
            .num_prop
              %h6#proposition_55 Proposition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Sing
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Sing(X)
                = succeed "," do
                  %a.maruku-ref{:href => "#SingularSimplicialComplex"}
                = succeed "." do
                  %a.maruku-ref{:href => "#KanComplexes"}
            .proof
              %h6#proof_82 Proof
              %p
                The inclusions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                          %msub
                            %mrow
                              %msup
                                %mi Λ
                                %mi n
                            %mi Top
                        %mi k
                      %mo ↪
                      %msubsup
                        %mi Δ
                        %mi Top
                        %mi n
                    %annotation{:encoding => "application/x-tex"} {{\Lambda^n}_{Top}}_k \hookrightarrow \Delta^n_{Top}
                of topological horns into topological simplices are
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/retracts"} retracts
                %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi Top
                        %mi n
                      %mo →
                      %msub
                        %mrow
                          %msub
                            %mrow
                              %msup
                                %mi Λ
                                %mi n
                            %mi Top
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \Delta^n_{Top} \to {{\Lambda^n}_{Top}}_k
                given by “squashing” a topological
                = succeed "-simplex" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mrow
                          %msub
                            %mrow
                              %msup
                                %mi Λ
                                %mi n
                            %mi Top
                        %mi k
                      %mo →
                      %msubsup
                        %mi Δ
                        %mi Top
                        %mi n
                      %mo →
                      %msub
                        %mrow
                          %msub
                            %mrow
                              %msup
                                %mi Λ
                                %mi n
                            %mi Top
                        %mi k
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi Id
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      ({{\Lambda^n}_{Top}}_k \to \Delta^n_{Top} \to
                      {{\Lambda^n}_{Top}}_k)
                      \=
                      Id
                      \\,.
              %p
                Therefore the map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Δ
                        %mi n
                      %mo ,
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mo{:stretchy => "false"} [
                      %msubsup
                        %mi Λ
                        %mi k
                        %mi n
                      %mo ,
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [\Delta^n, \Pi(X)] \to [\Lambda^n_k,\Pi(X)]
                is an epimorphism, since it is equal to to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Δ
                        %mi n
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi Top
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi Λ
                        %mi k
                        %mi n
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Top(\Delta^n, X) \to Top(\Lambda^n_k, X)
                which has a right inverse
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Top
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi Λ
                          %mi k
                          %mi n
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi Top
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi Δ
                          %mi n
                        %mo ,
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Top(\Lambda^n_k, X) \to Top(\Delta^n, X)
            %p More generally:
            #KanFibration.num_defn
              %h6#definition_78 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"}> Kan fibration
                  )
              %p
                A morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi S
                      %mo ⟶
                      %mi T
                    %annotation{:encoding => "application/x-tex"} \phi \colon S \longrightarrow T
                in
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                is called a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                if it has the
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                again all
                %a.existingWikiWord{:href => "/nlab/show/horn"} horn
                inclusions, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#Horn"}
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi Λ
                                %mi i
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi S
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi ϕ
                          %mtr
                            %mtd
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi T
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\Lambda^i[n] &amp;\longrightarrow&amp; S
                      \\\
                      \\downarrow &amp;&amp; \downarrow^{\mathrlap{\phi}}
                      \\\
                      \\Delta[n] &amp;\longrightarrow&amp; T
                      }
              %p there exists a lift
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi Λ
                                %mi i
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi S
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi ϕ
                          %mtr
                            %mtd
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi T
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \\Lambda^i[n] &amp;\longrightarrow&amp; S
                      \\\
                      \\downarrow &amp;\nearrow&amp; \downarrow^{\mathrlap{\phi}}
                      \\\
                      \\Delta[n] &amp;\longrightarrow&amp; T
                      }
                      \\,.
            %p
              This is the simplicial incarnation of the concept of
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibrations"} Serre fibrations
              of topological spaces:
            #SerreFibration.num_defn
              %h6#definition_79 Definition
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
                between
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                is a
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                if for all
                %a.existingWikiWord{:href => "/nlab/show/CW-complexes"} CW-complexes
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and for every
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                in
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi C
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                              %mi C
                              %mo ×
                              %mi I
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Y
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      C &amp;\longrightarrow&amp; X
                      \\\
                      \\downarrow &amp;&amp; \downarrow^{\mathrlap{f}}
                      \\\
                      C \times I &amp;\longrightarrow&amp; Y
                      }
              %p there exists a lift
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi C
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo ↗
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
                              %mi C
                              %mo ×
                              %mi I
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      C &amp;\longrightarrow&amp; X
                      \\\
                      \\downarrow &amp;\nearrow&amp; \downarrow^{\mathrlap{f}}
                      \\\
                      C \times I &amp;\longrightarrow&amp; Y
                      }
                      \\,.
            #SingDetextsAndReflectsFibrations.num_prop
              %h6#proposition_56 Proposition
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
                = succeed "," do
                  %a.maruku-ref{:href => "#SerreFibration"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ⟶
                      %mi Sing
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sing(f) \colon Sing(X) \longrightarrow Sing(Y)
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SingularSimplicialComplex"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                = succeed "." do
                  %a.maruku-ref{:href => "#KanFibration"}
            %p
              The proof uses the basic tool of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              to which we get to below in prop.
              = succeed "." do
                %a.maruku-ref{:href => "#NerveAndRealizationAdjunction"}
            .proof
              %h6#proof_83 Proof
              %p
                First observe that the left
                %a.existingWikiWord{:href => "/nlab/show/lifting+property"} lifting property
                against all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ↪
                      %mi C
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} C \hookrightarrow C \times I
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                a
                %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
                is equivalent to left lifting against
                %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %msup
                          %mi Λ
                          %mi i
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} |
                      %mo ↪
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {\vert \Lambda^i[n]\vert} \hookrightarrow {\vert \Delta[n]\vert}
                of
                %a.existingWikiWord{:href => "/nlab/show/horn"} horn
                inclusions. Then apply the
                %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Top
                        %mo{:stretchy => "false"} (
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mo −
                          %mo{:stretchy => "false"} |
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi sSet
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mi Sing
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Top({\vert-\vert},-) \simeq sSet(-,Sing(-))
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                of prop.
                %a.maruku-ref{:href => "#NerveAndRealizationAdjunction"}
                and example
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalRealizationOfSimplicialSets"}
            #PullbackOfKanFibrationSendsLeftHomotopyToFiberwiseHomotopyequivalence.num_lemma
              %h6#lemma_27 Lemma
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} p \colon X \longrightarrow Y
                be a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                = succeed "," do
                  %a.maruku-ref{:href => "#KanFibration"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 1
                      %mo ,
                      %msub
                        %mi f
                        %mn 2
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo ⟶
                      %mi X
                    %annotation{:encoding => "application/x-tex"} f_1,f_2 \colon A \longrightarrow X
                be two morphisms. If there is a
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#LeftHomotopyOfSimplicialSets"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mn 1
                      %mo ⇒
                      %msub
                        %mi f
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} f_1 \Rightarrow f_2
                between these maps, then there is a fiberwise
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                = succeed "," do
                  %a.maruku-ref{:href => "#HomotopyEquivalence"}
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                fibrations
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi f
                          %mn 1
                          %mo *
                        %mi X
                        %mo ≃
                        %msubsup
                          %mi f
                          %mn 2
                          %mo *
                        %mi X
                      %annotation{:encoding => "application/x-tex"} f_1^\ast X \simeq f_2^\ast X
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "classical+model+structure+on+simplicial+sets#GoerssJardine99"} Goerss-Jardine 99, chapter I, lemma 10.6
            %p
              While
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              have the advantage of being purely combinatorial structures, the
              %a.existingWikiWord{:href => "/nlab/show/singular+simplicial+complex"} singular simplicial complex
              of any given
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %a.maruku-ref{:href => "#SingularSimplicialComplex"}
              is in general a huge simplicial set which does not lend itself to detailed inspection. The following is about small models.
            #MinimalKanFibration.num_defn
              %h6#definition_80 Definition
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo{:lspace => "verythinmathspace"} :
                        %mi S
                        %mo ⟶
                        %mi T
                      %annotation{:encoding => "application/x-tex"} \phi \colon S \longrightarrow T
                = succeed "," do
                  %a.maruku-ref{:href => "#KanFibration"}
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibration"} minimal Kan fibration
                if for any two cells in the same fiber with the same
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                if they are homotopic relative their boundary, then they are already equal.
              %p
                More formally,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                is minimal precisely if for every
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mo ∂
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                              %mo{:stretchy => "false"} )
                              %mo ×
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mn 1
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 1
                            %mtd
                              %mo ∂
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                              %mo ×
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mn 1
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mover
                                %mo ⟶
                                %mi h
                            %mtd
                              %mi S
                          %mtr
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi p
                                      %mn 1
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi ϕ
                          %mtr
                            %mtd
                              %mi Δ
                              %mo{:stretchy => "false"} [
                              %mi n
                              %mo{:stretchy => "false"} ]
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi T
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (\partial \Delta[n]) \times \Delta[1]
                      \&amp;\stackrel{p_1}{\longrightarrow}&amp;
                      \\partial \Delta[n]
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      \\Delta[n] \times \Delta[1]
                      \&amp;\stackrel{h}{\longrightarrow}&amp;
                      S
                      \\\
                      \\downarrow^{\mathrlap{p_1}} &amp;&amp; \downarrow^{\mathrlap{\phi}}
                      \\\
                      \\Delta[n] &amp;\longrightarrow&amp; T
                      }
              %p then the two composites
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mi d
                              %mn 1
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi d
                              %mn 0
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ×
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo ⟶
                        %mi h
                      %mi S
                    %annotation{:encoding => "application/x-tex"}
                      \\Delta[n]
                      \\stackrel{\overset{d_0}{\longrightarrow}}{\underset{d_1}{\longrightarrow}}
                      \\Delta[n] \times \Delta[1]
                      \\stackrel{h}{\longrightarrow}
                      S
              %p are equal.
            #PullbackPreservesMinimalFibration.num_prop
              %h6#proposition_57 Proposition
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
                (in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibration"} minimal Kan fibration
                = succeed "," do
                  %a.maruku-ref{:href => "#MinimalKanFibration"}
            %p
              …
              = succeed "\u2026" do
                %a.existingWikiWord{:href => "/nlab/show/anodyne+extensions"} anodyne extensions
            %p
              (
              %a{:href => "classical+model+structure+on+simplicial+sets#GoerssJardine99"}> Goerss-Jardine 99, chapter I, section 4
              ,
              = succeed ")" do
                %a{:href => "classical+model+structure+on+simplicial+sets#JoyalTierney05"} Joyal-Tierney 05, section 31
            #KanFibrationHasMinimalStrongDeformationRetract.num_prop
              %h6#proposition_58 Proposition
              %p
                For every
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
                = succeed "," do
                  %a.maruku-ref{:href => "#KanFibration"}
                %a.existingWikiWord{:href => "/nlab/show/strong+deformation+retract"} strong deformation retract
                to a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibration"} minimal Kan fibration
                = succeed "." do
                  %a.maruku-ref{:href => "#MinimalKanFibration"}
            %p
              (e.g.
              = succeed "," do
                %a{:href => "classical+model+structure+on+simplicial+sets#GoerssJardine99"} Goerss-Jardine 99, chapter I, prop. 10.3
              = succeed ")." do
                %a{:href => "classical+model+structure+on+simplicial+sets#JoyalTierney05"} Joyal-Tierney 05, theorem 3.3.1, theorem 3.3.3
            .proof
              %h6#proof_idea Proof idea
              %p
                Choose representatives by
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/induction"} induction
                %a.existingWikiWord{:href => "/nlab/show/anodyne+extensions"} anodyne extensions
                against a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
            #FiberwiseHomotopyEquivalenceOfMinimalFibrationsIsIso.num_lemma
              %h6#lemma_28 Lemma
              %p
                A morphism between
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibrations"} minimal Kan fibrations
                = succeed "," do
                  %a.maruku-ref{:href => "#MinimalKanFibration"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                = succeed "," do
                  %a.maruku-ref{:href => "#HomotopyEquivalenceOfSimplicialSets"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "classical+model+structure+on+simplicial+sets#GoerssJardine99"} Goerss-Jardine 99, chapter I, lemma 10.4
            .proof
              %h6#proof_idea_2 Proof idea
              %p
                Show the statement degreewise. In the
                %a.existingWikiWord{:href => "/nlab/show/induction"} induction
                one needs to lift
                %a.existingWikiWord{:href => "/nlab/show/anodyne+extensions"} anodyne extensions
                agains a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
            #MinimalKanFibrationAreFiberBundles.num_lemma
              %h6#lemma_29 Lemma
              %p
                Every
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/minimal+Kan+fibration"} minimal Kan fibration
                = succeed "," do
                  %a.maruku-ref{:href => "#MinimalKanFibration"}
                %a.existingWikiWord{:href => "/nlab/show/connected"} connected
                base is a simplicial
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            %p
              (e.g.
              = succeed ")" do
                %a{:href => "classical+model+structure+on+simplicial+sets#GoerssJardine99"} Goerss-Jardine 99, chapter I, corollary 10.8
            .proof
              %h6#proof_84 Proof
              %p
                By assumption of the base being connected, the classifying maps for the fibers over any two vertices are connected by a
                %a.existingWikiWord{:href => "/nlab/show/zig-zag"} zig-zag
                of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/homotopies"} homotopies
                %a.maruku-ref{:href => "#PullbackOfKanFibrationSendsLeftHomotopyToFiberwiseHomotopyequivalence"}
                the fibers are connected by
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalences"} homotopy equivalences
                and then by prop.
                %a.maruku-ref{:href => "#PullbackPreservesMinimalFibration"}
                and lemma
                %a.maruku-ref{:href => "#FiberwiseHomotopyEquivalenceOfMinimalFibrationsIsIso"}
                they are already isomorphic. Write
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                for this
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/typical+fiber"} typical fiber
              %p
                Moreover, for all
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                the morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[n] \to \Delta[0] \to \Delta[n]
                are
                %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopic
                to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mover
                        %mo →
                        %mi id
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[n] \stackrel{id}{\to} \Delta[n]
                and so applying lemma
                %a.maruku-ref{:href => "#PullbackOfKanFibrationSendsLeftHomotopyToFiberwiseHomotopyequivalence"}
                and prop.
                %a.maruku-ref{:href => "#FiberwiseHomotopyEquivalenceOfMinimalFibrationsIsIso"}
                once more yields that the fiber over each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[n]
                is
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ×
                        %mi F
                      %annotation{:encoding => "application/x-tex"} \Delta[n]\times F
            %h4#GroupoidsAsKanComplexes Groupoids as Kan complexes
            #Groupoid.num_defn
              %h6#definition_81 Definition
              %p
                A (
                %a.existingWikiWord{:href => "/nlab/show/small+category"}> small
                )
                %em
                  %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
                is
              %ul
                %li
                  %p
                    a pair of
                    %a.existingWikiWord{:href => "/nlab/show/sets"} sets
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒢
                            %mn 0
                          %mo ∈
                          %mi Set
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}_0 \in Set
                    (the set of
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒢
                            %mn 1
                          %mo ∈
                          %mi Set
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \in Set
                    (the set of
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                %li
                  %p
                    equipped with
                    %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %msub
                                    %mi 𝒢
                                    %mn 1
                                  %msub
                                    %mo ×
                                    %mrow
                                      %msub
                                        %mi 𝒢
                                        %mn 0
                                  %msub
                                    %mi 𝒢
                                    %mn 1
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mo ∘
                                %mtd
                                  %msub
                                    %mi 𝒢
                                    %mn 1
                                %mtd
                                  %mover
                                    %mover
                                      %munder
                                        %mo ⟶
                                        %mi s
                                      %mover
                                        %mo ←
                                        %mi i
                                    %mover
                                      %mo ⟶
                                      %mi t
                                %mtd
                                  %msub
                                    %mi 𝒢
                                    %mn 0
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \\mathcal{G}_1 \times_{\mathcal{G}_0} \mathcal{G}_1
                          \&amp;\stackrel{\circ}{\longrightarrow}&amp;
                          \\mathcal{G}_1
                          \&amp; \stackrel{\overset{t}{\longrightarrow}}{\stackrel{\overset{i}{\leftarrow}}{\underset{s}{\longrightarrow}}}&amp;
                          \\mathcal{G}_0
                          }\,,
                  %p
                    where the
                    %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                    on the left is that over
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi 𝒢
                              %mn 1
                            %mover
                              %mo →
                              %mi t
                            %msub
                              %mi 𝒢
                              %mn 0
                            %mover
                              %mo ←
                              %mi s
                            %msub
                              %mi 𝒢
                              %mn 1
                          %annotation{:encoding => "application/x-tex"} \mathcal{G}_1 \stackrel{t}{\to} \mathcal{G}_0 \stackrel{s}{\leftarrow} \mathcal{G}_1
              %p such that
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                        %annotation{:encoding => "application/x-tex"} i
                    takes values in
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi t
                          %mo ∘
                          %mi i
                          %mo =
                          %mi s
                          %mo ∘
                          %mi i
                          %mo =
                          %msub
                            %mi id
                            %mrow
                              %msub
                                %mi 𝒢
                                %mn 0
                          %mo ,
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                        %annotation{:encoding => "application/x-tex"}
                          t \circ i = s \circ i =   id_{\mathcal{G}_0}, \;\;\;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ∘
                        %annotation{:encoding => "application/x-tex"} \circ
                    defines a partial
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                    operation which is
                    %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
                    and
                    %a.existingWikiWord{:href => "/nlab/show/unitality"} unital
                    for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi i
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi 𝒢
                            %mn 0
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} i(\mathcal{G}_0)
                    the
                    = succeed ";" do
                      %a.existingWikiWord{:href => "/nlab/show/identities"} identities
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi g
                          %mo ∘
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi s
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} s (g \circ f) = s(f)
                    and
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi t
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ∘
                            %mi f
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi t
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} t (g \circ f) = t(g)
                %li
                  %p
                    every morphism has an
                    %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
                    under this composition.
            .num_remark
              %h6#remark_39 Remark
              %p This data is visualized as follows. The set of morphisms is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mn 1
                      %mo =
                      %mrow
                        %mo {
                        %msub
                          %mi ϕ
                          %mn 0
                        %mover
                          %mo →
                          %mi k
                        %msub
                          %mi ϕ
                          %mn 1
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{G}_1
                      \=
                      \\left\{
                      \\phi_0 \stackrel{k}{\to} \phi_1
                      \\right\}
              %p and the set of pairs of composable morphisms is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mn 2
                      %mo ≔
                      %msub
                        %mi 𝒢
                        %mn 1
                      %munder
                        %mo ×
                        %mrow
                          %msub
                            %mi 𝒢
                            %mn 0
                      %msub
                        %mi 𝒢
                        %mn 1
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msub
                                  %mi ϕ
                                  %mn 1
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msub
                                        %mi k
                                        %mn 1
                                %mo ↗
                              %mtd
                              %mtd
                                %msup
                                  %mo ↘
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %msub
                                        %mi k
                                        %mn 2
                            %mtr
                              %mtd
                                %msub
                                  %mi ϕ
                                  %mn 0
                              %mtd
                              %mtd
                                %mover
                                  %mo →
                                  %mrow
                                    %msub
                                      %mi k
                                      %mn 2
                                    %mo ∘
                                    %msub
                                      %mi k
                                      %mn 1
                              %mtd
                              %mtd
                                %msub
                                  %mi ϕ
                                  %mn 2
                        %mo }
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{G}_2 \coloneqq \mathcal{G}_1 \underset{\mathcal{G}_0}{\times} \mathcal{G}_1
                      \=
                      \\left\{
                      \\array{
                      \&amp;&amp; \phi_1
                      \\\
                      \&amp; {}^{\mathllap{k_1}}\nearrow &amp;&amp; \searrow^{\mathrlap{k_2}}
                      \\\
                      \\phi_0 &amp;&amp; \stackrel{k_2 \circ k_1}{\to} &amp;&amp; \phi_2
                      }
                      \\right\}
                      \\,.
              %p
                The functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo ,
                      %msub
                        %mi p
                        %mn 2
                      %mo ,
                      %mo ∘
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi 𝒢
                        %mn 2
                      %mo →
                      %msub
                        %mi 𝒢
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} p_1, p_2, \circ \colon \mathcal{G}_2 \to \mathcal{G}_1
                are those which send, respectively, these triangular diagrams to the left morphism, or the right morphism, or the bottom morphism.
            #SetAsGroupoid.num_example
              %h6#example_50 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to be the set of objects and adding only precisely the
                %a.existingWikiWord{:href => "/nlab/show/identity"} identity
                morphism from each object to itself
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo (
                        %mi X
                        %munderover
                          %mover
                            %mo ⟵
                            %mi id
                          %munder
                            %mo ⟶
                            %mi id
                          %mover
                            %mo ⟶
                            %mi id
                        %mi X
                        %mo )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\left(
                      X
                      \\underoverset
                      {\underset{id}{\longrightarrow}}
                      {\overset{id}{\longrightarrow}}
                      { \overset{id}{\longleftarrow} }
                      X
                      \\right)
                      \\,.
            #DeloopingGroupoid.num_example
              %h6#example_51 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/group"} group
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                    %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)_\bullet
                has
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %msub
                            %mo{:stretchy => "false"} )
                            %mn 0
                          %mo =
                          %mo *
                        %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)_0 = \ast
                    ;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                          %msub
                            %mo{:stretchy => "false"} )
                            %mn 1
                          %mo =
                          %mi G
                        %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)_1 = G
                    \.
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
                two groups, group homomorphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi G
                      %mo →
                      %mi K
                    %annotation{:encoding => "application/x-tex"} f \colon G \to K
                are in
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
                with groupoid homomorphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi f
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi K
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (\mathbf{B}f)_\bullet
                      \\;\colon\;
                      (\mathbf{B}G)_\bullet \to (\mathbf{B}K)_\bullet
                      \\,.
              %p
                In particular a
                %a.existingWikiWord{:href => "/nlab/show/group+character"} group character
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo{:lspace => "verythinmathspace"} :
                      %mi G
                      %mo →
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c \colon G \to U(1)
                is equivalently a groupoid homomorphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi c
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (\mathbf{B}c)_\bullet
                      \\;\colon\;
                      (\mathbf{B}G)_\bullet
                      \\to
                      (\mathbf{B}U(1))_\bullet
                      \\,.
              %p
                Here, for the time being, all groups are
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+groups"} discrete groups
                %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(1)
                also has a standard structure of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi Grp
                    %annotation{:encoding => "application/x-tex"}
                      \\flat U(1) \in Grp
              %p
                to mean explicitly the
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
                underlying the circle group. (Here “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo ♭
                    %annotation{:encoding => "application/x-tex"} \flat
                ” denotes the “
                %a.existingWikiWord{:href => "/nlab/show/flat+modality"}> flat modality
                ”.)
            #ActionGroupoid.num_example
              %h6#example_52 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/set"} set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a
                %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ×
                      %mi G
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \rho \colon X \times G \to X
                an
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                (a
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/permutation+representation"} permutation representation
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
                or
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is the groupoid
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} /
                        %mi ρ
                      %mi G
                      %mo =
                      %mrow
                        %mo (
                        %mi X
                        %mo ×
                        %mi G
                        %mover
                          %munder
                            %mo ⟶
                            %mrow
                              %msub
                                %mi p
                                %mn 1
                          %mover
                            %mo ⟶
                            %mi ρ
                        %mi X
                        %mo )
                    %annotation{:encoding => "application/x-tex"}
                      X//_\rho G
                      \=
                      \\left(
                      X \times G
                      \\stackrel{\overset{\rho}{\longrightarrow}}{\underset{p_1}{\longrightarrow}}
                      X
                      \\right)
              %p
                with composition induced by the product in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                are of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi x
                        %mn 1
                      %mover
                        %mo →
                        %mi g
                      %msub
                        %mi x
                        %mn 2
                      %mo =
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi x
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      x_1 \stackrel{g}{\to} x_2 = \rho(x_1)(g)
              %p
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi x
                          %mn 1
                        %mo ,
                        %msub
                          %mi x
                          %mn 2
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x_1, x_2 \in X
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                        %mo ∈
                        %mi G
                      %annotation{:encoding => "application/x-tex"} g \in G
            %p As an important special case we have:
            #BGGroupoidAsActionGroupoid.num_example
              %h6#example_53 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a
                %a.existingWikiWord{:href => "/nlab/show/discrete"} discrete
                group and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                    %annotation{:encoding => "application/x-tex"} \rho
                the trivial action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on the point
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
                (the singleton set), the corresponding
                %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
                according to def.
                %a.maruku-ref{:href => "#ActionGroupoid"}
                is the
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                groupoid of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                according to def.
                = succeed ":" do
                  %a.maruku-ref{:href => "#DeloopingGroupoid"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (\ast //G)_\bullet = (\mathbf{B}G)_\bullet
                      \\,.
              %p
                Another canonical action is the action of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on itself by right multiplication. The corresponding action groupoid we write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi E
                      %mi G
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %mo ≔
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} /
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (\mathbf{E}G)_\bullet \coloneqq G//G
                      \\,.
              %p
                The constant map
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo →
                      %mo *
                    %annotation{:encoding => "application/x-tex"} G \to \ast
                induces a canonical morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi G
                              %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} /
                              %mi G
                            %mtd
                              %mo ≃
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi E
                              %mi G
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mo *
                              %mo{:stretchy => "false"} /
                              %mo{:stretchy => "false"} /
                              %mi G
                            %mtd
                              %mo ≃
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      G//G &amp; \simeq &amp; \mathbf{E}G
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      \\ast //G &amp; \simeq &amp; \mathbf{B}G
                      }
                      \\,.
              %p
                This is known as the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
                %a.maruku-ref{:href => "#PullbackOfEGGroupoidAsHomotopyFiberProduct"}
                for more on this.
            .num_example
              %h6#example_54 Example
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/interval"} interval
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is the groupoid with
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mn 0
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi a
                        %mo ,
                        %mi b
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} I_0 = \{a,b\}
                  ;
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mn 1
                        %mo =
                        %mo{:stretchy => "false"} {
                        %msub
                          %mi{:mathvariant => "normal"} id
                          %mi a
                        %mo ,
                        %msub
                          %mi{:mathvariant => "normal"} id
                          %mi b
                        %mo ,
                        %mi a
                        %mo →
                        %mi b
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} I_1 = \{\mathrm{id}_a, \mathrm{id}_b, a \to  b \}
                  \.
            #FundamentalGroupoid.num_example
              %h6#example_55 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %a.existingWikiWord{:href => "/nlab/show/fundamental+groupoid"} fundamental groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_1(\Sigma)
                is
              %ul
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 0
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \Pi_1(\Sigma)_0 =
                  points in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                %li
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mi Σ
                        %msub
                          %mo{:stretchy => "false"} )
                          %mn 1
                        %mo =
                      %annotation{:encoding => "application/x-tex"} \Pi_1(\Sigma)_1 =
                  %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
                  paths in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  modulo
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                  that leaves the endpoints fixed.
            #PathSpaceGroupoid.num_example
              %h6#example_56 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
                any groupoid, there is the
                %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
                groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝒢
                        %mo •
                        %mi I
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}^I_\bullet
                with
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msubsup
                            %mi 𝒢
                            %mn 0
                            %mi I
                          %mo =
                          %msub
                            %mi 𝒢
                            %mn 1
                          %mo =
                          %mrow
                            %mo {
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi ϕ
                                      %mn 0
                                %mtr
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mpadded{:width => "0"}
                                        %mi k
                                %mtr
                                  %mtd
                                    %msub
                                      %mi ϕ
                                      %mn 1
                            %mo }
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}^I_0 = \mathcal{G}_1 = \left\{ \array{ \phi_0 \\ \downarrow^{\mathrlap{k}} \\ \phi_1  } \right\}
                    ;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi 𝒢
                            %mn 1
                            %mi I
                          %mo =
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}^I_1 =
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting squares
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒢
                            %mo •
                        %annotation{:encoding => "application/x-tex"} \mathcal{G}_\bullet
                    \=
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mo {
                            %mrow
                              %mtable
                                %mtr
                                  %mtd
                                    %msub
                                      %mi ϕ
                                      %mn 0
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi h
                                          %mn 0
                                  %mtd
                                    %msub
                                      %mover
                                        %mi ϕ
                                        %mo{:stretchy => "false"} ˜
                                      %mn 0
                                %mtr
                                  %mtd
                                    %msup
                                      %mrow
                                      %mpadded{:lspace => "-100%width", :width => "0"}
                                        %mi k
                                    %mo{:stretchy => "false"} ↓
                                  %mtd
                                  %mtd
                                    %msup
                                      %mo{:stretchy => "false"} ↓
                                      %mpadded{:width => "0"}
                                        %mover
                                          %mi k
                                          %mo{:stretchy => "false"} ˜
                                %mtr
                                  %mtd
                                    %msub
                                      %mi ϕ
                                      %mn 1
                                  %mtd
                                    %mover
                                      %mo →
                                      %mrow
                                        %msub
                                          %mi h
                                          %mn 1
                                  %mtd
                                    %msub
                                      %mover
                                        %mi ϕ
                                        %mo{:stretchy => "false"} ˜
                                      %mn 1
                            %mo }
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\left\{
                          \\array{
                          \\phi_0 &amp;\stackrel{h_0}{\to}&amp; \tilde \phi_0
                          \\\
                          {}^{\mathllap{k}}\downarrow &amp;&amp; \downarrow^{\mathrlap{\tilde k}}
                          \\\
                          \\phi_1 &amp;\stackrel{h_1}{\to}&amp; \tilde \phi_1
                          }
                          \\right\}
                          \\,.
              %p This comes with two canonical homomorphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝒢
                        %mo •
                        %mi I
                      %mover
                        %munder
                          %mo ⟶
                          %mrow
                            %msub
                              %mi ev
                              %mn 0
                        %mover
                          %mo ⟶
                          %mrow
                            %msub
                              %mi ev
                              %mn 1
                      %msub
                        %mi 𝒢
                        %mo •
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{G}^I_\bullet
                      \\stackrel{\overset{ev_1}{\longrightarrow}}{\underset{ev_0}{\longrightarrow}}
                      \\mathcal{G}_\bullet
              %p which are given by endpoint evaluation, hence which send such a commuting square to either its top or its bottom hirizontal component.
            .num_defn
              %h6#definition_82 Definition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi f
                        %mo •
                      %mo ,
                      %msub
                        %mi g
                        %mo •
                      %mo :
                      %msub
                        %mi 𝒢
                        %mo •
                      %mo →
                      %msub
                        %mi 𝒦
                        %mo •
                    %annotation{:encoding => "application/x-tex"} f_\bullet, g_\bullet : \mathcal{G}_\bullet \to \mathcal{K}_\bullet
                two morphisms between groupoids, a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/homotopy"} homotopy
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ⇒
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f \Rightarrow g
                (a
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mo •
                      %mo :
                      %msub
                        %mi 𝒢
                        %mo •
                      %mo →
                      %msubsup
                        %mi 𝒦
                        %mo •
                        %mi I
                    %annotation{:encoding => "application/x-tex"} \eta_\bullet : \mathcal{G}_\bullet \to \mathcal{K}^I_\bullet
                (with
                %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
                the
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒦
                        %mo •
                    %annotation{:encoding => "application/x-tex"} \mathcal{K}_\bullet
                as in example
                = succeed ")" do
                  %a.maruku-ref{:href => "#PathSpaceGroupoid"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                              %mo ↗
                              %msup
                                %mo ↘
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi f
                                      %mo •
                          %mtr
                            %mtd
                              %mi 𝒢
                            %mtd
                              %msup
                                %mo ⇓
                                %mpadded{:width => "0"}
                                  %mi η
                            %mtd
                              %mi 𝒦
                          %mtr
                            %mtd
                            %mtd
                              %mo ↘
                              %msub
                                %mo ↗
                                %mpadded{:width => "0"}
                                  %mrow
                                    %msub
                                      %mi g
                                      %mo •
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
