                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                    %annotation{:encoding => "application/x-tex"} \Delta
                (Example
                = succeed ")," do
                  %a.maruku-ref{:href => "#CategoryOfPresheaves"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
                = succeed "." do
                  %a.maruku-ref{:href => "#SimplicialSet"}
              %p
                Via this identification, the
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                of
                %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#sSet"}
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
                to the
                %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                on the
                %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi Δ
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      sSet
                      \\;=\;
                      [\Delta^{op}, Set]
                      \\,.
              %p
                In particular this means that
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                is a
                %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
                for
                %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
                (Example
                = succeed ")," do
                  %a.maruku-ref{:href => "#ExamplesOfCosmoi"}
                = succeed "." do
                  %a.maruku-ref{:href => "#PropertiesOfSheafToposes"}
            .proof
              %h6#proof_81 Proof
              %p
                One checks by inspection that the
                %a.existingWikiWord{:href => "/nlab/show/simplicial+identities"} simplicial identities
                characterize precisely the behaviour of the morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mi op
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Delta^{op}([n],[n+1])
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \Delta^{op}([n],[n-1])
            %p This makes the following evident:
            #StandardCosimplicialTopologicalSpace.num_example
              %h6#example_48 Example
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/topological+simplices"} topological simplices
                from def.
                %a.maruku-ref{:href => "#TopologicalSimplex"}
                arrange into a
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
                    in
                    %a.existingWikiWord{:href => "/nlab/show/Top"} Top
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Δ
                        %mo •
                      %mo :
                      %mi Δ
                      %mo →
                      %mi Top
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\Delta^\bullet : \Delta \to Top
                      \\,.
            %p
              With this now the structure of a simplicial set on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Sing
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                    %annotation{:encoding => "application/x-tex"} (Sing X)_\bullet
              = succeed "," do
