                is
              %ol
                %li
                  %p
                    an
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi N
                            %mo ∈
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} N \in \mathcal{C}
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ρ
                          %mspace{:width => "thickmathspace"}
                          %mo{:lspace => "verythinmathspace"} :
                          %mspace{:width => "thickmathspace"}
                          %mi A
                          %mo ⊗
                          %mi N
                          %mo ⟶
                          %mi N
                        %annotation{:encoding => "application/x-tex"} \rho \;\colon\; A \otimes N \longrightarrow N
                    (called the
                    = succeed ");" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/action"} action
              %p such that
              %ol
                %li
                  %p
                    (
                    %a.existingWikiWord{:href => "/nlab/show/unitality"}> unitality
                    ) the following
                    = succeed ":" do
                      %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
