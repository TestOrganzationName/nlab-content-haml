                                        %mpadded{:lspace => "-100%width", :width => "0"}
                                          %mi γ
                                        %mrow
                                          %msub
                                            %mi 𝒞
                                            %mi f
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                %mtd
                                  %msub
                                    %mo ⇙
