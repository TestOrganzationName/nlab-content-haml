                    %annotation{:encoding => "application/x-tex"}
                      \\rho_l \;\colon\; G \otimes X \longrightarrow X
              %p
                satisfying the
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                property. Hence this is equivalently an
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#OppositeAndProductOfPointedTopologicallyEnrichedCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                    %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)^{op}
                comes from the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/opposite+group"} opposite group
                %a.existingWikiWord{:href => "/nlab/show/group+object"} object
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo =
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi G
                        %mi op
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      (\mathbf{B}G)^{op}
                      \=
                      \\mathbf{B}(G^{op})
                      \\,.
              %p
                (The isomorphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ≃
                      %msup
                        %mi G
                        %mi op
                    %annotation{:encoding => "application/x-tex"} G \simeq G^{op}
                induces a canonical euqivalence of enriched categories
                = succeed ".)" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                        %mo ≃
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %mi G
                      %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)^{op} \simeq \mathbf{B}G
              %p
                So an
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi ρ
                        %mi r
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %msup
                        %mo{:stretchy => "false"} )
                        %mi op
                      %mo ⟶
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"}
                      (Y,\rho_r)
                      \\;\colon\;
                      (\mathbf{B} G)^{op} \longrightarrow \mathcal{V}
              %p
                is equivalently a
                %em right
                %a.existingWikiWord{:href => "/nlab/show/action"} action
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              %p
                Therefore the
                %a.existingWikiWord{:href => "/nlab/show/coend"} coend
                of two such functors (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#EndAndCoendInTopcgSmash"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mi g
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ∼
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi g
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (x g,\;y)
                      \\sim
                      (x,\; g y)
              %p
                (where juxtaposition denotes left/right action) and is the
                %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                of the plain
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                by the
                %a.existingWikiWord{:href => "/nlab/show/diagonal+action"} diagonal action
                of the group
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mo ∫
                        %mrow
                          %mo *
                          %mo ∈
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi G
                            %mo +
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %msub
                        %mi ρ
                        %mi r
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ⊗
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %msub
                        %mi ρ
                        %mi l
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mo *
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mi Y
                      %msub
                        %mo ⊗
                        %mi G
                      %mi X
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\overset{\ast \in \mathbf{B}(G_+)}{\int}
                      (Y,\rho_r)(\ast) \,\otimes\, (X,\rho_l)(\ast)
                      \\;\simeq\;
                      Y \otimes_G X
                      \\,.
            #NaturalTransformationsViaEnds.num_example
              %h6#example_6 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/enriched+natural+transformations"} enriched natural transformations
                  as
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/ends"} ends
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small
                %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#TopEnrichedCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ,
                      %mi G
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi 𝒞
                      %mo ⟶
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"}
