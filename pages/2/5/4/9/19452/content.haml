                        %mi red
                      %mo ∘
                      %msub
                        %mi Π
                        %mi inf
                    %annotation{:encoding => "application/x-tex"} \Pi \simeq \Pi_{red} \circ \Pi_{inf}
                by essential uniqueness of
                %a.existingWikiWord{:href => "/nlab/show/adjoints"} adjoints
                (Prop.
                = succeed ")." do
