                  %a.maruku-ref{:href => "#LeftAndRightHomotopyInAModelCategory"}
            #ComponentMapsOfCylinderAndPathSpaceInGoodSituation.num_lemma
              %h6#lemma_3 Lemma
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                is cofibrant, then for every
                %a.existingWikiWord{:href => "/nlab/show/cylinder+object"} cylinder object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cyl
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cyl(X)
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                = succeed "," do
                  %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi i
                        %mn 0
                      %mo ,
                      %msub
                        %mi i
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⊔
                      %mi X
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} (i_0,i_1) \colon X \sqcup X \to X
                a cofibration, but each
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mn 0
                      %mo ,
                      %msub
                        %mi i
                        %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Cyl
