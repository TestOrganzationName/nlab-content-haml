                      \\stackrel{\in Cof_{cl}}{\longrightarrow}
                      \\hat X
                      \\stackrel{\in W_{cl} \cap Fib_{cl}}{\longrightarrow}
                      Y
                      \\,.
            .proof
              %h6#proof_52 Proof
              %p
                By lemma
                %a.maruku-ref{:href => "#CompactSubsetsAreSmallInCellComplexes"}
                the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mi Top
                      %mo =
                      %mo{:stretchy => "false"} {
                      %msup
                        %mi S
                        %mrow
