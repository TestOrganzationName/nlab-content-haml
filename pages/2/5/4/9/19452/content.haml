                            %mphantom
                              %mi AA
                      %msub
                        %mi sSet
                        %mi Qu
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mi CombModCat
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{C}^{op}, sSet_{Qu}]_{inj, loc, \mathbb{A}}
                      \\underoverset
                      {\underset{ \underset{\longleftarrow}{\lim} }{\longrightarrow}}
                      {\overset{ \phantom{AA}const\phantom{AA} }{\longleftarrow}}
                      {\bot}
                      sSet_{Qu}
                      \\;\;\;\;
                      \\in
                      CombModCat
              %p
                is a
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#QuillenEquivalence"}
            .proof
              %h6#proof_12 Proof
              %p
                First to see that
                %a.maruku-eqref{:href => "#eq:QuillenEquivalenceInABousfLocalization"} (105)
                is a
                %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
                (Def.
                = succeed "):" do
                  %a.maruku-ref{:href => "#QuillenAdjunction"}
                %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial Quillen adjunction
                before localization
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mi inj
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ⟶
                          %munder
                            %mi lim
                            %mo ⟵
                        %mover
                          %mo ⟵
                          %mrow
                            %mphantom
                              %mi AA
                            %mi const
                            %mphantom
                              %mi AA
                      %msub
                        %mi sSet
                        %mi Qu
                    %annotation{:encoding => "application/x-tex"}
                      [\mathcal{C}^{op}, sSet_{Qu}]_{inj}
                      \\underoverset
                      {\underset{ \underset{\longleftarrow}{\lim} }{\longrightarrow}}
                      {\overset{ \phantom{AA}const\phantom{AA} }{\longleftarrow}}
                      {\bot}
                      sSet_{Qu}
              %p
                (by Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#HomotopyLimitOfSimplicialSets"}
                %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                here are
                %a.existingWikiWord{:href => "/nlab/show/left+proper+model+category"} left proper
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
                (by Prop.
                %a.maruku-ref{:href => "#SimplicialPresheavesIsProperCombinatorialSimplicial"}
                and Prop.
                = succeed ")," do
                  %a.maruku-ref{:href => "#ExistenceOfLeftBousfieldLocalization"}
                %a.existingWikiWord{:href => "/nlab/show/left+Bousfield+localization"} left Bousfield localization
                does not change the class of
                %a.existingWikiWord{:href => "/nlab/show/cofibrations"} cofibrations
                (by Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#BousfieldLocalizationOfModelCategories"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi lim
                        %mo ⟵
                    %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}
                preserves
                %a.existingWikiWord{:href => "/nlab/show/fibrant+objects"} fibrant objects
                (by Prop.
                = succeed ")." do
                  %a.maruku-ref{:href => "#RecognitionOfSimplicialQuillenAdjunction"}
              %p
                But by assumption
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                has a
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo =
                      %msup
                        %mi 𝔸
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \ast = \mathbb{A}^0
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#InitialObject"}
                %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mi op
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{op}
                %a.existingWikiWord{:href => "/nlab/show/limit"} limit
                operation is given just by evaluation on that object:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi lim
                        %mo ⟵
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔸
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\underset{\longleftarrow}{\lim}
                      \\mathbf{X}
                      \\;=\;
                      \\mathbf{X}(\mathbb{A}^0)
                      \\,.
              %p
                Hence it is sufficient to see that an injectively fibrant simplicial presheaf
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}
                is objectwise a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
                = succeed "." do
                  %a.maruku-ref{:href => "#ModelCategoriesOfSimplicialPresheaves"}
              %p
                To check that
                %a.maruku-eqref{:href => "#eq:QuillenEquivalenceInABousfLocalization"} (105)
                is actually a
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#QuillenEquivalence"}
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
                and
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+counit"} derived adjunction counit
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#DerivedAdjunctionUnit"}
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} X \in sSet
                any simplicial set (necessarily cofibrant), the
                %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi id
                            %mi X
                      %mi const
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔸
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo ⟶
                        %mrow
                          %mi const
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi j
                            %mi X
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi 𝔸
                            %mn 0
                          %mo{:stretchy => "false"} )
                      %mi const
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔸
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      X
                      \\overset{id_X}{\longrightarrow}
                      const(X)(\mathbb{A}^0)
                      \\overset{ const(j_X)(\mathbb{A}^0) }{\longrightarrow}
                      const(P X)(\mathbb{A}^0)
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi j
                            %mi X
                      %mi P
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \overset{j_X}{\longrightarrow} P X
                is a
                %a.existingWikiWord{:href => "/nlab/show/fibrant+replacement"} fibrant replacement
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi const
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi 𝔸
                        %mn 0
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} const(-)(\mathbb{A}^0)
                is clearly the
                %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
                and the plain adjunction unit is the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/identity+morphism"} identity morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mi X
                    %annotation{:encoding => "application/x-tex"} j_X
                itself, which is indeed a weak equivalence.
              %p
                For the other case, let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                      %mo ∈
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %msub
                        %mi sSet
                        %mi Qu
                      %msub
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mi inj
                          %mo ,
                          %mi loc
                          %mo ,
                          %msup
                            %mi 𝔸
                            %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbf{X} \in [\mathcal{C}^{op}, sSet_{Qu}]_{inj, loc, \mathbb{A}^1}
                be fibrant. This means (by Prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ExistenceOfLeftBousfieldLocalization"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}
                is fibrant in the injective
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
                as well as in the local model structure, and is a derived-
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^1
                \-
                %a.existingWikiWord{:href => "/nlab/show/local+object"} local object
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#DerivedLocalObjects"}
                %a.existingWikiWord{:href => "/nlab/show/derived+hom-functor"} derived hom-functor
                out of any
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔸
                        %mi n
                      %mo ×
                      %msup
                        %mi 𝔸
                        %mn 1
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi p
                            %mn 1
                      %msup
                        %mi 𝔸
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathbb{A}^n \times \mathbb{A}^1 \overset{p_1}{\longrightarrow} \mathbb{A}^n
                into
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi X
                    %annotation{:encoding => "application/x-tex"} \mathbf{X}
                is a
                = succeed ":" do
