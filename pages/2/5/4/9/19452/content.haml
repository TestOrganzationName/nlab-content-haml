                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %msup
                                %mi D
                                %mi n
                              %mo ×
                              %mi I
                            %mtd
                              %mo ≃
                            %mtd
                              %msup
                                %mi D
                                %mi n
                              %mo ×
                              %mi I
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      (D^n \times \{0\})\cup (\partial D^n \times I) &amp;\simeq&amp; D^n
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      D^n \times I &amp;\simeq&amp; D^n\times I
                      }
              %p
                and hence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
                is a Serre fibration equivalently also if it admits lifts in all diagrams of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
