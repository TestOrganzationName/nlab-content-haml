                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
                              %mo{:stretchy => "false"} (
                              %mi C
                              %mo ⊗
                              %mi Y
                              %mo{:stretchy => "false"} (
                              %mi j
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                              %mo ,
                              %mi X
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %munder
                                %mi lim
                                %munder
                                  %mo ⟵
                                  %mrow
                                    %mi j
                                    %mo ∈
                                    %mi 𝒥
                              %msub
                                %mi Hom
                                %mi 𝒞
                              %mo{:stretchy => "false"} (
