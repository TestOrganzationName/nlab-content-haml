                                  %mi 𝒞
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mi F
                                %mtd
                                  %mi 𝒟
                              %mtr
                                %mtd
                                %mtd
                                  %msup
                                    %mrow
                                    %mrow
                                      %msub
                                        %mpadded{:lspace => "-100%width", :width => "0"}
                                          %mi γ
                                        %mrow
                                          %msub
                                            %mi 𝒞
                                            %mi f
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                %mtd
                                  %msub
                                    %mo ⇙
                                    %mo ≃
                                %mtd
                                %mtd
                                  %msup
                                    %mo{:stretchy => "false"} ↓
