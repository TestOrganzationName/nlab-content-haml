            %p
              The archetypical example of a
              %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
              is the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/category+of+categories"} category of categories
            #2CategoryOfCategories.num_example
              %h6#example_21 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/2-category+of+categories"}> 2-category of categories
                  )
              %p
                There is a
                %a.existingWikiWord{:href => "/nlab/show/strict+2-category"} strict 2-category
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Strict2Categories"}
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                whose
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                    are
                    %a.existingWikiWord{:href => "/nlab/show/small+categories"} small categories
                    (Def.
                    = succeed ");" do
                      %a.maruku-ref{:href => "#SmallCategory"}
                %li
                  %p
