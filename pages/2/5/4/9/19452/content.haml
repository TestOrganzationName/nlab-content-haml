                    %annotation{:encoding => "application/x-tex"}
                      (F \dashv G)
                      \\;\colon\;
                      \\mathcal{C}
                      \\underoverset
                      {\underset{G}{\longleftarrow}}
                      {\overset{ \phantom{AA} F \phantom{AA} }{\longrightarrow}}
