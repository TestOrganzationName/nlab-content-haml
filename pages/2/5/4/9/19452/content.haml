                          %mi R
                        %mover
                          %mo ⟵
                          %mi C
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}_2
                      \\underoverset
                      {\underset{R}{\longrightarrow}}
                      {\overset{C}{\longleftarrow}}
                      {{}_{\phantom{Qu}}\bot_{Qu}}
                      \\mathcal{D}
              %p
                such that the two
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model structures
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_2
                on the category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                share the same class of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              %p Then:
              %ol
                %li
                  %p
                    the
                    %a.existingWikiWord{:href => "/nlab/show/derived+adjunction+unit"} derived adjunction unit
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
