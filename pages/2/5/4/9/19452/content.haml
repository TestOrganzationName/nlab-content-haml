                                    %mn 1
                                  %mo{:stretchy => "false"} )
                                %mtd
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mrow
                                      %mphantom
                                        %mi AA
                                      %mi F
                                      %mo{:stretchy => "false"} (
                                      %mi g
                                      %mo{:stretchy => "false"} )
                                      %mphantom
                                        %mi AA
                                %mtd
                                %mtd
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi X
                                    %mn 2
                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                %mtd
                                  %msub
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 1
                                  %mo ↘
                                %mtd
                                %mtd
                                  %msub
                                    %mo ↙
                                    %mpadded{:width => "0"}
                                      %mrow
                                        %msub
                                          %mi f
                                          %mn 2
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi c
                        %annotation{:encoding => "application/x-tex"}
                          f_2\circ F(g)
                          \\;=\;
                          f_1
                          \\phantom{AAAAAA}
                          \\array{
                          X_1 &amp;&amp; \overset{\phantom{AA} g \phantom{AA}}{\longrightarrow} &amp;&amp; X_2
                          \\\
                          F(X_1)
                          \&amp;&amp;
                          \\overset{\phantom{AA} F(g) \phantom{AA}}{\longrightarrow}
                          \&amp;&amp;
                          F(X_2)
                          \\\
                          \&amp; {}_{\mathllap{f_1}}\searrow &amp;&amp; \swarrow_{\mathrlap{f_2}}
                          \\\
                          \&amp;&amp; c
                          }
                  %p
                    There is a canonical
                    %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
