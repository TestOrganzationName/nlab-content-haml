                from def.
                = succeed "," do
                  %a.maruku-ref{:href => "#ClassicalModelStructureOnPointedTopologicalSpaces"}
                %strong with non-degenerate basepoints
                or . Notice that the point itself is cofibrant in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Top
                          %mi Quillen
                      %annotation{:encoding => "application/x-tex"} Top_{Quillen}
            %p
              While the existence of the model structure on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"} Top^{\ast/}
              is immediate, via prop.
              = succeed "," do
                %a.maruku-ref{:href => "#ModelStructureOnSliceCategory"}
              %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functors"} topologically enriched functors
              (
              %a{:href => "#ModelStructureOnTopEnrichedFunctors"}> below
              ) it is useful to record that this, too, is a
              %a.existingWikiWord{:href => "/nlab/show/cofibrantly+generated+model+category"} cofibrantly generated model category
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#CofibrantlyGeneratedModelCategory"}
            #GeneratingCofibrationsForPointedTopologicalSpaces.num_defn
              %h6#definition_51 Definition
              %p Write
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                      %mo =
                      %mrow
                        %mo {
                        %msubsup
                          %mi S
                          %mo +
                          %mrow
                            %mi n
                            %mo −
                            %mn 1
                        %mover
                          %mo ⟶
                          %mrow
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi ι
                              %mi n
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo +
                        %msubsup
                          %mi D
                          %mo +
                          %mi n
                        %mo }
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⊂
