                  %p from the colimit over the limit sequnce to the limit of the colimits of sequences.
            .proof
              %h6#proof_80 Proof
              %p Regarding the first statement:
              %p
                Use that both
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
