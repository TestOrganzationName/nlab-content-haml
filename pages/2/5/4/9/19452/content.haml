            #InitialObject.num_defn
              %h6#definition_3 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                  and
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#Categories"}
              %ol
                %li
                  %p
                    an
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \ast \in \mathcal{C}
                    is called a
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                    if for every other
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi c
                            %mo ∈
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
                    %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
                    from
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                        %annotation{:encoding => "application/x-tex"} c
                    to
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi c
                          %mover
                            %mo ⟶
                            %mrow
                              %mo ∃
                              %mo !
                          %mo *
                        %annotation{:encoding => "application/x-tex"}
                          c \overset{\exists!}{\longrightarrow} \ast
                  %p
                    hence if the
                    %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                    is a
                    %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo *
                            %mo ∈
                            %mi Set
                          %annotation{:encoding => "application/x-tex"} \ast \in Set
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %mi c
                          %mo ,
                          %mo *
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo ≃
                          %mspace{:width => "thickmathspace"}
                          %mo *
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          Hom_{\mathcal{C}}(c,\ast) \;\simeq\; \ast
                          \\,.
                %li
                  %p
                    an
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ∅
                          %mo ∈
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \emptyset \in \mathcal{C}
                    is called an
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                    if for every other
                    %a.existingWikiWord{:href => "/nlab/show/object"} object
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi c
                            %mo ∈
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} c \in \mathcal{C}
