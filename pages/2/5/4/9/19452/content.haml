                in the abstract sense of def.
                = succeed "." do
                  %a.maruku-ref{:href => "#PathAndCylinderObjectsInAModelCategory"}
            .proof
              %h6#proof_58 Proof
              %p
                To see that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi const
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo →
                      %msup
                        %mi X
                        %mi I
                    %annotation{:encoding => "application/x-tex"} const \colon X\to X^I
                is a
                %a.existingWikiWord{:href => "/nlab/show/weak+homotopy+equivalence"} weak homotopy equivalence
                it is sufficient, by prop.
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalHomotopyEquivalencesAreWeakHomotopyEquivalences"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
