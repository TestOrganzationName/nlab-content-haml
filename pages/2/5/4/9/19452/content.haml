                                %mtd
                                  %mo ≃
                                %mtd
                                  %mi Ho
                                  %mo{:stretchy => "false"} (
                                  %mi 𝒞
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %munder
                                    %mo ⟶
                                    %mrow
                                      %mi Ho
                                      %mo{:stretchy => "false"} (
                                      %mi F
                                      %mo{:stretchy => "false"} )
                                %mtd
                                  %mi Ho
                                  %mo{:stretchy => "false"} (
                                  %mi 𝒟
                                  %mo{:stretchy => "false"} )
                          %mspace{:width => "thinmathspace"}
                          %mo ,
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \&amp; \mathcal{C}_f &amp;\hookrightarrow&amp; \mathcal{C} &amp;\overset{F}{\longrightarrow}&amp; \mathcal{D}
                          \\\
                          \&amp;
                          {}^{\mathllap{\gamma}_{\mathcal{C}_f}}
                          \\downarrow
                          \&amp;&amp;
                          \\swArrow_{\simeq}
                          \&amp;&amp;
                          \\downarrow^{\mathrlap{\gamma_{\mathcal{D}}}}
                          \\\
                          \\mathbb{R} F \colon &amp; \mathcal{C}_f[W^{-1}] &amp;\simeq&amp; Ho(\mathcal{C})
                          \&amp;\underset{Ho(F)}{\longrightarrow}&amp; Ho(\mathcal{D})
                          }
                          \\,,
                  %p
                    where we use corollary
                    = succeed "." do
                      %a.maruku-ref{:href => "#HomotopyCategoryOfSubcategoriesOfModelCategoriesOnGoodObjects"}
                %li
                  %p
                    If the restriction of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                    to the
                    %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝒞
                            %mi c
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}_c
                    of cofibrant object becomes a homotopical functor (def.
                    = succeed ")," do
                      %a.maruku-ref{:href => "#HomotopicalFunctor"}
                    %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                    of that restriction, according to def.
                    = succeed "," do
                      %a.maruku-ref{:href => "#DerivedFunctorOfAHomotopicalFunctor"}
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/left+derived+functor"} left derived functor
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                        %annotation{:encoding => "application/x-tex"} F
                    and denoted by
                    = succeed ":" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝕃
                            %mi F
                          %annotation{:encoding => "application/x-tex"} \mathbb{L}F
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                  %msub
                                    %mi 𝒞
                                    %mi c
