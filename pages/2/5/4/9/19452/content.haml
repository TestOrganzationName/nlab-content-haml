                      \\underoverset
                      {{\longleftarrow}}
                      {\overset{L}{\longrightarrow}}
                      {{}_{\phantom{Qu}}\bot_{Qu}}
                      \\mathcal{D}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 2
                      %munderover
                        %mrow
                          %msub
                            %mrow
                            %mphantom
                              %mi Qu
                          %msub
                            %mo ⊥
                            %mi Qu
                        %munder
