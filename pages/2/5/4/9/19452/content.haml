                                %mi Path
                                %mo *
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Path
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi pb
                              %mo{:stretchy => "false"} )
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mover
                                    %mi f
                                    %mo{:stretchy => "false"} ˜
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      Path_\ast(f) &amp;\longrightarrow&amp; Path(f)
                      \\\
                      \\downarrow &amp;(pb)&amp; \downarrow^{\mathrlap{\tilde f}}
                      \\\
                      \\ast &amp;\longrightarrow&amp; Y
                      }
                      \\,.
            %p
              The following prop.
              %a.maruku-ref{:href => "#FiberOfFibrationIsCompatibleWithWeakEquivalences"}
              says that, up to equivalence, this situation is independent of the specific fibration resolution
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              provided by the
              %a.existingWikiWord{:href => "/nlab/show/factorization+lemma"} factorization lemma
              (hence by the prescription for the
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/mapping+cocone"} mapping cocone
              %em some
              fibration resolution.
            #FiberOfFibrationIsCompatibleWithWeakEquivalences.num_prop
              %h6#proposition_18 Proposition
              %p
                In the
                %a.existingWikiWord{:href => "/nlab/show/category+of+fibrant+objects"} category of fibrant objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                        %msub
                          %mo{:stretchy => "false"} )
                          %mi f
                      %annotation{:encoding => "application/x-tex"} (\mathcal{C}^{\ast/})_f
                = succeed "," do
                  %a.maruku-ref{:href => "#FullSubcategoriesOfFibrantCofibrantObjects"}
                %a.existingWikiWord{:href => "/nlab/show/slice+model+structure"} model structure on pointed objects
                (prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#ModelStructureOnSliceCategory"}
                = succeed "-diagrams," do
                  %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
                of the form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
