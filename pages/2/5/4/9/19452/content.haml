                          %mi n
                          %mo +
                          %mn 1
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} D^{n+1} \to D^{n+1} \times I
                (as in remark
                = succeed ")." do
                  %a.maruku-ref{:href => "#SerreFibrationsByLiftingAgainstMapsHomeomorphicToDiskInclusions"}
            %h3#ModelstructureOnPointedTopologicalSpaces Model structure on pointed spaces
            %p
              A
              %em
                %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x)
              is of course an
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo{:lspace => "verythinmathspace"} :
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \colon \ast \to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,x) \longrightarrow (Y,y)
              is a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \longrightarrow Y
              that takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
            %p
              Passing to pointed objects is also the first step in linearizing classical homotopy theory to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/zero+morphisms"} zero morphisms
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Introduction+to+Stable+homotopy+theory+--+1"} section on stable homotopy theory
            #SliceCategory.num_defn
              %h6#definition_46 Definition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                and let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X \in \mathcal{C}
                be an
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/object"} object
              %p
                The
                %em
                  %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
                is the category whose
              %ul
                %li
                  %p
                    objects are morphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi A
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                              %mtr
                                %mtd
                                  %mi X
                        %annotation{:encoding => "application/x-tex"} \array{A \\ \downarrow \\ X}
                    in
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %li
                  %p
                    morphisms are
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting triangles
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi A
                                %mtd
                                %mtd
                                  %mo ⟶
                                %mtd
                                %mtd
                                  %mi B
                              %mtr
                                %mtd
                                %mtd
                                  %msub
                                    %mrow
                                    %mrow
                                  %mo ↘
                                %mtd
                                %mtd
                                  %mo ↙
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi X
                        %annotation{:encoding => "application/x-tex"} \array{ A &amp;&amp; \longrightarrow &amp;&amp; B \\ &amp; {}_{}\searrow &amp;&amp; \swarrow \\ &amp;&amp; X}
                    in
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %p
                Dually, the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{X/}
                is the category whose
              %ul
                %li
                  %p
                    objects are morphisms
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi X
                              %mtr
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                              %mtr
                                %mtd
                                  %mi A
                        %annotation{:encoding => "application/x-tex"} \array{X \\ \downarrow \\ A}
                    in
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %li
                  %p
                    morphisms are
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting triangles
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mi X
                              %mtr
                                %mtd
                                %mtd
                                  %mo ↙
                                %mtd
                                %mtd
                                  %mo ↘
                              %mtr
                                %mtd
                                  %mi A
                                %mtd
                                %mtd
                                  %mo ⟶
                                %mtd
                                %mtd
                                  %mi B
                        %annotation{:encoding => "application/x-tex"} \array{ &amp;&amp; X \\ &amp; \swarrow &amp;&amp; \searrow \\ A &amp;&amp; \longrightarrow &amp;&amp; B }
                    in
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %p
                There are the canonical
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functors"} forgetful functors
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi 𝒞
                        %mrow
                          %mo{:stretchy => "false"} /
                          %mi X
                      %mo ,
                      %msup
                        %mi 𝒞
                        %mrow
                          %mi X
                          %mo{:stretchy => "false"} /
                      %mo ⟶
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      U \;\colon \; \mathcal{C}_{/X}, \mathcal{C}^{X/} \longrightarrow \mathcal{C}
              %p
                given by forgetting the morphisms to/from
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
            %p We here focus on this class of examples:
            #CategoryOfPointedObjects.num_defn
              %h6#definition_47 Definition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                with
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                %a.existingWikiWord{:href => "/nlab/show/coslice+category"} coslice category
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#SliceCategory"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                is the corresponding
                = succeed ":" do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
              %ul
                %li
                  %p
                    objects are morphisms in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    of the form
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                          %mover
                            %mo →
                            %mi x
                          %mi X
                        %annotation{:encoding => "application/x-tex"} \ast \overset{x}{\to} X
                    (hence an object
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
                    equipped with a choice of point; i.e. a
                    = succeed ");" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed object
                %li
                  %p
                    morphisms are
                    %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting triangles
                    of the form
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                %mtd
                                  %mo *
                              %mtr
                                %mtd
                                %mtd
                                  %msup
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mi x
                                  %mo ↙
                                %mtd
                                %mtd
                                  %msup
                                    %mo ↘
                                    %mpadded{:width => "0"}
                                      %mi y
                              %mtr
                                %mtd
                                  %mi X
                                %mtd
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mi f
                                %mtd
                                %mtd
                                  %mi Y
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \&amp;&amp; \ast
                          \\\
                          \&amp; {}^{\mathllap{x}}\swarrow &amp;&amp; \searrow^{\mathrlap{y}}
                          \\\
                          X &amp;&amp; \overset{f}{\longrightarrow} &amp;&amp; Y
                          }
                  %p
                    (hence morphisms in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    which preserve the chosen points).
            #PointedObjectsHaveZeroObject.num_remark
              %h6#remark_24 Remark
              %p
                In a
                %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                = succeed "," do
                  %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                coincides with the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \ast \in \mathcal{C}
                itself, pointed in the unique way.
              %p
                In this situation one says that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast
                is a
                %em
                  %a.existingWikiWord{:href => "/nlab/show/zero+object"} zero object
                and that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                is a
                = succeed "." do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/pointed+category"} pointed category
              %p
                It follows that also all
                %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mrow
                          %msup
                            %mi 𝒞
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Hom_{\mathcal{C}^{\ast/}}(X,Y)
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                are canonically
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pointed+sets"} pointed sets
                %em
                  %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero morphism
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi X
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∃
                          %mo !
                      %mn 0
                      %mover
                        %mo ⟶
                        %mrow
                          %mo ∃
                          %mo !
                      %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      0
                      \\;\colon\;
                      X
                      \\overset{\exists !}{\longrightarrow}
                      0
                      \\overset{\exists !}{\longrightarrow} Y
                      \\,.
            #BasePointAdjoined.num_defn
              %h6#definition_48 Definition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                with
                %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/finite+colimits"} finite colimits
                %a.existingWikiWord{:href => "/nlab/show/forgetful+functor"} forgetful functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo →
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} U \colon \mathcal{C}^{\ast/} \to \mathcal{C}
                from its
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
                = succeed "," do
                  %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %munderover
                        %mo ⊥
                        %munder
                          %mo ⟶
                          %mi U
                        %mover
                          %mo ⟵
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msub
                              %mo{:stretchy => "false"} )
                              %mo +
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"}
                      \\mathcal{C}^{\ast/}
                      \\underoverset
                      {\underset{U}{\longrightarrow}}
                      {\overset{(-)_+}{\longleftarrow}}
                      {\bot}
                      \\mathcal{C}
              %p
                given by forming the
                %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
                (
                %a.existingWikiWord{:href => "/nlab/show/coproduct"}> coproduct
                ) with a base point (“adjoining a base point”).
            #LimitsAndColimitsOfPointedObjects.num_prop
              %h6#proposition_37 Proposition
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                with all
                %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
                %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                = succeed "," do
                  %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
              %p Moreover:
              %ol
                %li
                  %p
                    the limits are the limits of the underlying diagrams in
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %li
                  %p
                    the colimits are the limits in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    of the diagrams
                    = succeed "." do
                      %em with the basepoint adjoined
            .proof
              %h6#proof_59 Proof
              %p
                It is immediate to check the relevant
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                = succeed "." do
                  %em
                    %a{:href => "overcategory#LimitsAndColimits"} slice category – limits and colimits
            #WedgeSumAsCoproduct.num_example
              %h6#example_29 Example
              %p
                Given two pointed objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,x)
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi Y
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (Y,y)
              %ol
                %li
                  %p
                    their
                    %a.existingWikiWord{:href => "/nlab/show/product"} product
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒞
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                    is simply
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo ×
                            %mi Y
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} (X\times Y, (x,y))
                %li
                  %p
                    their
                    %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒞
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                    has to be computed using the second clause in prop.
                    = succeed ":" do
                      %a.maruku-ref{:href => "#LimitsAndColimitsOfPointedObjects"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo *
                        %annotation{:encoding => "application/x-tex"} \ast
                    has to be adjoined to the diagram, it is given not by the coproduct in
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    of the form:
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mo *
                                %mtd
                                  %mover
                                    %mo ⟶
                                    %mi x
                                %mtd
                                  %mi X
                              %mtr
                                %mtd
                                  %msup
                                    %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mi y
                                  %mo{:stretchy => "false"} ↓
                                %mtd
                                  %mo{:stretchy => "false"} (
                                  %mi po
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mo{:stretchy => "false"} ↓
                              %mtr
                                %mtd
                                  %mi Y
                                %mtd
                                  %mo ⟶
                                %mtd
                                  %mi X
                                  %mo ∨
                                  %mi Y
                          %mspace{:width => "thinmathspace"}
                          %mo .
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \\ast &amp;\overset{x}{\longrightarrow}&amp; X
                          \\\
                          {}^{\mathllap{y}}\downarrow &amp;(po)&amp; \downarrow
                          \\\
                          Y &amp;\longrightarrow&amp; X \vee Y
                          }
                          \\,.
                  %p
                    This is called the
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                    operation on pointed objects.
              %p
                Generally for a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi X
                        %mi i
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                    %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top^{\ast/}
              %ol
                %li
                  %p
                    their
                    %a.existingWikiWord{:href => "/nlab/show/product"} product
                    is formed in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Top
                        %annotation{:encoding => "application/x-tex"} Top
                    as in example
                    = succeed "," do
                      %a.maruku-ref{:href => "#ProductTopologicalSpace"}
                %li
                  %p
                    their
                    %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                    is formed by the
                    %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Top
                        %annotation{:encoding => "application/x-tex"} Top
                    over the diagram with a basepoint adjoined, and is called the
                    %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                    = succeed "." do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mo ∨
                              %mrow
                                %mi i
                                %mo ∈
                                %mi I
                            %msub
                              %mi X
                              %mi i
                          %annotation{:encoding => "application/x-tex"} \vee_{i \in I} X_i
            .num_example
              %h6#example_30 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
                %a.maruku-ref{:href => "#TopologicalCellComplex"}
                then for every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                the
                %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                (example
                = succeed ")" do
                  %a.maruku-ref{:href => "#QuotientSpaceAsPushout"}
                = succeed "-skeleton" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-skeleton" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n-1)
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                = succeed "," do
                  %a.maruku-ref{:href => "#WedgeSumAsCoproduct"}
                = succeed "-spheres," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed "-cell" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mi n
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi X
                        %mrow
                          %mi n
                          %mo −
                          %mn 1
                      %mo ≃
                      %munder
                        %mo ∨
                        %mrow
                          %mi i
                          %mo ∈
                          %msub
                            %mi I
                            %mi n
                      %msup
                        %mi S
                        %mi n
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      X^n / X^{n-1} \simeq \underset{i \in I_n}{\vee} S^n
                      \\,.
            #SmashProductOfPointedObjects.num_defn
              %h6#definition_49 Definition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                a
                %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
                with
                %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
                and
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/finite+colimits"} finite colimits
                %em
                  %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                is the
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ×
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo ⟶
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"}
                      (-)\wedge(-)
                      \\;\colon\;
                      \\mathcal{C}^{\ast/}
                      \\times
                      \\mathcal{C}^{\ast/}
                      \\longrightarrow
                      \\mathcal{C}^{\ast/}
              %p given by
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∧
                      %mi Y
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mo *
                      %munder
                        %mo ⊔
                        %mrow
                          %mi X
                          %mo ⊔
                          %mi Y
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      X \wedge Y
                      \\;\coloneqq\;
                      \\ast
                      \\underset{X\sqcup Y}{\sqcup} (X \times Y)
                      \\,,
              %p
                hence by the
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi X
                              %mo ⊔
                              %mi Y
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi id
                                    %mi X
                                  %mo ,
                                  %mi y
                                  %mo{:stretchy => "false"} )
                                  %mo ,
                                  %mo{:stretchy => "false"} (
                                  %mi x
                                  %mo ,
                                  %msub
                                    %mi id
                                    %mi Y
                                  %mo{:stretchy => "false"} )
                            %mtd
                              %mi X
                              %mo ×
                              %mi Y
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} ↓
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                              %mo ∧
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      X \sqcup Y &amp;\overset{(id_X,y),(x,id_Y) }{\longrightarrow}&amp; X \times Y
                      \\\
                      \\downarrow &amp;&amp; \downarrow
                      \\\
                      \\ast &amp;\longrightarrow&amp; X \wedge Y
                      }
                      \\,.
              %p
                In terms of the
                %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                from def.
                = succeed "," do
                  %a.maruku-ref{:href => "#WedgeSumAsCoproduct"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∧
                      %mi Y
                      %mo =
                      %mfrac
                        %mrow
                          %mi X
                          %mo ×
                          %mi Y
                        %mrow
                          %mi X
                          %mo ∨
                          %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      X \wedge Y = \frac{X\times Y}{X \vee Y}
                      \\,.
            #SmashProductOnTopNotAssociative.num_remark
              %h6#remark_25 Remark
              %p
                For a general category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                in def.
                = succeed "," do
                  %a.maruku-ref{:href => "#SmashProductOfPointedObjects"}
                %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                need not be
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} (-)\times Z
                does not preserve the
                %a.existingWikiWord{:href => "/nlab/show/quotients"} quotients
                involved in the definition.
              %p
                In particular this may happen for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo =
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} =
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              %p
                A sufficient condition for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} (-) \times Z
                to preserve quotients is that it is a
                %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                functor. This is the case in the smaller subcategory of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
                %a.maruku-ref{:href => "#SmashProductInTopcgIsAssociative"}
                below.
            %p
              These two operations are going to be ubiquituous in
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+theory"} stable homotopy theory
            %table
              %thead
                %tr
                  %th symbol
                  %th name
                  %th category theory
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∨
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} X \vee Y
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒞
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ∧
                          %mi Y
                        %annotation{:encoding => "application/x-tex"} X \wedge Y
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                    in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi 𝒞
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
            #WedgeAndSmashOfBasePointAdjoinedTopologicalSpaces.num_example
              %h6#example_31 Example
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                        %mo ∈
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} X, Y \in Top
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mo +
                        %mo ,
                        %msub
                          %mi Y
                          %mo +
                        %mo ∈
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} X_+,Y_+ \in Top^{\ast/}
                = succeed "," do
                  %a.maruku-ref{:href => "#BasePointAdjoined"}
              %ul
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mo +
                          %mo ∨
                          %msub
                            %mi Y
                            %mo +
                          %mo ≃
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ⊔
                          %mi Y
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo +
                        %annotation{:encoding => "application/x-tex"} X_+ \vee Y_+ \simeq (X \sqcup Y)_+
                    ;
                %li
                  %p
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mo +
                          %mo ∧
                          %msub
                            %mi Y
                            %mo +
                          %mo ≃
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ×
                          %mi Y
                          %msub
                            %mo{:stretchy => "false"} )
                            %mo +
                        %annotation{:encoding => "application/x-tex"} X_+ \wedge Y_+ \simeq (X \times Y)_+
                    \.
            .proof
              %h6#proof_60 Proof
              %p
                By example
                = succeed "," do
                  %a.maruku-ref{:href => "#WedgeSumAsCoproduct"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo +
                      %mo ∨
                      %msub
                        %mi Y
                        %mo +
                    %annotation{:encoding => "application/x-tex"} X_+ \vee Y_+
                is given by the colimit in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Top
                    %annotation{:encoding => "application/x-tex"} Top
                over the diagram
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mo ↙
                            %mtd
                            %mtd
                              %mo ↘
                          %mtr
                            %mtd
                              %mi X
                            %mtd
                              %mspace{:width => "thinmathspace"}
                              %mspace{:width => "thinmathspace"}
                            %mtd
                              %mo *
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %mo *
                            %mtd
                              %mspace{:width => "thinmathspace"}
                              %mspace{:width => "thinmathspace"}
                            %mtd
                              %mi Y
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;&amp; &amp;&amp; \ast
                      \\\
                      \&amp;&amp; &amp; \swarrow &amp;&amp; \searrow
                      \\\
                      X &amp;\,\,&amp; \ast &amp;&amp; &amp;&amp; \ast &amp;\,\,&amp; Y
                      }
                      \\,.
              %p
                This is clearly
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ⊔
                        %mo *
                        %mo ⊔
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} X \sqcup \ast \sqcup Y
                %a.maruku-ref{:href => "#SmashProductOfPointedObjects"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                          %mtr
                            %mtd
                              %msub
                                %mi X
                                %mo +
                              %mo ∧
                              %msub
                                %mi Y
                                %mo +
                            %mtd
                              %mo ≃
                              %mfrac
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi X
                                  %mo ⊔
                                  %mo *
                                  %mo{:stretchy => "false"} )
                                  %mo ×
                                  %mo{:stretchy => "false"} (
                                  %mi X
                                  %mo ⊔
                                  %mo *
                                  %mo{:stretchy => "false"} )
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi X
                                  %mo ⊔
                                  %mo *
                                  %mo{:stretchy => "false"} )
                                  %mo ∨
                                  %mo{:stretchy => "false"} (
                                  %mi Y
                                  %mo ⊔
                                  %mo *
                                  %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %mfrac
                                %mrow
                                  %mi X
                                  %mo ×
                                  %mi Y
                                  %mo ⊔
                                  %mi X
                                  %mo ⊔
                                  %mi Y
                                  %mo ⊔
                                  %mo *
                                %mrow
                                  %mi X
                                  %mo ⊔
                                  %mi Y
                                  %mo ⊔
                                  %mo *
                          %mtr
                            %mtd
                            %mtd
                              %mo ≃
                              %mi X
                              %mo ×
                              %mi Y
                              %mo ⊔
                              %mo *
                              %mspace{:width => "thinmathspace"}
                              %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{aligned}
                      X_+ \wedge Y_+
                      \&amp; \simeq
                      \\frac{(X \sqcup \ast) \times (X \sqcup \ast)}{(X\sqcup \ast) \vee (Y \sqcup \ast)}
                      \\\
                      \&amp; \simeq
                      \\frac{X \times Y \sqcup X \sqcup Y \sqcup \ast}{X \sqcup Y \sqcup \ast}
                      \\\
                      \&amp; \simeq
                      X \times Y \sqcup \ast
                      \\,.
                      \\end{aligned}
            #StandardReducedCyclinderInTop.num_example
              %h6#example_32 Example
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo =
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/} = Top^{\ast/}
                be
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi I
                        %mo +
                      %mo ∈
                      %msup
                        %mi Top
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"}
                      I_+ \in Top^{\ast/}
              %p
                denotes the standard interval object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo =
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} I = [0,1]
                from def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalInterval"}
                = succeed "." do
                  %a.maruku-ref{:href => "#BasePointAdjoined"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                any
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed topological space
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi I
                        %mo +
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ×
                      %mi I
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi x
                        %mn 0
                      %mo{:stretchy => "false"} }
                      %mo ×
                      %mi I
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      X \wedge (I_+) = (X \times I)/(\{x_0\} \times I)
              %p
                is the
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/reduced+cylinder"} reduced cylinder
                over
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                as in def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TopologicalInterval"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with the point.
              %p
                (Generally, any construction in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                properly adapted to pointed objects
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝒞
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                is called the “reduced” version of the unpointed construction. Notably so for “
                %a.existingWikiWord{:href => "/nlab/show/reduced+suspension"}> reduced suspension
                ” which we come to
                = succeed ".)" do
                  %a{:href => "#MappingCones"} below
              %p
                Just like the ordinary cylinder
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} X\times I
                receives a canonical injection from the
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊔
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \sqcup X
                formed in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} Top
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊔
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X \sqcup X
                formed in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Top
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} Top^{\ast/}
                %a.existingWikiWord{:href => "/nlab/show/wedge+sum"} wedge sum
                from example
                = succeed ":" do
                  %a.maruku-ref{:href => "#WedgeSumAsCoproduct"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ∨
                      %mi X
                      %mo ⟶
                      %mi X
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi I
                        %mo +
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      X \vee X \longrightarrow X \wedge (I_+)
                      \\,.
            #PointedMappingSpace.num_example
              %h6#example_33 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (X,x),(Y,y)
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/locally+compact+topological+space"} locally compact topological space
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/pointed+mapping+space"} pointed mapping space
                is the
                %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                of the
                %a.existingWikiWord{:href => "/nlab/show/mapping+space"} mapping space
                of def.
                %a.maruku-ref{:href => "#CompactOpenTopology"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Maps
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo ↪
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mi Y
                      %mo ,
                      %msub
                        %mi const
                        %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Maps((Y,y),(X,x))_\ast
                      \\hookrightarrow
                      (X^Y, const_x)
              %p
                on those maps which preserve the basepoints, and pointed by the map constant on the basepoint of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %p
                In particular, the
                %strong standard topological pointed path space object
                on some pointed
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                (the pointed variant of def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#TopologicalPathSpace"}
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Maps
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi I
                          %mo +
                        %mo ,
                        %mi X
                        %msub
                          %mo{:stretchy => "false"} )
                          %mo *
                      %annotation{:encoding => "application/x-tex"} Maps(I_+,X)_\ast
              %p
                The pointed consequence of prop.
                %a.maruku-ref{:href => "#MappingTopologicalSpaceIsExponentialObject"}
                then gives that there is a
                %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ∧
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %mi Hom
                        %mrow
                          %msup
                            %mi Top
                            %mrow
                              %mo *
                              %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi Z
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi Maps
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi x
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo *
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{Top^{\ast/}}((Z,z) \wedge (Y,y), (X,x))
                      \\simeq
                      Hom_{Top^{\ast/}}((Z,z), Maps((Y,y),(X,x))_\ast)
              %p
                between basepoint-preserving continuous functions out of a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
                = succeed "," do
                  %a.maruku-ref{:href => "#SmashProductOfPointedObjects"}
            #FiberAndCofiberInPointedObjects.num_example
              %h6#example_34 Example
              %p
                Given a morphism
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ⟶
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} f \colon X \longrightarrow Y
                in a
                %a.existingWikiWord{:href => "/nlab/show/category+of+pointed+objects"} category of pointed objects
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi 𝒞
                          %mrow
                            %mo *
                            %mo{:stretchy => "false"} /
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}^{\ast/}
                = succeed "," do
                  %a.maruku-ref{:href => "#CategoryOfPointedObjects"}
              %ol
                %li
                  %p
                    its
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
