                      }
              %p
                and take the unit transformation
                %a.maruku-eqref{:href => "#eq:UnitComponentOfMonoidalFunctor"} (43)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
