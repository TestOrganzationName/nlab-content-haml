            #FunctorCategory.num_example
              %h6#example_14 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/functor+category"}> functor category
                  )
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{D}
                be
                %a.existingWikiWord{:href => "/nlab/show/categories"} categories
                (Def.
                = succeed ")." do
                  %a.maruku-ref{:href => "#Categories"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/category+of+functors"} category of functors
                between them, to be denoted
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi 𝒞
                        %mo ,
                        %mi 𝒟
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [\mathcal{C}, \mathcal{D}]
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                whose
                %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                are the
                %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mover
                        %mo →
                        %mi F
                      %mi 𝒟
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} \overset{F}{\to} \mathcal{D}
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Functors"}
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                are the
                %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mover
                        %mo ⇒
                        %mi η
                      %mi G
                    %annotation{:encoding => "application/x-tex"} F \overset{\eta}{\Rightarrow} G
                between functors (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#NaturalTransformations"}
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
                operation is the composition of natural transformations
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:NaturalTransformationComposition"} (5)
            #CategoryOfPresheaves.num_example
              %h6#example_15 Example
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"}> category of presheaves
                  )
              %p
                Given a
                %a.existingWikiWord{:href => "/nlab/show/category"} category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Categories"}
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
                (Def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#Functors"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ⟶
                      %mi Set
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      F \;\colon\; \mathcal{C}^{op} \longrightarrow Set
                      \\,,
              %p
                hence out of the
                %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#OppositeCategory"}
                %a.existingWikiWord{:href => "/nlab/show/category+of+sets"} category of sets
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#CategoryOfSets"}
                %em
                  %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaf
                (for reasons discussed below)
                %em
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
                or
                = succeed "." do
                  %em
                    over
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %p
                The corresponding
                %a.existingWikiWord{:href => "/nlab/show/functor+category"} functor category
                (Example
                = succeed ")" do
                  %a.maruku-ref{:href => "#FunctorCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝒞
                        %mi op
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"}
                      PSh(\mathcal{C})
                      \\;\coloneqq\; [\mathcal{C}^{op}, Set]
              %p
                is hence called the
                %em
                  %a.existingWikiWord{:href => "/nlab/show/category+of+presheaves"} category of presheaves
                over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
