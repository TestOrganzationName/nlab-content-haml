                          %mrow
                            %mi β
                            %mo +
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} X_{\beta} \to X_{\beta + 1}
              %p To that end, let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mrow
                          %msub
                            %mi n
                            %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mi i
                      %mo ×
                      %mi I
                      %mo ⟶
