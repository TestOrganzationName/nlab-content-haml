                      %mo ⊣
                      %mi Γ
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ≃
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Disc
                        %mi inf
                      %mo ∘
                      %msub
                        %mi Disc
                        %mi red
                      %mspace{:width => "thinmathspace"}
                      %mo ⊣
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi Γ
                        %mi red
                      %mo ∘
                      %msub
                        %mi Γ
                        %mi inf
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (Disc \dashv \Gamma)
                      \\;\simeq\;
                      ( Disc_{inf} \circ Disc_{red} \,\dashv\, \Gamma_{red} \circ \Gamma_{inf} )
              %p
                follows from the essential uniqueness of the
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/global+section"} global section
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
