                      \\,.
            .proof
              %h6#proof_76 Proof
              %p
                First consider the underlying diagram of functors
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi F
                        %mi i
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} F_i^\circ
                where the topology on the
                %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                and of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
                has been forgotten. Then one finds
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %munder
                          %mi lim
                          %mo ⟵
                        %mi i
                      %msubsup
                        %mi F
                        %mi i
                        %mo ∘
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %munder
                          %mi lim
                          %mo ⟵
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi F
                        %mi i
                        %mo ∘
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mi Set
                    %annotation{:encoding => "application/x-tex"}
                      (\underset{\longleftarrow}{\lim}_i F^\circ_i)(c) \simeq \underset{\longleftarrow}{\lim}_i (F^\circ_i(c)) \;\;\in Set
              %p and
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %munder
                          %mi lim
                          %mo ⟶
                        %mi i
                      %msubsup
                        %mi F
                        %mi i
                        %mo ∘
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msub
                        %munder
                          %mi lim
                          %mo ⟶
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi F
                        %mi i
