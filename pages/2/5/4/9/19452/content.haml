                      \\,.
              %p
                (This is the first example of the more general phenomenon of
                = succeed ".)" do
                  %a.existingWikiWord{:href => "/nlab/show/universal+principal+infinity-bundles"} universal principal infinity-bundles
            #LoopSpaceGroupoid.num_example
              %h6#example_60 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a
                %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \ast \to X
                a point in it, we call
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Ω
                      %mi X
                      %mo ≔
                      %mo *
                      %munder
                        %mo ×
                        %mi X
                      %mo *
                    %annotation{:encoding => "application/x-tex"}
                      \\Omega X
                      \\coloneqq
                      \\ast \underset{X}{\times} \ast
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space groupoid
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a group and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                its
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                groupoid from example
                = succeed "," do
                  %a.maruku-ref{:href => "#DeloopingGroupoid"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ≃
                      %mi Ω
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo =
                      %mo *
                      %munder
                        %mo ×
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mo *
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      G \simeq \Omega \mathbf{B}G = \ast \underset{\mathbf{B}G}{\times} \ast
                      \\,.
              %p
                Hence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                is the
                %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop space object
                of its own
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            .proof
              %h6#proof_85 Proof
              %p
                We are to compute the ordinary limiting cone
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo *
                      %munder
                        %mo ×
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi G
                            %mo •
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msup
                        %mi G
                        %mi I
                      %msub
                        %mo{:stretchy => "false"} )
                        %mo •
                      %munder
                        %mo ×
                        %mrow
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %msub
                            %mi G
                            %mo •
                      %mo *
                    %annotation{:encoding => "application/x-tex"} \ast \underset{\mathbf{B}G_\bullet}{\times}  (\mathbf{B}G^I)_\bullet \underset{\mathbf{B}G_\bullet}{\times} \ast
                in
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                            %mtd
                              %mo →
                            %mtd
                            %mtd
                              %mo →
                            %mtd
                              %mo *
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                          %mtr
                            %mtd
                            %mtd
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mi G
                              %msubsup
                                %mo{:stretchy => "false"} )
                                %mo •
                                %mi I
                            %mtd
                              %munder
                                %mo →
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %msub
                                    %mi ev
                                    %mn 0
                                  %msub
                                    %mo{:stretchy => "false"} )
                                    %mo •
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %msub
                                %mi G
                                %mo •
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi ev
                                      %mn 1
                                    %msub
                                      %mo{:stretchy => "false"} )
                                      %mo •
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %munder
                                %mo →
                                %mrow
                            %mtd
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %msub
                                %mi G
                                %mo •
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      \&amp;\to&amp; &amp;\to&amp; \ast
                      \\\
                      \\downarrow &amp;&amp; &amp;&amp; \downarrow^{\mathrlap{}}
                      \\\
                      \&amp;&amp; (\mathbf{B}G)^I_\bullet &amp;\underset{(ev_0)_\bullet}{\to}&amp; \mathbf{B}G_\bullet
                      \\\
                      \\downarrow &amp;&amp; \downarrow^{\mathrlap{(ev_1)_\bullet}}
                      \\\
                      \\ast &amp;\underset{}{\to}&amp; \mathbf{B}G_\bullet
                      }
                      \\,,
              %p
                In the middle we have the groupoid
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mo •
                        %mi I
                    %annotation{:encoding => "application/x-tex"} (\mathbf{B}G)^I_\bullet
                whose objects are elements of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                and whose morphisms starting at some element are labeled by pairs of elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mn 1
                      %mo ,
                      %msub
                        %mi h
                        %mn 2
                      %mo ∈
                      %mi G
                    %annotation{:encoding => "application/x-tex"} h_1, h_2 \in G
                and end at
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi h
                          %mn 1
                        %mo ⋅
                        %mi g
                        %mo ⋅
                        %msub
                          %mi h
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} h_1 \cdot g \cdot h_2
                %a.maruku-ref{:href => "#FiberProductsOfGroupoidsComponentwise"}
                the limiting cone is seen to precisely pick those morphisms in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %msub
                        %mi G
                        %mo •
                      %msubsup
                        %mo{:stretchy => "false"} )
                        %mo •
                        %mi I
                    %annotation{:encoding => "application/x-tex"} (\mathbf{B}G_\bullet)^I_\bullet
                such that these two elements are constant on the neutral element
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi h
                          %mn 1
                        %mo =
                        %msub
                          %mi h
                          %mn 2
                        %mo =
                        %mi e
                        %mo =
                        %msub
                          %mi id
                          %mo *
                      %annotation{:encoding => "application/x-tex"} h_1 = h_2 = e = id_{\ast}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                regarded as a groupoid with only identity morphisms, as in example
                = succeed "." do
                  %a.maruku-ref{:href => "#SetAsGroupoid"}
            #FreeLoopSpaceOfGroupoid.num_prop
              %h6#proposition_60 Proposition
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi X
                      %munder
                        %mo ×
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %mi X
                          %mo{:stretchy => "false"} ]
                      %mi X
                    %annotation{:encoding => "application/x-tex"}
                      [\Pi(S^1), X]
                      \\simeq
                      X \underset{[\Pi(S^0), X]}{\times}X
            .proof
              %h6#proof_86 Proof
              %p
                Notice that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Π
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi S
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mo *
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \Pi_1(S^0) \simeq \ast \coprod \ast
                %a.existingWikiWord{:href => "/nlab/show/path+space+object"} path space object
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi X
                        %mo •
                      %msubsup
                        %mo{:stretchy => "false"} ]
                        %mo •
                        %mi I
                    %annotation{:encoding => "application/x-tex"} [\Pi(S^0), X_\bullet]^I_\bullet
                has
              %ul
                %li
                  %p
                    objects are pairs of morphisms in
                    = succeed ";" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi X
                              %mo •
                          %annotation{:encoding => "application/x-tex"} X_\bullet
                %li
                  %p morphisms are commuting squares of such.
              %p
                Now the fiber product in def.
                %a.maruku-ref{:href => "#HomotopyFiberProductOfGroupoids"}
                picks in there those pairs of morphisms for which both start at the same object, and both end at the same object. Therefore
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                      %munder
                        %mo ×
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mi X
                            %mo •
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mo •
                      %mo{:stretchy => "false"} [
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 0
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %msub
                        %mi X
                        %mo •
                      %msubsup
                        %mo{:stretchy => "false"} ]
                        %mo •
                        %mi I
                      %munder
                        %mo ×
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi Π
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi S
                            %mn 0
                          %mo{:stretchy => "false"} )
                          %mo ,
                          %msub
                            %mi X
                            %mo •
                          %msub
                            %mo{:stretchy => "false"} ]
                            %mo •
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X_\bullet \underset{[\Pi(S^0), X_\bullet]_\bullet}{\times} [\Pi(S^0), X_\bullet]^I_\bullet \underset{[\Pi(S^0), X_\bullet]_\bullet}{\times} X
                is the groupoid whose
              %ul
                %li
                  %p
                    objects are diagrams in
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi X
                            %mo •
                        %annotation{:encoding => "application/x-tex"} X_\bullet
                    of the form
                  .maruku-equation
                    %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                %mtd
                                  %mo ↗
                                  %mo ↘
                              %mtr
                                %mtd
                                  %msub
                                    %mi x
                                    %mn 0
                                %mtd
                                %mtd
                                  %msub
                                    %mi x
                                    %mn 1
                              %mtr
                                %mtd
                                %mtd
                                  %mo ↘
                                  %mo ↗
                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \&amp; \nearrow \searrow
                          \\\
                          x_0 &amp;&amp; x_1
                          \\\
                          \&amp; \searrow \nearrow
                          }
                %li
                  %p morphism are cylinder-diagrams over these.
              %p
                One finds along the lines of example
                %a.maruku-ref{:href => "#BZIsPiSOne"}
                that this is equivalent to maps from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_1(S^1)
                into
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mo •
                    %annotation{:encoding => "application/x-tex"} X_\bullet
                and homotopies between these.
            .num_remark
              %h6#remark_42 Remark
              %p
                Even though all these models of the circle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Pi_1(S^1)
                are equivalent, below the special appearance of the circle in the proof of prop.
                %a.maruku-ref{:href => "#FreeLoopSpaceOfGroupoid"}
                as the combination of two semi-circles will be important for the following proofs. As we see in a moment, this is the natural way in which the circle appears as the composition of an
                %a.existingWikiWord{:href => "/nlab/show/evaluation+map"} evaluation map
                with a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/coevaluation+map"} coevaluation map
            #AdjointActionGroupoidFromFreeLoopSpaceObject.num_example
              %h6#example_61 Example
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
                %a.existingWikiWord{:href => "/nlab/show/free+loop+space+object"} free loop space object
                of its
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}G
                is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %msub
                          %mo{:stretchy => "false"} /
                          %mi ad
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G//_{ad} G
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
                = succeed "," do
                  %a.maruku-ref{:href => "#ActionGroupoid"}
                %a.existingWikiWord{:href => "/nlab/show/adjoint+action"} adjoint action
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
                on itself:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                      %mo{:stretchy => "false"} ]
                      %mo ≃
                      %mi G
                      %mo{:stretchy => "false"} /
                      %msub
                        %mo{:stretchy => "false"} /
                        %mi ad
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      [\Pi(S^1), \mathbf{B}G] \simeq G//_{ad} G
                      \\,.
            .num_example
              %h6#example_62 Example
              %p
                For an
                %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
                such as
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ♭
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \flat U(1)
                we have
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi Π
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
