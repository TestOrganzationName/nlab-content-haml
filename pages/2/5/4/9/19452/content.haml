                  %a.maruku-ref{:href => "#ComparisonMorphismBetweenOppositeExtremes"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ptp
