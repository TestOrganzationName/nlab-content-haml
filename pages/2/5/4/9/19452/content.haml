                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mo =
                          %mtr
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi A
                              %mo ⊗
                              %mi C
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mi A
                                  %mo ⊗
                                  %mi f
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi N
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mi μ
                                    %mo ⊗
                                    %mi id
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mi ρ
                          %mtr
                            %mtd
                              %mi A
                              %mo ⊗
                              %mi C
                            %mtd
