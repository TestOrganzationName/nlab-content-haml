                %a.existingWikiWord{:href => "/nlab/show/indexed+set"} indexed set
                of composites
                %a.maruku-eqref{:href => "#eq:OneComposite"} (45)
                and
                = succeed "." do
                  %a.maruku-eqref{:href => "#eq:OtherComposite"} (46)
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+natural+transformation"} enriched natural transformation
            %p
              Conversely, example
              %a.maruku-ref{:href => "#NaturalTransformationsViaEnds"}
              says that
              %a.existingWikiWord{:href => "/nlab/show/ends"} ends
              over
              %a.existingWikiWord{:href => "/nlab/show/bifunctors"} bifunctors
              of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [F(-),G(-))]
              constitute
              %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
              between pointed
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+functors"} topologically enriched functors
            #PointedTopologicalFunctorCategory.num_defn
              %h6#definition_3 Definition
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/enriched+presheaf+category"}> enriched presheaf category
                  )
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
                a
                %a.existingWikiWord{:href => "/nlab/show/cosmos"} cosmos
                (Def.
                = succeed ")," do
                  %a.maruku-ref{:href => "#Cosmos"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                be a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
