                        %annotation{:encoding => "application/x-tex"}
                          \\array{
                          \&amp; {}^{\mathllap{f}}\nearrow &amp;&amp; \searrow^{\mathrlap{g}}
                          \\\
                          \&amp;&amp; \underset{ g \circ f }{\longrightarrow}
                          }
