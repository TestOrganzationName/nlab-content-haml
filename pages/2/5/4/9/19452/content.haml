                            %mphantom
                              %mi AA
                            %mi ℝ
                            %mi id
                            %mphantom
                              %mi AA
                        %mover
                          %mo ⟵
                          %mrow
                            %mi 𝕃
                            %mi id
                      %mi Ho
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Ho(\mathcal{C}_{loc})
                      \\underoverset
                      {\underset{\phantom{AA}\mathbb{R} id \phantom{AA}}{\hookrightarrow}}
                      {\overset{\mathbb{L}id}{\longleftarrow}}
                      {\bot}
                      Ho(\mathcal{C})
