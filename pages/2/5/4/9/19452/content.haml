                        %mi A
                        %mi s
                    %annotation{:encoding => "application/x-tex"} \underset{s \in S}{\coprod} A_s
                induced via its
                %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
                by the set of morphisms
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi i
                          %mi s
                      %annotation{:encoding => "application/x-tex"} i_s
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo ⊔
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msub
                        %mi A
                        %mi s
                      %mover
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi i
                            %mi s
                          %msub
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mi s
                              %mo ∈
                              %mi S
                      %munder
                        %mo ⊔
                        %mrow
                          %mi s
                          %mo ∈
                          %mi S
                      %msub
                        %mi B
                        %mi s
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      \\underset{s \in S}{\sqcup} A_s
                      \\overset{(i_s)_{s\in S}}{\longrightarrow}
                      \\underset{s \in S}{\sqcup} B_s
                      \\,.
              %p Now let
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %munder
                                %mo ⊔
                                %mrow
                                  %mi s
                                  %mo ∈
                                  %mi S
                              %msub
                                %mi A
                                %mi s
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi X
                          %mtr
                            %mtd
                              %msup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi i
                                      %mi s
                                    %msub
                                      %mo{:stretchy => "false"} )
                                      %mrow
                                        %mi s
                                        %mo ∈
                                        %mi S
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msubsup
                                %mo{:stretchy => "false"} ↓
                                %mpadded{:width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi K
                                %mpadded{:width => "0"}
                                  %mi f
                          %mtr
                            %mtd
