                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    (Def.
                    = succeed ")" do
                      %a.maruku-ref{:href => "#Categories"}
                %li
                  %p
                    a
                    %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                          %mo ⊂
                          %mi 𝒞
                        %annotation{:encoding => "application/x-tex"} W \subset \mathcal{C}
                    (i.e. sub-class of objects and morphisms that inherits the structure of a
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/category"} category
              %p
                such that the
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %ol
                %li
                  %p
                    include all the
                    %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
                    of
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                %li
                  %p
                    satisfy
                    = succeed ":" do
                      %em
                        %a.existingWikiWord{:href => "/nlab/show/two-out-of-three"} two-out-of-three
                  %p
                    If for
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi g
                          %annotation{:encoding => "application/x-tex"} g
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                        %annotation{:encoding => "application/x-tex"} f
                    any two
                    %a.existingWikiWord{:href => "/nlab/show/composition"} composable
                    %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                    in
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi 𝒞
                          %annotation{:encoding => "application/x-tex"} \mathcal{C}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
