            %p
              The following says that for computing the hom-sets in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+category+of+a+model+category"} homotopy category
            #HomsOutOfCofibrantIntoFibrantComputeHomotopyCategory.num_lemma
              %h6#lemma_7 Lemma
              %p
                %strong
                  (
                  %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
                  of
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+category"} homotopy category
                  via mapping
                  %a.existingWikiWord{:href => "/nlab/show/cofibrant+resolutions"} cofibrant resolutions
                  into
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/fibrant+resolutions"} fibrant resolutions
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ∈
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} X, Y \in \mathcal{C}
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                cofibrant and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                fibrant, and for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ,
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} P, Q
                fibrant/cofibrant replacement functors as in def.
                = succeed "," do
                  %a.maruku-ref{:href => "#FibrantCofibrantReplacementFunctorToHomotopyCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mrow
                          %mi Ho
                          %mo{:stretchy => "false"} (
                          %mi 𝒞
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi X
                      %mo ,
                      %mi Q
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi X
                      %mo ,
                      %mi Q
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi j
                            %mi X
                          %mo ,
                          %msub
                            %mi p
                            %mi Y
                          %mo{:stretchy => "false"} )
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{Ho(\mathcal{C})}(P X,Q Y)
                      \=
                      Hom_{\mathcal{C}}(P X, Q Y)/_{\sim}
                      \\overset{Hom_{\mathcal{C}}(j_X, p_Y)}{\longrightarrow}
                      Hom_{\mathcal{C}}(X,Y)/_{\sim}
              %p
                (on
                %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
                of morphisms, well defined by prop.
                = succeed ")" do
                  %a.maruku-ref{:href => "#BetweenCofibFibLeftAndRightHomotopyAreEquivalentEquivalenceRelations"}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            %p
              (
              %a{:href => "model+category#Quillen67"}> Quillen 67, I.1 lemma 7
              )
            .proof
              %h6#proof_12 Proof
              %p We may factor the morphism in question as the composite
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi X
                      %mo ,
                      %mi Q
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi id
                            %mrow
                              %mi P
                              %mi X
                          %mo ,
                          %msub
                            %mi p
                            %mi Y
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo{:stretchy => "false"} /
                            %mo ∼
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi P
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mover
                        %mo ⟶
                        %mrow
                          %msub
                            %mi Hom
                            %mi 𝒞
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi j
                            %mi X
                          %mo ,
                          %msub
                            %mi id
                            %mi Y
                          %mo{:stretchy => "false"} )
                          %msub
                            %mo{:stretchy => "false"} /
                            %mo ∼
                      %msub
                        %mi Hom
                        %mi 𝒞
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} /
                        %mo ∼
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      Hom_{\mathcal{C}}(P X, Q Y)/_{\sim}
                      \\overset{Hom_{\mathcal{C}}(id_{P X}, p_Y)/_\sim }{\longrightarrow}
                      Hom_{\mathcal{C}}(P X, Y)/_{\sim}
                      \\overset{Hom_{\mathcal{C}}(j_X, id_Y)/_\sim}{\longrightarrow}
                      Hom_{\mathcal{C}}(X,Y)/_{\sim}
                      \\,.
              %p
                This shows that it is sufficient to see that for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                cofibrant and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
                fibrant, then
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Hom
                        %mi 𝒞
