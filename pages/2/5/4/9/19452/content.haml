                                    %mi AA
                          %mtr
                            %mtd
                              %mover
                                %mo ⟶
                                %mrow
                                  %mphantom
                                    %mi AA
                                  %mi ℝ
                                  %munder
                                    %mi lim
                                    %mo ⟵
                                  %mphantom
                                    %mi AA
                      %mspace{:width => "thickmathspace"}
                      %mi Ho
                      %mo{:stretchy => "false"} (
