            #GeneratingCofibrationsForProjectiveStructureOnFunctors.num_defn
              %h6#definition_61 Definition
              %p
                For
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
                a
                %a.existingWikiWord{:href => "/nlab/show/small+category"} small
                topologically enriched category, def.
                = succeed "," do
                  %a.maruku-ref{:href => "#TopEnrichedCategory"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi I
                        %mi Top
                        %mi 𝒞
                      %mspace{:width => "thickmathspace"}
                      %mo ≔
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mrow
                          %mo {
                          %mi y
                          %mo{:stretchy => "false"} (
                          %mi c
