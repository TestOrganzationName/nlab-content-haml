              itself:
            #TopkAsATopologicallyEnrichedCategory.num_example
              %h6#example_42 Example
              %p
                The category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                    %annotation{:encoding => "application/x-tex"} Top_{cg}
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#kTop"}
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/topologically+enriched+category"} topologically enriched category
                = succeed "," do
                  %a.maruku-ref{:href => "#TopEnrichedCategory"}
                %a.existingWikiWord{:href => "/nlab/show/hom-spaces"} hom-spaces
                given by the compactly generated
                %a.existingWikiWord{:href => "/nlab/show/mapping+spaces"} mapping spaces
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#CompactlyGeneratedMappingSpaces"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Top
                        %mi cg
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msup
                        %mi Y
                        %mi X
                    %annotation{:encoding => "application/x-tex"}
                      Top_{cg}(X,Y)
                      \\coloneqq
                      Y^X
              %p
                and with
                %a.existingWikiWord{:href => "/nlab/show/composition"} composition
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Y
                        %mi X
                      %mo ×
                      %msup
                        %mi Z
                        %mi Y
                      %mo ⟶
                      %msup
                        %mi Z
                        %mi X
                    %annotation{:encoding => "application/x-tex"}
                      Y^X \times Z^Y
                      \\longrightarrow
                      Z^X
              %p
                given by the
                %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
                under the (product
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊣
                    %annotation{:encoding => "application/x-tex"} \dashv
                mapping-space)-
                %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
                from prop.
                %a.maruku-ref{:href => "#CartesianClosureOfTopcg"}
                of the
                %a.existingWikiWord{:href => "/nlab/show/evaluation+morphisms"} evaluation morphisms
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %msup
                        %mi Y
                        %mi X
                      %mo ×
                      %msup
                        %mi Z
                        %mi Y
                      %mover
                        %mo ⟶
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi ev
                          %mo ,
                          %mi id
                          %mo{:stretchy => "false"} )
                      %mi Y
                      %mo ×
                      %msup
                        %mi Z
                        %mi Y
                      %mover
                        %mo ⟶
                        %mi ev
                      %mi Z
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      X \times Y^X \times Z^Y
                      \\overset{(ev, id)}{\longrightarrow}
                      Y \times Z^Y
                      \\overset{ev}{\longrightarrow}
                      Z
                      \\,.
              %p
                Similarly,
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Top
                        %mi k
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                    %annotation{:encoding => "application/x-tex"} Top_k^{\ast/}
                form a pointed topologically enriched category, using the
                %a.existingWikiWord{:href => "/nlab/show/pointed+mapping+spaces"} pointed mapping spaces
                from example
                = succeed ":" do
                  %a.maruku-ref{:href => "#PointedMappingSpace"}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Top
                        %mi cg
                        %mrow
                          %mo *
                          %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mi Maps
                      %mo{:stretchy => "false"} (
