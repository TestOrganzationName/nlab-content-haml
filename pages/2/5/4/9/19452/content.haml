                      %mi p
                    %annotation{:encoding => "application/x-tex"} f^* p
                has the
                %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
                with respect to all
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi i
                        %mo ∈
                        %mi K
                      %annotation{:encoding => "application/x-tex"} i \in K
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi A
                            %mtd
                              %mo ⟶
                            %mtd
                              %mi Z
                              %msub
                                %mo ×
                                %mi f
                              %mi X
                          %mtr
                            %mtd
                              %msubsup
                                %mrow
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mrow
                                    %mo ∈
                                    %mi K
                                %mpadded{:lspace => "-100%width", :width => "0"}
                                  %mi i
                              %mo{:stretchy => "false"} ↓
                            %mtd
                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
