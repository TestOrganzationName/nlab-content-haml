          %h2#idea Idea
          %p
            The
            %strong simplicial bar construction
            is a way of building a cofibrant
            %a.existingWikiWord{:href => "/nlab/show/resolution"} resolution
            of a diagram, suitable for computing
            %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimits
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model categories
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            be a
            %a.existingWikiWord{:href => "/nlab/show/cocomplete+category"} cocomplete
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            %a.existingWikiWord{:href => "/nlab/show/monoidal+closed+category"} monoidal closed category
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            be a small
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} category
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W_\bullet (c', \mathbb{C}, c)
            for each pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c', c)
            of objects in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"} \mathbb{C}
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi c
                        %mn 0
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi c
                        %mi n
                      %mo{:stretchy => "false"} )
                  %mi ℂ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mi n
                  %mo ,
                  %mi c
                  %mo ′
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi ℂ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo ,
                  %msub
                    %mi c
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi ⋯
                  %mo ⊗
                  %mi ℂ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 0
                  %mo ,
                  %msub
                    %mi c
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %msub
                    %mi c
                    %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W_n (c', \mathbb{C}, c) = \coprod_{(c_0, \ldots, c_n)} \mathbb{C} (c_n, c') \otimes \mathbb{C} (c_{n-1}, c_n) \otimes \cdots \otimes \mathbb{C} (c_0, c_1) \otimes \mathbb{C} (c, c_0)
          %p
            with the obvious face and degeneracy operators induced by the composition and identities of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} blank
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} blank
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} W_\bullet (\blank, \mathbb{C}, \blank)
            is a
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℂ
                      %mi op
                    %mo ⊗
                    %mi ℂ
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mstyle{:mathvariant => "bold"}
                        %mi Δ
                      %mi op
                    %mo ,
                    %mi 𝒱
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}^{op} \otimes \mathbb{C} \to [\mathbf{\Delta}^{op}, \mathcal{V}]
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} \mathcal{M}
            be a
            %a.existingWikiWord{:href => "/nlab/show/copower"} tensored
            = succeed "-category." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %strong two-sided simplicial bar construction
            of a
            = succeed "-diagram" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi ℂ
                  %mo →
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} F : \mathbb{C} \to \mathcal{M}
            weighted by a
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo :
                  %msup
                    %mi ℂ
                    %mi op
                  %mo →
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} G : \mathbb{C}^{op} \to \mathcal{V}
            is a simplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi B
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B_\bullet (G, \mathbb{C}, F)
            equipped with isomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℳ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi B
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %msub
                    %mo ∫
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ′
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi ℂ
                        %mi op
                      %mo ⊗
                      %mi ℂ
                  %mi 𝒱
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi W
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi ℳ
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mi c
                  %mo ′
                  %mo ⊙
                  %mi F
                  %mi c
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{M} (B_n (G, \mathbb{C}, F), M) \cong \int_{(c', c) : \mathbb{C}^{op} \otimes \mathbb{C}} \mathcal{V} (W_n (c', \mathbb{C}, c), \mathcal{M}(G c' \odot F c, M))
          %p
            that are natural in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            and
            = succeed "-natural" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/end"} end
          %p
            Now suppose a
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mo •
                  %mo :
                  %mstyle{:mathvariant => "bold"}
                    %mi Δ
                  %mo →
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \Delta^\bullet : \mathbf{\Delta} \to \mathcal{V}
            is given, so that we may define the
            %span.newWikiWord
              realisation
              %a{:href => "/nlab/new/realisation"} ?
            of a simplicial object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mo •
                %annotation{:encoding => "application/x-tex"} X_\bullet
            in a
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %a.existingWikiWord{:href => "/nlab/show/weighted+colimit"} weighted colimit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %msub
                        %mi X
                        %mo •
                      %mo |
                    %mo =
                    %msup
                      %mi Δ
                      %mo •
                    %mo ⋆
                    %msub
                      %mi X
                      %mo •
                  %annotation{:encoding => "application/x-tex"} \left| X_\bullet \right| = \Delta^\bullet \star X_\bullet
            %strong two-sided bar construction
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi ℂ
                  %mo →
                  %mi ℳ
                %annotation{:encoding => "application/x-tex"} F : \mathbb{C} \to \mathcal{M}
            weighted by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo :
                  %msup
                    %mi ℂ
                    %mi op
                  %mo →
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} G : \mathbb{C}^{op} \to \mathcal{V}
            is then defined to be the geometric realisation of the two-sided simplicial bar construction:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo |
                    %msub
                      %mi B
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo |
                %annotation{:encoding => "application/x-tex"} B (G, \mathbb{C}, F) = \left| B_\bullet (G, \mathbb{C}, F) \right|
          %h2#properties Properties
          .num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              is a tensored
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              has two-sided simplicial bar constructions for all diagrams and weights. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              is moreover
              = succeed "-cocomplete," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              also has two-sided bar constructions.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              is a tensored
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %ul
              %li
                For each
                = succeed "-diagram" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo :
                        %mi ℂ
                        %mo →
                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} F : \mathbb{C} \to \mathcal{M}
                = succeed "-functor" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi ℂ
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi ℂ
                        %mi op
                      %mo ,
                      %mi 𝒱
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℳ
                    %annotation{:encoding => "application/x-tex"} B_n (-, \mathbb{C}, F) : [\mathbb{C}^{op}, \mathcal{V}] \to \mathcal{M}
                has a right
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              is also
              = succeed "," do
                %em cotensored
            %ul
              %li
                For each weight
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                        %mo :
                        %msup
                          %mi ℂ
                          %mi op
                        %mo →
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} G : \mathbb{C}^{op} \to \mathcal{V}
                = succeed "-functor" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo ,
                      %mi ℂ
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi ℂ
                      %mo ,
                      %mi ℳ
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℳ
                    %annotation{:encoding => "application/x-tex"} B_n (G, \mathbb{C}, -) : [\mathbb{C}, \mathcal{M}] \to \mathcal{M}
                has a right
                = succeed "-adjoint." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒱
                      %annotation{:encoding => "application/x-tex"} \mathcal{V}
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W (c', \mathbb{C}, c)
              be the realisation of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ′
                      %mo ,
                      %mi ℂ
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W_\bullet (c', \mathbb{C}, c)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              is a cotensored
              = succeed "-cocomplete" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              = succeed "-category," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %msub
                      %mo ∫
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ′
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo :
                        %msup
                          %mi ℂ
                          %mi op
                        %mo ⊗
                        %mi ℂ
                    %mi 𝒱
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ′
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℳ
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mi c
                    %mo ′
                    %mo ⊙
                    %mi F
                    %mi c
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{M} (B (G, \mathbb{C}, F), M) \cong \int_{(c', c) : \mathbb{C}^{op} \otimes \mathbb{C}} \mathcal{V} (W (c', \mathbb{C}, c), \mathcal{M} (G c' \odot F c, M))
            %p
              that are
              = succeed "-natural" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
          %p The next theorem is essentially a version of the Fubini theorem for coends.
          .num_prop
            %h6#theorem Theorem
            %p
              Let
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo :
                      %mi ℂ
                      %mo →
                      %mi ℳ
                    %annotation{:encoding => "application/x-tex"} F : \mathbb{C} \to \mathcal{M}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo :
                      %msup
                        %mi 𝔻
                        %mi op
                      %mo →
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} G : \mathbb{D}^{op} \to \mathcal{V}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo :
                    %msup
                      %mi ℂ
                      %mi op
                    %mo ×
                    %mi 𝔻
                    %mo →
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} H : \mathbb{C}^{op} \times \mathbb{D} \to \mathcal{V}
              be
              = succeed "-functors." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              is a
              %em cotensored
              = succeed "-cocomplete" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
              = succeed "-category," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒱
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi 𝔻
                    %mo ,
                    %mi H
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mi 𝔻
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B (B (G, \mathbb{D}, H), \mathbb{C}, F) \cong B (G, \mathbb{D}, B (H, \mathbb{C}, F))
          %h2#applications Applications
          %p As stated in the introduction, the two-sided simplicial bar construction can be used to compute homotopy colimits.
          %p
            Let us write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                  %mi c
                %annotation{:encoding => "application/x-tex"} y c
            for the representable
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{C}(-, c)
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi ℂ
                  %mo ,
                  %mi ℂ
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B (\mathbb{C}, \mathbb{C}, F)
            for the diagram
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ↦
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mi c
                    %mo ,
                    %mi ℂ
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \mapsto B (y c, \mathbb{C}, F)
          .num_prop
            %h6#theorem_2 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℳ
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}
              be a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              be a small category.
            %ol
              %li
                For each diagram
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo :
                        %mi ℂ
                        %mo →
                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} F : \mathbb{C} \to \mathcal{M}
                %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mi c
                      %mo ,
                      %mi ℂ
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi F
                      %mi c
                    %annotation{:encoding => "application/x-tex"} B (y c, \mathbb{C}, F) \to F c
                that is natural in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi c
                      %annotation{:encoding => "application/x-tex"} c
              %li
                The functor
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi colim
                      %mo :
                      %mo{:stretchy => "false"} [
                      %mi ℂ
                      %mo ,
                      %mi ℳ
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi ℳ
                    %annotation{:encoding => "application/x-tex"} colim : [\mathbb{C}, \mathcal{M}] \to \mathcal{M}
                preserves weak equivalences between diagrams of the form
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi ℂ
                      %mo ,
                      %mi ℂ
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B (\mathbb{C}, \mathbb{C}, F)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
                is a diagram such that each
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mi c
                    %annotation{:encoding => "application/x-tex"} F c
                is a cofibrant object in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} \mathcal{M}
              %li
                The functor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi ℂ
                        %mo ,
                        %mi Q
                        %mo −
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mo{:stretchy => "false"} [
                        %mi ℂ
                        %mo ,
                        %mi ℳ
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} B (1, \mathbb{C}, Q -) : [\mathbb{C}, \mathcal{M}] \to \mathcal{M}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo :
                      %mi ℳ
                      %mo →
                      %mi ℳ
                    %annotation{:encoding => "application/x-tex"} Q : \mathcal{M} \to \mathcal{M}
                is a cofibrant replacement functor, is a left
                %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi colim
                        %mo :
                        %mo{:stretchy => "false"} [
                        %mi ℂ
                        %mo ,
                        %mi ℳ
                        %mo{:stretchy => "false"} ]
                        %mo →
                        %mi ℳ
                      %annotation{:encoding => "application/x-tex"} colim : [\mathbb{C}, \mathcal{M}] \to \mathcal{M}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimits
