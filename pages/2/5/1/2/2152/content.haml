            %p
              This entry is about
              %a.existingWikiWord{:href => "/nlab/show/geometry"} geometry
              based on the study of
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/analytic+functions"} analytic functions
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/analytic+varieties"} analytic varieties
            %p
              This is unrelated to “analytic geometry” in the sense of methods in the geometry of
              = succeed "-dimensional" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              involving
              %em
