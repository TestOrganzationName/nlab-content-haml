              = succeed ");" do
                %a.existingWikiWord{:href => "/nlab/show/synthetic+geometry"} synthetic geometry
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/coordinate+system"} coordinate system
