            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/CRing"} CRing
            –
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msubsup
                    %mo{:stretchy => "false"} ]
                    %mrow
