            %a.existingWikiWord{:href => "/nlab/show/closed+subscheme"} closed subscheme
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo ⊂
                  %mi X
