            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ⟨
                    %mover
                      %mi x
                      %mo{:stretchy => "false"} →
                    %msub
                      %mo{:stretchy => "false"} ⟩
                      %mi k
                    %mo ⊂
                    %msup
                      %mi k
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \langle \vec x\rangle_k \subset k^{n+1}
              is the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                    %annotation{:encoding => "application/x-tex"} \vec x
            %p
              (The space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is the space of
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              consisting of the “name” of a
              = succeed "-line" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k^{n+1}
              together with an element of that
              = succeed "-line)." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p
              This is a bundle over
              %a.existingWikiWord{:href => "/nlab/show/projective+space"} projective space
              via the projection function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi T
                          %mtd
                            %mover
                              %mo ⟶
                              %mi π
                          %mtd
                            %mi k
                            %msup
                              %mi P
                              %mi n
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi x
                              %mn 1
                            %mo :
                            %mi ⋯
                            %mo :
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} →
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi x
                              %mn 1
                            %mo :
                            %mi ⋯
                            %mo :
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    T &amp;\overset{\pi}{\longrightarrow}&amp; k P^n
                    \\\
                    ([x_1: \cdots : x_{n+1}], \vec v) &amp;\mapsto&amp; [x_1: \cdots : x_{n+1}]
                    }
                    \\,.
          #WellDefinedTautologicalTopologicalLineBundle.num_prop
            %h6#proposition Proposition
            %p
              %strong (tautological topological line bundle is well defined)
            %p
              The tautological line bundle in def.
              %a.maruku-ref{:href => "#TautologicalTopologicalLineBundle"}
              is well defined in that it indeed admits a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
          .proof
            %h6#proof Proof
            %p
              We claim that there is a local trivialization over the canonical
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#TopologicalProjectiveSpaceStandardOpenCover"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} i \in \{1, \cdots, n\}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi U
                              %mi i
                            %mo ×
                            %mi k
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %mi T
                            %msub
                              %mo{:stretchy => "false"} |
                              %mrow
                                %msub
                                  %mi U
                                  %mi i
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi x
                              %mn 1
                            %mo :
                            %mi ⋯
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo :
                            %mn 1
                            %mo :
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo :
                            %mi ⋯
                            %mo :
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi x
                              %mn 1
                            %mo :
                            %mi ⋯
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo :
                            %mn 1
                            %mo :
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo :
                            %mi ⋯
                            %mo :
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi c
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %mi c
                            %msub
                              %mi x
                              %mn 2
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi c
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U_i \times k &amp;\overset{}{\longrightarrow}&amp; T\vert_{U_i}
                    \\\
                    ( [x_1 : \cdots x_{i-1}: 1 : x_{i+1} : \cdots : x_{n+1}] , c )
                    \&amp;\mapsto&amp;
                    ( [x_1 : \cdots x_{i-1} : 1 : x_{i+1} : \cdots : x_{n+1} ], (c x_1, c x_2, \cdots , c x_{n+1}) )
                    }
                    \\,.
            %p
              First, this is clearly a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              of
              %a.existingWikiWord{:href => "/nlab/show/underlying"} underlying
              sets.
            %p
              To see that this function and its inverse function are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              notice that this map is the
              %a.existingWikiWord{:href => "/nlab/show/extension"} extension
              to the
              %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient topological space
              of the analogous map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo ,
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mo{:stretchy => "false"} (
                            %mi c
                            %msub
                              %mi x
                              %mn 1
                            %mo ,
                            %mi ⋯
                            %mi c
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo −
                                %mn 1
                            %mo ,
                            %mi c
                            %mo ,
                            %mi c
                            %msub
                              %mi x
                              %mrow
                                %mi i
                                %mo +
                                %mn 1
                            %mo ,
                            %mi ⋯
                            %mo ,
                            %mi c
                            %msub
                              %mi x
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    ( (x_1, \cdots, x_{i-1}, x_{i+1}, \cdots, x_{n+1}) , c)
                    \&amp;\mapsto&amp;
                    ( (x_1, \cdots, x_{i-1}, x_{i+1}, \cdots, x_{n+1}) , (c x_1, \cdots c x_{i-1}, c, c x_{i+1}, \cdots, c x_{n+1}) )
                    }
                    \\,.
            %p
              This is a
              %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
              function on
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
              and since
              %a.existingWikiWord{:href => "/nlab/show/polynomials+are+continuous"} polynomials are continuous
              it is continuous. Similarly, the
              %a.existingWikiWord{:href => "/nlab/show/inverse+function"} inverse function
              lifts to a
              %a.existingWikiWord{:href => "/nlab/show/rational+function"} rational function
              on a subspace of Euclidean space, and since
              %a.existingWikiWord{:href => "/nlab/show/rational+functions+are+continuous"} rational functions are continuous
              on their domain of definition, also this lift is continuous.
            %p
              Therefore by the
              %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quotient+topology"} quotient topology
          %h2#examples Examples
          %h3#mbius_strip Möbius strip
          %p
            The tautological line bundle over the 1-dimensional
            %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %msup
                    %mi P
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{R}P^1
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/M%C3%B6bius+strip"} Möbius strip
          %h3#over_riemann_sphere Over Riemann sphere
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/basic+complex+line+bundle+on+the+2-sphere"} basic complex line bundle on the 2-sphere
            is the tautological
            %a.existingWikiWord{:href => "/nlab/show/complex+line+bundle"} complex line bundle
            over the
            %a.existingWikiWord{:href => "/nlab/show/complex+projective+space"} complex projective space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℂ
                  %msup
                    %mi P
                    %mn 1
                  %mo ≃
                  %msup
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{C}P^1 \simeq S^2
            (the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
          %p
            This plays a key role in
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            and more generally in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/canonical+line+bundle"}> canonical line bundle
                ,
                %a.existingWikiWord{:href => "/nlab/show/universal+complex+line+bundle"} universal complex line bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/hyperplane+line+bundle"} hyperplane line bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tautological+equivariant+line+bundle"} tautological equivariant line bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/resolution+of+singularities"} resolution of singularities
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bott+element"} Bott element
          %h2#references References
          %p
            Discussion with an eye towards
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex-oriented+cohomology+theory"} complex-oriented cohomology theory
          %ul
            %li#ConnerFloyd66
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Conner"}> Pierre Conner
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edwin+Floyd"} Edwin Floyd
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/The+Relation+of+Cobordism+to+K-Theories"} The Relation of Cobordism to K-Theories
                %strong 28
                Springer 1966 (
                %a{:href => "https://link.springer.com/book/10.1007/BFb0071091"}> doi:10.1007/BFb0071091
                ,
                = succeed ")" do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=216511"} MR216511
            %li#TamakiKono06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dai+Tamaki"}> Dai Tamaki
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Akira+Kono"} Akira Kono
                = succeed "," do
                  %em Generalized Cohomology
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/files/GeneralizedCohomology.pdf", :title => "pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://bookstore.ams.org/mmono-230"} ISBN: 978-0-8218-3514-2
          %p
            Lecture notes with an eye towards
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %ul
            %li#Wirthmuller12
              %a.existingWikiWord{:href => "/nlab/show/Klaus+Wirthm%C3%BCller"}> Klaus Wirthmüller
              , section 2 of
              = succeed "," do
                %em Vector bundles and K-theory
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/wirthmueller-vector-bundles-and-k-theory.pdf", :title => "pdf"} pdf
          %p See also:
          %ul
            %li
