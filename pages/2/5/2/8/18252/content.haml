                              %msup
                                %mi k
                                %mo ×
                        %mtd
                          %mo =
                          %mspace{:width => "thinmathspace"}
                          %mi k
                          %msup
                            %mi P
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %msup
                            %mrow
                            %mpadded{:width => "0"}
                              %mfrac
                                %mrow
                                  %mi id
