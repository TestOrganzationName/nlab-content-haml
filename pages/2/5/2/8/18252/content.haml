                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mtd
                              %mo ↦
                            %mtd
                              %mo{:stretchy => "false"} (
                              %msub
                                %mi v
                                %mn 1
                              %mspace{:width => "negativethinmathspace"}
                              %mo ⋅
                              %mspace{:width => "negativethinmathspace"}
                              %mi z
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %mi ⋯
                              %mo ,
                              %mspace{:width => "thinmathspace"}
                              %msub
                                %mi v
                                %mrow
                                  %mi n
                                  %mo +
                                  %mn 1
                              %mspace{:width => "negativethinmathspace"}
                              %mo ⋅
                              %mspace{:width => "negativethinmathspace"}
                              %mi z
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      k^{n+1} \times k^\times
                      \&amp;
                      \\overset{ \;\;\;\; }{\longrightarrow}
                      \&amp;
                      k^{n+1}
                      \\\
                      \\big(
                      (v_1, \, \cdots, \, v_{n+1}),
                      \\,
                      z
                      \\big)
                      \&amp;\mapsto&amp;
                      (v_1 \!\cdot\! z,\, \cdots, \, v_{n+1} \!\cdot\! z)
                      \\,,
                      }
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mo *
                    %annotation{:encoding => "application/x-tex"} k^\ast
                is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                equipped with the right
                = succeed "-action" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mo ×
                      %annotation{:encoding => "application/x-tex"} k^\times
                = succeed ":" do
                  %em inverse multiplication from the left
              #eq:DualActionOnk.maruku-equation
                %span.maruku-eq-number (4)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %msup
                                %mi k
                                %mo ×
                              %mo ×
                              %msup
                                %mi k
                                %mo *
                            %mtd
                              %mo ⟶
                            %mtd
                              %msup
                                %mi k
                                %mo *
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi z
                              %mo ,
                              %mi g
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo ↦
                            %mtd
                              %msup
                                %mi z
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo ⋅
                              %mi g
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      k^\times \times k^\ast
                      \&amp;\longrightarrow&amp;
                      k^\ast
                      \\\
                      (z,g) &amp;\mapsto&amp; z^{-1} \cdot g
                      }
              %p
                (equivalently,
                %a.maruku-eqref{:href => "#eq:RightDirectMultiplicationAction"} (3)
                and
                %a.maruku-eqref{:href => "#eq:DualActionOnk"} (4)
                are left actions of the
                %a.existingWikiWord{:href => "/nlab/show/opposite+group"} opposite group
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi k
                          %mo ×
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                      %annotation{:encoding => "application/x-tex"} (k^\times)^{op}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mfrac
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                        %mrow
                          %msup
                            %mi k
                            %mo ×
                    %annotation{:encoding => "application/x-tex"} \frac{(-) \times (-)}{k^\times}
                denotes the
                %a.existingWikiWord{:href => "/nlab/show/quotient+space"} quotient space
                of a
                %a.existingWikiWord{:href => "/nlab/show/product+space"} product
                of right
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mo ×
                      %annotation{:encoding => "application/x-tex"} k^\times
                %a.existingWikiWord{:href => "/nlab/show/G-space"} spaces
                by their
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/diagonal+action"} diagonal action
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [-]
                denotes its elements as
                %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
                of elements of the original space;
            %li
              %p
                so that, for
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi z
                        %mspace{:width => "thinmathspace"}
                        %mo ∈
                        %mspace{:width => "thinmathspace"}
                        %msup
                          %mi k
                          %mo ×
                      %annotation{:encoding => "application/x-tex"} z \,\in\, k^\times
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi v
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %mi v
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mi z
                      %mspace{:width => "negativethinmathspace"}
                      %mo ⋅
                      %mspace{:width => "negativethinmathspace"}
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo =
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} [
                      %mi v
                      %mspace{:width => "negativethinmathspace"}
                      %mo ⋅
                      %mspace{:width => "negativethinmathspace"}
                      %mi z
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mn 1
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ∈
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mfrac
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo ∖
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo ×
                          %msup
                            %mi k
                            %mo *
                        %mrow
                          %msup
                            %mi k
                            %mo ×
                    %annotation{:encoding => "application/x-tex"}
                      [v,\,z]
                      \\;=\;
                      [v,\, z \!\cdot\! 1]
                      \\;=\;
                      [v \!\cdot\! z ,\, 1]
                      \\;\;\in\;\;
                      \\frac{
                      (V \setminus \{0\}) \times k^\ast
                      }{
                      k^\times
                      }
            %li
              %p
                and hence so that the quotient construction in
                %a.maruku-eqref{:href => "#eq:TautologicalBundleProjection"} (1)
                is equivalently the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber
                %em
                  %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated bundle
                to the
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mo ×
                      %annotation{:encoding => "application/x-tex"} k^\times
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                (here “
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                ” is for
                = succeed "):" do
                  %a.existingWikiWord{:href => "/nlab/show/torsor"} torsor
          #eq:TautologicalPrincipalBundleOverProjectiveSpace.maruku-equation
            %span.maruku-eq-number (5)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi T
                            %mrow
                              %mi k
                              %msup
                                %mi P
                                %mi n
                        %mtd
                          %mo ≔
                        %mtd
                          %msup
                            %mi k
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo ∖
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo{:stretchy => "false"} }
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %msup
                            %mrow
                            %mpadded{:width => "0"}
                              %mrow
                                %mi quotient
                                %mspace{:width => "thickmathspace"}
                                %mi map
                      %mtr
                        %mtd
                          %mi k
                          %msup
                            %mi P
                            %mi n
                        %mtd
                          %mo =
                        %mtd
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi k
                            %mrow
                              %mi n
                              %mo +
                              %mn 1
                          %mo ∖
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo{:stretchy => "false"} }
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} /
                          %msup
                            %mi k
                            %mo ×
                          %mspace{:width => "thinmathspace"}
                          %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  T_{k P^n}
                  \&amp; \coloneqq &amp;
                  k^{n+1} \setminus \{0\}
                  \\\
                  \\big\downarrow
                  \&amp;&amp;
                  \\big\downarrow {}^{\mathrlap{
                  quotient\;map
                  }}
                  \\\
                  k P^n
                  \&amp;=&amp;
                  (k^{n+1} \setminus \{0\}) / k^\times
                  \\,.
                  }
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/star+algebra"} star algebra
            %a.maruku-eqref{:href => "#eq:TautologicalBundleProjection"} (1)
            becomes a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕂
                  %annotation{:encoding => "application/x-tex"} \mathbb{K}
            %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
            (specifically:
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕂
                %annotation{:encoding => "application/x-tex"} \mathbb{K}
            on itself by
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/quaternionic+conjugation"} conjugate
                right multiplication
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
            %a.maruku-eqref{:href => "#eq:TautologicalBundleProjection"} (1)
            is “tautological” in the sense that its
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            over a point labeled
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi v
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [v]
            – which may be regarded as the
            %em name
            of the line
            %a.existingWikiWord{:href => "/nlab/show/linear+span"} spanned
            by the vector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo ∈
                  %msup
                    %mi k
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} v \in k^{n+1}
            – consists of all the points
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mspace{:width => "negativethinmathspace"}
                  %mo ⋅
                  %mspace{:width => "negativethinmathspace"}
                  %mi z
                %annotation{:encoding => "application/x-tex"} v \!\cdot\! z
            %em on that line
            – as made explicit by the horizontal map in
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:TautologicalBundleProjection"} (1)
          %p
            Often the tautological line bundle is referred to via the notation “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %msub
                    %mi 𝒪
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{O}_k(-1)
            ”, which in
            %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
            is standard notation for its
            %a.existingWikiWord{:href => "/nlab/show/abelian+sheaf"} abelian sheaf
            of
            %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            (see e.g.
            = succeed "):" do
              %a{:href => "#Wirthmuller12"} Wirthmüller 12, p. 14 (16 of 67)
          %ul
            %li
              “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mrow
                        %mi k
                        %msup
                          %mi P
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_{k P^n}
              ”
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ↔
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                  %annotation{:encoding => "application/x-tex"} \;\;\;\leftrightarrow\;\;\;
              “
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_k(-1)
              ”
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/corestriction"} corestriction
            of the horizontal map in
            %a.maruku-eqref{:href => "#eq:TautologicalBundleProjection"} (1)
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi k
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} k^{n+1}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℒ
                    %mrow
                      %mi k
                      %msup
                        %mi P
                        %mi n
                  %mo ≔
                  %mfrac
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi k
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mo ∖
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msup
                        %mi k
                        %mo *
                    %mrow
                      %msup
                        %mi k
                        %mo ×
                  %mover
                    %mo ⟶
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi v
                      %mo ,
                      %mi z
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %mi v
                      %mo ⋅
                      %mi z
                  %msup
                    %mi k
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{L}_{k P^n}
                  \\coloneqq
                  \\frac{
                  (k^{n+1} \setminus \{0\}) \times k^\ast
                  }{
                  k^\times
                  }
                  \\overset{
                  [v,z]
                  \\mapsto
                  v \cdot z
                  }{\longrightarrow}
                  k^{n+1}
          %p
            exhibits the total space of the tautological bundle as the “
            %a.existingWikiWord{:href => "/nlab/show/blow-up"}> blow-up
            ” of the origin of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} k^{n+1}
          %p#Illustration
            The following illustration shows the tautological
            %a.existingWikiWord{:href => "/nlab/show/real+line+bundle"} real line bundle
            over 1-dimensional
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+projective+space"} real projective space
          %p
            %img{:src => "/nlab/files/TautologicalLineBundleOverRP1.jpg", :width => "700px"}/
          %h3#DualTautologicalLineBundle Dual tautological line bundle and its Thom space
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual line bundle
            of the tautological line bundle
            %a.maruku-eqref{:href => "#eq:TautologicalBundleProjection"} (1)
            is
          #eq:DualTautologicalBundleProjection.maruku-equation
            %span.maruku-eq-number (6)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi ℒ
                            %mrow
                              %mi k
                              %msup
                                %mi P
                                %mi n
                            %mo *
