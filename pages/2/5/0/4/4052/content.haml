                %li
                  %a{:href => "#internal_categories_in_a_topos"}
                    Internal categories in a
                    = succeed "-topos" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
