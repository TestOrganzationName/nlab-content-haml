          .proof
            %h6#proof Proof
            %p
              By the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/2-Giraud+theorem"} 2-Giraud theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
