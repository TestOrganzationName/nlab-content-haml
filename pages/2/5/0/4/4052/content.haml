                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (2,1)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-topos"} (2,1)-topos
          %h3#InTermsOfInternalCategories In terms of internal categories
          %p
            Given a 2-topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
