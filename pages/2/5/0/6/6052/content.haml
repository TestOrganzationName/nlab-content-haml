                  %annotation{:encoding => "application/x-tex"} {}_R \mathcal{M}_R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mrow
                    %mi R
                  %msub
                    %mi ℳ
                    %mi R
