                              %mrow
                                %msub
                                  %mi θ
                                  %mrow
                                    %msup
                                      %mstyle{:mathvariant => "bold"}
                                        %mi B
                                      %mi p
                                    %mi U
                                    %mo{:stretchy => "false"} (
                                    %mn 1
                                    %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi G
                        %mtd
                          %mover
                            %mo ⟶
                            %mi ω
                        %mtd
                          %msubsup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mi cl
                            %mrow
                              %mi p
                              %mo +
                              %mn 2
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                        %mtd
                          %msub
                            %mo ♭
                            %mi dR
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mrow
                              %mi p
                              %mo +
                              %mn 2
                          %mi ℝ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{B}^{p+1}U(1)_{conn} &amp;\longrightarrow&amp; \mathbf{B}^{p+1}U(1)
                  \\\
                  \&amp;{}^\mathllap{\nabla}\nearrow&amp; \downarrow &amp;\swArrow_\simeq&amp; \downarrow^{\mathrlap{\theta_{\mathbf{B}^p U(1)}}}
                  \\\
                  G &amp;\stackrel{\omega}{\longrightarrow}&amp; \mathbf{\Omega}_{cl}^{p+2} &amp;\stackrel{}{\longrightarrow}&amp; \flat_{dR}\mathbf{B}^{p+2}\mathbb{R}
                  }
                  \\,.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                  %mo =
                  %mo{:stretchy => "false"} ⟨
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ⟩
                %annotation{:encoding => "application/x-tex"} \omega = \langle -,[-,-]\rangle
            as above, we have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} p= 1
            and so
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            here is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 2-bundle with connection
            %a.existingWikiWord{:href => "/nlab/show/bundle+gerbe"} bundle gerbe
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle+gerbe"} with connection
            %em WZW gerbe
            or similar.
          %p
            This terminology arises as follows. In (
            %a{:href => "Wess-Zumino-Witten+model#WessZumino71"}> Wess-Zumino 84
            ) the
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            for a
            %a.existingWikiWord{:href => "/nlab/show/string"} string
            propagating on the
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            was considered, with only the standard
            %a.existingWikiWord{:href => "/nlab/show/kinetic+action"} kinetic action
            term. Then in (
            %a{:href => "Wess-Zumino-Witten+model#Witten84"}> Witten 84
            ) it was observed that for this
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            to give a
            %a.existingWikiWord{:href => "/nlab/show/conformal+field+theory"} conformal field theory
            after
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+theory"} higher gauge
            %a.existingWikiWord{:href => "/nlab/show/interaction+term"} interaction term
            has to the added. The resulting
            %a.existingWikiWord{:href => "/nlab/show/sigma-model"} sigma-model
            came to be known as the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Wess-Zumino-Witten+model"} Wess-Zumino-Witten model
            or
            %em WZW model
            for short, and the term that Witten added became the
            = succeed "." do
              %em WZW term
            %a.existingWikiWord{:href => "/nlab/show/string+theory"} string theory
            it describes the propagation of the
            %a.existingWikiWord{:href => "/nlab/show/string"} string
            on the group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            subject to a
            %a.existingWikiWord{:href => "/nlab/show/force"} force
            of
            %a.existingWikiWord{:href => "/nlab/show/gravity"} gravity
            given by the
            %a.existingWikiWord{:href => "/nlab/show/Killing+form"} Killing form
            %a.existingWikiWord{:href => "/nlab/show/Riemannian+metric"} Riemannian metric
            and subject to a
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher gauge force
            whose
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed ")" do
              %a{:href => "Wess-Zumino-Witten+model#Gawedzki87"} Gawedzki 87
            %a.existingWikiWord{:href => "/nlab/show/surface+holonomy"} surface holonomy
            functional of a
            %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle+gerbe"} connection on a bundle gerbe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            that we just motivated above.
          %p
            Later, such WZW terms, or at least their curvature forms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} \omega
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+sigma-models+for+super+p-branes"} Green-Schwarz sigma-models for super p-branes
            each have an
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            that is the sum of the standard
            %a.existingWikiWord{:href => "/nlab/show/kinetic+action"} kinetic action
            plus a WZW term of degree
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} p+2
          %p
            In general WZW terms are “
            %a.existingWikiWord{:href => "/nlab/show/gauged+WZW+model"}> gauged
            ” which means, as we will see, that they are not defined on the given
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-group"} smooth infinity-group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            itself, but on a bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde G
            of
            %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential
            %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
            over that group, such that a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo →
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \Sigma \to \tilde G
            is a pair consisting of a map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \Sigma \to G
            and of a
            %a.existingWikiWord{:href => "/nlab/show/higher+gauge+field"} higher gauge field
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            (a “tensor multiplet” of fields).
          %p Here we discuss the general construction and theory of such higher WZW terms.
          %h3#model_layer Model layer
          %p
            We discuss how every
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi 𝔤
                  %mo →
                  %msup
                    %mi b
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mu \colon \mathfrak{g} \to b^{p+1} \mathbb{R}
            in
            %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} L-∞ algebra cohomology
            has a
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            to a higher WZW term of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mi μ
                  %mo{:lspace => "verythinmathspace"} :
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ˜
                  %mo ⟶
                  %msup
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mrow
                      %mi p
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} /
                  %mi Γ
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                %annotation{:encoding => "application/x-tex"}
                  \\mathbf{L}_\mu \colon \tilde G \longrightarrow \mathbf{B}^{p+1}(\mathbb{R}/\Gamma)_{conn}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi G
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde G
            is a differential extension of the smooth
            = succeed "-group" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p+1
            %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                  %mo ↪
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \Gamma \hookrightarrow \mathbb{R}
            is the group of
            %a.existingWikiWord{:href => "/nlab/show/periods"} periods
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            on that group.
          %p
            This construction is a differential refinement of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
          %h4#lie_integration Lie integration
          %p
            So let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
