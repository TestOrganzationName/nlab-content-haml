            %a.existingWikiWord{:href => "/nlab/show/principal+infinity-bundle"} principal infinity-bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
