              of those
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              which are
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integrations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %mo ∂
                        %msubsup
                          %mi Δ
                          %mi smth
                          %mrow
                            %mi p
                            %mo +
                            %mn 3
                    %msup
                      %mi μ
                      %mo *
                    %mi A
                    %mo ∈
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{\partial \Delta^{p+3}_{smth}} \mu^\ast A \in \mathbb{R}
            %p
              of the value of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              = succeed "," do
                %a.maruku-ref{:href => "#LInfinityCocyclesAsMorphisms"}
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+valued+differential+forms"} L-∞ algebra valued differential forms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo ∂
                    %msubsup
                      %mi Δ
                      %mi smth
                      %mrow
                        %mi p
