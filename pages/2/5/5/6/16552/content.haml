            %a.existingWikiWord{:href => "/nlab/show/spin+group"} Spin
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo =
                  %mn 1
