          #TruncatedLieIntegrationOfCocycle.num_prop
            %h6#proposition Proposition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycle"} L-∞ cocycle
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝔤
                      %mo →
                      %msup
                        %mi b
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mu \colon \mathfrak{g} \to b^{p+1}\mathbb{R}
              = succeed "," do
                %a.maruku-ref{:href => "#LInfinityCocyclesAsMorphisms"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi μ
                    %annotation{:encoding => "application/x-tex"} \mu
              %a.maruku-ref{:href => "#SimplicialLieIntegrationOfLinfinityAlgebra"}
              and remark
              = succeed "," do
                %a.maruku-ref{:href => "#LieIntegrationIsFunctorial"}
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+2)
              %a.existingWikiWord{:href => "/nlab/show/coskeleton"} coskeleton
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mo •
                    %mo ≔
                    %msub
                      %mi cosk
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{B}G_\bullet \coloneqq cosk_{p+2}\exp(\mathfrak{g})
            %p
              up to quotienting the coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}
              by the group of
              %a.existingWikiWord{:href => "/nlab/show/periods"} periods
