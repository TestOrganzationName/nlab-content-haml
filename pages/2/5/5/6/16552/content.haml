                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \int \Omega \mathbf{c} \in H^{p+2}(X,\mathbb{Z})
            is an
            %a.existingWikiWord{:href => "/nlab/show/integral+cohomology"} integral cohomology
            lift of the
            %a.existingWikiWord{:href => "/nlab/show/real+cohomology"} real cohomology
            class encoded by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
