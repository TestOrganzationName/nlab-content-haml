          #ExamplesOfLieIntegration.num_example
            %h6#example Example
            %p
              From the discussion at
              = succeed ":" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Lie+integration"} Lie integration
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msubsup
                          %mi Ω
                          %mi flat
                          %mn 1
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %msup
                          %mi b
                          %mrow
                            %mi p
                            %mo +
                            %mn 1
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msubsup
                          %mstyle{:mathvariant => "bold"}
                            %mi Ω
                          %mi cl
                          %mrow
                            %mi p
                            %mo +
                            %mn 2
                      %annotation{:encoding => "application/x-tex"} \Omega^1_{flat}(-,b^{p+1}\mathbb{R}) = \mathbf{\Omega}^{p+2}_{cl}
                  ;
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  an ordinary
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+skeleton"} 2-coskeleton
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi cosk
                          %mn 2
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mo •
                      %annotation{:encoding => "application/x-tex"}
                        cosk_2 \exp(\mathfrak{g}) \simeq \mathbf{B}G_\bullet
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  the simply connected
                  %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                  associated to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  by traditional
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theory
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  is furthermore a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+algebra"} semisimple Lie algebra
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi cosk
                          %mn 3
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mo •
                      %annotation{:encoding => "application/x-tex"}
                        cosk_3 \exp(\mathfrak{g}) \simeq \mathbf{B}G_\bullet
              %li
                %p
                  for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                        %mo =
                        %msup
                          %mi b
                          %mi p
                        %mi ℝ
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g} = b^{p}\mathbb{R}
                  the
                  = succeed "-algebra," do
                    %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie p+1
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi exp
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi b
                          %mi p
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mstyle{:mathvariant => "bold"}
                            %mi B
