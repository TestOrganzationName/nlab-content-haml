                %p
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mo ♭
