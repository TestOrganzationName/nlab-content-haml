                  \\\
                  \&amp;&amp; G &amp;\stackrel{\Omega\mathbf{c}}{\longrightarrow}&amp; \mathbf{B}^{p+1}U(1)
                  }
          %p
            whose higher
            %a.existingWikiWord{:href => "/nlab/show/Dixmier-Douady+class"} Dixmier-Douady class
            class
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
