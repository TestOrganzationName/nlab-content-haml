                                  %mi p
                                  %mn 1
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi ℝ
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi Γ
                              %mn 1
                            %msub
                              %mo{:stretchy => "false"} )
                              %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\widetilde {\hat G}
                    \&amp;\stackrel{}{\longrightarrow}&amp;
                    \\mathbf{\Omega}^{p_1+1}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    \\tilde G
                    \&amp;\stackrel{\mathbf{L}_1}{\longrightarrow}&amp;
                    \\mathbf{B}^{p_1+1}(\mathbb{R}/\Gamma_1)_{conn}
                    }
                    \\,.
          .proof
            %h6#proof_3 Proof
            %p
              Consider the following
              %a.existingWikiWord{:href => "/nlab/show/pasting"} pasting
              composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                                %mo +
                                %mn 1
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟵
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mstyle{:mathvariant => "bold"}
                                  %mi d
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ⇙
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                                %mo +
                                %mn 2
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mo ♭
                              %mi dR
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                                %mo +
                                %mn 2
                            %mi ℝ
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %msub
                                  %mi θ
                                  %mrow
                                    %msup
                                      %mstyle{:mathvariant => "bold"}
                                        %mi B
                                      %mrow
                                        %msub
                                          %mi p
                                          %mn 1
                                    %mo{:stretchy => "false"} (
                                    %mi ℝ
                                    %mo{:stretchy => "false"} /
                                    %msub
                                      %mi Γ
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mstyle{:mathvariant => "bold"}
                                %mi B
                              %mrow
                                %msub
                                  %mi p
                                  %mn 1
                                %mo +
                                %mn 1
                            %mi ℝ
                        %mtr
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi μ
                                    %mn 1
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mo ♭
                                    %mi dR
                                  %mstyle{:mathvariant => "bold"}
                                    %mi B
                                  %mi G
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↑
                              %mpadded{:width => "0"}
                                %mrow
                                  %mi Ω
                                  %msub
                                    %mstyle{:mathvariant => "bold"}
                                      %mi c
                                    %mn 1
                        %mtr
                          %mtd
                            %msubsup
                              %mstyle{:mathvariant => "bold"}
                                %mi Ω
                              %mi flat
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                          %mtd
                            %msub
                              %mo ♭
                              %mi dR
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                          %mtd
                            %mover
                              %mo ⟵
                              %mrow
                                %msub
                                  %mi θ
                                  %mi G
                          %mtd
                            %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbf{\Omega}^{p_1+1}
                    \&amp;\longrightarrow&amp;
                    \\ast
                    \&amp;\longleftarrow&amp;
                    \\ast
                    \\\
                    {}^{\mathllap{\mathbf{d}}}\downarrow &amp;\swArrow&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    \\mathbf{\Omega}^{p_1+2}
                    \&amp;\longrightarrow&amp;
                    \\flat_{dR}\mathbf{B}^{p_1+2}\mathbb{R}
                    \&amp;\stackrel{\theta_{\mathbf{B}^{p_1}(\mathbb{R}/\Gamma_1)}}{\longleftarrow}&amp;
                    \\mathbf{B}^{p_1+1}\mathbb{R}
                    \\\
                    \\uparrow^{\mathrlap{\mu_1}} &amp;&amp; \uparrow^{\mathrlap{\flat_{dR} \mathbf{B}G}} &amp;&amp; \uparrow^{\mathrlap{\Omega \mathbf{c}_1}}
                    \\\
                    \\mathbf{\Omega}^1_{flat}(-,\mathfrak{g})
                    \&amp;\stackrel{}{\longrightarrow}&amp;
