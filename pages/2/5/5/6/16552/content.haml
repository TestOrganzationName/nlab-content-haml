                on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Δ
                        %mi smth
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \Delta_{smth}^k
                which have
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/sitting+instants"} sitting instants
                %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
                of the
                %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
                they are constant perpendicular to any face on their value at that face;
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mi si
