          %p
            This happens to be the case notably for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
            %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact
            %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+group"} semisimple Lie group
            such as
            %a.existingWikiWord{:href => "/nlab/show/special+unitary+group"} SU
            or
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} Spin
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
