            is the
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
