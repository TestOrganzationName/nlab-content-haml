                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                        %mtd
                          %mo ⟶
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo ∇
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ⇙
                            %mo ≃
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
