                    %annotation{:encoding => "application/x-tex"} \Omega^\bullet_{si}(U \times \Delta_{smth}^k)
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ∈
                      %mi SmoothMfd
                    %annotation{:encoding => "application/x-tex"} U \in SmoothMfd
                for the
                %a.existingWikiWord{:href => "/nlab/show/de+Rham+complex"} de Rham complex
                of differential forms on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
