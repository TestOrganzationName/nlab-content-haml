          %h2#wzw_terms
            %strong WZW terms
          %p
            We had seen that in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
            %a.existingWikiWord{:href => "/nlab/show/differential+n-form"} differential (p+2)-form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega \in \Omega^{p+2}_{cl}(X)
            %a.existingWikiWord{:href => "/nlab/show/prequantization"} prequantization
            of it, namely for a
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle (p+1)-bundle with connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            (equivalently:
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in degree-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (p+2)
            \-
            %a.existingWikiWord{:href => "/nlab/show/Deligne+cohomology"}> Deligne cohomology
            ) on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            whose
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mo =
                    %mi ω
                  %annotation{:encoding => "application/x-tex"} F_\nabla = \omega
            %a.existingWikiWord{:href => "/nlab/show/moduli+stacks"} moduli stacks
            this means asking for lifts of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msup
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mrow
                              %mi p
                              %mo +
                              %mn 1
                          %mi U
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %msub
                            %mo{:stretchy => "false"} )
                            %mi conn
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mo ∇
                          %mo ↗
                        %mtd
                          %msup
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mrow
                                %msub
                                  %mi F
                                  %mrow
                                    %mo{:stretchy => "false"} (
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mi ω
                        %mtd
                          %msubsup
                            %mstyle{:mathvariant => "bold"}
                              %mi Ω
                            %mi cl
                            %mrow
                              %mi p
                              %mo +
                              %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; \mathbf{B}^{p+1}U(1)_{conn}
                  \\\
                  \&amp;{}^{\mathllap{\nabla}}\nearrow&amp; \downarrow^{\mathrlap{F_{(-)}}}
                  \\\
                  X
                  \&amp;\stackrel{\omega}{\longrightarrow}&amp;
                  \\mathbf{\Omega}^{p+2}_{cl}
                  }
          %p
            in the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/smooth+homotopy+types"} smooth homotopy types
          %p This immediately raises the question for natural classes of examples of such prequantizations.
          %p
            One such class arises in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/infinity-Lie+theory"} infinity-Lie theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            is a
            %a.existingWikiWord{:href => "/nlab/show/left+invariant+form"} left invariant form
            on a
            %a.existingWikiWord{:href => "/nlab/show/smooth+infinity-group"} smooth infinity-group
            given by a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+cohomology"} L-∞ algebra cohomology
            %a.existingWikiWord{:href => "/nlab/show/prequantum+n-bundles"} prequantum n-bundles
            arising this way are the higher
            %a.existingWikiWord{:href => "/nlab/show/WZW+terms"} WZW terms
            discussed here.
          %p
            In low degree of traditional
            %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} Lie theory
            this appears as follows: On
            %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "-forms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+2)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            which are
            %a.existingWikiWord{:href => "/nlab/show/left+invariant+forms"} left invariant forms
            may be identified, via the general theory of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+2)
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            in the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
            of the
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔤
                %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            corresponding to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
