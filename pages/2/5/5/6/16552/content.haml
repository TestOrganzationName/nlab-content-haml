                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \flat_{dR}\mathbf{B}^{p+2}\mathbb{R} \simeq \flat_{dR}\mathbf{B}^{p+2}U(1)
            is the
            %a{:href => "cohesive+infinity-topos+--+structures#deRhamCohomology"} de Rham coefficients
            (see also at
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+de+Rham+coefficients"} geometry of physics – de Rham coefficients
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ω
                %annotation{:encoding => "application/x-tex"} \omega
            as a de Rham representative of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mstyle{:mathvariant => "bold"}
