                    %mo{:lspace => "verythinmathspace"} :
                    %mi Σ
                    %mo →
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \phi \colon \Sigma \to \tilde G
