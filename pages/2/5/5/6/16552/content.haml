                            %mn 1
                        %mi ℝ
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\exp(b^p \mathbb{R}) \simeq \mathbf{B}^{p+1}\mathbb{R}
                        \\,.
          #LieIntegrationIsFunctorial.num_remark
            %h6#remark Remark
            %p
              The constructions in def.
              %a.maruku-ref{:href => "#SimplicialLieIntegrationOfLinfinityAlgebra"}
              are clearly
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functorial
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebras"} L-∞ algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mo ⟶
                    %mi 𝔥
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \;\colon\; \mathfrak{g} \longrightarrow \mathfrak{h}
            %p it prolongs to a homomorphism of presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \colon \Omega^1_{flat}(-,\mathfrak{g})
                    \\longrightarrow \Omega^1(-,\mathfrak{h})
            %p
              and of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi μ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi exp
                    %mo{:stretchy => "false"} (
                    %mi 𝔥
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\exp(\mu)
                    \\;\colon\;
                    \\exp(\mathfrak{g})
                    \\longrightarrow
                    \\exp(\mathfrak{h})
            %p etc.
          #LInfinityCocyclesAsMorphisms.num_example
            %h6#example_2 Example
            %p
              A degree-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo +
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p+2)
              \-
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycle"} L-∞ cocycle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
              on an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra"} L-∞ algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is a homomorphism of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo ⟶
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \colon \mathfrak{g} \longrightarrow b^{p+1}\mathbb{R}
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/line+Lie+n-algebra"} line Lie (p+2)-algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi b
                        %mrow
                          %mi p
                          %mo +
                          %mn 1
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} b^{p+1}\mathbb{R}
              %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal dual
              of this is the homomorphism of
              %a.existingWikiWord{:href => "/nlab/show/dg-algebras"} dg-algebras
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ⟵
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi ℝ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi μ
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    CE(\mathfrak{g}) \longleftarrow CE(b^{p+1}\mathbb{R}) \colon \mu^\ast
            %p
              which manifestly picks a
              = succeed "-closed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mrow
                          %mi CE
                          %mo{:stretchy => "false"} (
                          %mi 𝔤
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_{CE(\mathfrak{g})}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi CE
                        %mrow
                          %mi p
                          %mo +
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mi 𝔤
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} CE^{p+2}(\mathfrak{g})
            %p
              Precomposing this
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi μ
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \mu^\ast
              with a flat
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebra+valued+differential+form"} L-∞ algebra valued differential form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi Hom
                      %mi dgAlg
                    %mo{:stretchy => "false"} (
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    A \in \Omega^1_{flat}(X,\mathfrak{g}) = Hom_{dgAlg}(CE(\mathfrak{g}), \Omega^\bullet(X))
            %p
              yields, by example
              = succeed "," do
                %a.maruku-ref{:href => "#ExamplesOfLieIntegration"}
              = succeed "-form" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (p+2)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi μ
                      %mo *
                    %mi A
                    %mo ∈
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mrow
                        %mi p
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mu^\ast A \in \Omega^{p+2}_{cl}(X)
                    \\,.
          #GroupOfPeriods.num_defn
            %h6#definition_2 Definition
            %p
              Given an
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+cocycle"} L-∞ cocycle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                    %mo{:lspace => "verythinmathspace"} :
                    %mi 𝔤
                    %mo ⟶
                    %msup
                      %mi b
                      %mrow
                        %mi p
                        %mo +
                        %mn 1
                    %mi ℝ
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\mu \colon \mathfrak{g} \longrightarrow b^{p+1}\mathbb{R}
                    \\,,
            %p
              as in example
