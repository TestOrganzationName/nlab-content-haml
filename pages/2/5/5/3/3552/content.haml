            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dgc-algebras"} dgc-algebras
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijectively
            to
            %a.existingWikiWord{:href => "/nlab/show/connective"} connective
            %a.existingWikiWord{:href => "/nlab/show/nilpotent+L-infinity+algebra"}
              nilpotent
              = succeed "-algebras" do
