          %div
            %h3#EllipticGeneraAsBranePartitionFunctionsReferences
              Elliptic genera as super
              = succeed "-brane" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
            %p
