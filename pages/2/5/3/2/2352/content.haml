                            %mtd
                              %msup
                                %mo{:stretchy => "false"} ↓
                                %mi F
                          %mtr
                            %mtd
                              %mi D
                            %mtd
                              %mover
                                %mo →
                                %mrow
                                  %msub
                                    %mi Id
                                    %mi D
                            %mtd
                              %mi D
                    %annotation{:encoding => "application/x-tex"}
                      \\array{
                      Graph(F) &amp;\to&amp; C
                      \\\
                      \\downarrow &amp; \swArrow &amp; \downarrow^F
                      \\\
                      D &amp;\stackrel{Id_D}{\to}&amp; D
                      }
            %li
              %p
                Pairs
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo :
                      %mi c
                      %mo ′
                      %mo →
                      %mi c
                      %mo ,
                      %mi g
                      %mo :
                      %mi d
                      %mo →
                      %mi d
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f:c'\to c, g:d\to d')
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo ′
                        %mo =
                        %mi g
                        %mo ∘
                        %mi ϕ
                        %mo ∘
                        %mi F
                        %mi f
                      %annotation{:encoding => "application/x-tex"} \phi' = g \circ \phi \circ F f
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mi op
                        %mo ×
                        %mi D
                      %annotation{:encoding => "application/x-tex"} C^{op}\times D
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/discrete+opfibration"} discrete opfibration
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
