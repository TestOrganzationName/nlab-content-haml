                  %msup
                    %mi D
                    %mi op
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \chi_f : C \times D^{op} \to (\infty,0)
            as described at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/universal+fibration+of+%28%E2%88%9E%2C1%29-categories"} universal fibration of (∞,1)-categories
          %h3#for_00categories_sets For (0,0)-categories (sets)
          %p
            To reproduce the ordinary notion of
            %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph of a function
            let
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,r) = (0,0)
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,r)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X,Y
            are just sets and a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            is just a function between sets. Moreover, the category of
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1,r) = (-1,0)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{0,1\}
            of truth values, as described at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28-1%29-category"} (-1)-category
            %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
            corresponding to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} f : X \to Y
            is therefore the characteristic function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mi f
                  %mo :
                  %mi X
                  %mo ×
                  %mi Y
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\chi_f : X \times Y \to \{0,1\}
          %p that maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mi if
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi y
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mi otherwise
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\chi_f(x,y) =
                  \\left\lbrace
                  \\array{
                  1 &amp; if f(x) = y
                  \\\
                  0 &amp; otherwise
                  }
                  \\right.
                  \\,.
          %p
            (Notice that in this case
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mi op
                    %mo =
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X^{op} = X
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/2-pullback"} 2-pullback
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                  %mo =
                  %mn 1
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} {*} = {1} \to \{0,1\}
            along
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mi f
                %annotation{:encoding => "application/x-tex"} \chi_f
            is just the ordinary
            %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Graph
                          %mo{:stretchy => "false"} (
                          %mi f
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mi X
                          %mo ×
                          %mi Y
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mi χ
                                %mi f
                        %mtd
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Graph(f) &amp;\to&amp; {*}
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  X \times Y
                  \&amp;\stackrel{\chi_f}{\to}&amp;
                  \\{0,1\}
                  }
          %p
            which identifies
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Graph
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Graph(f) \hookrightarrow X \times Y
            with the subset of pairs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (x,y)
            for which
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f(x) = y
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+function"} graph of a function
          %h2#related_concepts Related concepts
          %ul
            %li
              %strong> graph of a functor
              ,
              %a.existingWikiWord{:href => "/nlab/show/cograph+of+a+functor"} cograph of a functor
            %li
