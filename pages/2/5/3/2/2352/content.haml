                      %annotation{:encoding => "application/x-tex"} C\times D
                %a.existingWikiWord{:href => "/nlab/show/two-sided+discrete+fibration"} two-sided discrete fibration
                that is contravariant over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                and covariant over
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                %a.existingWikiWord{:href => "/nlab/show/comma+category"} comma category
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} ↓
                        %msub
                          %mi Id
                          %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (F\downarrow Id_D)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mi Graph
                              %mo{:stretchy => "false"} (
                              %mi F
                              %mo{:stretchy => "false"} )
                            %mtd
                              %mo →
                            %mtd
                              %mi C
                          %mtr
                            %mtd
                              %mo{:stretchy => "false"} ↓
                            %mtd
