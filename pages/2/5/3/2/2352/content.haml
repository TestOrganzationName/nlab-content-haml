                          %mi D
                          %mi op
                      %annotation{:encoding => "application/x-tex"} D^{op}
          %p
            If the profunctor is the
            %span.newWikiWord
              hom profunctor
              %a{:href => "/nlab/new/hom+profunctor"} ?
            of a category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and the second graph is the
            %a.existingWikiWord{:href => "/nlab/show/twisted+arrow+category"} twisted arrow category
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h3#graphs_of_a_functor Graphs of a functor
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} F:C\to D
            be a functor, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo •
                  %mo :
                  %msup
                    %mi C
                    %mi op
                  %mo ×
                  %mi D
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F^\bullet : C^{op}\times D \to Set
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo •
                %annotation{:encoding => "application/x-tex"} F_\bullet
            be the corresponding representable
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/profunctors"} profunctors
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "2em"}
                  %msub
                    %mi F
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi Fc
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} F^\bullet(c,d) = D(F c, d) \qquad F_\bullet(d,c) = D(d,Fc).
          %p
            Then the graphs of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mo •
                %annotation{:encoding => "application/x-tex"} F^\bullet
            yield four graphs of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ∈
                    %mi C
                    %mo ,
                    %mi d
                    %mo ∈
                    %mi D
                    %mo ,
                    %mi ϕ
                    %mo :
                    %mi F
                    %mi c
                    %mo →
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (c\in C, d\in D, \phi:F c \to d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo ,
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ′
                  %mo ,
                  %mi d
                  %mo ′
                  %mo ,
                  %mi ϕ
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (c,d,\phi) \to (c',d',\phi')
            are:
          %ul
            %li
              %p
                Pairs
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo :
                      %mi c
                      %mo →
                      %mi c
                      %mo ′
                      %mo ,
                      %mi g
                      %mo :
                      %mi d
                      %mo →
                      %mi d
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f:c\to c', g:d\to d')
                such that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
