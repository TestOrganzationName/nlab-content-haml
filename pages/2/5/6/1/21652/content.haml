              %li
                %a{:href => "#examples_and_applications"} Examples and applications
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            The
            %em Dieudonné determinant
            is a variant of the notion of
            %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            which applies to
            %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            with values in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/division+rings"} division rings
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
            %a.existingWikiWord{:href => "/nlab/show/SL%282%2CH%29"} SL(2,H)
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
          %h2#definition Definition
          %h3#general General
          %p
            %a{:href => "#Dieudonne"} Dieudonné 43
            showed that for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/division+ring"} division ring
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            of the form
          #eq:TheGroupHomomorphism.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} [
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %msup
                    %mi K
                    %mo ×
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi K
                    %mo ×
                  %mo ,
                  %msup
                    %mi K
                    %mo ×
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\alpha
                  \\;\colon\;
                  GL(n,K)/[GL(n,K), GL(n,K)]
                  \\longrightarrow
                  K^\times/[K^\times, K^\times]
                  \\,,
          %p where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL(n,K)
                is the
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear
                %a.existingWikiWord{:href => "/nlab/show/group"} group
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ×
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n \times n
                %a.existingWikiWord{:href => "/nlab/show/invertible+matrices"} invertible
                %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
                with entries in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi K
                        %mo ×
                      %mo =
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi K
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K^\times = GL(1,K)
                is the
                %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} [
                      %mi G
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} G/[G,G]
                is the
                %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
                of the group
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
          %p
            Moreover, this group homomorphism
            %a.maruku-eqref{:href => "#eq:TheGroupHomomorphism"} (1)
            is uniquely determined by the following properties:
          %ul
            %li
              %p
                If a row of the matrix
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is left multiplied by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %msup
                        %mi K
                        %mo ×
                    %annotation{:encoding => "application/x-tex"} a \in K^\times
                then
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha(T)
                is left multiplied by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi a
                        %mo{:stretchy => "false"} ]
                        %mo ∈
                        %msup
                          %mi K
                          %mo ×
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi K
                          %mo ×
                        %msup
                          %mi K
                          %mo ×
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} [a] \in K^\times/[K^\times K^\times]
            %li
              %p
                If a multiple of one row of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi T
                    %annotation{:encoding => "application/x-tex"} T
                is added to another row of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                      %annotation{:encoding => "application/x-tex"} T
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi T
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha(T)
                is unchanged.
          %p
            Composing the homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                %annotation{:encoding => "application/x-tex"} \alpha
            %a.maruku-eqref{:href => "#eq:TheGroupHomomorphism"} (1)
            with the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} [
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  q
                  \\,\colon\,
                  GL(n,K)
                  \\longrightarrow
                  GL(n,K) / [GL(n,K), GL(n,K)]
          %p
            gives the
            %strong Dieudonné determinant
          #eq:TheDieudonneDeterminant.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi det
                    %mi D
                  %mspace{:width => "thinmathspace"}
                  %mo ≔
                  %mspace{:width => "thinmathspace"}
                  %mi q
                  %mo ∘
                  %mi α
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mi K
                    %mo ×
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi K
                    %mo ×
                  %mo ,
                  %msup
                    %mi K
                    %mo ×
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  det_{D}
                  \\,\coloneqq\,
                  q \circ \alpha
                  \\;\colon\;
                  GL(n,K)
                  \\longrightarrow
                  K^\times / [K^\times, K^\times]
                  \\,.
          %h3#the_quaternionic_case The quaternionic case
          %p
            In the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            is the ring of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℍ
                    %mo ×
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi ℍ
                    %mo ×
                  %mo ,
                  %msup
                    %mi ℍ
                    %mo ×
                  %mo{:stretchy => "false"} ]
                  %mo ⟶
                  %msub
                    %mi ℝ
                    %mrow
                      %mo &gt;
                      %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{H}^\times
                  \/
                  [
                  \\mathbb{H}^\times,
                  \\mathbb{H}^\times
                  ]
                  \\longrightarrow
                  \\mathbb{R}_{\gt 0}
          %p
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℝ
                    %mrow
                      %mo &gt;
                      %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{R}_{\gt 0}
            is made into a group using
            %a.existingWikiWord{:href => "/nlab/show/multiplication"} multiplication
            of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            %a.existingWikiWord{:href => "/nlab/show/commutator+subgroup"} commutator subgroup
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msup
                    %mi ℍ
                    %mo ×
                  %mo ,
                  %msup
                    %mi ℍ
                    %mo ×
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [\mathbb{H}^\times, \mathbb{H}^\times]
            is the group
            %a.existingWikiWord{:href => "/nlab/show/Sp%281%29"} Sp(1)
            of quaternions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi q
                    %mo{:stretchy => "false"} |
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} |q| = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mi q
                %annotation{:encoding => "application/x-tex"} a q
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ∈
                  %msub
                    %mi ℝ
                    %mrow
                      %mo &gt;
                      %mn 0
                %annotation{:encoding => "application/x-tex"} a \in \mathbb{R}_{\gt 0}
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo |
                      %mi q
                      %mo |
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \left\vert q \right\vert = 1
          %p
            Thus, in this case we can write the Dieudonné determinant
            %a.maruku-eqref{:href => "#eq:TheDieudonneDeterminant"} (2)
            more concretely as a
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi det
                    %mi D
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi ℍ
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi ℝ
                    %mrow
                      %mo &gt;
                      %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  det_{D}
                  \\,\colon\,
                  GL(n,\mathbb{H})
                  \\longrightarrow
                  \\mathbb{R}_{\gt 0}
                  \\,.
          %p
            Furthermore, for any
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n \times n
            quaternionic matrix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            that is not invertible, setting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi det
                    %mi D
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mn 0
                %annotation{:encoding => "application/x-tex"} det_D(T) \coloneqq 0
            %a.existingWikiWord{:href => "/nlab/show/extension"} extends
            the Dieudonné determinant to a
            %a.existingWikiWord{:href => "/nlab/show/function"} function
            of the form
          #eq:DieudonneDetOverQuaternions.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi det
                    %mi D
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi M
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi ℍ
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi ℝ
                    %mrow
                      %mo ≥
                      %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  det_{D}
                  \\;\colon\;
                  M_n(\mathbb{H})
                  \\longrightarrow
                  \\mathbb{R}_{\ge 0}
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} M
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi ℍ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{M}_n(\mathbb{H})
            is now the full
            %a.existingWikiWord{:href => "/nlab/show/matrix+algebra"} matrix algebra
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n \times n
            matrices with
            %a.existingWikiWord{:href => "/nlab/show/quaternion"} quaternion
            entries. This function
            %a.maruku-eqref{:href => "#eq:DieudonneDetOverQuaternions"} (3)
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
          #eq:QuaternionicDieudonneIsMonoidHomomorphism.maruku-equation
            %span.maruku-eq-number (4)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi det
                            %mi D
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mi T
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi det
                            %mi D
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %msub
                            %mi det
                            %mi D
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo ,
                      %mtr
                        %mtd
                          %msub
                            %mi det
                            %mi D
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 1
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  det_{D}(S T)
                  \&amp; =
                  det_{D}(S)
                  \\cdot
                  det_{D}(T),
                  \\\
                  det_{D}(1)
                  \&amp;
                  \= 1
                  \\mathrlap{\,.}
                  \\end{aligned}
          %h2#variants Variants
          %h3#DraxlPredeterminant Draxl’s predeterminant
          %p
            %a{:href => "#Draxl83"} Draxl 83
            introduces a more primitive notion, the
            = succeed ":" do
              %em Dieudonné predeterminant
          %p
            Given an invertible matrix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            over a
            %a.existingWikiWord{:href => "/nlab/show/skew-field"} skew-field
            (and in some other cases) there is a
            %em strict Bruhat normal form
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            (
            %a{:href => "#Draxl83"}> Draxl 83, Sec. 19, Thm. 1, Def. 1 (p. 128)
            )
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo =
                  %mi U
                  %mi D
                  %mi P
                  %mi L
                %annotation{:encoding => "application/x-tex"} T = U D P L
            where
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                    %annotation{:encoding => "application/x-tex"} P
                is a permutation matrix
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                is upper triangular unidiagonal,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
                diagonal
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                    %annotation{:encoding => "application/x-tex"} L
                lower triangular unidiagonal matrix.
          %p
            The case when for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            the identity matrix can be taken may be viewed as generic as such matrices are dense in a number of meanings and contexts. This is the case of belonging to the
            %em big
            Bruhat cell or equivalently to the
            %em main
            Gauss cell, and the decomposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo =
                  %mi U
                  %mi D
                  %mi L
                %annotation{:encoding => "application/x-tex"} T = U D L
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Gauss+decomposition"} Gauss decomposition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi U
                  %mi D
                  %mi L
                %annotation{:encoding => "application/x-tex"} P U D L
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            fixed, are also dense in the same sense as they are simply the shifts (by multiplication by an invertible matrix
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
          %p
            The
            %em Dieudonné predeterminant
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi ϵ
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \delta\epsilon\tau(T)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            upside down (
            %a{:href => "#Draxl83"}> Draxl 83, Sec. 20, Def. 1 (p. 133)
            ) if the matrix is invertible and zero otherwise.
          %p
            The Dieudonné determinant is then the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi δ
                  %mi ϵ
                  %mi τ
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \delta\epsilon\tau(T)
            under the projection to the
            %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
            (
            %a{:href => "#Draxl83"}> Draxl 83, Sec. 20, Cor. 1 (p. 135)
            )
          %p
            It is well known that the Gauss decomposition of matrices over a noncommutative ring has a simple expression in terms of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasideterminants"} quasideterminants
            %a{:href => "#GelfandRetakh02"} Gelfand-Retakh 02
            (and in their earlier references, around 1990), from which it can be inferred that the Dieudonné predeterminant can be generically presented as a signed product of quasideterminants.
          %h3#the_study_determinant The Study determinant
          %p
            There is another notion of determinant for
            %a.existingWikiWord{:href => "/nlab/show/quaternion"} quaternionic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            = succeed "." do
              %strong Study determinant
          %p
            Any matrix
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo ∈
                  %msub
                    %mi{:mathvariant => "normal"} M
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi ℍ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} T \in \mathrm{M}_n(\mathbb{H})
            determines by right multiplication a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of left
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} \mathbb{H}
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℍ
                      %mi n
                    %mo →
                    %msup
                      %mi ℍ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} T \colon \mathbb{H}^n \to \mathbb{H}^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∈
                  %mi ℍ
                %annotation{:encoding => "application/x-tex"} i \in \mathbb{H}
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mn 2
                  %mo =
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} i^2 = -1
            gives
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℍ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{H}^n
            the structure of a left
            = succeed "-module:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
            %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex vector space
            of dimension
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                    %mi n
                  %annotation{:encoding => "application/x-tex"} 2n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi ℍ
                    %mi n
                  %mo →
                  %msup
                    %mi ℍ
                    %mi n
                %annotation{:encoding => "application/x-tex"} T \colon \mathbb{H}^n \to \mathbb{H}^n
            with a
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
            %a.existingWikiWord{:href => "/nlab/show/linear+transformation"} linear transformation
            of a complex vector space, and define its
            %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
            in the usual way for such a transformation.
          %p
            This determinant turns out not to depend on the choice of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo ∈
                  %mi ℍ
                %annotation{:encoding => "application/x-tex"} i \in \mathbb{H}
            with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi i
                      %mn 2
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i^2 = -1
            %strong Study determinant
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi det
                      %mi S
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} det_S(T)
          %p It clearly obeys
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                      %mtr
                        %mtd
                          %msub
                            %mi det
                            %mi S
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mi T
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %msub
                            %mi det
                            %mi S
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                          %mo ⋅
                          %msub
                            %mi det
                            %mi S
                          %mo{:stretchy => "false"} (
                          %mi T
                          %mo{:stretchy => "false"} )
                          %mo ,
                      %mtr
                        %mtd
                          %msub
                            %mi det
                            %mi S
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo =
                          %mn 1
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\begin{aligned}
                  det_S(S T)
                  \&amp; = det_S(S) \cdot det_S(T),
                  \\\
                  det_S(1) &amp;= 1
                  \\mathrlap{\,.}
                  \\end{aligned}
          %p
            %em A priori
            it is complex-valued, but in fact it takes nonnegative real values, because one can show (
            %a{:href => "#Arlaksen96"}> Arlaksen 96
            ) that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi det
                    %mi S
                  %mo{:stretchy => "false"} (
                  %mi T
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi det
                    %mi D
                  %mo{:stretchy => "false"} (
                  %mi T
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  det_{S}(T) = det_{D}(T)^2
                  \\,,
          %p
            where the determinant on the right is the Dieudonné determinant
            = succeed "." do
              %a.maruku-eqref{:href => "#eq:DieudonneDetOverQuaternions"} (3)
          %p
            Thus, by
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:QuaternionicDieudonneIsMonoidHomomorphism"} (4)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n \times n
            quaternionic matrices defines a monoid homomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi det
                    %mi S
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi M
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi ℍ
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi ℝ
                    %mrow
                      %mo ≥
                      %mn 0
                %annotation{:encoding => "application/x-tex"}
                  det_{S}
                  \\;\colon\;
                  M_n(\mathbb{H})
                  \\longrightarrow
                  \\mathbb{R}_{\ge 0}
          %p which contains exactly as much information as the Dieudonné determinant.
          %h2#examples_and_applications Examples and applications
          %p
            Over any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/division+ring"} division ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mo ×
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2 \times 2
            matrix has the following form:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi det
                  %mrow
                    %mo (
                    %mtable{:columnalign => "center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi a
                        %mtd
                          %mi b
                      %mtr
                        %mtd
                          %mi c
                        %mtd
                          %mi d
                    %mo )
                  %mo =
                  %mrow
                    %mo {
                    %mtable{:columnalign => "center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi c
                          %mi b
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mtext if
                          %mspace{:width => "thickmathspace"}
                          %mi a
                          %mo =
                          %mn 0
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} [
                          %mi a
                          %mi d
                          %mo −
                          %mi a
                          %mi c
                          %msup
                            %mi a
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mi b
                          %mo{:stretchy => "false"} ]
                        %mtd
                          %mtext if
                          %mspace{:width => "thickmathspace"}
                          %mi a
                          %mo ≠
                          %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\det \left({\begin{array}{cc} a &amp; b \\ c &amp; d \end{array}}\right) =
                  \\left\lbrace{\begin{array}{ccc} [-c b] &amp; \text{if } \; a = 0 \\ [a d - a c a^{-1}b] &amp; \text{if } \; a \ne 0 \end{array}}\right. \, .
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [x]
            stands for the equivalence class of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∈
                  %msup
                    %mi K
                    %mo ×
                %annotation{:encoding => "application/x-tex"} x \in K^\times
            in the abelianization
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi K
                      %mo ×
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi K
                      %mo ×
                    %mo ,
                    %msup
                      %mi K
                      %mo ×
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} K^\times/[K^\times, K^\times]
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/special+linear+group"} special linear group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} SL
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo ,
                  %mi ℍ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{SL}(n,\mathbb{H})
            over the
            %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
            (e.g.
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/SL%282%2CH%29"} SL(2,H)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n \times n
            quaternionic matrices for which the Dieudonné determinant equals 1, or equivalently for which the Study determinant equals 1.
          %p
            We can show that the
            %a.existingWikiWord{:href => "/nlab/show/quaternionic+unitary+group"} quaternionic unitary group
            %a.existingWikiWord{:href => "/nlab/show/Sp%28n%29"} Sp(n)
            is a subgroup of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} SL
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi ℍ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{SL}(n,\mathbb{H})
          %p
            Every quaternionic unitary matrix is conjugate to a diagonal one since every element is conjugate to one in a maximal torus,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{U}(n)
            contains a maximal torus of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Sp
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Sp}(n)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} U
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{U}(n)
            is conjugate to a diagonal one. Thus, every
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo ∈
                  %mi Sp
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g \in Sp(n)
            is conjugate to one of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} diag
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi q
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi q
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{diag}(q_1, \dots, q_n)
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi q
                    %mi i
                  %mo ∈
                  %mi ℂ
                  %mo ⊂
                  %mi ℍ
                %annotation{:encoding => "application/x-tex"} q_i \in \mathbb{C} \subset \mathbb{H}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi q
                    %mi i
                  %mo{:stretchy => "false"} |
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} |q_i| = 1
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi det
                      %mi D
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} diag
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi q
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi q
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} det_D(\mathrm{diag}(q_1, \dots, q_n)) = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi det
                    %mi D
                  %mo{:stretchy => "false"} (
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} det_D(g) = 1
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi Sp
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g \in Sp(n)
          %h2#references References
          %p The original article:
          %ul
            %li#Dieudonne43
              %a.existingWikiWord{:href => "/nlab/show/Jean+Dieudonn%C3%A9"}> Jean Dieudonné
              \:
              = succeed "," do
                %em Les déterminants sur un corps non commutatif
              %strong 71
              (1943) 27-45 &amp;lbrack;
              %a{:href => "http://www.numdam.org/item/?id=BSMF_1943__71__27_0"}> numdam:BSMF_1943__71__27_0
              \&amp;rbrack;
          %p Exposition and review:
          %ul
            %li#Arlaksen96
              %p
                Helmer Aslaksen:
                = succeed "," do
                  %em Quaternionic determinants
                %strong 18
                (1996) 57–65 &amp;lbrack;
                %a{:href => "https://doi.org/10.1007/BF03024312"}> doi:10.1007/BF03024312
                \&amp;rbrack;
            %li#CohenDeLeo99
              %p
                Nir Cohen, Stefano De Leo:
                = succeed "," do
                  %em The quaternionic determinant
                %strong 7
                (2000) 100-111 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math-ph/9907015"}> arXiv:math-ph/9907015
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://eudml.org/doc/121484"} eudml:121484
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nigel+Hitchin"}> Nigel Hitchin
                \:
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi SL
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} SL(2)
                  over the octonions
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1805.02224"}> arXiv:1805.02224
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jo%C3%A1s+Ven%C3%A2ncio"}> Joás Venâncio
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Carlos+Batista"} Carlos Batista
                %em Two-Component Spinorial Formalism using Quaternions for Six-dimensional Spacetimes
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2007.04296"}> arXiv:2007.04296
                \&amp;rbrack;
          %p See also:
          %ul
            %li
              Wikipedia,
              %em
                %a{:href => "https://en.wikipedia.org/wiki/Dieudonn%C3%A9_determinant"} Dieudonné determinant
          %p
            Comparison to
