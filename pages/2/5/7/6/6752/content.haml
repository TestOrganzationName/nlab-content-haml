          %h2#Idea Idea
          %p
            What is called the
            %em Langlands correspondence
            in
            %a.existingWikiWord{:href => "/nlab/show/number+theory"} number theory
            (
            %a{:href => "#Langlands67"}> Langlands 67
            ) is first of all a
            %a.existingWikiWord{:href => "/nlab/show/conjecture"} conjectural
            correspondence (a
            %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
            subject to various conditions) between
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                \-
                %a.existingWikiWord{:href => "/nlab/show/dimensional"} dimensional
                complex
                %a.existingWikiWord{:href => "/nlab/show/linear+representations"} linear representations
                of the
                %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Gal
                      %mo{:stretchy => "false"} (
                      %mover
                        %mi F
                        %mo{:stretchy => "false"} ¯
                      %mo{:stretchy => "false"} /
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Gal(\bar F/F)
                of a given
                %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
            %li
              %p
                certain
                %a.existingWikiWord{:href => "/nlab/show/representations"} representations
                – called
                %em
                  %a.existingWikiWord{:href => "/nlab/show/automorphic+representations"} automorphic representations
                – of the
                = succeed "-dimensional" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔸
                        %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_n(\mathbb{A}_F)
                with
                %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                in the
                %a.existingWikiWord{:href => "/nlab/show/ring+of+adeles"} ring of adeles
                of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                on the
                %a.existingWikiWord{:href => "/nlab/show/double+coset+space"} double coset space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo \
                      %msub
                        %mi GL
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔸
                        %mi F
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi GL
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi 𝒪
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_n(F) \backslash GL_n(\mathbb{A}_F)/GL_n(\mathcal{O})
                (where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒪
                      %mo =
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mi v
                      %msub
                        %mi 𝒪
                        %mi p
                    %annotation{:encoding => "application/x-tex"} \mathcal{O} = \prod_v \mathcal{O}_p
                is the
                %a.existingWikiWord{:href => "/nlab/show/ring+of+integers"} ring of integers
                of all
                %a.existingWikiWord{:href => "/nlab/show/formal+completions"} formal completions
                of
                = succeed ")." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
          %p
            This is motivated from the abelian case (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n=1
            ), which is fully understood: For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n = 1
            then an
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois group
            factors through
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                %annotation{:encoding => "application/x-tex"} GL_1
            and hence through an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
            %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
            of the Galois group. The
            %a.existingWikiWord{:href => "/nlab/show/Kronecker-Weber+theorem"} Kronecker-Weber theorem
            says that for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} F = \mathbb{Q}
            %a.existingWikiWord{:href => "/nlab/show/idele+class+group"} idele class group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mo \
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi 𝔸
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_1(\mathbb{Q}) \backslash GL_1(\mathbb{A})
            %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "\u201D" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi ℚ
                    %mo{:stretchy => "false"} )
                    %mo \
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi 𝔸
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi GL
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ℤ
                      %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL_1(\mathbb{Q}) \backslash GL_1(\mathbb{A})/GL_1(\mathbb{Z}_p)
            %a.existingWikiWord{:href => "/nlab/show/Artin+reciprocity+law"} Artin reciprocity law
            says that for any
            %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            there is an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo \
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝔸
                    %mi K
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %msub
                    %mi GL
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi 𝒪
                    %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} GL_1(K) \backslash GL_1(\mathbb{A}_K)/GL_1(\mathcal{O}_K)
            and the
            %a.existingWikiWord{:href => "/nlab/show/abelianization"} abelianization
            of the
            %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Gal
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi K
                      %mo{:stretchy => "false"} ¯
                    %mo{:stretchy => "false"} /
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Gal(\bar K/K)
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p Moreover:
          %p#Conjecture1
            %strong Conjecture 1
            To each such
            %a.existingWikiWord{:href => "/nlab/show/automorphic+representation"} automorphic representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                %annotation{:encoding => "application/x-tex"} \pi
            is associated an
            %a.existingWikiWord{:href => "/nlab/show/L-function"} L-function
            – the
            %em
              %a.existingWikiWord{:href => "/nlab/show/automorphic+L-function"} automorphic L-function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi π
                %annotation{:encoding => "application/x-tex"} L_\pi
            – and in generalization of
            %a.existingWikiWord{:href => "/nlab/show/Artin+reciprocity"} Artin reciprocity
            the conjecture of Langlands is that the
            %a.existingWikiWord{:href => "/nlab/show/Artin+L-function"} Artin L-function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi σ
                %annotation{:encoding => "application/x-tex"} L_\sigma
            associated with the given
            %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            is equal to this:
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi σ
                  %mo =
                  %msub
                    %mi L
                    %mi π
                %annotation{:encoding => "application/x-tex"} L_\sigma = L_\pi
            (
            %a{:href => "#Gelbart84"}> Gelbart 84, conjecture 1 (page 27 (204))
            ).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            More generally, analogous statements are supposed to hold for general
            %a.existingWikiWord{:href => "/nlab/show/reductive+algebraic+groups"} reductive algebraic groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            other than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi GL
                      %mi n
                  %annotation{:encoding => "application/x-tex"} GL_n
            %a.existingWikiWord{:href => "/nlab/show/L-function"} L-function
            is assigned to data which in addition to the
            %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
            consists of a
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mi L
                  %mi G
                  %mo ⟶
                  %msub
                    %mi GL
                    %mi n
                %annotation{:encoding => "application/x-tex"} {}^L G \longrightarrow GL_n
            of the
            %a.existingWikiWord{:href => "/nlab/show/Langlands+dual+group"} Langlands dual group
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p First of all:
          %p#Conjecture2
            %strong Conjecture 2
            This more general L-function is conjectured to indeed behave like a decent L-function in that it has meromorphic
            %a.existingWikiWord{:href => "/nlab/show/analytic+continuation"} analytic continuation
            to the
            %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
            and satisfies the “
            %a.existingWikiWord{:href => "/nlab/show/functional+equation"}> functional equation
            ”-invariance under sending its parameter
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                %annotation{:encoding => "application/x-tex"} s
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo −
                  %mi s
                %annotation{:encoding => "application/x-tex"} 1-s
            (
            %a{:href => "#Gelbart84"}> Gelbart 84, conjecture 2’ (page 29 (205))
            ).
          %p Second:
          %p#Conjecture3
            %strong Conjecture 3
            This construction is supposed to behave well with respect to an analytic
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mi L
                  %mi G
                  %mo →
                  %msup
                    %mrow
                    %mi L
                  %msup
                    %mi G
                    %mo ′
                %annotation{:encoding => "application/x-tex"} {}^L G \to {}^L G^{'}
            in that when changing the representation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mrow
                    %mi L
                  %msup
                    %mi G
                    %mo ′
                %annotation{:encoding => "application/x-tex"} {}^L G^{'}
            by precomposition with this homomorphism one may find an accompanying change of Galois representation/automorphic representation from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mo ′
                %annotation{:encoding => "application/x-tex"} G^{'}
            such that the associated L-function remains invariant under these joint changes. This statement is what
            %a.existingWikiWord{:href => "/nlab/show/Robert+Langlands"} Robert Langlands
            calls
            %em functoriality
            (
            %a{:href => "#Gelbart84"}> Gelbart 84, conjecture 3 (page 31 (207))
            )
          %p
            In fact this last conjecture implies the previous two (
            %a{:href => "#Gelbart84"}> Gelbart 84, (page 32 (208))
            ).
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Various versions and refinements of this conjecture have since been considered, for some perspective see (
            %a{:href => "#Taylor02"}> Taylor 02
            ,
            = succeed "," do
              %a{:href => "#Langlands14"} Langlands 14
            = succeed ")." do
              %a{:href => "#Harris14"} Harris 14
            %a.existingWikiWord{:href => "/nlab/show/local+fields"} local fields
            leads to the conjecture of
            %em
              %a.existingWikiWord{:href => "/nlab/show/local+Langlands+correspondences"} local Langlands correspondences
            (
            %a{:href => "#Gelbart84"}> Gelbart 84, (page 34 (210))
            ). On the other hand, the interpretation of the above story dually in
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            in view of the
            %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
            motivates the conjectural
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois group
                is essentially the
                %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                of an
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+curve"} algebraic curve
            %li
              %p
                hence a
                %a.existingWikiWord{:href => "/nlab/show/representation"} representation
                of it is a
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal
                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                with
                %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
                on this curve;
            %li
              %p
                while that curious double quotient
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi GL
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo \
                      %msub
                        %mi GL
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝔸
                        %mi F
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi GL
                        %mi n
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi 𝒪
                        %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} GL_n(F) \backslash GL_n(\mathbb{A}_F)/GL_n(\mathcal{O}_F)
                is, in view of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Weil+uniformization+theorem"} Weil uniformization theorem
                = succeed "-realization" do
                  %a.existingWikiWord{:href => "/nlab/show/Cech+cohomology"} Cech
                %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+bundles"} moduli stack of bundles
                (see there for details) on that curve.
          %div
            %p
              %strong
                %a.existingWikiWord{:href => "/nlab/show/analogies"} analogies
                in the
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Langlands+program"} Langlands program
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic
                    %a.existingWikiWord{:href => "/nlab/show/Langlands+correspondence"} Langlands correspondence
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/ring+of+integers"} ring of integers
                    of
                    %a.existingWikiWord{:href => "/nlab/show/global+field"} global field
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
                    on
                    %a.existingWikiWord{:href => "/nlab/show/complex+curve"} complex curve
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \Sigma
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois group
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
                    of
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \Sigma
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/flat+connection"}> flat connection
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
                    on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \Sigma
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/idele+class+group"} idele class group
                    mod
                    %a.existingWikiWord{:href => "/nlab/show/integral+adeles"} integral adeles
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+line+bundles"} moduli stack of line bundles
                    on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \Sigma
                %tr
                  %td{:style => "text-align: left;"}
                    nonabelian
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thickmathspace"}
                        %annotation{:encoding => "application/x-tex"} \;
                    “
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+vector+bundles"} moduli stack of vector bundles
                    on
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Σ
                        %annotation{:encoding => "application/x-tex"} \Sigma
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/automorphic+representation"} automorphic representation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Hitchin+connection"} Hitchin connection
                    %a.existingWikiWord{:href => "/nlab/show/D-module"} D-module
                    on bundle of
                    %a.existingWikiWord{:href => "/nlab/show/conformal+blocks"} conformal blocks
                    over the moduli stack
          %p
            From this
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            point of view the Langlands conjecture seems to speak of a correspondence that sends
            %a.existingWikiWord{:href => "/nlab/show/Dirac+distributions"} Dirac distributions
            on the
            %a.existingWikiWord{:href => "/nlab/show/moduli+space+of+flat+connections"} moduli space of flat connections
            over an
            %a.existingWikiWord{:href => "/nlab/show/algebraic+curve"} algebraic curve
            to certain “automorphic” functions on the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+bundles"} moduli stack of bundles
            on the same curve. This suggests that the Langlands correspondence should be understood as a nonabelian version of a
            = succeed "-type" do
              %a.existingWikiWord{:href => "/nlab/show/Fourier-Mukai+transform"} Fourier-Mukai
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/local+Langlands+correspondence"} local Langlands correspondence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/automorphic+form"} automorphic form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Shimura+variety"} Shimura variety
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/modularity+theorem"} modularity theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Langlands+functoriality"} Langlands functoriality
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/relative+Langlands+program"} relative Langlands program
          %h2#References References
          %p
            The original
            %a.existingWikiWord{:href => "/nlab/show/conjecture"} conjecture
            is due to
          %ul
            %li#Langlands67
              %a.existingWikiWord{:href => "/nlab/show/Robert+Langlands"}> Robert Langlands
              , letter to
              %a.existingWikiWord{:href => "/nlab/show/Andre+Weil"} Andre Weil
              1967 (
              %a{:href => "https://publications.ias.edu/rpl/paper/43"} IAS page
              including scan and TeXed version, see also
              %a{:href => "http://sunsite.ubc.ca/DigitalMathArchive/Langlands/functoriality.html#weil1967"} this UBC page
              for a little more information)
          %p Introductions and expository surveys include
          %ul
            %li#Gelbart84
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stephen+Gelbart"}> Stephen Gelbart
                ,
                = succeed "," do
                  %em An elementary introduction to the Langlands program
                = succeed "," do
                  %a{:href => "https://projecteuclid.org/euclid.bams/1183551573"} euclid:1183551573
                = succeed ")" do
                  %a{:href => "http://www.ams.org/journals/bull/1984-10-02/S0273-0979-1984-15237-6/"} doi:10.1090/S0273-0979-1984-15237-6
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Frenkel"}> Edward Frenkel
                ,
                = succeed "," do
                  %em
                    Commentary on “An elementary introduction to the Langlands Program” by
                    %a.existingWikiWord{:href => "/nlab/show/Stephen+Gelbart"} Stephen Gelbart
                %strong 48
                (2011), 513-515, (
                %a{:href => "http://www.ams.org/journals/bull/2011-48-04/S0273-0979-2011-01347-7/S0273-0979-2011-01347-7.pdf"}> pdf
                )
            %li
              %p
                Mark Goresky,
                %em Langlands’ conjectures for physicists
                (
                %a{:href => "http://www.math.ias.edu/~goresky/pdf/Physicists.pdf"}> pdf
                )
            %li#Cogdell12
              %p
                James W. Cogdell,
                = succeed "," do
                  %em L-functions and non-abelian class field theory, from Artin to Langlands
                = succeed ")" do
                  %a{:href => "https://people.math.osu.edu/cogdell.1/Artin-www.pdf"} pdf
            %li#MK14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Minhyong+Kim"}> Minhyong Kim
                ,
                = succeed "," do
                  %em A superficial introduction to Langlands functoriality
                = succeed ")" do
                  %a{:href => "http://people.maths.ox.ac.uk/vonk/automorphic/functoriality.pdf"} pdf
            %li#BernsteinGelbart18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Bernstein"}> Joseph Bernstein
                ,
                %a.existingWikiWord{:href => "/nlab/show/Stephen+Gelbart"} Stephen Gelbart
                (eds.),
                = succeed "," do
                  %em An Introduction to the Langlands Program
                = succeed ")" do
                  %a{:href => "https://link.springer.com/book/10.1007/978-0-8176-8226-2"} doi:10.1007/978-0-8176-8226-2
          %p Surveys of the state of the program include
          %ul
            %li#Taylor02
              %p
                Richard Taylor,
                = succeed "," do
                  %em Galois Representations
                = succeed ")." do
                  %a{:href => "http://www.math.ias.edu/~rtaylor/longicm02.pdf"} long version pdf
            %li#Langlands14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Langlands"}> Robert Langlands
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Problems+in+the+theory+of+automorphic+forms+--+45+years+later"} Problems in the theory of automorphic forms – 45 years later
            %li#Harris14
              %p
                Michael Harris,
                = succeed "," do
                  %em Automorphic Galois representations and Shimura varieties
                = succeed ")." do
                  %a{:href => "https://www.imj-prg.fr/~michael.harris/2014.pdf"} pdf
          %p
            Discussion with an eye towards
            %a.existingWikiWord{:href => "/nlab/show/geometric+class+field+theory"} geometric class field theory
            and
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+duality"} geometric Langlands duality
            and
            %a.existingWikiWord{:href => "/nlab/show/quantum+field+theory"} quantum field theory
            is in
          %ul
            %li#Kapranov95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Mikhail+Kapranov"}> Mikhail Kapranov
                ,
                = succeed "," do
                  %em Analogies between the Langlands Correspondence and Topological Quantum Field Theory
                %em Functional Analysis on the Eve of the 21st Century
                Progress in Mathematics Volume 131/132, 1995, pp 119-151
            %li#Toth11
              %p
                Peter Toth,
                = succeed "," do
                  %em Geometric abelian class field theory
                = succeed ")" do
                  %a{:href => "http://dspace.library.uu.nl/handle/1874/206061"} web
            %li#Frenkel09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Edward+Frenkel"}> Edward Frenkel
                ,
                %em Gauge Theory and Langlands Duality
                (
                %a{:href => "http://arxiv.org/abs/0906.2747"}> arXiv:0906.2747
                )
          %p More resources are at
          %ul
            %li
              %p
                the
                %a{:href => "http://sunsite.ubc.ca/DigitalMathArchive/Langlands/intro.html"} digital archive
                of
                = succeed "\u2018" do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Langlands"} Robert Langlands
            %li
              %p
                %a{:href => "https://publications.ias.edu/rpl"} The Work of Robert Langlands
                at the Institute of Advanced Study.
