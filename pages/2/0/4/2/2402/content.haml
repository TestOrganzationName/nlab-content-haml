                    %mn 2
                %annotation{:encoding => "application/x-tex"} g = g_1 + g_2
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo =
                  %msub
                    %mi n
                    %mn 1
                  %mo +
                  %msub
                    %mi n
                    %mn 2
                %annotation{:encoding => "application/x-tex"} n = n_1 + n_2
            obtained by gluing the last marked point of the first curve to the first marked point of the second curve.
          %p so consider now the combination of these two maps
          .maruku-equation
