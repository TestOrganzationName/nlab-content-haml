                  \\alpha
                  \:
                  \\bar M_{g_1,n_1+1}
                  \\times
                  \\bar M_{g_2,n_2+1}
                  \\to
                  \\bar M_{g,n}
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo =
                  %msub
