                              %mi M
                              %mo{:stretchy => "false"} ¯
                            %mrow
                              %mi g
                              %mo ,
                              %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\bar M_{g,n}(X,\beta)
                  \\\
                  \\downarrow^\phi
                  \\\
                  \\bar M_{g,n}
                  }
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mrow
