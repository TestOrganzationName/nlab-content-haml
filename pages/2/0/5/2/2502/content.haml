            (“
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"}> supersymmetry
            ”):
          %ul
            %li#GolfandLikhtman72
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yuri+Golfand"}> Yuri Golfand
                ,
                = succeed ",_On" do
