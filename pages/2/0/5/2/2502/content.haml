                        %mi A
                        %mo ∈
                        %mi 𝒯
                      %annotation{:encoding => "application/x-tex"} A \in \mathcal{T}
            %li
              %p
                In dimensional
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
