                %a.existingWikiWord{:href => "/nlab/show/Daniel+Freed"}> Daniel Freed
                ,
                %em
                  Lecture 4 of
                  %a.existingWikiWord{:href => "/nlab/show/Five+lectures+on+supersymmetry"} Five lectures on supersymmetry
            %li#Varadarajan04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Veeravalli+Varadarajan"}> Veeravalli Varadarajan
                , section 7 of
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Supersymmetry+for+mathematicians"}> Supersymmetry for mathematicians
                    \: An introduction
          %p See also
          %ul
            %li#CAIB99
              C. Chrysso‌malakos,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+de+Azc%C3%A1rraga"} José de Azcárraga
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jos%C3%A9+M.+Izquierdo"} José M. Izquierdo
              = succeed "," do
                %em The geometry of branes and extended superspaces
              %strong 567
              (2000) 293-330 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/hep-th/9904137"}> arXiv:hep-th/9904137
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1016/S0550-3213(99)00512-X"} doi:10.1016/S0550-3213(99)00512-X
          %p
            for discussion in the view of the
            %a.existingWikiWord{:href => "/nlab/show/brane+scan"} brane scan
            and
            %a.existingWikiWord{:href => "/schreiber/show/The+brane+bouquet"} The brane bouquet
            of super-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
