                        %mn 4
                        %mo ,
                        %mn 6
                        %mo ,
                        %mn 10
                      %annotation{:encoding => "application/x-tex"} d =  3,4,6, 10
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
