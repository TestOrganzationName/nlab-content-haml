            \-
            %a.existingWikiWord{:href => "/nlab/show/branes"} branes
            on
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetime"} super-Minkowski spacetime
            = succeed "." do
              %a{:href => "#Brandt12-13"} Brandt 12-13
            %a.existingWikiWord{:href => "/nlab/show/division+algebras"} division algebras
            (
            %a{:href => "#BaezHuerta10"}> Baez-Huerta 10
            ).
          %p
            %strong Theorem
          %ul
            %li
              %p
                In dimensional
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
