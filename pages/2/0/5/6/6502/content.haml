          %h3#pseudoriemannian_geometry (pseudo-)Riemannian geometry
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo =
                  %mi Iso
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G = Iso(d,1)
            be the
            %a.existingWikiWord{:href => "/nlab/show/Poincare+group"} Poincare group
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ⊂
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \subset G
            the
            %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} orthogonal group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(d,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝔦𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi 𝔰𝔬
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi ℝ
                    %mrow
                      %mi d
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\mathfrak{iso}(d,1)/\mathfrak{so}(d,1) \simeq
                  \\mathbb{R}^{d+1}
          %p
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lorentzian+spacetime"} Lorentzian spacetime
            = succeed "-Cartan" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi Iso
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (O(d,1)\hookrightarrow Iso(d,1))
            = succeed "-connection" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(d,1)
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/tangent+space"} tangent space
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
            %a.existingWikiWord{:href => "/nlab/show/pseudo-Riemannian+manifold"} pseudo-Riemannian manifold
            from the perspective discussed at
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/first-order+formulation+of+gravity"} first-order formulation of gravity
          %p
            the
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d+1}
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/vielbein"} vielbein
          %h3#ExampleGStructures
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            \-Structures
          %p
            More generally,
            %a.existingWikiWord{:href => "/nlab/show/G-structures"} G-structures
            equipped with compatible principal connections are given by Cartan connections. (We will speak of “
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            \-structure” here, since the reduced structure will correspond to the group denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            above, while what is denoted
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            above will be the semidirect product of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            with the
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/translation+group"} translation group
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo →
                  %mi GL
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H \to GL(\mathbb{R}^n)
            be a
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            %a.existingWikiWord{:href => "/nlab/show/reduction+of+the+structure+group"} reduction of the structure group
            of the
            %a.existingWikiWord{:href => "/nlab/show/frame+bundle"} frame bundle
            of a manifold of
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            along this map is an
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} H-structure
            on the manifold. Then write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ≔
                  %msup
                    %mi ℝ
                    %mi n
                  %mo ⋊
                  %mi H
                %annotation{:encoding => "application/x-tex"}
                  G \coloneqq \mathbb{R}^n \rtimes H
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/semidirect+product"} semidirect product
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            with the
            %a.existingWikiWord{:href => "/nlab/show/translation+group"} translation group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
            via the canonical action of the
            %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi GL
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} GL(\mathbb{R}^n)
          %p
            With this an
            = succeed "-Cartan" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ↪
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mi n
                    %mo ⋊
                    %mi H
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (H \hookrightarrow G)= (H \hookrightarrow \mathbb{R}^n \rtimes H)
            %a.existingWikiWord{:href => "/nlab/show/G-structure"} H-structure
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/vielbein+field"} vielbein field
            and with an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
          %p
            (
            %a{:href => "#CapSlovak09"}> CapSlovak 09, section 1.3.6 and 1.6.1
            )
          %p
            With this identification the
            %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+Cartan+connection"} torsion of a Cartan connection
            maps into the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/torsion+of+a+G-structure"} torsion of a G-structure
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection on a bundle
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/parallel+transport"}> parallel transport
                  ,
                  %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/affine+connection"}> affine connection
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+connection"} Levi-Civita connection
                  %strong Cartan connection
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+2-bundle"} connection on a 2-bundle
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/connection+on+an+%E2%88%9E-bundle"} connection on an ∞-bundle
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/higher+Cartan+geometry"} ∞-Cartan connection
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
          %h2#References References
          %h3#general General
          %p
            The idea originates in
            = succeed "\u2018s" do
              %a.existingWikiWord{:href => "/nlab/show/%C3%89lie+Cartan"} Élie Cartan
            = succeed ")L" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cartan+geometry"} Cartan geometry
          %ul
            %li#Cartan23
              %a.existingWikiWord{:href => "/nlab/show/%C3%89lie+Cartan"}> Élie Cartan
              ,
              = succeed "," do
                %em Sur les variétés à connexion affine et la théorie de la relativité généralisée (première partie)
              %strong 3
              40 (1923) 325-412 &amp;lbrack;
              %a{:href => "http://www.numdam.org/item?id=ASENS_1923_3_40__325_0"}> numdam:ASENS_1923_3_40__325_0
              \&amp;rbrack;
          %p Historical review:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Erhard+Scholz"}> Erhard Scholz
              ,
              = succeed "," do
                %em E. Cartan’s attempt at bridge-building between Einstein and the Cosserats – or how translational curvature became to be known as “torsion”
              %strong 44
              (2019) 47-75 [
              %a{:href => "https://doi.org/10.1140/epjh/e2018-90059-x"}> doi:10.1140/epjh/e2018-90059-x
              ]
          %p
            The formalization in terms of
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            (in their incarnation as
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Ehresmann+connections"} Ehresmann connections
          %ul
            %li#Ehresmann50
              %a.existingWikiWord{:href => "/nlab/show/Charles+Ehresmann"}> Charles Ehresmann
              ,
              = succeed "," do
                %em Les connexions infinitesimales dans un espace fibre diff´erentiable
          %p reviewed in
          %ul
            %li#Marle14
              %a.existingWikiWord{:href => "/nlab/show/Charles-Michel+Marle"}> Charles-Michel Marle
              ,
              %em The works of Charles Ehresmann on connections: from Cartan connections to connections on fibre bundles
              (
              %a{:href => "http://arxiv.org/abs/1401.8272"}> arxiv:1401.8272
              )
          %p see also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Sh%C3%B4shichi+Kobayashi"}> Shôshichi Kobayashi
              ,
              = succeed "," do
                %em On Connections Of Cartan
              %strong 8
              (1956) 145-156 &amp;lbrack;
              %a{:href => "https://doi.org/10.4153/CJM-1956-018-8"}> doi:10.4153/CJM-1956-018-8
              \&amp;rbrack;
          %p Introduction:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Richard+W.+Sharpe"}> Richard W. Sharpe
              ,
              = succeed "," do
                %em An introduction to Cartan Geometries
              = succeed "," do
                %a{:href => "https://eudml.org/doc/220395"} eudml:220395
              = succeed "&rbrack;" do
                %a{:href => "http://dml.cz/dmlcz/701688"} dml:701688
          %p Monographs:
          %ul
            %li#Sharpe97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Richard+W.+Sharpe"}> Richard W. Sharpe
                ,
                = succeed "," do
                  %em Differential geometry – Cartan’s generalization of Klein’s Erlagen program
                = succeed "," do
                  %strong 166
                = succeed "&rbrack;" do
                  %a{:href => "https://link.springer.com/book/9780387947327"} ISBN:9780387947327
            %li#CapSlovak09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andreas+%C4%8Cap"}> Andreas Čap
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jan+Slov%C3%A1k"} Jan Slovák
                = succeed "," do
                  %em Parabolic Geometries I – Background and General Theory
                = succeed "&rbrack;" do
                  %a{:href => "http://bookstore.ams.org/surv-154"} ISBN:978-1-4704-1381-1
          %p
            Discussion with an eye towards
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/first-order+formulation+of+gravity"} first-order formulation of gravity
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gabriel+Catren"}> Gabriel Catren
                ,
                = succeed "," do
                  %em Geometrical Foundations of Cartan Gauge Gravity
                %strong 12
                04 (2015) 1530002 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1407.7814"}> arXiv:1407.7814
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/S0219887815300020"} doi:10.1142/S0219887815300020
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kirill+Krasnov"}> Kirill Krasnov
                , §3 in:
                = succeed "," do
                  %em Formulations of General Relativity
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/9781108674652"} doi:10.1017/9781108674652
                = succeed "&rbrack;" do
                  %a{:href => "https://www.maths.nottingham.ac.uk/plp/pmzkk/book_taster.pdf"} pdf
          %p
            Discussion with an eye towards
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/torsion+constraints+in+supergravity"} torsion constraints in supergravity
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Lott"}> John Lott
                ,
                = succeed "," do
                  %em Torsion Constraints in Supergravity
                %strong 133
                (1990) 563-615
            %li#Lott01
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+Lott"}> John Lott
                ,
                %em The Geometry of Supergravity Torsion Constraints
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/0108125"}> arXiv:0108125
                \&amp;rbrack;
          %p See also
          %ul
            %li#Kuranishi95
              %p
                %a.existingWikiWord{:href => "/nlab/show/Masatake+Kuranishi"}> Masatake Kuranishi
                ,
                = succeed "," do
                  %em CR geometry and Cartan geometry
                = succeed "," do
                  %a{:href => "https://eudml.org/doc/186418"} EuDML page
                = succeed ")" do
                  %a{:href => "http://gdz.sub.uni-goettingen.de/dms/load/pdf/?PPN=PPN481110151_0007&DMDID=dmdlog11"} page with link to pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dmiti+Alekseevesky"}> Dmiti Alekseevesky
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Peter+Michor"} Peter Michor
                %em Differential geometry of Cartan connections
                Publ. Math. Debrecen 47/3-4 (1995), 349-375 (
                %a{:href => "http://www.mat.univie.ac.at/~michor/cartan.pdf"}> pdf
                )
          %p
            Further discussion of Cartan connections as models for the
            %a.existingWikiWord{:href => "/nlab/show/first+order+formulation+of+gravity"} first order formulation of gravity
            is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Derek+Wise"}> Derek Wise
                ,
                = succeed "," do
                  %em MacDowell-Mansouri gravity and Cartan geometry
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/gr-qc/0611154/"} arXiv:gr-qc/0611154
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gabriel+Catren"}> Gabriel Catren
                ,
                %em Geometrical Foundations of Cartan Gauge Gravity
                (
                %a{:href => "http://arxiv.org/abs/1407.7814"}> arXiv:1407.7814
                )
          %p See also
          %ul
            %li
              wikipedia
              %a{:href => "http://en.wikipedia.org/wiki/Cartan_connection"} Cartan connection
          %div
            %h3#cartan_structural_equations_and_bianchi_identities Cartan structural equations and Bianchi identities
            %p
              On
              %a.existingWikiWord{:href => "/nlab/show/Cartan+structural+equations"} Cartan structural equations
              and their
              %a.existingWikiWord{:href => "/nlab/show/Bianchi+identities"} Bianchi identities
              for
              %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
              and
              %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion
              of
              %a.existingWikiWord{:href => "/nlab/show/Cartan+moving+frames"} Cartan moving frames
              and (
              %a.existingWikiWord{:href => "/nlab/show/Cartan+connection"}> Cartan
              \-)
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connections
              on
              %a.existingWikiWord{:href => "/nlab/show/tangent+bundles"} tangent bundles
              (especially in
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/first-order+formulation+of+gravity"} first-order formulation of gravity
            %p The original account:
            %ul
              %li#Cartan1923
                %a.existingWikiWord{:href => "/nlab/show/%C3%89lie+Cartan"}> Élie Cartan
                ,
                = succeed "," do
                  %em Sur les variétés à connexion affine et la théorie de la relativité généralisée (première partie)
                %strong 40
                (1923) 325-412 [
                %a{:href => "http://www.numdam.org/item?id=ASENS_1923_3_40__325_0"}> doi:ASENS_1923_3_40__325_0
                ]
            %p Historical review:
            %ul
              %li#Scholz19
                %a.existingWikiWord{:href => "/nlab/show/Erhard+Scholz"}> Erhard Scholz
                , §2 in:
                = succeed "," do
                  %em E. Cartan’s attempt at bridge-building between Einstein and the Cosserats – or how translational curvature became to be known as “torsion”
                %strong 44
                (2019) 47-75 [
                %a{:href => "https://doi.org/10.1140/epjh/e2018-90059-x"}> doi:10.1140/epjh/e2018-90059-x
                ]
            %p Further discussion:
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Shiing-Shen+Chern"}> Shiing-Shen Chern
                  , p. 748 of:
                  = succeed "," do
                    %em A Simple Intrinsic Proof of the Gauss-Bonnet Formula for Closed Riemannian Manifolds
                  %strong 45
                  4 (1944) 747-752 [
                  %a{:href => "https://doi.org/10.2307/1969302"}> doi:10.2307/1969302
                  ]
              %li#CastellaniDAuriaFre
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"} Riccardo D'Auria
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} Supergravity and Superstrings - A Geometric Perspective
                  = succeed "," do
                    %a{:href => "https://doi.org/10.1142/0224"} doi:10.1142/0224
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/files/CDF91-TOC.pdf", :title => "pdf"} pdf
                  = succeed "]" do
                    %a.existingWikiWord{:href => "/nlab/files/CastellaniDAuriaFre-ChI2.pdf", :title => "pdf"} pdf
              %li
                %p
                  C. C. Briggs,
                  %em A Sequence of Generalizations of Cartan’s Conservation of Torsion Theorem
                  [
                  %a{:href => "https://arxiv.org/abs/gr-qc/9908034"}> arXiv:gr-qc/9908034
                  ]
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Loring+Tu"}> Loring Tu
                  , §22 in:
                  = succeed "," do
                    %em Differential Geometry – Connections, Curvature, and Characteristic Classes
                  = succeed "]" do
                    %a{:href => "https://www.springer.com/gp/book/9783319550824"} ISBN:978-3-319-55082-4
              %li
                %p
                  Thoan Do, Geoff Prince,
                  = succeed "," do
                    %em An intrinsic and exterior form of the Bianchi identities
                  %strong 14
                  01 (2017) 1750001 [
                  %a{:href => "https://doi.org/10.1142/S0219887817500013"}> doi:10.1142/S0219887817500013
                  ,
                  = succeed "]" do
                    %a{:href => "https://arxiv.org/abs/1501.01123"} arXiv:1501.01123
              %li
                %p
                  Ivo Terek Couto,
                  %em Cartan Formalism and some computations
                  [
                  %a{:href => "https://www.asc.ohio-state.edu/terekcouto.1/texts/cartan_formalism.pdf"}> pdf
                  ,
                  = succeed "]" do
                    %a.existingWikiWord{:href => "/nlab/files/Couto-CartanFormalism.pdf", :title => "pdf"} pdf
              %li
                %p
                  %a{:href => "https://cadabra.science"}> Cadabra
                  ,
                  %em
                    %a{:href => "https://cadabra.science/notebooks/structure_equations_and_bianchi.html"} Cartan structural equations and Bianchi identity
            %p
              Generalization to
              %a.existingWikiWord{:href => "/nlab/show/supergeometry"} supergeometry
              (motivated by
              = succeed "):" do
                %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Julius+Wess"}> Julius Wess
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Bruno+Zumino"} Bruno Zumino
                  = succeed "," do
                    %em Superspace formulation of supergravity
                  %strong 66
                  (1977) 361-364 [
                  %a{:href => "https://doi.org/10.1016/0370-2693(77)90015-6"}> doi:10.1016/0370-2693(77)90015-6
                  ]
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Richard+Grimm"}> Richard Grimm
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Julius+Wess"} Julius Wess
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Bruno+Zumino"} Bruno Zumino
                  = succeed "," do
                    %em A complete solution of the Bianchi identities in superspace with supergravity constraints
                  %strong 152
                  (1979) 255-265 [
                  %a{:href => "https://doi.org/10.1016/0550-3213(79)90102-0"}> doi:10.1016/0550-3213(79)90102-0
                  ]
              %li#CastellaniDAuriaFre
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Leonardo+Castellani"}> Leonardo Castellani
                  ,
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Riccardo+D%27Auria"} Riccardo D'Auria
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Pietro+Fr%C3%A9"} Pietro Fré
                  = succeed "," do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Supergravity+and+Superstrings+-+A+Geometric+Perspective"} Supergravity and Superstrings - A Geometric Perspective
                  = succeed "," do
                    %a{:href => "https://doi.org/10.1142/0224"} doi:10.1142/0224
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/files/CDF91-TOC.pdf", :title => "pdf"} pdf
                  = succeed "]" do
                    %a.existingWikiWord{:href => "/nlab/files/CastellaniDAuriaFre-ChIII3.pdf", :title => "pdf"} pdf
