                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
