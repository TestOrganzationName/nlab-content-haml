              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
          .num_example
            %h6#example Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/semisimple+Lie+group"} semisimple
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo =
                    %mi T
                    %mo ↪
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H = T\hookrightarrow G
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/maximal+torus"} maximal torus
              %a.maruku-ref{:href => "#MCFormAsFiberOfDifferentialModuli"}
              plays a central role in the stacky formulation of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/orbit+method"} orbit method
              = succeed "." do
                %em
                  %a{:href => "orbit+method#ThetaAsHomotopyFiberOfJ"} this proposition
          %p We need this and one more ingredient for synthetically formalizing Cartan connections:
          #FactorizationOfConnection.num_remark
            %h6#remark_4 Remark
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔻
                      %mi x
                      %mi d
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}^d_x \hookrightarrow X
              be the first-oder
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
              of a point in a manifold
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/differential+p-form"} differential p-form
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ≥
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} p \geq 2
              vanishes on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi 𝔻
                        %mi d
                    %annotation{:encoding => "application/x-tex"} \mathbb{D}^d
              %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
              restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔻
                      %mi d
                  %annotation{:encoding => "application/x-tex"} \mathbb{D}^d
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
              and hence is indeed gauge equivalent to the trivial connection. In particular every map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi 𝔻
                      %mi x
                      %mi d
                    %mo ⟶
                    %msup
                      %mi Ω
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %msub
                      %mi G
                      %mi conn
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{D}^d_x \longrightarrow \Omega^1(-,\mathfrak{g})//H \to \mathbf{B}G_{conn}
            %p has a null-homotopy, hence fits into a square of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi 𝔻
                              %mi x
                              %mi d
                          %mtd
                            %mover
                              %mo ⟶
                              %mrow
                                %msub
                                  %mo ∇
                                  %mi H
                          %mtd
                            %msup
                              %mi Ω
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo ,
                            %mi 𝔤
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} /
                            %mo{:stretchy => "false"} /
                            %mi H
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ⇙
                              %mpadded{:width => "0"}
                                %mo ≃
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mstyle{:mathvariant => "bold"}
                                  %mi J
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %msub
                              %mi G
                              %mi conn
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{D}^d_x
                    \&amp;\stackrel{\nabla_H}{\longrightarrow}&amp;
                    \\Omega^1(-,\mathfrak{g})//H
                    \\\
                    \\downarrow &amp;\swArrow_{\mathrlap{\simeq}}&amp; \downarrow^{\mathrlap{\mathbf{J}}}
                    \\\
                    \\ast &amp;\longrightarrow&amp; \mathbf{B}G_{conn}
                    }
                    \\,.
            %p
              It follows by prop.
              %a.maruku-ref{:href => "#MCFormAsFiberOfDifferentialModuli"}
              that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
