                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\nabla_H|_{\mathbb{D}^d_x}
                    \\;\colon\;
                    \\mathbb{D}^d_x
                    \\stackrel{}{\longrightarrow}
                    G/H
                    \\stackrel{\theta/H}{\longrightarrow}
                    \\Omega^1(-,\mathfrak{g})//H
                    \\,.
          %p
            The following is a synthetic formulation of Cartan connections, def.
            = succeed "." do
              %a.maruku-ref{:href => "#Traditional"}
          #CartanConnectionSynthetically.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/smooth+set"} smooth set
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo ↪
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (H \hookrightarrow G)
                \-Cartan connection
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
            %ol
              %li
                %p
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi G
                        %annotation{:encoding => "application/x-tex"} G
                  %a.existingWikiWord{:href => "/nlab/show/principal+connection"} principal connection
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ∇
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo ⟶
                        %mstyle{:mathvariant => "bold"}
                          %mi B
                        %msub
                          %mi G
                          %mi conn
                      %annotation{:encoding => "application/x-tex"}
                        \\nabla \colon X \longrightarrow \mathbf{B}G_{conn}
              %li
                %p
                  equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/reduction+of+structure+groups"} reduction of structure groups
                  given by a lift through
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mstyle{:mathvariant => "bold"}
                          %mi J
                      %annotation{:encoding => "application/x-tex"} \mathbf{J}
                  in prop.
                  %a.maruku-ref{:href => "#MCFormAsFiberOfDifferentialModuli"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %msup
                                  %mi Ω
                                  %mn 1
                                %mo{:stretchy => "false"} (
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo ,
                                %mi 𝔤
                                %mo{:stretchy => "false"} )
                                %mo{:stretchy => "false"} /
                                %mo{:stretchy => "false"} /
                                %mi H
                            %mtr
                              %mtd
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %msup
                                        %mo ∇
                                        %mi H
                                %mo ↗
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mstyle{:mathvariant => "bold"}
                                      %mi J
                            %mtr
                              %mtd
                                %mi X
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mo ∇
                              %mtd
                                %mstyle{:mathvariant => "bold"}
                                  %mi B
                                %msub
                                  %mi G
                                  %mi conn
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \&amp;&amp; \Omega^1(-,\mathfrak{g})//H
                        \\\
                        \&amp; {}^{\mathllap{\nabla^H}}\nearrow &amp; \downarrow^{\mathrlap{\mathbf{J}}}
                        \\\
                        X &amp;\stackrel{\nabla}{\longrightarrow}&amp; \mathbf{B}G_{conn}
                        }
              %li
                %p
                  such that over each first-order
                  %a.existingWikiWord{:href => "/nlab/show/infinitesimal+neighbourhood"} infinitesimal neighbourhood
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi 𝔻
                          %mi x
                          %mi d
                        %mo ↪
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \mathbb{D}^d_x \hookrightarrow X
                  any induced factorization, via remark
                  = succeed "," do
                    %a.maruku-ref{:href => "#FactorizationOfConnection"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi 𝔻
                          %mi x
                          %mi d
                        %mover
                          %mo ⟶
                          %mrow
                        %mi G
                        %mo{:stretchy => "false"} /
                        %mi H
                      %annotation{:encoding => "application/x-tex"}
                        \\mathbb{D}^d_x \stackrel{}{\longrightarrow} G/H
                %p
                  is
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/formally+%C3%A9tale+morphism"} formally étale
          %h2#weaker_definitions_pre_and_semicartan_geometry Weaker definitions (pre- and semi-Cartan geometry)
