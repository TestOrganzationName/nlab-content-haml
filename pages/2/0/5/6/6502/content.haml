                      %mi H
                  %annotation{:encoding => "application/x-tex"} \nabla_H
              here factors through the
              %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+form"} Maurer-Cartan form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∇
                      %mi H
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msubsup
                          %mi 𝔻
                          %mi x
                          %mi d
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi 𝔻
                      %mi x
                      %mi d
                    %mover
                      %mo ⟶
                      %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mover
                      %mo ⟶
                      %mrow
                        %mi θ
                        %mo{:stretchy => "false"} /
                        %mi H
                    %msup
                      %mi Ω
                      %mn 1
