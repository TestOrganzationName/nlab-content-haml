          #2CategoryOfModelCategories.num_example
            %h6#definition_3 Definition
            %p
              %strong
                (the
                %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
                of
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            %p Write
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ModCat
                      %annotation{:encoding => "application/x-tex"} ModCat
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
                  whose
                  %a.existingWikiWord{:href => "/nlab/show/objects"} objects
                  are
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
                  %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
                  are
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %a.existingWikiWord{:href => "/nlab/show/functors"} functors
                  of
                  %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunctions"} Quillen adjunctions
                  and
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
                  are
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CombModCat
                        %mo ⊂
                        %mi ModCat
                      %annotation{:encoding => "application/x-tex"} CombModCat \subset ModCat
                  for the
                  %a.existingWikiWord{:href => "/nlab/show/full+sub-2-category"} full sub-2-category
                  on the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
          #LocalPresentationOfCombinatorialModelCategories.num_remark
            %h6#remark Remark
            %p
              %strong (local presentation of combinatorial model categories)
            %p
              By
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Dugger%27s+theorem"} Dugger's theorem
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ∈
                    %mi CombModCat
                  %annotation{:encoding => "application/x-tex"} \mathcal{C} \in CombModCat
              a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              and a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi 𝒮
                      %mi op
                    %mo ,
                    %mi sSet
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi proj
                        %mo ,
                        %mi loc
                    %mover
                      %mo ⟶
                      %mrow
                        %msub
                          %mo ≃
                          %mi Qu
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{C}^p
                    \\;\coloneqq\;
                    [\mathcal{S}^{op}, sSet]_{proj,loc}
                    \\overset{\simeq_{Qu}}{\longrightarrow}
                    \\mathcal{C}
            %p
              from the local projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+sSet-enriched+presheaves"} model structure on sSet-enriched presheaves
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒮
                    %annotation{:encoding => "application/x-tex"} \mathcal{S}
          #Homotopy2CategoryOf2CatOfCombinatorialModelCategories.num_theorem
            %h6#theorem Theorem
            %p
              %strong
                (the
                %a.existingWikiWord{:href => "/nlab/show/homotopy+2-category"} homotopy 2-category
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/2-localization"} 2-localization
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#2Localization"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CombModCat
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msup
                      %mi QuillenEquivalences
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %annotation{:encoding => "application/x-tex"}
                    CombModCat\big[QuillenEquivalences^{-1}\big]
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              of
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+categories"} combinatorial model categories
              (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#2CategoryOfModelCategories"}
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalences"} Quillen equivalences
              exists. Up to
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+2-categories"} equivalence of 2-categories
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CombModCat
                  %annotation{:encoding => "application/x-tex"} CombModCat
              and for any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                    %mo ∈
                    %mi CombModCat
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}, \mathcal{D} \in CombModCat
              its
              %a.existingWikiWord{:href => "/nlab/show/hom-category"} hom-category
              is the
              %a.existingWikiWord{:href => "/nlab/show/localization+of+categories"} localization of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CombModCat
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msup
                      %mi QuillenEquivalences
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo ,
                    %mi 𝒟
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ModCat
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi 𝒞
                      %mi p
                    %mo ,
                    %msup
                      %mi 𝒟
                      %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mo{:stretchy => "false"} {
                    %mi QuillenHomotopies
                    %msup
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %annotation{:encoding => "application/x-tex"}
                    CombModCat\big[QuillenEquivalences^{-1}\big](\mathcal{C}, \mathcal{D})
                    \\;\simeq\;
                    ModCat( \mathcal{C}^p, \mathcal{D}^p )\big[\{QuillenHomotopies\}^{-1}\big]
            %p
              of the category of
              %a.existingWikiWord{:href => "/nlab/show/left+Quillen+functors"} left Quillen functors
              and
              %a.existingWikiWord{:href => "/nlab/show/natural+transformations"} natural transformations
              between local presentations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒞
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}^p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒟
                      %mi p
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}^p
