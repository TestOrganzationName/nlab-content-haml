            %h6#definition_2 Definition
            %p
              %strong (localization of a 2-category)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
              be a
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⊂
                    %mn 1
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W \subset 1Mor(\mathcal{C})
              be a sub-
              %a.existingWikiWord{:href => "/nlab/show/class"} class
              of its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/1-morphisms"} 1-morphisms
            %p
              Then
              %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
              the
              %em 2-localization
              x is, if it exists,
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi W
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}]
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                        %mover
                          %mo ⟶
                          %mi γ
                        %mi 𝒞
                        %mo{:stretchy => "false"} [
                        %msup
                          %mi W
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathcal{C} \overset{\gamma}{\longrightarrow} \mathcal{C}[W^{-1}]
            %p such that
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi γ
                      %annotation{:encoding => "application/x-tex"} \gamma
                  sends all elements of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                      %annotation{:encoding => "application/x-tex"} W
                  to an
                  %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+2-category"} equivalence in the 2-category
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒞
                          %mo{:stretchy => "false"} [
                          %msup
                            %mi W
                            %mrow
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mn 1
                          %mo{:stretchy => "false"} ]
                        %annotation{:encoding => "application/x-tex"} \mathcal{C}[W^{-1}]
              %li
                %p
