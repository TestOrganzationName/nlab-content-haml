              = succeed ")" do
                %a.maruku-ref{:href => "#LocalPresentationOfCombinatorialModelCategories"}
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              that on
              %a.existingWikiWord{:href => "/nlab/show/cofibrant+objects"} cofibrant objects
              have components that are
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalences"} weak equivalences
              (“Quillen homotopies”).
          %p
            This is the statement of
            = succeed "." do
              %a{:href => "#Renaudin06"} Renaudin 06, theorem 2.3.2
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            a
            %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            write
          %ol
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒞
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}_0
                for the 1-category obtained by discarding all
                = succeed ";" do
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi π
                        %mn 0
                        %mi iso
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_0^{iso}(\mathcal{C})
                for the
                %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
                obtained by identifying isomorphic
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/2-morphisms"} 2-morphisms
          .num_prop
            %h6#proposition Proposition
            %p The composite 1-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi CombModCat
                      %mn 0
                    %mo ⟶
                    %msubsup
                      %mi π
                      %mn 0
                      %mi iso
                    %mo{:stretchy => "false"} (
                    %mi CombModCat
                    %mo{:stretchy => "false"} )
                    %mover
