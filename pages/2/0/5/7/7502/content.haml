                    %mo ,
                    %msub
                      %mi I
                      %mn 2
                    %mo ⊂
                    %mi Mor
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I_1, I_2\subset Mor(\mathcal{C})
              be two
              %a.existingWikiWord{:href => "/nlab/show/classes"} classes
              of its morphisms.
            %p
              Then under
              %a.existingWikiWord{:href => "/nlab/show/pushout+product"} pushout product
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mo ⊗
