                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} }
                      %mrow
                        %mo{:maxsize => "2.4em", :minsize => "2.4em"} /
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi x
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi g
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mspace{:width => "thinmathspace"}
                        %mo ∼
                        %mspace{:width => "thinmathspace"}
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mspace{:width => "thinmathspace"}
                        %mi y
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                  %annotation{:encoding => "application/x-tex"}
                    f \,\widehat{\times}\, g
                    \\;\;
                    \\simeq
                    \\;\;
                    \\big\{
                    (x,y'),
                    \\,
                    (x',y)
                    \\big\}_{
                    \\bigg/
                    \\Big(
                    \\big(x,\,g(y)\big) \,\sim\, \big(f(x),\,y\big)
                    \\Big)
                    }
            %p (where each variable ranges over the set denoted by the corresponding capital symbol).
            %p
              Moreover, if we denote the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+class"} equivalence class
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x,y')
              by
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ,
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [x,y']
              %a.existingWikiWord{:href => "/nlab/show/coprojections"} coprojections
              into the pushout product are given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo ′
                            %mo ×
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %msub
                                  %mi q
                                  %mi l
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi f
                            %mspace{:width => "thinmathspace"}
                            %mover
                              %mo ×
                              %mo ^
                            %mspace{:width => "thinmathspace"}
                            %mi g
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ′
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi y
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi x
                            %mo ′
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi y
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                            %mo ×
                            %mi Y
                            %mo ′
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                                %msub
                                  %mi q
                                  %mi r
                                %mspace{:width => "thickmathspace"}
                                %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi f
                            %mspace{:width => "thinmathspace"}
                            %mover
                              %mo ×
                              %mo ^
                            %mspace{:width => "thinmathspace"}
                            %mi g
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi y
                            %mo ′
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi x
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi y
                            %mo ′
                            %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X' \times Y
                    \&amp;\xrightarrow{\;\; q_l\;\;}&amp;
                    f \,\widehat{\times}\, g
                    \\\
                    (x',\,y) &amp;\mapsto&amp; [x',\, y]
                    }
                    \\;\;\;\;\;\;\;\;\;
                    \\text{and}
                    \\;\;\;\;\;\;\;\;\;
                    \\array{
                    X \times Y'
                    \&amp;\xrightarrow{\;\; q_r\;\;}&amp;
                    f \,\widehat{\times}\, g
                    \\\
                    (x,\,y') &amp;\mapsto&amp; [x,\, y']
                    }
            %p and the pushout-product map itself (the dashed arrow) is given as follows:
            #eq:ThePushoutProductMapForSets.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi f
                            %mspace{:width => "thinmathspace"}
                            %mover
                              %mo ×
                              %mo ^
                            %mspace{:width => "thinmathspace"}
                            %mi g
                          %mtd
                            %mover
                              %mo →
                              %mphantom
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mo −
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mtd
                            %mi X
                            %mo ′
                            %mo ×
                            %mi Y
                            %mo ′
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi x
                            %mo ′
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi y
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi x
                            %mo ′
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi g
                            %mo{:stretchy => "false"} (
                            %mi y
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mi x
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi y
                            %mo ′
                            %mo{:stretchy => "false"} ]
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi x
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mspace{:width => "thinmathspace"}
                            %mi y
                            %mo ′
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mpadded{:width => "0"}
                              %mrow
                                %mspace{:width => "thinmathspace"}
                                %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f \,\widehat{\times}\, g
                    \&amp;\xrightarrow{\phantom{---}}&amp;
                    X' \times Y'
                    \\\
                    [x',\, y] &amp;\mapsto&amp; \big(x',\, g(y)\big)
                    \\\
                    [x,\, y'] &amp;\mapsto&amp; \big(f(x),\, y' \big)
                    \\mathrlap{\,.}
                    }
            %p
              More informatively, the
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              of the pushout-product map over any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo ,
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi X
                    %mo ′
                    %mo ×
                    %mi Y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} (x',y') \,\in\, X' \times Y'
              look as follows:
            #eq:FibersOfPushoutProductOfMapsOfSets.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi f
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mo ×
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ′
                        %mo ,
                        %mi y
                        %mo ′
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mrow
                        %mtable
                          %mtr
                            %mtd
                              %mo *
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mo{:stretchy => "false"} (
                              %mi x
                              %mo ′
                              %mo ,
                              %mi y
                              %mo ′
                              %mo{:stretchy => "false"} )
                              %mspace{:width => "thickmathspace"}
                              %mo ∈
                              %mspace{:width => "thickmathspace"}
                              %mi im
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                              %mo ×
                              %mi im
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mi f
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mo{:stretchy => "false"} {
                              %mi x
                              %mo ′
                              %mo{:stretchy => "false"} }
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi y
                              %mo ′
                              %mspace{:width => "thickmathspace"}
                              %mo ∈
                              %mspace{:width => "thickmathspace"}
                              %mi Y
                              %mo ′
                              %mo ∖
                              %mi im
                              %mo{:stretchy => "false"} (
                              %mi g
                              %mo{:stretchy => "false"} )
                          %mtr
                            %mtd
                              %msup
                                %mi g
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                              %mo{:stretchy => "false"} {
                              %mi y
                              %mo ′
                              %mo{:stretchy => "false"} }
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mtd
                              %mo{:stretchy => "false"} |
                            %mtd
                              %mi x
                              %mo ′
                              %mspace{:width => "thickmathspace"}
                              %mo ∈
                              %mspace{:width => "thickmathspace"}
                              %mi X
                              %mo ′
                              %mo ∖
                              %mi im
                              %mo{:stretchy => "false"} (
                              %mi f
                              %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    f \,\widehat{\times}\, g
                    \\big)_{(x',y')}
                    \\;\;
                    \=
                    \\;\;
                    \\left\{
                    \\array{
                    \\ast &amp;\vert&amp; (x',y') \;\in\; im(f) \times im(g)
                    \\\
                    f^{-1}\big(\{x'\}\big)  &amp;\vert&amp; y' \;\in\; Y' \setminus im(g)
                    \\\
                    g^{-1}\big(\{y'\}\big)  &amp;\vert&amp; x' \;\in\; X' \setminus im(f)
                    }
                    \\right.
            %p where
            %ul
              %li
                %p
                  “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo *
                      %annotation{:encoding => "application/x-tex"} \ast
                  ” denotes the
                  %a.existingWikiWord{:href => "/nlab/show/singleton+set"} singleton set
              %li
                %p
                  “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} (-)^{-1}
                  ” denotes forming
                  %a.existingWikiWord{:href => "/nlab/show/preimages"} preimages
              %li
                %p
                  “
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mo ∖
                      %annotation{:encoding => "application/x-tex"} \setminus
                  ” denotes forming
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/complements"} complements
            %p
          .proof
            %h6 Proof
            %p
              We discuss in more detail how to obtain the fibers
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:FibersOfPushoutProductOfMapsOfSets"} (2)
            %p
              To see the first case: By the assumption that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} x' \,\in\, im(f)
              we find
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mn 1
                    %mo ∈
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} x_1 \in f^{-1}\big(\{x'\}\big)
              and hence by
              %a.maruku-eqref{:href => "#eq:ThePushoutProductMapForSets"} (1)
              we find
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mo ×
                        %mo ^
                      %mspace{:width => "thinmathspace"}
                      %mi g
                      %msub
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo ′
                          %mo ,
                          %mi y
                          %mo ′
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} [x_1,y'] \,\in\, \big(f \,\widehat{\times}\, g\big)_{(x',y')}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi im
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y' \,\in\, im(g)
              there is also
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} }
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} y \in g^{-1}\big(\{y'\}\big)
              and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi y
                    %mo ′
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mi f
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi y
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %mi x
                    %mo ′
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi y
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big[x_1,\, y'\big]
                    \\,=\,
                    \\big[x_1,\, g(y)\big]
                    \\,=\,
                    \\big[f(x_1),\, y\big]
                    \\,=\,
                    \\big[x',\, y\big]
                    \\,.
            %p
              This shows that all elements of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [x,y']
              in the fiber are in fact equal, and also equal to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi x
                      %mo ′
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [x', y]
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
            %p
              To see the second case: Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y'
              is not in the image of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %a.maruku-eqref{:href => "#eq:ThePushoutProductMapForSets"} (1)
              the elements in the fiber can only be of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [x,y']
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %mo{:stretchy => "false"} {
                      %mi x
                      %mo ′
                      %mo{:stretchy => "false"} }
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %annotation{:encoding => "application/x-tex"} x \in f^{-1}\big(\{x'\}\big)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} y'
              is not in the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              – and hence they are all distinct.
            %p
              The third case works the same way, under swapping
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ↔
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X \leftrightarrow Y
          %p
          #InjectionsOfSets.num_remark
            %h6 Example
            %p
              %strong (Pushout-product of injections of sets)
              %br/
              In the special case that both maps are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injections"} injections
              %a.maruku-eqref{:href => "#eq:FibersOfPushoutProductOfMapsOfSets"} (2)
              are all
              %a.existingWikiWord{:href => "/nlab/show/%28-1%29-truncated"} (-1)-truncated
              (either
              %a.existingWikiWord{:href => "/nlab/show/empty+sets"} empty sets
              or
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/singleton+sets"} singleton sets
            %p
              This shows that the pushout-product map of two
              %a.existingWikiWord{:href => "/nlab/show/injections"} injections
              of
              %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
              is itself an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/injection"} injection
              = succeed "-subsets" do
                %a.existingWikiWord{:href => "/nlab/show/interval"} interval
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/plane"} plane
            %p
              %img{:src => "/nlab/files/PushoutProductOfInjections-230425.jpg", :width => "300"}/
            %p
          %h3#in_topological_spaces In Topological Spaces
          #PushoutProductOfSpheresInclusionsIntoDisks.num_example
            %h6#example Example
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mrow
                        %mi n
                        %mo −
                        %mn 1
                    %mo ↪
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"}
                    i_n \;\colon\; S^{n-1}\hookrightarrow D^n
            %p
              be the canonical
              %a.existingWikiWord{:href => "/nlab/show/sphere"} sphere
              inclusions in
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              (the generating cofibrations of the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} cartesian
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/topological+product+space"} product of topological spaces
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mo ×
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ≃
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i_{n_1} \,\widehat{\times}\, i_{n_2} \simeq i_{n_1 + n_2}
                    \\,.
            %p Let moreover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi n
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %mi id
                    %mo ,
                    %msub
                      %mi δ
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi D
                      %mi n
                    %mo ↪
                    %msup
                      %mi D
                      %mi n
                    %mo ×
                    %mi I
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    j_n \coloneqq (id,\delta_0) \;\colon\; D^n \hookrightarrow D^n \times I
                    \\,.
            %p Then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mo ×
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi j
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ≃
                    %msub
                      %mi j
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i_{n_1} \,\widehat{\times}\, j_{n_2} \simeq j_{n_1 + n_2}
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              To see this, it is profitable to model
              %a.existingWikiWord{:href => "/nlab/show/n-disks"} n-disks
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            %p To see the idea of the proof, consider the situation in low dimensions, where one readily sees that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mo ×
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi i
                      %mn 1
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo ∪
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo □
                  %annotation{:encoding => "application/x-tex"}
                    i_1 \,\widehat{\times}\, i_1
                    \\;\colon\;
                    (\; = \;\cup\; \vert\vert\;)
                    \\hookrightarrow
                    \\Box
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mo ×
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi j
                      %mn 0
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo ∪
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} |
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mo □
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i_1 \,\widehat{\times}\, j_0
                    \\;\colon\;
                    (\; = \;\cup\; \vert \; )
                    \\hookrightarrow
                    \\Box
                    \\,.
            %p
              Generally,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi n
                  %annotation{:encoding => "application/x-tex"} D^n
              may be represented as the space of
              = succeed "-tuples" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [0,1]
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
              as the suspace of tuples for which at least one of the coordinates is equal to 0 or to 1.
            %p
              Accordingly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times D^{n_2}
              is the spaces of
              = succeed "-tuples," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 1
                      %mo +
                      %msub
                        %mi n
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n_1+n_2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} n_1
              coordinates is equal to 0 or 1, and hence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mo ∪
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^{n_1}
                    \\times
                    D^{n_2}
                    \\;\cup\;
                    D^{n_1}
                    \\times
                    S^{n_2}
                    \\;\;\simeq\;\;
                    S^{n_1 + n_2}
                    \\,.
            %p
              And of course it is clear that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ×
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ≃
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                          %mo +
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} D^{n_1} \times D^{n_2} \simeq D^{n_1 + n_2}
            %p
              For the second, use that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ×
                    %mi I
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times D^{n_2} \times I
              is contractible to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times D^{n_2}
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ×
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                      %mo ×
                      %mi I
                    %annotation{:encoding => "application/x-tex"} D^{n_1} \times D^{n_2} \times I
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi D
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} S^{n_1} \times D^{n_2}
              is a subspace of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 1
                      %mo ×
                      %msup
                        %mi D
                        %mrow
                          %msub
                            %mi n
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} D^{n_1} \times D^{n_2}
          .num_remark
            %h6#remark Remark
            %p
              The relations in example
              %a.maruku-ref{:href => "#PushoutProductOfSpheresInclusionsIntoDisks"}
              are the key in proving that the
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
              (on
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated topological spaces
              %a.existingWikiWord{:href => "/nlab/show/enriched+model+category"} enriched model category
              over itself. See there at
              %em
                %a{:href => "classical+model+structure+on+topological+spaces#TopologicalEnrichment"} topological enrichment
              for more.
          %h3#PushoutApplication Pushout application of natural transformations
          %p
            The following example exploits the generality of allowing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℰ
                    %mn 1
                  %mo ,
                  %msub
                    %mi ℰ
                    %mn 2
                  %mo ,
                  %msub
                    %mi ℰ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} \mathcal{E}_1,\mathcal{E}_2,\mathcal{E}_3
            to differ in the functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi ℰ
                      %mn 1
                    %mo ×
                    %msub
                      %mi ℰ
                      %mn 2
                    %mo →
                    %msub
                      %mi ℰ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \otimes \colon \mathcal{E}_1 \times \mathcal{E}_2 \to \mathcal{E}_3
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo ,
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{C},\mathcal{D}
            be
            %a.existingWikiWord{:href => "/nlab/show/categories"} categories
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{D}
            has
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
            %a.existingWikiWord{:href => "/nlab/show/evaluation"} evaluation
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ev
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi 𝒟
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi 𝒞
                  %mo →
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} ev \colon [\mathcal{C},\mathcal{D}] \times \mathcal{C} \to \mathcal{D}
            sending a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            and object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(d)
          %p
            The induced pushout product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ev
                    %mo ^
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} [
                  %mi 𝒞
                  %mo ,
                  %mi 𝒟
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %mo ×
                  %msup
                    %mi 𝒞
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                  %mo →
                  %msup
                    %mi 𝒟
                    %mstyle{:mathvariant => "bold"}
                      %mn 2
                %annotation{:encoding => "application/x-tex"} \widehat{ev} \colon [\mathcal{C},\mathcal{D}]^{\mathbf{2}} \times \mathcal{C}^{\mathbf{2}} \to \mathcal{D}^{\mathbf{2}}
            takes a
            %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            and a morphism of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            and outputs a morphism of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒟
                  %annotation{:encoding => "application/x-tex"} \mathcal{D}
          .num_defn
            %h6#CylinderPushoutApplication Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/cylinder+functor"} cylinder functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℰ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} C \colon \mathcal{E} \to \mathcal{E}
              with natural transformations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 0
                      %mo ,
                      %msub
                        %mi e
                        %mn 1
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi Id
                        %mi ℰ
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} e_0,e_1 \colon Id_{\mathcal{E}} \to C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi k
                  %annotation{:encoding => "application/x-tex"} e_k
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f \colon A \to B
              is the map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %msub
                      %mo ⨿
                      %mi A
                    %mi CA
                    %mover
                      %mo ⟶
                      %mrow
                        %mover
                          %mi ev
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mi k
                        %mo ,
                        %mi f
                        %mo{:stretchy => "false"} )
                    %mi CB
                  %annotation{:encoding => "application/x-tex"}
                    B \amalg_A CA \overset{\widehat{ev}(e_k,f)}{\longrightarrow} CB
            %p
              from the (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              \-oriented)
              %a.existingWikiWord{:href => "/nlab/show/mapping+cylinder"} mapping cylinder
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              to the cylinder on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          %p
            Now suppose additionally that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            has pullbacks. Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Cat
                    %mi adj
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi 𝒟
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Cat_adj(\mathcal{C},\mathcal{D})
            for the category whose objects are
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo :
                  %mi L
                  %mo ⊣
                  %mi R
                  %mo :
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} \mathcal{C} : L \dashv R : \mathcal{D}
            and whose morphisms are
            %a.existingWikiWord{:href => "/nlab/show/conjugate+transformations+of+adjoints"} conjugate transformations of adjoints
            (in the direction of the transformation of left adjoints).
          %p
            We have a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ev
                    %mi L
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi Cat
                    %mi adj
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi 𝒟
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi 𝒞
                  %mo →
                  %mi 𝒟
                %annotation{:encoding => "application/x-tex"} ev_L \colon Cat_adj(\mathcal{C},\mathcal{D}) \times \mathcal{C} \to \mathcal{D}
            which applies the left adjoint and a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ev
                    %mi R
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mo{:lspace => "0em", :rspace => "thinmathspace"} Cat
                    %mi adj
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo ,
                  %mi 𝒟
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ×
                  %mi 𝒟
                  %mo →
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} ev_R \colon \Cat_adj(\mathcal{C},\mathcal{D})^{op} \times \mathcal{D} \to \mathcal{C}
            which applies the right adjoint, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ev
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊣
                  %mi R
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ev_L(L \dashv R, -)
            is
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ev
                    %mi R
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo ⊣
                  %mi R
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} ev_R(L \dashv R, -)
            for every pair of adjoints
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo ⊣
                    %mi R
                  %annotation{:encoding => "application/x-tex"} L \dashv R
          %p
            Hence for any conjugate transformations
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn 1
                    %mo ⊣
                    %msub
                      %mi R
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi L
                      %mn 2
                    %mo ⊣
                    %msub
                      %mi R
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lambda, \rho) \colon (L_1 \dashv R_1) \to (L_2 \dashv R_2)
            %a.maruku-ref{:href => "#PushoutProductPullbackPowerAdjoint"}
            that the pushout product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %msub
                        %mi ev
                        %mi L
                    %mo ^
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi λ
                  %mo ,
                  %mi ρ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \widehat{ev_L}((\lambda, \rho),-)
            (which is the same as
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ev
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{ev}(\lambda,-)
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            to the
            %a.existingWikiWord{:href => "/nlab/show/pullback+power"} pullback power
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %msub
                          %mi ev
                          %mi R
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi λ
                    %mo ,
                    %mi ρ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{ev_R}((\lambda,\rho),-)
          .num_defn
            %h6#example_3 Example
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/cylinder+functor"} cylinder functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℰ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} C \colon \mathcal{E} \to \mathcal{E}
              with a right adjoint
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℰ
                      %mo →
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} P \colon \mathcal{E} \to \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mn 0
                    %mo ,
                    %msub
                      %mi e
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi Id
                      %mi ℰ
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} e_0,e_1 \colon Id_{\mathcal{E}} \to C
              make
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              into a functorial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cocylinder"} cocylinder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi k
                  %annotation{:encoding => "application/x-tex"} e_k
              from Example
              %a.maruku-ref{:href => "#CylinderPushoutApplication"}
              is then left adjoint to the pullback application of its conjugate, which sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi Y
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f : Y \to X
              to the map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mi Y
                    %mo →
                    %mi Y
                    %msub
                      %mo ×
                      %mi X
                    %mi P
                    %mi X
                  %annotation{:encoding => "application/x-tex"} P Y \to Y \times_X P X
              from the
              %a.existingWikiWord{:href => "/nlab/show/path+space"} path space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              to the
              %a.existingWikiWord{:href => "/nlab/show/mapping+path+space"} mapping path space
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
          %h3#general General
          %p
          #PushoutProductWithAnInitialMorphism.num_remark
            %h6 Example
            %p
              %strong (pushout-product with initial morphism is tensor product)
              %br/
              With respect to a
              %a.existingWikiWord{:href => "/nlab/show/bifunctor"} bifunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒞
                    %mo ×
                    %mi 𝒞
                    %mo ⟶
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"}
                    \\otimes
                    \\;\colon\;
                    \\mathcal{C} \times \mathcal{C}
                    \\longrightarrow
                    \\mathcal{C}
              which
              %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
              %a.existingWikiWord{:href => "/nlab/show/initial+objects"} initial objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∅
                  %annotation{:encoding => "application/x-tex"} \varnothing
              in, say, the first variable, the pushout-product with an
              %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∅
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \varnothing \to X
              is given by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} X \otimes (-)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo ∅
                    %mo →
                    %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mover
                      %mo ⊗
                      %mo ^
                    %mspace{:width => "thinmathspace"}
                    %mi g
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi id
                      %mi X
                    %mo ⊗
                    %mi g
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    \\varnothing \to X
                    \\big)
                    \\,\widehat{\otimes}\,
                    g
                    \\;\simeq\;
                    id_X
                    \\otimes
                    g
                    \\,.
            %p
              (Of course, in applications
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-)\otimes(-)
              is typically a
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
              %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
              which hence even
              %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves all colimits
              in each variable separately.)
            %p This is because the defining pushout diagram now looks like this:
            %svg{:height => "150.671pt", :version => "1.2", :viewbox => "0 0 284.452 150.671", :width => "284.452pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              %defs
                %g
                  %symbol{:id => "S9N3wm4OAKV4RahSTry2Sn6SN34=-glyph0-0", :overflow => "visible"}
                    %path{:d => "", :style => "stroke:none;"}
                  %symbol{:id => "S9N3wm4OAKV4RahSTry2Sn6SN34=-glyph0-1", :overflow => "visible"}
