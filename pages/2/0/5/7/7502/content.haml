                      %mi g
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mo ⊗
                        %mo ^
                      %mspace{:width => "thinmathspace"}
                      %mi h
                      %mo ≅
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mo ⊗
                        %mo ^
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %mi g
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mo ⊗
                        %mo ^
                      %mspace{:width => "thinmathspace"}
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (f \,\widehat{\otimes}\, g) \,\widehat{\otimes}\, h \cong f \,\widehat{\otimes}\, (g \,\widehat{\otimes}\, h)
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
