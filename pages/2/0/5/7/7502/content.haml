                      %mi ℰ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_1,\mathcal{E}_2,\mathcal{E}_3
              be categories such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℰ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}_3
              has pushouts and let
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ⊗
                      %mo{:lspace => "verythinmathspace"} :
