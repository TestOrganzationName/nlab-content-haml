            %p
              The pushout product defines a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ⊗
                      %mo ^
                    %mo{:lspace => "verythinmathspace"} :
                    %msubsup
                      %mi ℰ
                      %mn 1
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %mo ×
                    %msubsup
                      %mi ℰ
                      %mn 2
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %mo →
                    %msubsup
                      %mi ℰ
                      %mn 3
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                  %annotation{:encoding => "application/x-tex"} {\widehat{\otimes}} \colon \mathcal{E}_1^{\mathbf{2}} \times \mathcal{E}_2^{\mathbf{2}} \to \mathcal{E}_3^{\mathbf{2}}
              on
              %a.existingWikiWord{:href => "/nlab/show/arrow+categories"} arrow categories
              with the evident functorial action.
          %h2#Properties Properties
          %p
            The pushout product associated to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                  %mo{:lspace => "verythinmathspace"} :
                  %msub
                    %mi ℰ
                    %mn 1
                  %mo ×
                  %msub
                    %mi ℰ
                    %mn 2
                  %mo →
                  %msub
                    %mi ℰ
                    %mn 3
                %annotation{:encoding => "application/x-tex"} {\otimes} \colon \mathcal{E}_1 \times \mathcal{E}_2 \to \mathcal{E}_3
            inherits various properties from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⊗
                %annotation{:encoding => "application/x-tex"} \otimes
            (see
            = succeed "):" do
              %a{:href => "#RiehlVerity14"} Riehl &amp; Verity (2014)
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be a category with pushouts and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⊗
                    %mo{:lspace => "verythinmathspace"} :
                    %mi ℰ
                    %mo ×
                    %mi ℰ
                    %mo →
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \otimes \colon \mathcal{E} \times \mathcal{E} \to \mathcal{E}
              be a functor equipped with a natural isomorphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ⊗
                      %mi B
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi C
                      %mo ≅
                      %mi A
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ⊗
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (A \otimes B) \otimes C \cong A \otimes (B \otimes C)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mspace{:width => "thinmathspace"}
                      %mover
                        %mo ⊗
                        %mo ^
