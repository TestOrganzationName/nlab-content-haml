                %a{:href => "http://www.math.uiuc.edu/K-theory/0761/THESE.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://faculty.math.illinois.edu/K-theory/0761"} K:0761
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Ayoub"}> Joseph Ayoub
                ,
                = succeed "," do
                  %em Les six opérations de Grothendieck et le formalisme des cycles évanescents dans le monde motivique (I)
                %strong 314
                (2007) &amp;lbrack;
                %a{:href => "http://www.numdam.org/issues/AST_2007__314__R1_0"}> numdam:AST_2007__314__R1_0
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joseph+Ayoub"}> Joseph Ayoub
                ,
                = succeed "," do
                  %em Les six opérations de Grothendieck et le formalisme des cycles évanescents dans le monde motivique (II)
                %strong 315
                (2007) &amp;lbrack;
                %a{:href => "http://www.numdam.org/issues/AST_2007__315__1_0"}> numdam:AST_2007__315__1_0
                \&amp;rbrack;
            %li#CisinskiDeglise09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fr%C3%A9d%C3%A9ric+D%C3%A9glise"} Frédéric Déglise
                = succeed "," do
                  %em Triangulated categories of mixed motives
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/0912.2110"} arXiv:0912.2110
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/978-3-030-33242-6"} doi:10.1007/978-3-030-33242-6
          %p
            and in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/rigid+analytic+geometry"} rigid analytic geometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Joseph+Ayoub"}> Joseph Ayoub
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Martin+Gallauer"} Martin Gallauer
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Vezzani"} Alberto Vezzani
              = succeed "," do
                %em The six-functor formalism for rigid analytic motives
              %strong 10
              (2022) E61 &amp;lbrack;
              %a{:href => "https://doi.org/10.1017/fms.2022.55"}> doi:10.1017/fms.2022.55
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/2010.15004"} arXiv:2010.15004
          %p
            Enhancement to
            = succeed ":" do
