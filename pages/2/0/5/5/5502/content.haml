              = succeed "," do
                %a{:href => "https://digitalcollections.wesleyan.edu/object/ir%3A3269"} ir:3269
              = succeed "&rbrack;" do
                %a.existingWikiWord{:href => "/nlab/files/Riley-BunchedHoTT.pdf", :title => "pdf"} pdf
          %p following a suggestion in
