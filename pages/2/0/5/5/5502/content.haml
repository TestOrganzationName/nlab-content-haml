                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1112/S0010437X16007375"} doi:10.1112/S0010437X16007375
          %p Lecture notes:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Gallauer"}> Martin Gallauer
                ,
                = succeed "," do
                  %em An introduction to six-functor formalism
                = succeed "," do
