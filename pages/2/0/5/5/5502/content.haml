            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-categories"} stable (infinity,1)-categories
          %ul
            %li
              Yifeng Liu, Weizhe Zheng:
              = succeed "," do
                %em Enhanced six operations and base change theorem for Artin stacks
              = succeed "." do
                %a{:href => "http://arxiv.org/abs/1211.5948"} arXiv
          %p
