              = succeed "," do
                %a{:href => "http://www.math.uchicago.edu/~mitya/langlands/Bernstein/Bernstein-dmod.ps"} ps
              = succeed ")" do
                %a{:href => "http://www.math.uchicago.edu/~mitya/langlands/Bernstein/Bernstein-dmod.dvi"} dvi
