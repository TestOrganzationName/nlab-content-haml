                %a{:href => "https://www.uni-muenster.de/IVV5WS/WebHop/user/nikolaus/Papers/sheaves-on-manifolds.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/KrauseNikolaus-SheavesOnManifolds.pdf", :title => "pdf"} pdf
          %p
            An
            %a.existingWikiWord{:href => "/nlab/show/enhanced+triangulated+category"} enhanced
            version of the six operations formalism for
            %a.existingWikiWord{:href => "/nlab/show/etale+cohomology"} etale cohomology
            of (
            %a.existingWikiWord{:href => "/nlab/show/infinity-stack"}> higher
