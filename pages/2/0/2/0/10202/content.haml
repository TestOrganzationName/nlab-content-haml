                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} A_n(n) + 1 = \phi(n) \leq A_n(\max\{3, n\}) = A_n(n).
          .num_prop
            %h6#proposition Proposition
            %p
              The
              %em graph
              of the Ackermann function
              %em is
              a primitive recursive relation.
          .proof
            %h6#proof_5 Proof
            %p
              The rough idea is to let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              bound the search for solutions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x, y)
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi A
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi z
                    %annotation{:encoding => "application/x-tex"} A_x(y) = z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ,
                    %mi y
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} x, y \gt 0
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi A
                      %mrow
                        %mi x
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A_x(y) = A_{x-1}(A_x(y-1)) = A_x(y')
              where
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ′
                      %mo ≔
                      %msub
                        %mi A
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y' \coloneqq A_x(y-1)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ′
                      %mo &lt;
                      %msub
                        %mi A
                        %mrow
                          %mi x
                          %mo −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi z
                    %annotation{:encoding => "application/x-tex"} y' \lt A_{x-1}(y') = z
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi y
                        %mn 0
                      %mo =
                      %mi y
                      %mo &lt;
                      %mi z
                    %annotation{:encoding => "application/x-tex"} y_0 = y \lt z
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo =
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi A
                      %mrow
                        %mi x
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi A
                      %mrow
                        %mi x
                        %mo −
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi …
                    %mo =
                    %msub
                      %mi A
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 2
                    %msub
                      %mi y
                      %mi x
                  %annotation{:encoding => "application/x-tex"} z = A_x(y_0) = A_{x-1}(y_1) = A_{x-2}(y_2) = \ldots = A_0(y_x) = 2 y_x
            %p
              with each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi y
                      %mi i
                  %annotation{:encoding => "application/x-tex"} y_i
              less than
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                    %annotation{:encoding => "application/x-tex"} z
              = succeed ".)" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi y
                        %mrow
                          %mi i
                          %mo +
                          %mn 1
                      %mo ≔
                      %msub
                        %mi A
                        %mrow
                          %mi x
                          %mo −
                          %mi i
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi y
                        %mi i
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} y_{i+1} \coloneqq A_{x-i}(y_i - 1)
            %p
              Thus, after disposing of some trivial low number cases, WLOG we may take
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo &gt;
                      %mn 4
                    %annotation{:encoding => "application/x-tex"} z \gt 4
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo &gt;
                    %mn 4
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (z \gt 4) \wedge (A_x(y) = z)
            %p is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &gt;
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo &gt;
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo &lt;
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %msub
                      %mo ∃
                      %mrow
                        %msub
                          %mi y
                          %mn 0
                        %mo ,
                        %msub
                          %mi y
                          %mn 1
                        %mo ,
                        %mi …
                        %msub
                          %mi y
                          %mi x
                        %mo &lt;
                        %mi z
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo =
                    %msub
                      %mi y
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∀
                      %mrow
                        %mi i
                        %mo &lt;
                        %mi x
                    %msub
                      %mi y
                      %mrow
                        %mi i
                        %mo +
                        %mn 1
                    %mo =
                    %msub
                      %mi A
                      %mrow
                        %mi x
                        %mo −
                        %mi i
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mi i
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %msub
                      %mi y
                      %mi x
                    %mo =
                    %mi z
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x \gt 0) \wedge (y \gt 2) \wedge (x \lt z) \wedge \exists_{y_0, y_1, \ldots y_x \lt z} (y = y_0) \wedge (\forall_{i \lt x} y_{i+1} = A_{x-i}(y_i - 1)) \wedge (2 y_x = z)
            %p
              where the quantifications are manifestly bounded by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                    %annotation{:encoding => "application/x-tex"} z
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi z
                  %annotation{:encoding => "application/x-tex"} A_x(y) = z
              is primitive recursive.
            %p
              From this it follows that the binary relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi z
                  %annotation{:encoding => "application/x-tex"} A_x(x) = z
              is also primitive recursive, as claimed.
          %p
            Combining this result with Theorem
            = succeed "," do
              %a.maruku-ref{:href => "#graph"}
          .num_corollary
            %h6#corollary_3 Corollary
            %p
              The Ackermann function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo :
                    %mi x
                    %mo ↦
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A: x \mapsto A_x(x)
              is recursive.
          #inverse.num_example
            %h6#example Example
            %p
              Here we exhibit a primitive recursive bijection whose inverse is not primitive recursive. The graph
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo =
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} y = A_x(x)
              of the Ackermann function is primitive recursive binary predicate, and the image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi y
                    %mo :
                    %msub
                      %mo ∃
                      %mi x
                    %mi y
                    %mo =
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I = \{y: \exists_x y = A_x(x)\}
              is a primitive recursive unary predicate, because the existential quantifier is a bounded quantifier applied to a primitive recursive relation:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mrow
                        %mi x
                        %mo =
                        %mn 0
                      %mrow
                        %mi y
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi A
                      %mi x
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi y
                    %mo{:stretchy => "false"} ]
                    %mo .
                  %annotation{:encoding => "application/x-tex"} I = \bigvee_{x=0}^{y-1} [A_x(x) = y].
            %p
              Observe that both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              and its complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi I
                  %annotation{:encoding => "application/x-tex"} \neg I
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{N}
              are infinite.
            %p
              For any infinite set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi J
                      %mo ⊆
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} J \subseteq \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi J
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} p_J: \mathbb{N} \to \mathbb{N}
              be the function taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              to the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi n
                      %mi th
                  %annotation{:encoding => "application/x-tex"} n^{th}
              element of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              (with respect to the usual order
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo &lt;
                    %annotation{:encoding => "application/x-tex"} \lt
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi I
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi A
                        %mi x
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_I(x) = A_x(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi ℕ
                    %mo →
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} f: \mathbb{N} \to \mathbb{N}
              by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi m
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                          %mtd
                            %mn 2
                            %msubsup
                              %mi p
                              %mi I
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi m
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mtext if
                            %mspace{:width => "thickmathspace"}
                            %mi m
                            %mo ∈
                            %mi I
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mn 2
                            %msubsup
                              %mi p
                              %mrow
                                %mo ¬
                                %mi I
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %mi m
                            %mo{:stretchy => "false"} )
                            %mo +
                            %mn 1
                          %mtd
                            %mtext if
                            %mspace{:width => "thickmathspace"}
                            %mi m
                            %mo ∈
                            %mo ¬
                            %mi I
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    f(m) &amp; = &amp; 2p_I^{-1}(m) &amp; \text{if} \; m \in I \\
                    \&amp; = &amp; 2p_{\neg I}^{-1}(m) + 1 &amp; \text{if} \; m \in \neg I
                    }
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mn 2
                    %mi m
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} f(m) \leq 2m + 1
              and the graph of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is primitive recursive, so by Theorem
              = succeed "," do
                %a.maruku-ref{:href => "#bound"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a primitive recursive function. It is a bijection by construction. But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} f^{-1}
              is not primitive recursive, because
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi f
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi p
                        %mi I
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi A
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} f^{-1}(2x) = p_I(x) = A(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is not primitive recursive.
