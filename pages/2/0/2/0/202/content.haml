          %h2#definition Definition
          %p
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} Grp
            is the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            %a.existingWikiWord{:href => "/nlab/show/group"} groups
            as
            %a.existingWikiWord{:href => "/nlab/show/objects"} objects
            and
            %a.existingWikiWord{:href => "/nlab/show/group+homomorphisms"} group homomorphisms
            as
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
          %p
            Similarly there is the
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinGrp
                  %mo ↪
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} FinGrp \hookrightarrow Grp
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+groups"} finite groups
          %p
            More generally, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is any
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+products"} finite products
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Grp(\mathcal{C})
            of
            %a.existingWikiWord{:href => "/nlab/show/group+objects"} group objects
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒞
                  %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prod
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi T
                    %mi Grp
                  %mo ,
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Prod(T_{Grp}, \mathcal{C})
            of product-preserving functors from the
            %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            for groups to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
