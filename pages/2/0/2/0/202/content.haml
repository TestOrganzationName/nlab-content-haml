                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mi j
                            %mi π
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ′
                            %mi g
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi j
                            %mi π
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ′
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mtext iff
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∀
                              %mrow
                                %mi g
                                %mo ′
                                %mo :
                                %mi G
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ′
                            %mi g
                            %mi H
                            %mo{:stretchy => "false"} )
                            %mo =
                            %mi j
                            %mo{:stretchy => "false"} (
                            %mi g
                            %mo ′
                            %mi H
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mtext iff
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mo ∀
                              %mrow
                                %mi g
                                %mo ′
                                %mo :
                                %mi G
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thickmathspace"}
                            %mi g
                            %mo ′
                            %mi g
                            %mi H
                            %mo =
                            %mi g
                            %mo ′
                            %mi H
                        %mtr
                          %mtd
                          %mtd
                            %mtext iff
                          %mtd
                            %mi g
                            %mi H
                            %mo =
                            %mi H
                        %mtr
                          %mtd
                          %mtd
                            %mtext iff
                          %mtd
                            %mi g
                            %mo ∈
                            %mi H
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    d_{j\pi}(g) = 0 &amp; \text{iff} &amp; (\forall_{g': G})\; g\cdot j\pi(g') = j\pi(g') \\
                    \&amp; \text{iff} &amp; (\forall_{g': G})\; j\pi(g' g) = j\pi(g') \\
                    \&amp; \text{iff} &amp; (\forall_{g': G})\; j(g' g H) = j(g' H) \\
                    \&amp; \text{iff} &amp; (\forall_{g': G})\; g' g H = g' H \\
                    \&amp; \text{iff} &amp; g H = H \\
                    \&amp; \text{iff} &amp; g \in H.
                    }
            %p
              (All we needed was
              %em some
              injection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo :
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} j: G/H \to A
              into an abelian group; embedding into the free abelian group is a pretty canonical choice.)
          .num_remark
            %h6#remark Remark
            %p
              This proof can be adapted to show that monomorphisms in the category of
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              groups (group objects in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi FinSet
                    %annotation{:encoding => "application/x-tex"} FinSet
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝔽
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              generated by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G/H
          .num_remark
            %h6#remark_2 Remark
            %p
              The proof requires that the
              %a.existingWikiWord{:href => "/nlab/show/monad"} unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo →
                    %mi U
                    %mi F
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \to U F X
              of the free abelian group monad (or the free
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔽
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{F}_2
              vector space monad) is monic, constructively. This is not entirely obvious, and is not a well-known fact, but details can be found in this
              = succeed "." do
                %a{:href => "https://mathoverflow.net/questions/302516/constructively-is-the-unit-of-the-free-abelian-group-monad-on-sets-injective/302519"} MO thread
          .num_cor
            %h6#corollary Corollary
            %p
              The category of groups is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/balanced+category"} balanced
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epic
              mono is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          .proof
            %h6#proof_2 Proof
            %p This follows because an epic equalizer is an equalizer of two maps that (by epi-ness) must be the same, hence the equalizer is an isomorphism.
          .num_cor
            %h6#corollary_2 Corollary
            %p Every epimorphism in the category of groups is a coequalizer.
          .proof
            %h6#proof_3 Proof
            %p
              Since every morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi G
                    %mo →
                    %mi H
                  %annotation{:encoding => "application/x-tex"} f: G \to H
              factors as a
              %em regular
              epi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi G
                    %mo →
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi ker
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p: G \to G/\ker(f)
              followed by a mono
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                    %annotation{:encoding => "application/x-tex"} i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              epi implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              is a epic mono. Epic monos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              being isomorphisms,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is then forced to be regular epic as well.
          .num_remark
            %h6#remark_3 Remark
            %p
              Despite the fact that every morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} Grp
              factors as an epi followed by a regular mono, it is not true that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Grp
                      %mi op
                  %annotation{:encoding => "application/x-tex"} Grp^{op}
              is regular. Indeed, (regular) monos are in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} Grp
              not stable under pushouts. This follows essentially from the plenitude of
              %a.existingWikiWord{:href => "/nlab/show/simple+objects"} simple objects
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Grp
                    %annotation{:encoding => "application/x-tex"} Grp
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              is not simple but embeds in a simple group
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo →
                      %mi H
                      %mo{:stretchy => "false"} /
                      %mi N
                    %annotation{:encoding => "application/x-tex"} H \to H/N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi H
                          %mtd
                            %mo ↪
                          %mtd
                            %mi G
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi H
                            %mo{:stretchy => "false"} /
                            %mi N
                          %mtd
                            %mo →
                          %mtd
                            %mi P
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    H &amp; \hookrightarrow &amp; G \\
                    \\downarrow &amp; &amp; \downarrow \\
                    H/N &amp; \to &amp; P
                    }
            %p
              the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
              will be a proper quotient of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              and therefore
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi P
                      %mo ≅
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} P \cong 1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \to G
              which is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} /
                    %mi N
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} H/N \to 1
              fails to be mono.
