                %mrow
                  %mi 𝒞
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{C} =
            %a.existingWikiWord{:href => "/nlab/show/SmthMfd"} SmthMfd
            this yields the category of
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                  %mo =
                %annotation{:encoding => "application/x-tex"} \mathcal{C} =
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            it reduces again to the default case.
          %h2#remarks Remarks
          %p
            If one associates to a group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            its
            %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
            one-object
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} B G
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full
            sub-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            \-category of
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            on one-object groupoids. In this case the
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/inner+automorphism"} inner automorphism
            %em not
            equivalent to the 1-category of groups.
          %p
            On the other hand, if we regard
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} Grp
            as a full sub-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn 2
                %annotation{:encoding => "application/x-tex"} 2
            \-category of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Grpd
                      %mo *
                  %annotation{:encoding => "application/x-tex"} Grpd_*
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
            %em
              %a.existingWikiWord{:href => "/nlab/show/pointed+object"} pointed
            groupoids, then this is
            %a.existingWikiWord{:href => "/nlab/show/locally+discrete+2-category"} locally discrete
            and
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalent
            to the ordinary
            %a.existingWikiWord{:href => "/nlab/show/1-category"} 1-category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Grp
                  %annotation{:encoding => "application/x-tex"} Grp
            %em pointed
            intertwiner between two homomorphisms is the identity.
          %p
            Precisely analogous statements hold for the category
            %a.existingWikiWord{:href => "/nlab/show/Alg"} Alg
            of algebras.
          %h2#properties Properties
          %p
            (In this section, all statements about
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} Grp
            are valid more generally for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Grp(E)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            with a
            = succeed ".)" do
              %a.existingWikiWord{:href => "/nlab/show/natural+numbers+object"} natural numbers object
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grp
                %annotation{:encoding => "application/x-tex"} Grp
            is one of the prototypical examples of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/semiabelian+category"} semiabelian category
            %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular
            and even
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Barr-exact+category"} exact
            %a.existingWikiWord{:href => "/nlab/show/protomodular+category"} protomodular
            so that one can expect a certain battery of
            %a{:href => "/nlab/show/diagram+chasing+lemmas+-+contents"} diagram chasing lemmas
            to hold in it.
          %p
            The category of groups is also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/balanced+category"} balanced
