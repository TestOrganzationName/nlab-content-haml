            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is a
            %a.existingWikiWord{:href => "/nlab/show/measure"} measure
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
