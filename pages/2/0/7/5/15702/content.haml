            %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois group
          .maruku-equation
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_10.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mi K
                      %mo ,
                      %mi σ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi s
                  %mo ↦
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi 𝔭
                  %mi det
                  %msup
                    %mrow
                      %mo (
                      %mi id
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mi N
