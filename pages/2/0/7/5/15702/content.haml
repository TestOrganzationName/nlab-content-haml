          %h2#idea Idea
          %p
            An
            %em Artin L-function
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi σ
                %annotation{:encoding => "application/x-tex"} L_\sigma
            (
            %a{:href => "#Artin23"}> Artin 23
            ) is an
            %a.existingWikiWord{:href => "/nlab/show/L-function"} L-function
            associated with a
            %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            and induced from the choice of an
            = succeed "-dimensional" do
              %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
            %a.existingWikiWord{:href => "/nlab/show/linear+representation"} linear representation
          .maruku-equation
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_4.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
