                %annotation{:encoding => "application/x-tex"} \mathfrak{p}
            in the
            %a.existingWikiWord{:href => "/nlab/show/ring+of+integers"} ring of integers
            of
            = succeed "," do
              %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %a.existingWikiWord{:href => "/nlab/show/characteristic+polynomials"} characteristic polynomials
            of the
            %a.existingWikiWord{:href => "/nlab/show/Frobenius+homomorphism"} Frobenius homomorphism
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
