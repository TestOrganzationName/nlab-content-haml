            for some finite
            %a.existingWikiWord{:href => "/nlab/show/Galois+extension"} Galois extension
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
