            (
            %a{:href => "#Gelbhart84"}> e.g. Gelbhart 84, II.C.2
            ,
            = succeed ")." do
              %a{:href => "#Snyder02"} Snyder 02, def. 2.1.3
          %blockquote
            %p discussion of ramified primes needs to be added
          %p
            For
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \sigma = 1
            the
            %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial representation
            then the Artin L-function reduces to the
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+zeta+function"} Dedekind zeta function
            (see
            = succeed ")." do
              %a{:href => "#RelationToDedekindZeta"} below
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/flat+connections"} flat connections
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/local+systems+of+coefficients"} local systems of coefficients
          %p
            For
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            any 1-dimensional
            %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
            (hence the case
            = succeed ")" do
              %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
            %em
              %a.existingWikiWord{:href => "/nlab/show/Dirichlet+character"} Dirichlet character
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            such that the Artin L-function
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi σ
                %annotation{:encoding => "application/x-tex"} L_\sigma
            is equal to the
            %a.existingWikiWord{:href => "/nlab/show/Dirichlet+L-function"} Dirichlet L-function
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi χ
                %annotation{:encoding => "application/x-tex"} L_\chi
            – this relation is part of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Artin+reciprocity"} Artin reciprocity
          %p
            For
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            any
            = succeed "-dimensional" do
              %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mn 1
                %annotation{:encoding => "application/x-tex"} n \geq 1
            then the
            %a.existingWikiWord{:href => "/nlab/show/conjecture"} conjecture
            of
            %em
              %a.existingWikiWord{:href => "/nlab/show/Langlands+correspondence"} Langlands correspondence
            is that for each
            = succeed "-dimensional" do
              %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            there is an
            %a.existingWikiWord{:href => "/nlab/show/automorphic+representation"} automorphic representation
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi π
                %annotation{:encoding => "application/x-tex"} \pi
            such that the Artin L-function
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi σ
                %annotation{:encoding => "application/x-tex"} L_\sigma
            equals the
            %a.existingWikiWord{:href => "/nlab/show/automorphic+L-function"} automorphic L-function
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mi π
                %annotation{:encoding => "application/x-tex"} L_\pi
            (e.g
            = succeed ")." do
              %a{:href => "#Gelbhart84"} Gelbhart 84, pages 5-6
          %h2#properties Properties
          %h3#for_irreducible_representations__artins_conjecture For irreducible representations – Artin’s conjecture
          %p
            %em Artin’s conjecture
            is the statement that for a nontrivial
            %em
              %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible representation
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            the Artin L-function
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mi K
                      %mo ,
                      %mi σ
                %annotation{:encoding => "application/x-tex"} L_{K,\sigma}
            is not just a
            %a.existingWikiWord{:href => "/nlab/show/meromorphic+function"} meromorphic function
            on the complex plane, but in fact an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/entire+holomorphic+function"} entire holomorphic function
          %p
            e.g. (
            %a{:href => "#RamMurty94"}> Ram Murty 94, p. 3
            )
          %blockquote
            %p
              or rather with at most a pole at
              %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} s = 1
              %a{:href => "#MurtyMurty12"} Murty-Murty 12, page 29 in chapter 2
          %h3#ForInducedRepresentations For induced representations
          %p
            Let
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ↪
                  %mi Gal
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H \hookrightarrow Gal(L/K)
            be
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of the Galois group
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ≔
                  %mi Gal
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} G \coloneqq Gal(L/K)
            and write
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mi H
                  %mo ↪
                  %mi L
                %annotation{:encoding => "application/x-tex"} L^H \hookrightarrow L
            for the subfield of elements fixed by
            = succeed "." do
              %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            be a representation of
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %mi Gal
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi L
                    %mi H
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H = Gal(L/L^H)
            and write
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi Ind
                    %mi H
                    %mi G
                  %mi σ
                %annotation{:encoding => "application/x-tex"} Ind_H^G\sigma
            for the
            %a.existingWikiWord{:href => "/nlab/show/induced+representation"} induced representation
            of
            = succeed "." do
              %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          .maruku-equation
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_36.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mi K
                      %mo ,
                      %mrow
                        %msubsup
                          %mi Ind
                          %mi H
                          %mi G
                        %mi σ
                  %mo =
                  %msub
                    %mi L
                    %mrow
                      %msup
                        %mi L
                        %mi H
                      %mo ,
                      %mi σ
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L_{K,{Ind_H^{G}\sigma}} = L_{L^H, \sigma}
                  \\,.
          %p
            (e.g. (
            %a{:href => "#MurtyMurty12"}> Murty-Murty 12, equation (2) in chapter 2
            )).
          %h3#RelationToDedekindZeta Relation to the Dedekind zeta function
          %p
            For
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \sigma = 1
            the
            %a.existingWikiWord{:href => "/nlab/show/trivial+representation"} trivial representation
            then
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi Frob
                    %mi 𝔭
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi id
                %annotation{:encoding => "application/x-tex"} \sigma(Frob_{\mathfrak{p}}) = id
            identically, and hence in this case the definition of the Artin L-function becomes verbatim that of the
            %a.existingWikiWord{:href => "/nlab/show/Dedekind+zeta+function"} Dedekind zeta function
            = succeed ":" do
              %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ζ
                      %mi K
                  %annotation{:encoding => "application/x-tex"} \zeta_K
          .maruku-equation
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_40.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi L
                    %mrow
                      %mi L
                      %mo ,
                      %mn 1
                  %mo =
                  %msub
                    %mi ζ
                    %mi L
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  L_{L,1} = \zeta_L
                  \\,.
          %p
            If
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %mo{:stretchy => "false"} /
                  %mi K
                %annotation{:encoding => "application/x-tex"} L/K
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Galois+extension"} Galois extension
            %a{:href => "#ForInducedRepresentations"} above
            this is also the Artin L-function of
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            itself for the
            %a.existingWikiWord{:href => "/nlab/show/regular+representation"} regular representation
            of
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Gal
                  %mo{:stretchy => "false"} (
                  %mi L
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Gal(L/K)
          .maruku-equation
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_44.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi L
                  %mo =
                  %msub
                    %mi L
                    %mrow
                      %mi L
                      %mo ,
                      %mn 1
                  %mo =
                  %msub
                    %mi L
                    %mrow
                      %mi K
                      %mo ,
                      %mrow
                        %msubsup
                          %mi Ind
                          %mn 1
                          %mrow
                            %mi Gal
                            %mo{:stretchy => "false"} (
                            %mi L
                            %mo{:stretchy => "false"} /
                            %mi K
                            %mo{:stretchy => "false"} )
                        %mn 1
                %annotation{:encoding => "application/x-tex"}
                  \\zeta_L
                  \=
                  L_{L,1}
                  \=
                  L_{K,{Ind_1^{Gal(L/K)}1}}
          %p
            (e.g. (
            %a{:href => "#MurtyMurty12"}> Murty-Murty 12, below (2) in chapter 2
            ))
          %h3#AnalogyWithSelbergZeta Analogy with Selberg/Ruelle zeta-functions
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Frobenius+morphism"} Frobenius morphism
            %math#mathml_12049cb8a6825b151e4c22a4db78dcd7f06ef271_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Frob
                    %mi p
                %annotation{:encoding => "application/x-tex"} Frob_p
            giving an element in the
            %a.existingWikiWord{:href => "/nlab/show/Galois+group"} Galois group
            means that one may think of it as an element of the
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            of the given
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+curve"} arithmetic curve
            (see at
            = succeed ")." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/algebraic+fundamental+group"} algebraic fundamental group
            %a.existingWikiWord{:href => "/nlab/show/prime+geodesics"} prime geodesics
            in hyperbolic geometry (
            %a{:href => "#Brown09"}> Brown 09, p. 6
            ).
          %p
            Under this interpretation, a
            %a.existingWikiWord{:href => "/nlab/show/Galois+connection"} Galois connection
            corresponds to a
            %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
            (
            %a.existingWikiWord{:href => "/nlab/show/local+system+of+coefficients"}> local system of coefficients
            ) on an arithmetic curve, and its Artin L-function is a product of
            %a.existingWikiWord{:href => "/nlab/show/characteristic+polynomials"} characteristic polynomials
            of the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/monodromies"} monodromies
            %a.existingWikiWord{:href => "/nlab/show/holonomies"} holonomies
            of that flat connection.
          %p
            Now, in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            %a.existingWikiWord{:href => "/nlab/show/hyperbolic+manifold"} hyperbolic manifold
            equipped with an actual
            %a.existingWikiWord{:href => "/nlab/show/flat+bundle"} flat bundle
            over it, then associated with it is the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Selberg+zeta+function"} Selberg zeta function
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Ruelle+zeta+function"} Ruelle zeta function
            %a.existingWikiWord{:href => "/nlab/show/Euler+products"} Euler products
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic+polynomials"} characteristic polynomials
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/monodromies"} monodromies
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/holonomies"} holonomies
            %em
              %a{:href => "Selberg+zeta+function#AnalogyWithArtinLFunction"} Selberg zeta function – Analogy with Artin L-function
            and at
            %em
              %a{:href => "Ruelle+zeta+function#AnalogyToTheArtinLFunction"} Ruelle zeta function – Analogy with Artin L-function
            for more on this.
          %p
            See also (
            %a{:href => "#Brown09"}> Brown 09, page 6
            ,
            = succeed ")." do
              %a{:href => "#Morishita12"} Morishita 12, remark 12.7
          %p
            (The definition also has some similarity to that of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Alexander+polynomial"} Alexander polynomial
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/arithmetic+topology"} arithmetic topology
