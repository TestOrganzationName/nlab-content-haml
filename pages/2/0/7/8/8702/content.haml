                %tr
                  %td{:style => "text-align: left;"}
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %annotation{:encoding => "application/x-tex"} \,
                    %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %annotation{:encoding => "application/x-tex"} \,
                  %td{:style => "text-align: left;"}
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %annotation{:encoding => "application/x-tex"} \,
                    %a.existingWikiWord{:href => "/nlab/show/disjoint+union+topological+space"} disjoint union topological space
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
