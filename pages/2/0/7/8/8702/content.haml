            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi U
                    %mi i
                %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod} U_i
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi U
                    %mi i
                  %mo ⊂
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} U_i \subset X_i
            open and with
            %em no
            further restriction on the factors.
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            not finite then the box topology is a strictly
            %a.existingWikiWord{:href => "/nlab/show/fine+topology"} finer topology
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi prod
