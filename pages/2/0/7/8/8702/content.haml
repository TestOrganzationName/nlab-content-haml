          %h2#definition Definition
          #ProductTopologicalSpace.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi i
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{(X_i, \tau_i)\}_{i \in I}
              be a
              %a.existingWikiWord{:href => "/nlab/show/set"} set
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              %em product topological space
              has as underlying set the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod} X_i
              of the underlying sets, and has as topology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi prod
                    %mo ⊂
                    %mi P
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau_{prod} \subset P(\underset{i \in I}{\prod} X_i)
              the
              %a.existingWikiWord{:href => "/nlab/show/coarse+topology"} coarsest topology
              such that all the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mo ⟶
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"}
                    p_i
                    \\;\colon\;
                    \\underset{i \in I}{\prod} X_i
                    \\longrightarrow
                    X_i
            %p
              become
              %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
              (called the
              = succeed ")." do
                %em Tychonoff topology
            %p
              This means equivalently that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi prod
                  %annotation{:encoding => "application/x-tex"} \tau_{prod}
              is the topology generated from the
              %a.existingWikiWord{:href => "/nlab/show/sub-base+of+a+topology"} sub-base
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi β
                      %mi prod
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %msubsup
                        %mi p
                        %mi i
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi U
                        %mi i
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi X
                        %mi i
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi i
                      %mo ∈
                      %mi I
                      %mo ,
                      %msub
                        %mi U
                        %mi i
                      %mo ⊂
                      %msub
                        %mi X
                        %mi i
                      %mspace{:width => "thinmathspace"}
                      %mtext open
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\beta_{prod}
                    \\;\coloneqq\;
                    \\left\{
                    p_i^{-1}(U_i) \subset \underset{i \in I}{\prod} X_i
                    \\;\vert\;
                    i \in I, U_i \subset X_i \, \text{open}
                    \\right\}
                    \\,.
          %p Notice that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi p
                    %mi i
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi U
                    %mi i
                  %mo ×
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi j
                        %mo ∈
                        %mi I
                        %mo \
                        %mo{:stretchy => "false"} {
                        %mi i
                        %mo{:stretchy => "false"} }
                    %msub
                      %mi X
                      %mi j
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  p_i^{-1}(U_i)
                  \=
                  U_i
                  \\times
                  \\left(\underset{j \in I \backslash \{i\}}{\prod} X_j\right)
          %p and that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi p
                    %mi i
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo ∩
                  %msubsup
                    %mi p
                    %mi j
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi j
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi U
                    %mi i
                  %mo ×
                  %msub
                    %mi U
                    %mi j
                  %mo ×
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi k
                        %mo ∈
                        %mi I
                        %mo \
                        %mo{:stretchy => "false"} {
                        %mi i
                        %mo ,
                        %mi j
                        %mo{:stretchy => "false"} }
                    %msub
                      %mi X
                      %mi k
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  p_i^{-1}(U_i)
                  \\cap
                  p_j^{-1}(U_j)
                  \=
                  U_i \times U_j
                  \\times
                  \\left(\underset{k \in I \backslash \{i,j\}}{\prod} X_k\right)
          %p etc.
          %h2#examples Examples
          #ProductWithDiscreteFiniteTopologicalSpace.num_example
            %h6#example Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be any
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(\{1,2\})
              for the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              on a set with two elements. Then there is a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi X
                    %mo ⊔
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    X \times Disc(\{0,1\})
                    \\;\simeq\;
                    X \sqcup X
            %p
              between the product space of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(\{1,2\})
              and the
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+space"} disjoint union space
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with itself.
          .proof
            %h6#proof Proof
            %p
              By definition of
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              there is a
              %a.existingWikiWord{:href => "/nlab/show/bijection"} bijection
              of underlying sets
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ⊔
                      %mi X
                      %mo ≃
                      %mi X
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} X \sqcup X \simeq X \times \{1,2\}
            %p By unwinding the definitions
            %ol
              %li
                %p
                  the open subsets of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ×
                        %mi Disc
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \times Disc(\{0,1\})
                  are unions of those of the form
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo ×
                          %mi S
                        %annotation{:encoding => "application/x-tex"} U \times S
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U \subset X
                  is an open subset and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊂
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} S \subset \{1,2\}
                  is any subset
              %li
                %p
                  the open subsets of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ⊔
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X \sqcup X
                  are of the form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ⊔
                        %mi V
                      %annotation{:encoding => "application/x-tex"} U \sqcup V
                  with
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ,
                        %mi V
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} U,V \subset X
                  open.
            %p Under the above bijection the we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊔
                    %mi V
                    %mo =
                    %mrow
                      %mo (
                      %mi U
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mo ∪
                    %mrow
                      %mo (
                      %mi V
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 2
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    U \sqcup V = \left(U \times \{1\}\right) \cup \left( V \times \{2\}\right)
                    \\,.
            %p
              Conversely, every union of elements of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ′
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} U' \times \{1\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ′
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} V' \times \{2\}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                    %mo =
                    %mi W
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ∪
                    %mi W
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 2
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} W \times \{1,2\} = W \times \{1\} \cup W \times \{2\}
              is of the form
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo ∪
                      %mi V
                      %mo ×
                      %mo{:stretchy => "false"} {
                      %mn 2
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} U \times \{1\} \cup V \times \{2\}
            %p This shows that the above bijection of underlying sets induces a bijection of the corresponding open subsets, hence is a homeomorphism.
          .num_example
            %h6#example_2 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              consider the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+space"} Cartesian space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^n
              with the
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              induced from its
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean metric
              structure. Then the product topological spaces satisfy
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ≃
                    %msup
                      %mi ℝ
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{R}^{n_1}\times \mathbb{R}^{n_2}
                    \\simeq
                    \\mathbb{R}^{n_1 + n_2}
                    \\,.
          #InfiniteProductOfDiscreteSpaces.num_example
            %h6#example_3 Example
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(S)
              be a
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              on a set with at least two elements. Then the infinite product space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{n \in \mathbb{Z}}{\prod} Disc(S)
            %p
              is itself
              %em not
              a discrete space.
          .proof
            %h6#proof_2 Proof
            %p
              The open subsets of a discrete space include
              %em all
              the subsets of the underlying set. Hence we need to see that there are subsets of the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℤ
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{n \in \mathbb{Z}}{\prod} Disc(S)
              which are not open subsets in the Tychonoff topology.
            %p But by definition the open subsets in the Tychnoff topology are unions of products of open subsets of the factor spaces such that only a finite number of the factors is not the total space.
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is assumed to contain at least two elements let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} 1 \in S
              be one of these. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo ⊂
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \{1\} \subset S
              is a proper subset. Accordingly the product subset
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi 𝔹
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{n \in \mathbb{B}}{\prod} \{1\}
                    \\;\subset\;
                    \\underset{n\in \mathbb{N}}{\prod} Disc(S)
            %p
              is not open. For if it were, it would have to be the union of product subsets that contain the total set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              in at least one entry, which by construction it is not.
          #CantorSpace.num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Cantor+space"}> Cantor space
                )
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Disc(\{0,1\})
              for the the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topological+space"} discrete topological space
              with two points. Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 2
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underset{n \in \mathbb{N}}{\prod} Disc(\{0,2\})
              for the
              %a.existingWikiWord{:href => "/nlab/show/product+topological+space"} product topological space
              of a
              %a.existingWikiWord{:href => "/nlab/show/countable+set"} countable set
              of copies of this discrete space with itself (i.e. the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \underset{n \in \mathbb{N}}{\prod} \{0,1\}
              equipped with the Tychonoff topology induced from the
              %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
              of
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0,1\}
            %p
              Then consider the
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                              %mrow
                                %mi n
                                %mo ∈
                                %mi ℕ
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mover
                              %mo ⟶
                              %mi κ
                          %mtd
                            %mo{:stretchy => "false"} [
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} ]
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi a
                              %mi i
                            %msub
                              %mo{:stretchy => "false"} )
                              %mrow
                                %mi i
                                %mo ∈
                                %mi ℕ
                          %mtd
                            %mover
                              %mo ↦
                              %mphantom
                                %mi AAAA
                          %mtd
                            %munderover
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi i
                                %mo =
                                %mn 0
                              %mn ∞
                            %mfrac
                              %mrow
                                %mn 2
                                %msub
                                  %mi a
                                  %mi i
                              %mrow
                                %msup
                                  %mn 3
                                  %mi n
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\underset{n \in \mathbb{N}}{\prod} \{0,1\}
                    \&amp;\overset{\kappa}{\longrightarrow}&amp;
                    [0,1]
                    \\\
                    (a_i)_{i \in \mathbb{N}}
                    \&amp;\overset{\phantom{AAAA}}{\mapsto}&amp;
                    \\underoverset{i = 0}{\infty}{\sum} \frac{2 a_i}{ 3^n}
                    }
            %p
              which sends an element in the product space, hence a
              %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
              of binary digits, to the value of the
              %a.existingWikiWord{:href => "/nlab/show/power+series"} power series
              as shown on the right.
            %p
              One checks that this is a
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
              (from the
              %a.existingWikiWord{:href => "/nlab/show/product+topology"} product topology
              to the
              %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
              %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              on the
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi κ
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo )
                    %mo ⊂
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \kappa\left( \underset{n \in \mathbb{N}}{\prod} \{0,1\}\right) \subset [0,1]
              equipped with its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              onto its image:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                    %mi Disc
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mphantom
                          %mi AA
                        %mo ≃
                        %mphantom
                          %mi AA
                    %mi κ
                    %mrow
                      %mo (
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi n
                          %mo ∈
                          %mi ℕ
                      %mi Disc
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} }
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mover
                      %mo ↪
                      %mphantom
                        %mi AAAA
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{n \in \mathbb{N}}{\prod} Disc(\{0,1\})
                    \\overset{\phantom{AA}\simeq\phantom{AA}}{\longrightarrow}
                    \\kappa\left(
                    \\underset{n \in \mathbb{N}}{\prod} Disc(\{0,1\})
                    \\right)
                    \\overset{\phantom{AAAA}}{\hookrightarrow}
                    [0,1]
                    \\,.
            %p
              This image is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/Cantor+space"} Cantor space
              as a subspace of the closed interval.
          %p
          .num_remark
            %h6 Example
            %p
              A Cartesian product of countably many copies of the real
              %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0,1]
              (as a topological space) is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+cube"} Hilbert cube
          %h2#properties Properties
          %h3#basic_properties Basic properties
          #ProjectionsAreOpenMaps.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/projections"} projections
                are
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/open+maps"} open maps
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{X_i\}_{i \in I}
              a set of topological spaces, the for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi j
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} j \in I
              the
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              out of their product space into the
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                    %annotation{:encoding => "application/x-tex"} j
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi j
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mo ⟶
                    %msub
                      %mi X
                      %mi j
                  %annotation{:encoding => "application/x-tex"}
                    p_j \;\colon\; \underset{i \in I}{\prod} X_i \longrightarrow X_j
            %p
              is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+map"} open map
          .proof
            %h6#proof_3 Proof
            %p
              Since images preserve unions (
              %a{:href => "interactions+of+images+and+pre-images+with+unions+and+intersections#PreservationOfUnionsAndIntersectionsOfSets"}> this prop.
              ) it is sufficient to check that the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi j
                  %annotation{:encoding => "application/x-tex"} p_j
              of a
              %span.newWikiWord
                base open
                %a{:href => "/nlab/new/base+fo+the+topology"} ?
              is still open. But base opens in the product topology by definition are, in particular, products of open subsets.
          %h3#universal_property Universal property
          %p
            The product topological space construction from def.
            %a.maruku-ref{:href => "#ProductTopologicalSpace"}
            is the
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            in
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            over the
            %a.existingWikiWord{:href => "/nlab/show/discrete+category"} discrete
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            consisting of the factor spaces, hence the
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theoretic
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
          %p
            For
            %strong proof
            see at
            = succeed "." do
              %a{:href => "Top#UniversalConstructions"} Top – Universal constructions
          %h3#the_tychonoff_theorem The Tychonoff theorem
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Tychonoff+theorem"} Tychonoff theorem
            states that the product space of any set of
            %a.existingWikiWord{:href => "/nlab/show/compact+topological+spaces"} compact topological spaces
            (with its Tychonoff topology) is itself compact.
          %h3#relation_to_smash_product_of_pointed_spaces Relation to smash product of pointed spaces
          #OnePointCompactificationAndSmashProduct.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/one-point+compactification+intertwines+Cartesian+product+with+smash+product"}> one-point compactification intertwines Cartesian product with smash product
                )
            %p
              On the
              %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Top
                      %mi LCHaus
                  %annotation{:encoding => "application/x-tex"} Top_{LCHaus}
              of
              %a.existingWikiWord{:href => "/nlab/show/Top"} Top
              on the
              %a.existingWikiWord{:href => "/nlab/show/locally+compact+Hausdorff+spaces"} locally compact Hausdorff spaces
              with
              %a.existingWikiWord{:href => "/nlab/show/proper+maps"} proper maps
              between them, the
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              of
              %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#OnePointCompactificationFunctor"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi cpt
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Top
                      %mi LCHaus
                    %mo ⟶
                    %msup
                      %mi Top
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                  %annotation{:encoding => "application/x-tex"}
                    (-)^{cpt}
                    \\;\colon\;
                    Top_{LCHaus}
                    \\longrightarrow
                    Top^{\ast/}
            %p
              sends
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+products"} Cartesian products
              (
              %a.existingWikiWord{:href => "/nlab/show/product+topological+spaces"}> product topological spaces
              ) to
              %a.existingWikiWord{:href => "/nlab/show/smash+products"} smash products
              of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mi cpt
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi X
                      %mi cpt
                    %mo ∧
                    %msup
                      %mi Y
                      %mi cpt
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    X \times Y
                    \\big)^{cpt}
                    \\;\simeq\;
                    X^{cpt} \wedge Y^{cpt}
                    \\,.
          %p
            This is briefly mentioned in
            = succeed "." do
              %a{:href => "one-point+compactification#Bredon93"} Bredon 93, p. 199
            = succeed "," do
              %a{:href => "https://math.stackexchange.com/a/1645794/58526"} MO:a/1645794/
            = succeed "." do
              %a{:href => "one-point+compactification#Cutler20"} Cutler 20, Prop. 1.6
          %h3#relation_to_singular_cohomology Relation to singular (co)homology
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            of product topological spaces is informed by
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+theorem"} Eilenberg-Zilber theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/product+manifold"} product manifold
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
          %div
            %p
              %strong
                examples of
                = succeed ":" do
                  %a{:href => "Top#UniversalConstructions"} universal constructions of topological spaces
            %table
              %thead
                %tr
                  %th
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi AAAA
                        %annotation{:encoding => "application/x-tex"} \phantom{AAAA}
                    %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                  %th
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi AAAA
                        %annotation{:encoding => "application/x-tex"} \phantom{AAAA}
                    %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %annotation{:encoding => "application/x-tex"} \,
                    %a.existingWikiWord{:href => "/nlab/show/point+space"} point space
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
                        %annotation{:encoding => "application/x-tex"} \,
                  %td{:style => "text-align: left;"}
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
