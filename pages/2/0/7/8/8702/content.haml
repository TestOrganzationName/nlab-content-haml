              %p
                %a.existingWikiWord{:href => "/nlab/show/Terence+Tao"}> Terence Tao
                ,
                %em Notes on products of topological spaces
                (
                %a{:href => "http://www.math.ucla.edu/~tao/resource/general/121.1.00s/product.pdf"}> pdf
                )
            %li
