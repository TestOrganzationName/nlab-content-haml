                %tr
                  %td{:style => "text-align: left;"}
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mspace{:width => "thinmathspace"}
