                        %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (X_1 \times X_2 , \tau_{X_1 \times X_2})
          %p
            is called the
            %em product topological space
            of the two original spaces.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/formal+duality"} formally dual
            concept is that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union+topological+spaces"} disjoint union topological spaces
          %p
            More generally, consider any index
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            and an
            = succeed "-indexed" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msub
                    %mi X
                    %mi i
                  %mo ,
                  %msub
                    %mi τ
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \{X_i, \tau_i\}_{i \in I}
            of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %em product topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi prod
                %annotation{:encoding => "application/x-tex"} \tau_{prod}
            or
            %em
              %a.existingWikiWord{:href => "/nlab/show/Tychonoff+topology"} Tychonoff topology
            on the
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod} X_i
            of underlying sets is equivalently
          %ol
            %li
              %p
                the topology generated from the
                %a.existingWikiWord{:href => "/nlab/show/sub-base+of+a+topology"} sub-base
                given by products
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod} U_i
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ⊂
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i \subset X_i
                open, but
                %em all except one of the factors
                equal to the corresponding
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi i
                      %annotation{:encoding => "application/x-tex"} X_i
              %p hence the topology whose open subsets are precisely those obtained as arbitrary unions of finite intersections of such subsets;
            %li
              %p
                the topology generated from the
                %a.existingWikiWord{:href => "/nlab/show/base+of+a+topology"} base
                given by products
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\prod} U_i
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                      %mo ⊂
                      %msub
                        %mi X
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i \subset X_i
                open, but
                %em all except a finite number of factors
                equal to the corresponding
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi X
                          %mi i
                      %annotation{:encoding => "application/x-tex"} X_i
              %p hence the topology whose open subsets are precisely those obtained as arbitrary unions of such subsets.
          %p
            This product topology is singled out by the fact that the resulting product topological space is the
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theoretic
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            of the original space in the
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %a.existingWikiWord{:href => "/nlab/show/Top"} Top
            of topological spaces:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mi prod
                    %mo )
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi i
                  %mo ,
                  %msub
                    %mi τ
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\left(
                  \\underset{i \in I}{\prod} X_i
                  ,\;
                  \\tau_{prod}
                  \\right)
                  \\;\simeq\;
                  \\underset{i \in I}{\prod} (X_i, \tau_i)
                  \\,.
          %p
            This means that the product topology enjoys the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            that for any topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi τ
                    %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Y,\tau_Y)
            then sets of
            %a.existingWikiWord{:href => "/nlab/show/continuous+functions"} continuous functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi τ
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi ϕ
                        %mi i
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mi i
                  %mo ,
                  %msub
                    %mi τ
                    %mi i
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo{:stretchy => "false"} }
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                %annotation{:encoding => "application/x-tex"} \{(Y, \tau_Y) \overset{\phi_i}{\to} (X_i, \tau_i)\}_{i \in I}
            into the factor spaces are in
            %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            with continuous functions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ϕ
                    %mi i
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mi i
                      %mo ∈
                      %mi I
                  %mo{:lspace => "verythinmathspace"} :
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %msub
                    %mi τ
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi X
                      %mi i
                    %mo ,
                    %msub
                      %mi τ
                      %mi prod
                    %mo )
                %annotation{:encoding => "application/x-tex"} (\phi_i)_{i \in I} \colon (Y, \tau_Y) \to \left(\underset{i \in I}{\prod} X_i, \tau_{prod}\right)
            into the product topological space.
          %p
            Beware that (among others) there is also the
            %em
              %a.existingWikiWord{:href => "/nlab/show/box+topology"} box topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
