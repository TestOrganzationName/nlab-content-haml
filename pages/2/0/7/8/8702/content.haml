                    %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
                    %math#mathml_7ec4608812513a5e534c550385bc5d1ae5fa5eaf_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
