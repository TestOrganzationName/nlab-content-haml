          %h2#idea Idea
          %p
            Given two
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi τ
                    %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_1,\tau_1)
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi τ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_2, \tau_2)
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
            of their underlying sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo ×
                  %msub
                    %mi X
                    %mn 2
                %annotation{:encoding => "application/x-tex"} X_1 \times X_2
            is naturally equipped with a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mrow
                      %msub
                        %mi X
                        %mn 1
                      %mo ×
                      %msub
                        %mi X
                        %mn 2
                %annotation{:encoding => "application/x-tex"} \tau_{X_1 \times X_2}
            itself, generated from the
            %a.existingWikiWord{:href => "/nlab/show/base+of+a+topology"} base opens
            which are themselves Cartesian product
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mn 1
                    %mo ×
                    %msub
                      %mi U
                      %mn 2
                    %mo ⊂
                    %msub
                      %mi X
                      %mn 1
                    %mo ×
                    %msub
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} U_1 \times U_2 \subset X_1 \times X_2
            %a.existingWikiWord{:href => "/nlab/show/open+subsets"} open subsets
            of the original spaces:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %msub
                      %mi X
                      %mi i
                  %annotation{:encoding => "application/x-tex"} U_i \subset X_i
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
