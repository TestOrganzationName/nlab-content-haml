                        %mi k
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} [
                      %mi L
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi L
                        %mrow
                          %mo ⊗
                          %mi k
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \psi^k([L]) = [L^{\otimes k}]
