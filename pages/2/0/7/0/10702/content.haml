            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mrow
                      %mo ⊗
                      %mi k
                %annotation{:encoding => "application/x-tex"} L^{\otimes k}
            is another line bundle for any
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/complex+topological+K-theory"} complex topological K-theory
            group
            = succeed "," do
