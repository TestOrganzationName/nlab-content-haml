                  \\begin{matrix} \mathcal{A}(U) &amp; \to &amp; \text{Aut}(s) \\
                  Id \downarrow &amp;  &amp; \downarrow \\
                  \\mathcal{A}(U) &amp; \to &amp; \text{Aut}(t) \end{matrix}
          %p
            In particular, we get that for any two objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo ,
                  %mi D
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} C, D\in F(U)
            we have that the sheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Isom
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Isom(C,D)
            is an
            = succeed "-torsor." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} F(U)\neq \emptyset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(U)
            is in natural bijection with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %msub
                      %mi 𝒜
                      %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^1(U, \mathcal{A}_U)
          %p
            For example, consider the stack of rank 1 vector bundles on a scheme
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mtext Vect
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \text{Vect}_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mtext Vect
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \text{Vect}_1
            is a
            = succeed "-gerbe" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔾
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \mathbb{G}_m
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            will be precisely
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒪
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi U
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ×
                  %annotation{:encoding => "application/x-tex"} \mathcal{O}_X(U)^\times
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %msubsup
                    %mi 𝒪
                    %mi X
                    %mo ×
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^1(X, \mathcal{O}_X^\times)
            which is just
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtext Pic
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \text{Pic}(X)
          %p
            One can form the
            = succeed "," do
              %em classifying stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} B\mathcal{A}
            from the important example above by taking
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi 𝒯
                    %mi ors
                    %mo{:stretchy => "false"} (
                    %mi 𝒜
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B\mathcal{A}(U)=\mathcal{T}ors(\mathcal{A}(U))
            = succeed "-gerbes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            = succeed "-gerbe," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} B\mathcal{A}
            if and only if
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ≠
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} F(B)\neq \emptyset
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is isomorphic to the classifying stack if and only if it has a global object.
          %p
            For information on how gerbes play a role in differential geometry see
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/gerbe+%28in+differential+geometry%29"} gerbe (in differential geometry)
          %h2#references References
          %p
            There is a lengthier description of gerbes (at this level of generality) in the Menagerie notes that are available from
            %a.existingWikiWord{:href => "/nlab/show/Tim+Porter"} Tim Porter's
            home page.
          %p Other material available online includes the following:
          %ul
            %li
              %p
                I. Moerdijk,
                %em Introduction to the language of stacks and gerbes
                (
                %a{:href => "http://arxiv.org/abs/math/0212266"}> arXiv
                )
            %li
              %p
                Larry Breen,
                %em Notes on 1- and 2-gerbes
                (
                %a{:href => "http://arxiv.org/abs/math/0611317"}> arXiv
                )
          %p Further references are given in the other entries on gerbes.
