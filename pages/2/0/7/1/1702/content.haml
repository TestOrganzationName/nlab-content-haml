                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi U
                    %mi i
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(U_i)(x,y)
            is not empty. (Translation: a ‘local object’, or ‘locally defined object’, of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is a ‘local section’ of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ob(F)
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
