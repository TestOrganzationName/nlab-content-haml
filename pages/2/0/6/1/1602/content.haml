                  \\big(
                  [\nabla], [\hat j_E]
                  \\big)
                  \\;\mapsto\;
                  \\exp\big(
                  \\mathrm{i}
                  \\textstyle{\int}_X F_\nabla \wedge \star F_\nabla
                  \\big)
                  \\,
                  \\exp\big(
                  2 \pi \mathrm{i} \int_X \hat j_E \cdot \nabla
                  \\big)
                  \\,.
          %p
            \&amp;lbrack;cf.
            = succeed "&rbrack;" do
              %a{:href => "#Freed00"} Freed 2002 (2.17)
          %h3#_and_with_magnetic_charge … and with magnetic charge.
          %p
            We now consider one more additional term in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge field
            with a distribution of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/electric+charge"} electric charge
            described
            = succeed "." do
              %a{:href => "#WithElectricCharge"} above
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
            distribution itself is also modeled as a
            %a.existingWikiWord{:href => "/nlab/show/cocycle"} cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ^
                    %mi B
                %annotation{:encoding => "application/x-tex"} \hat j_B
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
            %a.existingWikiWord{:href => "/nlab/show/electric+charge"} electric charge
            it is however not part of the dynamics but of the kinematics of the system: it does not manifestly show up in the integral expression for the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
          %p
            Namely the kinematic higher
            %a.existingWikiWord{:href => "/nlab/show/Maxwell+equations"} Maxwell equations
            is a condition of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %msub
                    %mi F
                    %mo ∇
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi j
                    %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{d} F_\nabla
                  \\;=\;
                  j_B
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mi B
                %annotation{:encoding => "application/x-tex"} j_B
            is the
            %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
            distribution. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mo ∇
                %annotation{:encoding => "application/x-tex"} F_\nabla
            is the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %msub
                      %mi F
                      %mo ∇
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} d F_\nabla = 0
            %a.existingWikiWord{:href => "/nlab/show/cocycles"} cocycles
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            One finds instead that one has to model
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            not as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle n-bundle with connection
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/twisted+bundle"} twisted bundle
            with connection, where the
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"} twist
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi j
                        %mo{:stretchy => "false"} ^
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \hat j_B
          %p
            We shall write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi C
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mrow
                      %msub
                        %mover
                          %mi j
                          %mo{:stretchy => "false"} ^
                        %mi B
                %annotation{:encoding => "application/x-tex"} C^{n+1}_{diff}(X)_{\hat j_B}
            for the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            of twisted cocycles for this fixed twist. The crucial point is now the following:
          %p
            the
            %a{:href => "#WithElectricCharge"} above
            expression
          .maruku-equation
