                        %msub
                          %mover
                            %mi j
                            %mo{:stretchy => "false"} ^
                          %mi B
                  %annotation{:encoding => "application/x-tex"} \nabla \in C^{n+1}_{diff}(X)_{\hat j_B}
            = succeed "-valued" do
              %a.existingWikiWord{:href => "/nlab/show/circle+group"} circle group
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/function"} function
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of a
            %a.existingWikiWord{:href => "/nlab/show/line+bundle"} line bundle
