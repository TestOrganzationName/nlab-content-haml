                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            This way the configuration space of higher electromagnetism in the presence of electric and magnetic charge is naturally incarnated as an object in the
            %a.existingWikiWord{:href => "/nlab/show/cohesive+%28%E2%88%9E%2C1%29-topos"} cohesive (∞,1)-topos
            of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/smooth+%E2%88%9E-groupoid"} smooth ∞-groupoid
            %a{:href => "http://nlab.mathforge.org/nlab/show/cohesive%20(infinity,1)-topos#Structures"} differential geometric structures
            in cohesive
            = succeed "-topos" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} line bundles with connection
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Conf
                  %annotation{:encoding => "application/x-tex"} Conf
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Anom
                    %mrow
                      %msub
                        %mover
                          %mi j
                          %mo{:stretchy => "false"} ^
                        %mi B
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi Conf
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mi conn
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Anom_{\hat j_B}
                  \\;\colon\;
                  Conf \to \mathbf{B} U(1)_{conn}
                  \\,.
          %p
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
          %p We say that:
          %ul
            %li
              %p
                the underlying class in
                %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi Anom
                        %mrow
                          %msub
                            %mover
                              %mi j
                              %mo{:stretchy => "false"} ^
                            %mi B
                      %mo{:stretchy => "false"} ]
                      %mo ∈
                      %msup
                        %mi H
                        %mn 2
                      %mo{:stretchy => "false"} (
                      %mi Conf
                      %mo ,
                      %mi ℤ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      [Anom_{\hat j_B}] \in H^2(Conf, \mathbb{Z})
              %p
                is
                %strong the anomaly
                of the system of higher electromagnetism coupled to electric and magnetic charge;
            %li
              %p
                its
                %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
                2-form
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Curv
                        %mrow
                          %msub
                            %mi Anom
                            %mrow
                              %msub
                                %mover
                                  %mi j
                                  %mo{:stretchy => "false"} ^
                                %mi B
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Conf
                      %mo →
                      %msubsup
                        %mi Ω
                        %mi flat
                        %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      Curv_{Anom_{\hat j_B}}
                      \\;\colon\;
                      Conf \to \Omega^2_{flat}
              %p
                is the
                = succeed "." do
                  %strong differential anomaly
          %p
            One finds that this curvature 2-form is given by the
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            of the wedge product of the
            %a.existingWikiWord{:href => "/nlab/show/electric+current"} electric current
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n+1)
            %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mi X
                    %mo −
                    %mi n
                  %annotation{:encoding => "application/x-tex"} dim X - n
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Curv
                    %mrow
                      %msub
                        %mi Anom
                        %mrow
                          %msub
                            %mover
                              %mi j
                              %mo{:stretchy => "false"} ^
                            %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∫
                      %mi X
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi j
                      %mi E
                    %mo ∧
                    %msub
                      %mi j
                      %mi B
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  Curv_{Anom_{\hat j_B}}
                  \\,=\,
                  \\textstyle{\int}_X
                  \\,
                  j_E \wedge j_B
                  \\,.
          %p
            This means that for every parameter space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} U \in
            %a.existingWikiWord{:href => "/nlab/show/SmoothMfd"} SmoothMfd
            and every morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %mi U
                  %mo →
                  %mi Conf
                %annotation{:encoding => "application/x-tex"} \phi : U \to Conf
            – which corresponds by the nature of the
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Conf
                %annotation{:encoding => "application/x-tex"} Conf
            to a field configuration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo ,
                  %msub
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ^
                    %mi E
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msubsup
                    %mi C
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msubsup
                    %mi C
                    %mi diff
                    %mrow
                      %mi dim
                      %mi X
                      %mo −
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo ×
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\nabla, \hat j_E) \in C^{n+1}_{diff}(U \times X) \times C^{dim X - n}_{diff}(U \times X)
            – the pullback of this differential form to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            yields the ordinary differential form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi X
                  %msub
                    %mi j
                    %mi E
                  %mo ∧
                  %msub
                    %mi j
                    %mi B
                %annotation{:encoding => "application/x-tex"} \int_X j_E \wedge j_B
            which is the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo ∇
                  %mo ,
                  %msub
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ^
                    %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\nabla, \hat j_E)
            under the
            %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∫
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ×
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi Ω
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\textstyle{\int}_X(-)
                  \\;\colon\;
                  \\Omega^\bullet(U \times X) \to \Omega^\bullet(U)
                  \\,.
          %h3#the_greenschwarz_mechanism The Green-Schwarz mechanism
          %p
            We can now state the
            %strong Green-Schwarz mechanism
            itself.
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Conf
                    %mo{:stretchy => "false"} ^
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} \hat Conf \in
            %a.existingWikiWord{:href => "/nlab/show/Smooth%E2%88%9EGrpd"} Smooth∞Grpd
            be the configuration space of a physical system that contains among its fields higher abelian gauge theory with
            %a.existingWikiWord{:href => "/nlab/show/electric+charge"} electric charge
            with configuration space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Conf
                %annotation{:encoding => "application/x-tex"} Conf
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi Conf
                    %mo{:stretchy => "false"} ^
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi Conf
                    %mi rest
                  %mo ×
                  %mi Conf
                %annotation{:encoding => "application/x-tex"}
                  \\hat Conf \,=\, Conf_{rest} \times Conf
          %p
            and equipped with an
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} i
                  %msub
                    %mi S
                    %mi rest
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi{:mathvariant => "normal"} i
                  %msub
                    %mi S
                    %mi el
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mover
                    %mi Conf
                    %mo{:stretchy => "false"} ^
                  %mo →
                  %msub
                    %mi Anom
                    %mi rest
                %annotation{:encoding => "application/x-tex"}
                  \\exp\big(
                  \\mathrm{i} S_{rest}(-) + \mathrm{i} S_{el}(-)
                  \\big)
                  \\;\colon\;
                  \\hat Conf \to Anom_{rest}
          %p
            that is a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of an anomaly line bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Anom
                    %mi rest
                %annotation{:encoding => "application/x-tex"} Anom_{rest}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %msub
                            %mi Anom
                            %mi rest
                      %mtr
                        %mtd
                        %mtd
                          %msup
                            %mrow
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mrow
                                %mi exp
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi S
                                  %mi tot
                                %mo{:stretchy => "false"} )
                          %mo ↗
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi Conf
                            %mi rest
                        %mtd
                          %mo =
                        %mtd
                          %msub
                            %mi Conf
                            %mi rest
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; Anom_{rest}
                  \\\
                  \&amp; {}^{\mathllap{\exp(S_{tot})}}\nearrow &amp; \downarrow
                  \\\
                  Conf_{rest} &amp;=&amp; Conf_{rest}
                  }
          %p
            such that the
            %a.existingWikiWord{:href => "/nlab/show/curvature"} curvature
            2-form of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Anom
                    %mi tot
                %annotation{:encoding => "application/x-tex"} Anom_{tot}
            happens to be of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Curv
                  %mrow
                    %msub
                      %mi Anom
                      %mi ref
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∫
                      %mi X
                    %msub
                      %mi I
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo ∧
                    %msub
                      %mi j
                      %mi el
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Curv{Anom_{ref}}
                  \\,=\,
                  \\textstyle{\int}_X I_{n+2} \wedge j_{el}
                  \\,,
          %p
            for some
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mo ∈
                  %msubsup
                    %mi Ω
                    %mi cl
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} I_{n+2} \in \Omega^{n+2}_{cl}(X)
            (understood, as explained
            = succeed "," do
              %a{:href => "https://ncatlab.org/nlab/show/Green-Schwarz+mechanism#the_anomaly_line_bundle"} above
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mi cl
                      %mrow
                        %mi n
                        %mo +
                        %mn 2
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^{n+2}_{cl}(X\times U)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi el
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi dim
                        %mi X
                        %mo −
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} j_{el} \in \Omega^{dim X - n}(X)
          %p
            Then the
            %strong Green-Schwarz mechanism
            is the map that changes this physical system by adding magnetic charge to it, given by a cocycle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ^
                    %mi B
                %annotation{:encoding => "application/x-tex"} \hat j_B
            with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ^
                    %mi B
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mo −
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi Anom
                    %mi rest
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"}
                  [\hat j_B]
                  \\,=\,
                  \- [Anom_{rest}]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mi B
                  %mspace{:width => "thinmathspace"}
                  %mo =
                  %mspace{:width => "thinmathspace"}
                  %mo −
                  %msub
                    %mi I
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  j_B
                  \\,=\,
                  \- I_{n+2}
                  \\,.
          %p
            This means, by the above, that the new
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            is now a section
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} i
                  %msub
                    %mi S
                    %mi rest
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi{:mathvariant => "normal"} i
                  %msub
                    %mi S
                    %mi el
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi Conf
                    %mi rest
                  %mo ×
                  %mi Conf
                  %mo →
                  %msub
                    %mi Anom
                    %mi rest
                  %mo ⊗
                  %msub
                    %mi Anom
                    %mrow
                      %msub
                        %mover
                          %mi j
                          %mo{:stretchy => "false"} ^
                        %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\exp\big(
                  \\mathrm{i} S_{rest}(-) + \mathrm{i} S_{el}(-)
                  \\big)
                  \\,\colon\,
                  Conf_{rest} \times Conf
                  \\to
                  Anom_{rest} \otimes Anom_{\hat j_B}
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
            of the two anomaly line bundles. The
            %a.existingWikiWord{:href => "/nlab/show/first+Chern+class"} first Chern class
            of the tensor product is the sum of the two 1st Chern-classes, hence by definition of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mi B
                %annotation{:encoding => "application/x-tex"} j_B
            they cancel, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Anom
                    %mi rest
                  %mo ⊗
                  %msub
                    %mi Anom
                    %mrow
                      %msub
                        %mover
                          %mi j
                          %mo{:stretchy => "false"} ^
                        %mi B
                %annotation{:encoding => "application/x-tex"} Anom_{rest} \otimes Anom_{\hat j_B}
            is trivializatable as a line bundle with connection.
          %p A choice of such trivialization identifies the section then with an ordinary function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} i
                  %msub
                    %mi S
                    %mi rest
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi{:mathvariant => "normal"} i
                  %msub
                    %mi S
                    %mi el
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Conf
                    %mi rest
                  %mo ×
                  %mi Conf
                  %mo →
                  %mi U
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\exp\big(
                  \\mathrm{i} S_{rest}(-) + \mathrm{i} S_{el}(-)\big)
                  \\;\colon\;
                  Conf_{rest} \times Conf \to U(1)
                  \\,.
          %p This is the anomaly-free action functional after the Green-Schwarz mechanism has been applied.
          %h2#examples Examples
          %h3#heterotic_supergravity Heterotic supergravity
          %p
            The original work of Green-Schwarz concerned anomaly cancellation in the effective
            %a.existingWikiWord{:href => "/nlab/show/supergravity"} supergravity
            theory on a
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dim
                    %mi X
                    %mo =
                    %mn 10
                  %annotation{:encoding => "application/x-tex"} dim X = 10
            %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
          %p The configurations of this theory are given by
          %ul
            %li
              %p
                a
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/Spin"} Spin
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ω
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat \omega
                – the
                %a.existingWikiWord{:href => "/nlab/show/spin+connection"} spin connection
                (the
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/graviton"} graviton
            %li
              %p
                a
                = succeed "-" do
                  %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
                %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} with connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi A
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat A
                (the
                = succeed ");" do
                  %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+field"} Yang-Mills field
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/circle+n-bundle+with+connection"} circle 2-bundle with connection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat B
                – the
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Kalb-Ramond+field"} Kalb-Ramond field
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/section"}> section
                s of the
                %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
                = succeed "s:" do
                  %a.existingWikiWord{:href => "/nlab/show/spinor+bundle"} spinor bundle
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
                (
                %a.existingWikiWord{:href => "/nlab/show/gravitino"}> gravitino
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/gaugino"} gaugino
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/dilatino"} dilatino
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/path+integral"} path integral
            over the fermionic part of the action
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mi S
                    %mi ferm
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi ω
                  %mo ,
                  %mi A
                  %mo ,
                  %mi B
                  %mo ,
                  %mi ψ
                  %mo{:stretchy => "false"} )
                  %mo ↦
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mo ∫
                    %mi X
                  %mover
                    %mi ψ
                    %mo{:stretchy => "false"} ¯
                  %msub
                    %mi D
                    %mrow
                      %mi ω
                      %mo ,
                      %mi A
                  %mi ψ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i S_{ferm}(-)) : (\omega, A, B, \psi) \mapsto   \exp(i \int_X \bar \psi D_{\omega,A} \psi)
          %p
            is an anomalous action functional on the configuration space of the remaining bosonic fields
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi A
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mover
                      %mi ω
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\hat A, \hat \omega)
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Pfaffian+line+bundle"} Pfaffian line bundle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi curv
                    %mi Pfaff
                  %mo =
                  %msub
                    %mo ∫
                    %mi X
                  %msub
                    %mi I
                    %mn 4
                  %mo ∧
                  %msub
                    %mi I
                    %mn 8
                %annotation{:encoding => "application/x-tex"}
                  curv_{Pfaff} = \int_X I_4 \wedge I_8
          %p with
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mn 4
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 2
                  %msub
                    %mi p
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi ω
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mi ch
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  I_4 = \frac{1}{2} p_1(F_\omega) - ch_2(F_A)
          %p
            the difference between the (image in
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            of the) first fractional
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
            of the
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                  %annotation{:encoding => "application/x-tex"} Spin
            %a.existingWikiWord{:href => "/nlab/show/Chern+class"} Chern class
            of the
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
            %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mn 8
                  %mo =
                  %mfrac
                    %mn 1
                    %mn 48
                  %msub
                    %mi p
                    %mn 2
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi ω
                  %mo{:stretchy => "false"} )
                  %mo −
                  %msub
                    %mi ch
                    %mn 4
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi F
                    %mi A
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mo .
                  %mo .
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  I_8 = \frac{1}{48} p_2(F_\omega) - ch_4(F_A) +
                  \...
          %p
            where the ellipses indicate decomposable
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/curvature+characteristic+form"} curvature characteristic form
          %p Therefore in this case the Green-Schwarz mechanism consists of
          %ol
            %li
              %p
                adding to the system
                %em
                  fivebrane
                  %a.existingWikiWord{:href => "/nlab/show/magnetic+charge"} magnetic charge
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mi B
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mn 2
                          %mo +
                          %mn 2
                    %annotation{:encoding => "application/x-tex"} j_B \in \Omega^{2+2}
                given by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi I
                          %mn 4
                      %annotation{:encoding => "application/x-tex"} I_4
              %p
                This means that the Kalb-Ramond field
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi B
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat B
                becomes a twisted field whose
                %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
                is no longer closed, but satisfies the kinematical
                %a.existingWikiWord{:href => "/nlab/show/Maxwell+equation"} Maxwell equation
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mi H
                      %mo =
                      %msub
                        %mi I
                        %mn 4
                      %mspace{:width => "thinmathspace"}
                      %mo .
                    %annotation{:encoding => "application/x-tex"}
                      d H = I_4
                      \\,.
            %li
              %p
                adding to the system
                %em
                  string
                  %a.existingWikiWord{:href => "/nlab/show/electric+charge"} electric charge
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi j
                        %mi E
                      %mo ∈
                      %msup
                        %mi Ω
                        %mrow
                          %mn 10
                          %mo −
                          %mn 2
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j_E \in \Omega^{10 - 2}(X)
                \.
              %p
                This means that to the
                %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
                is added the factor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mi i
                  %msub
                    %mo ∫
                    %mi X
                  %mover
                    %mi B
                    %mo{:stretchy => "false"} ^
                  %mo ⋅
                  %msub
                    %mover
                      %mi I
                      %mo{:stretchy => "false"} ^
                    %mn 8
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\exp(i \int_X \hat B \cdot \hat I_8 )
          %p
            which is locally on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ↪
                  %mi X
                %annotation{:encoding => "application/x-tex"} U \hookrightarrow X
            given in the exponent by the integral
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∫
                    %mi U
                  %msub
                    %mi B
                    %mi U
                  %mo ∧
                  %msub
                    %mi I
                    %mn 8
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\int_U B_U \wedge I_8
                  \\,.
          %p
            The nature of the field configuration obtained this way – spin connection with twist of th Kalb-Ramond field by the Pontryagin class – may be understood conciesely as constituting a
            %a.existingWikiWord{:href => "/nlab/show/differential+string+structure"} twisted differential string structure
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h3#axions_and_the_strong_cp_problem_in_heterotic_supergravity Axions and the strong CP problem in heterotic supergravity
          %p
            The Green-Schwarz anomaly cancellation mechanism naturally makes the twisted
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            in
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            behave like the
            %a.existingWikiWord{:href => "/nlab/show/axion"} axion
            with the correct potential to serve as the
            %a.existingWikiWord{:href => "/nlab/show/theta+angle"} theta angle
            and serve as the solution to the
            %a.existingWikiWord{:href => "/nlab/show/strong+CP+problem"} strong CP problem
            (
            %a{:href => "#SvrcekWitten06"}> Svrcek-Witten 06
            ):
          %blockquote
            %p
              An obvious question about the axion hypothesis is how natural it really is. Why introduce a global PQ “symmetry” if it is not actually a symmetry? What is the sense in constraining a theory so that the classical Lagrangian possesses a certain symmetry if the symmetry is actually anomalous? It could be argued that the best evidence that PQ “symmetries” are natural comes from string theory, which produces them without any contrivance. … the string compactifications always generate PQ symmetries, often spontaneously broken at the string scale and producing axions, but sometimes unbroken.(
              %a{:href => "#SvrcekWitten06"}> Svrcek-Witten 06, pages 3-4
              )
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactified
            to 4d, the 4d
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            = succeed ")." do
              %a{:href => "#SvrcekWitten06"} Svrcek-Witten 06, starting p. 15
          %p
            This works as follows: By the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+anomaly+cancellation"} Green-Schwarz anomaly cancellation
            mechanism, then
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            in
            %a.existingWikiWord{:href => "/nlab/show/heterotic+string+theory"} heterotic string theory
            is a twisted 2-form field, whose
            %a.existingWikiWord{:href => "/nlab/show/field+strength"} field strength
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            locally has in addition to the exact differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi B
                %annotation{:encoding => "application/x-tex"} d B
            also a fundamental 3-form contribution, so that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo =
                  %mi d
                  %mi B
                  %mo +
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  H = d B + C
          %p
            (locally). Moreover, the differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi H
                %annotation{:encoding => "application/x-tex"} d H
            is constrained to be the Pontryagin 4-form of the gauge potential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
            (minus that of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Riemann+curvature"} Riemann curvature
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mi H
                  %mo =
                  %mi tr
                  %mrow
                    %mo (
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∧
                    %msub
                      %mi F
                      %mo ∇
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  d H = tr \left(F_\nabla \wedge F_\nabla\right)
                  \\,.
          %p
            Now suppose
            %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            to 4d has been taken care of, then this constraint may be implemented in the
            %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            by adding it to the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            %a.existingWikiWord{:href => "/nlab/show/Lagrange+multiplier"} Lagrange multiplier
            \:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo =
                  %munder
                    %munder
                      %mrow
                        %msub
                          %mo ∫
                          %mi X
                        %mi H
                        %mo ∧
                        %mo ⋆
                        %mi H
                      %mo ⏟
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mtext kinetic action
                      %mrow
                        %mtext for B-field
                  %mo +
                  %munder
                    %munder
                      %mrow
                        %msub
                          %mo ∫
                          %mi X
                        %mi a
                        %mrow
                          %mo (
                          %mi d
                          %mi H
                          %mo −
                          %mi tr
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi F
                            %mo ∇
                          %mo ∧
                          %msub
                            %mi F
                            %mo ∇
                          %mo{:stretchy => "false"} )
                          %mo )
                      %mo ⏟
                    %mtext Green-Schwarz constraint
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  S
                  \=
                  \\underset{
                  \\text{kinetic action} \atop \text{for B-field}
                  }{
                  \\underbrace{\int_X H \wedge \star H}
                  }
                  +
                  \\underset{
                  \\text{Green-Schwarz constraint}
                  }{
                  \\underbrace{
                  \\int_X a \left( d H - tr(F_\nabla \wedge F_\nabla) \right)
                  }
                  }
                  \\,.
          %p
            Now by the usual argument, one says that instead of varying by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and thus implementing the
            %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+anomaly+cancellation"} Green-Schwarz anomaly cancellation
            constraint, it is equivalent to fist vary with respect to the other fields, and then insert the resulting equations in terms of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            into the action functional.
          %p
            Now since we are dealing with a twisted
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
