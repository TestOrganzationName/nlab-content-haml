            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi U
                %annotation{:encoding => "application/x-tex"} A_U
            is the local
            %a.existingWikiWord{:href => "/nlab/show/connection+on+an+infinity-bundle"} connection
            = succeed "-form" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
          %p Globally, this contribution is given by the push-forward
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi π
                  %mi{:mathvariant => "normal"} i
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∫
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi H
                      %mi flat
                      %mrow
                        %mi dim
                        %mi X
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msubsup
                      %mi H
                      %mi flat
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                %annotation{:encoding => "application/x-tex"}
                  2 \pi \mathrm{i}
                  \\textstyle{\int}_X (-)
                  \\;\colon\;
                  H_{flat}^{dim X + 1}(X) \to H_{flat}^1(*)
                  \\;=\;
                  U(1)
                  \\,.
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ^
                    %mi E
                  %mo ⋅
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \hat j_E \cdot \nabla
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ordinary+differential+cohomology"} ordinary differential cohomology
          %p
            In total then, the
            %a.existingWikiWord{:href => "/nlab/show/action+functional"} action functional
            of higher abelian
            %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+theory"} Yang-Mills theory
            in the presence of
            %a.existingWikiWord{:href => "/nlab/show/electric+charge"} electric charge
            is the
            %a.existingWikiWord{:href => "/nlab/show/function"} function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi exp
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} i
                  %msub
                    %mi S
                    %mi YM
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mi{:mathvariant => "normal"} i
                  %msub
                    %mi S
                    %mi el
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %msubsup
                    %mi H
                    %mi diff
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %msubsup
                    %mi H
                    %mi diff
                    %mrow
                      %mi dim
                      %mi X
                      %mo −
                      %mi n
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi ℂ
                %annotation{:encoding => "application/x-tex"}
                  \\exp\big(
                  \\mathrm{i}
                  S_{YM}(-)
                  +
                  \\mathrm{i}
                  S_{el}(-)
                  \\big)
                  \\;\;\colon\;\;
                  H^{n+1}_{diff}(X)
                  \\times
                  H^{dim X - n}_{diff}(X)
                  \\longrightarrow
                  \\mathbb{C}
          %p given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mo{:stretchy => "false"} [
                  %mo ∇
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mo{:stretchy => "false"} [
                  %msub
                    %mover
                      %mi j
                      %mo{:stretchy => "false"} ^
                    %mi E
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ↦
                  %mspace{:width => "thickmathspace"}
                  %mi exp
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} i
                  %mstyle{:displaystyle => "false"}
                    %msub
                      %mo ∫
                      %mi X
                    %msub
                      %mi F
                      %mo ∇
                    %mo ∧
                    %mo ⋆
                    %msub
                      %mi F
                      %mo ∇
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mi exp
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
