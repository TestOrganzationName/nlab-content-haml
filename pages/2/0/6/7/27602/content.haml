          %h2#idea Idea
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/01-bounded+semilattice"} 01-bounded semilattice
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/absorbing+element"} absorbing element
            %strong Phoa’s principle
            states that every
            %a.existingWikiWord{:href => "/nlab/show/endofunction"} endofunction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi L
                  %mo →
                  %mi L
                %annotation{:encoding => "application/x-tex"} f:L \to L
            is
            %a.existingWikiWord{:href => "/nlab/show/monotonic"} monotonic
            and the precomposition function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo ↦
                  %mi h
                  %mo ∘
                  %mi i
                  %mo :
                  %msup
                    %mi L
                    %mi L
                  %mo →
                  %msup
                    %mi L
                    %mi 𝟚
                %annotation{:encoding => "application/x-tex"} h \mapsto h \circ i:L^L \to L^\mathbb{2}
            by the
            %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi 𝟚
                  %mo ↪
                  %mi L
                %annotation{:encoding => "application/x-tex"} i:\mathbb{2} \hookrightarrow L
            of the
            %a.existingWikiWord{:href => "/nlab/show/booleans"} booleans
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is an embedding.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/distributive+lattice"} distributive lattice
            %a.existingWikiWord{:href => "/nlab/show/endofunctions"} endofunctions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi L
                  %mo →
                  %mi L
                %annotation{:encoding => "application/x-tex"} f:L \to L
            and elements
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi L
                  %annotation{:encoding => "application/x-tex"} x \in L
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mo ⊤
                  %mo{:stretchy => "false"} )
                  %mo ∧
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ∨
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mo ⊥
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f(x) = f(\top) \wedge (x \vee f(\bot))
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/Pos"} Pos
            the category of
            %a.existingWikiWord{:href => "/nlab/show/posets"} posets
            and
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monotonic+functions"} monotonic functions
            %a.existingWikiWord{:href => "/nlab/show/boolean+domain"} boolean domain
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝟚
                  %annotation{:encoding => "application/x-tex"} \mathbb{2}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+Stone+duality"} synthetic Stone duality
            %a.existingWikiWord{:href => "/nlab/show/type+of+propositions"} type of
            %a.existingWikiWord{:href => "/nlab/show/open+propositions"} open propositions
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Open
                  %annotation{:encoding => "application/x-tex"} \mathrm{Open}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/synthetic+domain+theory"} synthetic domain theory
            %a.existingWikiWord{:href => "/nlab/show/dominance"} dominance
            = succeed "." do
