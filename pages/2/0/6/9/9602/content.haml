          %h2#idea Idea
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+algebras"} model structure on simplicial algebras
            for
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+Lie+algebras"} simplicial Lie algebras
          %h2#Details Details
          #CategoryOfSimplicialLieAlgebras.num_defn
            %h6#definition Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              some
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/field"} field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi LieAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"} LieAlg_k
              for the
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi LieAlg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo ∈
                    %mi sSetCat
                  %annotation{:encoding => "application/x-tex"}
                    ((LieAlg)_k)^{\Delta^{op}}
                    \\in sSetCat
            %p
              for the category of
              %a.existingWikiWord{:href => "/nlab/show/simplicial+objects"} simplicial objects
              in that category, naturally regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+category"} simplicial category
              %em weak equivalence
              or
              = succeed "," do
                %em fibration
              %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
              is a weak equivalence or fibration, respectively, in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+simplicial+sets"} classical model structure on simplicial sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi LieAlg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi proj
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} ((LieAlg)_k)^{\Delta^{op}}_{proj}
              for the category equipped with these classes of morphism.
          #ProjectiveModelStructureOnSimplicialLieAlgebras.num_prop
            %h6#proposition Proposition
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mi LieAlg
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mi proj
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                  %annotation{:encoding => "application/x-tex"} ((LieAlg)_k)^{\Delta^{op}}_{proj}
              from def.
              %a.maruku-ref{:href => "#CategoryOfSimplicialLieAlgebras"}
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
          %p
            Since
            %a.existingWikiWord{:href => "/nlab/show/Lie+algebras"} Lie algebras
            are algebras over a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theory
            = succeed ")" do
              %a{:href => "https://ncatlab.org/nlab/show/model+structure+on+simplicial+algebras#Reedy74"} Reedy 74, theorem I
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+algebras"} model structure on simplicial algebras
            %a.existingWikiWord{:href => "/nlab/show/reduced+simplicial+sets"} reduced
            simplicial Lie algebras this model structure is a special case of (
            %a{:href => "#Quillen67"}> Quillen 67, II.4 theorem 4
            ) and also left as an exercise for the reader in (
            %a{:href => "#Quillen69"}> Quillen 69, below theorem 4.7
            ).
          %h2#properties Properties
          %h3#relation_to_dglie_algebras Relation to dg-Lie algebras
          #dgLieAlgebraOfASimplicialLieAlgebra.num_defn
            %h6#definition_2 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (\mathfrak{g}, [-,-]
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+Lie+algebra"} simplicial Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/normalized+chains+complex"} normalized chains complex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} N \mathfrak{g}
              of the underlying
              %a.existingWikiWord{:href => "/nlab/show/simplicial+abelian+group"} simplicial abelian group
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebra"} dg-Lie algebra
              by equipping it with the
              %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
              given by the following
              %a.existingWikiWord{:href => "/nlab/show/composition"} composite
              morphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mrow
                        %mi N
                        %mi 𝔤
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ∇
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %msub
                      %mo ⊗
                      %mi k
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} )
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    [-,-]_{N \mathfrak{g}}
                    \\;\colon\;
                    (N \mathfrak{g}) \otimes_k (N \mathfrak{g})
                    \\overset{\nabla}{\longrightarrow}
                    N (\mathfrak{g} \otimes_k \mathfrak{g})
                    \\overset{N([-,-])}{\longrightarrow}
                    N (\mathfrak{g})
            %p
              where the first morphism is the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+map"} Eilenberg-Zilber map
            %p
              This construction extends to a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi LieAlg
                      %mi k
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo ⟶
                    %msub
                      %mi dgLieAlg
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    N
                    \\;\colon\;
                    LieAlg_k^{\Delta^{op}}
                    \\longrightarrow
                    dgLieAlg_k
            %p
              from simplical Lie algebras to
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
          %p
            (
            %a{:href => "#Quillen69"}> Quillen 69, (4.3)
            )
          #NormalizedChainsFromSimplicialLieAlgtodgLieAlgHasLeftAdjoint.num_prop
            %h6#proposition_2 Proposition
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              from simplicial Lie algebras to dg-Lie algebras from def.
              %a.maruku-ref{:href => "#dgLieAlgebraOfASimplicialLieAlgebra"}
              has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi N
                      %mo *
                    %mo ⊣
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi LieAlg
                      %mi k
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi N
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi N
                            %mo *
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (N^* \dashv N)
                    \\;\colon\;
                    LieAlg_k^{\Delta^{op}}
                    \\underoverset
                    {\underset{N}{\longrightarrow}}
                    {\overset{N^*}{\longleftarrow}}
                    {\bot}
                    dgLieAlg_k
                    \\,.
          %p
            This is (
            %a{:href => "#Quillen69"}> Quillen 69, prop. 4.4
            ).
          #QuillenAdjunctionTodgLieAlgebras.num_prop
            %h6#proposition_3 Proposition
            %p
              With respect to the projective model structure on simplicial Lie algebras from prop.
              %a.maruku-ref{:href => "#ProjectiveModelStructureOnSimplicialLieAlgebras"}
              and the projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+dg-Lie+algebras"} model structure on dg-Lie algebras
              (
              %a{:href => "model+structure+on+dg-Lie+algebras#ProjectiveModelStructureOndgLieAlgebras"}> this prop.
              ) the
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              from prop.
              %a.maruku-ref{:href => "#NormalizedChainsFromSimplicialLieAlgtodgLieAlgHasLeftAdjoint"}
              is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi N
                      %mo *
                    %mo ⊣
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi LieAlg
                      %mi k
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mi N
                      %mover
                        %mo ⟵
                        %mrow
                          %msup
                            %mi N
                            %mo *
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi proj
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (N^* \dashv N)
                    \\;\colon\;
                    (LieAlg_k^{\Delta^{op}})_{proj}
                    \\underoverset
                    {\underset{N}{\longrightarrow}}
                    {\overset{N^*}{\longleftarrow}}
                    {\bot}
                    (dgLieAlg_k)_{proj}
                    \\,.
          .proof
            %h6#proof Proof
            %p
              By the standard
              %a.existingWikiWord{:href => "/nlab/show/Dold-Kan+correspondence"} Dold-Kan correspondence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
              preserves fibrations and weak equivalences (
              %a{:href => "Dold-Kan+correspondence#QuillenEquivalenceBetweensAbAndCh"}> this prop.
              ,
              = succeed "," do
                %a{:href => "#SchwedeShipley"} Schwede-Shipley 02, section 4.1
              = succeed ")." do
                %a{:href => "http://www.math.uic.edu/~bshipley/monoidalequi.final.pdf#page=17"} p.17
          .num_prop
            %h6#proposition_4 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
              between
              %a.existingWikiWord{:href => "/nlab/show/homotopy+categories"} homotopy categories
              of the
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
              of the
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
              in prop.
              %a.maruku-ref{:href => "#QuillenAdjunctionTodgLieAlgebras"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi LieAlg
                      %mi k
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟶
                        %mrow
                          %mi ℝ
                          %mi N
                      %mover
                        %mo ⟵
                        %mrow
                          %mi 𝕃
                          %msup
                            %mi N
                            %mo *
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi dgLieAlg
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Ho(LieAlg_k^{\Delta^{op}})
                    \\underoverset
                    {\underset{\mathbb{R}N}{\longrightarrow}}
                    {\overset{\mathbb{L}N^*}{\longleftarrow}}
                    {\bot}
                    Ho(dgLieAlg_k)
            %p
              restricts on connected simplicial algebras and connected
              %a.existingWikiWord{:href => "/nlab/show/dg-Lie+algebras"} dg-Lie algebras
              (meaning: having the trivial Lie algebra in degree 0) to an
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ho
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi LieAlg
                      %mi k
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo ≥
                        %mn 1
                    %munderover
