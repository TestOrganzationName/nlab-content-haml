          %title Equivalence classes
          %h1#equivalence_classes Equivalence classes
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#definitions"} Definitions
              %ul
                %li
                  %a{:href => "#axiomatic"} Axiomatic
                %li
                  %a{:href => "#as_subsets"} As subsets
                %li
                  %a{:href => "#redefined_equality"} Redefined equality
                %li
                  %a{:href => "#as_objects_of_a_groupoid"} As objects of a groupoid
              %li
                %a{:href => "#examples"} Examples
          %h2#idea Idea
          %p
            An equivalence class is an
            %a.existingWikiWord{:href => "/nlab/show/element"} element
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quotient+set"} quotient set
          %h2#definitions Definitions
          %p There are a variety of ways to make this precise.
          %h3#axiomatic Axiomatic
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/set"} set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} {\sim}
            be an
            %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} S/{\sim}
            %strong quotient set
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            modulo
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} \sim
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo ∼
                %annotation{:encoding => "application/x-tex"} [x]_{\sim}
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} /
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} S/{\sim}
            %strong equivalence class
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            modulo
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∼
                  %annotation{:encoding => "application/x-tex"} {\sim}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} S/{\sim}
            is of this form. Furthermore,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo ∼
                %annotation{:encoding => "application/x-tex"} [x]_{\sim}
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi y
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo ∼
                %annotation{:encoding => "application/x-tex"} [y]_{\sim}
            are equal in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} S/{\sim}
            if and only if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∼
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \sim y
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+quotients"} axiom of quotients
            is an axiom of
            %a.existingWikiWord{:href => "/nlab/show/set+theory"} set theory
            which states that the paragraph above is true. It corresponds to the clause in the definition of a
            %a.existingWikiWord{:href => "/nlab/show/pretopos"} pretopos
            (or in
            %a.existingWikiWord{:href => "/nlab/show/Giraud%27s+axioms"} Giraud's axioms
            for a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            %a.existingWikiWord{:href => "/nlab/show/congruence"} congruence
            has a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/coequaliser"} coequaliser
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/intensional+type+theory"} intensional type theory
            such as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            %a.existingWikiWord{:href => "/nlab/show/quotient+sets"} quotient sets
            could be constructed as a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
          %h3#as_subsets As subsets
          %p
            Again, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a set, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} {\sim}
            be an equivalence relation on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            be an element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %strong equivalence class
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            modulo
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} {\sim}
            is the
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            consisting of those elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            that are equivalent to
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo ∼
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi y
                  %mo{:lspace => "verythinmathspace"} :
                  %mi S
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} |
                  %mspace{:width => "thickmathspace"}
                  %mi x
                  %mo ∼
                  %mi y
                  %mo{:stretchy => "false"} }
                  %mo .
                %annotation{:encoding => "application/x-tex"} [x]_{\sim} \coloneqq \{ y\colon S \;|\; x \sim y \} .
          %p
            Then the
            %strong quotient set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} S/{\sim}
            is the collection of these equivalence classes.
          %p
            We may construct this collection using the
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/elementary+topos"} elementary topos
            as well as in such diverse set theories as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/ZFC"} ZFC
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/SEAR"} SEAR
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ETCS"} ETCS
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
          %p
            Any element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is a
            %strong representative
            of its equivalence class
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [x]
            %em is
            the equivalence class in the material set-theoretic sense.
          %p
            One usually defines properties of equivalence classes and functions on quotient sets by defining them for an arbitrary representative, then proving that the result is independent of the representative chosen. This does
            %em not
            require the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/axiom+of+choice"} axiom of choice
          %h3#redefined_equality Redefined equality
          %p
            In some
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/foundations+of+mathematics"} foundations of mathematics
            %a.existingWikiWord{:href => "/nlab/show/presets"} presets
            (sometimes called
            %a.existingWikiWord{:href => "/nlab/show/types"} types
            or, confusingly, sets). By definition, a set (sometimes called a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/setoid"} setoid
          %p
            Once more, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a set, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} {\sim}
            be an equivalence relation on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} S/{\sim}
            is the the underlying preset of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            equipped with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} \sim
            (in place of the original equality on
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo ∼
                %annotation{:encoding => "application/x-tex"} [x]_{\sim}
            is simply
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
          %h3#as_objects_of_a_groupoid As objects of a groupoid
          %p
            One can also consider sets as
            %a.existingWikiWord{:href => "/nlab/show/groupoids"} groupoids
            (or
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"} groupoids
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/discrete+groupoid"} discrete
          %p
            So again, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a set, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} {\sim}
            be an equivalence relation on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo{:stretchy => "false"} /
                  %mo ∼
                %annotation{:encoding => "application/x-tex"} S/{\sim}
            is the (higher) groupoid whose objects are the same as those of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            and with a single morphism from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            iff
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∼
                  %mi y
                %annotation{:encoding => "application/x-tex"} x \sim y
            (and none otherwise);
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi x
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mo ∼
                %annotation{:encoding => "application/x-tex"} [x]_{\sim}
            is simply
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            again.
