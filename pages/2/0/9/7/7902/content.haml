          %h2#idea Idea
          %p
            A
            %em Wilson loop
            or
            %em Wilson line
            is an
            %a.existingWikiWord{:href => "/nlab/show/observable"} observable
            in (both classical and quantum)
            %a.existingWikiWord{:href => "/nlab/show/gauge+theory"} gauge theory
            obtained from the
            %a.existingWikiWord{:href => "/nlab/show/holonomy"} holonomy
            of the
            %a.existingWikiWord{:href => "/nlab/show/gauge+field"} gauge
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
          %p
            Hence if the gauge connection is given by a globally defined 1-form
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %strong Wilson loop
            along a closed
            %a.existingWikiWord{:href => "/nlab/show/loop"} loop
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the trace of the
            %a.existingWikiWord{:href => "/nlab/show/Dyson+formula"} path-ordered exponential
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi W
                    %mi C
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mi Tr
                  %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                  %mi 𝒫
                  %mi exp
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi{:mathvariant => "normal"} i
                  %mstyle{:displaystyle => "false"}
                    %mrow
                      %msub
                        %mo ∮
                        %mi C
                    %msub
                      %mi A
                      %mi μ
                    %mi d
                    %msup
                      %mi x
                      %mi μ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                    %mpadded{:width => "0"}
                      %mrow
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                %annotation{:encoding => "application/x-tex"}
                  W_C
                  \\;=\;
                  Tr\Big(
                  \\mathcal{P}exp\big(
                  \\mathrm{i}
                  \\textstyle{\oint_C} A_\mu d x^\mu
                  \\big)
                  \\Big)
                  \\mathrlap{\,,}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            is the “path-ordering operator” and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi A
                    %mi μ
                %annotation{:encoding => "application/x-tex"} A_\mu
            are the components of the connection.
          %h2#examples Examples
          %h3#in_chernsimons_theory In Chern-Simons theory
          %p
            In
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SU(2)
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            the Wilson line observables compute the
            %a.existingWikiWord{:href => "/nlab/show/Jones+polynomial"} Jones polynomial
            of the given curve. See there for more details.
          %h3#in_rozanskywitten_theory In Rozansky-Witten theory
          #RozanskyWittenWilsonLoopOfUnknotIsSquareRootOfAHat.num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Rozansky-Witten+Wilson+loop+of+unknot+is+A-hat+genus"}> Rozansky-Witten Wilson loop of unknot is square root of A-hat genus
                )
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℳ
                      %mrow
                        %mn 4
                        %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{M}^{4n}
              a
              %a.existingWikiWord{:href => "/nlab/show/hyperk%C3%A4hler+manifold"} hyperkähler manifold
              (or just a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/holomorphic+symplectic+manifold"} holomorphic symplectic manifold
              %a.existingWikiWord{:href => "/nlab/show/Rozansky-Witten+invariant"} Rozansky-Witten invariant
              %a.existingWikiWord{:href => "/nlab/show/Wilson+loop+observable"} Wilson loop observable
              associated with the
              %a.existingWikiWord{:href => "/nlab/show/unknot"} unknot
              in the
              %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
              is the
              %a.existingWikiWord{:href => "/nlab/show/square+root"} square root
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msqrt
                      %mrow
                        %mover
                          %mi A
                          %mo ^
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi ℳ
                          %mrow
                            %mn 4
                            %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sqrt{{\widehat A}(\mathcal{M}^{4n})}
              of the
              %a.existingWikiWord{:href => "/nlab/show/A-hat+genus"} A-hat genus
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℳ
                        %mrow
                          %mn 4
                          %mi n
                    %annotation{:encoding => "application/x-tex"} \mathcal{M}^{4n}
          %p
            This is
            = succeed "," do
              %a{:href => "Rozansky-Witten+Wilson+loop+of+unknot+is+A-hat+genus#RobertsWillerton10"} Roberts-Willerton 10, Lemma 8.6
            %a.existingWikiWord{:href => "/nlab/show/Wheels+theorem"} Wheels theorem
            and the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hitchin-Sawon+theorem"} Hitchin-Sawon theorem
          %h2#properties Properties
          %h3#relation_to_1d_chernsimons_theory Relation to 1d Chern-Simons theory
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a suitable
            %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            (compact, semi-simple and simply connected) the Wilson loops of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/principal+connections"} principal connections
            are equivalently the
            %a.existingWikiWord{:href => "/nlab/show/partition+functions"} partition functions
            of a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/1-dimensional+Chern-Simons+theory"} 1-dimensional Chern-Simons theory
          %p
            This appears famously in the formulation of
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            = succeed "." do
              %a{:href => "Chern-Simons+theory#WithWilsonLineObservables"} with Wilson lines
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/orbit+method"} orbit method
          %h3#as_the_universal_vassiliev_invariant As the universal Vassiliev invariant
          %p
            The un-traced
            %a.existingWikiWord{:href => "/nlab/show/Wilson+loop+observable"} Wilson loop observable
            of
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantization+of+3d+Chern-Simons+theory"} perturbative Chern-Simons theory
            is the
            %a.existingWikiWord{:href => "/nlab/show/universal+Vassiliev+invariant"} universal Vassiliev invariant
            (see there for more):
          %center
            %img{:src => "https://ncatlab.org/nlab/files/UniversalWilsonLoopObservable.jpg", :width => "700"}/
          %center
            %img{:src => "https://ncatlab.org/nlab/files/TheGrandStoryOfVassilievKnotInvariants.jpg", :width => "800"}/
          %blockquote
            %p
              from
              %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Sati-Schreiber 19c
          %h3#relation_to_defects Relation to defects
          %p
            Wilson loop insertions may be thought of or at least related to
            %em defects
            in the sense of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/QFT+with+defects"} QFT with defects
          %h3#duality_with_t_hooft_operators_under_sduality_and_geometric_langlands Duality with ‘t Hooft operators under S-duality and geometric Langlands
          %p
            %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
            of 4d
            %a.existingWikiWord{:href => "/nlab/show/super+Yang-Mills+theory"} super Yang-Mills theory
            may exchange Wilson loop operators with
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%27t+Hooft+operators"} 't Hooft operators
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
            (
            %a{:href => "#KapustinWitten06"}> Kapustin-Witten 06
            )
          %div
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/S-duality"} S-duality
                    in
                    %a.existingWikiWord{:href => "/nlab/show/N%3D4+D%3D4+super+Yang-Mills+theory"} N=4 D=4 super Yang-Mills theory
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Hecke+transformation"} Hecke transformation
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/%27t+Hooft+operator"} 't Hooft operator
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/local+system"}> local system
                    \/
                    %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/electric+eigenbrane"} electric eigenbrane
                    (eigenbrane of
                    = succeed ")" do
                      %a.existingWikiWord{:href => "/nlab/show/Wilson+operator"} Wilson operator
                %tr
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/Hecke+eigensheaf"} Hecke eigensheaf
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/magnetic+eigenbrane"} magnetic eigenbrane
                    (eigenbrane of
                    %a.existingWikiWord{:href => "/nlab/show/%27t+Hooft+operator"} 't Hooft operator
                    )
            %p
              (
              %a{:href => "geometric+Langlands+correspondence#KapustinWitten06"}> Kapustin-Witten 06
              )
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/flux+tube"} flux tube
            %li
