              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/supermanifolds"} supermanifolds
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Felix+A.+Berezin"}> Felix A. Berezin
                  , M. S. Marinov:
                  = succeed "," do
                    %em Particle Spin Dynamics as the Grassmann Variant of Classical Mechanics
                  %strong 104
                  2 (1977) 336-362 [
                  %a{:href => "https://doi.org/10.1016/0003-4916(77)90335-9"}> doi:10.1016/0003-4916(77)90335-9
                  ,
                  = succeed "," do
                    %a{:href => "https://inis.iaea.org/collection/NCLCollectionStore/_Public/09/348/9348577.pdf"} pdf
                  = succeed "]" do
                    %a.existingWikiWord{:href => "/nlab/files/BerezinMarinov-ParticleSpin.pdf", :title => "pdf"} pdf
                %p
                  reprinted in Appendix I of:
                  %a.existingWikiWord{:href => "/nlab/show/Alexandre+A.+Kirillov"} Alexandre A. Kirillov
                  (ed.):
                  = succeed "," do
                    %em Introduction to Superanalysis
                  = succeed "," do
                    %strong 9
                  = succeed "&rbrack;" do
                    %a{:href => "https://doi.org/10.1007/978-94-017-1963-6"} doi:10.1007/978-94-017-1963-6
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Schmitt"}> Thomas Schmitt
                  \:
                  %em The Cauchy Problem for Classical Field Equations with Ghost and Fermion Fields
                  [
                  %a{:href => "https://arxiv.org/abs/hep-th/9607133"}> arXiv:hep-th/9607133
                  ]
              %li#Schmitt97
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Schmitt"}> Thomas Schmitt
                  \:
                  = succeed "," do
                    %em Supergeometry and Quantum Field Theory, or: What is a Classical Configuration?
                  %strong 9
                  (1997) 993-1052 [
                  %a{:href => "https://doi.org/10.1142/S0129055X97000348"}> doi:10.1142/S0129055X97000348
