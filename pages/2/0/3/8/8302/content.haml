                  of a
                  %a.existingWikiWord{:href => "/nlab/show/flat+%28%E2%88%9E%2C1%29-bundle"} flat
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-module bundle
              %li
                %p
                  sending a
                  %a.existingWikiWord{:href => "/nlab/show/flat+%28%E2%88%9E%2C1%29-bundle"} flat
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-module bundle
                  to its
