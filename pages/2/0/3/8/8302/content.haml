                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (H k)
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module"} (∞,1)-module
              of sections of the trivial
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
