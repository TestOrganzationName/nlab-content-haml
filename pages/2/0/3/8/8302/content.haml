                        %a.existingWikiWord{:href => "/nlab/show/Eilenberg-Zilber+theorem"} Eilenberg-Zilber theorem
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/cochain+on+a+simplicial+set"} cochain on a simplicial set
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/universal+coefficient+theorem"} universal coefficient theorem
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/K%C3%BCnneth+theorem"} Künneth theorem
          %h1#contents Contents
          .maruku_toc
            %ul
              %li
                %a{:href => "#idea"} Idea
              %li
                %a{:href => "#properties"} Properties
              %ul
                %li
                  %a{:href => "#relation_to_homotopy_groups"} Relation to homotopy groups
                %li
                  %a{:href => "#InTermsOfHigherLinearAlgebra"} Description in terms of higher linear algebra
                %li
                  %a{:href => "#ordinary_homology_spectra_split"} Ordinary homology spectra split
              %li
                %a{:href => "#related_concepts"} Related concepts
              %li
                %a{:href => "#references"} References
          %h2#idea Idea
          %p
            %em Ordinary homology
            is
            %a.existingWikiWord{:href => "/nlab/show/generalized+homology"} generalized homology
            with respect to an
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi A
                  %annotation{:encoding => "application/x-tex"} H A
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} H \mathbb{Z}
          %p
            Equivalently this is computed by
            %em
              %a.existingWikiWord{:href => "/nlab/show/singular+homology"} singular homology
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %h2#properties Properties
          %h3#relation_to_homotopy_groups Relation to homotopy groups
          %p
            Ordinary homology with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            of a
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            serves to approximate the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            See for instance at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Hurewicz+theorem"} Hurewicz theorem
          %h3#InTermsOfHigherLinearAlgebra Description in terms of higher linear algebra
          %p
            We discuss (
            %a.existingWikiWord{:href => "/nlab/show/twisted+cohomology"}> twisted
            ) ordinary homology and
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            in terms of sections of
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundles"} (∞,1)-module bundles
            over the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mi k
                  %mo ∈
                  %msub
                    %mi CRing
                    %mn ∞
                %annotation{:encoding => "application/x-tex"}
                  H k \in CRing_\infty
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/E-%E2%88%9E+ring"} E-∞ ring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mi Mod
                  %mo ∈
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mi Cat
                %annotation{:encoding => "application/x-tex"}
                  (H k) Mod \in (\infty,1)Cat
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-modules"} (∞,1)-category of (∞,1)-modules
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi k
                  %annotation{:encoding => "application/x-tex"} H k
          #DoldKan.num_prop
            %h6#proposition Proposition
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi Mod
                    %mo ≃
                    %msub
                      %mi L
                      %mi qi
                    %msub
                      %mi Ch
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mi Mod
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (H k)Mod \simeq L_{qi} Ch_\bullet(k Mod)
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-modules"} (∞,1)-category of (∞,1)-modules
              over the
              %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} Eilenberg-MacLane spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mi k
                  %annotation{:encoding => "application/x-tex"} H k
              and the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+localization"} simplicial localization
              of the
              %a.existingWikiWord{:href => "/nlab/show/category+of+unbounded+chain+complexes"} category of unbounded chain complexes
              of ordinary (1-categorical)
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/modules"} modules
          %p
            This is the statement of the
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/stable+Dold-Kan+correspondence"} stable Dold-Kan correspondence
            = succeed "." do
              %em
                %a{:href => "%28infinity%2C1%29-module#StableDoldKanCorrespondence"} (∞,1)-category of (∞,1)-modules – Properties – Stable Dold-Kan correspondence
          .num_defn
            %h6#definition Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \Pi(X) \in
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              for its underlying
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
              (its
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/fundamental+%E2%88%9E-groupoid"} fundamental ∞-groupoid
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    \\Pi(X) \to (H k) Mod
            %p
              is (the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/higher+parallel+transport"} higher parallel transport
              %em
                %a.existingWikiWord{:href => "/nlab/show/flat+%28%E2%88%9E%2C1%29-bundle"} flat
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundle"} (∞,1)-module bundle
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %em
                %a.existingWikiWord{:href => "/nlab/show/local+system"} local system
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mi k
                    %annotation{:encoding => "application/x-tex"} H k
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-modules"} (∞,1)-modules
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
          .num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Riemann-Hilbert+correspondence"}> Riemann-Hilbert correspondence
                )
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is an
              %a.existingWikiWord{:href => "/nlab/show/orientation"} oriented
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+manifold"} closed manifold
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+%28%E2%88%9E%2C1%29-categories"} equivalence of (∞,1)-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi Mod
                    %mo{:stretchy => "false"} ]
                    %mo ≃
                    %mo{:stretchy => "false"} (
                    %mi T
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    [\Pi(X), (H k)Mod]
                    \\simeq
                    (T X)Mod
            %p
              between
              %a.existingWikiWord{:href => "/nlab/show/flat+%28%E2%88%9E%2C1%29-bundle"} flat
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-module+bundles"} (∞,1)-module bundles
              %a.existingWikiWord{:href => "/nlab/show/local+systems"} local systems
              and
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebroid+representations"} L-∞ algebroid representations
              of the
              %a.existingWikiWord{:href => "/nlab/show/tangent+Lie+algebroid"} tangent Lie algebroid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/L-%E2%88%9E+algebroid+representation"} L-∞ algebroid representation
              given (as discussed there) by a flat
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              = succeed ")," do
                %a.maruku-ref{:href => "#DoldKan"}
              %a.existingWikiWord{:href => "/nlab/show/higher+holonomy"} higher holonomy
              defined in terms of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/iterated+integrals"} iterated integrals
          %p
            This is the main theorem in (
            %a{:href => "#BlockSmith09"}> Block-Smith 09
            ).
          .num_defn
            %h6#definition_2 Definition
            %p Write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %mi lim
                      %mo →
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi Π
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi Mod
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma \;\coloneqq\; \underset{\to}{\lim} \;\colon\;
