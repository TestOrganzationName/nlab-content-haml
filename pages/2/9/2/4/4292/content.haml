                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 0
                  %mfrac
                    %mrow
                      %msup
                        %mi r
                        %munder
                          %mi k
                          %mo ̲
                      %msup
                        %mi x
                        %mi k
                    %mrow
                      %mi k
                      %mo !
                %annotation{:encoding => "application/x-tex"} (1 + x)^r \coloneqq \exp(r \log(1 + x)) = \sum_{k \geq 0} \frac{r^\underline{k} x^k}{k!}
          %p
            where, remarkably,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is an arbitrary element of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          %h2#ring_of_power_series_as_rings_with_infinitesimals Ring of power series as rings with infinitesimals
          %table
            %thead
