                  %msup
                    %mi R
                    %mi ℕ
                %annotation{:encoding => "application/x-tex"} R^\mathbb{N}
            of the
            %a.existingWikiWord{:href => "/nlab/show/endofunctor"} endofunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo ×
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:lspace => "verythinmathspace"} :
                  %mi Set
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} R \times - \colon Set \to Set
            via the map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
