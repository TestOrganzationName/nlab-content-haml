                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[ [X]]
            may be identified with the
            %a.existingWikiWord{:href => "/nlab/show/terminal+coalgebra+of+an+endofunctor"} terminal coalgebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
