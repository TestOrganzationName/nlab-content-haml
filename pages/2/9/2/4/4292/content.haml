                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} K[[\epsilon]]
            by its ideal of non-invertible elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϵ
                  %mi K
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \epsilon K[[\epsilon]]
            is the
            %a.existingWikiWord{:href => "/nlab/show/residue+field"} residue field
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            itself, and the canonical function used in defining the quotient is the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
