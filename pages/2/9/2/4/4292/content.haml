          %h2#definition Definition
          %p
            A power series in a
            %a.existingWikiWord{:href => "/nlab/show/variable"} variable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in a
            %a.existingWikiWord{:href => "/nlab/show/ring"} ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is a
            %a.existingWikiWord{:href => "/nlab/show/series"} series
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %msub
                    %mi a
                    %mi n
                  %msup
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{n = 0}^\infty a_n X^n
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi n
                %annotation{:encoding => "application/x-tex"} a_n
            is in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            for each
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n\ge 0
            = succeed "." do
              %strong formal power series
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is commutative, then the collection of formal power series in a variable
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            with coefficients in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            forms a commutative ring denoted by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R [ [ X ] ]
          %p
            More generally, a power series in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            commuting variables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi X
                    %mi k
                %annotation{:encoding => "application/x-tex"} X_1,\ldots, X_k
            with coefficients in a ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has the form
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo =
                        %mn 0
                        %mo ,
                        %msub
                          %mi n
                          %mn 2
                        %mo =
                        %mn 0
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi n
                          %mi k
                        %mo =
                        %mn 0
                      %mn ∞
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mi …
                        %msub
                          %mi n
                          %mi k
                    %msubsup
                      %mi X
                      %mn 1
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %msubsup
                      %mi X
                      %mn 2
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mi ⋯
                    %msubsup
                      %mi X
                      %mi k
                      %mrow
                        %msub
                          %mi n
                          %mi k
                  %annotation{:encoding => "application/x-tex"} \sum_{n_1=0,n_2=0,\ldots, n_k = 0}^\infty a_{n_1\ldots n_k} X_1^{n_1} X_2^{n_2}\cdots X_k^{n_k}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is commutative, then the collection of formal power series in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            commuting variables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi X
                    %mi k
                %annotation{:encoding => "application/x-tex"} X_1,\ldots, X_k
            form a formal power series ring denoted by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi X
                      %mi k
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    R [ [ X_1,\ldots, X_k
                    ] ]
          %p
            More generally, we can consider noncommutative (associative unital) ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            and words in noncommutative variables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi X
                    %mi k
                %annotation{:encoding => "application/x-tex"} X_1,\ldots, X_k
            of the form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                  %mo =
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mi i
                        %mn 1
                  %mi ⋯
                  %msub
                    %mi X
                    %mrow
                      %msub
                        %mi i
                        %mi m
                %annotation{:encoding => "application/x-tex"}
                  w = X_{i_1}\cdots X_{i_m}
          %p
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                %annotation{:encoding => "application/x-tex"} m
            has nothing to do with
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi w
                  %mo ∈
                  %mi R
                %annotation{:encoding => "application/x-tex"} a_w \in R
            (here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            is a word of any length, not a multiindex in the previous sense). Thus the power sum is of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi w
                  %msub
                    %mi a
                    %mi w
                  %msub
                    %mi X
                    %mi w
                %annotation{:encoding => "application/x-tex"} \sum_w a_w X_w
            and they form a formal power series ring in variables
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi X
                    %mi k
                %annotation{:encoding => "application/x-tex"} X_1,\ldots, X_k
            denoted by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} ⟨
                    %mo{:stretchy => "false"} ⟨
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi X
                      %mi k
                    %mo{:stretchy => "false"} ⟩
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} R\langle \langle X_1,\ldots, X_k \rangle\rangle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            can be even a noncommutative
            %a.existingWikiWord{:href => "/nlab/show/semiring"} semiring
            in which case the words belong to the free monoid on the set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi X
                      %mi k
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S = \{ X_1,\ldots, X_k\}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} ⟨
                    %mi S
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"} R\langle S\rangle
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi r
                  %msub
                    %mi a
                    %mi r
                  %msub
                    %mi X
                    %mi r
                  %mo ⋅
                  %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                  %msub
                    %mi b
                    %mi s
                  %msub
                    %mi X
                    %mi s
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi w
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi u
                      %mo ,
                      %mi v
                      %mo ;
                      %mi w
                      %mo =
                      %mi u
                      %mi v
                  %msub
                    %mi a
                    %mi u
                  %msub
                    %mi b
                    %mi v
                  %msub
                    %mi X
                    %mi w
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{r} a_r X_r \cdot \sum b_s X_s = \sum_w \sum_{u,v; w = u v} a_u b_v X_w
          %p
            Of course, this implies that in a specialization,
            = succeed "-s" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %msub
                          %mi i
                          %mi k
                  %annotation{:encoding => "application/x-tex"} X_{i_k}
          %h3#as_adic_completions As adic completions
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[X]
            be the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            on one indeterminant
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X)
            is a
            %a.existingWikiWord{:href => "/nlab/show/maximal+ideal"} maximal ideal
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[X]
            %a.existingWikiWord{:href => "/nlab/show/adic+topology"} adic topology
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[X]
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is the
            %a.existingWikiWord{:href => "/nlab/show/adic+completion"} adic completion
            of the
            %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            of the quotient of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[X]
            by powers of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo ≔
                  %munder
                    %mi lim
                    %mo ←
                  %mi R
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi X
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                %annotation{:encoding => "application/x-tex"} R[[X]] \coloneqq \underset{\leftarrow}\lim R/(X)^n
          %p
            The ring of formal power series for multiple indeterminants
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi X
                    %mi i
                %annotation{:encoding => "application/x-tex"} X_i
            is constructed iteratively: because
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi X
                    %mn 2
                  %mo ,
                  %mi …
                  %msub
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[[X_1, X_2, \ldots X_n]]
            is a commutative ring, one could construct the
            %a.existingWikiWord{:href => "/nlab/show/polynomial+ring"} polynomial ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi X
                    %mn 2
                  %mo ,
                  %mi …
                  %msub
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[[X_1, X_2, \ldots X_n]][X_{n+1}]
            on the indeterminant
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} X_{n+1}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X_{n+1})
            is a
            %a.existingWikiWord{:href => "/nlab/show/maximal+ideal"} maximal ideal
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi X
                    %mn 2
                  %mo ,
                  %mi …
                  %msub
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[[X_1, X_2, \ldots X_n]][X_{n+1}]
            with a corresponding
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/adic+topology"} adic topology
            %a.existingWikiWord{:href => "/nlab/show/adic+completion"} adic completion
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi X
                    %mn 2
                  %mo ,
                  %mi …
                  %msub
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo ≔
                  %munder
                    %mi lim
                    %mo ←
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi X
                    %mn 1
                  %mo ,
                  %msub
                    %mi X
                    %mn 2
                  %mo ,
                  %mi …
                  %msub
                    %mi X
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi X
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi m
                %annotation{:encoding => "application/x-tex"} R[[X_1, X_2, \ldots X_n]][[X_{n+1}]] \coloneqq \underset{\leftarrow}\lim R[[X_1, X_2, \ldots X_n]]/(X_{n+1})^m
          %p
            The resulting commutative ring is usually just written as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %mi …
                    %msub
                      %mi X
                      %mi n
                    %mo ,
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[[X_1, X_2, \ldots X_n, X_{n+1}]]
          %h2#examples Examples
          %h3#polynomials Polynomials
          %p
            For a natural number
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %msub
                    %mi a
                    %mi n
                  %msup
                    %mi X
                    %mi n
                %annotation{:encoding => "application/x-tex"} \sum_{n=0}^\infty a_n X^n
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mi n
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} a_n = 0
            for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo &gt;
                  %mi k
                %annotation{:encoding => "application/x-tex"} n \gt k
            is a
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            of degree at most
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
          %h3#taylor_series Taylor series
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Taylor+series"} Taylor series
          %h3#maclaurin_series MacLaurin series
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f \in C^\infty(\mathbb{R})
            a
            %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
            on the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo ∈
                  %msup
                    %mi C
                    %mn ∞
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^{(n)} \in C^\infty(\mathbb{R})
            denoting its
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            its
            %a.existingWikiWord{:href => "/nlab/show/MacLaurin+series"} MacLaurin series
            (its
            %a.existingWikiWord{:href => "/nlab/show/Taylor+series"} Taylor series
            at
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %mfrac
                    %mn 1
                    %mrow
                      %mi n
                      %mo !
                  %msup
                    %mi f
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi x
                    %mi n
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\sum_{n = 0}^\infty
                  \\frac{1}{n!} f^{(n)}(0) x^n
                  \\,.
          %p
            If this power series
            %a.existingWikiWord{:href => "/nlab/show/convergence"} converges
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/analytic+function"} analytic
          %h3#laurent_series Laurent series
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Laurent+series"} Laurent series
          %h3#puiseux_series Puiseux series
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Puiseux+series"} Puiseux series
          %h2#properties Properties
          %ul
            %li
              An element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %msub
                      %mi a
                      %mn 0
                    %mo +
                    %msub
                      %mi a
                      %mn 1
                    %mi x
                    %mo +
                    %msub
                      %mi a
                      %mn 2
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %mi …
                  %annotation{:encoding => "application/x-tex"} a = a_0 + a_1 x + a_2 x^2 + \ldots
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[ [x] ]
              is (multiplicatively) invertible iff
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} a_0
              is invertible.
          %p
            This follows easily from the observation that we can invert
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo +
                  %mi x
                  %mi b
                %annotation{:encoding => "application/x-tex"} 1 + x b
            for any power series
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            by forming
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %mo −
                  %mi x
                  %mi b
                  %mo +
                  %msup
                    %mi x
                    %mn 2
                  %msup
                    %mi b
                    %mn 2
                  %mo −
                  %mi …
                %annotation{:encoding => "application/x-tex"} 1 - x b + x^2 b^2 - \ldots
            and collecting only finitely many terms in each degree. As a simple corollary,
          %ul
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[ [X] ]
              is also a local ring.
          %h3#functional_substitution_and_inversion Functional substitution and inversion
          .num_prop
            %h6#proposition Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[ [x_1, \ldots, x_n] ]
              equipped with the ideal
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x_1, \ldots, x_n)
              is the free
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} adic
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              generators, in the sense that it is the value of the left adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Pow
                  %annotation{:encoding => "application/x-tex"} Pow
              to the forgetful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ideal
                    %mo :
                    %mi AdicRAlg
                    %mo →
                    %mi Set
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi I
                  %annotation{:encoding => "application/x-tex"} Ideal: AdicRAlg \to Set: (A, I) \mapsto I
            %p
              as applied to the set
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi x
                        %mn 1
                      %mo ,
                      %mi …
                      %mo ,
                      %msub
                        %mi x
                        %mi n
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{x_1, \ldots, x_n\}
          .proof
            %h6#proof Proof
            %p
              The idea is that for each adic
              = succeed "-algebra" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S, I)
              and element
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mn 1
                      %mo ,
                      %mi …
                      %msub
                        %mi s
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msup
                        %mi I
                        %mi n
                    %annotation{:encoding => "application/x-tex"} (s_1, \ldots s_n) \in I^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi S
                  %annotation{:encoding => "application/x-tex"} R[ [x_1, \ldots, x_n] ] \to S
              that sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi x
                      %mi i
                  %annotation{:encoding => "application/x-tex"} x_i
              to
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mi i
                    %annotation{:encoding => "application/x-tex"} s_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %msub
                      %mi a
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                        %mo ,
                        %mi …
                        %mo ,
                        %msub
                          %mi k
                          %mi n
                    %msubsup
                      %mi x
                      %mn 1
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %msubsup
                      %mi x
                      %mi n
                      %mrow
                        %msub
                          %mi k
                          %mi n
                  %annotation{:encoding => "application/x-tex"} \sum a_{k_1, \ldots, k_n} x_1^{k_1} x_n^{k_n}
              to the sequence of truncations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                            %mo +
                            %mi …
                            %mo +
                            %msub
                              %mi k
                              %mi n
                            %mo &lt;
                            %mi k
                        %msub
                          %mi a
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                            %mo ,
                            %mi …
                            %mo ,
                            %msub
                              %mi k
                              %mi n
                        %msubsup
                          %mi s
                          %mn 1
                          %mrow
                            %msub
                              %mi k
                              %mn 1
                        %mi …
                        %msubsup
                          %mi s
                          %mi n
                          %mrow
                            %msub
                              %mi k
                              %mi n
                        %mo{:lspace => "mediummathspace", :rspace => "mediummathspace"} mod
                        %msup
                          %mi I
                          %mi k
                        %mo )
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \left(\sum_{k_1 + \ldots + k_n \lt k} a_{k_1, \ldots, k_n} s_1^{k_1} \ldots s_n^{k_n} \mod I^k\right)_k
            %p
              belonging to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %munder
                          %mi lim
                          %mo ⟵
                        %mi k
                      %mi S
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi I
                        %mi k
                      %mo ≅
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \underset{\longleftarrow}{\lim}_k S/I^k \cong S
          %p
            It follows that we may define a clone or cartesian operad as follows: the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi n
                    %mi th
                %annotation{:encoding => "application/x-tex"} n^{th}
            component is the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mi n
                  %mo =
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⊂
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} I_n = (x_1, \ldots, x_n) \subset R[ [x_1, \ldots, x_n] ]
            which is the monad value
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ideal
                    %mi Pow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} }
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ideal Pow(\{x_1, \ldots, x_n\})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            denote the monad
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ideal
                    %mo ∘
                    %mi Pow
                  %annotation{:encoding => "application/x-tex"} Ideal \circ Pow
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            the set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi x
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi x
                      %mi n
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{x_1, \ldots, x_n\}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi I
                    %mi n
                  %mo ×
                  %msubsup
                    %mi I
                    %mi k
                    %mi n
                  %mo →
                  %msub
                    %mi I
                    %mi k
                %annotation{:encoding => "application/x-tex"} I_n \times I_k^n \to I_k
          %p is the composition of the maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi k
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi n
                  %mo ≅
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mn 1
                      %mo ×
                      %mi func
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi M
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi eval
                  %mi M
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %mi μ
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                  %mi M
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} M(n) \times M(k)^n \cong M(n) \times \hom([n], M(k)) \stackrel{1 \times func}{\to} M(n) \times \hom(M(n), M M(k)) \stackrel{eval}{\to} M M(k) \stackrel{\mu(k)}{\to} M(k)
          %p
            The clone multiplication thus defined is called
            = succeed ";" do
              %em substitution of power series
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi I
                    %mi n
                  %mo ,
                  %msub
                    %mi q
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %msub
                    %mi x
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi I
                    %mi k
                  %mo ,
                  %mi …
                  %msub
                    %mi q
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi I
                    %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(x_1, \ldots, x_n) \in I_n, q_1(x_1, \ldots x_k) \in I_k, \ldots q_n(x_1, \ldots, x_k) \in I_k)
            to a power series denoted as
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi q
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi …
                  %msub
                    %mi q
                    %mi n
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"} p(q_1(x_1, \ldots, x_k), \ldots q_n(x_1, \ldots, x_k)).
          %p
            The resulting clone or operad yields, in the particular case
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = n = 1
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi x
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mi sub
                  %mi x
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} x R[ [x] ] \times x R[ [x] ] \stackrel{sub}{\to} x R[ [x] ]
          %p
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi sub
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                  %mo ∘
                  %mi q
                %annotation{:encoding => "application/x-tex"} sub(p, q) = p \circ q
            the power series
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} p(q(x))
          #InvertibleElements.num_prop
            %h6#proposition_2 Proposition
            %p
              The group of invertible elements in the substitution monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} x R[ [x] ]
              consists of power series of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mi x
                    %mo +
                    %msub
                      %mi a
                      %mn 2
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %mi …
                  %annotation{:encoding => "application/x-tex"} a_1 x + a_2 x^2 + \ldots
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} a_1
              is multiplicatively invertible in the ring
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
          %p
            In other words, we can functionally invert a power series provided that the linear coefficient
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi a
                    %mn 1
                %annotation{:encoding => "application/x-tex"} a_1
            is invertible in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .proof
            %h6#proof_2 Proof
            %p
              Given power series
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo =
                    %msub
                      %mi a
                      %mn 1
                    %mi x
                    %mo +
                    %msub
                      %mi a
                      %mn 2
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %mi …
                  %annotation{:encoding => "application/x-tex"} a = a_1 x + a_2 x^2 + \ldots
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo =
                      %msub
                        %mi b
                        %mn 1
                      %mi x
                      %mo +
                      %msub
                        %mi b
                        %mn 2
                      %msup
                        %mi x
                        %mn 2
                      %mo +
                      %mi …
                    %annotation{:encoding => "application/x-tex"} b = b_1 x + b_2 x^2 + \ldots
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∘
                    %mi b
                  %annotation{:encoding => "application/x-tex"} a \circ b
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ∘
                    %mi b
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo ≥
                        %mn 1
                    %msub
                      %mi a
                      %mi n
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi k
                        %mo =
                        %msub
                          %mi k
                          %mn 1
                        %mo +
                        %mi …
                        %mo +
                        %msub
                          %mi k
                          %mi n
                    %msub
                      %mi b
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %msub
                      %mi b
                      %mrow
                        %msub
                          %mi k
                          %mn 2
                    %mi …
                    %msub
                      %mi b
                      %mrow
                        %msub
                          %mi k
                          %mi n
                  %annotation{:encoding => "application/x-tex"} (a \circ b)_k = \sum_{n \geq 1} a_n \sum_{k = k_1 + \ldots + k_n} b_{k_1} b_{k_2} \ldots b_{k_n}
            %p
              where in particular
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ∘
                      %mi b
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                      %mo =
                      %msub
                        %mi a
                        %mn 1
                      %msub
                        %mi b
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} (a \circ b)_1 = a_1 b_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              is the left functional inverse of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              is the right inverse of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ∘
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi x
                    %annotation{:encoding => "application/x-tex"} (a \circ b)(x) = x
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ∘
                    %mi b
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} (a \circ b)_k = 1
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              otherwise. The first equation says simply
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ∘
                    %mi b
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 1
                    %mo =
                    %msub
                      %mi a
                      %mn 1
                    %msub
                      %mi b
                      %mn 1
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} (a \circ b)_1 = a_1 b_1 = 1
              which implies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} a_1
              is invertible. Conversely, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} a_1
              is multiplicatively invertible and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mn 1
                      %mo =
                      %msubsup
                        %mi a
                        %mn 1
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} b_1 = a_1^{-1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi n
                                %mo ≥
                                %mn 1
                            %msub
                              %mi a
                              %mi n
                            %munder
                              %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                              %mrow
                                %mi k
                                %mo =
                                %msub
                                  %mi k
                                  %mn 1
                                %mo +
                                %mi …
                                %mo +
                                %msub
                                  %mi k
                                  %mi n
                            %msub
                              %mi b
                              %mrow
                                %msub
                                  %mi k
                                  %mn 1
                            %msub
                              %mi b
                              %mrow
                                %msub
                                  %mi k
                                  %mn 2
                            %mi …
                            %msub
                              %mi b
                              %mrow
                                %msub
                                  %mi k
                                  %mi n
                          %mtd
                            %mo =
                            %mn 1
                            %mspace{:width => "thickmathspace"}
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi k
                            %mo =
                            %mn 1
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                            %mspace{:width => "thickmathspace"}
                            %mi if
                            %mspace{:width => "thickmathspace"}
                            %mi k
                            %mo ≠
                            %mn 1
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\sum_{n \geq 1} a_n \sum_{k = k_1 + \ldots + k_n} b_{k_1} b_{k_2} \ldots b_{k_n} &amp; = 1\; if\; k = 1 \\
                    \&amp; = 0\; if\; k \neq 1
                    }
            %p
              may be uniquely solved for the remaining
              = succeed "'s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi i
                    %annotation{:encoding => "application/x-tex"} a_i
              = succeed "'s," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mi j
                    %annotation{:encoding => "application/x-tex"} b_j
              = succeed "'s" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mi j
                    %annotation{:encoding => "application/x-tex"} b_j
              = succeed "'s," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi i
                    %annotation{:encoding => "application/x-tex"} a_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≠
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k \neq 1
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %msub
                      %mi b
                      %mi k
                    %mo +
                    %msub
                      %mi a
                      %mi k
                    %msubsup
                      %mi b
                      %mn 1
                      %mi k
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mi terms
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi a
                      %mi n
                    %msub
                      %mi b
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %mi …
                    %msub
                      %mi b
                      %mrow
                        %msub
                          %mi k
                          %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} a_1 b_k + a_k b_1^k + \; terms\; a_n b_{k_1} \ldots b_{k_n} = 0
            %p
              and this allows us to solve for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi b
                        %mi k
                    %annotation{:encoding => "application/x-tex"} b_k
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mi k
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msubsup
                      %mi a
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi a
                      %mi k
                    %msubsup
                      %mi b
                      %mn 1
                      %mi k
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mi terms
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi a
                      %mi n
                    %msub
                      %mi b
                      %mrow
                        %msub
                          %mi k
                          %mn 1
                    %mi …
                    %msub
                      %mi b
                      %mrow
                        %msub
                          %mi k
                          %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b_k = -a_1^{-1}(a_k b_1^k + \; terms\; a_n b_{k_1} \ldots b_{k_n})
            %p
              given the values
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi a
                      %mi k
                  %annotation{:encoding => "application/x-tex"} a_1, \ldots, a_k
              and earlier
              = succeed "-values" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                    %annotation{:encoding => "application/x-tex"} b
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mrow
                        %msub
                          %mi k
                          %mi j
                  %annotation{:encoding => "application/x-tex"} b_{k_j}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi k
                      %mi j
                    %mo &lt;
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k_j \lt k
              given by inductive hypothesis. Similarly we can solve for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi a
                      %mi k
                  %annotation{:encoding => "application/x-tex"} a_k
              in terms of given coefficients
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %msub
                      %mi b
                      %mi k
                  %annotation{:encoding => "application/x-tex"} b_1, \ldots, b_k
              and earlier
              = succeed "-values" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                    %annotation{:encoding => "application/x-tex"} a
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi a
                        %mi n
                    %annotation{:encoding => "application/x-tex"} a_n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo &lt;
                      %mi k
                    %annotation{:encoding => "application/x-tex"} n \lt k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                  %annotation{:encoding => "application/x-tex"} a
              has a right inverse if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi a
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} a_1^{-1}
              exists, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
              has a left inverse if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi b
                      %mn 1
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} b_1^{-1}
              exists, and this completes the proof.
          %h3#formal_differentiation Formal differentiation
          %p
            One way to define the formal differentiation operator, as a function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mo ∂
                      %mrow
                        %mo ∂
                        %mi X
                    %mo :
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial X}:R[[X]] \to R[[X]]
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mi X
                  %mrow
                    %mo (
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi n
                        %mo =
                        %mn 0
                      %mn ∞
                    %msub
                      %mi a
                      %mi n
                    %msup
                      %mi X
                      %mi n
                    %mo )
                  %mo ≔
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi n
                      %mo =
                      %mn 0
                    %mn ∞
                  %msub
                    %mi a
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %msup
                    %mi X
                    %mi n
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\frac{\partial}{\partial X}\left(\sum_{n = 0}^\infty a_n X^n\right) \coloneqq \sum_{n = 0}^\infty a_{n + 1} (n + 1) X^n.
          %p
            Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mo ∂
                    %mrow
                      %mo ∂
                      %mi X
                %annotation{:encoding => "application/x-tex"} \frac{\partial}{\partial X}
            is an
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[[X]]
            which satisfies the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Leibniz+rule"} Leibniz rule
            %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi X
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} R[[X]]
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+algebra"} differential algebra
          %p
            Here is a conceptual story underlying the formalism. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo =
                  %mi R
                  %mo{:stretchy => "false"} [
                  %mi ε
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
