                %annotation{:encoding => "application/x-tex"} K[[\epsilon]]
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/local+ring"} local ring
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
