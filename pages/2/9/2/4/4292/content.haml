                    %mi p
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mi ε
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \delta(p) = p(X) + p'(X)\varepsilon.
            %p
          %p We leave as an exercise the proof that the two definitions of derivative match:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
