                  %annotation{:encoding => "application/x-tex"} (X)
            %a.existingWikiWord{:href => "/nlab/show/adic+topologies"} adic topologies
            described above) that sends
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
