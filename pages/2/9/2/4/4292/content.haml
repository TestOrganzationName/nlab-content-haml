                  %mo ,
                %annotation{:encoding => "application/x-tex"} R^\mathbb{N} \to R \times R^\mathbb{N}\; \colon \; (a_n)_{n \geq 0} \mapsto \langle a_0, (a_{n+1})_{n \geq 0} \rangle,
          %p corresponds to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
