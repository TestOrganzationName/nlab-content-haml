                  %mrow
                    %mi X
                    %mo ′
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} X' = 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi X
                    %mi k
                  %mo{:stretchy => "false"} )
                  %mo ′
                  %mo =
                  %mi k
