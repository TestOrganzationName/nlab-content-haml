          #RicciTensorOfRoundNSphere.num_remark
            %h6 Example
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %msub
                      %mi ℕ
                      %mrow
                        %mo &gt;
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}_{\gt 0}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                      %mo ∈
                      %msub
                        %mi ℝ
                        %mrow
                          %mo &gt;
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} r \in \mathbb{R}_{\gt 0}
              %a.existingWikiWord{:href => "/nlab/show/round+sphere"} round
