              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi v
                        %mo{:stretchy => "false"} |
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} {\vert v \vert} = 1
            %p
              Accordingly, the
