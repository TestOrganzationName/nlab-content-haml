                \-categories of
                %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-categories"} (n,r)-categories
            %ul
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Pos"} Pos
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
