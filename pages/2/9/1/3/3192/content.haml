                    %mo →
                    %msub
                      %mi B
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F \colon B_1\to B_2
              between
              %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
              is
              %strong Fredholm
              if it has
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              and finite dimensional
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cokernel"} cokernel
          (e.g.
          = succeed ")" do
            %a{:href => "#Murphy90"} Murphy 1990 p. 23
          %p
          .num_remark
            %h6 Remark
            %p
              Some (older) text may also require that the
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              be
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              having finite dimension (cf. Prop.
              %a.maruku-ref{:href => "#ImageIsClosed"}
              below). Moreover, some (older) texts do not require
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              to be bounded, but just ask that it be
              %a.existingWikiWord{:href => "/nlab/show/closed+operator"} closed
              with
              %a.existingWikiWord{:href => "/nlab/show/dense+subset"} dense
              %a.existingWikiWord{:href => "/nlab/show/domain"} domain
              of definition (e.g.
              = succeed ")." do
                %a{:href => "#Schechter1967"} Schechter 1967 §1
          %p
          #FredholmIndex.num_defn
            %h6 Definition
            %p
              The difference between the
              %a.existingWikiWord{:href => "/nlab/show/dimension+of+a+vector+space"} dimensions
              of the kernel and the cokernel of a Fredholm operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is called its
              %em
                %a.existingWikiWord{:href => "/nlab/show/index"} index
              (the
              = succeed ")" do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Fredholm+index"} Fredholm index
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %mi ind
                          %mi F
                        %mtd
                          %mo ≔
                        %mtd
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi ker
                          %mi F
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi coker
                          %mi F
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                        %mtd
                          %mo =
                        %mtd
                          %mi dim
                          %mo{:stretchy => "false"} (
                          %mi ker
                          %mi F
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi codim
                          %mo{:stretchy => "false"} (
                          %mi im
                          %mi F
                          %mo{:stretchy => "false"} )
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccl}
                    ind F
                    \&amp;\coloneqq&amp;
                    dim (ker F) - dim (coker F)
                    \\\
                    \&amp;=&amp;
                    dim (ker F) - codim (im F)
                    \\mathrlap{\,.}
                    \\end{array}
            %p
          %h2#examples Examples
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/elliptic+operator"} Elliptic operators
                on
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact
                %a.existingWikiWord{:href => "/nlab/show/manifolds"} manifolds
                are naturally Fredholm, when understood between the appropriate
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Sobolev+spaces"} Sobolev spaces
            %li
              %p
                %a{:href => "Dirac+field#FreeDiracFieldInCoulombBackground"} charged vacua of free Dirac field in Coulomb background
                are characterized by Fredholm operators
          %h2#properties Properties
          %h3#general General
          %p
          #ImageIsClosed.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/image"} image
              (range) of a Fredholm operator is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed
          (cf.
          = succeed "," do
            %a{:href => "#Atiyah67"} Atiyah 1967 p. 153-4
          = succeed ")" do
            %a{:href => "#Murphy90"} Murphy 1990 Thm. 1.4.7
          %p
          #SubspaceOfFredholmInNormTopology.num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fred
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 1
                    %mo ,
                    %msub
                      %mi B
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi B
                      %mn 1
                    %mo ,
                    %msub
                      %mi B
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fred(B_1,B_2)\subset B(B_1,B_2)
              of Fredholm operators (in the space of
              %a.existingWikiWord{:href => "/nlab/show/bounded+linear+operators"} bounded linear operators
              equipped with the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/norm+topology"} norm topology
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/open+subset"} open
            %p
              On this subspace with its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
              = succeed ")" do
                %a.maruku-ref{:href => "#FredholmIndex"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/continuous+map"} continuous map
          (
          %a{:href => "#Murphy90"}> Murphy 1990 Thm. 1.4.17
          )
          %p
          .num_remark
            %h6 Remark
            %p
              In other words, Prop.
              %a.maruku-ref{:href => "#SubspaceOfFredholmInNormTopology"}
              says that given a Fredholm operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              then there exists a
              %a.existingWikiWord{:href => "/nlab/show/real+number"} real number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \epsilon \gt 0
              such that every
              %a.existingWikiWord{:href => "/nlab/show/bounded+linear+operator"} bounded linear operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              with
              %a.existingWikiWord{:href => "/nlab/show/operator+norm"} operator norm
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo{:stretchy => "false"} ‖
                      %mi G
                      %mo −
                      %mi F
                      %mo{:stretchy => "false"} ‖
                    %mo &lt;
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} {\Vert G - F \Vert} \lt \epsilon
              is itself Fredholm of the same index.
          %p
          #ClosureUnderComposition.num_prop
            %h6 Proposition
            %p
              For
              %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} B_1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi B
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} B_2
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} B_3
              and Fredholm operators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi B
                      %mn 1
                    %mo ⟶
                    %msub
                      %mi B
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F_1 \colon B_1 \longrightarrow B_2
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 2
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi B
                      %mn 2
                    %mo ⟶
                    %msub
                      %mi B
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} F_2 \colon B_2 \longrightarrow B_3
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/composition"} composite
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 2
                        %mspace{:width => "thinmathspace"}
                        %mo ∘
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi F
                          %mn 1
                        %mo{:lspace => "verythinmathspace"} :
                        %msub
                          %mi B
                          %mn 1
                        %mo ⟶
                        %msub
                          %mi B
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} F_2 \,\circ\, F_1 \colon B_1 \longrightarrow B_3
                  is Fredholm
              %li
                %p
                  with index (Def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#FredholmIndex"}
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ind
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mn 2
                        %mo ∘
                        %msub
                          %mi F
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo =
                        %mspace{:width => "thickmathspace"}
                        %mi ind
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mn 1
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mi ind
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        ind(F_2\circ F_1)
                        \\;=\;
                        ind(F_1) + ind(F_2)
                        \\,.
            %p
          (
          %a{:href => "#Murphy90"}> Murphy 1990 Thm. 1.4.8
          )
          %p
          .num_remark
            %h6 Remark
            %p
              In other words, Prop.
              %a.maruku-ref{:href => "#ClosureUnderComposition"}
              says that Banach spaces with Fredholm operators between them form a
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              on which the Fredholm index is a
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              to the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              of the
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/integers"} integers
              %a.existingWikiWord{:href => "/nlab/show/endomorphism"} endomorphic
              Fredholm operators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi B
                    %mo ⟶
                    %mi B
                  %annotation{:encoding => "application/x-tex"} F \colon B \longrightarrow B
              form a
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
              with the Fredholm index being a
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of monoids.
          %h3#ViaParametrices Via parametrices
          %p An equivalent characterization of Fredholm operators is the following:
          %p
          #Parametrix.num_defn
            %h6 Definition
            %p
              A
              %strong parametrix
              of a
              %a.existingWikiWord{:href => "/nlab/show/bounded+operator"} bounded
              %a.existingWikiWord{:href => "/nlab/show/linear+operator"} linear operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi ℋ
                      %mn 1
                    %mo →
                    %msub
                      %mi ℋ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F \colon \mathcal{H}_1 \to \mathcal{H}_2
              is a reverse bounded operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi ℋ
                      %mn 2
                    %mo →
                    %msub
                      %mi ℋ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} P \colon \mathcal{H}_2 \to \mathcal{H}_1
              which is an “
              %a.existingWikiWord{:href => "/nlab/show/inverse"} inverse
              up to
              = succeed "\u201D," do
                %a.existingWikiWord{:href => "/nlab/show/compact+operators"} compact operators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∘
                    %mi P
                    %mo −
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi ℋ
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} F \circ P - id_{\mathcal{H}_2}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo ∘
                    %mi F
                    %mo −
                    %msub
                      %mi id
                      %mrow
                        %msub
                          %mi ℋ
                          %mn 1
                  %annotation{:encoding => "application/x-tex"} P \circ F - id_{\mathcal{H}_1}
              are both
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+operators"} compact operators
          %p
          #FredholmViaParametrix.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Atkinson%27s+theorem"}> Atkinson's theorem
                )
              %br/
              A
              %a.existingWikiWord{:href => "/nlab/show/bounded+operator"} bounded
              %a.existingWikiWord{:href => "/nlab/show/linear+operator"} linear operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi B
                      %mn 1
                    %mo →
                    %msub
                      %mi B
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F \colon B_1\to B_2
              between
              %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
              is Fredholm, def.
              = succeed "," do
                %a.maruku-ref{:href => "#FredholmOperator"}
              = succeed "." do
                %a.maruku-ref{:href => "#Parametrix"}
          (cf.
          = succeed ")" do
            %a{:href => "#Murphy90"} Murphy 1990 Thm. 1.4.16
          %h3#relation_to_topological_ktheory Relation to topological K-theory
          %p
          .num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Atiyah-J%C3%A4nich+theorem"}> Atiyah-Jänich theorem
                )
              %br/
              The space of
              %a.existingWikiWord{:href => "/nlab/show/Fredholm+operators"} Fredholm operators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fred
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fred(\mathscr{H})
              on a (countably infinite-dimensional,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/separable+Hilbert+space"} separable
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} \mathscr{H}
              is a
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              for
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(-)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+Hausdorff+space"} compact Hausdorff space
              %a.existingWikiWord{:href => "/nlab/show/homotopy+classes"} homotopy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/continuous+maps"} continuous maps
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fred
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fred(\mathscr{H})
              are in
              %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(X)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mi Map
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi X
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mi Fred
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %munderover
                      %mo →
                      %mrow
                        %mo ∼
                      %mrow
                        %msub
                          %mi ind
                          %mi X
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_0 \,
                    Map\big(
                    X,
                    \\,
                    Fred(\mathscr{H})
                    \\big)
                    \\xrightarrow[\sim]{ind_X}
                    K(X)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ind
                      %mi X
                  %annotation{:encoding => "application/x-tex"} ind_X
              is an
              = succeed "-parameterized" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Fredholm+index"} Fredholm index
          %p#VariantsForTwistedKTheory
            Several variants of the ordinary space of Fredholm operators retain the same
            %a.existingWikiWord{:href => "/nlab/show/homotopy+type"} homotopy type
            and hence all serves as
            %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
            for
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            = succeed "." do
              %a{:href => "#AtiyahSegal04"} Atiyah &amp; Segal 2004 §3
          %p
            A definition which makes a good classifying space also for
            %a.existingWikiWord{:href => "/nlab/show/twisted+K-theory"} twisted K-theory
            and
            %a.existingWikiWord{:href => "/nlab/show/equivariant+K-theory"} equivariant K-theory
            is the following:
          %p
          #FredZero.num_defn
            %h6 Definition
            %p
              Given any
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} C_2
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded
              infinite-dimensional (
              %a.existingWikiWord{:href => "/nlab/show/separable+Hilbert+space"} separable
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/complex+vector+space"} complex
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript ℋ
                      %mo ≃
                      %msub
                        %mi.mathscript ℋ
                        %mo +
                      %mo ⊕
                      %msub
                        %mi.mathscript ℋ
                        %mi i
                    %annotation{:encoding => "application/x-tex"} \mathscr{H} \simeq \mathscr{H}_+ \oplus \mathscr{H}_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fred^{(0)}(\mathscr{H})
              for the set of
              %a.existingWikiWord{:href => "/nlab/show/bounded+linear+operators"} bounded linear operators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi.mathscript ℋ
                    %mo →
                    %mi.mathscript ℋ
                  %annotation{:encoding => "application/x-tex"} F \,\colon\, \mathscr{H} \to \mathscr{H}
              which are
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/self-adjoint+operator"}> self-adjoint
                  \:
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi F
                          %mo †
                        %mo =
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F^\dagger = F
              %li
                %p
                  odd-graded:
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi F
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi.mathscript ℋ
                            %mo ±
                          %mo{:stretchy => "false"} )
                          %mo ⊂
                          %msub
                            %mi.mathscript ℋ
                            %mo ∓
                        %annotation{:encoding => "application/x-tex"} F(\mathscr{H}_{\pm}) \subset \mathscr{H}_{\mp}
              %li
                %p
                  idempotent up to
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/compact+operators"} compact operators
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi F
                            %mn 2
                          %mo −
                          %mi Id
                          %mspace{:width => "thinmathspace"}
                          %mo ∈
                          %mspace{:width => "thinmathspace"}
                          %mi 𝒦
                          %mo{:stretchy => "false"} (
                          %mi.mathscript ℋ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} F^2 - Id \,\in\, \mathcal{K}(\mathscr{H})
            %p
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topology
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+subspace"} topological subspace
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mspace{:width => "thinmathspace"}
                    %mo ↦
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi F
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi F
                      %mn 2
                    %mo −
                    %mi id
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    F \,\mapsto\, \big(F ,\, F^2 - id\big)
                    \\,,
            %p
              of the
              %a.existingWikiWord{:href => "/nlab/show/product+space"} product space
              of the spaces of
            %ol
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/bounded+linear+operators"}> bounded linear operators
                  ,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℬ
                        %annotation{:encoding => "application/x-tex"} \mathcal{B}
                  %a.existingWikiWord{:href => "/nlab/show/compact-open+topology"} compact-open topology
                  and
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/compact+operators"}> compact operators
                  ,
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒦
                        %annotation{:encoding => "application/x-tex"} \mathcal{K}
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/norm+topology"} norm topology
            %div{:style => "margin: -30px 0px 20px 30px"}
              %img{:src => "/nlab/files/Fred0.png", :width => "800px"}/
            %p
          (This is due to
          = succeed "," do
            %a{:href => "#AtiyahSegal04"} Atiyah &amp; Segal 2004 Def. 3.2
          = succeed "," do
            %a{:href => "#AtiyahSinger69"} Atiyah &amp; Singer 1969 p 7
          = succeed ".)" do
            %a{:href => "#FreedHopkinsTeleman11"} Freed, Hopkins &amp; Teleman 2011 Def. A.39
          %p
          .num_remark
            %h6 Remark
            %p
              In view of Def.
              %a.maruku-ref{:href => "#Parametrix"}
              and Prop.
              = succeed "," do
                %a.maruku-ref{:href => "#FredholmViaParametrix"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mn 2
                    %mo −
                    %mi id
                    %mo ∈
                    %mi 𝒦
                  %annotation{:encoding => "application/x-tex"} F^2 - id \in \mathcal{K}
              in Def.
              %a.maruku-ref{:href => "#FredZero"}
              asserts that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              not just has a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/parametrix"} parametrix
              %em own
              parametrix. Or rather, together with the condition that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is odd, hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo =
                    %msub
                      %mi F
                      %mo +
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %msub
                      %mi F
                      %mo −
                  %annotation{:encoding => "application/x-tex"} F = F_+ + F_-
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo ±
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi.mathscript ℋ
                        %mo ±
                      %mo →
                      %msub
                        %mi.mathscript ℋ
                        %mo ∓
                    %annotation{:encoding => "application/x-tex"} F_\pm \colon \mathscr{H}_{\pm} \to \mathscr{H}_{\mp}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo +
                  %annotation{:encoding => "application/x-tex"} F_+
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo −
                  %annotation{:encoding => "application/x-tex"} F_-
              are parametrices of each other.
            %p
              Indeed the Fredholm index map on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Fred
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Fred^{(0)}(\mathscr{H})
              assigns the Fredholm index (Def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FredholmIndex"}
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo +
                    %annotation{:encoding => "application/x-tex"} F_+
              = succeed ".)" do
                %a{:href => "#AtiyahSegal04"} AS04 §3
            %p
              Finally, together with the grading, the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi F
                      %mo *
                    %mo =
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F^\ast = F
              implies that in fact
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mo ±
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi F
                        %mo ∓
                      %msup
                        %mo{:stretchy => "false"} )
                        %mo *
                    %annotation{:encoding => "application/x-tex"} F_\pm = (F_\mp)^\ast
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/virtual+vector+bundle"} virtual vector space
          %p
            %br/
          %h3#PropertiesSelfAdjointFredholmOperators Self-adjoint Fredholm operators
          %h4#SelfAdjointFredholmOperatorsGeneral General
          %p
            The following is a digest of
            = succeed "." do
              %a{:href => "#BooßBavnbekWojciechowski1993"} Booß-Bavnbek &amp; Wojciechowski 1993
          %p
            All
            %a.existingWikiWord{:href => "/nlab/show/linear+operators"} linear operators
            in the following act on a given
            %a.existingWikiWord{:href => "/nlab/show/separable+Hilbert+space"} separable
            countably infinite-dimensional
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
          %p Consider and denote:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
                — the space of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/bounded+operators"} bounded operators
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒦
                      %mo ⊂
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{K} \subset \mathcal{B}
                — the subspace of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/compact+operators"} compact operators
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                      %mo ≔
                      %mi ℬ
                      %mo{:stretchy => "false"} /
                      %mi 𝒦
                    %annotation{:encoding => "application/x-tex"} \mathcal{C} \coloneqq \mathcal{B}/\mathcal{K}
                — the
                %a.existingWikiWord{:href => "/nlab/show/Calkin+algebra"} Calkin algebra
                regarded as a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %msup
                            %mi C
                            %mo *
                        %annotation{:encoding => "application/x-tex"} C^\ast
                    \-algebra
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi p
                      %mo{:lspace => "verythinmathspace"} :
                      %mi ℬ
                      %mo ↠
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathbf{p} \colon \mathcal{B} \twoheadrightarrow \mathcal{C}
                — the
                %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                      %mo ≔
                      %msup
                        %mi 𝒞
                        %mo ×
                      %mo =
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{G} \coloneqq \mathcal{C}^\times = GL(\mathcal{C})
                — the
                %a.existingWikiWord{:href => "/nlab/show/group+of+units"} group of units
                of the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Calkin+algebra"} Calkin algebra
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi 𝒢
                        %mo ^
                      %mo ⊂
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathcal{G}} \subset \mathcal{G}
                — the subgroup of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/self-adjoint+elements"} self-adjoint elements
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi 𝒢
                          %mo ^
                        %mo ±
                      %mo ⊂
                      %mover
                        %mi 𝒢
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathcal{G}}_{\pm} \subset \widehat{\mathcal{G}}
                — the subgroup of elements with purely positibe/negative
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/essential+spectrum"} essential spectrum
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi 𝒢
                          %mo ^
                        %mo *
                      %mo ⊂
                      %mover
                        %mi 𝒢
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathcal{G}}_{\ast} \subset \widehat{\mathcal{G}}
                — the remaining subspace, of elements whose essential spectrum is both positive and negative,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ≔
                      %mi{:mathvariant => "normal"} U
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                      %mo ⊂
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G \coloneqq \mathrm{U}(\mathcal{C}) \subset GL(\mathcal{C})
                — the
                %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
                of the Calkin algebra,
            %li
