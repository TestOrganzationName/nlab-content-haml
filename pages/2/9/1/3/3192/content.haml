                      %mover
                        %mi{:mathvariant => "normal"} F
                        %mo ^
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\widehat{\mathrm{F}}{}_\ast^0
                    \\;\coloneqq\;
                    \\Big\{
                    f \in \widehat{\mathcal{F}}_\ast
                    \\;\Big\vert\;
                    spec(f) = \{+1, -1\}
                    ,\,
                    \\vert f \vert = 1
                    \\Big\}
                    \\hookrightarrow
                    \\widehat{\mathrm{F}}_\ast
            %p
              is
              %a.existingWikiWord{:href => "/nlab/show/contractible+space"} contractible
              and its inclusio is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Hurewicz+cofibration"} Hurewicz cofibration
          .proof
            %h6 Proof
            %p
              For the first statement: These operators are equivalently choices of
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              decompositions
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi.mathscript ℋ
                      %mo ≃
                      %mi.mathscript ℋ
                      %mo ⊕
                      %mi.mathscript ℋ
                    %annotation{:encoding => "application/x-tex"} \mathscr{H} \simeq \mathscr{H} \oplus \mathscr{H}
              %a.existingWikiWord{:href => "/nlab/show/Grassmannian"} Grassmannian
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} U
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi{:mathvariant => "normal"} U
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi{:mathvariant => "normal"} U
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{U}(\mathscr{H})/\big( \mathrm{U}(\mathscr{H}) \times \mathrm{U}(\mathscr{H}) \big)
              — but
              %a.existingWikiWord{:href => "/nlab/show/U%28%E2%84%8B%29"} U(ℋ)
              is contractible (
              %a.existingWikiWord{:href => "/nlab/show/Kuiper%27s+theorem"}> Kuiper's theorem
              ).
            %p
              For the second statement: Since all spaces of operators in question are
              %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
              (via the
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/operator+norm"} operator norm
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/perfectly+normal+Hausdorff+spaces"} perfectly normal Hausdorff spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi{:mathvariant => "normal"} F
                      %mo ^
                    %msubsup
                      %mrow
                      %mo *
                      %mn 0
                    %mo ⊂
                    %mover
                      %mi{:mathvariant => "normal"} F
                      %mo ^
                    %msub
                      %mrow
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \widehat{\mathrm{F}}{}_\ast^0 \subset \widehat{\mathrm{F}}{}_\ast
              is a
              %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed subspace
              (being the
              %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{0\}
              under the
              %a.existingWikiWord{:href => "/nlab/show/map"} map
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi{:mathvariant => "normal"} F
                          %mo ^
                        %mo *
                      %mo →
                      %mi ℬ
                      %mo{:stretchy => "false"} (
                      %mi.mathscript ℋ
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "verythinmathspace"} :
                      %mi f
                      %mo ↦
                      %msup
                        %mi f
                        %mn 2
                      %mo −
                      %mi Id
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathrm{F}}_\ast \to \mathcal{B}(\mathscr{H}) \colon f \mapsto f^2 - Id
              = succeed ")" do
                %a{:href => "deformation+retract#ClosedStrongNDROfPerfectlyNormalSpaceIsCofibration"} this Prop.
              %a.existingWikiWord{:href => "/nlab/show/strong+deformation+retract"} strong deformation retract
              of a
              %a.existingWikiWord{:href => "/nlab/show/neighbourhood"} neighbourhood
              (
              %a{:href => "deformation+retract#StrongDeformationRetractOfNeighbourhood"}> this Def.
              ). That neighbourhood may be taken to be the invertible operators among
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi{:mathvariant => "normal"} F
                          %mo ^
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathrm{F}}_\ast
              %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
              may then be given by
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/functional+calculus"} functional calculus
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ±
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \pm 1
          %p
            Hence we can sharpen Prop.
            %a.maruku-ref{:href => "#ExponentiatedUnitNormalSelfAdjointFredholmOperators"}
            to:
          %p
          #ExponentiatedProjectionSelfAdjointFredholmOperators.num_cor
            %h6 Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/exponential+map"} exponential map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi exp
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi π
                    %mi{:mathvariant => "normal"} i
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mover
                        %mi{:mathvariant => "normal"} F
                        %mo ^
                      %mo *
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                    %mover
                      %mi{:mathvariant => "normal"} F
                      %mo ^
                    %msubsup
                      %mrow
                      %mo *
                      %mn 0
                    %mo ⟶
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} {
                    %mi U
                    %mo ∈
                    %mi{:mathvariant => "normal"} U
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} |
                    %mspace{:width => "thinmathspace"}
                    %mi U
                    %mo −
                    %mi id
                    %mo ∈
                    %mi 𝒦
                    %mo{:stretchy => "false"} (
                    %mi.mathscript ℋ
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.8em", :minsize => "1.8em"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\exp\big(\pi \mathrm{i} (-) \big)
                    \\;\colon\;
                    \\widehat{\mathrm{F}}_\ast
                    \\big/
                    \\widehat{\mathrm{F}}{}_\ast^0
                    \\longrightarrow
                    \-
                    \\Big\{
                    U \in \mathrm{U}(\mathscr{H})
                    \\,\Big\vert\,
                    U - id \in \mathcal{K}(\mathscr{H})
                    \\Big\}
            %p
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %p
          #CanonicalRepresentativeOfpi3OfSAFred.num_remark
            %h6 Example
            %p
              %strong
                (Fredholm representative of
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi π
                          %mn 3
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi KU
                          %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \pi_3(KU_1)
              %br/
              Regarding
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 3
                        %mo ≃
                        %msup
                          %mi D
                          %mn 3
                        %mo{:stretchy => "false"} /
                        %mo ∂
                        %msup
                          %mi D
                          %mn 3
                      %annotation{:encoding => "application/x-tex"} S^3 \simeq D^3/\partial D^3
                  — the
                  %a.existingWikiWord{:href => "/nlab/show/3-sphere"} 3-sphere
                  as the
                  %a.existingWikiWord{:href => "/nlab/show/one-point+compactification"} one-point compactification
                  of the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/closed+ball"} closed 3-ball
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi D
                          %mn 3
                        %mo ≃
                        %mi D
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ℍ
                          %mi im
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} D^3 \simeq D(\mathbb{H}_{im})
                  — the closed 3-ball as the closed unit ball in the space of
                  %a.existingWikiWord{:href => "/nlab/show/imaginary+number"} imaginary
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ℍ
                          %mi im
                        %mo ↪
                        %msubsup
                          %mi Mat
                          %mrow
                            %mn 2
                            %mo ×
                            %mn 2
                          %mi herm
                        %mo{:stretchy => "false"} (
                        %mi ℂ
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathbb{H}_{im} \hookrightarrow Mat^{herm}_{2 \times 2}(\mathbb{C})
                  — via the
                  %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} {
                          %msub
                            %mi σ
                            %mi i
                          %msubsup
                            %mo{:stretchy => "false"} }
                            %mrow
                              %mi i
                              %mo =
                              %mn 1
                            %mn 3
                        %annotation{:encoding => "application/x-tex"} \{\sigma_i\}_{i = 1}^3
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Mat
                          %mrow
                            %mn 2
                            %mo ×
                            %mn 2
                        %mo{:stretchy => "false"} (
                        %mi ℂ
                        %mo{:stretchy => "false"} )
                        %mo ↪
                        %mi ℱ
                      %annotation{:encoding => "application/x-tex"} Mat_{2 \times 2}(\mathbb{C}) \hookrightarrow \mathcal{F}
                  by forming the
                  %a.existingWikiWord{:href => "/nlab/show/direct+sum+of+Hilbert+spaces"} Hilbert space direct sum
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                          %mo ↦
                          %mi X
                          %mo ⊕
                          %msub
                            %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⨁
                            %mrow
                              %mi n
                              %mo ∈
                              %mi ℕ
                          %mi diag
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mn 1
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} X \mapsto X \oplus \bigoplus_{n \in \mathbb{N}} diag(+1,-1)
            %p
              then Cor.
              %a.maruku-ref{:href => "#ExponentiatedProjectionSelfAdjointFredholmOperators"}
              implies that we have a
              %a.existingWikiWord{:href => "/nlab/show/map"} map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mtable{:columnalign => "center center center center center", :displaystyle => "false", :rowspacing => "0.5ex"}
                      %mtr
                        %mtd
                          %msup
                            %mi D
                            %mn 3
                          %mo{:stretchy => "false"} /
                          %mo ∂
                          %msup
                            %mi D
                            %mn 3
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                        %mtd
                          %msub
                            %mover
                              %mi{:mathvariant => "normal"} F
                              %mo ^
                            %mo *
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} /
                          %mover
                            %mi{:mathvariant => "normal"} F
                            %mo ^
                          %msubsup
                            %mrow
                            %mo *
                            %mn 0
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %mi exp
                              %mo{:stretchy => "false"} (
                              %mi π
                              %mi{:mathvariant => "normal"} i
                              %mo{:stretchy => "false"} (
                              %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                              %mo{:stretchy => "false"} )
                              %mo{:stretchy => "false"} )
                        %mtd
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mi C
                      %mtr
                        %mtd
                          %mi x
                        %mtd
                          %mo ↦
                        %mtd
                          %mi σ
                          %mo ⋅
                          %mi x
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{array}{ccccc}
                    D^3 / \partial D^3
                    \&amp;\overset{}{\longrightarrow}&amp;
                    \\widehat{\mathrm{F}}_\ast
                    \\big/
                    \\widehat{\mathrm{F}}{}_\ast^0
                    \&amp;\overset{ exp(\pi \mathrm{i} (-))  }{\longrightarrow}&amp;
                    \- C
                    \\\
                    x &amp;\mapsto&amp; \sigma \cdot x
                    \\mathrlap{\,.}
                    \\end{array}
            %p
              But the total map now is now essentially just the
              %a.existingWikiWord{:href => "/nlab/show/exponential+map"} exponential map
              from the unit ball in the
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              %a.existingWikiWord{:href => "/nlab/show/su%282%29"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔲
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{su}(2)
              to the
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
              and as such represents a generator of
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 3
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo =
                    %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_3\big(C\big) = \mathbb{Z}
                    \\,.
            %p
              This construction (in consequence of
              = succeed ")" do
                %a{:href => "#AtiyahSinger69"} Atiyah &amp; Singer 1969 Prop. 3.3
              = succeed "," do
                %a{:href => "#SS26"} SS26 §4.3.3
              %a{:href => "D-brane+charge+quantization+in+K-theory#Witten00"} Witten 2001 p. 6-8
              following
              = succeed "." do
                %a{:href => "D-brane+charge+quantization+in+K-theory#Horava98"} Hořava 1998 (3.7, 3.17)
            %p
          %p
            %br/
          %h2#generalizations Generalizations
          %p
            Fredholm operators generalize to Fredholm complexes. A finite
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 0
                  %mo →
                  %msub
                    %mi C
                    %mn 0
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi d
                        %mn 0
                  %msub
                    %mi C
                    %mn 1
                  %mover
                    %mo ⟶
                    %mrow
                      %msub
                        %mi d
                        %mn 1
                  %msub
                    %mi C
                    %mn 2
                  %mo ⟶
                  %mi ⋯
                  %mo ⟶
                  %msub
                    %mi C
                    %mi n
                  %mo →
                  %mn 0
                %annotation{:encoding => "application/x-tex"}
                  0
                  \\to
                  C_0
                  \\overset{d_0}{\longrightarrow}
                  C_1
                  \\overset{d_1}{\longrightarrow}
                  C_2
                  \\longrightarrow
                  \\cdots
                  \\longrightarrow
                  C_n
                  \\to
                  0
          %p
            of
            %a.existingWikiWord{:href => "/nlab/show/Banach+spaces"} Banach spaces
            and
            %a.existingWikiWord{:href => "/nlab/show/bounded+linear+operators"} bounded linear operators
            between them is said to be a
            %strong Fredholm complex
            if the
            %a.existingWikiWord{:href => "/nlab/show/images"} images
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                %annotation{:encoding => "application/x-tex"} d_i
            are
            %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed
            and the
            %a.existingWikiWord{:href => "/nlab/show/chain+homology"} chain homology
            of the complex is finite dimensional. The
            %a.existingWikiWord{:href => "/nlab/show/Euler+characteristic"} Euler characteristic
            (the alternative sum of the dimensions of the homology groups) is then called the
            %strong index
            of the Fredholm complex. Each Fredholm operator can be considered as a Fredholm complex concentrated at zero. Each Fredholm complex produces a Fredholm operator from the sum of the even- to the sum of the odd-numbered spaces in the complex.
          %p
            One can consider
            = succeed "," do
              %em Fredholm almost complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi i
                  %mo ∘
                  %msub
                    %mi d
                    %mrow
                      %mi i
                      %mo −
                      %mn 1
                %annotation{:encoding => "application/x-tex"} d_i \circ d_{i-1}
            is not zero but the image of that operator is compact. Out of every Fredholm almost complex one can make a complex by correcting the differentials by compact perturbation terms.
            %a.existingWikiWord{:href => "/nlab/show/elliptic+complex"} Elliptic complexes
            give examples of Fredholm complexes.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fredholm+module"} Fredholm module
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fredholm+determinant"} Fredholm determinant
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Fredholm+group"} Fredholm group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Toeplitz+operator"} Toeplitz operator
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"}> topological K-theory
                ,
                %a.existingWikiWord{:href => "/nlab/show/KK-theory"} KK-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Atiyah-J%C3%A4nich+theorem"} Atiyah-Jänich theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/index+theory"} index theory
          %h2#References References
          %h3#general_3 General
          %p The concept of Fredholm operators originates with and is named after:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ivar+Fredholm"}> Ivar Fredholm
              \:
              = succeed "," do
                %em Sur une classe d’équations fonctionnelles
              %strong 27
              (1903) &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/BF02421317"}> doi:10.1007/BF02421317
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://projecteuclid.org/journals/acta-mathematica/volume-27/issue-none/Sur-une-classe-d%C3%A9quations-fonctionnelles/10.1007/BF02421317.full"} euclid:10.1007/BF02421317
          %p Textbook accounts:
          %ul
            %li
              %p
                Ronald G. Douglas:
                = succeed "," do
                  %em Compact Operators, Fredholm Operators, and Index Theory
                = succeed "," do
                  %em Banach Algebra Techniques in Operator Theory
                %strong 49
                (1972) 121-148 [
                %a{:href => "https://doi.org/10.1016/S0079-8169(08)60364-5"}> doi:10.1016/S0079-8169(08)60364-5
                ]
            %li#Murphy90
