                          %mi p
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi 𝒢
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{F} \simeq \mathbf{p}^{-1}(\mathcal{G})
                — the space of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Fredholm+operators"} Fredholm operators
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi ℱ
                        %mo ^
                      %mo ⊂
                      %mi ℱ
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathcal{F}} \subset \mathcal{F}
                — the subspace of self-adjoint Fredholm operators,
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi ℱ
                          %mo ^
                        %mo ±
                      %mo ⊂
                      %mover
                        %mi ℱ
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathcal{F}}_{\pm} \subset \widehat{\mathcal{F}}
                — the subspace of operators with purely positive/negative
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/essential+spectrum"} essential spectrum
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mover
                          %mi ℱ
                          %mo ^
                        %mo *
                      %mo ⊂
                      %mover
                        %mi ℱ
                        %mo ^
                    %annotation{:encoding => "application/x-tex"} \widehat{\mathcal{F}}_{\ast} \subset \widehat{\mathcal{F}}
                — the remaining subspace, that of operators with both positive and negative
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/essential+spectrum"} essential spectrum
          %p
          .num_prop
            %h6 Proposition
            %p
            %p
              We have
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/homeomorphisms"} homeomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mover
                              %mi 𝒢
                              %mo ^
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %msub
                              %mover
                                %mi 𝒢
                                %mo ^
                              %mo +
                            %mo ⊔
