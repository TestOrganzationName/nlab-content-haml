          %h2#references References
          %ul#Caramello
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrej+Bauer"}> Andrej Bauer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Lars+Birkedal"} Lars Birkedal
                = succeed "," do
