                    %annotation{:encoding => "application/x-tex"} S^n \simeq O(n+1)/O(n)
          #StiefelManifold.num_example
            %h6#example_2 Example
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≤
                      %mi k
