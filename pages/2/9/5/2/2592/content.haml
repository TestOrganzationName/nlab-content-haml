          %h3#CosetSpaces Coset spaces
          #nSphereAsCosetSpace.num_example
            %h6#example Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              are
              %a.existingWikiWord{:href => "/nlab/show/coset+spaces"} coset spaces
              of orthogonal groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^n \simeq O(n+1)/O(n)
                    \\,.
            %p
