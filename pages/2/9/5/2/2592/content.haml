          %h2#definition Definition
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℕ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
            the
            %strong orthogonal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi O
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} O(n)
            is the group of
            %a.existingWikiWord{:href => "/nlab/show/isometry"} isometries
            of a real
            = succeed "-dimensional" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Hilbert+space"} Hilbert space
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ×
                  %mi n
                %annotation{:encoding => "application/x-tex"} n \times n
            orthogonal
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
          %p
            More generally there is a notion of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group+of+an+inner+product+space"} orthogonal group of an inner product space
          %p
            The analog for complex Hilbert spaces is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/unitary+group"} unitary group
          %h2#properties Properties
          %h3#compactness Compactness
          #OrthogonalGroupIsCompact.num_prop
            %h6#proposition Proposition
            %p
              The orthogonal group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n)
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compact+topological+space"} compact topological space
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
          %h3#HomotopyGroups Homotopy groups
          #InclusionOfOnIntoOkIsnMinus1Equivalence.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ,
                      %mi N
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} n, N \in \mathbb{N}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo ≤
                      %mi N
                    %annotation{:encoding => "application/x-tex"} n \leq N
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    O(n) \hookrightarrow O(N)
            %p
              is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-equivalence"} (n-1)-equivalence
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on
              %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
              in degrees
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo &lt;
                    %mi n
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \lt n-1
              and a
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
              in degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n-1
          .proof
            %h6#proof Proof
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    O(n)
                    \\longrightarrow
                    O(n+1)
                    \\longrightarrow
                    O(n+1)/O(n)
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#OrthogonalGroupIsCompact"}
              and by
              = succeed "," do
                %a{:href => "coset#QuotientProjectionForCompactLieSubgroupIsPrincipal"} this corollary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n+1)\to O(n+1)/O(n)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %a.maruku-ref{:href => "#nSphereAsCosetSpace"}
              identifies the
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              with the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^{n}\simeq O(n+1)/O(n)
                    \\,.
            %p
              Therefore the
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              of the
              %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} O(n)\to O(n+1)\to S^n
              looks like
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\pi_{\bullet+1}(S^n)
                    \\longrightarrow
                    \\pi_\bullet(O(n))
                    \\longrightarrow
                    \\pi_\bullet(O(n+1))
                    \\longrightarrow
                    \\pi_\bullet(S^n)
                    \\to
                    \\cdots
            %p
              Since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mrow
                          %mo &lt;
                          %mi n
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi S
                        %mi n
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \pi_{\lt n}(S^n) = 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mo &lt;
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
