                    %annotation{:encoding => "application/x-tex"} n
              %em
                real
                %a.existingWikiWord{:href => "/nlab/show/Stiefel+manifold"} Stiefel manifold
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mi k
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^k
          .num_prop
            %h6#proposition_3 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Stiefel+manifold"} Stiefel manifold
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_n(\mathbb{R}^k)
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#StiefelManifold"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-connected+topological+space"} (k-n-1)-connected
          .proof
            %h6#proof_2 Proof
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi V
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    O(k-n)
                    \\longrightarrow
                    O(k)
                    \\longrightarrow
                    O(k)/O(k-n)
                    \=
                    V_n(\mathbb{R}^k)
                    \\,.
            %p
              By prop.
              %a.maruku-ref{:href => "#OrthogonalGroupIsCompact"}
              and by
              %a{:href => "QuotientProjectionForCompactLieSubgroupIsPrincipal"} this corollary
              the projection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(k)\to O(k)/O(k-n)
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              of this
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/fiber+sequence"} fiber sequence
              %a.maruku-ref{:href => "#InclusionOfOnIntoOkIsnMinus1Equivalence"}
              it has the following form in degrees bounded by
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo ≤
                        %mi k
                        %mo −
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi epi
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo ≤
                        %mi k
                        %mo −
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mn 0
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo ≤
                        %mi k
                        %mo −
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mn 0
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo &lt;
                        %mi k
                        %mo −
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %mo &lt;
                        %mi k
                        %mo −
                        %mi n
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo −
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\pi_{\bullet \leq k-n-1}(O(k-n))
                    \\overset{epi}{\longrightarrow}
                    \\pi_{\bullet \leq k-n-1}(O(k))
                    \\overset{0}{\longrightarrow}
                    \\pi_{\bullet \leq k-n-1}(V_n(\mathbb{R}^k))
                    \\overset{0}{\longrightarrow}
                    \\pi_{\bullet-1 \lt k-n-1}(O(k))
                    \\overset{\simeq}{\longrightarrow}
                    \\pi_{\bullet-1 \lt k-n-1}(O(k-n))
                    \\to
                    \\cdots
                    \\,.
            %p
              This implies the claim. (Exactness of the sequence says that every element in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
