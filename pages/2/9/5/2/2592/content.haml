          %p
            The
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 6
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO(6)
            row can be found using
            = succeed "," do
              %a{:href => "#MimuraToda63"} Mimura-Toda 63
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 6
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(6) = SU(4)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 6
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(6)
            is a
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
            %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mn 6
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(6)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SO
                  %mo{:stretchy => "false"} (
                  %mn 7
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} SO(7)
            row can be derived from the homotopy groups of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Spin
                  %mo{:stretchy => "false"} (
                  %mn 7
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Spin(7)
            as found in
            = succeed "." do
              %a{:href => "#Mimura67"} Mimura 67
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \pi_k
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
