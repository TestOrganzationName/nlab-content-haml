          %p Note that the maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi π
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 3
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ⟶
                          %msub
                            %mi π
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 4
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                          %mo ⟶
                          %msub
                            %mi π
                            %mn 3
                          %mo{:stretchy => "false"} (
                          %mi SO
                          %mo{:stretchy => "false"} (
                          %mn 5
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mi ℤ
                          %mo ⟶
                          %mi ℤ
                          %mo ⊕
                          %mi ℤ
                          %mo ⟶
                          %mi ℤ
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\pi_3(SO(3)) \longrightarrow \pi_3(SO(4)) \longrightarrow \pi_3(SO(5))
                  \\\
                  \\mathbb{Z}\longrightarrow \mathbb{Z}\oplus \mathbb{Z} \longrightarrow\mathbb{Z}
                  }
          %p
            are inclusion of the first summand followed by the map sending
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 0
