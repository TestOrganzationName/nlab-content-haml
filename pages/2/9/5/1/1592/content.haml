                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %h2#Example Examples
          #UniversalCoveringOfCircleRealLine.num_example
            %h6#example_3 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                is universal covering of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
            %p Let
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
                  be the
                  %a.existingWikiWord{:href => "/nlab/show/real+line"} real line
                  with its
                  %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                        %mo ≔
                        %mrow
                          %mo {
                          %mi x
                          %mo ∈
                          %msup
                            %mi ℝ
                            %mn 2
                          %mspace{:width => "thickmathspace"}
                          %mo{:stretchy => "false"} |
                          %mspace{:width => "thickmathspace"}
                          %mrow
                            %mo{:stretchy => "false"} ‖
                            %mi x
                            %mo{:stretchy => "false"} ‖
                          %mo =
                          %mn 1
                          %mo }
                        %mo ⊂
                        %msup
                          %mi ℝ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} S^1 \coloneqq \left\{ x\in \mathbb{R}^2 \;\vert\; {\Vert x\Vert} = 1 \right\} \subset \mathbb{R}^2
                  be the
                  %a.existingWikiWord{:href => "/nlab/show/circle"} circle
                  with its
                  %a.existingWikiWord{:href => "/nlab/show/subspace+topology"} subspace topology
                  induced from the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Euclidean+plane"} Euclidean plane
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi ℝ
                              %mn 1
                          %mtd
                            %mover
                              %mo ⟶
                              %mi p
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ⊂
                            %msup
                              %mi ℝ
                              %mn 2
                        %mtr
                          %mtd
                            %mi t
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi cos
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi π
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi sin
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi π
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{R}^1
                    \&amp;\overset{p}{\longrightarrow}&amp;
                    S^1 \subset \mathbb{R}^2
                    \\\
                    t &amp;\mapsto&amp; (\cos(2\pi t), \sin(2\pi t))
                    }
                    \\,.
            %p
              This exhibits the universal covering space (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CoveringUniversal"}
          .proof
            %h6#proof_4 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ∈
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p \in S^1
              be any point. It is clear that we have a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ∖
                            %mi p
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \setminus p
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    (0, 1)
                    }
                    \\,.
            %p
              and hence a
              %a.existingWikiWord{:href => "/nlab/show/homeomorphism"} homeomorphism
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 1
                            %mo ×
                            %mi Disc
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mn 0
                            %mo ,
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi Disc
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mo ≃
                          %mtd
                            %msup
                              %mi p
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi S
                              %mn 1
                            %mo ∖
                            %mo{:stretchy => "false"} {
                            %mi p
                            %mo{:stretchy => "false"} }
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi t
                            %mo ,
                            %mi n
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi cos
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi π
                            %mi n
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi sin
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mi π
                            %mi n
                            %mi t
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^1 \times Disc(\mathbb{Z}) &amp;\simeq&amp; (0,1) \times Disc(\mathbb{Z})
                    \&amp;\overset{\simeq}{\longrightarrow}&amp;
                    p^{-1}(S^1 \setminus \{p\})
                    \\\
                    \&amp;&amp; (t,n) &amp;\mapsto&amp; (cos(2\pi n t), \sin(2\pi n t))
                    }
                    \\,.
            %p
              Now for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                    %mo ≠
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_1 \neq p_2
              two distinct point in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              constitute an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mrow
                        %mo {
                        %msup
                          %mi S
                          %mn 1
                        %mo ∖
                        %msub
                          %mi p
                          %mi i
                        %mo ⊂
                        %msup
                          %mi S
                          %mn 1
                        %mo }
                      %mrow
                        %mi i
                        %mo ∈
                        %mo{:stretchy => "false"} {
                        %mn 1
                        %mo ,
                        %mn 2
                        %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ S^1 \setminus p_i \subset S^1  \right\}_{i \in \{1,2\}}
            %p
              and so this exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℝ
                      %mn 1
                    %mo →
                    %msup
                      %mi S
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p \colon \mathbb{R}^1 \to S^1
              as being covering spaces.
            %p Now
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi S
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} S^1
                  is
                  %a.existingWikiWord{:href => "/nlab/show/path-connected+topological+space"} path-connected
                  and
                  %a.existingWikiWord{:href => "/nlab/show/locally+path-connected+topological+space"} locally path connected
                  (
                  %a{:href => "LocallyPathConnectedCircle"}> this example
                  );
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi ℝ
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
                  is
                  %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
                  (
                  %a{:href => "fundamental+group#EuclideanSpaceFundamentalGroup"}> this example
                  ).
            %p
              Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              exhibits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^1
              as a universal covering space of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} S^1
              = succeed "." do
                %a.maruku-ref{:href => "#CoveringUniversal"}
          %h2#related_entries Related entries
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+covering+spaces"} fundamental theorem of covering spaces
            %li
              %p
                %a{:href => "smooth+homotopy#HomotopyOfSmoothPathsRelativeToTheirEndpoints"} homotopy of smooth paths relative to their endpoints
          %h2#references References
          %p
            See also the references at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/covering+space"} covering space
          %p A detailed treatment is available in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Nicolas+Bourbaki"}> Nicolas Bourbaki
              ,
              = succeed "," do
                %em Topologie Algébrique
              = succeed "," do
                %a{:href => "https://doi.org/10.1007/978-3-662-49361-8"} doi:10.1007/978-3-662-49361-8
          %p Original discussion of universal covering spaces in terms of equivalence classes of based paths:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/William+S.+Massey"}> William S. Massey
              , Chapter 5, Section 10 of:
              = succeed "," do
                %em Algebraic Topology: An Introduction
              = succeed ")" do
                %a{:href => "https://link.springer.com/book/9780387902715"} ISBN:978-0-387-90271-5
          %p
            Formulation in
            %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+theory"} cohesive homotopy theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"}> Urs Schreiber
              ,
              %a{:href => "https://arxiv.org/pdf/1310.7930v1.pdf#page=356"} Def. 3.8.10
              in
              %em
                %a.existingWikiWord{:href => "/schreiber/show/differential+cohomology+in+a+cohesive+topos"}
                  Differential cohomology in a cohesive
                  = succeed "-topos" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
              (2013)
          %p
            and explicitly so in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/cohesive+homotopy+type+theory"} cohesive homotopy type theory
          %ul
            %li#CherubiniRijke20
              %a.existingWikiWord{:href => "/nlab/show/Felix+Cherubini"}> Felix Cherubini
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"} Egbert Rijke
              = succeed "," do
                %em Modal Descent
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/2003.09713"} arXiv:2003.09713
              = succeed ")" do
                %a{:href => "https://doi.org/10.1017/S0960129520000201"} doi:10.1017/S0960129520000201
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/equivariant+universal+covers"} equivariant universal covers
            in the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equivariant+homotopy+theory"} equivariant homotopy theory
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tammo+tom+Dieck"}> Tammo tom Dieck
              , Section I (10.13) of:
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Transformation+Groups"} Transformation Groups
              = succeed ")" do
                %a{:href => "https://doi.org/10.1515/9783110858372"} doi:10.1515/9783110858372
