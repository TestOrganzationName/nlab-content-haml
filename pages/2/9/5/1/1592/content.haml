                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Pi_1(E)
            %em group
            of the connected (2,1)-topos
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %p
            Therefore, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo ˜
                %annotation{:encoding => "application/x-tex"} \widetilde{E}
            is trivialized over any 1-connected object, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is generated by 1-connected objects,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo ˜
                %annotation{:encoding => "application/x-tex"} \widetilde{E}
            is locally trivial. Moreover, since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo *
                %annotation{:encoding => "application/x-tex"} *
            is a
            %a.existingWikiWord{:href => "/nlab/show/discrete+object"} discrete object
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
