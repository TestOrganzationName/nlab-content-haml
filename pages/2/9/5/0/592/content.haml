          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi χ
                    %mi i
                %annotation{:encoding => "application/x-tex"} \chi_i
            is the classifying map of
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
          %h2#Examples Examples
          %p
          .num_remark
            %h6 Example
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              of
              %a.existingWikiWord{:href => "/nlab/show/injections"} injections
              of
              %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
              is called the
              %a.existingWikiWord{:href => "/nlab/show/union"} union
              of the sets.
          %p
          .num_remark
            %h6 Example
            %p
              A pushout of
              %a.existingWikiWord{:href => "/nlab/show/groups"} groups
              in
              %a.existingWikiWord{:href => "/nlab/show/Grps"} Grps
              is called their
              %em
                %a.existingWikiWord{:href => "/nlab/show/amalgamated+free+product"} amalgamated free product
          %p
          .num_remark
            %h6 Example
            %p
              In
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topology"} topology
              %a.existingWikiWord{:href => "/nlab/show/space+attachments"} space attachments
              are pushouts in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Top"} Top
