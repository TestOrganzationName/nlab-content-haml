          %h2#idea Idea
          %p
            A
            %strong pushout
            is an ubiquitous construction in
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            providing a
            %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            for the diagram
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo •
                    %mo ←
                    %mo •
                    %mo →
                    %mo •
                  %annotation{:encoding => "application/x-tex"} \bullet\leftarrow\bullet\rightarrow\bullet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          %h2#pushouts_in_
            Pushouts in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
          %p
