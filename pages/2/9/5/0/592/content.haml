            %p is a pushout square in some category then:
            %ol
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f_\ast g
                  is an epimorphism;
              %li
                %p
                  if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi g
                      %annotation{:encoding => "application/x-tex"} g
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
                  then
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi f
                          %mo *
                        %mi g
                      %annotation{:encoding => "application/x-tex"} f_\ast g
                  is an isomorphism.
          .num_prop
