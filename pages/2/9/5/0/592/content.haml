          #PushoutPreservesEpimorphisms.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (pushouts preserves epimorphisms and isomorphisms)
            %p
              Pushouts preserve
              %a.existingWikiWord{:href => "/nlab/show/epimorphisms"} epimorphisms
              and
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
