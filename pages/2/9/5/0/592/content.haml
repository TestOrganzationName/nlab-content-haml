          %p
            there is a unique function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi X
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} h: X \to Y
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %msub
                    %mi i
                    %mi A
                  %mo =
                  %msub
                    %mi j
                    %mi A
                %annotation{:encoding => "application/x-tex"} h i_A = j_A
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %msub
                    %mi i
                    %mi B
                  %mo =
                  %msub
                    %mi j
                    %mi B
                  %mo .
                %annotation{:encoding => "application/x-tex"} h i_B = j_B .
          %p
