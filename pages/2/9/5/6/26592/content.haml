          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+theory"} probability theory
            %a.existingWikiWord{:href => "/nlab/show/events"} events
            are not always
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/independent+events"} independent
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ≠
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  P(A,B) \ne P(A)\,P(B).
          %p
            One says that
            = succeed "." do
              %em the probability of a product is not the product of the probabilities
            %em joint probability
            (the probability that the events
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            happen
            = succeed ")" do
              %em jointly
            %em marginal probabilities
            (the probabilities that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            happen
            = succeed ".)" do
              %em separately
            %a.existingWikiWord{:href => "/nlab/show/correlation"} correlation
            or other
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stochastic+interactions"} stochastic interactions
          %p
            From the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category-theoretic+approaches+to+probability+theory"} category-theoretic perspective
          %ul
            %li
              A
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal structure
              on a
              %a.existingWikiWord{:href => "/nlab/show/category+of+kernels"} category of kernels
              or
              %a.existingWikiWord{:href => "/nlab/show/Markov+category"} Markov category
              which is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/semicartesian+monoidal+category"} semicartesian
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+monoidal+category"} cartesian
              = succeed ";" do
                %a.existingWikiWord{:href => "/nlab/show/product"} categorical product
          %p or
