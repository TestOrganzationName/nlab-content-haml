          %p We call
          %ul
            %li
              The
              %strong joint distribution
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              (or of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %a.existingWikiWord{:href => "/nlab/show/pushforward+measure"} pushforward measure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %mi g
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p_{X,Y}=(f,g)_*p
              on
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} X\times Y
            %li
              The
              %strong marginal distributions
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              (or of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %a.existingWikiWord{:href => "/nlab/show/pushforward+measures"} pushforward measures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi X
                    %mo =
                    %msub
                      %mi f
                      %mo *
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p_X=f_*p
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi Y
                    %mo =
                    %msub
                      %mi g
                      %mo *
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p_Y=g_*p
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
          %p
            Note that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi π
                    %mn 1
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                  %msub
                    %mi p
                    %mrow
                      %mi X
                      %mo ,
                      %mi Y
                  %mo =
                  %msub
                    %mi p
                    %mi X
                %annotation{:encoding => "application/x-tex"} (\pi_1)_*p_{X,Y} = p_X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi π
                      %mn 2
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo *
                    %msub
                      %mi p
                      %mrow
                        %mi X
                        %mo ,
                        %mi Y
                    %mo =
                    %msub
                      %mi p
                      %mi Y
                  %annotation{:encoding => "application/x-tex"} (\pi_2)_*p_{X,Y} = p_Y
            %a.existingWikiWord{:href => "/nlab/show/product"} product
            projections under a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/probability+monad"} probability monad
          %p
            In absence of the space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            one can call “joint distribution” any probability distribution on a product space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ×
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X\times Y
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X\times Y
            as
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"} \Omega
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinite+tensor+product"} infinite products
          %p
            Given two (marginal) distributions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            on spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi 𝒜
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,\mathcal{A})
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Y,\mathcal{B})
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X\times Y
            admitting
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            as their marginals, corresponding to different possible
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stochastic+dependence+and+independence"} stochastic interactions
            %strong product distribution
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo ⊗
                    %mi q
                  %annotation{:encoding => "application/x-tex"} p\otimes q
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ×
                  %mi B
                  %mo ⊆
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} A\times B\subseteq X\times Y
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ⊗
                  %mi q
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ×
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi q
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (p\otimes q)\,(A\times B) = p(A)\,q(B) ,
          %p
            which makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stochastic+dependence+and+independence"} independent
          %h3#in_terms_of_probability_monads In terms of probability monads
          %p
            Recall that the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Giry+monad"} Giry monad
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/probability+monads"} probability monads
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi X
                %annotation{:encoding => "application/x-tex"} P X
            of
            %a.existingWikiWord{:href => "/nlab/show/probability+measures"} probability measures
            over it. A joint distribution is then encoded by an element of the space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} P(X\times Y)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi X
                %annotation{:encoding => "application/x-tex"} P X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mi Y
                %annotation{:encoding => "application/x-tex"} P Y
            obtained via applying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            to the product projections. Additionally, by the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/products"} products
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo :
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mi X
                  %mo ×
                  %mi P
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \Delta:P(X\times Y)\to P X\times P Y
            making the following diagram commute.
            %svg{:height => "82.039pt", :version => "1.2", :viewbox => "0 0 237.129 82.039", :width => "237.129pt", :xmlns => "http://www.w3.org/2000/svg", "xmlns:xlink" => "http://www.w3.org/1999/xlink"}
              %defs
                %g
                  %symbol{:id => "X8ttAk-u28Evi58f5deyRx2C064=-glyph0-0", :overflow => "visible"}
                    %path{:d => "", :style => "stroke:none;"}
                  %symbol{:id => "X8ttAk-u28Evi58f5deyRx2C064=-glyph0-1", :overflow => "visible"}
