                %mrow
                  %mi f
                  %mo :
                  %mi Ω
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} f:\Omega\to X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi Ω
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} g:\Omega\to Y
            there exists a unique morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo →
                  %mi X
                  %mo ⊗
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \Omega\to X\otimes Y
