              which is
              %a.existingWikiWord{:href => "/nlab/show/affine+monad"} affine
              but not
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/products"} products
          %p
            When one takes as
            %a.existingWikiWord{:href => "/nlab/show/Markov+category"} Markov category
            the
            %a.existingWikiWord{:href => "/nlab/show/Kleisli+category"} Kleisli category
