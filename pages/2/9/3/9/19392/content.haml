                      %p
                        %a.existingWikiWord{:href => "/nlab/show/realizability+interpretation"} realizability interpretation
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/effective+topos"} effective topos
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/Kleene%27s+first+algebra"}> Kleene's first algebra
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/Kleene%27s+second+algebra"} Kleene's second algebra
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/function+realizability"} function realizability
                  %h3#computability Computability
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/computability"} computability
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/computation"}> computation
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/computational+type+theory"} computational type theory
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/computable+function"}> computable function
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/partial+recursive+function"} partial recursive function
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/computable+analysis"}> computable analysis
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/constructive+analysis"} constructive analysis
                      %ul
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/Type+Two+Theory+of+Effectivity"} Type Two Theory of Effectivity
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/computable+function+%28analysis%29"} computable function (analysis)
                        %li
                          %p
                            %a.existingWikiWord{:href => "/nlab/show/exact+real+computer+arithmetic"} exact real computer arithmetic
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/computable+set"} computable set
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/persistent+homology"}> persistent homology
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/effective+homology"} effective homology
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/computable+physics"} computable physics
