          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Baez02"} Baez 02, 4.1
          %h3#relation_to_quaternions Relation to quaternions
          #InvolutionProjectingOutH.num_prop
            %h6#proposition_7 Proposition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℍ
                    %mo =
                    %mo{:stretchy => "false"} ⟨
                    %mn 1
                    %mo ,
                    %mi i
                    %mo ,
                    %mi j
                    %mo ,
                    %mi k
                    %mo{:stretchy => "false"} ⟩
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{H} = \langle 1, i, j, k\rangle
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/quaternions"} quaternions
              equipped with canonical
              %a.existingWikiWord{:href => "/nlab/show/linear+basis"} basis
              elements, and let
            #eq:ForProjectionStatementOcotonionsDirectSumUnderCayleyDickson.maruku-equation
              %span.maruku-eq-number (2)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕆
                    %mo =
                    %mi ℍ
                    %mo ⊕
                    %mi ℓ
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbb{O} = \mathbb{H} \oplus \ell \mathbb{H}
            %p
              be the octonions equipped with the linear basis induced by the
              %a.existingWikiWord{:href => "/nlab/show/Cayley-Dickson+construction"} Cayley-Dickson construction
              (via
              = succeed ")." do
                %a{:href => "Cayley-Dickson+construction#CayleyDicksonDoubleByAdjoiningFurtherGenerator"} this def.
            %p Then the linear map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi L
                      %mi ℓ
                    %msub
                      %mi L
                      %mrow
                        %mi ℓ
                        %mi i
                    %msub
                      %mi L
                      %mrow
                        %mi ℓ
                        %mi j
                    %msub
                      %mi L
                      %mrow
                        %mi ℓ
                        %mi k
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝕆
                    %mo ⟶
                    %mi 𝕆
                  %annotation{:encoding => "application/x-tex"}
                    L_{\ell} L_{\ell i} L_{\ell j} L_{\ell k}
