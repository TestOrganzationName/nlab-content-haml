                    \\mathbb{O} \longrightarrow \mathbb{O}
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/involution"} involution
              whose +1
              %a.existingWikiWord{:href => "/nlab/show/eigenspace"} eigenspace
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mi ℍ
                  %annotation{:encoding => "application/x-tex"} \ell \mathbb{H}
              and whose -1 eigenspace is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℍ
                    %annotation{:encoding => "application/x-tex"} \mathbb{H}
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ForProjectionStatementOcotonionsDirectSumUnderCayleyDickson"} (2)
