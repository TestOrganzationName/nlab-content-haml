                %a{:href => "https://arxiv.org/abs/1511.00316"}> arXiv:1511.00316
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s00220-016-2669-9"} doi:10.1007/s00220-016-2669-9
            %li
