              of class
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi k
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} C^1_k
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∘
                    %mi f
                  %annotation{:encoding => "application/x-tex"} g \circ f
              is of class
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mrow
                          %mi Λ
                          %mo ′
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} C^1_{\Lambda'}
          #corchain.num_cor
            %h6#corollary Corollary
            %p
              The chain rule holds for each of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi c
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} C^1_c
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mrow
                          %mi q
                          %mi b
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} C^1_{q b}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi Π
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} C^1_\Pi
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi Δ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} C^1_\Delta
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi Θ
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} C^1_\Theta
            %p The following partial chain rules also hold:
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi Π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msubsup
                        %mi C
                        %mi 𝒮
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msubsup
                        %mi C
                        %mi 𝒮
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^1_\Pi(F,G) \times C^1_{\mathcal{S}}(E,F) \to C^1_{\mathcal{S}}(E,G)
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is metrisable,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi k
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msubsup
                        %mi C
                        %mi s
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msubsup
                        %mi C
                        %mi s
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^1_k(F,G) \times C^1_s(E,F) \to C^1_s(E,G)
              %li
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is metrisable,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi k
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %msubsup
                        %mi C
                        %mi k
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msubsup
                        %mi C
                        %mi k
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C^1_k(F,G) \times C^1_k(E,F) \to C^1_k(E,G)
          %h2#higher_derivatives Higher Derivatives
          %p
            A minor wriggle enters the story with higher derivatives due to the fact that the higher derivatives are multilinear maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi E
                    %mi n
                  %mo →
                  %mi F
                %annotation{:encoding => "application/x-tex"} E^n \to F
            and so not only are there different notions of convergence to put on these spaces, there are also different possible meanings of the statement that these are continuous. When dealing with one of the topologies (defined by some family of bounded sets), we will end up with derivatives in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi 𝒮
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H}^n_{\mathcal{S}}(E,F)
            rather than
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℒ
                    %mi 𝒮
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{L}^n_{\mathcal{S}}(E,F)
            in the notation of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/continuous+multilinear+operator"} continuous multilinear operator
          %p
            However, we can start with a very weak notion to get the ball rolling. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi L
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} L^n(E,F)
            be the space of all (not necessarily continuous)
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi E
                      %mi n
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} E^n \to F
          #wdiff.num_defn
            %h6#definition_3 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              be LCTVS,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %mi E
                  %annotation{:encoding => "application/x-tex"} U \subseteq E
              an open subset,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} f \colon U \to F
              is said to be
              %strong
                weakly
                = succeed "-times" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
              if there exist functions
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi k
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %msup
                      %mi L
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^k f \colon U \to L^k(E,F)
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi p
                  %annotation{:encoding => "application/x-tex"} k = 0, 1, \dots, p
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mn 0
                    %mi f
                    %mo =
                    %mi f
                  %annotation{:encoding => "application/x-tex"} D^0 f = f
              and for each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi U
                    %annotation{:encoding => "application/x-tex"} x \in U
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo ∈
                      %mi E
                    %annotation{:encoding => "application/x-tex"} h \in E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi p
                    %mo −
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} k = 0, 1, \dots, p-1
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mrow
                        %mi t
                        %mo →
                        %mn 0
                    %mfrac
                      %mrow
                        %msup
                          %mi D
                          %mi k
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo +
                        %mi t
                        %mi h
                        %mo{:stretchy => "false"} )
                        %mo −
                        %msup
                          %mi D
                          %mi k
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mi t
                    %mo =
                    %msup
                      %mi D
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mi h
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\lim_{t \to 0} \frac{D^k f(x + t h) - D^k f(x)}{t} = D^{k+1} f(x)h.
          %p
            Note that we don’t assume that the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi k
                  %mi f
                %annotation{:encoding => "application/x-tex"} D^k f
            are continuous. If some are continuous then some nice properties ensue. For example, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi p
                  %mi f
                %annotation{:encoding => "application/x-tex"} D^p f
            is continuous then each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi D
                    %mi k
                  %mi f
                %annotation{:encoding => "application/x-tex"} D^k f
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                  %mo ≤
                  %mi p
                %annotation{:encoding => "application/x-tex"} k \le p
            is totally symmetric.
          %p
            From the definition of weakly
            = succeed "-times" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-times" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi ℋ
                    %mi 𝒮
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{H}^n_{\mathcal{S}}(E,F)
            see the page on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/continuous+multilinear+operator"} continuous multilinear operator
          #chdiff.num_defn
            %h6#definition_4 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              be LCTVS,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %mi E
                  %annotation{:encoding => "application/x-tex"} U \subseteq E
              an open subset,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒮
                  %annotation{:encoding => "application/x-tex"} \mathcal{S}
              be a family of bounded sets in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              which covers
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} f \colon U \to F
              is said to be
              %strong
                differentiable of class
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi C
                        %mi 𝒮
                        %mi p
                    %annotation{:encoding => "application/x-tex"} C^p_{\mathcal{S}}
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is weakly
              = succeed "-times" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi …
                    %mo ,
                    %mi p
                  %annotation{:encoding => "application/x-tex"} k = 0,1,\dots, p
              then:
            %ol
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi k
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi U
                      %mo{:stretchy => "false"} )
                      %mo ⊆
                      %msubsup
                        %mi ℋ
                        %mi 𝒮
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D^k f(U) \subseteq \mathcal{H}^k_{\mathcal{S}}(E,F)
                , and
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mi k
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi U
                      %mo →
                      %msubsup
                        %mi ℋ
                        %mi 𝒮
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo ,
                      %mi F
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D^k f \colon U \to \mathcal{H}^k_{\mathcal{S}}(E,F)
                is continuous.
          %p Using convergence structures, we have:
          #cvdiff.num_defn
            %h6#definition_5 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              be LCTVS,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ⊆
                    %mi E
                  %annotation{:encoding => "application/x-tex"} U \subseteq E
              an open subset,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} p \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              be one of the convergence structures
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Λ
                        %mi c
                    %annotation{:encoding => "application/x-tex"} \Lambda_c
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Λ
                        %mrow
                          %mi q
                          %mi b
                    %annotation{:encoding => "application/x-tex"} \Lambda_{q b}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Π
                    %annotation{:encoding => "application/x-tex"} \Pi
              = succeed "," do
