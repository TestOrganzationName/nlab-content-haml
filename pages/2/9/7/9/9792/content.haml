                    %mi G
                  %annotation{:encoding => "application/x-tex"} g \colon V \to G
              be functions with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
