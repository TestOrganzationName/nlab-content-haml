                        %mo ′
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_k(F,G) \times \mathcal{L}_\Lambda(E,F) \to \mathcal{L}_{\Lambda'}(E,G)
            %p is continuous.
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi U
                    %mo →
                    %mi F
                  %annotation{:encoding => "application/x-tex"} f \colon U \to F
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
