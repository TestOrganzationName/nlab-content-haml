          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/continuous+function"}> continuous function
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/differentiable+function"} differentiable function
              = succeed "," do
                %strong continuously differentiable function
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              %a.existingWikiWord{:href => "/nlab/show/analytic+function"} analytic function
