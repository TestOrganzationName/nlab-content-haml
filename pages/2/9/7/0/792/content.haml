                  \&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  G_1 &amp;&amp;&amp;&amp; X_1 \times_B X_2 &amp;&amp;&amp;&amp; G_2
                  \\\
                  \&amp; \searrow &amp;&amp; \swarrow &amp;&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp; X_1 &amp;&amp;&amp;&amp; X_2
                  \\\
                  \&amp;&amp;&amp; \searrow &amp;&amp; \swarrow
                  \\\
                  \&amp;&amp;&amp;&amp; B
                  }
          %p
            of a certain prescribed
            = succeed "-form" do
              %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
            = succeed "))." do
              %a{:href => "#BunkeRumpfSchick08"} Bunke-Rumpf-Schick 08, p. 9
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
              %ul
                %li
                  %p
                    %strong topological T-duality
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/differential+T-duality"} differential T-duality
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/T-duality+2-group"} T-duality 2-group
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spherical+T-duality"} spherical T-duality
          %h2#references References
          %h3#general General
          %p
            The concept of topological T-duality was introduced on the level of
            = succeed "-data" do
              %a.existingWikiWord{:href => "/nlab/show/differential+form"} differential form
          %ul
            %li#BouwknegtEvslinMathai04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Bouwknegt"}> Peter Bouwknegt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jarah+Evslin"} Jarah Evslin
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                = succeed "," do
                  %em T-Duality: Topology Change from H-flux
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/hep-th/0306062"} hep-th/0306062
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s00220-004-1115-6"} doi:10.1007/s00220-004-1115-6
            %li#BouwknegtHannabusMathai04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Peter+Bouwknegt"}> Peter Bouwknegt
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Keith+Hannabus"} Keith Hannabus
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
                = succeed "," do
                  %em T-duality for principal torus bundles
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/hep-th/0312284"} hep-th/0312284
          %p
            In these papers the
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(1)
            %a.existingWikiWord{:href => "/nlab/show/gerbe"} gerbe
            (
            %a.existingWikiWord{:href => "/nlab/show/circle+2-bundle+with+connection"}> circle 2-bundle with connection
            ) does not appear, but an integral
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential+3-form"} differential 3-form
            %a.existingWikiWord{:href => "/nlab/show/Dixmier-Douady+class"} Dixmier-Douady class
            does. Note that if the
            %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+spectrum"} integral
            %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi H
                    %mn 3
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H^3(X,\mathbb{Z})
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            has
            %a.existingWikiWord{:href => "/nlab/show/torsion"} torsion
            in dimension three, not all gerbes will arise in this way.
          %p
            The formalization with the above topological/
            %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theoretic
            data originates in
          %ul
            %li#BunkeSchick04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Schick"} Thomas Schick
                = succeed "," do
                  %em On the topology of T-duality
                %strong 17
                (2005) 77-112 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/0405132"}> arXiv:math/0405132
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/S0129055X05002315"} doi:10.1142/S0129055X05002315
            %li#BunkeRumpfSchick08
              %p#BunkeRumpfSchick08
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> U. Bunke
                , P. Rumpf,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Schick"} Thomas Schick
                = succeed "," do
                  %em
                    The topology of
                    = succeed "-duality" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi T
                          %annotation{:encoding => "application/x-tex"} T
                    = succeed "-bundles" do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi T
                              %mi n
                          %annotation{:encoding => "application/x-tex"} T^n
                %strong 18
                1103 (2006) &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math.GT/0501487"}> arXiv:math.GT/0501487
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/S0129055X06002875"} doi:10.1142/S0129055X06002875
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Markus+Spitzweck"} Markus Spitzweck
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Schick"} Thomas Schick
                = succeed "," do
                  %em Periodic twisted cohomology and T-duality
          %p
            A refined version of this using
            %a.existingWikiWord{:href => "/nlab/show/smooth+stacks"} smooth stacks
            is due to
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ulrich+Bunke"}> Ulrich Bunke
                ,
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
                = succeed "," do
                  %em T-Duality via Gerby Geometry and Reductions
                %strong 27
                05 1550013 (2015) &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/1305.6050"}> arXiv:1305.6050
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1142/S0129055X15500130"} doi:10.1142/S0129055X15500130
            %li#Nikolaus14
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"}> Thomas Nikolaus
                ,
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/T-Duality+in+K-theory+and+Elliptic+Cohomology"} T-Duality in K-theory and Elliptic Cohomology
                = succeed "," do
                  %em String Geometry Network Meeting
                = succeed ")" do
                  %a{:href => "http://www.ingvet.kau.se/juerfuch/conf/esi14/esi14_34.html"} website
          %p
            There is also
            %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebraic
            version of toplogical T-duality, .e. in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/noncommutative+topology"} noncommutative topology
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/non-commutative+geometry"} non-commutative geometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"}> Varghese Mathai
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"} Jonathan Rosenberg
              %em T-Duality for Torus Bundles with H-Fluxes via Noncommutative Topology
              (
              %a{:href => "http://arxiv.org/abs/hep-th/0401168"}> arXiv:hep-th/0401168
              )
          %p
            The equivalence of the
            %a.existingWikiWord{:href => "/nlab/show/C%2A-algebra"} C*-algebraic
            to the Bunke-Schick version, when the latter exists, is discussed in
          %ul
            %li
              Ansgar Schneider,
              %em Die lokale Struktur von T-Dualitnätstripeln
              (
              %a{:href => "https://arxiv.org/abs/0712.0260"}> arXiv:0712.0260
              )
          %p Introduction and review:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jonathan+Rosenberg"}> Jonathan Rosenberg
                ,
                = succeed "," do
                  %em
                    Topology,
                    = succeed "-algebras," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi C
                              %mo *
                          %annotation{:encoding => "application/x-tex"} C^*
                = succeed "," do
                  %strong 111
                = succeed "," do
                  %a{:href => "https://doi.org/10.1090/cbms/111"} doi:10.1090/cbms/111
                = succeed "&rbrack;" do
                  %a{:href => "http://www.zentralblatt-math.org/zmath/en/advanced/?q=an:05632075&type=pdf&format=complete"} ZMATH
            %li
              %p
                §1 in
                %a{:href => "#Waldorf22"} Waldorf 2022
          %p
            Another discussion that instead of
            %a.existingWikiWord{:href => "/nlab/show/noncommutative+geometry"} noncommutative geometry
            uses
            %a.existingWikiWord{:href => "/nlab/show/topological+groupoids"} topological groupoids
            is in
          %ul
            %li
              Calder Daenzer,
              %em A groupoid approach to noncommutative T-duality
              (
              %a{:href => "http://arxiv.org/abs/0704.2592"}> arXiv:0704.2592
              )
          %p
            Comments in relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/T-folds"} T-folds
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Bouwknegt"}> Peter Bouwknegt
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ashwin+S.+Pande"} Ashwin S. Pande
              = succeed "," do
                %em Topological T-duality and T-folds
              %strong 13
              5 (2009) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/0810.4374"}> arXiv:0810.4374
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://dx.doi.org/10.4310/ATMP.2009.v13.n5.a6"} doi:10.4310/ATMP.2009.v13.n5.a6
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/bi-brane"} bi-brane
            perspective on T-duality is amplified in
          %ul
            %li#SarkissianSchweigert08
              Gor Sarkissian,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Schweigert"} Christoph Schweigert
              %em Some remarks on defects and duality
              (
              %a{:href => "http://arxiv.org\n/abs/0810.3159"}> arXiv:0810.3159
              )
          %p
            Discussion for non-free torus actions (physically:
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/KK-monopoles"} KK-monopoles
          %ul
            %li#Pande06
              %a.existingWikiWord{:href => "/nlab/show/Ashwin+S.+Pande"}> Ashwin S. Pande
              ,
              = succeed "," do
                %em Topological T-duality and Kaluza-Klein Monopoles
              %strong 12
              (2007) 185-215 &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math-ph/0612034"}> arXiv:math-ph/0612034
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://dx.doi.org/10.4310/ATMP.2008.v12.n1.a3"} doi:10.4310/ATMP.2008.v12.n1.a3
          %p
            Discussion in
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            %a.existingWikiWord{:href => "/nlab/show/dg-geometry"} dg-geometry
            is in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ernesto+Lupercio"}> Ernesto Lupercio
              , Camilo Rengifo,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bernardo+Uribe"} Bernardo Uribe
              %em T-duality and exceptional generalized geometry through symmetries of dg-manifolds
              (
              %a{:href => "https://arxiv.org/abs/1208.6048"}> arXiv:1208.6048
              )
          %p
            and a derivation of the rules of topological T-duality from analysis of the
            %a.existingWikiWord{:href => "/nlab/show/super+p-brane"} super p-brane
            super-cocycles in super rational homotopy theory (with a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/doubled+supergeometry"} doubled supergeometry
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/T-Duality+from+super+Lie+n-algebra+cocycles+for+super+p-branes"} T-Duality from super Lie n-algebra cocycles for super p-branes
              %strong 22
              5 (2018) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1611.06536"}> arXiv:1611.06536
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://dx.doi.org/10.4310/ATMP.2018.v22.n5.a3"} doi:10.4310/ATMP.2018.v22.n5.a3
          %p reviewed in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/T-duality+in+rational+homotopy+theory+via+strong+homomotopy+Lie+algebras"} T-duality in rational homotopy theory via strong homomotopy Lie algebras
                %a{:href => "http://geo-top.org/GTMP/index.php/volume-1-2018/"} Geometry, Topology and Mathematical Physics Journal, Volume 1 (2018)
                (
                %a{:href => "https://arxiv.org/abs/1712.00758"}> arXiv:1712.00758
                )
            %li#Fiorenza18
              %p
                %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
                ,
                = succeed "," do
                  %em T-duality in rational homotopy theory
                = succeed "," do
                  %em
                    %a{:href => "http://conference.math.muni.cz/srni/files/archiv/2018/"} 38th Srni Winter School on Geometry and Physics
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/FiorenzaSrni2018.pdf", :title => "pdf slides"} pdf slides
          %p and further expanded on on
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              %em
                %a.existingWikiWord{:href => "/schreiber/show/Cyclification+of+Orbifolds"} Cyclification of Orbifolds
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2212.13836"}> arXiv:2212.13836
              \&amp;rbrack;
          %p See also:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              , Mattia Coloma,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Eugenio+Landi"} Eugenio Landi
              = succeed "," do
                %em A very short note on the (rational) graded Hori map
              %strong 50
              5 (2022) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2003.13066"}> arXiv:2003.13066
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1080/00927872.2021.2005076"} doi:10.1080/00927872.2021.2005076
          %p
            Comprehensive discussion in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/higher+differential+geometry"} higher differential geometry
          %ul
            %li#Alfonsi19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Luigi+Alfonsi"}> Luigi Alfonsi
                ,
                = succeed "," do
                  %em Global Double Field Theory is Higher Kaluza-Klein Theory
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1912.07089"} arXiv:1912.07089
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1002/prop.202000010"} doi:10.1002/prop.202000010
              %p
                (relating
                %a.existingWikiWord{:href => "/nlab/show/Kaluza-Klein+compactification"} Kaluza-Klein compactification
                on
                %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundles"} principal ∞-bundles
                to
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/double+field+theory"} double field theory
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/T-folds"} T-folds
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/non-abelian+T-duality"} non-abelian T-duality
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/type+II+geometry"} type II geometry
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/exceptional+geometry"} exceptional geometry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Luigi+Alfonsi"}> Luigi Alfonsi
                ,
                %em The puzzle of global Double Field Theory: open problems and the case for a Higher Kaluza-Klein perspective
                (
                %a{:href => "https://arxiv.org/abs/2007.04969"}> arXiv:2007.04969
                )
          %p See also:
          %ul
            %li
              Ashwin S. Pande:
              %em On Higher Topological T-duality Functors
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2402.12039"}> arXiv:2402.12039
              \&amp;rbrack;
          %h3#equivariant_refinement Equivariant refinement
          %p
            Discussion in the
            %a.existingWikiWord{:href => "/nlab/show/equivariant+cohomology"} equivariant
            generality, ie. as an equivalence of
            %a.existingWikiWord{:href => "/nlab/show/twisted+equivariant+K-theory"} twisted equivariant K-theory
            groups:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Tom+Dove"}> Tom Dove
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Schick"} Thomas Schick
              %em Equivariant Topological T-Duality
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2310.06064"}> arXiv:2310.06064
              \&amp;rbrack;
          %h3#ReferencesGeometricRefinement Geometric refinement
          %p
            On possible geometric refinement of topological T-duality via some form of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/differential+cohomology"} differential cohomology
          %p
            via
            %a.existingWikiWord{:href => "/nlab/show/differential+K-theory"} differential K-theory
            classes:
          %ul
            %li#KahleValentino
              %a.existingWikiWord{:href => "/nlab/show/Alexander+Kahle"}> Alexander Kahle
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Alessandro+Valentino"} Alessandro Valentino
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/T-Duality+and+Differential+K-Theory"} T-Duality and Differential K-Theory
              %strong 16
              02 (2014) &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/0912.2516"}> arXiv:0912.2516
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1142/S0219199713500144"} doi:10.1142/S0219199713500144
          %p
            using
            %a.existingWikiWord{:href => "/nlab/show/adjusted+Weil+algebra"} adjusted
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/principal+2-connections"} principal 2-connections
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hyungrok+Kim"}> Hyungrok Kim
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christian+Saemann"} Christian Saemann
                %em Non-Geometric T-Duality as Higher Groupoid Bundles with Connections
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2204.01783"}> arXiv:2204.01783
                \&amp;rbrack;
            %li#Waldorf22
              %p
                %a.existingWikiWord{:href => "/nlab/show/Konrad+Waldorf"}> Konrad Waldorf
                \:
                = succeed "," do
                  %em Geometric T-duality: Buscher rules in general topology
                %strong 25
                (2024) 1285–1358 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2207.11799"}> arXiv:2207.11799
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s00023-023-01295-0"} doi:10.1007/s00023-023-01295-0
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hyungrok+Kim"}> Hyungrok Kim
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Christian+Saemann"} Christian Saemann
                %em T-duality as Correspondences of Categorified Principal Bundles with Adjusted Connections
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2303.16162"}> arXiv:2303.16162
                \&amp;rbrack;
        .revisedby
