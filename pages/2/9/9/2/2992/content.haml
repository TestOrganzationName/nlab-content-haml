              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo :
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} q:\mathbb{Q}
          .num_defn
            %h6#definition_23 Definition
            %p
              The
              %strong absolute value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} |
                    %mo :
                    %mi ℚ
                    %mo →
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \vert(-)\vert:\mathbb{Q} \to \mathbb{Q}
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} |
                    %mi p
                    %mo{:stretchy => "false"} |
                    %mo ≔
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \vert p \vert \coloneqq \max(p, -p)
            %p
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} p:\mathbb{Q}
          .num_defn
            %h6#definition_24 Definition
            %p
              The
              %strong metric
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo :
                    %mi ℚ
                    %mo ×
                    %mi ℚ
                    %mo →
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \rho:\mathbb{Q} \times \mathbb{Q} \to \mathbb{Q}
              is defined as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mi min
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho(p, q) \coloneqq \max(p, q) - \min(p, q)
            %p
              for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} p:\mathbb{Q}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi q
                      %mo :
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} q:\mathbb{Q}
          %h3#uniform_structure_on_the_rational_numbers Uniform structure on the rational numbers
          %p
            We define the ternary relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %msub
                    %mo ∼
                    %mi ϵ
                  %mi y
                  %mo ≔
                  %mi ρ
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo &lt;
                  %mi ϵ
                %annotation{:encoding => "application/x-tex"} x \sim_\epsilon y \coloneqq \rho(x, y) \lt \epsilon
            for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} x \in \mathbb{Q}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                    %mo ∈
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} y \in \mathbb{Q}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                    %mo ∈
                    %msub
                      %mi ℚ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            are within a distance of
            = succeed "\u201D." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            %a.existingWikiWord{:href => "/nlab/show/uniform+space"} uniform space
            with respect to the
            %a.existingWikiWord{:href => "/nlab/show/uniformity"} uniformity
            %a.existingWikiWord{:href => "/nlab/show/ternary+relation"} ternary relation
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %msub
                      %mo ∼
                      %mi ϵ
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x \sim_\epsilon y
          %ol
            %li
              %p
                For every
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} x \in \mathbb{Q}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                        %mo ∈
                        %msub
                          %mi ℚ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ∼
                        %mi ϵ
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x \sim_\epsilon x
            %li
              %p
                For every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{Q}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} y \in \mathbb{Q}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} z \in \mathbb{Q}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mo ∈
                        %msub
                          %mi ℚ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \delta \in \mathbb{Q}_+
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                        %mo ∈
                        %msub
                          %mi ℚ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ∼
                        %mi δ
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \sim_\delta y
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %msub
                        %mo ∼
                        %mi ϵ
                      %mi z
                    %annotation{:encoding => "application/x-tex"} y \sim_\epsilon z
                implies that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %msub
                          %mo ∼
                          %mrow
                            %mi δ
                            %mo +
                            %mi ϵ
                        %mi z
                      %annotation{:encoding => "application/x-tex"} x \sim_{\delta + \epsilon} z
            %li
              %p
                For every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{Q}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} y \in \mathbb{Q}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                        %mo ∈
                        %msub
                          %mi ℚ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ∼
                        %mi ϵ
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \sim_\epsilon y
                implies that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %msub
                          %mo ∼
                          %mi ϵ
                        %mi x
                      %annotation{:encoding => "application/x-tex"} y \sim_\epsilon x
            %li
              %p
                For every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{Q}
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} y \in \mathbb{Q}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ∼
                        %mn 1
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \sim_1 y
                if and only if
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo &lt;
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} \rho(x, y) \lt 1
            %li
              %p
                For every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{Q}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} y \in \mathbb{Q}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mo ∈
                        %msub
                          %mi ℚ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \delta \in \mathbb{Q}_+
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                        %mo ∈
                        %msub
                          %mi ℚ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ∼
                        %mrow
                          %mi min
                          %mo{:stretchy => "false"} (
                          %mi δ
                          %mo ,
                          %mi ϵ
                          %mo{:stretchy => "false"} )
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \sim_{\min(\delta, \epsilon)} y
                implies that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ∼
                        %mi δ
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \sim_{\delta} y
                and
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %msub
                          %mo ∼
                          %mi ϵ
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x \sim_{\epsilon} y
            %li
              %p
                For every
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} x \in \mathbb{Q}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} y \in \mathbb{Q}
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mo ∈
                        %msub
                          %mi ℚ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \delta \in \mathbb{Q}_+
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϵ
                        %mo ∈
                        %msub
                          %mi ℚ
                          %mo +
                      %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo ≤
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} \delta \leq \epsilon
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %msub
                        %mo ∼
                        %mi δ
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \sim_{\delta} y
                implies that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %msub
                          %mo ∼
                          %mi ϵ
                        %mi y
                      %annotation{:encoding => "application/x-tex"} x \sim_{\epsilon} y
          %h3#algebraic_closure Algebraic closure
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/algebraic+closure"} algebraic closure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi ℚ
                    %mo ¯
                %annotation{:encoding => "application/x-tex"} \overline{\mathbb{Q}}
            of the rational numbers is called the
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/algebraic+numbers"} algebraic numbers
            %a.existingWikiWord{:href => "/nlab/show/absolute+Galois+group"} absolute Galois group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Gal
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi ℚ
                    %mo ¯
                  %mo{:stretchy => "false"} |
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Gal(\overline{\mathbb{Q}}\vert \mathbb{Q})
            has some curious properties, see
            = succeed "." do
              %a{:href => "absolute+Galois+group#OfTheRationalNumbers"} there
          %h3#topologies Topologies
          %p
            There are several interesting
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topologies
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            that make
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            into a
            %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            under addition, allowing us to define interesting fields by taking the
            %a.existingWikiWord{:href => "/nlab/show/complete+space"} completion
            with respect to this topology:
          %ol
            %li
              %p
                The
                %em
                  %a.existingWikiWord{:href => "/nlab/show/discrete+topology"} discrete topology
                is the most obvious, which is already complete.
            %li
              %p
                The
                %em absolute-value topology
                is defined by the
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi x
                          %mo −
                          %mi y
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} d(x,y) \coloneqq {|x - y|}
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
              %p
                (This topology is
                %a.existingWikiWord{:href => "/nlab/show/totally+disconnected+space"} totally disconnected
                (
                %a{:href => "totally+disconnected+space#RationalNumbersAreTotallyDisconnected"}> this exmpl.
                ))
            %li
              %p
                Fixing a
                %a.existingWikiWord{:href => "/nlab/show/prime+number"} prime number
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                  \-adic topology
                is defined by the
                %a.existingWikiWord{:href => "/nlab/show/ultrametric"} ultrametric
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mi n
                    %annotation{:encoding => "application/x-tex"} d(x,y) \coloneqq 1/n
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
                is the highest exponent on
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
                in the
                %a.existingWikiWord{:href => "/nlab/show/prime+factorization"} prime factorization
                of
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi x
                          %mo −
                          %mi y
                          %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} {|x - y|}
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                      %annotation{:encoding => "application/x-tex"} p
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/adic+number"} adic numbers
          %p
            According to
            %a.existingWikiWord{:href => "/nlab/show/Ostrowski%27s+theorem"} Ostrowski's theorem
            this are the only possibilities.
          %p
            Interestingly, (2) cannot be interpreted as a
            %a.existingWikiWord{:href => "/nlab/show/locale"} localic
            group, although the completion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} \mathbb{R}
            can. (Probably the same holds for (3); I need to check.)
          %h3#analysis Analysis
          %p
            One could analytically define the concepts of
            %a.existingWikiWord{:href => "/nlab/show/limit+of+a+function"} limit of a function
            and
            %a.existingWikiWord{:href => "/nlab/show/continuous+function"} continuous function
            with respect to the absolute-value topology, and prove that the limit of a function satisfy the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+limit+theorem"} algebraic limit theorem
            %a.existingWikiWord{:href => "/nlab/show/reciprocal+function"} reciprocal function
            on the rational numbers is well defined for non-zero rational numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℚ
                      %mrow
                        %mo ≠
                        %mn 0
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}_{\neq 0}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi I
                  %mo →
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} f:I \to \mathbb{Q}
            for open interval
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo ⊆
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} I \subseteq \mathbb{Q}
            the
            %a.existingWikiWord{:href => "/nlab/show/difference+quotient"} difference quotient
            function exists and thus the
            %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
            is well-defined for continuous functions. One could thus define
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on the rational numbers, and because the rational numbers are a Hausdorff space,
            %a.existingWikiWord{:href => "/nlab/show/analytic+functions"} analytic functions
            on the rational numbers, despite the fact that the rational numbers are a totally disconnected space.
          %p For example,
          %ul
            %li
              %p
                A rational metric space is a type
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi X
                      %mo :
                      %mi X
                      %mo ×
                      %mi X
                      %mo →
                      %msub
                        %mi ℚ
                        %mrow
                          %mo ≥
                          %mn 0
                    %annotation{:encoding => "application/x-tex"} d_X:X \times X \to \mathbb{Q}_{\geq 0}
                such that
              %ul
                %li
                  for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} x \in X
                  and
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} y \in X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi d
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d_X(x, y) = d_X(y, x)
                %li
                  for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x \in X
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi y
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} y \in X
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi z
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} z \in X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ≤
                        %msub
                          %mi d
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo +
                        %msub
                          %mi d
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} d_X(x, z) \leq d_X(x, y) + d_X(y, z)
                %li
                  for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x \in X
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo =
                        %mi y
                        %mo ⇔
                        %msub
                          %mi d
                          %mi X
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} x = y \iff d_X(x, y) = 0
          %p
            One could show that any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/open+interval"} open interval
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/half-open+interval"} half-open interval
            %a.existingWikiWord{:href => "/nlab/show/closed+interval"} closed interval
            in the rational numbers is a rational metric space, with its metric inherited from the Euclidean metric on the rational numbers
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi ℚ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mi a
                      %mo −
                      %mi b
                      %mo{:stretchy => "false"} |
                  %annotation{:encoding => "application/x-tex"} d_\mathbb{Q}(x, y) = {|a - b|}
            %a.existingWikiWord{:href => "/nlab/show/partial+functions"} partial functions
            in the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %a.existingWikiWord{:href => "/nlab/show/reciprocal+function"} reciprocal function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ↦
                  %mfrac
                    %mn 1
                    %mi x
                %annotation{:encoding => "application/x-tex"} x \mapsto \frac{1}{x}
            and the
            %a.existingWikiWord{:href => "/nlab/show/rational+functions"} rational functions
            on the rational numbers.
          %p
            Then, given a rational metric space
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %msub
                      %mi d
                      %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X, d_X)
          %ul
            %li
              %p
                if it exists, the (Weierstrass)
                %a.existingWikiWord{:href => "/nlab/show/limit+of+a+function"} limit of a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} f:X \to \mathbb{Q}
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the rational numbers approaching an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} a \in X
                is a rational number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} L \in \mathbb{Q}
                with a function on the positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo :
                      %msub
                        %mi ℚ
                        %mo +
                      %mo →
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} M:\mathbb{Q}_+ \to \mathbb{Q}_+
                such that for all positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                and for all elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} b \in X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo &lt;
                      %msub
                        %mi d
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} 0 \lt d_X(a, b) \lt M(\epsilon)
                implies
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi L
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} {|f(b) - L|} \lt \epsilon
            %li
              %p
                similarly, if it exists, the (Bourbaki)
                %a.existingWikiWord{:href => "/nlab/show/limit+of+a+function"} limit of a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} f:X \to \mathbb{Q}
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the rational numbers approaching an element
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} a \in X
                is a rational number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi L
                      %mo ∈
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} L \in \mathbb{Q}
                with a function on the positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo :
                      %msub
                        %mi ℚ
                        %mo +
                      %mo →
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} M:\mathbb{Q}_+ \to \mathbb{Q}_+
                such that for all positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                and for all elements
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} b \in X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi d
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} d_X(a, b) \lt M(\epsilon)
                implies
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi L
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mi ϵ
                    %annotation{:encoding => "application/x-tex"} {|f(b) - L|} \lt \epsilon
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/pointwise+continuous+function"} pointwise continuous function
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the rational numbers is a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} f:X \to \mathbb{Q}
                with a function from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the set of endofunctions on the positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo :
                      %mi X
                      %mo →
                      %msub
                        %mi ℚ
                        %mo +
                      %mo →
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} M:X \to \mathbb{Q}_+ \to \mathbb{Q}_+
                such that for all positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                and for all rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} a \in X
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} b \in X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \delta_X(a, b) \lt M(a, \epsilon)
                implies that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                        %mo &lt;
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} {|f(a) - f(b)|} \lt \epsilon
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/uniformly+continuous+function"} uniformly continuous function
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the rational numbers is a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} f:X \to \mathbb{Q}
                with a function on the positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo :
                      %msub
                        %mi ℚ
                        %mo +
                      %mo →
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} M:\mathbb{Q}_+ \to \mathbb{Q}_+
                such that for all positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                and for all elements numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} a \in X
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} b \in X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi δ
                        %mi X
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi b
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \delta_X(a, b) \lt M(\epsilon)
                implies that
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi a
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi b
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} |
                        %mo &lt;
                        %mi ϵ
                      %annotation{:encoding => "application/x-tex"} {|f(a) - f(b)|} \lt \epsilon
          %p
            Now, given an
            %a.existingWikiWord{:href => "/nlab/show/injection"} injection
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo :
                    %mi X
                    %mo ↪
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} i:X \hookrightarrow \mathbb{Q}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of the rational numbers,
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/pointwise+differentiable+function"} pointwise differentiable function
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the rational numbers is a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} f:X \to \mathbb{Q}
                with a
                %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
                function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ′
                      %mo :
                      %mi X
                      %mo →
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} f':X \to \mathbb{Q}
                on the rational numbers and a function from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the set of endofunctions on the positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo :
                      %mi X
                      %mo →
                      %msub
                        %mi ℚ
                        %mo +
                      %mo →
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} M:X \to \mathbb{Q}_+ \to \mathbb{Q}_+
                such that for all positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %msub
                        %mi{:mathvariant => "normal"} Q
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \epsilon \in \mathrm{Q}_+
                and for all elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} a \in X
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} b \in X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} {|f(a) - f(b)|} \lt M(a, \epsilon)
                implies that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mi ϵ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|f(b) - f(a) - f'(a)(i(b) - i(a)))|} \lt \epsilon {|f(a) - f(b)|}
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/uniformly+differentiable+function"} uniformly differentiable function
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to the rational numbers is a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} f:X \to \mathbb{Q}
                with a
                %a.existingWikiWord{:href => "/nlab/show/derivative"} derivative
                function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ′
                      %mo :
                      %mi X
                      %mo →
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} f':X \to \mathbb{Q}
                on the rational numbers and a function on the positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo :
                      %msub
                        %mi ℚ
                        %mo +
                      %mo →
                      %msub
                        %mi ℚ
                        %mo +
                    %annotation{:encoding => "application/x-tex"} M:\mathbb{Q}_+ \to \mathbb{Q}_+
                such that for all positive rational numbers
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %msub
                        %mi{:mathvariant => "normal"} Q
                        %mo +
                    %annotation{:encoding => "application/x-tex"} \epsilon \in \mathrm{Q}_+
                and for all elements
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} a \in X
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} b \in X
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi ϵ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} {|f(a) - f(b)|} \lt M(\epsilon)
                implies that
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo ′
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi i
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                      %mo &lt;
                      %mi ϵ
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                        %mo −
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi b
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} |
                    %annotation{:encoding => "application/x-tex"} {|f(b) - f(a) - f'(a)(i(b) - i(a)))|} \lt \epsilon {|f(a) - f(b)|}
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
                in rational numbers is a function
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi ℚ
                      %mo →
                      %mi ℚ
                    %annotation{:encoding => "application/x-tex"} f:\mathbb{Q} \to \mathbb{Q}
                with a
                %a.existingWikiWord{:href => "/nlab/show/sequence"} sequence
                of functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi D
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi f
                      %mo :
                      %mi ℕ
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi ℚ
                      %mo →
                      %mi ℚ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D^{(-)}f:\mathbb{N} \to (\mathbb{Q} \to \mathbb{Q})
                and a sequence of functions
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi M
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mo{:stretchy => "false"} )
                      %mi f
                      %mo :
                      %mi ℕ
                      %mo →
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi ℚ
                        %mo +
                      %mo →
                      %msub
                        %mi ℚ
                        %mo +
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} M^{(-)}f:\mathbb{N} \to (\mathbb{Q}_+ \to \mathbb{Q}_+)
                in the positive rational numbers, such that
              %ul
                %li
                  %p
                    for every element
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi x
                            %mo ∈
                            %mi X
                          %annotation{:encoding => "application/x-tex"} x \in X
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi D
                            %mn 0
                          %mi f
                          %mo{:stretchy => "false"} )
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi f
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (D^{0}f)(x) = f(x)
                %li
                  %p
                    for every natural number
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi n
                            %mo ∈
                            %mi ℕ
                          %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi ϵ
                            %mo ∈
                            %msub
                              %mi ℚ
                              %mo +
                          %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{Q}_+
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi h
                          %mo ∈
                          %mi ℚ
                        %annotation{:encoding => "application/x-tex"} h \in \mathbb{Q}
                    such that
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mn 0
                            %mo &lt;
                            %mo{:stretchy => "false"} |
                            %mi h
                            %mo{:stretchy => "false"} |
                            %mo &lt;
                            %msup
                              %mi M
                              %mi n
                            %mi f
                            %mo{:stretchy => "false"} (
                            %mi ϵ
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} 0 \lt | h | \lt M^{n}f(\epsilon)
                    = succeed "," do
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi x
                            %mo ∈
                            %mi ℚ
                          %annotation{:encoding => "application/x-tex"} x \in \mathbb{Q}
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mo |
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo +
                    %mi h
                    %mo{:stretchy => "false"} )
                    %mo −
                    %munderover
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi i
                        %mo =
                        %mn 0
                      %mi n
                    %mfrac
                      %mrow
                        %msup
                          %mi h
                          %mi i
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi D
                          %mi i
                        %mi f
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                      %mrow
                        %mi i
                        %mo !
                    %mo |
                  %mo &lt;
                  %mi ϵ
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi h
                    %mi n
                  %mo{:stretchy => "false"} |
                %annotation{:encoding => "application/x-tex"} \left|f(x + h) - \sum_{i=0}^n \frac{h^i (D^{i}f)(x)}{i!}\right| \lt \epsilon |h^n|
          %p
            Alternatively, we could use
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimals"} infinitesimals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ϵ
                    %mn 2
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}[\epsilon]/(\epsilon^2 = 0)
            be the dual rational numbers, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}[[\epsilon]]
            be the commutative ring of
            %a.existingWikiWord{:href => "/nlab/show/formal+power+series"} formal power series
            on the rational numbers. The former is equivalent to the product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo ×
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q} \times \mathbb{Q}
            and the latter is equivalent to the
            %a.existingWikiWord{:href => "/nlab/show/function+set"} function set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℚ
                      %mi ℕ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}^\mathbb{N}
          %p
            Both of these are commutative
            %a.existingWikiWord{:href => "/nlab/show/rational+algebras"} rational algebras
            with ring homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi h
                  %mo :
                  %mi ℚ
                  %mo →
                  %mi ℚ
                  %mo{:stretchy => "false"} [
                  %mi ϵ
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ϵ
                    %mn 2
                  %mo =
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} h:\mathbb{Q} \to \mathbb{Q}[\epsilon]/(\epsilon^2 = 0)
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mi ℚ
                    %mo →
                    %mi ℚ
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} k:\mathbb{Q} \to \mathbb{Q}[[\epsilon]]
          %ul
            %li
              A function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} f:X \to \mathbb{Q}
              is
              %strong differentiable
              if it has a function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} lift
                      %mi f
                    %mo :
                    %mi ℚ
                    %mo{:stretchy => "false"} [
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϵ
                      %mn 2
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ℚ
                    %mo{:stretchy => "false"} [
                    %mi ϵ
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ϵ
                      %mn 2
                    %mo =
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{lift}_f:\mathbb{Q}[\epsilon]/(\epsilon^2 = 0) \to \mathbb{Q}[\epsilon]/(\epsilon^2 = 0)
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} lift
                      %mi f
                    %mo{:stretchy => "false"} (
                    %mi h
