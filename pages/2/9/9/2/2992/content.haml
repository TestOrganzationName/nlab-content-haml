          %h2#definition Definition
          %p
            A
            %em rational number
            is a
            %a.existingWikiWord{:href => "/nlab/show/fraction"} fraction
            of two
            %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/numbers"} numbers
          %h3#as_a_field As a field
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            of
            = succeed "," do
              %strong rational numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            %a.existingWikiWord{:href => "/nlab/show/field+of+fractions"} field of fractions
            of the
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/fractions"} fractions
            (“
            %a.existingWikiWord{:href => "/nlab/show/ratios"}> ratios
            ”) of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
          %h3#as_a_commutative_ring As a commutative ring
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℕ
                    %mo +
                  %mo ,
                  %mn 1
                  %mo :
                  %msup
                    %mi ℕ
                    %mo +
                  %mo ,
                  %mi s
                  %mo :
                  %msup
                    %mi ℕ
                    %mo +
                  %mo →
                  %msup
                    %mi ℕ
                    %mo +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{N}^+,1:\mathbb{N}^+,s:\mathbb{N}^+\to \mathbb{N}^+)
            be the set of positive integers. The positive integers are embedded into every
            %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inj
                  %mo :
                  %msup
                    %mi ℕ
                    %mo +
                  %mo →
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                %annotation{:encoding => "application/x-tex"} inj:\mathbb{N}^+\to\R
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inj
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} inj(1) = 1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inj
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi inj
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} inj(s(n)) = inj(n) + 1
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo :
                    %msup
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} n:\mathbb{N}^+
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            has an injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inv
                  %mo :
                  %msup
                    %mi ℕ
                    %mo +
                  %mo →
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} R
                %annotation{:encoding => "application/x-tex"} inv:\mathbb{N}^+\to\R
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inj
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mi inv
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} inj(n) \cdot inv(n) = 1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} inv
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⋅
                  %mo{:lspace => "0em", :rspace => "thinmathspace"} inj
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \inv(n) \cdot \inj(n) = 1
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo :
                    %msup
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} n:\mathbb{N}^+
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                %annotation{:encoding => "application/x-tex"} R
            is called a
            = succeed "," do
              %strong
                %a.existingWikiWord{:href => "/nlab/show/commutative+algebra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} \mathbb{Q}
                  \-algebra
            %strong rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            is the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            commutative
            = succeed "-algebra." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
          %p
            It can then be proven from the ring axioms and the properties of the integers that every rational number apart from zero and has a multiplicative inverse, making
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            a field.
          %h3#as_an_sequential_colimit_in_cring As an sequential colimit in CRing
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mo !
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/n!]
            be the
            %a.existingWikiWord{:href => "/nlab/show/localization+of+a+commutative+ring"} localization
            of the
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            %a.existingWikiWord{:href => "/nlab/show/localisation+of+a+commutative+ring+away+from+an+element"} away from
            the
            %a.existingWikiWord{:href => "/nlab/show/factorial"} factorial
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo !
                  %annotation{:encoding => "application/x-tex"} n!
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} i \in \mathbb{N}
            %a.existingWikiWord{:href => "/nlab/show/ring+homomorphism"} ring homomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi h
                    %mi i
                  %mo :
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi i
                  %mo !
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo +
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo !
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} h_{i}:\mathbb{Z}[1/i!]\to\mathbb{Z}[1/(i + 1)!]
            defined by the
            %a.existingWikiWord{:href => "/nlab/show/universal+property"} universal property
            of localisation of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mi i
                  %mo !
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/i!]
            away from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} i + 1
            %strong rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            is the
            %a.existingWikiWord{:href => "/nlab/show/sequential+colimit"} sequential colimit
            of the
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 0
                  %mo !
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi h
                        %mn 0
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 1
                  %mo !
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi h
                        %mn 1
                  %mi ℤ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo !
                  %mo{:stretchy => "false"} ]
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi h
                        %mn 2
                  %mi …
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}[1/0!] \overset{h_0}\to \mathbb{Z}[1/1!] \overset{h_1}\to \mathbb{Z}[1/2!] \overset{h_2}\to \ldots
          %h3#as_an_abelian_group As an abelian group
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℕ
                    %mo +
                  %mo ,
                  %mn 1
                  %mo :
                  %msup
                    %mi ℕ
                    %mo +
                  %mo ,
                  %mi s
                  %mo :
                  %msup
                    %mi ℕ
                    %mo +
                  %mo →
                  %msup
                    %mi ℕ
                    %mo +
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{N}^+,1:\mathbb{N}^+,s:\mathbb{N}^+\to \mathbb{N}^+)
            be the set of positive integers and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi ℤ
                  %mo ,
                  %mn 0
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\mathbb{Z},0,+,-,1)
            be the
            %a.existingWikiWord{:href => "/nlab/show/free+abelian+group"} free abelian group
            on the set
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} {1}
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            be an
            %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            containing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            as an abelian subgroup. The positive integers are embedded into the
            %a.existingWikiWord{:href => "/nlab/show/function+algebra"} function abelian group
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A \to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi id
                    %mi A
                  %mo :
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} id_A:A \to A
            being the
            %a.existingWikiWord{:href => "/nlab/show/identity+function"} identity function
            on
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inj
                  %mo :
                  %msup
                    %mi ℕ
                    %mo +
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} inj:\mathbb{N}^+\to (A \to A)
            such that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inj
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi id
                    %mi A
                %annotation{:encoding => "application/x-tex"} inj(1) = id_A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inj
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi inj
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo +
                  %msub
                    %mi id
                    %mi A
                %annotation{:encoding => "application/x-tex"} inj(s(n)) = inj(n) + id_A
            for all
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo :
                    %msup
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} n:\mathbb{N}^+
          %p
            Suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            has an injection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inv
                  %mo :
                  %msup
                    %mi ℕ
                    %mo +
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} inv:\mathbb{N}^+\to (A \to A)
            such that for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo :
                    %msup
                      %mi ℕ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} n:\mathbb{N}^+
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi inj
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi inv
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi id
                    %mi A
                %annotation{:encoding => "application/x-tex"} inj(n) \circ inv(n) = id_A
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi inv
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi inj
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi id
                      %mi A
                  %annotation{:encoding => "application/x-tex"} inv(n) \circ inj(n) = id_A
            %strong rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            is the
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial
            such abelian group.
          %h3#as_an_initial_object_in_a_category As an initial object in a category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            be the
            %a.existingWikiWord{:href => "/nlab/show/integers"} integers
            and let
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mrow
                      %mo #
                      %mn 0
                  %mo ≔
                  %mo{:stretchy => "false"} {
                  %mi a
                  %mo ∈
                  %mi ℤ
                  %mo{:stretchy => "false"} |
                  %mi a
                  %mo &lt;
                  %mn 0
                  %mo ∨
                  %mn 0
                  %mo &lt;
                  %mi a
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{#0} \coloneqq \{a \in \mathbb{Z} \vert a \lt 0 \vee 0 \lt a \}
          %p be the set of integers apart from zero.
          %p
            For lack of a better name, let us define a
            %em set with rational numbers
            to be a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            with a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ι
                  %mo ∈
                  %mi ℤ
                  %mo ×
                  %msub
                    %mi ℤ
                    %mrow
                      %mo #
                      %mn 0
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \iota \in \mathbb{Z} \times \mathbb{Z}_{#0} \to A
            with domain the Cartesian product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo ×
                  %msub
                    %mi ℤ
                    %mrow
                      %mo #
                      %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{Z} \times \mathbb{Z}_{#0}
            and codomain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi ℤ
                  %mo .
                  %mo ∀
                  %mi b
                  %mo ∈
                  %msub
                    %mi ℤ
                    %mrow
                      %mo #
                      %mn 0
                  %mo .
                  %mo ∀
                  %mi c
                  %mo ∈
                  %mi ℤ
                  %mo .
                  %mo ∀
                  %mi d
                  %mo ∈
                  %msub
                    %mi ℤ
                    %mrow
                      %mo #
                      %mn 0
                  %mo .
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⋅
                  %mi d
                  %mo =
                  %mi c
                  %mo ⋅
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ⇒
                  %mo{:stretchy => "false"} (
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ι
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall a \in \mathbb{Z}. \forall b \in \mathbb{Z}_{#0}. \forall c \in \mathbb{Z}. \forall d \in \mathbb{Z}_{#0}. (a \cdot d = c \cdot b) \implies (\iota(a, b) = \iota(c, d))
          %p
            A
            %em homomorphism of sets with rational numbers
            between two sets with rational numbers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            is a function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ∈
                  %msup
                    %mi B
                    %mi A
                %annotation{:encoding => "application/x-tex"} f \in B^A
            such that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∀
                  %mi a
                  %mo ∈
                  %mi ℤ
                  %mo .
                  %mo ∀
                  %mi b
                  %mo ∈
                  %msub
                    %mi ℤ
                    %mrow
                      %mo #
                      %mn 0
                  %mo .
                  %mi f
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ι
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi ι
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \forall a \in \mathbb{Z}. \forall b \in \mathbb{Z}_{#0}. f(\iota_A(a, b)) = \iota_B(a, b)
          %p
            The
            %em category of sets with rational numbers
            is the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi SwRN
                %annotation{:encoding => "application/x-tex"} SwRN
            whose objects
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi SwRN
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ob(SwRN)
            are sets with rational numbers and whose morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Mor
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Mor(A,B)
            for sets with rational numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi SwDF
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in Ob(SwDF)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ∈
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi SwRN
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B \in Ob(SwRN)
            are homomorphisms of sets with rational numbers. The set of
            = succeed "," do
              %strong rational numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
          %h3#in_dependent_type_theory  In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
          %h4#as_a_dependent_sum_type As a dependent sum type
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}
            be the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ℤ
                    %mrow
                      %mo ≠
                      %mn 0
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi a
                      %mo :
                      %mi ℤ
                  %mi max
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{\neq 0} \coloneqq \sum_{a:\mathbb{Z}} \max(a,-a) \gt 0
          %p
            be the non-zero integers, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi gcd
                  %mo :
                  %mi ℤ
                  %mo ×
                  %mi ℤ
                  %mo →
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \gcd:\mathbb{Z} \times \mathbb{Z} \to \mathbb{Z}
            be the
            %a.existingWikiWord{:href => "/nlab/show/greatest+common+divisor"} greatest common divisor
            on the integers. Then the rational numbers is defined as the type of pairs of integers and non-zero integers such that the greatest common divisor is equal to one:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℚ
                  %mo ≔
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi ℤ
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi y
                      %mo :
                      %msub
                        %mi ℤ
                        %mrow
                          %mo ≠
                          %mn 0
                  %mi gcd
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo =
                    %mi ℤ
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \mathbb{Q} \coloneqq \sum_{x:\mathbb{Z}} \sum_{y:\mathbb{Z}_{\neq 0}} \gcd(x, \pi_1(y)) =_\mathbb{Z} 1
          %p
            We define the function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi ℤ
                  %mo ×
                  %msub
                    %mi ℤ
                    %mrow
                      %mo ≠
                      %mn 0
                  %mo →
                  %mi ℚ
                %annotation{:encoding => "application/x-tex"} (-)/(-) : \mathbb{Z} \times \mathbb{Z}_{\neq 0} \rightarrow \mathbb{Q}
            for all integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo :
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} a:\mathbb{Z}
            and non-zero integers
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo :
                  %msub
                    %mi ℤ
                    %mrow
                      %mo ≠
                      %mn 0
                %annotation{:encoding => "application/x-tex"} b:\mathbb{Z}_{\neq 0}
            by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo{:stretchy => "false"} /
                  %mi b
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ÷
                  %mi gcd
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ÷
                  %mi gcd
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a/b \coloneqq (a \div \gcd(a, \pi_1(b)), \pi_1(b) \div \gcd(a, \pi_1(b)), p(a, b))
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(a, b)
            is the witness that the greatest common divisor of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ÷
                  %mi gcd
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} a \div \gcd(a, \pi_1(b))
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo ÷
                  %mi gcd
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %msub
                    %mi π
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_1(b) \div \gcd(a, \pi_1(b))
            is equal to 1, and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                  %mo ÷
                  %mi b
                %annotation{:encoding => "application/x-tex"} a \div b
            is
            %a.existingWikiWord{:href => "/nlab/show/integer"} integer
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/division"} division
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+domain"} Euclidean domain
            and thus have a division and remainder operation.
          %h4#as_a_higher_inductive_type As a higher inductive type
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
            = succeed "," do
              %strong rational numbers
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℚ
                  %annotation{:encoding => "application/x-tex"} \mathbb{Q}
            = succeed ")" do
              %a{:href => "#UBP13"} UBP13, §11.1
            %a.existingWikiWord{:href => "/nlab/show/higher+inductive+type"} higher inductive type
            generated by:
          %ul
            %li
              %p
                A function
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} /
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi ℤ
                        %mo ×
                        %msub
                          %mi ℤ
                          %mrow
                            %mo ≠
                            %mn 0
                        %mo →
                        %mi ℚ
                      %annotation{:encoding => "application/x-tex"} (-)/(-) : \mathbb{Z} \times \mathbb{Z}_{\neq 0} \rightarrow \mathbb{Q}
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mrow
                          %mo ≠
                          %mn 0
                      %mo ≔
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi a
                          %mo :
                          %mi ℤ
                      %mi max
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ,
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi a
                      %mo{:stretchy => "false"} )
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_{\neq 0} \coloneqq \sum_{a:\mathbb{Z}} \max(a,-a) \gt 0
            %li
              %p A dependent product of functions between identities representing that equivalent fractions are equal:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi equivfrac
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi a
                          %mo :
                          %mi ℤ
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi b
                          %mo :
                          %msub
                            %mi ℤ
                            %mrow
                              %mo ≠
                              %mn 0
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi c
                          %mo :
                          %mi ℤ
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi d
                          %mo :
                          %msub
                            %mi ℤ
                            %mrow
                              %mo ≠
                              %mn 0
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ⋅
                      %msub
                        %mi π
                        %mn 1
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi c
