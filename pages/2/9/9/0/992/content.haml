            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/A-%E2%88%9E+category"} A-∞ category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/triangulated+category"}> triangulated category
                ,
                %a.existingWikiWord{:href => "/nlab/show/enhanced+triangulated+category"} enhanced triangulated category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/t-structure+on+a+stable+%28%E2%88%9E%2C1%29-category"}> t-structure on a stable (∞,1)-category
                ,
                %a.existingWikiWord{:href => "/nlab/show/heart+of+a+stable+%28%E2%88%9E%2C1%29-category"} heart of a stable (∞,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/K-theory+of+a+stable+%28%E2%88%9E%2C1%29-category"} K-theory of a stable (∞,1)-category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spectral+sequence+of+a+filtered+stable+homotopy+type"} spectral sequence of a filtered stable homotopy type
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/prime+spectrum+of+a+symmetric+monoidal+stable+%28%E2%88%9E%2C1%29-category"} prime spectrum of a symmetric monoidal stable (∞,1)-category
          %h2#references References
          %p
            The abstract
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+theory"} (∞,1)-category theoretical
            notion was introduced and studied in
          %ul
            %li#StabCat
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Stable+Infinity-Categories"} Stable Infinity-Categories
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/math/0608228"} arXiv:math/0608228
          %p
            This appears in a more comprehensive context of
            %a.existingWikiWord{:href => "/nlab/show/higher+algebra"} higher algebra
          %ul
            %li#HigherAlgebra
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              , as section 1 of:
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
          %p A brief introduction is in
          %ul
            %li#Harpaz2013
              %a.existingWikiWord{:href => "/nlab/show/Yonatan+Harpaz"}> Yonatan Harpaz
              ,
              = succeed "," do
                %em
                  Introduction to stable
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/HarpazStableInfinityCategory2013.pdf", :title => "pdf"} pdf
          %p
            Discussion of how
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/dg-categories"} dg-categories
            %a.existingWikiWord{:href => "/nlab/show/A-infinity+categories"} A-infinity categories
            present
            = succeed "-linear" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li#Cohn13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Lee+Cohn"}> Lee Cohn
                ,
                %em Differential Graded Categories are k-linear Stable Infinity Categories
                (
                %a{:href => "http://arxiv.org/abs/1308.2587"}> arXiv:1308.2587
                )
            %li#Faonte13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Giovanni+Faonte"}> Giovanni Faonte
                ,
                %em Simplicial nerve of an A-infinity category
                (
                %a{:href => "http://arxiv.org/abs/1312.2127"}> arXiv:1312.2127
                )
          %p
            A diagram of the interrelation of all models for stable
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/enhanced+triangulated+categories"} enhanced triangulated categories
          %ul
            %li#Schwede
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Markus+Hausmann"} Markus Hausmann
              = succeed "," do
                %em Enhancements of triangulated categories
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/files/Schwede_EnhancedSeminar.pdf", :title => "pdf"} pdf
          %p
            For discussion of the
            %a.existingWikiWord{:href => "/nlab/show/stable+model+category"} stable model category
            models of stable
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li#SchwedeShipley
              %a.existingWikiWord{:href => "/nlab/show/Stefan+Schwede"}> Stefan Schwede
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Brooke+Shipley"} Brooke Shipley
              %em Classification of stable model categories
              (
              %a{:href => "http://hopf.math.purdue.edu/Schwede-Shipley/class.final.pdf"}> Hopf pdf
              ) and (
              %a{:href => "http://arxiv.org/abs/math/0108143"}> arXiv:math/0108143
              )
          %p The enrichment over spectra is made precise in
          %ul
            %li#GepnerHaugseng13
              %a.existingWikiWord{:href => "/nlab/show/David+Gepner"}> David Gepner
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Rune+Haugseng"} Rune Haugseng
              %em Enriched ∞-categories via non-symmetric ∞-operads
              (
              %a{:href => "http://arxiv.org/abs/1312.3178"}> arXiv:1312.3178
              )
