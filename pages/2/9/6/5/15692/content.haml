                              %mo ∫
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn ∞
                              %mn ∞
                            %mi sin
                            %mrow
                              %mo (
                              %msqrt
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %msubsup
                                    %mrow
                                      %mo{:stretchy => "false"} |
                                      %mi x
                                      %mo −
                                      %mi y
                                      %mo{:stretchy => "false"} |
                                    %mi η
                                    %mn 2
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi m
                                    %mi c
                                  %mi ℏ
                              %mrow
                                %mo (
                                %mi cosh
