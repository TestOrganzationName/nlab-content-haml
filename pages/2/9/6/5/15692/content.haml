              which makes use of the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ω
                    %mo{:stretchy => "false"} (
                    %mi κ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \omega(\kappa)
              is non-negative, by construction. This
              %a.existingWikiWord{:href => "/nlab/show/change+of+integration+variables"} change of integration variables
              makes the integrals under the braces above become
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo ±
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mo ∫
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn ∞
                      %mn ∞
                    %mi sin
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mrow
                            %mi m
                            %mi c
                          %mi ℏ
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi x
                          %mn 0
                        %mo −
                        %msup
                          %mi y
                          %mn 0
                        %mo{:stretchy => "false"} )
                        %mi cosh
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo ±
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mover
                            %mi x
                            %mo{:stretchy => "false"} →
                          %mo −
                          %mover
                            %mi y
                            %mo{:stretchy => "false"} →
                          %mo{:stretchy => "false"} |
                        %mi sinh
                        %mo{:stretchy => "false"} (
                        %mi z
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mi d
                    %mi z
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    I_\pm
                    \\;=\;
                    \\int_{-\infty}^\infty
                    \\sin\left(
                    \\tfrac{m c}{\hbar}
                    \\left(
                    (x^0 - y^0) \cosh(z)
                    \\pm
                    {\vert \vec x - \vec y\vert}
                    \\sinh(z)
                    \\right)
                    \\right)
                    \\, d z
                    \\,.
            %p
              Next we similarly parameterize the vector
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x-y
              by its
              %a.existingWikiWord{:href => "/nlab/show/rapidity"} rapidity
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x-y
              is spacelike or not, and if not, whether it is future or past directed.
            %p
              First, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x-y
              is
              %a.existingWikiWord{:href => "/nlab/show/spacelike"} spacelike
              in that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mi x
                        %mo −
                        %mi y
                        %mo{:stretchy => "false"} |
                      %mi η
                      %mn 2
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} {\vert x-y\vert}^2_\eta \gt 0
              then we may parameterize as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 0
                    %mo −
                    %msup
                      %mi y
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msqrt
                      %mrow
                        %msubsup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                    %mi sinh
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AA
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AA
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo −
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} |
                    %mo =
                    %msqrt
                      %mrow
                        %msubsup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                    %mi cosh
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (x^0 - y^0)
                    \=
                    \\sqrt{{\vert x-y\vert}^2_\eta} \sinh(\tau)
                    \\phantom{AA}
                    \\,,
                    \\phantom{AA}
                    {\vert \vec x - \vec y\vert}
                    \=
                    \\sqrt{ {\vert x-y\vert}^2_\eta} \cosh(\tau)
            %p which yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi I
                              %mo ±
                          %mtd
                            %mo =
                            %msubsup
                              %mo ∫
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn ∞
                              %mn ∞
                            %mi sin
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi m
                                    %mi c
                                  %mi ℏ
                              %msqrt
                                %mrow
                                  %msubsup
                                    %mrow
                                      %mo{:stretchy => "false"} |
                                      %mi x
                                      %mo −
                                      %mi y
                                      %mo{:stretchy => "false"} |
                                    %mi η
                                    %mn 2
                              %mrow
                                %mo (
                                %mi sinh
                                %mo{:stretchy => "false"} (
                                %mi τ
                                %mo{:stretchy => "false"} )
                                %mi cosh
                                %mo{:stretchy => "false"} (
                                %mi z
                                %mo{:stretchy => "false"} )
                                %mo ±
                                %mi cosh
                                %mo{:stretchy => "false"} (
                                %mi τ
                                %mo{:stretchy => "false"} )
                                %mi sinh
                                %mo{:stretchy => "false"} (
                                %mi z
                                %mo{:stretchy => "false"} )
                                %mo )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mi d
                            %mi z
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mo ∫
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn ∞
                              %mn ∞
                            %mi sin
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi m
                                    %mi c
                                  %mi ℏ
                              %msqrt
                                %mrow
                                  %msubsup
                                    %mrow
                                      %mo{:stretchy => "false"} |
                                      %mi x
                                      %mo −
                                      %mi y
                                      %mo{:stretchy => "false"} |
                                    %mi η
                                    %mn 2
                              %mrow
                                %mo (
                                %mi sinh
                                %mrow
                                  %mo (
                                  %mi τ
                                  %mo ±
                                  %mi z
                                  %mo )
                                %mo )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mi d
                            %mi z
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msubsup
                              %mo ∫
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn ∞
                              %mn ∞
                            %mi sin
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
                                %mfrac
                                  %mrow
                                    %mi m
                                    %mi c
                                  %mi ℏ
                              %msqrt
                                %mrow
                                  %msubsup
                                    %mrow
                                      %mo{:stretchy => "false"} |
                                      %mi x
                                      %mo −
                                      %mi y
                                      %mo{:stretchy => "false"} |
                                    %mi η
                                    %mn 2
                              %mrow
                                %mo (
                                %mi sinh
                                %mrow
                                  %mo (
                                  %mi z
                                  %mo )
                                %mo )
                              %mo )
                            %mspace{:width => "thinmathspace"}
                            %mi d
                            %mi z
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mn 0
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    I_{\pm}
                    \&amp; =
                    \\int_{-\infty}^\infty
                    \\sin\left(
                    \\tfrac{m c}{\hbar}
                    \\sqrt{ {\vert x-y\vert}^2_\eta }
                    \\left(
                    \\sinh(\tau) \cosh(z)
                    \\pm
                    \\cosh(\tau)
                    \\sinh(z)
                    \\right)
                    \\right)
                    \\, d z
                    \\\
                    \&amp; =
                    \\int_{-\infty}^\infty
                    \\sin\left(
                    \\tfrac{m c}{\hbar}
                    \\sqrt{ {\vert x-y\vert}^2_\eta}
                    \\left(
                    \\sinh\left( \tau \pm z\right)
                    \\right)
                    \\right)
                    \\, d z
                    \\\
                    \&amp; =
                    \\int_{-\infty}^\infty
                    \\sin\left(
                    \\tfrac{m c}{\hbar}
                    \\sqrt{ {\vert x-y\vert}^2_\eta }
                    \\left(
                    \\sinh\left( z \right)
                    \\right)
                    \\right)
                    \\, d z
                    \\\
                    \&amp; = 0
                    \\,,
                    \\end{aligned}
            %p
              where in the last line we observe that the integrand is a skew-symmetric function of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi z
                    %annotation{:encoding => "application/x-tex"} z
            %p
              Second, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x-y
              is
              %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 0
                    %mo −
                    %msup
                      %mi y
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (x^0 - y^0) \gt 0
              then we may parameterize as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 0
                    %mo −
                    %msup
                      %mi y
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msqrt
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msubsup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                    %mi cosh
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AA
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                    %mphantom
                      %mi AA
                    %mrow
                      %mo{:stretchy => "false"} |
                      %mover
                        %mi x
                        %mo{:stretchy => "false"} →
                      %mo −
                      %mover
                        %mi y
                        %mo{:stretchy => "false"} →
                      %mo{:stretchy => "false"} |
                    %mo =
                    %msqrt
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %msubsup
                          %mrow
                            %mo{:stretchy => "false"} |
                            %mi x
                            %mo −
                            %mi y
                            %mo{:stretchy => "false"} |
                          %mi η
                          %mn 2
                    %mi sinh
                    %mo{:stretchy => "false"} (
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (x^0 - y^0)
                    \=
                    \\sqrt{ -{\vert x-y\vert}^2_\eta} \cosh(\tau)
                    \\phantom{AA}
                    \\,,
                    \\phantom{AA}
                    {\vert \vec x - \vec y\vert}
                    \=
                    \\sqrt{ -{\vert x - y\vert}^2_\eta }
                    \\sinh(\tau)
            %p which yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi I
                              %mo ±
                          %mtd
                            %mo =
                            %msubsup
                              %mo ∫
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mn ∞
                              %mn ∞
                            %mi sin
                            %mrow
                              %mo (
                              %mstyle{:displaystyle => "false"}
