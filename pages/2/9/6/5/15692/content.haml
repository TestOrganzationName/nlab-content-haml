          %p It follows immediately that:
          #SymmetricFeynmanPropagator.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                is symmetric)
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                  %annotation{:encoding => "application/x-tex"} \Delta_F
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FeynmanPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
