                    %mo ∫
                    %mn 0
                    %mn ∞
                  %msup
                    %mi t
                    %mrow
                      %mi s
                      %mo −
                      %mn 1
                  %mi Tr
                  %mspace{:width => "thinmathspace"}
                  %mi exp
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi t
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mi d
                  %mi t
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Tr_{reg} H^{-s} = \int_0^\infty t^{s-1} Tr\, \exp(-t H)\,d t
                  \\,.
