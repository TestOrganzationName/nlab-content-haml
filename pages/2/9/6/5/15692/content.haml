                                  %mi x
                                  %mn 0
                                %mo −
                                %msup
                                  %mi y
                                  %mn 0
                                %mo{:stretchy => "false"} )
                                %mi cosh
                                %mo{:stretchy => "false"} (
                                %mi z
                                %mo{:stretchy => "false"} )
                                %mo ±
                                %mrow
                                  %mo{:stretchy => "false"} |
                                  %mover
                                    %mi x
                                    %mo{:stretchy => "false"} →
                                  %mo −
                                  %mover
                                    %mi y
                                    %mo{:stretchy => "false"} →
                                  %mo{:stretchy => "false"} |
