                                    %mi m
                                    %mi c
                                  %mi ℏ
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    I_\pm
                    \&amp; =
                    \\int_{-\infty}^\infty
                    \\sin\left(
                    \\tfrac{m c}{\hbar}
                    \\left(
                    (x^0 - y^0) \cosh(z)
                    \\pm
                    {\vert \vec x - \vec y\vert}
                    \\sinh(z)
                    \\right)
                    \\right)
                    \\, d z
                    \\\
                    \&amp; =
                    \\int_{-\infty}^\infty
                    \\sin\left(
                    \\sqrt{ - {\vert x-y\vert}^2_\eta }
                    \\tfrac{m c}{\hbar}
                    \\left(
                    \\cosh(\tau)\cosh(z)
                    \\pm
                    \\cosh(\tau)
                    \\sinh(z)
                    \\right)
                    \\right)
                    \\, d z
                    \\\
                    \&amp; =
                    \\int_{-\infty}^\infty
                    \\sin\left(
                    \\sqrt{ - {\vert x-y\vert}^2_\eta }
                    \\tfrac{m c}{\hbar}
                    \\left(
                    \\cosh(z \pm \tau)
                    \\right)
                    \\right)
                    \\, d z
                    \\\
                    \&amp; =
                    \\pi J_0\left( \sqrt{ - {\vert x-y\vert}^2_\eta} \tfrac{m c}{\hbar} \right)
                    \\end{aligned}
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi J
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} J_0
              denotes the
              %a.existingWikiWord{:href => "/nlab/show/Bessel+function"} Bessel function
              of order 0. The important point here is that this is a smooth function.
            %p
              Similarly, if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo −
                    %mi y
                  %annotation{:encoding => "application/x-tex"} x-y
              is
              %a.existingWikiWord{:href => "/nlab/show/timelike"} timelike
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi x
                      %mn 0
                    %mo −
                    %msup
                      %mi y
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo &lt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} (x^0 - y^0) \lt 0
              then the same argument yields
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi I
                      %mo ±
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi π
                    %msub
                      %mi J
                      %mn 0
                    %mrow
                      %mo (
                      %msqrt
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
