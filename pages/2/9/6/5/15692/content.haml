                    WF(\Delta_S) = \left\{ (x,k) \,\vert\, {\vert x\vert}^2_\eta = 0 \;\text{and} \; {\vert k\vert}^2_\eta = 0 \; \text{and} \, k \neq 0  \right\}
            %center
              %img{:src => "https://ncatlab.org/nlab/files/RetGreenFunction.png", :width => "60"}/
              %br/
              \-
              %br/
              %img{:src => "https://ncatlab.org/nlab/files/AdvancedGreenFunction.png", :width => "60"}/
            %ul
              %li
                the
                %a.existingWikiWord{:href => "/nlab/show/Wightman+propagator"} Wightman propagator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi H
                    %annotation{:encoding => "application/x-tex"} \Delta_H
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#StandardHadamardDistributionOnMinkowskiSpacetime"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x,k)
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                both on the light cone and
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi k
                          %mn 0
                        %mo &gt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} k^0 \gt 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %msubsup
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi x
                          %mo{:stretchy => "false"} |
                        %mi η
                        %mn 2
                      %mo =
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mtext and
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi k
                          %mo{:stretchy => "false"} |
                        %mi η
                        %mn 2
                      %mo =
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mtext and
                      %mspace{:width => "thickmathspace"}
                      %msup
                        %mi k
                        %mn 0
                      %mo &gt;
                      %mn 0
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    WF(\Delta_H) = \left\{ (x,k) \,\vert\, {\vert x\vert}^2_\eta = 0 \;\text{and} \; {\vert k\vert}^2_\eta = 0 \; \text{and} \; k^0 \gt 0   \right\}
            %center
              %img{:src => "https://ncatlab.org/nlab/files/HadamardPropagator.png", :width => "60"}/
            %ul
              %li
                the
                %a.existingWikiWord{:href => "/nlab/show/Feynman+propagator"} Feynman propagator
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \Delta_S
                (def.
                = succeed ")" do
                  %a.maruku-ref{:href => "#FeynmanPropagatorForKleinGordonEquationOnMinkowskiSpacetime"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (x,k)
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
                both on the light cone and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ±
                      %msub
                        %mi k
                        %mn 0
                      %mo &gt;
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mo ⇔
                      %mspace{:width => "thickmathspace"}
                      %mo ±
                      %msup
                        %mi x
                        %mn 0
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \pm k_0 \gt 0 \;\Leftrightarrow\; \pm x^0 \gt 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi WF
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Δ
                      %mi H
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thinmathspace"}
                      %msubsup
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi x
                          %mo{:stretchy => "false"} |
                        %mi η
                        %mn 2
                      %mo =
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mtext and
                      %mspace{:width => "thickmathspace"}
                      %msubsup
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi k
                          %mo{:stretchy => "false"} |
                        %mi η
                        %mn 2
                      %mo =
                      %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mtext and
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %mo ±
                        %msub
                          %mi k
                          %mn 0
                        %mo &gt;
                        %mn 0
                        %mspace{:width => "thickmathspace"}
                        %mo ⇔
                        %mspace{:width => "thickmathspace"}
                        %mo ±
                        %msup
                          %mi x
                          %mn 0
                        %mo &gt;
                        %mn 0
