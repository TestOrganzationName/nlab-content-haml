          %p
            Early discussion of application of the Chu construction as
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            for
            %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            is due to
            %a{:href => "#Barr91"} Barr 1991
            and, motivated &amp;lbrack;
            %a{:href => "quantum+logic#Pratt92"}> Pratt 1992
            \&amp;rbrack; by
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            of
            %a.existingWikiWord{:href => "/nlab/show/quantum+logic"} quantum logic
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/star-autonomous+categories"} star-autonomous categories
            = succeed "," do
              %a{:href => "Pratt93"} Pratt 1993
            = succeed "." do
              %a{:href => "#Pratt99"} 1999
          %p
            In outline, given a
            %a.existingWikiWord{:href => "/nlab/show/closed+symmetric+monoidal+category"} closed symmetric monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            with
            %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
            and an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/star-autonomous+category"} star-autonomous category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C, d)
            and a
            %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric monoidal functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %mi C
                  %mo ⟶
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  i
                  \\;\colon\;
                  C
                  \\longrightarrow
                  Chu(C, d)
          %p
            which realizes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            as a
            %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Chu
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Chu(C, d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C, d)
            is self-dual, in that its
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                %annotation{:encoding => "application/x-tex"} C^{op}
            also embeds as a full subcategory of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Chu
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Chu(C, d)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflectively
          %p
            Many
            %a.existingWikiWord{:href => "/nlab/show/concrete+dualities"} concrete dualities
            in mathematics can be seen as embedded in a larger ambient self-duality on a Chu construction. This applies in particular to the category of
            = succeed "," do
              %em Chu spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(Set, 2)
            (see below).
          %p
            Th Chu construction may be
            %a.existingWikiWord{:href => "/nlab/show/categorified"} categorified
            to what might be called a
            = succeed "," do
              %strong 2-Chu construction
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi Cat
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(Cat, Set)
            (see
            = succeed ")." do
              %a{:href => "#Shulman17"} Shulman17
            %a.existingWikiWord{:href => "/nlab/show/double+Chu+construction"} double Chu construction
            and to operations on
            %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/polycategories"} polycategories
          %h2#definition Definition
          %h3#as_a_category_with_selfduality As a category with self-duality
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            %a.existingWikiWord{:href => "/nlab/show/closed+symmetric+monoidal+category"} closed symmetric monoidal category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} d\in C
            an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/object"} object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C, d)
            are
            %a.existingWikiWord{:href => "/nlab/show/triples"} triples
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ;
                  %mi r
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi a
                  %mo ⊗
                  %mi b
                  %mo →
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a, b; r \,\colon\, a \otimes b \to d)
            (called
            %em
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              \-valued pairings
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                  %annotation{:encoding => "application/x-tex"} b
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi a
                %annotation{:encoding => "application/x-tex"} a
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                %annotation{:encoding => "application/x-tex"} b
            are objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi I
                    %mo ;
                    %mi ρ
                    %mo :
                    %mi d
                    %mo ⊗
                    %mi I
                    %mo ≅
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d, I; \rho: d \otimes I \cong d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ρ
                %annotation{:encoding => "application/x-tex"} \rho
            is an instance of the canonical isomorphism (the right
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/unitor"} unitor
            %a.existingWikiWord{:href => "/nlab/show/monoidal+unit"} monoidal unit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
            %a.existingWikiWord{:href => "/nlab/show/dualizing+object"} dualizing object
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Chu
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Chu(C, d)
          %p
            The morphisms of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Chu
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Chu(C, d)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ;
                  %mi r
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi a
                  %mo ⊗
                  %mi b
                  %mo →
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ;
                  %mi s
                  %mo :
                  %mi x
                  %mo ⊗
                  %mi y
                  %mo →
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  (a, b; r \,\colon\, a \otimes b \to d)
                  \\longrightarrow
                  (x, y; s: x \otimes y \to d)
                  \\,,
          %p
            are pairs of morphisms
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi a
                    %mo →
                    %mi x
                  %annotation{:encoding => "application/x-tex"} f \colon a \to x
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo{:lspace => "verythinmathspace"} :
                  %mi y
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} g \colon y \to b
            which are adjoints with respect to the pairings, that is, making the following
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commute
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                          %mi a
                          %mo ⊗
                          %mi y
                        %mtd
                          %mover
                            %mo ⟶
                            %mrow
                              %msub
                                %mn 1
                                %mi a
                              %mo ⊗
                              %mi g
                        %mtd
                          %mi a
                          %mo ⊗
                          %mi b
                      %mtr
                        %mtd
                        %mtd
                          %mrow
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi f
                                  %mo ⊗
                                  %msub
                                    %mn 1
                                    %mi y
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mrow
                                %mi r
                      %mtr
                        %mtd
                        %mtd
                          %mi x
                          %mo ⊗
                          %mi y
                        %mtd
                          %munder
                            %mo ⟶
                            %mrow
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                              %mi s
                              %mspace{:width => "thickmathspace"}
                              %mspace{:width => "thickmathspace"}
                        %mtd
                          %mi d
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp; a \otimes y &amp;
                  \\overset{1_a \otimes g}{\longrightarrow}
                  \&amp; a \otimes b
                  \\\
                  \&amp;
                  {{}^{\mathllap{f \otimes 1_y}}}
                  \\Big\downarrow
                  \&amp; &amp;
                  \\Big\downarrow{\mathrlap{{}^r}}
                  \\\
                  \&amp;
                  x \otimes y &amp; \underset{\;\; s \;\;}{\longrightarrow}
                  \&amp;
                  d
                  \\mathrlap{\,,}
                  }
          %p
            There is an evident self-duality
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C, d)^{op} \to Chu(C, d)
          %p
            which takes an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ;
                  %mi r
                  %mspace{:width => "thinmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thinmathspace"}
                  %mi a
                  %mo ⊗
                  %mi b
                  %mo ⟶
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a, b; r \,\colon\, a \otimes b \longrightarrow d)
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi b
                  %mo ,
                  %mi a
                  %mo ;
                  %msup
                    %mi r
                    %mo †
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mi b
                  %mo ⊗
                  %mi a
                  %mover
                    %mo ≅
                    %mi σ
                  %mi a
                  %mo ⊗
                  %mi b
                  %mover
                    %mo →
                    %mi r
                  %mi d
                  %mo{:stretchy => "false"} ]
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\big(
                  b, a; r^\dagger = [b \otimes a \overset{\sigma}{\cong} a \otimes b \overset{r}{\to} d]
                  \\big)
                  \\,,
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi σ
                %annotation{:encoding => "application/x-tex"} \sigma
            is an instance of the symmetry isomorphism, so that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi r
                    %mo †
                %annotation{:encoding => "application/x-tex"} r^\dagger
            is the evident transpose. On morphisms, it takes a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (f, g)
            to
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (g, f)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Chu
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Chu(C, d)
          %h3#as_a_autonomous_category
            As a
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
          %p
            Armed with just this much knowledge, and knowledge of how star-autonomous categories behave (as categorified versions of
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/linear+logic"} linear logic
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C, d)
            can pretty much be deduced (or strongly guessed) by the diligent reader, and this is actually a very good exercise. One could sketch this as follows:
          %ul
            %li
              %p
                The monoidal unit of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Chu(C, d)
                should be the dual of the dualizer, and so is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ,
                      %mi d
                      %mo ;
                      %mi λ
                      %mo :
                      %mi I
                      %mo ⊗
                      %mi d
                      %mo ≅
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (I, d; \lambda: I \otimes d \cong d)
                where
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi λ
                      %annotation{:encoding => "application/x-tex"} \lambda
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                      %annotation{:encoding => "application/x-tex"} \rho
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi I
                      %annotation{:encoding => "application/x-tex"} I
            %li
              %p
                The internal hom
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊸
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A \multimap X
                in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Chu(C, d)
                should internalize the external hom, i.e., the set of maps from the monoidal unit to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊸
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A \multimap X
                should be in natural bijection with the set of maps
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A \to X
                in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Chu
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Chu(C, d)
          %p
            This suggests the first component
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊸
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                %annotation{:encoding => "application/x-tex"} (A \multimap X)_0
            of the triple
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo ⊸
                  %mi X
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊸
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                  %mo ,
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊸
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 1
                  %mo ;
                  %mi pairing
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A \multimap X = ((A \multimap X)_0, (A \multimap X)_1; pairing)
          %p should be the object of adjoint pairs of maps: given
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ;
                  %mi r
                  %mo :
                  %mi a
                  %mo ⊗
                  %mi b
                  %mo →
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mspace{:width => "2em"}
                  %mi X
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ;
                  %mi s
                  %mo :
                  %mi x
                  %mo ⊗
                  %mi y
                  %mo →
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} A = (a, b; r: a \otimes b \to d), \qquad X = (x, y; s: x \otimes y \to d)
          %p
            define the first component as
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi A
                          %mo ⊸
                          %mi X
                          %msub
                            %mo{:stretchy => "false"} )
                            %mn 0
                        %mtd
                          %mo ⟶
                        %mtd
                          %msup
                            %mi x
                            %mi a
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mrow
                                %mover
                                  %mi s
                                  %mo{:stretchy => "false"} ˜
                      %mtr
                        %mtd
                          %msup
                            %mi b
                            %mi y
                        %mtd
                          %munder
                            %mo ⟶
                            %mover
                              %mi r
                              %mo{:stretchy => "false"} ˜
                        %mtd
                          %msup
                            %mi d
                            %mrow
                              %mi a
                              %mo ⊗
                              %mi y
                          %mpadded{:width => "0"}
                            %mrow
                              %mspace{:width => "thinmathspace"}
                              %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (A \multimap X)_0
                  \&amp; \longrightarrow &amp;
                  x^a
                  \\\
                  \\Big\downarrow
                  \&amp; &amp;
                  \\Big\downarrow\mathrlap{{}^{\tilde{s}}}
                  \\\
                  b^y
                  \&amp; \underset{\tilde{r}}{\longrightarrow} &amp;
                  d^{a \otimes y}
                  \\mathrlap{\,,}
                  }
          %p
            where exponentials are used to denote internal homs in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi r
                    %mo{:stretchy => "false"} ˜
                %annotation{:encoding => "application/x-tex"} \tilde{r}
            is the result of
            %a.existingWikiWord{:href => "/nlab/show/currying"} currying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi b
                  %mo →
                  %msup
                    %mi d
                    %mi a
                %annotation{:encoding => "application/x-tex"} b \to d^a
            and exponentiating, and similarly for
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi s
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde{s}
          %p
            The pullback is paired with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊗
                    %mi y
                  %annotation{:encoding => "application/x-tex"} a \otimes y
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊸
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi d
                %annotation{:encoding => "application/x-tex"} (A \multimap X)_0 \otimes (a \otimes y) \to d
          %p
            obtained by decurrying either leg of the pullback, so one defines (with fingers crossed)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊸
                  %mi X
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 1
                %annotation{:encoding => "application/x-tex"} (A \multimap X)_1
            to be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ⊗
                    %mi y
                  %annotation{:encoding => "application/x-tex"} a \otimes y
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
          %ul
            %li
              To form the tensor product
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊗
                      %mi X
                    %annotation{:encoding => "application/x-tex"} A \otimes X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ⊗
                    %mi X
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ⊸
                    %msup
                      %mi X
                      %mo *
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} A \otimes X \cong (A \multimap X^*)^*
              which holds true in any star-autonomous category (as a categorified analogue of the Boolean algebra equation
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∧
                      %mi x
                      %mo =
                      %mo ¬
                      %mo{:stretchy => "false"} (
                      %mi a
                      %mo ⇒
                      %mo ¬
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a \wedge x = \neg (a \Rightarrow \neg x)
          %p With notation as above, this works out to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mi x
                  %mo ,
                  %msup
                    %mi y
                    %mi a
                  %msub
                    %mo ×
                    %mrow
                      %msup
                        %mi d
                        %mrow
                          %mi a
                          %mo ⊗
                          %mi x
                  %msup
                    %mi b
                    %mi x
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a \otimes x, y^a \times_{d^{a \otimes x}} b^x)
          %p where the second component is a pullback, and the pairing omitted but obvious. The main thing to check is the presence of a canonical isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ⊗
                  %mi X
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi A
                  %mo ⊸
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C, d)(A \otimes X, Y) \cong Chu(C, d)(X, A \multimap Y)
          %p but this is left as an exercise.
          %p
            Also one should check that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            is the dualizing object, that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi A
                      %mo *
                    %mo ≅
                    %mi A
                    %mo ⊸
                    %mi D
                  %annotation{:encoding => "application/x-tex"} A^* \cong A \multimap D
          %ul
            %li
              %p There is a strong symmetric monoidal functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi C
                      %mo →
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} i: C \to Chu(C, d)
              %p
                taking
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                to
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %msup
                          %mi d
                          %mi c
                        %mo ;
                        %mi eval
                        %mo :
                        %mi c
                        %mo ⊗
                        %msup
                          %mi d
                          %mi c
                        %mo →
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (c, d^c; eval: c \otimes d^c \to d)
                %strong not
                take
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                to the dualizing object in
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Chu
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Chu(C, d)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo →
                      %msup
                        %mi d
                        %mi d
                    %annotation{:encoding => "application/x-tex"} I \to d^d
                is an isomorphism.) This embedding admits a right adjoint
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo ,
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                    %annotation{:encoding => "application/x-tex"} p: Chu(C, d) \to C
              %p
                given by the obvious projection, that is also strong symmetric monoidal. The unit of the adjunction is an isomorphism, hence
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is a coreflective (full) subcategory of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Chu
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Chu(C, d)
            %li
              %p
                If
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                is complete and cocomplete, then so is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Chu
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Chu(C, d)
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi colim
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi a
                        %mi i
                      %mo ,
                      %msub
                        %mi b
                        %mi i
                      %mo ;
                      %msub
                        %mi r
                        %mi i
                      %mo :
                      %msub
                        %mi a
                        %mi i
                      %mo ⊗
                      %msub
                        %mi b
                        %mi i
                      %mo →
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi colim
                        %mi i
                      %msub
                        %mi a
                        %mi i
                      %mo ,
                      %msub
                        %mi lim
                        %mi i
                      %msub
                        %mi b
                        %mi i
                      %mo ;
                      %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} colim_i (a_i, b_i; r_i: a_i \otimes b_i \to d) = (colim_i a_i, lim_i b_i; r)
              %p
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
                is the decurrying of
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi lim
                        %mi i
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi b
                        %mi i
                      %mo →
                      %msup
                        %mi d
                        %mrow
                          %msub
                            %mi a
                            %mi i
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msub
                        %mi lim
                        %mi i
                      %msub
                        %mi b
                        %mi i
                      %mo →
                      %msup
                        %mi d
                        %mrow
                          %msub
                            %mi colim
                            %mi i
                          %msub
                            %mi a
                            %mi i
                    %annotation{:encoding => "application/x-tex"} lim_i (b_i \to d^{a_i}) \cong lim_i b_i \to d^{colim_i a_i}
              %p
                and the formula for limits is obtained by dualizing the formula for colimits in
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Chu
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Chu(C, d)
          %h3#as_a_polycategory As a polycategory
          %p
            We can also deduce the
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C,d)
            by constructing it directly as a
            %a.existingWikiWord{:href => "/nlab/show/star-polycategory"} star-polycategory
            and then observing that it is representable. This has the additional benefit of giving a universal property to the tensor product, as well as applying to more general inputs
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (and giving a result that may not be representable), and giving a convenient way to phrase the universal property of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C,d)
            itself (see below).
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a (symmetric)
            %a.existingWikiWord{:href => "/nlab/show/polycategory"} polycategory
            in which every morphism has codomain arity 0 or 1 (a
            = succeed ")." do
              %em co-subunary polycategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is any
            %a.existingWikiWord{:href => "/nlab/show/symmetric+multicategory"} symmetric multicategory
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %mi C
                %annotation{:encoding => "application/x-tex"} d\in C
