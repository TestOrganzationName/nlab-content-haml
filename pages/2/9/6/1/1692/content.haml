                  %mi a
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi u
                  %mspace{:width => "2em"}
                  %mi g
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi u
                  %mspace{:width => "2em"}
                  %mi h
                  %mo :
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} f : (a,y) \to u \qquad g : (x,b) \to u \qquad h : (y,v) \to b
          %p
            such that three composite morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi y
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,y,v) \to ()
            are equal. With a suitable extension to
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "-polycategory:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a,b,r)
            is
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi b
                    %mo ,
                    %mi a
                    %mo ,
                    %msup
                      %mi r
                      %mo †
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (b,a,r^\dagger)
          %p
            It is then a straightforward exercise to check that if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is closed, representable, has pullbacks, and a “counit” in the sense that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ;
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi Γ
                    %mo ;
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(\Gamma;) \cong C(\Gamma;d)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C)
            is representable on both sides and hence a
            = succeed "-autonomous" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} \ast
          %h3#as_the_graph_of_a_profunctor As the graph of a profunctor
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(C,d)
            can be obtained as the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/graph+of+a+profunctor"} graph of a profunctor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^op
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo ×
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} C^{op} \times C^{op} \to Set
            given by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mo :
                  %mo =
                  %mspace{:width => "1em"}
                  %mi C
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ⊗
                  %mi b
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  H(a, b)
                  \\quad:=\quad
                  C(a \otimes b, d)
          %p
            A Chu space is thus exactly a triple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a, b, r)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ∈
                  %mi H
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} r \in H(a, b)
            and a morphism of Chu spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi a
                  %mo ,
                  %mi b
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi s
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (a, b, r) \to (x, y, s)
            is exactly a pair of morphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi a
                  %mo →
                  %mi x
                %annotation{:encoding => "application/x-tex"} f : a \to x
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi y
                  %mo →
                  %mi b
                %annotation{:encoding => "application/x-tex"} g : y \to b
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %msub
                      %mn 1
                      %mi y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi H
                    %mo{:stretchy => "false"} (
                    %msub
                      %mn 1
                      %mi a
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H(f, 1_y)(s) = H(1_a, g)(r)
          %h2#chu_spaces_general_case Chu spaces (General case)
          %p
            While the Chu construction is worthy of exploration for many types of symmetric monoidal categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(Set, 2)
            (or
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Chu
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo ,
                    %mi TV
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Chu(Set,TV)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi TV
                %annotation{:encoding => "application/x-tex"} TV
            is the set of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/truth+value"} truth value
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive
            = succeed "," do
              %strong Chu spaces
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ,
                  %mi Ω
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Chu(E, \Omega)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a
            %a.existingWikiWord{:href => "/nlab/show/topos"} topos
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                %annotation{:encoding => "application/x-tex"} \Omega
            its
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/subobject+classifier"} subobject classifier
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi TV
                %annotation{:encoding => "application/x-tex"} TV
            carries a panoply of
            %a.existingWikiWord{:href => "/nlab/show/ambimorphic+object"} ambimorphic
            (formerly, schizophrenic) object structures which induce concrete dualities between these categories, and all of these dualities are embedded in (i.e., are restrictions of) the one overarching duality that obtains on Chu spaces.
          %p
            The way this works is invariably the same: if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi C
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} U: C \to Set
            is a
            %a.existingWikiWord{:href => "/nlab/show/concrete+category"} concrete category
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbf{2}
            is an object of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            over the 2-element set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi TV
                  %annotation{:encoding => "application/x-tex"} TV
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi C
                  %mo →
                  %mi Chu
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi c
                  %mo ↦
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mi c
                  %mo ,
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ;
                  %mi U
                  %mi c
                  %mo ×
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi U
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo =
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i: C \to Chu(Set, 2): c \mapsto (U c, hom(c, \mathbf{2}); U c \times hom(c, \mathbf{2}) \to U\mathbf{2} = 2)
          %p which is faithful by the notion of concrete category.
          %p
            What is striking is that this functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is also
            %em full
            in many cases of interest. This is because the adjointness condition for a pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo ,
                  %mi g
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi i
                  %mi c
                  %mo →
                  %mi i
                  %mi d
                %annotation{:encoding => "application/x-tex"} (f, g): i c \to i d
            to be a Chu space morphism, together with faithfulness of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mo :
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mi monic
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mi d
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msup
                        %mi f
                        %mo *
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mi c
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} g: hom(d, \mathbf{2}) \overset{monic}{\to} hom(U d, 2) \overset{f^*}{\to} hom(U c, 2)
          %p
            to be a restriction of the
            %a.existingWikiWord{:href => "/nlab/show/preimage"} preimage
            function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                %annotation{:encoding => "application/x-tex"} f^*
            – and then the mere additional fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi f
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi ϕ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ϕ
                  %mo ∘
                  %mi f
                  %mo ∈
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} f^*(\phi) = \phi \circ f \in hom(c, \mathbf{2})
            whenever
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo ∈
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \phi \in hom(d, \mathbf{2})
            is often enough to force
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            to be (the underlying function of) a morphism of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mn 2
                %annotation{:encoding => "application/x-tex"} d \to \mathbf{2}
            to detect
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
          %ul
            %li
              %p
                As explained above,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
                fully embeds in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Chu
                      %mo{:stretchy => "false"} (
                      %mi Set
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Chu(Set, 2)
                by
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ↦
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo ,
                        %msup
                          %mn 2
                          %mi X
                        %mo ;
                        %mi eval
                        %mo :
                        %mi X
                        %mo ×
                        %msup
                          %mn 2
                          %mi X
                        %mo →
                        %mn 2
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} X \mapsto (X, 2^X; eval: X \times 2^X \to 2)
            %li
              %p
                For
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo =
                        %mi Top
                      %annotation{:encoding => "application/x-tex"} C = Top
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbf{2}
                to be
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Sierpinski+space"} Sierpinski space
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                    %annotation{:encoding => "application/x-tex"} c
                an identification
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Open
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi hom
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mstyle{:mathvariant => "bold"}
                          %mn 2
