                %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                  %use{:x => "326.504", "xlink:href" => "#eWAoo0Elg37WfXqRODUkgawG2oM=-glyph-3-1", :y => "50.024"}
                %path{:d => "M -78.383344 -34.649281 L 69.714313 -34.649281 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "butt", "stroke-linejoin" => "miter", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 169.106, 47.589)"}
                %path{:d => "M -2.484911 2.869563 C -2.031786 1.146906 -1.020067 0.334406 -0.00053625 -0.00153125 C -1.020067 -0.333562 -2.031786 -1.146062 -2.484911 -2.868719 ", :fill => "none", :stroke => "rgb(0%, 0%, 0%)", "stroke-linecap" => "round", "stroke-linejoin" => "round", "stroke-miterlimit" => "10", "stroke-opacity" => "1", "stroke-width" => "0.47818", :transform => "matrix(1, 0, 0, -1, 239.05913, 82.23675)"}
                %g{:fill => "rgb(0%, 0%, 0%)", "fill-opacity" => "1"}
                  %use{:x => "162.364", "xlink:href" => "#eWAoo0Elg37WfXqRODUkgawG2oM=-glyph-2-2", :y => "78.72"}
            %ul
              %li
                (4) For any Weil algebra
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊕
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U \oplus (-)
                preserves products and the above pullback.
          %p
            We finally restrict our attention to the category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Weil
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathsf{Weil}_1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                %annotation{:encoding => "application/x-tex"} W
            denote the
            = succeed "-Weil" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mi X
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} /
                    %msup
                      %mi X
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} R[X]/X^2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %msup
                    %mi W
                    %mi n
                  %mo{:stretchy => "false"} |
                  %mi n
                  %mo ∈
                  %mi ℕ
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \{ W^n | n \in \mathbb{N}\}
            under coproduct.
          %h4#abstract_weil_prolongation Abstract Weil Prolongation
          %p
            Consider the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Weil
                    %mn 1
                %annotation{:encoding => "application/x-tex"} \mathsf{Weil}_1
            over the the integers as a symmetric monoidal category with
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Weil
                      %mn 1
                    %mo ,
                    %mo ⊕
                    %mo ,
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathsf{Weil}_1,\oplus, R)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕏
                %annotation{:encoding => "application/x-tex"} \mathbb{X}
            has a tangent structure, then it has an
            %a.existingWikiWord{:href => "/nlab/show/actegory"} actegory
            structure
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∝
                  %mo :
                  %mi 𝕏
                  %mo ×
                  %msub
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi Weil
                    %mn 1
                  %mo →
                  %mi 𝕏
                %annotation{:encoding => "application/x-tex"}
                  \\propto: \mathbb{X} \times \mathsf{Weil}_1 \to \mathbb{X}
          %p
            so that for any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕏
                  %annotation{:encoding => "application/x-tex"} \mathbb{X}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∝
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \propto(M,-)
            preserves connected limits of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi Weil
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathsf{Weil}_1
          %ol
            %li
              The tangent bundle functor is the action by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} R[X]/X^2
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi X
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi Y
                        %mn 2
                      %mo =
                      %mi M
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mn 2
                      %mo ,
                      %msup
                        %mi Y
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      ( M \propto R[X]/X^2) \propto R[Y]/Y^2 = M \propto R[X,Y]/(X^2,Y^2)
            %li
              The addition map is given by:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ∝
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ↦
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi M
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi X
                        %mn 2
                      %mo ,
                      %msup
                        %mi Y
                        %mn 2
                      %mo ,
                      %mi XY
                      %mo →
                      %mi M
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      M \propto (X,Y \mapsto X): M \propto R[X,Y]/X^2,Y^2,XY \to M \propto R[X]/X^2
              %p
                similarly
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
                is given by:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ∝
                      %mn 0
                      %mo :
                      %mi M
                      %mo ∝
                      %mi R
                      %mo →
                      %mi M
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"}
                      M \propto 0: M \propto R \to M \propto R[X]/X^2
            %li
              The canonical flip is given by:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ∝
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo ↦
                      %mi Y
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi M
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mn 2
                      %mo ,
                      %msup
                        %mi Y
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi M
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mn 2
                      %mo ,
                      %msup
                        %mi Y
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      M \propto (X,Y \mapsto Y,X): M\propto R[X,Y](X^2,Y^2) \to M\propto R[X,Y](X^2,Y^2)
            %li
              The vertical lift is given by:
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ∝
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ↦
                      %mi XY
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi M
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} /
                      %msup
                        %mi X
                        %mn 2
                      %mo →
                      %mi M
                      %mo ∝
                      %mi R
                      %mo{:stretchy => "false"} [
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} ]
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi X
                        %mn 2
                      %mo ,
                      %msup
                        %mi Y
                        %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      M \propto (X \mapsto XY): M \propto R[X]/X^2 \to M\propto R[X,Y](X^2,Y^2)
          %h2#references References
          %p The definition is due to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jiri+Rosicky"}> Jiri Rosicky
              ,
              = succeed "," do
                %em Abstract tangent functors
              = succeed "." do
                %a{:href => "https://www.numdam.org/item/DIA_1984__12__A3_0/"} Numdam
          %p For developments of his ideas, see
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robin+Cockett"}> Robin Cockett
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Geoff+Cruttwell"} Geoff Cruttwell
                = succeed "," do
                  %em Differential structure, tangent structure, and SDG
                = succeed "," do
                  %a{:href => "https://doi.org/10.1007/s10485-013-9312-0"} doi
                = succeed "." do
                  %a{:href => "https://www.reluctantm.com/gcruttw/publications/sman3.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robin+Cockett"}> Robin Cockett
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Geoff+Cruttwell"} Geoff Cruttwell
                = succeed "," do
                  %em Differential bundles and fibrations for tangent categories
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1606.08379"} arXiv:1606.08379
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robin+Cockett"}> Robin Cockett
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Geoff+Cruttwell"} Geoff Cruttwell
                = succeed "," do
                  %em Connections in tangent categories
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1610.08774"} arXiv:1610.08774
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Geoff+Cruttwell"}> Geoff Cruttwell
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rory+Lucyshyn-Wright"} Rory Lucyshyn-Wright
                = succeed "," do
                  %em A simplicial foundation for differential and sector forms in tangent categories
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1606.09080"} arXiv:1606.09080
            %li
              %p
                Poon Leung,
                = succeed "," do
                  %em Classifying tangent structures using Weil algebras
                = succeed ")" do
                  %a{:href => "http://www.tac.mta.ca/tac/volumes/32/9/32-09abs.html"} tac
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Geoff+Cruttwell"}> Geoff Cruttwell
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Jean-Simon+Lemay"} Jean-Simon Lemay
                = succeed "," do
                  %em Tangent categories as a bridge between differential geometry and algebraic geometry
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/2301.05542"} arXiv:2301.05542
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Ching"}> Michael Ching
                ,
                %em A characterization of differential bundles in tangent categories
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2407.06515"}> arXiv:2407.06515
                \&amp;rbrack;
          %p Representation of this tangent structure as exponentiation by a tangent vector is given in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Richard+Garner"}> Richard Garner
              ,
              = succeed "," do
                %em An embedding theorem for tangent categories
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1704.08386"} arXiv:1704.08386
          %p The enriching category from the above paper was discussed earlier in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Eduardo+Dubuc"}> Eduardo Dubuc
                ,
                %em Sur les modeles de la géométrie différentielle synthétique
                Cahiers de topologie et géométrie différentielle catégoriques 20, no. 3 (1979): 231-279. (
                %a{:href => "https://www.numdam.org/item/CTGDC_1979__20_3_231_0/"}> Numdam
                )
            %li
              %p
                Wolfgang Bertram,
                = succeed "," do
                  %em Weil spaces and Weil-Lie groups
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1402.2619"} arXiv:1402.2619
          %p Weil Prolongation is discussed in the following papers:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Anders+Kock"}> Anders Kock
                ,
                = succeed "," do
                  %em Convenient vector spaces embed into the Cahiers topos
                = succeed ")" do
                  %a{:href => "https://www.numdam.org/item/CTGDC_1986__27_1_3_0/"} Numdam
            %li
              %p
                Wolfgang Bertram, Arnaud Souvay,
                = succeed "," do
                  %em A general construction of Weil functors
                = succeed "." do
                  %a{:href => "https://arxiv.org/abs/1111.2463"} arXiv:1111.2463
          %p
            On an abstract approach to tangent bundle categories in the style of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/formal+category+theory"} formal category theory
          %ul
            %li
              %p
                Marcello Lanfranchi,
                = succeed "," do
                  %em The Grothendieck construction in the context of tangent categories
                = succeed "&rbrack;" do
                  %a{:href => "https://arxiv.org/abs/2311.14643"} arXiv:2311.14643
            %li
              %p
                Marcello Lanfranchi,
                %em The formal theory of tangentads I
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/2503.18354"}> arXiv:2503.18354
                \&amp;rbrack;
          %p
            On
            %a.existingWikiWord{:href => "/nlab/show/connections"} connections
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
          %ul
            %li
              G. S. H. Cruttwell, Jean-Simon Pacaud Lemay, Elias Vandenberg,
              %em A Tangent Category Perspective on Connections in Algebraic Geometry
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2406.15137"}> arXiv:2406.15137
              \&amp;rbrack;
          %p
            An extension of the concept of a tangent bundle category to
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty, 1)
          %ul
            %li#BauerBurkeChing21
              %a.existingWikiWord{:href => "/nlab/show/Kristine+Bauer"}> Kristine Bauer
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Burke"} Matthew Burke
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Ching"} Michael Ching
              = succeed "," do
                %em
                  Tangent
                  = succeed "-categories" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
              = succeed ")." do
                %a{:href => "https://arxiv.org/abs/2101.07819"} arXiv:2101.07819
          %p
            Two further examples of tangent structures on an
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Topos"} (∞,1)-Topos
            and its
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/opposite+%28infinity%2C1%29-category"} opposite
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Michael+Ching"}> Michael Ching
              ,
              = succeed "," do
                %em Dual tangent structures for infinity-toposes
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/2101.08805"} arXiv:2101.08805
