          %p
            (The ‘’unit ideal of
            = succeed "\u2019\u2018" do
              %math#mathml_627003cea389e0c4b676ceb1edfe99a3e9e4f2b4_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
