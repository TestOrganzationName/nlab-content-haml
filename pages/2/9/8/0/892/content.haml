                    %li
                      %a.existingWikiWord{:href => "/nlab/show/class-set+theory"} class-set theory
                      %ul
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/class"}> class
                          ,
                          %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
                        %li
                          %a.existingWikiWord{:href => "/nlab/show/universal+class"}> universal class
                          ,
