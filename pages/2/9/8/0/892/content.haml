          %h2#definition Definition
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/set"} set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %strong power set
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is the set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mi S
                %annotation{:encoding => "application/x-tex"} \mathcal{P}S
            of all
            %a.existingWikiWord{:href => "/nlab/show/subsets"} subsets
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %ul
            %li
              %p
                the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} TV
                        %mi S
                    %annotation{:encoding => "application/x-tex"} \TV^S
                of all
                %a.existingWikiWord{:href => "/nlab/show/functions"} functions
                from
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                to the set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} TV
                    %annotation{:encoding => "application/x-tex"} \TV
                of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/truth+values"} truth values
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mn 2
                          %mi S
                      %annotation{:encoding => "application/x-tex"} 2^S
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 2
                truth values;
            %li
              %p
                the collection of
                %a.existingWikiWord{:href => "/nlab/show/subobjects"} subobjects
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                in the
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/slice+category"} slice category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Inj
                        %mo{:stretchy => "false"} /
                        %mi S
                      %annotation{:encoding => "application/x-tex"} Inj/S
                %a.existingWikiWord{:href => "/nlab/show/Inj"} Inj
                is the
                %a.existingWikiWord{:href => "/nlab/show/wide+subcategory"} wide subcategory
                of
                %a.existingWikiWord{:href => "/nlab/show/Set"} Set
                with morphisms restricted to
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/injection"} injections
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Inj
                      %mo{:stretchy => "false"} /
                      %mi S
                    %annotation{:encoding => "application/x-tex"} Inj/S
                has objects that are injections to
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                and morphisms that are commuting triangles of injections.
          %h2#foundational_status Foundational status
          %h3#in_material_set_theory In material set theory
          %p
            One generally needs a specific axiom in the
            %a.existingWikiWord{:href => "/nlab/show/foundations+of+mathematics"} foundations of mathematics
            to ensure the existence of power sets. In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
          %ul
            %li
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a set, then there exists a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{P}
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ⊆
                      %mi S
                    %annotation{:encoding => "application/x-tex"} A \subseteq S
          %p
            One can then use the
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+separation"} axiom of separation
            (
            %a.existingWikiWord{:href => "/nlab/show/bounded+separation"} bounded separation
            is enough) to prove that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            may be chosen so that the subsets of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            are the
            %em only
            members of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}
            %a.existingWikiWord{:href => "/nlab/show/axiom+of+extensionality"} axiom of extensionality
            proves that this
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            is unique.
          %p
            Alternatively, one could include a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/powerset+structure"} powerset structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathcal{P}(S)
            such that for all sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and sets
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo ∈
                  %mi A
                %annotation{:encoding => "application/x-tex"} B \in A
            implies that
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} B \in S
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi 𝒫
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in \mathcal{P}(S)
          %h3#in_structural_set_theory In structural set theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/structural+set+theory"} structural set theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒫
                %annotation{:encoding => "application/x-tex"} \mathcal{P}
            which indexes the subsets of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and prove uniqueness
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/generalised+the"} up to unique isomorphism
          %h3#in_dependent_type_theory In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/Tarski+universe"} Tarski universe
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo ,
                  %mo ∈
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (V, \in)
            of
            %a.existingWikiWord{:href => "/nlab/show/pure+sets"} pure sets
            which behaves as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/material+set+theory"} material set theory
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo :
                    %mi V
                    %mo ⊢
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi y
                        %mo :
                        %mi V
                    %mi y
                    %mo ∈
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x:V \vdash \sum_{y:V} y \in x
            %strong axiom of power sets
            is given by the following
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/inference+rule"} inference rule
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %mi Γ
                      %mspace{:width => "thickmathspace"}
                      %mi{:mathvariant => "normal"} ctx
                    %mrow
                      %mi Γ
                      %mo ⊢
                      %msub
                        %mi{:mathvariant => "normal"} powersets
                        %mi V
                      %mo :
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi S
                          %mo :
                          %mi V
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                        %mrow
                          %mi 𝒫
                          %mo :
                          %mi V
                      %munder
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                        %mrow
                          %mi A
                          %mo :
                          %mi V
                      %mrow
                        %mo (
                        %munder
                          %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                          %mrow
                            %mi x
                            %mo :
                            %mi V
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ∈
                        %mi A
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo ∈
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo )
                      %mo →
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ∈
                      %mi 𝒫
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \frac{\Gamma \; \mathrm{ctx}}{\Gamma \vdash \mathrm{powersets}_V:\prod_{S:V} \sum_{\mathcal{P}:V} \prod_{A:V} \left(\prod_{x:V} (x \in A) \to (x \in S)\right) \to (A \in \mathcal{P})}
          %h3#status_in_predicative_mathematics Status in predicative mathematics
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/predicative+mathematics"} predicative mathematics
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/proper+class"} proper class
            = succeed "." do
              %strong power class
          %p
            One can use power sets to construct
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/function+sets"} function sets
            %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
            (or anything else that will guarantee the existence of the set of truth values). In particular, power sets exist in any theory containing excluded middle and function sets; thus predicative theories which include function sets must also be
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive
          %h2#relation_to_function_sets_and_the_set_of_truth_values Relation to function sets and the set of truth values
          %p
            The existence of power sets is equivalent to the existence of
            %a.existingWikiWord{:href => "/nlab/show/function+sets"} function sets
            and a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/set+of+truth+values"} set of truth values
          %h3#in_dependent_type_theory_2 In dependent type theory
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/dependent+type+theory"} dependent type theory
            %a.existingWikiWord{:href => "/nlab/show/function+types"} function types
            and a
            %a.existingWikiWord{:href => "/nlab/show/univalent"} univalent
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/type+of+all+propositions"} type of all propositions
            %a.existingWikiWord{:href => "/nlab/show/univalent"} univalent
            %a.existingWikiWord{:href => "/nlab/show/type+of+all+propositions"} type of all propositions
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi{:mathvariant => "normal"} Prop
                    %mo ,
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\mathrm{Prop}, \mathrm{El})
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            is the
            %a.existingWikiWord{:href => "/nlab/show/function+type"} function type
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒫
                    %mi S
                    %mo ≔
                    %mi S
                    %mo →
                    %mi{:mathvariant => "normal"} Prop
                  %annotation{:encoding => "application/x-tex"} \mathcal{P}S \coloneqq S \to \mathrm{Prop}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Prop
                %annotation{:encoding => "application/x-tex"} \mathrm{Prop}
            is always a set by
            = succeed ";" do
              %a.existingWikiWord{:href => "/nlab/show/univalence"} univalence
            %a.existingWikiWord{:href => "/nlab/show/codomain"} codomain
            of a function type is a set, then the function type itself is a set.
          %p
            An element of a power set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo :
                  %mi 𝒫
                  %mi S
                %annotation{:encoding => "application/x-tex"} P:\mathcal{P}S
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/predicate"} predicate
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi x
                      %mo :
                      %mi S
                  %mi{:mathvariant => "normal"} El
                  %mo{:stretchy => "false"} (
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \sum_{x:S} \mathrm{El}(P(x))
          %p
            is the corresponding
            %a.existingWikiWord{:href => "/nlab/show/subtype"} subtype
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
            %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
            given by the first projection function defined in the
            %a.existingWikiWord{:href => "/nlab/show/elimination+rules"} elimination rules
            of the
            %a.existingWikiWord{:href => "/nlab/show/negative+type"} negative
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/dependent+sum+type"} dependent sum type
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mn 1
                  %mo :
                  %mrow
                    %mo (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo :
                        %mi S
                    %mi{:mathvariant => "normal"} El
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo )
                  %mo →
                  %mi S
                %annotation{:encoding => "application/x-tex"} \pi_1:\left(\sum_{x:S} \mathrm{El}(P(x))\right) \to S
          %p
            There is also a local membership relation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ∈
