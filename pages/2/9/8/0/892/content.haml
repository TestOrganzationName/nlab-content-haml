                    %li
                      %a.existingWikiWord{:href => "/nlab/show/algebraic+set+theory"} algebraic set theory
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#foundational_status"} Foundational status
              %ul
                %li
                  %a{:href => "#in_material_set_theory"} In material set theory
                %li
                  %a{:href => "#in_structural_set_theory"} In structural set theory
                %li
                  %a{:href => "#in_dependent_type_theory"} In dependent type theory
                %li
