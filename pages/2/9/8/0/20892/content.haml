          %title Chord diagrams and weight systems in Physics
          %h3#ReferencesWeightSystemsOnChordDiagramsInPhysics Chord diagrams and weight systems in Physics
          %p
            The following is a list of references that involve (
            %a.existingWikiWord{:href => "/nlab/show/weight+systems"} weight systems
            on)
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/chord+diagrams"} chord diagrams
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/physics"} physics
          %ol
            %li
              %p
                %a{:href => "#ReferencesWeightSystemsInChernSimonsTheory"} In Chern-Simons theory
            %li
              %p
                %a{:href => "#ReferencesWeightSystemsInDpDp2BraneIntersections"} In Dp-D(p+2) brane intersections
            %li
              %p
                In
                %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+in+condensed+matter+physics"} quantum many body models
                for
                %a.existingWikiWord{:href => "/nlab/show/AdS-CFT+correspondence"} for holographic
                = succeed "/" do
                  %a.existingWikiWord{:href => "/nlab/show/brane"} brane
                %a.existingWikiWord{:href => "/nlab/show/bulk"} bulk
                correspondence:
              %ol
                %li
                  %p
                    %a{:href => "#ReferencesWeightSystemsInSYKModel"} In AdS2/CFT1, JT-gravity/SYK-model
                %li
                  %p
                    %a{:href => "#ForHolographicEntanglementEntropy"} As dimer/bit thread codes for holographic entanglement entropy
          %p
            For a unifying perspective (via
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Hypothesis+H"} Hypothesis H
          %ul
            %li#SatiSchreiber19c
              %p
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"}> Hisham Sati
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/schreiber/show/Differential+Cohomotopy+implies+intersecting+brane+observables"} Differential Cohomotopy implies intersecting brane observables
                %strong 26
                4 (2022) [
                %a{:href => "https://dx.doi.org/10.4310/ATMP.2022.v26.n4.a4"} doi:10.4310/ATMP.2022.v26.n4.a4
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/1912.10425"} arXiv:1912.10425
            %li#CSS21
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Corfield"}> David Corfield
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/Fundamental+weight+systems+are+quantum+states"} Fundamental weight systems are quantum states
                Lett. Math. Phys.
                %strong 113
                112 (2023) [
                %a{:href => "https://arxiv.org/abs/2105.02871"}> arXiv:2105.02871
                ,
                = succeed "]" do
                  %a{:href => "https://doi.org/10.1007/s11005-023-01725-4"} doi:10.1007/s11005-023-01725-4
            %li#Collari2023
              %p
                %a.existingWikiWord{:href => "/nlab/show/Carlo+Collari"}> Carlo Collari
                ,
                = succeed "," do
                  %em A note on weight systems which are quantum states
                %strong 66
                4 (2023) [
                %a{:href => "https://doi.org/10.4153/S0008439523000206"}> doi:10.4153/S0008439523000206
                ,
                = succeed "]" do
                  %a{:href => "https://arxiv.org/abs/2210.05399"} arXiv:2210.05399
          %p Review:
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Carlo+Collari"}> Carlo Collari
              ,
              = succeed "," do
                %em Weight systems which are quantum states
              = succeed "," do
                %em
                  %a{:href => "https://nyuad.nyu.edu/en/events/2023/march/quantum-field-theories-and-cobordisms.html"} QFT and Cobordism
              %a.existingWikiWord{:href => "/nlab/show/CQTS"} CQTS
              (Mar 2023)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                  %annotation{:encoding => "application/x-tex"} [
              = succeed "," do
                %a{:href => "Center+for+Quantum+and+Topological+Systems#CollariMar2023"} web
              %a.existingWikiWord{:href => "/nlab/files/Collari-WeightSystems.pdf", :title => "pdf"} pdf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} ]
          %h4#ReferencesWeightSystemsInChernSimonsTheory In Chern-Simons theory
          %p
            Since
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weight+systems+are+the+associated+graded+of+Vassiliev+invariants"} weight systems are the associated graded of Vassiliev invariants
            %a.existingWikiWord{:href => "/nlab/show/Vassiliev+invariants"} Vassiliev invariants
            are
            %a.existingWikiWord{:href => "/nlab/show/knot+invariants"} knot invariants
            arising as certain
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/correlators"} correlators
            %a.existingWikiWord{:href => "/nlab/show/Feynman+amplitudes"} Feynman amplitudes
            of
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            in the presence of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Wilson+lines"} Wilson lines
            %a.existingWikiWord{:href => "/nlab/show/weight+systems"} weight systems
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/quantization+of+3d+Chern-Simons+theory"} quantum Chern-Simons theory
          %p
            Historically this is the original application of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/chord+diagrams"} chord diagrams
            %a.existingWikiWord{:href => "/nlab/show/Jacobi+diagrams"} Jacobi diagrams
            and their
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/weight+systems"} weight systems
            %em
              %a.existingWikiWord{:href => "/nlab/show/graph+complex"} graph complex
            and
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Kontsevich+integral"} Kontsevich integral
          .float_right_image{:style => "margin: -40px 0px 20px 14px"}
            %figure{:style => "margin: 0 0 0 0"}
              %img{:src => "/nlab/files/BarNatanChernSimonsChordDiagrams.jpg", :width => "330px"}/
              %figcaption{:style => "text-align: center"}
                from
                %a{:href => "#BarNatan91"} Bar-Natan 1991
          %ul
            %li#BarNatan91
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dror+Bar-Natan"}> Dror Bar-Natan
                ,
                = succeed "," do
                  %em Perturbative aspects of the Chern-Simons topological quantum field theory
                = succeed "," do
                  %a{:href => "http://inspirehep.net/record/323500"} spire:323500
                = succeed "," do
                  %a{:href => "https://search.proquest.com/docview/303979053"} proquest:303979053
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/BarNatanPerturbativeCS91.pdf", :title => ""} BarNatanPerturbativeCS91.pdf
            %li#Kontsevich93
              %p
                %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
                ,
                = succeed "," do
                  %em Vassiliev’s knot invariants
                = succeed ")" do
                  %a{:href => "http://pagesperso.ihes.fr/~maxim/TEXTS/VassilievKnot.pdf"} pdf
            %li
              %p
                Daniel Altschuler, Laurent Freidel,
                = succeed "," do
                  %em Vassiliev knot invariants and Chern-Simons perturbation theory to all orders
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/q-alg/9603010"} arxiv:q-alg/9603010
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                , Paolo Cotta-Ramusino, Riccardo Longoni,
                = succeed "," do
                  %em Configuration spaces and Vassiliev classes in any dimension
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math/9910139"} arXiv:math/9910139
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                , Paolo Cotta-Ramusino, Riccardo Longoni,
                = succeed "," do
                  %em Algebraic structures on graph cohomology
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math/0307218"} arXiv:math/0307218
          %p Reviewed in:
          %ul
            %li#Volic13
              %a.existingWikiWord{:href => "/nlab/show/Ismar+Voli%C4%87"}> Ismar Volić
              , Section 4 of:
              = succeed "," do
                %em Configuration space integrals and the topology of knot and link spaces
              %a{:href => "https://fdocuments.co/amp/document/morfismos-vol-17-no-2-2013.html"} Morfismos, Vol 17, no 2, 2013
              (
              %a{:href => "https://arxiv.org/abs/1310.7224"}> arxiv:1310.7224
              )
          %p
            Applied to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Gopakumar-Vafa+duality"} Gopakumar-Vafa duality
          %ul
            %li
              Dave Auckly, Sergiy Koshkin,
              = succeed "," do
                %em
                  Introduction to the Gopakumar-Vafa Large
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
