          %h2#idea Idea
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/parameterized+homotopy+theory"} parameterized homotopy theory
            %em retractive space
            (older terminology: “ex-space” &amp;lbrack;
            %a{:href => "#James95"}> James (1995)
            \&amp;rbrack;, cf. footnote 1,
            %a{:href => "http://www.math.uchicago.edu/~may/EXTHEORY/MaySig.pdf#page=27"} p. 19
            in
            = succeed ")" do
              %a{:href => "#MaySigurdsson06"} May &amp; Sigurdsson (2006)
            %a.existingWikiWord{:href => "/nlab/show/retraction"} retraction
            in a given
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒮
                %annotation{:encoding => "application/x-tex"} \mathcal{S}
            of
            %a.existingWikiWord{:href => "/nlab/show/model+category"} models
            for
            %a.existingWikiWord{:href => "/nlab/show/homotopy+types"} homotopy types
            (usually in
            %a.existingWikiWord{:href => "/nlab/show/TopologicalSpaces"} TopologicalSpaces
            or
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/SimplicialSets"} SimplicialSets
            %em
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo{:lspace => "verythinmathspace"} :
                    %mi E
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} p \colon E \to B
              of
              %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
            over a
            %em base space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:lspace => "verythinmathspace"} :
                  %mi B
                  %mo →
                  %mi E
                %annotation{:encoding => "application/x-tex"} i \colon B \to E
            exhibits the
