              %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/base+points"} base points
          %p
            Just as plain
            %a.existingWikiWord{:href => "/nlab/show/pointed+topological+spaces"} pointed topological spaces
            serve as the basis on which to construct
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/parameterized+spectra"} parameterized spectra
