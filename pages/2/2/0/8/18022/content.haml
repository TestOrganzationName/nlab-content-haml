                        %mo{:stretchy => "false"} (
                        %mi Sym
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi op
                        %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟵
                      %mrow
                        %mi SeqSpec
                        %mo{:stretchy => "false"} (
                        %msubsup
                          %mi ker
                          %mrow
                            %mi ϵ
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mi op
                        %mo{:stretchy => "false"} )
                  %mi SeqSpec
                  %msub
                    %mrow
                      %mo (
                      %mi 𝔤
                      %mo{:stretchy => "false"} /
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi LieAlg
                        %mi ℚ
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %msup
                            %mi Δ
                            %mi op
