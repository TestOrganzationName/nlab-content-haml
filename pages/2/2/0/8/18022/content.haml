                    %semantics
                      %mrow
                        %mi ℚ
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"} \mathbb{Q}[0]
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/augmented+algebra"} augmented
                  dgc-algebra
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the augmentation map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϵ
                  %annotation{:encoding => "application/x-tex"} \epsilon
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
