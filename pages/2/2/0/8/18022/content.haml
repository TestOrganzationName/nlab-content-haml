                  %msub
                    %mrow
                      %mo (
                      %mi 𝔤
                      %mi Mod
                      %mo )
                    %mi stable
                  %munderover
                    %mrow
                      %msub
                        %mo ≃
                        %mi Qu
                    %munder
                      %mo ⟶
                      %mrow
                        %mi SeqSpec
