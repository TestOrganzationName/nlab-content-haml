          %p
            See also
            %a{:href => "#BousfieldGugenheim76"} Bousfield-Gugenheim 76, 4.11
          %h3#simplicial_lie_algebras Simplicial Lie algebras
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
