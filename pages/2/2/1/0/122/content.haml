                          %mo ,
                          %mi b
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (c_1,a) &amp;\stackrel{(f,Id)}{\to}&amp; (c_2,a)
                  \\\
                  \\downarrow^{\mathrlap{(Id,(a \to b))}}
                  \&amp;&amp;
                  \\downarrow^{\mathrlap{(Id, (a \to b))}}
                  \\\
                  (c_1,b) &amp;\stackrel{(f,Id)}{\to}&amp; (c_2,b)
                  }
          %p
            So a natural transformation between functors
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} C \to D
            is given by the images of such squares in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            for a natural transformation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi F
                  %mo →
                  %mi G
                %annotation{:encoding => "application/x-tex"} \alpha : F \to G
            is the naturality square from above:
