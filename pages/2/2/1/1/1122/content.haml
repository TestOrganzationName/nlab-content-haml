                ,
                = succeed "," do
                  %em The classifying topos of a continuous groupoid. I
            %li
              %p
                O. Abbad,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Enrico+Vitale"} E. M. Vitale
                %em Faithful calculus of fractions
                , Cah. Top. Géom. Diff. Catég.
                %strong 54
                No. 3 (2013) 221-239. (
                %a{:href => "perso.uclouvain.be/enrico.vitale/FrazioniFedeli.pdf"}> preprint
                )
            %li
              %p
                E. Vitale,
                = succeed "," do
                  %em Bipullbacks and categories of fractions
                %a{:href => "https://perso.uclouvain.be/enrico.vitale/BPBc.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dorette+A.+Pronk"}> Dorette A. Pronk
                ,
                = succeed "," do
                  %em Etendues and stacks as bicategories of fractions
                %strong 102
                3 (1996) pp.243-303. (
                %a{:href => "http://www.numdam.org/item/?id=CM_1996__102_3_243_0"}> numdam:CM_1996__102_3_243_0
                )
            %li#Roberts12
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Roberts"}> David Roberts
                ,
                = succeed "," do
                  %em Internal categories, anafunctors and localisations
                %strong 26
                (2012) pp.788-829. (
                %a{:href => "http://www.tac.mta.ca/tac/volumes/26/29/26-29.pdf"}> pdf
                )
            %li
              %p
                M. Tommasini,
                %em A bicategory of reduced orbifolds from the point of view of differential geometry
                , arXiv:1304.6959 (2013). (
                %a{:href => "http://arxiv.org/pdf/1304.6959"}> pdf
                )
            %li
              %p
                M. Tommasini,
                %em Some insights on bicategories of fractions I
                , arXiv:1410.3990 (2014). (
                %a{:href => "http://arxiv.org/pdf/1410.3990"}> pdf
                )
            %li
              %p
                M. Tommasini,
                %em Some insights on bicategories of fractions II
                , arXiv:1410.5075 (2014). (
