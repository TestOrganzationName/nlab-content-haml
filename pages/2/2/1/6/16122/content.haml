          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field"} field
            %em conic section
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is the
            %a.existingWikiWord{:href => "/nlab/show/zero+locus"} zero set
            of a degree 2
            %a.existingWikiWord{:href => "/nlab/show/polynomial"} polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %mi k
                  %mo{:stretchy => "false"} [
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} p(x, y) \in k[x, y]
            in the
            %a.existingWikiWord{:href => "/nlab/show/affine+space"} affine plane
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝔸
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{A}^2(k)
            %a.existingWikiWord{:href => "/nlab/show/homogeneous+polynomial"} homogeneous polynomial
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo ,
                  %mi z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} p(x, y, z)
            of degree 2 in the
            %a.existingWikiWord{:href => "/nlab/show/projective+space"} projective plane
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℙ
                      %mn 2
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathbb{P}^2(k)
          %h2#over_the_real_numbers Over the real numbers
          %p
