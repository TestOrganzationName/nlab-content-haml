                    %mi b
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} w_b^{(n)}
            for
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi w
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi b
                  %annotation{:encoding => "application/x-tex"} [w^{(n)}]_b
          %p
            %img{:alt => "Coh_fig_6", :src => "/nlab/files/Coh_fig_6.gif"}/
          %p commute, which also implies that the outer rectangle commutes, that is:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℐ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mi m
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi ⋯
                  %mo ∘
                  %mi ℐ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi s
                    %mn 1
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi ℐ
                  %mo{:stretchy => "false"} (
                  %mi can
                  %mo{:stretchy => "false"} (
                  %mi w
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ∘
                  %mi ℐ
                  %mo{:stretchy => "false"} (
                  %mi can
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{I}(s_m)\circ \cdots \circ\mathcal{I}(s_1) = \mathcal{I}(can(w))^{-1}\circ \mathcal{I}(can(v)).
          %p
            The right-hand side depends only on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            (and not on the particular choice of the path
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 1
                    %mo ,
                    %mi …
                    %msub
                      %mi s
                      %mi m
                  %annotation{:encoding => "application/x-tex"}
                    s_1,\ldots
                    s_m
          .un_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %msub
                      %mi W
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} v\in W_0
              be a word of length
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi w
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w^{(n)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
              to any two directed paths (paths consisting only of directed arrows) from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi w
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} w^{(n)}
              results in two paths in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              that have the same composition in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          .proof
            %p
              The proof is by induction on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(v)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \rho(v)=0
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %msup
                      %mi w
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v = w^{(n)}
              and the assertion is trivial. Suppose, therefore, that
              = succeed ">" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(v)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              and the assertion is true for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                    %mo ∈
                    %msub
                      %mi W
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} v'\in W_0
              with
              = succeed "<" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(v')
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(v)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi len
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} len(v)
            %p
              Hence, we have to prove that if the assertion holds for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} v'
              of rank smaller than
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} r := \rho(v)
              and for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} v'
              of rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              and length smaller than
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              (for
              = succeed ">" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              – the basis for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n=1
              is trivial as then
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ′
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi w
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v' = (-) = w^{(1)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} v'
              of rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              = succeed "and" do
                %br/
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            %p
              From
              = succeed ">" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(v)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              we know that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ≠
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %annotation{:encoding => "application/x-tex"} v\neq -
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi w
                    %mo ∈
                    %msub
                      %mi W
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} u,w\in W_0
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo =
                      %mi u
                      %mo ⊗
                      %mi w
                    %annotation{:encoding => "application/x-tex"} v = u\otimes w
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi w
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w^{(n)}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \beta\in S
              be the first edge of the first path, and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \gamma\in S
              be the first edge of the second path (so that in particular
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi v
                      %mo =
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} dom(\beta) = v = dom(\gamma)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                    %mo :
                    %mo =
                    %mi cod
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} v':=cod(\beta)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ″
                      %mo :
                      %mo =
                      %mi cod
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} v'':=cod(\gamma)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_n
              we have
            %p
              %img{:alt => "Coh_fig_7", :src => "/nlab/files/Coh_fig_7.gif"}/
            %p
              Since
              = succeed "<" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(v')
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \rho(v)
              and
              = succeed "<" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo ″
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(v'')
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ρ
                      %mo{:stretchy => "false"} (
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \rho(v)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} v'
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi w
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} w^{(n)}
              have the same composition in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ″
                    %annotation{:encoding => "application/x-tex"} v''
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo =
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \beta = \gamma
            %p
              %img{:alt => "Coh_fig_8", :src => "/nlab/files/Coh_fig_8.gif"}/
            %p
              So, we will continue by assuming that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo ≠
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \beta\neq \gamma
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ′
                      %mo ≠
                      %mi v
                      %mo ″
                    %annotation{:encoding => "application/x-tex"} v'\neq v''
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi 𝒢
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ∈
                    %msub
                      %mi W
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} z\in W_0
              of length
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and directed paths (recall that here a directed path is a path consisting only of directed arrows) in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_n
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} v'
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              and from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} v''
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              such that applying
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
              to the following diamond (upper part of the diagram) results in a commutative diamond in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              %img{:alt => "Coh_fig_9", :src => "/nlab/files/Coh_fig_9.gif"}/
            %p
              (the outer paths are our two paths from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              to
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi w
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w^{(n)}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              The existence of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ∈
                    %msub
                      %mi W
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} z\in W_0
              and of directed paths from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} v'
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} v''
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                  %annotation{:encoding => "application/x-tex"} z
              such that the above diamond is commutative in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              will be proved by considering all possible cases for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %mo =
                      %mi β
                      %mo ′
                      %mover
                        %mo ⊗
                        %mo{:stretchy => "false"} ^
                      %mn 1
                      %mover
                        %mi w
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} \beta = \beta'\hat{\otimes} 1\tilde{w}
                for some
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi w
                        %mo{:stretchy => "false"} ˜
                      %mo ∈
                      %msub
                        %mi W
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \tilde{w}\in W_0
                and some directed
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo ′
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \beta'\in S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %mi u
                    %mo ⊗
                    %mi w
                    %mo =
                    %mi dom
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi dom
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"}
                    v = u\otimes w = dom(\beta) = dom(\beta')\otimes \tilde{w}
            %p
              and therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi dom
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi u
                  %annotation{:encoding => "application/x-tex"} dom(\beta') = u
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %mi w
                  %annotation{:encoding => "application/x-tex"} \tilde{w}=w
              (by standard “unique decomposition” of terms in a first-order language). Also,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ′
                      %mo =
                      %mi cod
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi cod
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi w
                    %annotation{:encoding => "application/x-tex"} v' = cod(\beta) = cod(\beta')\otimes w
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo =
                        %mn 1
                        %mover
                          %mi u
                          %mo{:stretchy => "false"} ˜
                        %mover
                          %mo ⊗
                          %mo{:stretchy => "false"} ^
                        %mi β
                        %mo ″
                      %annotation{:encoding => "application/x-tex"} \beta = 1\tilde{u}\hat{\otimes}\beta''
                  for some
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi u
                          %mo{:stretchy => "false"} ˜
                        %mo ∈
                        %msub
                          %mi W
                          %mn 0
                      %annotation{:encoding => "application/x-tex"} \tilde{u}\in W_0
                  and some directed
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi β
                          %mo ″
                          %mo ∈
                          %mi S
                        %annotation{:encoding => "application/x-tex"} \beta''\in S
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi dom
                        %mo{:stretchy => "false"} (
                        %mi β
                        %mo ″
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi w
                      %annotation{:encoding => "application/x-tex"} dom(\beta'') =w
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi u
                            %mo{:stretchy => "false"} ˜
                          %mo =
                          %mi u
                        %annotation{:encoding => "application/x-tex"} \tilde{u} = u
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ′
                          %mo =
                          %mi cod
                          %mo{:stretchy => "false"} (
                          %mi β
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi u
                          %mo ⊗
                          %mi cod
                          %mo{:stretchy => "false"} (
                          %mi β
                          %mo ″
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} v' = cod(\beta) = u\otimes cod(\beta'')
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo =
                        %mi α
                        %mover
                          %mi u
                          %mo{:stretchy => "false"} ˜
                        %mi s
                        %mi t
                      %annotation{:encoding => "application/x-tex"} \beta = \alpha \tilde{u} s t
                  for some
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mover
                            %mi u
                            %mo{:stretchy => "false"} ˜
                          %mo ,
                          %mi s
                          %mo ,
                          %mi t
                          %mo ∈
                          %msub
                            %mi W
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} \tilde{u},s,t\in W_0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %mi u
                    %mo ⊗
                    %mi w
                    %mo =
                    %mi dom
                    %mo{:stretchy => "false"} (
                    %mi β
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ˜
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ⊗
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    v = u\otimes w = dom(\beta) = \tilde{u}\otimes (s\otimes t),
            %p
              so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi u
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %mi u
                  %annotation{:encoding => "application/x-tex"} \tilde{u} = u
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo =
                      %mi s
                      %mo ⊗
                      %mi t
                    %annotation{:encoding => "application/x-tex"} w = s\otimes t
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                      %mo ′
                      %mo =
                      %mi cod
                      %mo{:stretchy => "false"} (
                      %mi β
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo ⊗
                      %mi s
                      %mo{:stretchy => "false"} )
                      %mo ⊗
                      %mi t
                    %annotation{:encoding => "application/x-tex"}
                      v' = cod(\beta) =
                      (u\otimes s)\otimes t
            %p
              In summary, we have the following 3 cases for
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
            %ul
              %li
                %p
                  Case
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mn 1
                            %mi β
                        %annotation{:encoding => "application/x-tex"} 1_{\beta}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo =
                        %mi β
                        %mo ′
                        %mover
                          %mo ⊗
                          %mo{:stretchy => "false"} ^
                        %mn 1
                        %mi w
                      %annotation{:encoding => "application/x-tex"} \beta = \beta'\hat{\otimes} 1w
                  for some directed
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo ′
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \beta'\in S
                  with
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi β
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi u
                        %annotation{:encoding => "application/x-tex"} dom(\beta')=u
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ′
                          %mo =
                          %mi cod
                          %mo{:stretchy => "false"} (
                          %mi β
                          %mo ′
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi w
                        %annotation{:encoding => "application/x-tex"}
                          v' =
                          cod(\beta')\otimes w
              %li
                %p
                  Case
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mn 2
                            %mi β
                        %annotation{:encoding => "application/x-tex"} 2_{\beta}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo =
                        %mn 1
                        %mi u
                        %mover
                          %mo ⊗
                          %mo{:stretchy => "false"} ^
                        %mi β
                        %mo ″
                      %annotation{:encoding => "application/x-tex"} \beta = 1u \hat{\otimes} \beta''
                  for some directed
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo ″
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \beta''\in S
                  with
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi dom
                          %mo{:stretchy => "false"} (
                          %mi β
                          %mo ″
                          %mo{:stretchy => "false"} )
                          %mo =
                          %mi w
                        %annotation{:encoding => "application/x-tex"} dom(\beta'') = w
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ′
                          %mo =
                          %mi u
                          %mo ⊗
                          %mi cod
                          %mo{:stretchy => "false"} (
                          %mi β
                          %mo ″
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          v' =
                          u\otimes cod(\beta'')
              %li
                %p
                  Case
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mn 3
                            %mi β
                        %annotation{:encoding => "application/x-tex"} 3_{\beta}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi β
                        %mo =
                        %mi α
                        %mi u
                        %mi s
                        %mi t
                      %annotation{:encoding => "application/x-tex"} \beta = \alpha u s t
                  for some
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi s
                          %mo ,
                          %mi t
                          %mo ∈
                          %msub
                            %mi W
                            %mn 0
                        %annotation{:encoding => "application/x-tex"} s,t\in W_0
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi w
                        %mo =
                        %mi s
                        %mo ⊗
                        %mi t
                      %annotation{:encoding => "application/x-tex"} w = s\otimes t
                  and
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi v
                          %mo ′
                          %mo =
                          %mo{:stretchy => "false"} (
                          %mi u
                          %mo ⊗
                          %mi s
                          %mo{:stretchy => "false"} )
                          %mo ⊗
                          %mi t
                        %annotation{:encoding => "application/x-tex"} v' = (u\otimes s)\otimes t
            %p
              Similarly, we have Case
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi γ
                    %annotation{:encoding => "application/x-tex"} 1_{\gamma}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 2
                      %mi γ
                  %annotation{:encoding => "application/x-tex"} 2_{\gamma}
              and Case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 3
                      %mi γ
                  %annotation{:encoding => "application/x-tex"} 3_{\gamma}
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi β
                  %annotation{:encoding => "application/x-tex"} \beta
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                    %annotation{:encoding => "application/x-tex"} \gamma
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi β
                  %annotation{:encoding => "application/x-tex"} 1_{\beta}
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi γ
                    %annotation{:encoding => "application/x-tex"} 1_{\gamma}
            %p
              %img{:alt => "Coh_fig_10", :src => "/nlab/files/Coh_fig_10.gif"}/
            %p
              Since
              = succeed "<" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi len
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} len(u)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi len
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} len(v)
              (as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                    %mo ∈
                    %msub
                      %mi W
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} w\in W_0
              cannot be
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi e
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} e_0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi u
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo −
                    %mo{:stretchy => "false"} (
                    %msub
                      %munder
                        %mrow
                          %mi ρ
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo +
                    %msub
                      %munder
                        %mrow
                          %mi len
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo{:stretchy => "false"} )
                          %mo −
                          %mn 1
                        %mo ⏟
                      %mrow
                        %mo ≥
                        %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mi ρ
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\rho(u) = \rho(v) - (\underbrace{\rho(w)}_{\geq 0} +
                    \\underbrace{len(w) - 1}_{\geq 0}) \leq \rho(v),
            %p
              it follows from the induction hypothesis that any two directed paths from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                  %annotation{:encoding => "application/x-tex"} u
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi w
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi len
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} w^{(len(u))}
              have the same composition in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℐ
                  %annotation{:encoding => "application/x-tex"} \mathcal{I}
              to the following diamond in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mrow
                        %mi len
                        %mo{:stretchy => "false"} (
                        %mi u
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_{len(u)}
              results in a commutative diamond in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              %img{:alt => "Coh_fig_11", :src => "/nlab/files/Coh_fig_11.gif"}/
            %p
              Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \otimes_B
              is a bifunctor, it follows that the following diagram is again commutative when interpreted in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
            %p
              %img{:alt => "Coh_fig_12", :src => "/nlab/files/Coh_fig_12.gif"}/
            %p
              (where for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %msub
                      %mi W
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} x\in W_0
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi len
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi len
                      %mo{:stretchy => "false"} (
                      %mi u
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} len(x) = len(u)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi can
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                    %mn 1
                    %mi w
                  %annotation{:encoding => "application/x-tex"} can(x)\hat{\otimes}  1 w
              for the directed path in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_n
              obtained by
              = succeed "-ing" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mo ⊗
                        %mo{:stretchy => "false"} ^
                    %annotation{:encoding => "application/x-tex"} \hat{\otimes}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi can
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} can(x)
              from the right with
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mi w
                    %annotation{:encoding => "application/x-tex"} 1 w
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 2
                      %mi β
                  %annotation{:encoding => "application/x-tex"} 2_{\beta}
              and
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 2
                        %mi γ
                    %annotation{:encoding => "application/x-tex"} 2_{\gamma}
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi β
                  %annotation{:encoding => "application/x-tex"} 1_{\beta}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 2
                      %mi γ
                  %annotation{:encoding => "application/x-tex"} 2_{\gamma}
              (or
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 2
                      %mi β
                  %annotation{:encoding => "application/x-tex"} 2_{\beta}
              and
              = succeed "):" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi γ
                    %annotation{:encoding => "application/x-tex"} 1_{\gamma}
            %p
              %img{:alt => "Coh_fig_13", :src => "/nlab/files/Coh_fig_13.gif"}/
            %p
              which commutes in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ⊗
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \otimes_B
              is a bifunctor.
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 3
                      %mi β
                  %annotation{:encoding => "application/x-tex"} 3_{\beta}
              or
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 3
                        %mi γ
                    %annotation{:encoding => "application/x-tex"} 3_{\gamma}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 3
                        %mi β
                    %annotation{:encoding => "application/x-tex"} 3_{\beta}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 3
                      %mi γ
                  %annotation{:encoding => "application/x-tex"} 3_{\gamma}
              holds, that is, that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo =
                    %mi α
                    %mi u
                    %mi s
                    %mo ′
                    %mi t
                    %mo ′
                  %annotation{:encoding => "application/x-tex"}
                    \\gamma = \alpha u s'
                    t'
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ′
                    %mo ,
                    %mi t
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} s',t'
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo =
                      %mi s
                      %mo ′
                      %mo ⊗
                      %mi t
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} w = s'\otimes t'
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ′
                      %mo ⊗
                      %mi t
                      %mo ′
                      %mo =
                      %mi s
                      %mo ⊗
                      %mi t
                    %annotation{:encoding => "application/x-tex"} s'\otimes t' = s \otimes t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ′
                    %mo =
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s' = s
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo ′
                      %mo =
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t' = t
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo =
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \gamma = \beta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi γ
                  %annotation{:encoding => "application/x-tex"} 1_{\gamma}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 2
                        %mi γ
                    %annotation{:encoding => "application/x-tex"} 2_{\gamma}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mn 1
                        %mi γ
                    %annotation{:encoding => "application/x-tex"} 1_{\gamma}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo =
                    %mi γ
                    %mo ′
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                    %mn 1
                    %msub
                      %munder
                        %mrow
                          %mi s
                          %mo ⊗
                          %mi t
                        %mo ⏟
                      %mi w
                  %annotation{:encoding => "application/x-tex"} \gamma = \gamma'\hat{\otimes} 1 \underbrace{s\otimes t}_{w}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo ′
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi u
                    %annotation{:encoding => "application/x-tex"} dom(\gamma') = u
            %p
              %img{:alt => "Coh_fig_15", :src => "/nlab/files/Coh_fig_14.gif"}/
            %p
              which commutes in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              by the naturality of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi α
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha^{(B)}
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 2
                      %mi γ
                  %annotation{:encoding => "application/x-tex"} 2_{\gamma}
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo =
                    %mn 1
                    %mi u
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                    %mi γ
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} \gamma =1 u\hat{\otimes} \gamma''
              and
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo ″
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi w
                      %mo =
                      %mi s
                      %mo ⊗
                      %mi t
                    %annotation{:encoding => "application/x-tex"} dom(\gamma'') = w = s\otimes t
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo ″
                    %annotation{:encoding => "application/x-tex"} \gamma''
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ″
                    %mo =
                    %mn 1
                    %mover
                      %mi s
                      %mo{:stretchy => "false"} ˜
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \gamma'' = 1\tilde{s}\hat{\otimes} \delta
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi s
                      %mo{:stretchy => "false"} ˜
                    %mo ∈
                    %msub
                      %mi W
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \tilde{s}\in W_0
              and some directed
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi δ
                      %mo ∈
                      %mi S
                    %annotation{:encoding => "application/x-tex"} \delta\in S
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ⊗
                      %mi t
                      %mo =
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo ″
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mover
                        %mi s
                        %mo{:stretchy => "false"} ˜
                      %mo ⊗
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %mi δ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      s\otimes t = dom(\gamma'') = \tilde{s}\otimes
                      dom(\delta)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi s
                      %mo{:stretchy => "false"} ˜
                    %mo =
                    %mi s
                  %annotation{:encoding => "application/x-tex"} \tilde{s} =s
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %mi δ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                    %annotation{:encoding => "application/x-tex"} dom(\delta) = t
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ″
                    %mo =
                    %mn 1
                    %mi s
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \gamma'' = 1 s \hat{\otimes} \delta
              with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %mi δ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi t
                    %annotation{:encoding => "application/x-tex"}
                      dom(\delta) =
                      t
            %p
              %img{:alt => "Coh_fig_15", :src => "/nlab/files/Coh_fig_15.gif"}/
            %p
              which commutes in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi α
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha^{(B)}
              is natural.
            %p
              The case where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ″
                    %mo =
                    %mi δ
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                    %mn 1
                    %mover
                      %mi t
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \gamma'' = \delta\hat{\otimes} 1\tilde{t}
              for some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi t
                      %mo{:stretchy => "false"} ˜
                    %mo ∈
                    %msub
                      %mi W
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \tilde{t}\in W_0
              and some directed
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} \delta\in S
              can be treated similarly.
            %p
              Finally, if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi γ
                      %mo ″
                      %mo =
                      %mi α
                      %mi r
                      %mi p
                      %mi q
                    %annotation{:encoding => "application/x-tex"} \gamma'' = \alpha r p q
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ⊗
                      %mi t
                      %mo =
                      %mi dom
                      %mo{:stretchy => "false"} (
                      %mi γ
                      %mo ″
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi r
                      %mo ⊗
                      %mo{:stretchy => "false"} (
                      %mi p
                      %mo ⊗
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      s\otimes t = dom(\gamma'') =
                      r\otimes(p\otimes q)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mi s
                  %annotation{:encoding => "application/x-tex"} r = s
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo =
                      %mi p
                      %mo ⊗
                      %mi q
                    %annotation{:encoding => "application/x-tex"}
                      t = p\otimes
                      q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ″
                    %mo =
                    %mi α
                    %mi s
                    %mi p
                    %mi q
                  %annotation{:encoding => "application/x-tex"} \gamma'' = \alpha s p q
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo =
                      %mi p
                      %mo ⊗
                      %mi q
                    %annotation{:encoding => "application/x-tex"} t = p\otimes q
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                  %annotation{:encoding => "application/x-tex"} \gamma
              in our two paths from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi w
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} w^{(n)}
              look like part of the coherent pentagon (Eq. (5) on p. 162 of
              = succeed "):" do
                %a{:href => "#CWM"} CWM
            %p
              %img{:alt => "Coh_fig_16", :src => "/nlab/files/Coh_fig_16.gif"}/
            %p
              All edges in the above pentagon are directed, and the diagram is obviously commutative in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              (as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              is monoidal). This completes the proof of the proposition.
          %h2#including_the_unit_and_the_unitors Including the unit and the unitors
          %p
            Note: By Kelly’s 1964 paper, we know that the pentagon identity and one triangle identity are all that is required (that the two other triangle identities follow from the above is shown both in
            %a{:href => "#CWM"} CWM
            an in Kelly, while the fact that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msubsup
                    %mi λ
                    %mrow
                      %msub
                        %mi e
                        %mi B
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mi ϱ
                    %mrow
                      %msub
                        %mi e
                        %mi B
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lambda^{(B)}_{e_B} = \varrho^{(B)}_{e_B}
            follows from the pentagon and the triangle identities is proved in Kelly). From this point on, we will be using freely all identities from pp. 162-163 of
            = succeed "." do
              %a{:href => "#CWM"} CWM
          .query
            %p Still need to fill this. The following are the highlights.
          %p
            First, show that any directed path in path in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %msub
                    %mo ′
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{G}'_n
            may be replaced by a path with the same starting and ending vertices in which all associators (if any) are at the end, and with the same composition in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            as the original path. The main ingredient in the following proposition:
          .un_prop
            %h6#proposition_3 Proposition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mover
                      %mo →
                      %mrow
                        %mi s
                        %mo ′
                    %mi u
                    %mo ′
                    %mover
                      %mo →
                      %mrow
                        %mi s
                        %mo ″
                    %mi u
                    %mo ″
                  %annotation{:encoding => "application/x-tex"}
                    u \stackrel{s'}{\to} u' \stackrel{s''}{\to} u''
            %p
              be two directed arrows of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %msub
                      %mo ′
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}'_n
              with an associator appearing in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} s'
              and a unitor appearing in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} s''
              (note: the definition of “directed” is extended in an obvious way to include unitors). Then either there exists a directed arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi s
                          %mn 1
                    %mi u
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} u\stackrel{s_1}{\to} u''
              containing a unitor with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℐ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ℐ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ″
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi ℐ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{I}(s_1)=\mathcal{I}(s'')\circ\mathcal{I}(s')
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi s
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} s_1
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} s_2
              as in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi s
                          %mn 1
                    %mo ?
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi s
                          %mn 2
                    %mi u
                    %mo ″
                  %annotation{:encoding => "application/x-tex"}
                    u \stackrel{s_1}{\to} ? \stackrel{s_2}{\to} u''
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} s_1
              containing a unitor,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi s
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} s_2
              containing an associator, and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℐ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi ℐ
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi s
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi ℐ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ″
                      %mo{:stretchy => "false"} )
                      %mo ∘
                      %mi ℐ
                      %mo{:stretchy => "false"} (
                      %mi s
                      %mo ′
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathcal{I}(s_2)\circ\mathcal{I}(s_1) = \mathcal{I}(s'')\circ\mathcal{I}(s')
          %p
            This proposition may be proved by a long and tedious induction on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo ′
                %annotation{:encoding => "application/x-tex"} s'
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo ″
                  %annotation{:encoding => "application/x-tex"} s''
          .query
            %p
              For this I needed the triangle identities and the naturality of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi α
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha^{(B)}
              (as mentioned in
              = succeed ")," do
                %a{:href => "#CWM"} CWM
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϱ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varrho^{(B)}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi λ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda^{(B)}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⊗
                        %mi B
                    %annotation{:encoding => "application/x-tex"} \otimes_B
            %p
              %img{:alt => "Coh_fig_17", :src => "/nlab/files/Coh_fig_17.gif"}/
            %p
              (where some associator appears in
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                    %annotation{:encoding => "application/x-tex"} \beta
          %p
            Recall that our original goal is to show that any two paths in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %msub
                    %mo ′
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{G}'_n
            with the same starting vertex and the same ending vertex have the same composition in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %msub
                    %mo ′
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{G}'_n
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi w
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} w^{(n)}
            (first remove all units, then proceed as in the case of
            = succeed ")," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒢
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \mathcal{G}_n
            %em directed
            paths of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %msub
                    %mo ′
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{G}'_n
            starting at some vertex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            and ending at
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi w
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} w^{(n)}
            have the same composition in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            %img{:alt => "Coh_fig_18", :src => "/nlab/files/Coh_fig_18.gif"}/
          %p
            Here,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi clean
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} clean(v)
            is the word obtained by removing all instances of the unit from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            (this can be defined rigorously by induction), and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            is the total number of units appearing in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            by the “coherence for the associator” that was already proved. Hence, it remains to prove that the left part, where all arrows involve unitors, commutes in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            (“coherence for the unitors”).
          %p
            First one must prove that two parallel directed arrows with unitors in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %msub
                    %mo ′
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{G}'_n
            have the same interpretation in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            \.
            = succeed "Recall" do
              %br/
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒢
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{G}_n
            (no units and no unitors), there are no parallel directed arrows. However, this is not the case in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %msub
                    %mo ′
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{G}'_n
            (for example, consider
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %msub
                      %mi e
                      %mn 0
                    %mo ⊗
                    %msub
                      %mi e
                      %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mi e
                      %mn 0
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                    %mi λ
                    %msub
                      %mi e
                      %mn 0
                    %mo ,
                    %mn 1
                    %msub
                      %mi e
                      %mn 0
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                    %mi ϱ
                    %msub
                      %mi e
                      %mn 0
                    %mo{:lspace => "verythinmathspace"} :
                    %msub
                      %mi e
                      %mn 0
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi e
                      %mn 0
                    %mo ⊗
                    %msub
                      %mi e
                      %mn 0
                    %mo{:stretchy => "false"} )
                    %mo ⇉
                    %msub
                      %mi e
                      %mn 0
                    %mo ⊗
                    %msub
                      %mi e
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\lambda e_0\otimes e_0,1
                    e_0\hat{\otimes} \lambda e_0, 1 e_0\hat{\otimes} \varrho e_0\colon
                    e_0\otimes(e_0\otimes e_0)\rightrightarrows e_0\otimes e_0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          .query
            %p
              For this, I used induction on the total number of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mo ⊗
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{\otimes}
              in both
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} s'
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ϱ
                      %mrow
                        %msub
                          %mi e
                          %mi B
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                    %mo =
                    %msubsup
                      %mi λ
                      %mrow
                        %msub
                          %mi e
                          %mi B
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varrho^{(B)}_{e_B}=\lambda^{(B)}_{e_B}
              and the naturality of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ϱ
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi B
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \varrho^{(B)}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi λ
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi B
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \lambda^{(B)}
          %p
            Now, we can finally prove coherence for the unitors, by induction on the number
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            of units in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mn 1
                    %mo =
                    %mi u
                    %msub
                      %mo ′
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} u_1=u'_1
          %p
            %img{:alt => "Coh_fig_19", :src => "/nlab/files/Coh_fig_19.gif"}/
          %p
            then the parallel arrows are equal in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            by the induction hypothesis.
          %p
            We can therefore assume that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi u
                      %mn 1
                    %mo ≠
                    %mi u
                    %msub
                      %mo ′
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} u_1 \neq u'_1
            = succeed "find" do
              %br/
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi w
                %annotation{:encoding => "application/x-tex"} w
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒢
                  %msub
                    %mo ′
                    %mi n
                %annotation{:encoding => "application/x-tex"} \mathcal{G}'_n
            and directed arrows
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \gamma'
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ′
                %annotation{:encoding => "application/x-tex"} S'
            containing unitors, as in
          %p
            %img{:alt => "Coh_fig_20", :src => "/nlab/files/Coh_fig_20.gif"}/
          %p
            such that the diamond on the left commutes in
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
            = succeed "If" do
              %br/
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi γ
                %annotation{:encoding => "application/x-tex"} \gamma
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi γ
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \gamma'
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
          %p
            Finally, the required commutative diamond may be found by induction on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
          %h2#proof_of_version_2_of_the_coherence_theorem_vii21_of_cwm
            Proof of version 2 of the coherence (Theorem VII.2.1 of
            = succeed ")" do
              %a{:href => "#CWM"} CWM
          .query
            %p I intend to come back and fill this. The most difficult part was already proved above.
          %h2#the_construction_of__and_proof_of_universality
            The construction of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} F[1]
            and proof of universality
          %p
            The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒲
                %annotation{:encoding => "application/x-tex"} \mathcal{W}
            has one-element hom-sets by construction, but it was not at all obvious that it is indeed the free monoidal category on one generator. Alternatively, it is possible to construct a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} F[1]
            that will be almost obviously a free monoidal category on one generator. This would mean that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} F[1]
            is isomorphic to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒲
                  %annotation{:encoding => "application/x-tex"} \mathcal{W}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} F[1]
            is free and has one-element hom-sets may then serve as yet a third version of coherence.
          .query
            %p This should still be filled.
          %h2#moving_from_one_variable_to_any_number_of_variables_the_category_
            Moving from one variable to any number of variables: The category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi It
                  %mo{:stretchy => "false"} (
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} It(B)
          .query
