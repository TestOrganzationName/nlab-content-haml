                %annotation{:encoding => "application/x-tex"} \langle B, \otimes_B, \alpha^{(B)}, e_B, \lambda^{(B)}, \varrho^{(B)}, \rangle
            be some
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %em
              %a.existingWikiWord{:href => "/nlab/show/coherence+theorem+for+monoidal+categories"} coherence theorem for monoidal categories
            to state that
            %em every
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            built up from instances of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi α
