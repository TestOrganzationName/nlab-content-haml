            or even
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi u
                  %mo ⊗
                  %mi v
                %annotation{:encoding => "application/x-tex"} u\otimes v
            for convenience) is also in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
          %p
            Next, we define a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ′
                %annotation{:encoding => "application/x-tex"} S'
            of certain arrow symbols as follows (the reason for the tag in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ′
                %annotation{:encoding => "application/x-tex"} S'
            will be clear later). Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ′
                %annotation{:encoding => "application/x-tex"} S'
            be the smallest set of strings in the alphabet
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mn 1
                  %mo ,
                  %mi α
                  %mo ,
                  %msup
