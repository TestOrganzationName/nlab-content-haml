            for all
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo ,
                    %mi w
                    %mo ∈
                    %mi W
                  %annotation{:encoding => "application/x-tex"} u,v,w\in W
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mi w
                  %mo ,
