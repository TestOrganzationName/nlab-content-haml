          %h2#introduction_and_statement Introduction and statement
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} ⟨
                  %mi B
                  %mo ,
                  %msub
                    %mo ⊗
                    %mi B
                  %mo ,
