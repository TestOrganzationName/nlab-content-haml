                  %mo ,
                  %msup
                    %mi ϱ
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo ,
                  %mstyle{:displaystyle => "true"}
                    %mrow
                      %mover
                        %mo ⊗
                        %mo{:stretchy => "false"} ^
                      %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} W\cup\{1,\alpha,\alpha^{-1},\lambda,\lambda^{-1},\varrho,\varrho^{-1},\displaystyle{\hat{\otimes}\}}
            satisfying
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
