                %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_173.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
