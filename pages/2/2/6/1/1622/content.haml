        #revision
          %p
            Here are notes from
            %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
            for Monday, June 8, from
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Oberwolfach+Workshop%2C+June+2009+--+Strings%2C+Fields%2C+Topology"} Oberwolfach
          %h2#schweigert_cft_and_algebra_in_braided_tensor_categories_i Schweigert: CFT and algebra in braided tensor categories, I
          %h3#1_modular_tensor_categories_and_rational_cft 1. Modular tensor categories and rational CFT
          %h4#11 1.1
          %ul
            %li
              %p
                consider a
                %em rational semisimple conformal vertex algebra
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %li
              %p
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo →
                    %annotation{:encoding => "application/x-tex"} \to
                from this we get a representation category
                = succeed "," do
                  %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
              %ul
                %li
                  that
                  %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  is semisimple and rarional makes
                  %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  in fact a
                  %a.existingWikiWord{:href => "/nlab/show/modular+tensor+category"} modular tensor category
            %li
              %p
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo →
                    %annotation{:encoding => "application/x-tex"} \to
                this gives rise to conformal blocks
          %p
            %strong
              Definition:
              %a.existingWikiWord{:href => "/nlab/show/modular+tensor+category"} modular tensor category
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/abelian+category"}> abelian category
                ,
                = succeed "-linear" do
                  %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Vect
                        %mi ℂ
                    %annotation{:encoding => "application/x-tex"} Vect_{\mathbb{C}}
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
                %a.existingWikiWord{:href => "/nlab/show/semisimple+category"} semisimple category
                %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} tensor category
            %li
              %p
                the tensor unit is a simple object,
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                a finite set of representatives of isomorphism classes of simple objects
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fusion+category"} fusion category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/braided+monoidal+category"} braided monoidal category
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/ribbon+category"}> ribbon category
                , in particular objects have duals
            %li
              %p
                %strong modularity
                a non-degeneracy condition on the braiding given by an isomorphism of algebras
              .maruku-equation
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_10.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo ⊗
                        %mi ℤ
                      %mover
                        %mo →
                        %mo ≃
                      %mi End
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Id
                        %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      K(C) \otimes_{\mathbb{Z}} \stackrel{\simeq}{\to} End(Id_C)
              %p where
              .maruku-equation
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_11.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi U
                      %mo{:stretchy => "false"} ]
                      %mo ↦
                      %msub
                        %mi α
                        %mi U
                    %annotation{:encoding => "application/x-tex"}
                      [U] \mapsto \alpha_U
              %p
                where the transformation
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi U
                    %annotation{:encoding => "application/x-tex"} \alpha_U
                is given on the simple object
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
                by
              .maruku-equation
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_14.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mi U
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi straight
                      %mi V
                      %mo −
                      %mi line
                      %mi encircled
                      %mi by
                      %mi U
                      %mo −
                      %mi loop
                    %annotation{:encoding => "application/x-tex"}
                      \\alpha_U(V) = straight V-line encircled by U-loop
              %p (on the right we use string diagram notation)
          %h4#12 1.2
          %p
            %strong
              Fact (
              %span.newWikiWord>
                Reshitikhin-Turaev model
                %a{:href => "/nlab/new/Reshitikhin-Turaev+model"} ?
              )
            for any
            %a.existingWikiWord{:href => "/nlab/show/modular+tensor+category"} modular tensor category
            %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            there is a
            %a.existingWikiWord{:href => "/nlab/show/monoidal+functor"} monoidal functor
          .maruku-equation
            %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_16.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi tft
                    %mi C
                  %mo :
                  %msubsup
                    %mi cobord
                    %mrow
                      %mn 3
                      %mo ,
                      %mn 2
                    %mi C
                  %mo →
                  %msub
                    %mi vect
                    %mi f
                  %mo{:stretchy => "false"} (
                  %mi 𝒞
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  tft_C : cobord_{3,2}^C \to vect_f(\mathcal{C})
          %ul
            %li
              %p
                1) factorization homomorphism: given a surface
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Σ
                        %mrow
                          %mi U
                          %mo ,
                          %msup
                            %mi U
                            %mo *
                    %annotation{:encoding => "application/x-tex"} \Sigma_{U,U^*}
                with two marked points labeled by
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
                and
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi U
                        %mo *
                    %annotation{:encoding => "application/x-tex"} U^*
                consider the 3d cobordism from
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                to the result of gluing a handle to
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Σ
                    %annotation{:encoding => "application/x-tex"} \Sigma
                that connects the two marked points with a
                = succeed "-line" do
                  %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
              .maruku-equation
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_23.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi fact
                        %mi U
                      %mo :
                      %mo =
                      %msub
                        %mi tft
                        %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mrow
                          %mi U
                          %mo ,
                          %msup
                            %mi U
                            %mo *
                      %mo →
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      fact_U := tft_C(\Sigma_{U,U^*} \to \Sigma)
              %p we have
            %li
              .maruku-equation
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_24.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ⊕
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi fact
                        %mrow
                          %msub
                            %mi U
                            %mi i
                      %mo :
                      %msub
                        %mo ⊕
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                      %msub
                        %mi tft
                        %mi C
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi Σ
                        %mrow
                          %mi U
                          %mo ,
                          %msup
                            %mi U
                            %mo *
                      %mo{:stretchy => "false"} )
                      %mover
                        %mo →
                        %mo ≃
                      %msub
                        %mi tft
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      \\oplus_{i \in I} fact_{U_i}
                      \:
                      \\oplus_{i \in I} tft_C(\Sigma_{U,U^*})
                      \\stackrel{\simeq}{\to}
                      tft_C(X)
            %li
              %p
                a representation of the mapping class group
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Map
                      %mo{:stretchy => "false"} (
                      %mi Σ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Map(\Sigma)
                on
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi tft
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} tft_C(X)
          %h3#2_cft_correlator 2. CFT correlator
          %h4#21 2.1
          %ul
            %li
              %p
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                a 2-dimensional conformal manifold, either oriented or unoriented without boundary
            %li
              %p for the purpose of this talk restrict to the oriented case (but unoriented case has been dealt with, too)
            %li
              %p
                also, from now on
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                regarded just as a topological surface, no longer a conformal one
          %h4#22 2.2
          %p strategy
          %ul
            %li
              %p
                decorate
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %li
              %p appropriate spaces of “functions” for correlators
          %p
            %strong holomorphic factorization
          %ul
            %li
              %p
                pass from
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                to its
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
                %em orientation bundle
                = succeed "," do
                  %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi X
                          %mo{:stretchy => "false"} ^
                      %annotation{:encoding => "application/x-tex"} \hat X
                %em orientation double cover
                (identifying points on the boundary, though) (an orientation twisted version of what is called the
                %strong double
                )
            %li
              %p double accounts for what physicists call left- and rightmoving degrees of freedom
          %p
            %strong goal
          %ul
            %li
              %p
                1) find a decoration for
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                such that
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi X
                        %mo{:stretchy => "false"} ^
                      %mo ∈
                      %msubsup
                        %mi cobord
                        %mrow
                          %mn 3
                          %mo ,
                          %mn 2
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \hat X \in cobord_{3,2}^C
            %li
              %p
                2) specify the correlator
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Cor
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %msub
                        %mi tft
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} hatt
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cor(X) \in tft_C(\hatt X)
              %ul
                %li
                  %p
                    a)
                    %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Cor
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Cor(X)
                    invariant under
                    %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Map
                          %mo{:stretchy => "false"} (
                          %mover
                            %mi X
                            %mo{:stretchy => "false"} ^
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %msub
                                %mi ℤ
                                %mn 2
                        %annotation{:encoding => "application/x-tex"} Map(\hat X)^{\mathbb{Z}_2}
                    %strong modular invariance
                %li
                  %p b) compatibility with factorization homomorphism (technical to state, dropped here)
          %h4#23 2.3
          %p
            %strong Insight.
            decoration bicategory of special symmetric Frobenius algebras in
            %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
          %ul
            %li
              %p
                Frobenius algebra in
                = succeed ":" do
                  %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
              .maruku-equation
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_40.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo ∈
                      %mi Obj
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi η
                      %mo :
                      %mn 1
                      %mo →
                      %mi A
                      %mo ,
                      %mi ϵ
                      %mo :
                      %mi A
                      %mo →
                      %mn 1
                      %mo ,
                      %mi m
                      %mo :
                      %mi A
                      %mo ⊗
                      %mi A
                      %mo →
                      %mi A
                      %mo ,
                      %mi Δ
                      %mo :
                      %mi A
                      %mo →
                      %mi A
                      %mo ⊗
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"}
                      (A \in Obj(C), \eta : 1 \to A,\epsilon : A \to 1,
                      m : A \otimes A \to A, \Delta : A \to A \otimes A)
              %p
                which is a unital associative algebra and counital coassociative coalgebra in
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            %li
              %p
                being Frobenius means that the coproduct
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_42.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo :
                      %mi A
                      %mo →
                      %mi A
                      %mo ⊗
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \Delta : A \to A \otimes A
                is a homomorphism of
                = succeed "-bimodules" do
                  %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_43.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p
                being
                %em symmetric
                means that the two obvious nontriviall morphisms
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %msup
                        %mi A
                        %mo *
                    %annotation{:encoding => "application/x-tex"} A \to A^*
                that one can build using unit and counit are equal
            %li
              %p
                being special means that
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∘
                      %mi Δ
                      %mo =
                      %msub
                        %mi Id
                        %mi A
                    %annotation{:encoding => "application/x-tex"} m \circ \Delta = Id_A
                and
                %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∘
                      %mi η
                      %mo =
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                      %msub
                        %mi Id
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} \epsilon \circ \eta = dim(A) Id_1
          %h4#24 2.4
          %p
            A typical worldsheet
            = succeed ":" do
              %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            %strong decoration
          %ul
            %li
              %p
                to 2-dimensional cells assign special symmetric Frobenius algebras
                = succeed ";" do
                  %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi A
                      %annotation{:encoding => "application/x-tex"} A
            %li
              %p to 1-dimensional cells
              %ul
                %li
                  %p to boundary lines a left or right module over the respective Frobenius algebra (boundary is oriented);
                %li
                  %p to a defect line: a bimodule over the respective Frobenius algebras
            %li
              %p to 0-dimensional cells
              %ul
                %li
                  %p
                    to a junction of three defect lines labeled by three bimodules
                    = succeed "," do
                      %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msub
                              %mi D
                              %mi i
                          %annotation{:encoding => "application/x-tex"} D_i
                    %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mrow
                              %msub
                                %mi A
                                %mn 1
                              %mo{:stretchy => "false"} |
                              %msub
                                %mi A
                                %mn 3
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mn 1
                          %msub
                            %mo ⊗
                            %mrow
                              %msub
                                %mi A
                                %mn 2
                          %msub
                            %mi D
                            %mn 2
                          %mo ,
                          %msub
                            %mi D
                            %mn 3
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Hom_{A_1| A_3}(D_1 \otimes_{A_2} D_2, D_3)
                %li
                  %p
                    boundary field insertions: for marked point on the boundary
                    %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                          %mo ∈
                          %mo ∂
                          %mi X
                        %annotation{:encoding => "application/x-tex"} x \in \partial X
                    attach a simple object
                    %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo ∈
                          %mi Obj
                          %mo{:stretchy => "false"} (
                          %mi C
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} U \in Obj(C)
                    to a marked point on a given defect line (or rather, on a junction of two defect lines) and an element in
                    %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mi A
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi D
                            %mn 1
                          %mo ⊗
                          %mi U
                          %mo ,
                          %msub
                            %mi D
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Hom_A(D_1 \otimes U, D_2)
                %li
                  %p
                    bulk field insertion: for
                    %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi x
                        %annotation{:encoding => "application/x-tex"} x
                    not in the boundary but in the inside of
                    = succeed "," do
                      %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi X
                          %annotation{:encoding => "application/x-tex"} X
                    = succeed "," do
                      %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mover
                              %mi X
                              %mo{:stretchy => "false"} ^
                          %annotation{:encoding => "application/x-tex"} \hat X
                    %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi U
                          %mo ,
                          %mi V
                        %annotation{:encoding => "application/x-tex"} U, V
                    to these, respectively and assign an element in
                  .maruku-equation
                    %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_58.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Hom
                            %mrow
                              %msub
                                %mi A
                                %mn 1
                              %mo{:stretchy => "false"} |
                              %msub
                                %mi A
                                %mn 2
                          %mo{:stretchy => "false"} (
                          %mi U
                          %mo ⊗
                          %msub
                            %mi A
                            %mn 1
                          %mo ⊗
                          %mi V
                          %mo ,
                          %msub
                            %mi A
                            %mn 2
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"}
                          Hom_{A_1|A_2}(U \otimes A_1 \otimes V, A_2)
                %li
                  %p here the bimodule structure on these tensor products are given by over- and underbraiding, respectively (depending on orientation)
          %h4#25 2.5
          %p correlators from cobordisms
          %p
            given
            %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            consider the cobordism from the empty surface
          .maruku-equation
            %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_60.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ∅
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi M
                        %mi X
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"}
                  \\emptyset \stackrel{M_X}{\to} \hat X
          %p given by
          .maruku-equation
            %math#mathml_a59c9603e2dda1396ed3a32aa551b8822ea52dce_61.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi M
                    %mi X
                  %mo =
