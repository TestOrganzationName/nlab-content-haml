          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Weierstrass+elliptic+function"} Weierstrass elliptic function
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℘
                  %annotation{:encoding => "application/x-tex"} \wp
            %a.existingWikiWord{:href => "/nlab/show/holomorphic+function"} holomorphic function
            with values in the
            %a.existingWikiWord{:href => "/nlab/show/Riemann+sphere"} Riemann sphere
            = succeed "," do
