          %h2#definition Definition
          %p
            The
            %em pillowcase orbifold
            is the 2-dimensional
            %a.existingWikiWord{:href => "/nlab/show/flat+orbifold"} flat
            (
            %a.existingWikiWord{:href => "/nlab/show/complex+orbifold"}> complex
            )
            %a.existingWikiWord{:href => "/nlab/show/orbifold"} orbifold
            which is the
            %a.existingWikiWord{:href => "/nlab/show/global+quotient+orbifold"} global quotient
            of the
            %a.existingWikiWord{:href => "/nlab/show/2-torus"} 2-torus
            by the
            %a.existingWikiWord{:href => "/nlab/show/reflection"} reflection
            %a.existingWikiWord{:href => "/nlab/show/involution"} involution
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi z
                  %mo ↦
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mi z
                %annotation{:encoding => "application/x-tex"} z \mapsto -z
            on its canonical
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Pillow
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi 𝕋
                    %mn 2
                  %msub
                    %mo ⫽
                    %mi refl
                  %msub
                    %mi ℤ
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo ≔
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℝ
                    %mn 2
                  %mo{:stretchy => "false"} /
                  %msup
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⫽
                    %mi refl
                  %msub
                    %mi ℤ
                    %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Pillow
                  \\;\coloneqq \;
                  \\mathbb{T}^2 \sslash_{refl} \mathbb{Z}_2
                  \\;\coloneqq\;
                  (\mathbb{R}^2/\mathbb{Z}^2) \sslash_{refl} \mathbb{Z}_2
                  \\,.
