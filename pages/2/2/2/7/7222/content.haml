                                  %msub
                                    %mo ∫
                                    %mi f
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.8em", :minsize => "1.8em"} ↓
                          %mpadded{:width => "0"}
                            %mrow
                              %msup
                                %mrow
                                %mrow
                                  %msub
                                    %mo ∫
