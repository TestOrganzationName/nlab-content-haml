          %h2#idea Idea
          %p
            The
            %em Fourier-Mukai transform
            is a
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorified
            %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
            roughly similar to the standard
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Fourier+transform"} Fourier transform
          %p
            Generally, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X,Y
            two suitably well-behaved
            %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
            (e.g. affine, smooth, complex) and with
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D(X)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(Y)
            their
            %a.existingWikiWord{:href => "/nlab/show/derived+categories"} derived categories
            of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaves"} quasicoherent sheaves
            %em Fourier-Mukai transform
            with
            %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ∈
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E \in D(X\times Y)
            is a
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            (of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/triangulated+categories"} triangulated categories
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28infinity%2C1%29-categories"} stable (infinity,1)-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:lspace => "verythinmathspace"} :
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Phi \colon D(X)\longrightarrow D(Y)
          %p
            which is given as the composite of the (
            %a.existingWikiWord{:href => "/nlab/show/derived+functor"}> derived
            ) operations of
          %ol
            %li
              %p
                pull (
                %a.existingWikiWord{:href => "/nlab/show/inverse+image"}> inverse image
                ) along the
                %a.existingWikiWord{:href => "/nlab/show/projection"} projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi X
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ×
                      %mi Y
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} p_X\colon X\times Y \to X
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/tensor+product"} tensor product
                with
                = succeed ";" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
            %li
              %p
                push (
                %a.existingWikiWord{:href => "/nlab/show/direct+image"}> direct image
                ) along the other projection
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mi Y
                      %mo{:lspace => "verythinmathspace"} :
                      %mi X
                      %mo ×
                      %mi Y
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} p_Y \colon X\times Y \to Y
          %p i.e.
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi p
                    %mi Y
                  %msub
                    %mo{:stretchy => "false"} )
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ⊗
                  %msubsup
                    %mi p
                    %mi X
                    %mo *
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\Phi(A) \coloneqq (p_Y)_\ast (E\otimes p_X^\ast A)
          %p
            (where here we implicitly understand all operations as
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/derived+functors"} derived functors
            = succeed ")" do
              %a{:href => "#Huybrechts08"} Huybrechts 08, page 4
          %p
            Hence this is a pull-tensor-push
            %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
            through the product
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                          %mo ×
                          %mi Y
                      %mtr
                        %mtd
                        %mtd
                          %mo ↙
                        %mtd
                        %mtd
                          %mo ↘
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                        %mtd
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \&amp;&amp; X \times Y
                  \\\
                  \&amp; \swarrow &amp;&amp; \searrow
                  \\\
                  X &amp;&amp; &amp;&amp; Y
                  }
          %p
            with twist
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            on the correspondence space.
          %p
            Such concept of
            %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
            is rather general and may be considered also in
            %a.existingWikiWord{:href => "/nlab/show/derived+algebraic+geometry"} derived algebraic geometry
            (e.g.
            = succeed ")" do
              %a{:href => "#BenZviNadlerPreygel13"} BenZvi-Nadler-Preygel 13
          %p
            As discussed at
            %em
              %a.existingWikiWord{:href => "/nlab/show/integral+transforms+on+sheaves"} integral transforms on sheaves
            this kind of
            %a.existingWikiWord{:href => "/nlab/show/integral+transform"} integral transform
            is a
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of an integral transform/
            %a.existingWikiWord{:href => "/nlab/show/matrix+multiplication"} matrix multiplication
            of functions induced by an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/integral+kernel"} integral kernel
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E\in D(X \times Y)
          %p
            Indeed, the central kind of result of the theory (theorem
            = succeed ")" do
              %a.maruku-ref{:href => "#OrlovTheorem"}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} D(X)\to D(Y)
            arises as a Fourier-Mukai transform for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %a.existingWikiWord{:href => "/nlab/show/categorification"} categorification
            of the standard fact from
            %a.existingWikiWord{:href => "/nlab/show/linear+algebra"} linear algebra
            that every
            %a.existingWikiWord{:href => "/nlab/show/linear+function"} linear function
            between finite dimensional
            %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            is represented by a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
          %p
            The original Fourier-Mukai transform proper is the special case of the above where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/abelian+variety"} abelian variety
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo =
                  %msup
                    %mi X
                    %mo ∨
                %annotation{:encoding => "application/x-tex"} Y = X^\vee
            its
            %a.existingWikiWord{:href => "/nlab/show/dual+abelian+variety"} dual abelian variety
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is the corresponding
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+line+bundle"} Poincaré line bundle
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a
            %a.existingWikiWord{:href => "/nlab/show/moduli+space+of+bundles"} moduli space of line bundles
            over a suitable
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+curve"} algebraic curve
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+correspondence"} geometric Langlands correspondence
            in the abelian case (
            %a{:href => "#Frenkel05"}> Frenkel 05, section 4.4, 4.5
            ).
          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            be
            %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
            over a
            %a.existingWikiWord{:href => "/nlab/show/field"} field
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ∈
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi QCoh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mrow
                      %mi X
                      %mo ×
                      %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E \in D(QCoh(O_{X \times Y}))
            be an object in the
            %a.existingWikiWord{:href => "/nlab/show/triangulated+categories+of+sheaves"} derived category of quasi-coherent sheaves
            over their
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            %a.existingWikiWord{:href => "/nlab/show/correspondence"} correspondence
            between
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            equipped with a
            %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            of
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/quasi-coherent+sheaves"} quasi-coherent sheaves
          %p
            The functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi QCoh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi QCoh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi(E) : D(QCoh(O_X)) \to D(QCoh(O_Y))
            defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ↦
                  %mstyle{:mathvariant => "bold"}
                    %mi R
                  %msub
                    %mi q
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mstyle{:mathvariant => "bold"}
                    %mi L
                  %msup
                    %mi p
                    %mo *
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %msup
                    %mo ⊗
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %mi E
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} F \mapsto \mathbf{R}q_*(\mathbf{L}p^*(F) \otimes^{\mathbf{L}} E),
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi q
                %annotation{:encoding => "application/x-tex"} q
            are the
            %a.existingWikiWord{:href => "/nlab/show/projections"} projections
            from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ×
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \times Y
            onto
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
            = succeed "," do
              %strong
                Fourier-Mukai transform of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
            = succeed "." do
              %strong
                Fourier-Mukai functor induced by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi QCoh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi X
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi QCoh
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi O
                    %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F : D(QCoh(O_X)) \to D(QCoh(O_Y))
            is isomorphic to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Φ
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Phi(E)
            for some
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi QCoh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi O
                      %mrow
                        %mi X
                        %mo ×
                        %mi Y
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in D(QCoh(O_{X \times Y}))
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is
            %strong
              represented by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            or simply that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is
            = succeed "." do
              %strong of Fourier-Mukai type
          %h2#properties Properties
          %p The key fact is as follows
          #OrlovTheorem.num_theorem
            %h6#theorem_
              Theorem (
              %a.existingWikiWord{:href => "/nlab/show/Orlov"}> Orlov
              )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be smooth projective
              %a.existingWikiWord{:href => "/nlab/show/varieties"} varieties
              over a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F : D(X) \to D(Y)
              be a
              %a.existingWikiWord{:href => "/nlab/show/triangulated+functor"} triangulated
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              is represented by some object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ∈
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E \in D(X \times Y)
              which is unique up to isomorphism.
          %p
            See
            %a{:href => "#OrlovSurvey"} Orlov 2003, 3.2.1
            for a proof.
          .num_remark
            %h6#remark Remark
            %p
              Though theorem
              %a.maruku-ref{:href => "#OrlovTheorem"}
              is stated there for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              admitting a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %a{:href => "#BondalBergh2002"} Bondal-van den Bergh 2002
              that every
              %a.existingWikiWord{:href => "/nlab/show/triangulated+functor"} triangulated
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              admits a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              automatically (see e.g.
              = succeed ")." do
                %a{:href => "#Huybrechts08"} Huybrechts 08, p. 6
          .num_remark
            %h6#remark_2 Remark
            %p
              It was believed that theorem
              %a.maruku-ref{:href => "#OrlovTheorem"}
              should be true for
              %em all
              %a.existingWikiWord{:href => "/nlab/show/triangulated+functors"} triangulated functors
              (e.g.
              = succeed ")." do
                %a{:href => "#Huybrechts08"} Huybrechts 08, p. 5
              %a{:href => "#RVdB2015"} (RVdB 2015)
              this is not true.
          %h2#enhancements Enhancements
          %p
            For any
            %a.existingWikiWord{:href => "/nlab/show/quasicompact+quasiseparated+morphism"} quasi-compact quasi-separated
            = succeed "-schemes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            there is a canonical equivalence of
            %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-categories"} stable (∞,1)-categories
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi{:mathvariant => "normal"} Func
                    %mi L
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ×
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{Func}^L(D(X), D(Y)) \simeq D(X \times Y).
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/triangulated+categories+of+sheaves"} triangulated categories of sheaves
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+duality"} Grothendieck duality
          %h2#references References
          %h3#general General
          %p The original article:
          %ul
            %li#Mukai81
              %a.existingWikiWord{:href => "/nlab/show/Shigeru+Mukai"}> Shigeru Mukai
              \:
              = succeed "," do
                %em
                  Duality between
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} D(X)
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi X
                          %mo{:stretchy => "false"} ^
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} D(\hat X)
                  with its application to Picard sheaves
              %strong 81
              (1981) 153-175 &amp;lbrack;
              %a{:href => "https://doi.org/10.1017/S002776300001922X"}> doi:10.1017/S002776300001922X
              \&amp;rbrack;
          %p Further discussion:
          %ul
            %li#BondalBergh2002
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alexei+Bondal"}> Alexei Bondal
                ,
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Michel+van+den+Bergh"} Michel van den Bergh
                = succeed "," do
                  %em Generators and representability of functors in commutative and noncommutative geometry
                %a{:href => "http://arxiv.org/abs/math/0204218"} arXiv
            %li#OrlovSurvey
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dmitri+Orlov"}> Dmitri Orlov
                ,
                = succeed "," do
                  %em Derived categories of coherent sheaves and equivalences between them
                = succeed "." do
                  %a{:href => "http://www.mi.ras.ru/~orlov/papers/Uspekhi2003.pdf"} translation
            %li
              %p
                Lutz Hille, Michel van den Bergh,
                %em Fourier-Mukai transforms
                (
                %a{:href => "http://arxiv.org/abs/math/0402043"}> arXiv:0402043
                )
            %li#Huybrechts08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Huybrechts"}> Daniel Huybrechts
                ,
                %em Fourier-Mukai transforms
                (2008) &amp;lbrack;
                %a{:href => "http://www.math.uni-bonn.de/people/huybrech/Garda2.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Huybrechts-FourierMukai.pdf", :title => "pdf"} pdf
            %li
              %p
                Claudio Bartocci,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ugo+Bruzzo"} Ugo Bruzzo
                = succeed "," do
                  %em Fourier-Mukai and Nahm transforms in geometry and mathematical physics
                = succeed "," do
                  %strong 276
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/b11801"} doi:10.1007/b11801
            %li#RVdB2015
              %p
                Alice Rizzardo,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michel+Van+den+Bergh"} Michel Van den Bergh
                %em An example of a non-Fourier-Mukai functor between derived categories of coherent sheaves
                (
                %a{:href => "http://arxiv.org/abs/1410.4039"}> arXiv:1410.4039
                )
            %li#Belmans
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pieter+Belmans"}> Pieter Belmans
                , section 2.2 of
                = succeed "," do
                  %em Grothendieck duality: lecture 3
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/BelmansDuality.pdf", :title => "pdf"} pdf
          %p
            Banerjee and Hudson have defined Fourier-Mukai functors analogously on
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/algebraic+cobordism"} algebraic cobordism
          %ul
            %li
              Anandam Banerjee, Thomas Hudson,
              = succeed "," do
                %em Fourier-Mukai transformation on algebraic cobordism
              = succeed "." do
                %a{:href => "https://sites.google.com/site/anandamb/research/fourier-mukai.pdf?attredirects=0"} pdf
          %p
            Discussion of
            %a.existingWikiWord{:href => "/nlab/show/internal+homs"} internal homs
            of
            %a.existingWikiWord{:href => "/nlab/show/dg-categories"} dg-categories
            in terms of refined Fourier-Mukai transforms is in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Bertrand+To%C3%ABn"}> Bertrand Toën
                ,
                = succeed "," do
                  %em The homotopy theory of dg-categories and derived Morita theory
            %li
              %p
                Alberto Canonaco, Paolo Stellari,
                %em Internal Homs via extensions of dg functors
                (
                %a{:href => "http://arxiv.org/abs/1312.5619"}> arXiv:1312.5619
                )
          %p
            Discussion in the context of
            %a.existingWikiWord{:href => "/nlab/show/geometric+Langlands+duality"} geometric Langlands duality
            is in
          %ul
            %li#Frenkel05
              %a.existingWikiWord{:href => "/nlab/show/Edward+Frenkel"}> Edward Frenkel
              ,
              %em Lectures on the Langlands Program and Conformal Field Theory
              (
              %a{:href => "http://arxiv.org/abs/hep-th/0512172"}> arXiv:hep-th/0512172
              )
          %p
            For a discussion of Fourier-Mukai transforms in the setting of
            = succeed "-enhancements," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %ul
            %li#BenZviNadlerPreygel13
              %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"}> David Ben-Zvi
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Nadler"} David Nadler
              = succeed "," do
                %em Integral transforms for coherent sheaves
              %a{:href => "http://arxiv.org/abs/1312.7164"} arXiv:1312.7164
          %h3#ReferencesForTDuality For T-duality
          %p
            Discussion of the effect of
            %a.existingWikiWord{:href => "/nlab/show/T-duality"} T-duality
            on
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            %a.existingWikiWord{:href => "/nlab/show/flux+densities"} flux densities
            (in
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            or in
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kentaro+Hori"}> Kentaro Hori
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Yaron+Oz"} Yaron Oz
                = succeed "," do
                  %em
                    F-Theory, T-Duality on K3 Surfaces and
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo =
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} N=2
                    Supersymmetric Gauge Theories in Four Dimensions
                %strong 501
                (1997) 97-108 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9702173"}> arXiv:hep-th/9702173
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0550-3213(97)00361-1"} doi:10.1016/S0550-3213(97)00361-1
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Kentaro+Hori"}> Kentaro Hori
                \: (1.1) and pp. 13 of:
                = succeed "," do
                  %em D-branes, T-duality, and Index Theory
                %strong 3
                2 (1999) 281-342 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/hep-th/9902102"}> arXiv:hep-th/9902102
                ,
                = succeed "," do
                  %a{:href => "https://dx.doi.org/10.4310/ATMP.1999.v3.n2.a5"} doi:10.4310/ATMP.1999.v3.n2.a5
                = succeed "&rbrack;" do
                  %a{:href => "https://www.intlpress.com/site/pub/files/_fulltext/journals/atmp/1999/0003/0002/ATMP-1999-0003-0002-a005.pdf"} pdf
              %blockquote
                %p (whence “Hori’s formula”)
          %p
            with explicit formulation in the context if
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/topological+T-duality"} topological T-duality
          %ul
            %li#BouwknegtEvslinMathai04
              %a.existingWikiWord{:href => "/nlab/show/Peter+Bouwknegt"}> Peter Bouwknegt
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jarah+Evslin"} Jarah Evslin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
              = succeed "," do
                %em T-Duality: Topology Change from H-flux
              %strong 249
              (2004) 383-415 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/hep-th/0306062"}> hep-th/0306062
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://doi.org/10.1007/s00220-004-1115-6"} doi:10.1007/s00220-004-1115-6
          %p Survery and Review:
          %ul
            %li
              %p
                Martin Ruderer,
                = succeed "," do
                  %em Fourier-Mukai Transforms from T-Duality
                = succeed "," do
                  %a{:href => "https://nbn-resolving.org//urn:nbn:de:bvb:355-epub-314033"} urn:nbn:de:bvb:355-epub-314033
                = succeed "&rbrack;" do
                  %a{:href => "https://epub.uni-regensburg.de/31403/6/final.pdf"} pdf
            %li
              %p
                Bjorn Andreas, Daniel Hernandez Ruiperez:
                = succeed "," do
                  %em Fourier Mukai Transforms and Applications to String Theory
                %strong 99
                1 (2005) 29-77 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/0412328"}> arXiv:math/0412328
                ,
                = succeed "," do
                  %a{:href => "https://inspirehep.net/literature/667425"} spire:667425
                = succeed "&rbrack;" do
                  %a{:href => "https://mat.usal.es/ruiperez/Site/Papers_files/4_ANDREAS.PDF"} pdf
          %p
            For
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/non-abelian+T-duality"} non-abelian T-duality
          %ul
            %li
              Eva Gevorgyan,
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Gor+Sarkissian"} Gor Sarkissian
              = succeed "," do
                %em Defects, Non-abelian T-duality, and the Fourier-Mukai transform of the Ramond-Ramond fields
              %strong 2014
              35 (2014) [
              %a{:href => "https://doi.org/10.1007/JHEP03(2014)035"}> doi:10.1007/JHEP03(2014)035
              ,
              = succeed "]" do
                %a{:href => "https://arxiv.org/abs/1310.1264"} arXiv:1310.1264
          %p
            On
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/superspace"} superspace
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Domenico+Fiorenza"}> Domenico Fiorenza
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hisham+Sati"} Hisham Sati
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Urs+Schreiber"} Urs Schreiber
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/schreiber/show/T-Duality+from+super+Lie+n-algebra+cocycles+for+super+p-branes"} T-Duality from super Lie n-algebra cocycles for super p-branes
              %strong 22
              5 (2018) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1611.06536"}> arXiv:1611.06536
              ,
              = succeed "&rbrack;" do
                %a{:href => "https://dx.doi.org/10.4310/ATMP.2018.v22.n5.a3"} doi:10.4310/ATMP.2018.v22.n5.a3
          %p
            For
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/spherical+T-duality"} spherical T-duality
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Peter+Bouwknegt"}> Peter Bouwknegt
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Jarah+Evslin"} Jarah Evslin
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Varghese+Mathai"} Varghese Mathai
              = succeed "," do
                %em Spherical T-duality and the spherical Fourier–Mukai transform
              %strong 133
              (2018) 303-314 &amp;lbrack;
              %a{:href => "https://doi.org/10.1016/j.geomphys.2018.07.020"}> doi:10.1016/j.geomphys.2018.07.020
              ,
              = succeed "&rbrack;" do
