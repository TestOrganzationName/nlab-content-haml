                          %mi M
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi β
                              %mi M
                        %mtd
                          %mi Y
                          %mi M
                        %mtd
                        %mtd
                        %mtd
                          %mi Y
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mn 1
                                %mi Y
                        %mtd
                          %mi Y
                      %mtr
                        %mtd
                          %mi Y
                          %mi m
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mi β
                        %mtd
                        %mtd
                        %mtd
                          %mi Y
                          %mi u
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %msub
                            %mn 1
                            %mi Y
                      %mtr
                        %mtd
