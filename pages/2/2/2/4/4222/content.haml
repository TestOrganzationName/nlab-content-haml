          %h2#idea Idea
          %p
            A two-sided bar construction is a
            %a.existingWikiWord{:href => "/nlab/show/simplicial+object"} simplicial object
            associated with the data of a left
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            and right module over a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monad"} monad
          %h2#definition Definition
          %h3#left_and_right_modules Left and right modules
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo :
                  %mi B
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} M: B \to B
            be a monad with multiplication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mi M
                  %mi M
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} m: M M \to M
            and unit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %msub
                      %mn 1
                      %mi B
                    %mo →
                    %mi M
                  %annotation{:encoding => "application/x-tex"} u: 1_B \to M
            %strong left module
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            consists of a 1-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} X: A \to B
            and a 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi M
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \alpha: M X \to X
            such that the diagrams
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi M
                          %mi M
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %mi M
                              %mi α
                        %mtd
                          %mi M
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo →
                            %mrow
                              %msub
                                %mn 1
                                %mi X
                        %mtd
                          %mi X
                      %mtr
                        %mtd
                          %mi m
                          %mi X
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %mi α
                        %mtd
                        %mtd
                        %mtd
                          %mi u
                          %mi X
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                          %msub
                            %mn 1
                            %mi X
                      %mtr
                        %mtd
                          %mi M
                          %mi X
                        %mtd
                          %munder
                            %mo →
                            %mi α
                        %mtd
                          %mi X
                        %mtd
                        %mtd
                        %mtd
                          %mi M
                          %mi X
                        %mtd
                          %munder
                            %mo →
                            %mi α
                        %mtd
                          %mi X
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  M M X &amp; \stackrel{M\alpha}{\to} &amp; M X &amp; &amp; &amp; X &amp; \stackrel{1_X}{\to} &amp; X \\
                  m X \downarrow &amp; &amp; \downarrow \alpha &amp; &amp; &amp; u X \downarrow &amp; &amp; \downarrow 1_X\\
                  M X &amp; \underset{\alpha}{\to} &amp; X &amp; &amp; &amp; M X &amp; \underset{\alpha}{\to} &amp; X
                  }
          %p
            commute. A
            %strong right module
            over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            consists of a 1-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo :
                  %mi B
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} Y: B \to C
            and a 2-cell
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo :
                  %mi Y
                  %mi M
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} \beta: Y M \to Y
            such that the diagrams
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi Y
