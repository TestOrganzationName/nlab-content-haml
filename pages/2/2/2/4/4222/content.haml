                          %mi M
                        %mtd
                          %munder
                            %mo →
                            %mi β
                        %mtd
                          %mi Y
                        %mtd
                        %mtd
                        %mtd
                          %mi Y
                          %mi M
                        %mtd
                          %munder
                            %mo →
                            %mi β
                        %mtd
                          %mi Y
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  Y M M &amp; \stackrel{\beta M}{\to} &amp; Y M &amp; &amp; &amp; Y &amp; \stackrel{1_Y}{\to} &amp; Y \\
                  Y m \downarrow &amp; &amp; \downarrow \beta &amp; &amp; &amp; Y u \downarrow &amp; &amp; \downarrow 1_Y\\
                  Y M &amp; \underset{\beta}{\to} &amp; Y &amp; &amp; &amp; Y M &amp; \underset{\beta}{\to} &amp; Y
                  }
          %p commute.
          %h3#initial_structure Initial structure
          %p
            With the aid of string diagrams, one may easily visualize the structure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi I
                %annotation{:encoding => "application/x-tex"} \mathbf{I}
            that is initial amongst 2-categories equipped with the data of monad and left and right modules over the monad. The 2-category has three 0-cells
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi m
                    %mrow
                      %mo ∘
                      %mi n
                  %mo :
                  %mn 1
                  %mo →
                  %mn 1
                  %mspace{:width => "2em"}
                  %mi y
                  %msup
                    %mi m
                    %mrow
                      %mo ∘
                      %mi n
                  %mo :
                  %mn 1
                  %mo →
                  %mn 2
                  %mspace{:width => "2em"}
                  %msup
                    %mi m
                    %mrow
                      %mo ∘
                      %mi n
                  %mi x
                  %mo :
                  %mn 0
                  %mo →
                  %mn 1
                  %mspace{:width => "2em"}
                  %mi y
                  %msup
                    %mi m
                    %mrow
                      %mo ∘
                      %mi n
                  %mi x
                  %mo :
                  %mn 0
                  %mo →
                  %mn 2
                  %mo ,
                %annotation{:encoding => "application/x-tex"} m^{\circ n}: 1 \to 1 \qquad y m^{\circ n}: 1 \to 2 \qquad m^{\circ n} x: 0 \to 1 \qquad y m^{\circ n} x: 0 \to 2,
          %p
            and the nonempty hom-categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi I
                  %mo{:stretchy => "false"} (
                  %mi i
                  %mo ,
                  %mi j
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} hom(i, j) = \mathbf{I}(i, j)
            may be described as follows:
          %ul
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} hom(1, 1)
                is isomorphic to the “algebraist’s
                = succeed "\u201D" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mi a
                      %annotation{:encoding => "application/x-tex"} \Delta_a
                = succeed "):" do
                  %a.existingWikiWord{:href => "/nlab/show/simplex+category"} simplex category
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} hom(1, 2)
                is isomorphic to
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mo ⊥
                      %annotation{:encoding => "application/x-tex"} \Delta_{\bot}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} hom(0, 1)
                is isomorphic to
                = succeed ":" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Δ
                          %mo ⊤
                      %annotation{:encoding => "application/x-tex"} \Delta_{\top}
            %li
              %p
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi hom
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo ,
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} hom(0, 2)
                is isomorphic to the “topologist’s
                = succeed "\u201D" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi Δ
                          %mi op
                      %annotation{:encoding => "application/x-tex"} \Delta^{op}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Δ
                        %mrow
                          %mo ⊤
                          %mo ,
                          %mo ⊥
                    %annotation{:encoding => "application/x-tex"} \Delta_{\top, \bottom}
                of
                = succeed "," do
                  %strong finite intervals
          %p
            Note that the structure of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} hom(1, 1)
            simply recapitulates the universal property of the algebraist’s
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Δ
                      %mi a
                  %annotation{:encoding => "application/x-tex"} \Delta_a
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %h3#twosided_bar_construction Two-sided bar construction
          %p
            Now we give the definition. Suppose given a 2-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{B}
            together with a monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo :
                  %mi B
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} M: B \to B
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                %annotation{:encoding => "application/x-tex"} X: A \to B
            and a right module
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo :
                    %mi B
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Y: B \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi I
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                %annotation{:encoding => "application/x-tex"} \mathbf{I} \to \mathbf{B}
          %p which preserves the monad and module structures, and this induces a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Δ
                    %mi op
                  %mo ≅
                  %mstyle{:mathvariant => "bold"}
                    %mi I
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \Delta^{op} \cong \mathbf{I}(0, 2) \to \mathbf{B}(A, C)
          %p
            This functor is the
            = succeed "," do
              %strong two-sided bar construction
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi Y
                    %mo ,
                    %mi M
                    %mo ,
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(Y, M, X)
          %p The structure of the two-sided bar construction may be given more concretely as follows:
          %ul
            %li
              %p
                The
                = succeed "-dimensional" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi M
                      %mo ,
                      %mi X
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} B(Y, M, X)
                is
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo{:stretchy => "false"} (
                      %mi Y
                      %mo ,
                      %mi M
                      %mo ,
                      %mi X
                      %msub
                        %mo{:stretchy => "false"} )
                        %mi n
                      %mo =
                      %mi Y
                      %msup
                        %mi M
                        %mrow
                          %mo ∘
                          %mi n
                      %mi X
                    %annotation{:encoding => "application/x-tex"} B(Y, M, X)_n = Y M^{\circ n} X
            %li
              %p
                The
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} n+2
                face maps
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi d
                        %mi n
                        %mi i
                      %mo :
                      %mi Y
                      %msup
                        %mi M
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi X
                      %mo →
                      %mi Y
                      %msup
                        %mi M
                        %mi n
                      %mi X
                    %annotation{:encoding => "application/x-tex"} d_{n}^{i}: Y M^{n+1} X \to Y M^n X
              %p
                are
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi β
                      %msup
                        %mi M
                        %mi n
                      %mi X
                    %annotation{:encoding => "application/x-tex"} \beta M^n X
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} i = 0
                ),
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %msup
                        %mi M
                        %mrow
                          %mi i
                          %mo −
                          %mn 1
                      %mi m
                      %msup
                        %mi M
                        %mrow
                          %mi n
                          %mo −
                          %mi i
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Y M^{i-1} m M^{n-i} X
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 1
                      %mo ≤
                      %mi i
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 1 \leq i \leq n
                ), and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %msup
                        %mi M
                        %mi n
                      %mi α
                    %annotation{:encoding => "application/x-tex"} Y M^n \alpha
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi i
                      %mo =
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} i = n+1
                ).
            %li
              %p
                The
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} n+1
                degeneracy maps
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi s
                        %mi n
                        %mi i
                      %mo :
                      %mi Y
                      %msup
                        %mi M
                        %mi n
                      %mi X
                      %mo →
                      %mi Y
                      %msup
                        %mi M
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                      %mi X
                    %annotation{:encoding => "application/x-tex"} s_{n}^{i}: Y M^n X \to Y M^{n+1} X
              %p
                are
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %msup
                        %mi M
                        %mi i
                      %mi u
                      %msup
                        %mi M
                        %mrow
                          %mi n
                          %mo −
                          %mi i
                      %mi X
                    %annotation{:encoding => "application/x-tex"} Y M^i u M^{n-i} X
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 0
                      %mo ≤
                      %mi i
                      %mo ≤
                      %mi n
                    %annotation{:encoding => "application/x-tex"} 0 \leq i \leq n
                ).
          %h2#examples Examples
          %p Two-sided bar constructions encapsulate a surprising number of constructions, a few of which follow.
          %h3#classifying_bundle Classifying bundle
          %p
            Consider the cartesian monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Top
                %annotation{:encoding => "application/x-tex"} Top
            as a 1-object bicategory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                  %mi Top
                %annotation{:encoding => "application/x-tex"} \Sigma Top
            (which we may strictify to a 2-category). A topological
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is the same as a monad in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Σ
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} \Sigma Top
            = succeed "-modules" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %p
            In particular,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            may be regarded as a left or right
            = succeed "-module," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            carries a unique structure of left or right
            = succeed "-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mi M
                  %mo =
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi M
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B M = B(1, M, 1)
          %p as base space, and the simplicial space
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mi M
                  %mo =
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi M
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} E M = B(M, M, 1)
          %p as total space, of a simplicial fibration
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi π
                  %mo ,
                  %mi M
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi M
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mi M
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(\pi, M, 1): B(M, M, 1) \to B(1, M, 1)
          %p
            induced by the unique left module map
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi M
                    %mo →
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} \pi: M \to 1
            %span.newWikiWord
              classifying bundle
              %a{:href => "/nlab/new/classifying+bundle"} ?
            of the monoid
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          %h3#cofibrant_replacement Cofibrant replacement
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            is a monad and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi α
                  %mo :
                  %mi M
                  %mi X
                  %mo →
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X, \alpha: M X \to X)
            is a (left-sided)
            = succeed "-algebra," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            acting upon itself on the right, there is a simplicial object
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mo ,
                  %mi M
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(M, M, X)
          %p
            which may be regarded as a
            %em cofibrant replacement
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/bar+construction"} bar construction
          %p
            Rather more generally, if in addition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi β
                  %mo :
                  %mi Y
                  %mi M
                  %mo →
                  %mi Y
                %annotation{:encoding => "application/x-tex"} (Y, \beta: Y M \to Y
            is a right
            = succeed "-module," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mi M
                  %mi X
                  %mover
                    %munder
                      %mo →
                      %mrow
                        %mi Y
                        %mi α
                    %mover
                      %mo →
                      %mrow
                        %mi β
                        %mi X
                  %mi Y
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y M X \stackrel{\overset{\beta X}{\to}}{\underset{Y \alpha}{\to}} Y X
          %p
            (if it exists) by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %msub
                      %mo ∘
                      %mi M
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \circ_M X
            %em tensor product
            (over
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ,
                  %mi M
                  %mo ,
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(Y, M, X)
            is canonically augmented by
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %msub
                      %mo ∘
                      %mi M
                    %mi X
                  %annotation{:encoding => "application/x-tex"} Y \circ_M X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %msub
                    %mo ∘
                    %mi M
                  %mi X
                %annotation{:encoding => "application/x-tex"} Y \circ_M X
            when the latter is regarded as a constant simplicial object. See also homotopy colimits, below.
          %h3#canonical_twosided_bar_construction_of_an_adjunction Canonical two-sided bar construction of an adjunction
          %p
            Suppose given any
            %a.existingWikiWord{:href => "/nlab/show/adjoint+pair"} adjoint pair
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo :
                  %mi B
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ⊣
                  %mo{:stretchy => "false"} (
                  %mi U
                  %mo :
                  %mi A
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (F: B \to A) \dashv (U: A \to B)
            in a 2-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ε
                    %mo :
                    %mi F
                    %mi U
                    %mo →
                    %msub
                      %mn 1
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \varepsilon: F U \to 1_A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo =
                    %mi U
                    %mi F
                    %mo :
                    %mi B
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} M = U F: B \to B
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo =
                  %mi U
                  %mi ε
                  %mo :
                  %mi U
                  %mi F
                  %mi U
                  %mo →
                  %mi U
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \alpha = U \varepsilon: U F U \to U,
          %p
            and a canonical right
            = succeed "-action" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi β
                  %mo =
                  %mi ε
                  %mi F
                  %mo :
                  %mi F
                  %mi U
                  %mi F
                  %mo →
                  %mi F
                  %mo .
                %annotation{:encoding => "application/x-tex"} \beta = \varepsilon F: F U F \to F.
          %p
            We may then form the canonical simplicial object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi M
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B(F, M, U)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %msub
                    %mo ∘
                    %mi M
                  %mi U
                %annotation{:encoding => "application/x-tex"} F \circ_M U
            is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mn 1
                      %mi A
                  %annotation{:encoding => "application/x-tex"} 1_A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mn 1
                    %mi A
                %annotation{:encoding => "application/x-tex"} 1_A
            as a constant simplicial object
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Δ
                      %mi op
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Delta^{op} \to \mathbf{B}(A, A)
          .un_prop
            %h6#proposition Proposition
            %p
              The canonical simplicial map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ,
                    %mi M
                    %mo ,
                    %mi U
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msub
                      %mn 1
                      %mi A
                  %annotation{:encoding => "application/x-tex"} B(F, M, U) \to 1_A
              is a simplicial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %h4#delooping_machines Delooping machines
          %p
            The classic application of this two-sided bar construction was given by Peter May, after work of Jon Beck. Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo =
                  %msub
                    %mi Top
                    %mo *
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mn 1
                  %mo ,
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %msub
                    %mi Top
                    %mo *
                  %mo →
                  %msub
                    %mi Top
                    %mo *
                %annotation{:encoding => "application/x-tex"} \Omega = Top_{*}(S^1, -): Top_{*} \to Top_{*}
            be the loop space functor on pointed spaces, with left adjoint the suspension functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %msup
                      %mi S
                      %mn 1
                    %mo ∧
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo :
                    %msub
                      %mi Top
                      %mo *
                    %mo →
                    %msub
                      %mi Top
                      %mo *
                  %annotation{:encoding => "application/x-tex"} S = S^1 \wedge -: Top_{*} \to Top_{*}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ≥
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n \geq 1
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mi n
                  %mo ⊣
                  %msup
                    %mi Ω
                    %mi n
                %annotation{:encoding => "application/x-tex"} S^n \dashv \Omega^n
            induces a monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Ω
                    %mi n
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} \Omega^n S^n
            which acts (on the left) on
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \Omega^n X
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} S^n
          .un_prop
            %h6#proposition_2 Proposition
            %p
              The canonical simplicial map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msup
                      %mi Ω
                      %mi n
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msup
                      %mi Ω
                      %mi n
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} B(S^n, \Omega^n S^n, \Omega^n X) \to X
              is a simplicial
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
          %p
            So if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                %annotation{:encoding => "application/x-tex"} Y
            is an
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi n
                  %mo ,
                  %msup
                    %mi Ω
                    %mi n
                  %msup
                    %mi S
                    %mi n
                  %mo ,
                  %mi Y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(S^n, \Omega^n S^n, Y)
            provides its
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
          %p
            Continuing this train of thought: suppose given a monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n
            equipped with a monad map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %msub
                    %mi C
                    %mi n
                  %mo →
                  %msup
                    %mi Ω
                    %mi n
                  %msup
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} \phi: C_n \to \Omega^n S^n
            (which is
            = succeed "d" do
              %a.existingWikiWord{:href => "/nlab/show/mate"} mate
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                    %msup
                      %mi Ω
                      %mi n
                    %mo →
                    %msup
                      %mi Ω
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_n \Omega^n \to \Omega^n
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            is objectwise a homotopy equivalence. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                %annotation{:encoding => "application/x-tex"} \phi
            induces a homotopy equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi n
                  %mo ,
                  %mi ϕ
                  %mo ,
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi n
                  %mo ,
                  %msub
                    %mi C
                    %mi n
                  %mo ,
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi B
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi S
                    %mi n
                  %mo ,
                  %msup
                    %mi Ω
                    %mi n
                  %msup
                    %mi S
                    %mi n
                  %mo ,
                  %msup
                    %mi Ω
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} B(S^n, \phi, \Omega^n): B(S^n, C_n, \Omega^n) \to B(S^n, \Omega^n S^n, \Omega^n)
          %p
            The classic example of this is where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n
            is the little
            = succeed "-cubes" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                    %mo =
                    %msub
                      %mi Top
                      %mo *
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^n = Top_{*}(S^n, -)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n
            is much more tractable than
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \Omega^n S^n
          %p Continuing this thought still further, we have the following recognition theorem of May:
          .un_thm
            %h6#theorem Theorem
            %p
              Suppose
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is a connected space with a
              = succeed "-action." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi n
                    %annotation{:encoding => "application/x-tex"} C_n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is homotopy equivalent to an
              = succeed "-fold" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi Ω
                      %mi n
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msub
                      %mi C
                      %mi n
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ←
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mi n
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msub
                      %mi C
                      %mi n
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi B
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Ω
                      %mi n
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %msup
                      %mi Ω
                      %mi n
                    %msup
                      %mi S
                      %mi n
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} \Omega^n B(S^n, C_n, Y) \leftarrow B(\Omega^n S^n, C_n, Y) \to B(\Omega^n S^n, \Omega^n S^n, Y) \simeq Y
            %p where each of the arrows is a homotopy equivalence.
          .query
            %p I’m going on sheer memory here of May’s Geometry of Iterated Loop Spaces, and it’s quite possible that I’m missing hypotheses in some directions and that hypotheses could be weakened in other directions, e.g., replacing the connectedness assumption with a group completion assumption. This is in need of expert attention.
            %p
              %a.existingWikiWord{:href => "/nlab/show/JCMcKeown"} JCMcKeown
              \: Hi, Todd (five years later); hmm. The first thing that comes to mind is that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                  %annotation{:encoding => "application/x-tex"} C_n
              the monad-of-the-operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_{(n)}
              of little-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              \-cubes isn’t objectwise homotopy-equivalent to
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Ω
                        %mi n
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} \Omega^n S^n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi n
                    %mi X
                    %mo =
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋁
                      %mi k
                    %msubsup
                      %mi E
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi X
                      %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C_n X = \bigvee_k E^{k}_{(n)}((X^k))
              for some sensible idea of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi E
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi n
                          %mo{:stretchy => "false"} )
                        %mi k
                      %mo{:stretchy => "false"} (
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} E^k_{(n)}((-))
              = succeed "-cubes" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
