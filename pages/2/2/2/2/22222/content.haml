          %p
          #HomCharacterization.num_theorem
            %h6 Theorem
            %p Having a left multi-adjoint can be equivalently characterized as follows:
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} R : D \to C
              has a left multi-adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi I
                    %mo ,
                    %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (I, L)
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo :
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} I : Obj(C) \to Set
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi L
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo :
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Obj
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} L : (x : Obj(C)) \to I(x) \to Obj(D)
              if for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo :
                      %mi Σ
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ∈
                      %mi I
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo .
                      %msub
                        %mi Hom
                        %mi D
                      %mo{:stretchy => "false"} (
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≅
                      %msub
                        %mi Hom
                        %mi C
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi R
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \alpha : \Sigma(i \in I(x)).Hom_D(L(x, i), y) \cong Hom_C(x, R y)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                    %annotation{:encoding => "application/x-tex"} y
          .proof
            %h6 Proof
            %p
              We first prove the Hom-characterization from the definition. Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi ϕ
                      %mo :
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (i, \phi : L(x, i) \to y)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mo =
                      %mi R
                      %mi ϕ
                      %mo ∘
                      %msub
                        %mi η
                        %mrow
                          %mi x
                          %mo ,
                          %mi i
                      %mo :
                      %mi x
                      %mo →
                      %mi R
                      %mi y
                    %annotation{:encoding => "application/x-tex"} \alpha(\phi) := R\phi \circ \eta_{x, i} : x \to R y
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi χ
                      %mo :
                      %mi y
                      %mo →
                      %mi z
                    %annotation{:encoding => "application/x-tex"} \chi : y \to z
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mi χ
                    %mo ∘
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi R
                    %mi χ
                    %mo ∘
                    %mi R
                    %mi ϕ
                    %mo ∘
                    %msub
                      %mi η
                      %mrow
                        %mi x
                        %mo ,
                        %mi i
                    %mo =
                    %mi α
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo ,
                    %mi χ
                    %mo ∘
                    %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    R\chi \circ \alpha(i, \phi) = R\chi \circ R\phi \circ \eta_{x,i} = \alpha(i, \chi \circ \phi).
            %p
              Now let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              be given. Then we define
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mrow
                          %mi x
                          %mo ,
                          %mi i
                      %mo =
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi id
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi x
                      %mo →
                      %mi RL
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_{x, i} = \alpha(i, id) : x \to RL(x, i)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi α
                      %mo{:stretchy => "false"} (
                      %mi i
                      %mo ,
                      %mi ϕ
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi R
                      %mi ϕ
                      %mo ∘
                      %msub
                        %mi η
                        %mrow
                          %mi x
                          %mo ,
                          %mi i
                    %annotation{:encoding => "application/x-tex"} \alpha(i, \phi) = R\phi \circ \eta_{x, i}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              proves the condition in the definition.
          %p
            %br/
          %p#FamOp
            For the following theorem, let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fam
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fam(D)
            be the category
          %ul
            %li
              %p
                whose objects are
                %a.existingWikiWord{:href => "/nlab/show/indexed+sets"} indexed sets
                of objects of
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                      %annotation{:encoding => "application/x-tex"} D
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi I
                      %mo ,
                      %mi h
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (I, h)
                where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is a
                %a.existingWikiWord{:href => "/nlab/show/set"} set
                and
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi h
                        %mo{:lspace => "verythinmathspace"} :
                        %mi I
                        %mo →
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi D
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} h \colon I \to Obj(D)
            %li
              %p
                whose morphisms
