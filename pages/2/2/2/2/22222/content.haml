          %h2#idea Idea
          %p
            A
            %strong multi-adjoint
            is like an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            but sends each
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            to a family of objects rather than a single one.
          %p
            Under mild conditions it is equivalent to the notion of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/parametric+right+adjoint"} parametric right adjoint
          %p
            Every multiadjunction induces a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multimonad"} multimonad
          %h2#definition Definition
          %p
          #MultiAdjoints.num_defn
            %h6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} R \colon D\to C
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/functor"} functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              has a
              %strong left multi-adjoint
              if for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x \in C
              there are
            %ol
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/small"} small
                set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} I(x)
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/family"} family
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \{L(x,i)\}_{i \in I(x)}
                of objects of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %li
                a
                %a.existingWikiWord{:href => "/nlab/show/family"} family
                of
                %a.existingWikiWord{:href => "/nlab/show/morphisms"} morphisms
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %msub
                        %mi η
                        %mrow
                          %mi x
                          %mo ,
                          %mi i
                      %mo{:lspace => "verythinmathspace"} :
                      %mi x
                      %mo →
                      %mi R
                      %mi L
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} )
                      %msub
                        %mo{:stretchy => "false"} }
                        %mrow
                          %mi i
                          %mo ∈
                          %mi I
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \{\eta_{x,i} \colon x \to R L(x,i)\}_{i\in I(x)}
            %p
              such that for any morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:lspace => "verythinmathspace"} :
                    %mi x
                    %mo →
                    %mi R
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f  \colon x\to R y
              there exists a unique
              %a.existingWikiWord{:href => "/nlab/show/pair"} pair
              of an index
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi f
                    %mo ∈
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} i_f\in I(x)
              and a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo{:lspace => "verythinmathspace"} :
                    %mi L
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %msub
                      %mi i
                      %mi f
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} g \colon L(x, i_f) \to y
