                          %mtd
                          %mtd
                            %msub
                              %mi G
                              %mrow
                                %mo{:stretchy => "false"} |
                                %mi 𝒰
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi G
                        %mtr
                          %mtd
                          %mtd
