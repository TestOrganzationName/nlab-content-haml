            Given a
            %a.existingWikiWord{:href => "/nlab/show/group"} group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            and a
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
            %em coset object
            is the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G/H
            %a.existingWikiWord{:href => "/nlab/show/equivalence+classes"} equivalence classes
            of elements of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            where two are regarded as equivalent if they differ by right multiplication with an element in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
            %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            and usually called the
            = succeed "." do
              %em coset space
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homogeneous+space"} homogeneous space
          %h2#definition Definition
          %h3#internal_to_a_general_category Internal to a general category
          %p
            In a category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            a
            %a.existingWikiWord{:href => "/nlab/show/group+object"} group object
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ↪
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
            a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup object
            %em object of cosets
            is the
            %a.existingWikiWord{:href => "/nlab/show/orbit"} object of orbits
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            under left/right multiplication by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
          %p
            Explicitly, the left coset space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/H
            %a.existingWikiWord{:href => "/nlab/show/coequalizes"} coequalizes
            the parallel morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ×
                  %mi G
                  %munderover
                    %mo ⇉
                    %mi μ
                    %mrow
                      %msub
                        %mi proj
                        %mi G
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  H \times G \underoverset{\mu}{proj_G}\rightrightarrows G
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi μ
                %annotation{:encoding => "application/x-tex"} \mu
            is (the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ×
                  %mi G
                  %mo ↪
                  %mi G
                  %mo ×
                  %mi G
                %annotation{:encoding => "application/x-tex"} H\times G \hookrightarrow G\times G
            composed with) the group multiplication.
          %p
            Simiarly, the right coset space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo \
                  %mi G
                %annotation{:encoding => "application/x-tex"} H\backslash G
            %a.existingWikiWord{:href => "/nlab/show/coequalizes"} coequalizes
            the parallel morphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo ×
                  %mi H
                  %munderover
                    %mo ⇉
                    %mrow
                      %msub
                        %mi proj
                        %mi G
                    %mi μ
                  %mi G
                %annotation{:encoding => "application/x-tex"}
                  G \times H \underoverset{proj_G}{\mu}\rightrightarrows G
          %h3#internal_to_
            Internal to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
          %p
            Specializing the above definition to the case where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is the well-pointed topos
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
            of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                  %mi H
                %annotation{:encoding => "application/x-tex"} g H
            is an element of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/H
            and is called a
            = succeed "." do
              %em left coset
          %p
            Using
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/comprehension"} comprehension
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi g
                  %mi H
                  %mo{:stretchy => "false"} |
                  %mi g
                  %mo ∈
                  %mi G
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"}
                  G/H = \{g H | g \in G\}
          %p
            Similarly there is a coset on the right
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo \
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \backslash G
          %h3#for_lie_groups_and_klein_geometry For Lie groups and Klein geometry
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                  %mo ↪
                  %mi G
                %annotation{:encoding => "application/x-tex"} H \hookrightarrow G
            is an inclusion of
            %a.existingWikiWord{:href => "/nlab/show/Lie+groups"} Lie groups
            then the quotient
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/H
            is also called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Klein+geometry"} Klein geometry
          %h3#ForInfinityGroups
            For
            = succeed "-groups" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            More generally, given an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi H
                %annotation{:encoding => "application/x-tex"} \mathbf{H}
            and a
            %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
            objects
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo →
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \to G
            %a.existingWikiWord{:href => "/nlab/show/deloopings"} deloopings
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}H \to \mathbf{B}G
            %a.existingWikiWord{:href => "/nlab/show/homotopy+quotient"} homotopy quotient
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/H
            is given by the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
            of this map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                        %mtd
                          %mo ⟶
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi H
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  G/H &amp;\longrightarrow&amp; \mathbf{B}H
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; \mathbf{B}G
                  }
                  \\,.
          %p
            See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
            for more on this definition. See at
            %em
              %a.existingWikiWord{:href => "/nlab/show/higher+Klein+geometry"} higher Klein geometry
            and
            %em
              %a.existingWikiWord{:href => "/nlab/show/higher+Cartan+geometry"} higher Cartan geometry
            for the corresponding concepts of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/higher+geometry"} higher geometry
          %h2#properties Properties
          %h3#for_normal_subgroups For normal subgroups
          %p
            The coset inherits the structure of a group if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi H
                %annotation{:encoding => "application/x-tex"} H
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/normal+subgroup"} normal subgroup
          %p
            Unless
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is abelian, considering both left and right coset spaces provide different information.
          %h3#QuotientMaps Topology of the quotient map
          #QuotientProjectionForCompactLieGroupActingFreelyOnManifoldIsPrincipa.num_prop
            %h6#proposition Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/free+action"} free
              smooth
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⟶
                    %mi X
                    %mo{:stretchy => "false"} /
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    X \longrightarrow X/G
            %p
              is a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              (hence in particular a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
          %p
            This is originally due to (
            %a{:href => "#Gleason50"}> Gleason 50
            ). See e.g. (
            %a{:href => "#Cohen"}> Cohen, theorem 1.3
            )
          #QuotientProjectionForCompactLieSubgroupIsPrincipal.num_cor
            %h6#corollary Corollary
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              %a.existingWikiWord{:href => "/nlab/show/coset"} coset
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ⟶
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    G \longrightarrow G/H
            %p
              is an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              (hence in particular a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
          %p
            This is originally due to (
            %a{:href => "#Samelson41"}> Samelson 41
            ).
          #ProjectionOfCosetsIsFiberBundleForClosedSubgroupsOfCompactLieGroup.num_prop
            %h6#proposition_2 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              a
              %a.existingWikiWord{:href => "/nlab/show/compact+Lie+group"} compact Lie group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo ⊂
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} K \subset H \subset G
              %a.existingWikiWord{:href => "/nlab/show/closed+subspace"} closed
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              %a.existingWikiWord{:href => "/nlab/show/projection"} projection
              map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi K
                    %mo ⟶
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"}
                    p \;\colon\; G/K \longrightarrow G/H
            %p
              is a locally trivial
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} /
                      %mi K
                    %annotation{:encoding => "application/x-tex"} H/K
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              (hence in particular a
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
          .proof
            %h6#proof Proof
            %p Observe that the projection map in question is equivalently
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %msub
                      %mo ×
                      %mi H
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo{:stretchy => "false"} /
                    %mi K
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    G \times_H (H/K) \longrightarrow G/H
                    \\,,
            %p
              (where on the left we form the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              and then divide out the
              %a.existingWikiWord{:href => "/nlab/show/diagonal+action"} diagonal action
              by
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                      %mo{:stretchy => "false"} /
                      %mi K
                    %annotation{:encoding => "application/x-tex"} H/K
              %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              to the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              of corollary
              = succeed "." do
                %a.maruku-ref{:href => "#QuotientProjectionForCompactLieSubgroupIsPrincipal"}
          %p
          #CosetSpaceCoprojectionsWithLocalSections.num_prop
            %h6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/coset+space+coprojections+with+local+sections"}> coset space coprojections with local sections
                )
              %br/
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⊂
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \subset G
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            %p
              Sufficient conditions for the
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mover
                      %mo →
                      %mi q
                    %mi G
                    %mo{:stretchy => "false"} /
                    %mi H
                  %annotation{:encoding => "application/x-tex"} G \overset{q}{\to} G/H
              to admit
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/local+sections"} local sections
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
