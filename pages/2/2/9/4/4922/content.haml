            %p
          %h3#as_a_homotopy_fiber As a homotopy fiber
          %p
          #InGeometricHomotopyTheory.num_remark
            %h6 Remark
            %p
              In
              %a.existingWikiWord{:href => "/nlab/show/geometric+homotopy+theory"} geometric homotopy theory
              (in an
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-topos"} (∞,1)-topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %mo ⟶
                    %mi G
                  %annotation{:encoding => "application/x-tex"} H \longrightarrow G
              any homomorphisms of
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-group"} ∞-group
              objects, then the natural projection
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ⟶
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G \longrightarrow G/H
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              as an
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/principal+%E2%88%9E-bundle"} principal ∞-bundle
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo{:stretchy => "false"} /
                      %mi H
                    %annotation{:encoding => "application/x-tex"} G/H
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                          %mtd
                            %mo ⟶
                          %mtd
                            %mo *
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi H
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G &amp; \longrightarrow &amp;*
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    G/H &amp;\longrightarrow&amp; \mathbf{B}H
                    }
                    \\,.
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}H
              is the
              %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping groupoid
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi H
                    %annotation{:encoding => "application/x-tex"} H
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-action"} ∞-action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              (see there for more).
            %p
              By the reverse
              %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
              for
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullbacks"} homotopy pullbacks
              (
              %a{:href => "pasting+law+for+pullbacks#ReversePastingLawForInfinityGroupoids"}> here
              , using that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                    %mo →
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi H
                  %annotation{:encoding => "application/x-tex"} \ast \to \mathbf{B}H
              is an
              %a{:href => "effective+epimorphism+in+an+infinity1-category"} effective epimorphism
              by definition of
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/homotopy+pullback"} homotopy pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi G
                            %mo{:stretchy => "false"} /
                            %mi H
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi H
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mo *
                          %mtd
                            %mo ⟶
                          %mtd
                            %mstyle{:mathvariant => "bold"}
                              %mi B
                            %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    G/H &amp; \longrightarrow &amp;\mathbf{B}H
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    * &amp; \longrightarrow &amp; \mathbf{B}G
                    }
            %p
              which exhibits the coset as the
              %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber"} homotopy fiber
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi H
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi B
                      %mi G
                    %annotation{:encoding => "application/x-tex"} \mathbf{B}H \to \mathbf{B}G
            %p
              See also
              = succeed "." do
                %a{:href => "#SatiSchreiber21"} SS21, Ex. 3.2.35
          %h2#examples Examples
          %h3#spheres
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            \-Spheres
          #nSphereAsCosetSpace.num_example
            %h6#example Example
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/n-spheres"} n-spheres
              are coset spaces of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+groups"} orthogonal groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi n
                    %mo ≃
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S^n \simeq O(n+1)/O(n)
                    \\,.
            %p
              The odd-dimensional spheres are also coset spaces of
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/unitary+groups"} unitary groups
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                    %mo ≃
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    S^{2n+1}
                    \\simeq
                    U(n+1)/U(n)
          .proof
            %h6#proof_2 Proof
            %p Regarding the first statement:
            %p
              Fix a
              %a.existingWikiWord{:href => "/nlab/show/unit+vector"} unit vector
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
              %a.existingWikiWord{:href => "/nlab/show/orbit"} orbit
              under the defining
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n+1)
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{n+1}
              is clearly the canonical embedding
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                      %mo ↪
                      %msup
                        %mi ℝ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} S^n \hookrightarrow \mathbb{R}^{n+1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(n+1)
              that consists of rotations around the axis formed by that unit vector
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+group"} stabilizes
              it, and that subgroup is isomorphic to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} O(n)
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi n
                      %mo ≃
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo +
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^n \simeq O(n+1)/O(n)
            %p The second statement follows by the same kind of reasoning:
            %p
              Clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(n+1)
              %a.existingWikiWord{:href => "/nlab/show/transitive+action"} acts transitively
              on the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mrow
                        %mn 2
                        %mi n
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} S^{2n+1}
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℂ
                        %mrow
                          %mi n
                          %mo +
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}^{n+1}
              %a.existingWikiWord{:href => "/nlab/show/stabilizer+subgroup"} stabilizer subgroup
              of any point on this sphere is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} U(n)
              %a.existingWikiWord{:href => "/nlab/show/coordinates"} coordinates
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mn 0
                    %mo ,
                    %mn 0
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,0, 0, \cdots,0)
              and regard elements of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U(n+1)
              as
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
            .maruku-equation
