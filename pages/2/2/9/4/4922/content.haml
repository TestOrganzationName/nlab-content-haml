          %p
            %br/
          %h3#QuotientMapsOfCosetSpaces Sequences of coset spaces
          %p
            Consider
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                  %mo ↪
                  %mi H
                  %mo ↪
                  %mi G
                %annotation{:encoding => "application/x-tex"} K \hookrightarrow H \hookrightarrow G
            two consecutive group inclusions with their induced coset
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            %a.existingWikiWord{:href => "/nlab/show/projections"} projections
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi H
                          %mo{:stretchy => "false"} /
                          %mi K
                        %mtd
                          %mo ⟶
                        %mtd
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi K
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi G
                          %mo{:stretchy => "false"} /
                          %mi H
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  H/K &amp; \longrightarrow&amp;  G/K
                  \\\
                  \&amp;&amp; \downarrow
                  \\\
                  \&amp;&amp; G/H
                  }
                  \\,.
          %p
            When
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo →
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                %annotation{:encoding => "application/x-tex"} G/K \to G/H
            is a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
            %a.maruku-ref{:href => "#ProjectionOfCosetsIsFiberBundleForClosedSubgroupsOfCompactLieGroup"}
            (so that this is indeed a
            %a.existingWikiWord{:href => "/nlab/show/homotopy+fiber+sequence"} homotopy fiber sequence
            with respect to the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/classical+model+structure+on+topological+spaces"} classical model structure on topological spaces
            %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ⋯
                  %mo →
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi π
                    %mi n
                  %mo{:stretchy => "false"} (
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi H
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msub
                    %mi π
                    %mrow
                      %mi n
                      %mo −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi H
                  %mo{:stretchy => "false"} /
                  %mi K
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi ⋯
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\cdots
                  \\to
                  \\pi_{n+1}(G/H)
                  \\longrightarrow
                  \\pi_n(H/K) \longrightarrow \pi_n(G/K) \longrightarrow \pi_n(G/H)
                  \\longrightarrow
                  \\pi_{n-1}(H/K)
                  \\to \cdots
                  \\,.
          #CofiberSequencesOfCosetsOfOrthogonalGroups.num_example
            %h6#example_2 Example
            %p
              Consider a sequence of inclusions of
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+groups"} orthogonal groups
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ↪
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    O(n) \hookrightarrow O(n+1) \hookrightarrow O(n+k)
                    \\,.
            %p
              Then by example
              %a.maruku-ref{:href => "#nSphereAsCosetSpace"}
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi S
                      %mi n
                  %annotation{:encoding => "application/x-tex"} O(n+1)/O(n) \simeq S^n
              is the
              %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
              and by corollary
              %a.maruku-ref{:href => "#QuotientProjectionForCompactLieSubgroupIsPrincipal"}
              the quotient map is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %a.existingWikiWord{:href => "/nlab/show/long+exact+sequence+of+homotopy+groups"} long exact sequence of homotopy groups
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⟶
                    %msub
                      %mi π
                      %mrow
                        %mi q
                        %mo −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots
                    \\to
                    \\pi_q(S^n)
                    \\longrightarrow \pi_q(O(n+k)/O(n)) \longrightarrow \pi_q(O(n+k)/O(n+1))
                    \\longrightarrow
                    \\pi_{q-1}(S^n)
                    \\to \cdots
                    \\,.
            %p
              Now for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi q
                    %mo &lt;
                    %mi n
                  %annotation{:encoding => "application/x-tex"} q \lt n
              then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi q
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \pi_q(S^n) = 0
              and hence in this range we have
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo &lt;
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi π
                      %mrow
                        %mo •
                        %mo &lt;
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_{\bullet \lt n}(O(n+k)/O(n))
                    \\stackrel{\simeq}{\longrightarrow}
                    \\pi_{\bullet \lt n}(O(n+k)/O(n+1))
                    \\,.
