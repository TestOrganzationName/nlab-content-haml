          %h2#definition Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %msub
                    %mi d
                    %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,d_C)
            be a dg-
            %a.existingWikiWord{:href => "/nlab/show/coalgebra"} coalgebra
            with comultiplication
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                %annotation{:encoding => "application/x-tex"} \Delta
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %msub
                    %mi d
                    %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (A,d_A)
            a
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            with multiplication
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi μ
                  %annotation{:encoding => "application/x-tex"} \mu
            %strong twisting cochain
            is a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo :
                  %mi C
                  %mo →
                  %mi A
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \tau:C\to A[1]
            such that the following
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+equation"} Maurer-Cartan equation
            in the
            %a.existingWikiWord{:href => "/nlab/show/convolution+algebra"} convolution algebra
            holds:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mi A
                  %mo ∘
                  %mi τ
                  %mo +
                  %mi τ
                  %mo ∘
                  %msub
                    %mi d
                    %mi C
                  %mo +
                  %mi μ
                  %mo ∘
                  %mo{:stretchy => "false"} (
                  %mi τ
                  %mo ⊗
                  %mi τ
                  %mo{:stretchy => "false"} )
                  %mo ∘
                  %mi Δ
                  %mo =
                  %mn 0
                  %mo .
                %annotation{:encoding => "application/x-tex"} d_A\circ\tau+\tau\circ d_C+\mu\circ(\tau\otimes\tau)\circ\Delta = 0.
          %p
            Notice that the last, perturbation term describes the square
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo ⋆
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau\star\tau
            in the
            %a.existingWikiWord{:href => "/nlab/show/convolution"} convolution
            algebra of homogeneous maps in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi{:mathvariant => "normal"} Hom
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathrm{Hom}(C,A)
          %h2#relation_to_the_adjunction_barcobar Relation to the adjunction bar-cobar
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Cogc
                %annotation{:encoding => "application/x-tex"} \mathrm{Cogc}
            be the category of cocomplete dg-co(al)gebras and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Alg
                %annotation{:encoding => "application/x-tex"} \mathrm{Alg}
            the category of dg-algebras. There is a
            %a.existingWikiWord{:href => "/nlab/show/bar+and+cobar+construction"} bar-construction
            functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo :
                  %mi{:mathvariant => "normal"} Alg
                  %mo →
                  %mi{:mathvariant => "normal"} Cogc
                %annotation{:encoding => "application/x-tex"} B :\mathrm{Alg}\to\mathrm{Cogc}
            which is a
            %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} right adjoint
            to the
            %a.existingWikiWord{:href => "/nlab/show/bar+and+cobar+construction"} cobar-construction
            functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ω
                    %mo :
                    %mi{:mathvariant => "normal"} Cogc
                    %mo →
                    %mi{:mathvariant => "normal"} Alg
                  %annotation{:encoding => "application/x-tex"} \Omega:\mathrm{Cogc}\to\mathrm{Alg}
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ∈
                    %mi{:mathvariant => "normal"} Cogc
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi B
                    %mi A
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} f\in\mathrm{Cogc}(C,B A)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi f
                %annotation{:encoding => "application/x-tex"} \tau_f
            by postcomposing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi C
                  %mo →
                  %mi B
                  %mi A
                %annotation{:encoding => "application/x-tex"} f: C\to B A
            by the natural projection
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi A
                    %mo →
                    %mi A
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} B A\to A[1]
            %a.existingWikiWord{:href => "/nlab/show/Maurer-Cartan+equation"} Maurer-Cartan equation
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi f
                %annotation{:encoding => "application/x-tex"} \tau_f
            translates to saying that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is a chain map,
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mrow
                        %mi B
                        %mi A
                    %mo ∘
                    %mi f
                    %mo =
                    %mi f
                    %mo ∘
                    %msub
                      %mi d
                      %mi C
                  %annotation{:encoding => "application/x-tex"} d_{B A}\circ f = f\circ d_C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi f
                %annotation{:encoding => "application/x-tex"} \tau_f
            by the composition of the evident canonical map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 0
                  %mo :
                  %mi Ω
                  %mi C
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \tau_0:\Omega C\to C[-1]
            (called the
            = succeed ")" do
              %em canonical twisting cochain
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi f
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \tau_f[-1]:C[-1]\to A
            to obtain a morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                    %mo :
                    %mi Ω
                    %mi C
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} f':\Omega C\to A
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                %annotation{:encoding => "application/x-tex"} \tau
            is equivalent also to saying that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo ′
                %annotation{:encoding => "application/x-tex"} f'
            is a chain map, i.e.
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi A
                    %mo ∘
                    %mi f
                    %mo ′
                    %mo =
                    %mi f
                    %mo ′
                    %mo ∘
                    %msub
                      %mi d
                      %mrow
                        %mi Ω
                        %mi C
                  %annotation{:encoding => "application/x-tex"} d_A\circ f'=f'\circ d_{\Omega C}
          %h2#some_usages_of_twisting_cochains Some usages of twisting cochains
          %p
            A twisting cochain is a datum used to define the
            %a.existingWikiWord{:href => "/nlab/show/twisted+tensor+product"} twisted tensor product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                  %msub
                    %mo ⊗
                    %mi τ
                  %mi M
                %annotation{:encoding => "application/x-tex"} L\otimes_\tau M
            for any right
            = succeed "-co" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi L
                %annotation{:encoding => "application/x-tex"} L
            and any left
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %a.existingWikiWord{:href => "/nlab/show/twisted+module+of+homomorphisms"} twisted module of homomorphisms
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi{:mathvariant => "normal"} Hom
                    %mi τ
                  %mo{:stretchy => "false"} (
                  %mi N
                  %mo ,
                  %mi P
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathrm{Hom}_\tau(N,P)
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is a left
            = succeed "-dg-comodule" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            a left
            = succeed "-dg-module." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
          %p
            B. Keller and his student Kenji Lefèvre-Hasegawa have shown that
            %a.existingWikiWord{:href => "/nlab/show/Koszul+duality"} Koszul duality
            is closely related to twisting cochains. Given a twisting cochain
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                  %annotation{:encoding => "application/x-tex"} \tau
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor"} adjoint functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mi τ
                  %mi A
                %annotation{:encoding => "application/x-tex"} \otimes_\tau A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mi τ
                  %mi C
                %annotation{:encoding => "application/x-tex"} \otimes_\tau C
            between the
            %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived category
            of modules over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and the coderived category of comodules over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} Cogc
                %annotation{:encoding => "application/x-tex"} \mathrm{Cogc}
            and the coderived category is just the localization of the category of complexes of comodules at the class of
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/weak+equivalence"} weak equivalence
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/quasi-isomorphism"} quasi-isomorphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi τ
                        %mn 0
                  %mi Ω
                  %mi C
                %annotation{:encoding => "application/x-tex"} \otimes_{\tau_0}\Omega C
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mn 0
                  %mo :
                  %mi Ω
                  %mi C
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \tau_0:\Omega C\to C[-1]
            is the canonical twisting cochain). This pair of adjoint functors is an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
            iff the composition
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mi C
                  %mo →
                  %mi C
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Omega C\to C[-1]
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi τ
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mi C
                  %mo{:stretchy => "false"} [
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \tau[-1]:C[-1]\to A
            (compare reasoning above) is a quasi-isomorphism. This can also be expressed by saying that the canonical map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                  %msub
                    %mo ⊗
                    %mi τ
                  %mi C
                  %msub
                    %mo ⊗
                    %mi τ
                  %mi A
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"}
                  A\otimes_\tau C\otimes_\tau A\to A
          %p
            is a quasiisomorphism. In that case, Keller calls the triple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo ,
                  %mi A
                  %mo ,
                  %mi τ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (C,A,\tau)
            the
            = succeed "." do
              %em Koszul–Moore triple
            = succeed ")" do
              %a{:href => "http://people.math.jussieu.fr/~keller/lefevre/TheseFinale/tel-00007761.pdf"} pdf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            determines
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            up to a weak equivalence (defined above) and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            determines
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            up to a quasi-isomorphism. Moreover,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi H
                    %mo *
                  %mi C
                  %mo =
                  %msubsup
                    %mi{:mathvariant => "normal"} Tor
                    %mo *
                    %mi A
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "1em"}
                  %mtext and
                  %mspace{:width => "1em"}
                  %msup
                    %mi H
                    %mo *
                  %mi A
                  %mo =
                  %msub
                    %mi{:mathvariant => "normal"} Ext
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo ,
                  %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} H_* C = \mathrm{Tor}^A_*(k,k)\quad \text{and}\quad H^* A = \mathrm{Ext}_C(k,k)
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/ground+field"} ground field
          %h2#alternative_guises Alternative guises
          %p The work of O’Brian, Toledo, and Tong throughout the 70s and 80s focused on a Čech version of twisting cochains, using them as a tool to circumvent the non-existence of global resolutions of coherent analytic sheaves by vector bundles in the holomorphic setting. The definition of a twisting cochain in this sense is related to the one above, but not obviously the same. For them, a twisting cochain is a Maurer–Cartan element in some Čech bicomplex given by the endomorphism algebra of a graded vector bundle.
          %p
            The definition by Bondal and Kapranov (
            %a{:href => "#BK91"}> BK91
            ) of a
            %em twisted complex
            turns out to be a generalisation of the O’Brian–Toledo–Tong notion. They show that, given an arbitrary (not necessarily pretriangulated) dg-category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                  %mo ′
                %annotation{:encoding => "application/x-tex"} \mathcal{A}'
            that contains it and in which there exist shifts and functorial cones is exactly the category of twisted complexes in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒜
                %annotation{:encoding => "application/x-tex"} \mathcal{A}
            is actually pretriangulated then this embedding is a quasi-equivalence (thus allowing us to pull back the shifts and cones, which give a triangulated structure on the homotopy category of
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒜
                  %annotation{:encoding => "application/x-tex"} \mathcal{A}
          %p
            For a history and exposition of this side of the twisting cochain story, see e.g. (
            %a{:href => "#H20"}> Hosgood, §G
            ).
          %h2#remarks Remarks
          %p John C. Moore was one of the people who studied the subject of ‘differential coalgebra’, including twisting cochains, in the 1960s and 1970s and gave a survey of the area during his ICM address.
          %p There are variants of the notion of twisting cochain in a variety of other contexts.
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/twisting+function"} twisting function
            is an analogue of a twisting cochain in the context of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
          %p
            Apart from original usage for the algebraic models for fibrations, twisting cochains and variants are used in
            %a.existingWikiWord{:href => "/nlab/show/homological+perturbation+theory"} homological perturbation theory
            (sometimes abbreviated HPT), rational homotopy theory, deformation theory, study of
            = succeed "-categories," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_\infty
          %p
            An old query archived
            = succeed "." do
              %a{:href => "http://www.math.ntnu.no/~stacey/Mathforge/nForum/comments.php?DiscussionID=3399&Focus=27888#Comment_27888"} here
          %h2#references References
          %ul
            %li
              %p Edgar H. Brown Jr. Twisted tensor products. I. Ann. of Math. (2) 69 (1959) 223–246.
            %li
              %p
                Kenji Lefèvre-Hasegawa, Sur les A-infini catégories, (
                %a{:href => "http://people.math.jussieu.fr/~keller/lefevre/TheseFinale/tel-00007761.pdf"}> pdf
                )
            %li
              %p V. A. Smirnov, Simplicial and operad methods in algebraic topology, Transl. Math. Monogr. 198, AMS 2001 (transl. by G. L. Rybnikov)
            %li
              %p D. Barnes and L. A. Lambe, A Fixed Point Approach to Homological Perturbation Theory, with Don Barnes, Proc. AMS, 112 (1991), 881–892.
            %li
              %p
                K. Hess, The cobar construction: a modern perspective (
                %a{:href => "http://sma.epfl.ch/~hessbell/Minicourse_Louvain_Notes.pdf"}> pdf
                ) (lecture notes from a minicourse at Louvain)
            %li
              %p
                Alexander I. Efimov, Valery A. Lunts, Dmitri O. Orlov, Deformation theory of objects in homotopy and derived categories,
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/math/0702838"} part 1
                = succeed "," do
                  %a{:href => "http://arxiv.org/abs/math/0702839"} part 2
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0702840"} part 3
            %li
              %p N. R. O’Brian, Geometry of twisting cochains. Compositio Math. 63 (1987), no. 1, 41–62.
            %li
              %p
                D. Toledo, Yue Lin L. Tong,
                %em Duality and intersection theory in complex manifolds. I.
                Math. Ann.
                %strong 237
                (1978), no. 1, 41–77; II. The holomorphic Lefschetz formula. Ann. of Math. (2)
                %strong 108
                (1978), no. 3, 519–538.
            %li#BK91
              %p
                A. I. Bondal, M. M. Kapranov, “Enhanced Triangulated Categories”,
                %em Math. USSR Sbornik
                %strong 70
                (1991),
                %a{:href => "https://ncatlab.org/nlab/files/bondalKaprEnhTRiangCat.pdf"} pdf
            %li#H20
              %p
                T. Hosgood, “Chern classes of coherent analytic sheaves: a simplicial approach”, PhD thesis (2020),
                %a{:href => "https://theses.hal.science/tel-02882140"} HAL:tel-02882140
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Henri+Gillet"}> Henri Gillet
                , The
                = succeed "-theory" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
                = succeed "-theory" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi K
                      %annotation{:encoding => "application/x-tex"} K
            %li
              %p
                Richard M. Hain,
                = succeed "," do
                  %em Twisted cochains and duality between minimal algebras and minimal Lie algebras
                = succeed "," do
                  %strong 277
