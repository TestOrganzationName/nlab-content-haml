          %title Twisting cochains
          %h1#twisting_cochains Twisting cochains
          .maruku_toc
            %ul
              %li
                %a{:href => "#definition"} Definition
              %li
                %a{:href => "#relation_to_the_adjunction_barcobar"} Relation to the adjunction bar-cobar
              %li
                %a{:href => "#some_usages_of_twisting_cochains"} Some usages of twisting cochains
