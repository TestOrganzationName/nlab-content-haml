          %h2#statement_and_proof Statement and proof
          %div
            %p
            .num_theorem
              %h6 Theorem
              %p
                Every
                %a.existingWikiWord{:href => "/nlab/show/second-countable+space"} second-countable
                %a.existingWikiWord{:href => "/nlab/show/regular+Hausdorff+space"} regular Hausdorff
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is
                %a.existingWikiWord{:href => "/nlab/show/metrizable+space"} metrizable
          %p
            The
            %strong proof
            can be divided into three parts. Recall that “second-countable” means having a
            %a.existingWikiWord{:href => "/nlab/show/countable+set"} countable
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/topological+base"} base
            %a.existingWikiWord{:href => "/nlab/show/T1"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
            (points are closed), so that “
            %a.existingWikiWord{:href => "/nlab/show/regular+topological+space"}> regular
            ” means “regular
            = succeed "\u201D." do
              %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff
          %ol
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/regular+space"} regular space
                with a
                %a.existingWikiWord{:href => "/nlab/show/countable+set"} countable
                %a.existingWikiWord{:href => "/nlab/show/topological+base"} base
                is
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/normal+space"} normal
            %li
              %p
                A normal space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                is a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/completely+regular+space"} completely regular space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
                and an open set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊆
                      %mi X
                    %annotation{:encoding => "application/x-tex"} U \subseteq X
                containing
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mi X
                      %mo →
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} f: X \to [0, 1]
                such that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} f(x) = 1
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} f(y) = 0
                for
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∉
                        %mi U
                      %annotation{:encoding => "application/x-tex"} y \notin U
            %li
              %p
                A completely regular space
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
                with a countable base can be embedded in the
                %a.existingWikiWord{:href => "/nlab/show/Hilbert+cube"} Hilbert cube
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mn 0
                        %mo ,
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} ]
                          %mi ℕ
                      %annotation{:encoding => "application/x-tex"} [0, 1]^\mathbb{N}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi ℕ
                    %annotation{:encoding => "application/x-tex"} [0, 1]^\mathbb{N}
                is metrizable, so is
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
          %p
            The second assertion being proved at
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Urysohn+lemma"} Urysohn lemma
          .num_prop
            %h6#proposition Proposition
            %p
              A regular space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with a countable base is normal.
          .proof
            %h6#proof Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ,
                    %mi B
                  %annotation{:encoding => "application/x-tex"} A, B
              be disjoint
              %a.existingWikiWord{:href => "/nlab/show/closed+sets"} closed sets
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/open+sets"} open sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∩
                    %mi A
                  %annotation{:encoding => "application/x-tex"} U \cap A
              is inhabited and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo ¯
                    %mo ∩
                    %mi B
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} \widebar{U} \cap B = \emptyset
              is, by regularity, an open covering of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mn 1
                      %mo ,
                      %msub
                        %mi U
                        %mn 2
                      %mo ,
                      %mi …
                    %annotation{:encoding => "application/x-tex"} U_1, U_2, \ldots
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mn 1
                    %mo ,
                    %msub
                      %mi V
                      %mn 2
                    %mo ,
                    %mi …
                  %annotation{:encoding => "application/x-tex"} V_1, V_2, \ldots
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mrow
                          %msub
                            %mi V
                            %mi k
                        %mo ¯
                      %mo ∩
                      %mi A
                      %mo =
                      %mi ∅
                    %annotation{:encoding => "application/x-tex"} \widebar{V_k} \cap A = \emptyset
            %p
              Now form open sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi n
                    %mo ≔
                    %msub
                      %mi U
                      %mi n
                    %mo ∩
                    %msubsup
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                      %mrow
                        %mi k
                        %mo =
                        %mn 1
                      %mi n
                    %mo ¬
                    %mover
                      %mrow
                        %msub
                          %mi V
                          %mi k
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} Y_n \coloneqq U_n \cap \bigcap_{k=1}^n \neg \widebar{V_k}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi Z
                        %mi n
                      %mo =
                      %msub
                        %mi V
                        %mi n
                      %mo ∩
                      %msubsup
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋂
                        %mrow
                          %mi k
                          %mo =
                          %mn 1
                        %mi n
                      %mo ¬
                      %mover
                        %mrow
                          %msub
                            %mi U
                            %mi k
                        %mo ¯
                    %annotation{:encoding => "application/x-tex"} Z_n = V_n \cap \bigcap_{k=1}^n \neg \widebar{U_k}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Y_n
              cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} Z_n
              cover
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi m
                    %mo ∩
                    %msub
                      %mi Z
                      %mi n
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} Y_m \cap Z_n = \emptyset
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ,
                      %mi n
                    %annotation{:encoding => "application/x-tex"} m, n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo ≥
                    %mi n
                  %annotation{:encoding => "application/x-tex"} m \geq n
              say, then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Y
                      %mi m
                    %mo ∩
                    %msub
                      %mi Z
                      %mi n
                    %mo ⊆
                    %msub
                      %mi Y
                      %mi m
                    %mo ∩
                    %msub
                      %mi V
                      %mi n
                    %mo ⊆
                    %msub
                      %mi Y
                      %mi m
                    %mo ∩
                    %mover
                      %mrow
                        %msub
                          %mi V
                          %mi n
                      %mo ¯
                    %mo ⊆
                    %msub
                      %mi U
                      %mi m
                    %mo ∩
                    %mo ¬
                    %mover
                      %mrow
                        %msub
                          %mi V
                          %mi n
                      %mo ¯
                    %mo ∩
                    %mover
                      %mrow
                        %msub
                          %mi V
                          %mi n
                      %mo ¯
                    %mo =
                    %mi ∅
                    %mo .
                  %annotation{:encoding => "application/x-tex"} Y_m \cap Z_n \subseteq Y_m \cap V_n \subseteq Y_m \cap \widebar{V_n} \subseteq U_m \cap \neg \widebar{V_n} \cap \widebar{V_n} = \emptyset.
            %p
              It follows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mi m
                    %msub
                      %mi Y
                      %mi m
                  %annotation{:encoding => "application/x-tex"} \bigcup_m Y_m
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ⋃
                      %mi n
                    %msub
                      %mi Z
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \bigcup_n Z_n
              are disjoint open sets containing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
          .num_prop
            %h6#proposition_2 Proposition
            %p
              A completely regular space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with countable base can be embedded in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo ,
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi ℕ
                    %annotation{:encoding => "application/x-tex"} [0, 1]^\mathbb{N}
          .proof
            %h6#proof_2 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              has a countable base
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi ℬ
                    %mo ×
                    %mi ℬ
                    %mo :
                    %mover
                      %mi U
                      %mo ¯
                    %mo ⊆
                    %mi V
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S = \{(U, V) \in \mathcal{B} \times \mathcal{B}: \widebar{U} \subseteq V\}
              is countable. For each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s = (U, V) \in S
              there is by the Urysohn lemma a continuous map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi s
                    %mo :
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} g_s: X \to [0, 1]
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi s
                  %annotation{:encoding => "application/x-tex"} g_s
              is identically
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi U
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \widebar{U}
              and identically
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mi V
                    %annotation{:encoding => "application/x-tex"} \neg V
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi X
                    %mo →
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi S
                    %mo :
                    %mi x
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi s
                    %mo ↦
                    %msub
                      %mi g
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g: X \to [0,1]^S: x \mapsto (s \mapsto g_s(x))
            %p
              is a continuous injection, since if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ≠
                      %mi y
                    %annotation{:encoding => "application/x-tex"} x \neq y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s = (U, V) \in S
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi U
                  %annotation{:encoding => "application/x-tex"} x \in U
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi y
                      %mo ∉
                      %mi V
                    %annotation{:encoding => "application/x-tex"} y \notin V
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} g_s(x) = 1
              differs from
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} g_s(y) = 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mi g
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} g(x) \neq g(y)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              induced from the monomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                  %annotation{:encoding => "application/x-tex"} g
              is contained in the given topology of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                    %annotation{:encoding => "application/x-tex"} g
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is an open neighborhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo ∈
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} V \in \mathcal{B}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi U
                    %mo ,
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi S
                  %annotation{:encoding => "application/x-tex"} s  = (U, V) \in S
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi s
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} g_s(x) = 1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi g
                      %mi s
                  %annotation{:encoding => "application/x-tex"} g_s
              is identically
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
              outside
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                      %mo −
                      %msub
                        %mi g
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} g_s(x) - g_s(y) \lt 1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi g
                        %mi s
                      %mo{:stretchy => "false"} (
                      %mi y
                      %mo{:stretchy => "false"} )
                      %mo ≠
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} g_s(y) \neq 0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
