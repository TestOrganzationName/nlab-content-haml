              is in fact open.
          %h3#RelationToInteriorSubspaces Relation to interior subspaces
          #RelationClAndInt.num_lemma
            %h6#lemma_2 Lemma
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              %a.existingWikiWord{:href => "/nlab/show/topological+interior"} topological interior
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Int(S)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              equals the
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
              of the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo \
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(X\backslash S)
              of the complement of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                    %mo \
                    %mi Cl
                    %mrow
                      %mo (
                      %mi X
                      %mo \
                      %mi S
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Int(S)
                    \=
                    X \backslash Cl\left(
                    X \backslash S
                    \\right)
                    \\,.
          .proof
            %h6#proof_4 Proof
            %p
              By taking
              %a.existingWikiWord{:href => "/nlab/show/complements"} complements
              once more, the statement is equivalent to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo \
                    %mi Int
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo \
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    X \backslash Int(S)
                    \=
                    Cl( X \backslash S )
                    \\,.
            %p Now we compute:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi X
                            %mo \
                            %mi Int
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo =
                            %mi X
                            %mo \
                            %mrow
                              %mo (
                              %munder
                                %mo ∪
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mrow
                                      %mi U
                                      %mspace{:width => "thinmathspace"}
                                      %mi open
                                  %mrow
                                    %mrow
                                      %mi U
                                      %mo ⊂
                                      %mi S
                              %mi U
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∩
                              %mrow
                                %mi U
                                %mo ⊂
                                %mi S
                            %mi X
                            %mo \
                            %mi U
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∩
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi C
                                    %mspace{:width => "thinmathspace"}
                                    %mi closed
                                %mrow
                                  %mrow
                                    %mi C
                                    %mo ⊃
                                    %mi X
                                    %mo \
                                    %mi S
                            %mi C
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi Cl
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo \
                            %mi S
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    X \backslash Int(S)
                    \&amp; =
                    X \backslash \left(  \underset{{U \, open} \atop {U \subset S}}{\cup}U \right)
                    \\\
                    \&amp; = \underset{U \subset S}{\cap} X \backslash U
                    \\\
                    \&amp; = \underset{{C\, closed} \atop {C \supset X \backslash S}}{\cap} C
                    \\\
                    \&amp; = Cl(X \backslash S)
                    \\end{aligned}
          %h3#relation_to_compact_subspaces Relation to compact subspaces
          %p
            The relation of closed subspaces to
            %a.existingWikiWord{:href => "/nlab/show/compact+subspaces"} compact subspaces
            is expressed by the following statements
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Heine-Borel+theorem"} Heine-Borel theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets+of+compact+spaces+are+compact"} closed subsets of compact spaces are compact
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/compact+subspaces+of+Hausdorff+spaces+are+closed"} compact subspaces of Hausdorff spaces are closed
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/closed+subspaces+of+compact+Hausdorff+spaces+are+equivalently+compact+subspaces"} closed subspaces of compact Hausdorff spaces are equivalently compact subspaces
          %h3#kuratowskis_closurecomplement_problem Kuratowski’s closure-complement problem
          %p
            This mildly amusing curiosity asks how many set-theoretic operations on a topological space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            are derivable from closure
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and
            %a.existingWikiWord{:href => "/nlab/show/complementation"} complementation
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg
            and applying finite composition. The answer is that at most 14 operations are so derivable (and there are examples showing this number is achievable). As the proofs below indicate, this bare fact has little to do with topology; it has more to do with general Moore closures and how they interact with complements (using
            = succeed ")." do
              %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(X)
            denote the
            %a.existingWikiWord{:href => "/nlab/show/power+set"} power set
            (ordered by
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/subset"} inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            the
            %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            of
            %a.existingWikiWord{:href => "/nlab/show/endofunctions"} endofunctions
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(X) \to P(X)
            with order defined pointwise. Then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mn 2
                  %mo =
                  %mi C
                %annotation{:encoding => "application/x-tex"} C^2 = C
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mo ¬
                    %mn 2
                  %mo =
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \neg^2 = 1
            in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            order-preserving and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ¬
                %annotation{:encoding => "application/x-tex"} \neg
            order-reversing. Also
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ≔
                    %mo ¬
                    %mi C
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} I \coloneqq \neg C \neg
              is the
              %a.existingWikiWord{:href => "/nlab/show/interior"} interior
              operation, with
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mo ≤
                      %mi Id
                    %annotation{:encoding => "application/x-tex"} I \leq Id
          .num_prop
            %h6#proposition_4 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} C \neg C \neg
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/idempotent+element"} idempotent
          .proof
            %h6#proof_5 Proof
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi I
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ¬
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≤
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ¬
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} I (C \neg C) \leq (C \neg C)
              , i.e.,
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                      %mi C
                      %mo ¬
                      %mi C
                      %mo ¬
                      %mi C
                      %mo ≤
                      %mi C
                      %mo ¬
                      %mi C
                    %annotation{:encoding => "application/x-tex"} \neg C \neg C \neg C \leq C \neg C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to both sides together with the fact that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn 2
                      %mo =
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C^2 = C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ≤
                    %mi C
                    %mi C
                    %mo ¬
                    %mi C
                    %mo =
                    %mi C
                    %mo ¬
                    %mi C
                    %mo .
                  %annotation{:encoding => "application/x-tex"} C\neg C \neg C \neg C \leq C C \neg C = C \neg C.
            %p
              Since
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                      %mi C
                      %mo ≤
                      %mi C
                    %annotation{:encoding => "application/x-tex"} I C \leq C
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
