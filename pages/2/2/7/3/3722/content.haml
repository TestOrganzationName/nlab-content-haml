                      %mi C
                    %annotation{:encoding => "application/x-tex"} \neg C \neg C \leq C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ¬
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C \neg C
              to both sides, we obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ¬
                    %mi C
                    %mo =
                    %mi C
                    %mo ¬
                    %mi C
                    %mi C
                    %mo ≤
                    %mi C
                    %mo ¬
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} C \neg C = C \neg C C \leq C \neg C (\neg C \neg C).
            %p
              Combining the two displayed inequalities gives
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ¬
                      %mi C
                      %mo =
                      %mi C
                      %mo ¬
                      %mi C
                      %mo ¬
                      %mi C
                      %mo ¬
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C \neg C = C \neg C \neg C \neg C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ¬
                    %annotation{:encoding => "application/x-tex"} \neg
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              be the monoid presented by two generators
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ,
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} C, \neg
              and subject to the relations
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi C
                        %mn 2
                      %mo =
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C^2 = C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ¬
                        %mn 2
                      %mo =
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} \neg^2 = 1
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ¬
                      %mi C
                      %mo ¬
                      %mi C
                      %mo ¬
                      %mi C
                      %mo =
                      %mi C
                      %mo ¬
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C \neg C \neg C \neg C = C \neg C
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "," do
                %em Kuratowski monoid
          .proof
            %h6#proof_6 Proof
            %p
              We may apply an obvious reduction algorithm on the set of words in two letters
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ,
                      %mo ¬
                    %annotation{:encoding => "application/x-tex"} C, \neg
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C C
              by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and any substring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg\neg
              by an empty substring, so that any word which cannot be further reduced must be alternating in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ,
                      %mo ¬
                    %annotation{:encoding => "application/x-tex"} C, \neg
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo ¬
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi C
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo ¬
                    %mi C
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi C
                    %mo ¬
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} 1, \qquad \neg, \qquad C, \qquad \neg C, \qquad C \neg, \qquad \neg C \neg, \qquad C \neg C,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mo ,
                    %mspace{:width => "2em"}
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                  %annotation{:encoding => "application/x-tex"} \neg C \neg C, \qquad C \neg C \neg, \qquad \neg C \neg C \neg, \qquad C \neg C \neg C, \qquad \neg C \neg C \neg C, \qquad C \neg C \neg C \neg, \qquad \neg C \neg C \neg C \neg
            %p
              with any further alternating words reducible by replacing a substring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                    %mo ¬
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C \neg C \neg C \neg C
              by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ¬
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C \neg C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is represented by one of these 14 words.
          %p
            These 14 words actually name distinct set-theoretic operations
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(X) \to P(X)
            for a judicious choice of space
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            has exactly 14 elements. For instance (courtesy of Wikipedia), taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi ℝ
                %annotation{:encoding => "application/x-tex"} X = \mathbb{R}
            with its standard topology, the orbit of the element
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo ,
                  %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mo{:stretchy => "false"} {
                  %mn 3
                  %mo{:stretchy => "false"} }
                  %mo ∪
                  %mo{:stretchy => "false"} (
                  %mo{:stretchy => "false"} [
                  %mn 4
                  %mo ,
                  %mn 5
                  %mo{:stretchy => "false"} ]
                  %mo ∩
                  %mi ℚ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (0, 1) \cup (1, 2) \cup \{3\} \cup ([4, 5] \cap \mathbb{Q})
            under the monoid action consists of 14 distinct elements.
          .num_remark
            %h6#remark Remark
            %p
              At most 7 operations are possible with interior and closure, corresponding to the covariant Kuratowski operations. Thus there is a 7-element submonoid
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mi cov
                      %mo ↪
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K_{cov} \hookrightarrow K
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              for which the topological action
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi cov
                    %mo →
                    %mi Set
                    %mo{:stretchy => "false"} (
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K_{cov} \to Set(P(X), P(X))
              is
              %em not
              injective are of some structural interest; for instance, the spaces for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mi I
                    %mi C
                    %mo =
                    %mi I
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C I C = I C
              are the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/extremally+disconnected+spaces"} extremally disconnected spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mi C
                    %mo =
                    %mi C
                  %annotation{:encoding => "application/x-tex"} I C = C
              are those where the open sets are equivalence classes for some equivalence relation (partition spaces). Those for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mi C
                  %annotation{:encoding => "application/x-tex"} I = C
              are
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/discrete+spaces"} discrete spaces
          .num_remark
            %h6#remark_2 Remark
            %p
              A more manifestly topological consideration is what happens when we throw
              %a.existingWikiWord{:href => "/nlab/show/joins"} joins
              (or
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/meets"} meets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ,
                    %mi C
                  %annotation{:encoding => "application/x-tex"} I, C
              mix. Briefly, at most 13 subsets can be obtained by starting with a subset
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                    %mo ∈
                    %mi P
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} A \in P(X)
              and generating new subsets by taking closures, interiors, and unions; the order structure of these 13 subsets coincides with the free cocompletion of the finite ordered monoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mi cov
                  %annotation{:encoding => "application/x-tex"} K_{cov}
              with respect to nonempty joins. Here we must use distributivity of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              over joins.
          %p
            For some details on these remarks (and quite a bit more), see
            %a{:href => "http://nzjm.math.auckland.ac.nz/images/6/63/The_Kuratowski_Closure-Complement_Theorem.pdf"} Gardner and Jackson, 2008
            and
            = succeed "." do
              %a{:href => "http://people.virginia.edu/~des5e/papers/14-sets.pdf"} Sherman 2004
            = succeed "." do
              %a{:href => "http://math.stackexchange.com/a/1912101/43208"} here
          %h2#generalizations Generalizations
          %h3#locales Locales
          %p
            In
            %a.existingWikiWord{:href => "/nlab/show/locale"} locale
            theory, every open
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in a locale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            defines a closed
            %a.existingWikiWord{:href => "/nlab/show/sublocale"} sublocale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi C
                  %mi U
                %annotation{:encoding => "application/x-tex"} \mathsf{C} U
            which is given by the
            %strong
              closed
              %a.existingWikiWord{:href => "/nlab/show/nucleus"} nucleus
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi C
                      %mi U
                  %mo{:lspace => "verythinmathspace"} :
                  %mi V
                  %mo ↦
                  %mi U
                  %mo ∪
                  %mi V
                  %mo .
                %annotation{:encoding => "application/x-tex"} j_{\mathsf{C} U}\colon V \mapsto U \cup V .
          %p
            The idea is that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi C
                  %mi U
                %annotation{:encoding => "application/x-tex"} \mathsf{C}U
            is the part of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            which does not involve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            (hence the notation
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi C
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \mathsf{C}U
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∪
                  %mi V
                %annotation{:encoding => "application/x-tex"} U \cup V
            when we are looking only away from
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
          %p
            The sublocale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi C
                  %mi U
                %annotation{:encoding => "application/x-tex"} \mathsf{C}U
            is literally a complement of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            in the lattice of sublocales of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∩
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi C
                  %mi U
                  %mo =
                  %mi ∅
                %annotation{:encoding => "application/x-tex"} U\cap \mathsf{C}U = \emptyset
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo ∪
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi C
                  %mi U
                  %mo =
                  %mi X
                %annotation{:encoding => "application/x-tex"} U\cup \mathsf{C}U = X
            as sublocales. Moreover, if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is a (
            %a.existingWikiWord{:href => "/nlab/show/sober+space"}> sober
            ) topological space regarded as a locale, then the locale
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                %annotation{:encoding => "application/x-tex"} U
            is also spatial, and so is
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi C
                    %mi U
                  %annotation{:encoding => "application/x-tex"} \mathsf{C}U
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mi U
                  %annotation{:encoding => "application/x-tex"} X\setminus U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi j
                    %mrow
                      %mstyle{:mathvariant => "sans-serif"}
                        %mi C
                      %mi U
                %annotation{:encoding => "application/x-tex"} j_{\mathsf{C}U}
            can be identified with the open sets containing
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mi U
                  %annotation{:encoding => "application/x-tex"} X\setminus U
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as a space or as a locale (at least as long as
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is sober).
          %h3#constructive_mathematics Constructive mathematics
          %p
            In
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/constructive+mathematics"} constructive mathematics
            %em inequivalent
            definitions of a closed subspace, including:
          %ol
            %li
              A subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C\subset X
              is closed if it is the complement of an open subspace, i.e. if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo =
                    %mi X
                    %mo ∖
                    %mi U
                  %annotation{:encoding => "application/x-tex"} C = X\setminus U
              for some open subspace
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                    %annotation{:encoding => "application/x-tex"} U
            %li
              A subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C\subset X
              is closed if its complement
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X\setminus C
              is open;
            %li
              A subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C\subset X
              is closed if it contains all its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/limit+points"} limit points
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x\in X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∩
                    %mi C
                  %annotation{:encoding => "application/x-tex"} U\cap C
              is
              %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
              for all
              %a.existingWikiWord{:href => "/nlab/show/neighborhoods"} neighborhoods
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} x\in C
          %p
            Definition (1) coincides with definition (2) or (3) only if excluded middle holds, since under (2) or (3) every subspace of a
            %a.existingWikiWord{:href => "/nlab/show/discrete+space"} discrete space
            is closed, while under (1) the only closed subspaces are those that are complements, and if every proposition is a negation then the
            %a.existingWikiWord{:href => "/nlab/show/law+of+double+negation"} law of double negation
            follows. On the other hand, Definition (2) is clearly too strong, because even
            %a.existingWikiWord{:href => "/nlab/show/closed+intervals"} closed intervals
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi a
                  %mo ,
                  %mi b
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [a,b]
            in the
            %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
            can’t be proved constructively to satisfy it (though they do satisfy definitions (1) and (3)). Note also that Definition (1) always implies Definition (3), since if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi X
                  %mo ∖
                  %mi U
                %annotation{:encoding => "application/x-tex"} C = X\setminus U
            and every open neighborhood of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            intersects
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo ∉
                  %mi U
                %annotation{:encoding => "application/x-tex"} x\notin U
            and thus
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} x\in C
          %ul
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C\subset X
              is
              %strong strongly closed
              if it is the complement of an open subspace.
            %li
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C\subset X
              is
              %strong weakly closed
              if it contains all its
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/limit+points"} limit points
          %p
            This constructive variety of notions of closed subspace gives rise to a corresponding variety of notions of
            %a.existingWikiWord{:href => "/nlab/show/Hausdorff+space"} Hausdorff space
            when applied to the diagonal subspace.
          %p Note also that neither of the sensible constructive definitions behaves quite like closed subspaces do classically. In particular, neither of them is apparently stable under finite unions (though the too-strong Definition (2) is). The situation is better for locales; see below.
          %h3#locales_in_constructive_mathematics Locales in constructive mathematics
          %p
            Of the “topological” definitions of closed subspace above, it is “strongly closed” (and the too-strong Definition (2)) that seem closest to the localic one. However, in the topological definitions we may not have
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi U
                  %mo ∪
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ∖
                  %mi U
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X = U \cup (X\setminus U)
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ∖
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo ∪
                  %mi C
                %annotation{:encoding => "application/x-tex"} X = (X\setminus C) \cup C
            even as sets, whereas it remains true constructively that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo =
                  %mi U
                  %mo ∪
                  %mstyle{:mathvariant => "sans-serif"}
                    %mi C
                  %mi U
                %annotation{:encoding => "application/x-tex"} X = U \cup \mathsf{C}U
            in the lattice of sublocales. In fact, we have the following:
          .un_theorem
            %h6#theorem Theorem
            %p The following are equivalent:
            %ol
              %li
                The law of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/excluded+middle"} excluded middle
              %li Every closed sublocale of a spatial locale is spatial.
              %li
                Every closed sublocale of a
                %a.existingWikiWord{:href => "/nlab/show/discrete+locale"} discrete locale
                is spatial.
          .proof
            %h6#proof_7 Proof
            %p
              We remarked above that (1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              (2), and of course (2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo ⇒
                  %annotation{:encoding => "application/x-tex"} \Rightarrow
              (3). So assume (3). Every spatial sublocale is a union of its points, and in a discrete space points are open; thus if closed sublocales are spatial, they are also open. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi U
                    %mo ∪
                    %mstyle{:mathvariant => "sans-serif"}
                      %mi C
                    %mi U
                  %annotation{:encoding => "application/x-tex"} X = U \cup \mathsf{C}U
              is constructively true, it follows that every open set is complemented in the open-set lattice of any discrete locale, which is to say that all powersets are
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Boolean+algebras"} Boolean algebras
          %p
            On the other hand, there is a localic notion of
            %em weakly closed sublocale
            that is closely related to topologically weakly closed subspaces (so that the above notion of “closed sublocale” — the formal complement of an open sublocale — could also be called
            = succeed ")." do
              %em strongly closed
            %span.newWikiWord
              fiberwise closed sublocale
              %a{:href => "/nlab/new/fiberwise+closed+sublocale"} ?
            to locale maps
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo →
                  %mn 1
                %annotation{:encoding => "application/x-tex"} X\to 1
            into the terminal object.
          .un_defn
            %h6#definition_3 Definition
            %p
              A sublocale
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C\subseteq X
              is
              %strong weakly closed
              if it is not
              %a.existingWikiWord{:href => "/nlab/show/strongly+dense+sublocale"} strongly dense
              in any larger sublocale of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is a sublocale of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊆
                    %mi D
                  %annotation{:encoding => "application/x-tex"} C\subseteq D
              by a strongly dense inclusion, then
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo =
                      %mi D
                    %annotation{:encoding => "application/x-tex"} C=D
          %p Since strong and weak denseness coincide classically, so do strong and weak closedness. And as we expect, strong closedness implies weak closedness, since strong density implies weak density. Moreover, both of them are better-behaved than the corresponding topological notions. For instance, strongly and weakly closed sublocales are both stable under finite unions (in the lattice of sublocales), even constructively.
          %p
            Both strongly and weakly closed sublocales are “correct” notions; they are simply different. Some classical theorems about closed sublocales are constructively about strongly closed ones, while others (such as the theorem that any
            %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
            of a
            %a.existingWikiWord{:href => "/nlab/show/localic+group"} localic group
            is closed) are about weakly closed ones.
          %p
            However, as we saw above, not every strongly closed sublocale (hence not every weakly closed sublocale either) can be spatial. But it is shown at
            %a.existingWikiWord{:href => "/nlab/show/strongly+dense+sublocale"} strongly dense sublocale
            that a subspace of a space is localically strongly dense if and only if it is topologically strongly dense. This leads us to guess:
          .un_theorem
            %h6#conjecture Conjecture
            %p
              A subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊆
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C\subseteq X
              of a (sober) topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is topologically weakly closed if and only if it is the spatial coreflection of a weakly closed sublocale.
          %p
            In one direction this is easy: suppose
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is topologically weakly closed, and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            be its localic weak closure. This is, by definition, the largest sublocale of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            in which
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is localically strongly dense. Now let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be the spatial coreflection of
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is spatial we have
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo ⊆
                    %mi E
                  %annotation{:encoding => "application/x-tex"} C\subseteq E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is localically strongly dense in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is also topologically weakly closed, hence
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                  %mi E
                %annotation{:encoding => "application/x-tex"} C=E
            and is the spatial coreflection of the weakly closed sublocale
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          %p The other direction is harder.
