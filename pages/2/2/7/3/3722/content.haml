          #ClosedSubset.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/closed+subsets"}> closed subsets
                )
            %div{:style => "float:right;margin:0 10px 10px 0;"}
              %img{:src => "https://ncatlab.org/nlab/files/ClosedAndOpenSubsets.png", :width => "300"}/
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
            %ol
              %li
                %p
                  A
                  %a.existingWikiWord{:href => "/nlab/show/subset"} subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} S \subset X
                  is called a
                  %em closed subset
                  if its
                  %a.existingWikiWord{:href => "/nlab/show/complement"} complement
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo ∖
                        %mi S
                      %annotation{:encoding => "application/x-tex"} X \setminus S
                  is an
                  = succeed ":" do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/open+subset"} open subset
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo (
                          %mi S
                          %mo ⊂
                          %mi X
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mtext is closed
                          %mo )
                        %mphantom
                          %mi AA
                        %mo ⇔
                        %mphantom
                          %mi AA
                        %mrow
                          %mo (
                          %mi X
                          %mo ∖
                          %mi S
                          %mspace{:width => "thinmathspace"}
                          %mo ⊂
                          %mi X
                          %mspace{:width => "thinmathspace"}
                          %mspace{:width => "thinmathspace"}
                          %mtext is open
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\left(
                        S \subset X\,\, \text{is closed}
                        \\right)
                        \\phantom{AA}
                        \\Leftrightarrow
                        \\phantom{AA}
                        \\left(
                        X\setminus S \, \subset X \,\, \text{is open}
                        \\right)
                        \\,.
                %blockquote
                  %p
                    graphics grabbed from
                    %a{:href => "#Vickers89"} Vickers 89
              %li
                %p
                  If a
                  %a.existingWikiWord{:href => "/nlab/show/singleton"} singleton
                  subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} {
                        %mi x
                        %mo{:stretchy => "false"} }
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} \{x\} \subset X
                  is closed, one says that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                      %annotation{:encoding => "application/x-tex"} x
                  is a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/closed+point"} closed point
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi X
                        %annotation{:encoding => "application/x-tex"} X
              %li
                %p
                  Given any subset
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                          %mo ⊂
                          %mi X
                        %annotation{:encoding => "application/x-tex"} S \subset X
                  %em topological closure
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cl(S)
                  is the smallest closed subset containing
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo ≔
                        %mspace{:width => "thickmathspace"}
                        %munder
                          %mo ∩
                          %mfrac{:linethickness => "0"}
                            %mrow
                              %mrow
                                %mi C
                                %mo ⊂
                                %mi X
                                %mspace{:width => "thinmathspace"}
                                %mtext closed
                            %mrow
                              %mrow
                                %mi S
                                %mo ⊂
                                %mi C
                        %mrow
                          %mo (
                          %mi C
                          %mo )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        Cl(S)
                        \\;\coloneqq\;
                        \\underset{ {C \subset X\, \text{closed}  }   \atop {S \subset C }  }{\cap} \left( C \right)
                        \\,.
              %li
                %p
                  A subset
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⊂
                        %mi X
                      %annotation{:encoding => "application/x-tex"} S \subset X
                  such that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Cl
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi X
                      %annotation{:encoding => "application/x-tex"} Cl(S) = X
                  is called a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/dense+subset"} dense subset
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo ,
                          %mi τ
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (X,\tau)
          %h2#properties Properties
          %h3#basic_properties Basic properties
          .num_prop
            %h6#proposition Proposition
            %p
              %a.existingWikiWord{:href => "/nlab/show/subsets+are+closed+in+a+closed+subspace+precisely+if+they+are+closed+in+the+ambient+space"} subsets are closed in a closed subspace precisely if they are closed in the ambient space
          #UnionOfOpensGivesClosure.num_lemma
            %h6#lemma Lemma
            %p
              %strong (alternative characterization of topological closures)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi τ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,\tau)
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S \subset X
              be a
              %a.existingWikiWord{:href => "/nlab/show/subset"} subset
              of its underlying set. Then a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi X
                  %annotation{:encoding => "application/x-tex"} x \in X
              is contained in the topological closure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cl(S)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClosedSubset"}
              %a.existingWikiWord{:href => "/nlab/show/open+neighbourhood"} open neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mi x
                    %mo ⊂
                    %mi X
                  %annotation{:encoding => "application/x-tex"} U_x \subset X
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersects
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi x
                      %mo ∈
                      %mi Cl
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                      %mo )
                    %mphantom
                      %mi AA
                    %mo ⇔
                    %mphantom
                      %mi AA
                    %mo ¬
                    %mrow
                      %mo (
                      %munder
                        %mo ∃
                        %mfrac{:linethickness => "0"}
                          %mrow
                            %mrow
                              %mi U
                              %mo ⊂
                              %mi X
                              %mo ∖
                              %mi S
                          %mrow
                            %mrow
                              %mi U
                              %mo ⊂
                              %mi X
                              %mspace{:width => "thinmathspace"}
                              %mtext open
                      %mrow
                        %mo (
                        %mi x
                        %mo ∈
                        %mi U
                        %mo )
                      %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    x \in Cl(S)
                    \\right)
                    \\phantom{AA}
                    \\Leftrightarrow
                    \\phantom{AA}
                    \\not\left(
                    \\underset{ {U \subset X \setminus S}  \atop  { U \subset X \, \text{open}  } }{\exists}
                    \\left(
                    x \in U
                    \\right)
                    \\right)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              Due to
              %a.existingWikiWord{:href => "/nlab/show/de+Morgan+duality"} de Morgan duality
              we may rephrase the definition of the
              %a.existingWikiWord{:href => "/nlab/show/topological+closure"} topological closure
              as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Cl
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≔
                            %munder
                              %mo ∩
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi S
                                    %mo ⊂
                                    %mi C
                                %mrow
                                  %mrow
                                    %mi C
                                    %mo ⊂
                                    %mi X
                                    %mspace{:width => "thinmathspace"}
                                    %mtext closed
                            %mrow
                              %mo (
                              %mi C
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %munder
                              %mo ∩
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %mi U
                                    %mo ⊂
                                    %mi X
                                    %mo ∖
                                    %mi S
                                %mrow
                                  %mrow
                                    %mi U
                                    %mo ⊂
                                    %mi X
                                    %mspace{:width => "thinmathspace"}
                                    %mtext open
                            %mrow
                              %mo (
                              %mi X
                              %mo ∖
                              %mi U
                              %mo )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi X
                            %mo ∖
                            %mrow
                              %mo (
                              %munder
                                %mo ∪
                                %mfrac{:linethickness => "0"}
                                  %mrow
                                    %mrow
                                      %mi U
                                      %mo ⊂
                                      %mi X
                                      %mo ∖
                                      %mi S
                                  %mrow
                                    %mrow
                                      %mi U
                                      %mo ⊂
                                      %mi X
                                      %mspace{:width => "thinmathspace"}
                                      %mtext open
                              %mi U
                              %mo )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    Cl(S)
                    \&amp; \coloneqq
                    \\underset{ {S \subset C }  \atop { C \subset X\,\text{closed} } }{\cap}
                    \\left(C \right)
                    \\\
                    \&amp; =
                    \\underset{ { U \subset X \setminus S } \atop {U \subset X\, \text{open}}  }{\cap} \left( X \setminus U \right)
                    \\\
                    \&amp; = X \setminus
                    \\left(
                    \\underset{ {U \subset X \setminus S} \atop { U \subset X\, \text{open} }}{\cup} U
                    \\right)
                    \\end{aligned}
                    \\,.
          #ClosureOfAFiniteUnionIsUnionOfTheClosures.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong (closure of a finite union is the union of the closures)
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              a
              %a.existingWikiWord{:href => "/nlab/show/finite+set"} finite set
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              a finite set of subsets of a topological space, we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Cl(\underset{i \in I}{\cup}U_i)
                    \=
                    \\underset{i \in I}{\cup} Cl(U_i)
                    \\,.
          .proof
            %h6#proof_2 Proof
            %p
              By lemma
              %a.maruku-ref{:href => "#UnionOfOpensGivesClosure"}
              we use that a point is in the closure of a set precisely if every open neighbourhood of the point intersects the set.
            %p Hence in one direction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{i \in I}{\cup} Cl(U_i)
                    \\subset
                    Cl(\underset{i \in I}{\cup}U_i)
            %p
              because if every neighbourhood of a point intersects some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
            %p The other direction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cl(\underset{i \in I}{\cup}U_i)
                    \\subset
                    \\underset{i \in I}{\cup} Cl(U_i)
            %p
              is equivalent by
              %a.existingWikiWord{:href => "/nlab/show/de+Morgan+duality"} de Morgan duality
              to
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∖
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo ⊂
                    %mi X
                    %mo ∖
                    %mi Cl
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo ∪
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    X \setminus
                    \\underset{i \in I}{\cup} Cl(U_i)
                    \\subset
                    X \setminus
                    Cl(\underset{i \in I}{\cup}U_i)
            %p
              On left now we have the point for which there exists for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i \in I
              a neighbourhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ,
                        %mi i
                  %annotation{:encoding => "application/x-tex"} U_{x,i}
              which does not intersect
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                  %annotation{:encoding => "application/x-tex"} I
              is finite, the intersection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo ∩
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                    %msub
                      %mi U
                      %mrow
                        %mi x
                        %mo ,
                        %mi i
                  %annotation{:encoding => "application/x-tex"} \underset{i \in I}{\cap} U_{x,i}
              is still an open neighbourhood of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                    %annotation{:encoding => "application/x-tex"} x
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi U
                        %mi i
                    %annotation{:encoding => "application/x-tex"} U_i
          %h3#InMetricSpaces In metric spaces
          #ConvergenceInClosedSubspace.num_prop
            %h6#proposition_3 Proposition
            %p
              Using
              %a.existingWikiWord{:href => "/nlab/show/classical+logic"} classical logic
              then:
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,d)
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+space"} metric space
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              via its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/metric+topology"} metric topology
