                    %annotation{:encoding => "application/x-tex"} \chi \colon \Gamma \to U(E)
                a
                %a.existingWikiWord{:href => "/nlab/show/unitary+representation"} unitary representation
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Γ
                      %annotation{:encoding => "application/x-tex"} \Gamma
          %p
            Then the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ≔
                  %mi Γ
                  %mo \
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mi K
                %annotation{:encoding => "application/x-tex"}
                  X \coloneqq \Gamma \backslash G / K
          %p
            is a
            %a.existingWikiWord{:href => "/nlab/show/hyperbolic+manifold"} hyperbolic manifold
            of odd
            %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
            with
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            being
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \pi_1(X) \simeq \Gamma
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                %annotation{:encoding => "application/x-tex"} \chi
            is equivalently a
            %a.existingWikiWord{:href => "/nlab/show/flat+vector+bundle"} flat vector bundle
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            Write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Conj
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Conj(\Gamma)
            for the set of
            %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes"} conjugacy classes
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Γ
                %annotation{:encoding => "application/x-tex"} \Gamma
            and write
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Prim
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                  %mo ↪
                  %mi Conj
                  %mo{:stretchy => "false"} (
                  %mi Γ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  Prim(\Gamma) \hookrightarrow Conj(\Gamma)
          %p
            for the
            %a.existingWikiWord{:href => "/nlab/show/subset"} subset
            of elements
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi g
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [g]
            for which
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n_\Gamma(g) = 1
            %a.existingWikiWord{:href => "/nlab/show/fundamental+group"} fundamental group
            as above, these elements correspond to paths which are
            %a.existingWikiWord{:href => "/nlab/show/prime+geodesics"} prime geodesics
            in
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            %strong Definition
          %p
            The
            %em Selberg zeta function
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi χ
                %annotation{:encoding => "application/x-tex"} \zeta_\chi
            of this data is defined for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Re
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo &gt;
                  %mi ρ
                  %mo ≔
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} Re(s)\gt \rho \coloneqq (n-1)/2
            to be the
            %a.existingWikiWord{:href => "/nlab/show/infinite+product"} infinite product
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi χ
                  %mo{:stretchy => "false"} (
                  %mi s
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mfrac{:linethickness => "0"}
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi g
                          %mo{:stretchy => "false"} ]
                          %mo ∈
                          %mi Prim
                          %mo{:stretchy => "false"} (
                          %mi Γ
                          %mo{:stretchy => "false"} )
                      %mrow
                        %mrow
                          %mo{:stretchy => "false"} [
                          %mi g
                          %mo{:stretchy => "false"} ]
                          %mo ≠
                          %mn 1
                  %mspace{:width => "thickmathspace"}
                  %munderover
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mrow
                      %mi k
                      %mo =
                      %mn 0
                    %mn ∞
                  %mi det
                  %mrow
                    %mo (
                    %mn 1
                    %mo −
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} (
                        %mi ρ
                        %mo +
                        %mi s
                        %mo{:stretchy => "false"} )
                        %mi l
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi S
                      %mi k
                    %mo{:stretchy => "false"} (
                    %mi Ad
                    %mo{:stretchy => "false"} (
                    %mi g
                    %msubsup
                      %mo{:stretchy => "false"} )
                      %mstyle{:mathvariant => "bold"}
                        %mi n
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} )
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi m
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\zeta_\chi(s) =
                  \\underset{{[g] \in Prim(\Gamma)} \atop {[g] \neq 1}}{\prod}
                  \\;
                  \\underoverset{k = 0}{\infty}{\prod}
                  \\det\left(
                  1 -
                  e^{-(\rho + s)l(g)}
                  S^k(Ad(g)^{-1}_{\mathbf{n}})
                  \\sigma(m)
                  \\;
                  \\chi(g)
                  \\right)
          %p
            (…) (
            %a{:href => "#BunkeOlbrich94a"}> BunkeOlbrich 94a, def. 4.1
            )
          %h2#properties Properties
          %h3#AnalogyWithArtinLFunction Analogy with Artin L-function
          %p
            That the Selberg zeta function is equivalently an
            %a.existingWikiWord{:href => "/nlab/show/Euler+product"} Euler product
            of
            %a.existingWikiWord{:href => "/nlab/show/characteristic+polynomials"} characteristic polynomials
            is due to (
            %a{:href => "#Gangolli77"}> Gangolli 77, (2.72)
            ,
            = succeed ")." do
              %a{:href => "#Fried86"} Fried 86, prop. 5
          %p
            That it is in particular the Euler product of
            %a.existingWikiWord{:href => "/nlab/show/characteristic+polynomials"} characteristic polynomials
            of the
            %a.existingWikiWord{:href => "/nlab/show/determinants"} determinants
            of the
            %a.existingWikiWord{:href => "/nlab/show/monodromies"} monodromies
            of the
            %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
            corresponding to the given
            %a.existingWikiWord{:href => "/nlab/show/group+representation"} group representation
            (similar to the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Ruelle+zeta+function"} Ruelle zeta function
            = succeed ")" do
              %a{:href => "#BunkeOlbrich94"} Bunke-Olbrich 94, prop. 6.3
            = succeed ")" do
              %a{:href => "#BunkeOlbrich94a"} Bunke-Olbrich 94a, def. 4.1
            %a.existingWikiWord{:href => "/nlab/show/Ruelle+zeta+function"} Ruelle zeta function
            (
            %a{:href => "#BunkeOlbrich94a"}> Bunke-Olbrich 94a, def. 5.1
            )).
          %p
            This is
            %a.existingWikiWord{:href => "/nlab/show/analogy"} analogous
            to the standard definition of an
            %a.existingWikiWord{:href => "/nlab/show/Artin+L-function"} Artin L-function
            if one interprets a) a
            %a.existingWikiWord{:href => "/nlab/show/Frobenius+map"} Frobenius map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Frob
                    %mi p
                %annotation{:encoding => "application/x-tex"} Frob_p
            (as discussed there) as an element of the
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+fundamental+group"} arithmetic fundamental group
            of an
            %a.existingWikiWord{:href => "/nlab/show/arithmetic+curve"} arithmetic curve
            and b) a
            %a.existingWikiWord{:href => "/nlab/show/Galois+representation"} Galois representation
            as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/flat+connection"} flat connection
          %p
            So under this analogy the Selberg zeta function for hyperbolic 3-manifolds as well as the
            %a.existingWikiWord{:href => "/nlab/show/Artin+L-function"} Artin L-function
            for a
            %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            both are like an
            %a.existingWikiWord{:href => "/nlab/show/infinite+product"} infinite product
            over primes (
            %a.existingWikiWord{:href => "/nlab/show/prime+geodesics"} prime geodesics
            in one case,
            %a.existingWikiWord{:href => "/nlab/show/prime+ideals"} prime ideals
            in the other, see also at
            = succeed ")" do
              %em
                %a{:href => "Spec%28Z%29#As3dSpaceContainingKnots"} Spec(Z) – As a 3-dimensional space containing knots
          %p
            See at
            %em
              %a{:href => "Artin%20L-function#AnalogyWithSelbergZeta"} Artin L-function – Analogy with Selberg zeta function
            for more. This analogy has been highlighted in (
            %a{:href => "#Brown09"}> Brown 09
            ,
            = succeed ")." do
              %a{:href => "#Morishita12"} Morishita 12, remark 12.7
          %h3#RelationToTheEtaFunction Relation to the eta-function
          %p
            Under suitable conditions, the Selberg zeta function of odd type is an exponential of the
            %a.existingWikiWord{:href => "/nlab/show/eta+function"} eta function
            of a suitable
            %a.existingWikiWord{:href => "/nlab/show/Dirac+operator"} Dirac operator
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ζ
                    %mi S
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi exp
                  %mrow
                    %mo (
                    %mi i
                    %mi π
                    %msub
                      %mi η
                      %mi D
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo{:stretchy => "false"} )
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\zeta_S(0) = \exp\left(i \pi \eta_D(0)\right)
          %p
            (
            %a{:href => "#Millson78"}> Millson 78
            ,
            = succeed "," do
              %a{:href => "#BunkeOlbrich94a"} Bunke-Olbrich 94a, prop. 4.5
            = succeed "," do
              %a{:href => "#Park01"} Park 01, theorem 1.2
            = succeed ")." do
              %a{:href => "#GuillarmouMoroianuPark09"} Guillarmou-Moroianu-Park 09
          %h3#RelationToAnalyticTorsion Relation to analytic torsion
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Ruelle+zeta+function"} Ruelle zeta function
            at 0 gives a power of
            %a.existingWikiWord{:href => "/nlab/show/analytic+torsion"} analytic torsion
          %p
            (
            %a{:href => "#Fried86"}> Fried 86
            ,
            = succeed ")" do
              %a{:href => "#BunkeOlbrich94a"} Bunke-Olbrich 94a, theorem 5.5.
          %ul
            %li
              %a{:href => "analytic+torsion#RelationToSelbergZeta"} analytic torsion – relation to Selberg zeta function
          %h3#relation_to_prime_geodesic_asymptotics Relation to prime geodesic asymptotics
          %p
            The Selberg zeta function controls the
            %a.existingWikiWord{:href => "/nlab/show/asymptotics"} asymptotics
            of
            %a.existingWikiWord{:href => "/nlab/show/prime+geodesics"} prime geodesics
            via the
            %a.existingWikiWord{:href => "/nlab/show/prime+geodesic+theorem"} prime geodesic theorem
            in direct
            %a.existingWikiWord{:href => "/nlab/show/analogy"} analogy
            to how the
            %a.existingWikiWord{:href => "/nlab/show/Riemann+zeta+function"} Riemann zeta function
            controls the asymptotics of
            %a.existingWikiWord{:href => "/nlab/show/prime+numbers"} prime numbers
            via the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/prime+number+theorem"} prime number theorem
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ruelle+zeta+function"} Ruelle zeta function
          %div
            %table
              %thead
                %tr
                  %th
                    context/
                    %a.existingWikiWord{:href => "/nlab/show/function+field+analogy"} function field analogy
