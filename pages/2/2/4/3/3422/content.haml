                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+an+overcategory"} model structure on an overcategory
                  for the Quillen
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            %p
              The first and third Quillen adjunction here is a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %p
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> HTT, section 3.1.5
            )
          %h2#properties Properties
          %h3#AsAnOplaxInfinityColimit
            As an (op)lax
            = succeed "-colimit" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %p
            The
            = succeed "-Grothendieck" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/lax+%28infinity%2C1%29-colimit"} lax (infinity,1)-colimit
            (
            %a{:href => "#GepnerHaugsengNikolaus15"}> Gepner-Haugseng-Nikolaus 15
            ).
          %p
            See also at
            %em
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            = succeed "." do
              %em
                %a{:href => "Grothendieck%20construction#AsALaxColimit"} as a lax colimit
          %h2#examples Examples
          %h3#cartesian_fibrations_over_the_point Cartesian fibrations over the point
          %p
            For the base category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            being the point
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo =
                    %mo *
                  %annotation{:encoding => "application/x-tex"} S = {*}
            = succeed "-Grothendieck" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi St
                    %mi ϕ
                  %mo :
                  %mi sSet
                  %mo{:stretchy => "false"} /
                  %mo *
                  %mo ≃
                  %mi sSet
                  %mo →
                  %mo{:stretchy => "false"} [
                  %mo *
                  %mo ,
                  %mi sSet
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mi sSet
                %annotation{:encoding => "application/x-tex"}
                  St_\phi : sSet/* \simeq sSet \to [*,sSet] \simeq sSet
          %p
            is not entirely trivial and in fact produces a Quillen auto-equivalence of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sSet
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            with itself that plays a central role in the proof of the corresponding Quillen equivalence over general
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
          %p
            %strong Definition
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo :
                  %mi Δ
                  %mo →
                  %mi sSet
                %annotation{:encoding => "application/x-tex"} Q : \Delta \to sSet
            be the
            %a.existingWikiWord{:href => "/nlab/show/cosimplicial+object"} cosimplicial
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            given by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo :
                  %mo =
                  %mo{:stretchy => "false"} |
                  %msup
                    %mi J
                    %mi n
                  %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  Q[n] := |J^n|(x,v)
                  \\,,
          %p where
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi J
                    %mi n
                  %mo =
                  %msup
                    %mi C
                    %mo ◃
                  %mo{:stretchy => "false"} (
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mo{:stretchy => "false"} {
                  %mi x
                  %mo{:stretchy => "false"} }
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  J^n = C^{\triangleleft}(\Delta[n] \to \{x\})
                  \\,.
          %p
            Then:
            %a.existingWikiWord{:href => "/nlab/show/nerve+and+realization"} nerve and realization
            associated to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Q
                %annotation{:encoding => "application/x-tex"} Q
            yield a
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sSet
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            with itself.
          %p
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> HTT, section 2.2.2
            \.
          %p …
          %h3#FibsOverInterval Cartesian fibrations over the interval
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                  %mo :
                  %mi K
                  %mo →
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} p : K \to \Delta[1]
            over the 1-
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            corresponds to a morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mi op
                  %mo →
                %annotation{:encoding => "application/x-tex"} \Delta[1]^{op} \to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29Cat"} (∞,1)Cat
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : D \to C
          %p
            By the above procedure we can express
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            as the image of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            under the straightening functor. The characterization via lax colimits leads to describing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi K
                %annotation{:encoding => "application/x-tex"} K
            as the mapping cylinder
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Δ
                      %mn 1
                    %mo ×
                    %mi B
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⨿
                      %mrow
                        %msup
                          %mi Δ
                          %mrow
                            %mo{:stretchy => "false"} {
                            %mn 0
                            %mo{:stretchy => "false"} }
                        %mo ×
                        %mi B
                    %mi A
                  %annotation{:encoding => "application/x-tex"} (\Delta^1 \times B) \amalg_{\Delta^{\{0\}} \times B} A
          %p However, there is a more immediate way to extract this functor, which we now describe. This construction also provides additional strictness properties in the quasicategory model.
          %p
            First recall the situation for the ordinary
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibration"} Grothendieck fibration
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo →
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} K \to \{0 \to 1\}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %msub
                    %mi K
                    %mn 1
                  %mo →
                  %msub
                    %mi K
                    %mn 0
                %annotation{:encoding => "application/x-tex"} f : K_1 \to K_0
            between the fibers, by
            %em choosing
            for each object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                  %mo ∈
                  %msub
                    %mi K
                    %mn 1
                %annotation{:encoding => "application/x-tex"} d \in K_1
            a
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi e
                      %mi d
                    %mo →
                    %mi d
                  %annotation{:encoding => "application/x-tex"} e_d \to d
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi d
                    %mn 1
                  %mo →
                  %msub
                    %mi d
                    %mn 2
                %annotation{:encoding => "application/x-tex"} d_1 \to d_2
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi K
                    %mn 1
                %annotation{:encoding => "application/x-tex"} K_1
            the unique left vertical filler in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi e
                            %mrow
                              %msub
                                %mi d
                                %mn 1
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi d
                            %mn 1
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi e
                            %mrow
                              %msub
                                %mi d
                                %mn 2
                        %mtd
                          %mo →
                        %mtd
                          %msub
                            %mi d
                            %mn 2
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  e_{d_1} &amp;\to&amp; d_1
                  \\\
                  \\downarrow &amp;&amp; \downarrow
                  \\\
                  e_{d_2} &amp;\to&amp; d_2
                  }
                  \\,.
          %p
            And again by universality, this assignment is functorial:
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi K
                      %mn 1
                    %mo →
                    %msub
                      %mi K
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} K_1 \to K_0
          %p
            Diagrammatically, the choice of Cartesian morphisms here is a lift
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                %annotation{:encoding => "application/x-tex"} e
            in the diagram
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi K
                            %mn 1
                        %mtd
                          %mo ↪
                        %mtd
                          %mi K
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %msub
                            %mo ↗
                            %mi e
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %msub
                            %mi K
                            %mn 1
                          %mo ×
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo →
                          %mn 1
                          %mo{:stretchy => "false"} }
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} {
                          %mn 0
                          %mo →
                          %mn 1
                          %mo{:stretchy => "false"} }
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  K_1 &amp;\hookrightarrow&amp; K
                  \\\
                  \\downarrow &amp;\nearrow_e&amp; \downarrow
                  \\\
                  K_1 \times \{0 \to 1\} &amp;\to&amp; \{0 \to 1\}
                  }
                  \\,.
          %p
            This diagrammatic way of encoding the functor associated to a Grothendieck fibration over the interval generalizes straightforwardly to the
            %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
            context.
          .un_defn
            %h6#definition_5 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi K
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p : K \to \Delta[1]
              with fibers the
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo :
                    %mo =
                    %msub
                      %mi K
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C := K_{0}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo :
                      %mo =
                      %msub
                        %mi K
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} D := K_{1}
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
                \-functor associated to the Cartesian fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              is a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f : D \to C
              such that there exists a commuting diagram in
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi D
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi F
                          %mtd
                          %mtd
                            %mi K
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D \times \Delta[1] &amp;&amp;\stackrel{F}{\to}&amp;&amp; K
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{p}}
                    \\\
                    \&amp;&amp; \Delta[1]
                    }
            %p such that
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi F
                        %msub
                          %mo{:stretchy => "false"} |
                          %mn 1
                        %mo =
                        %msub
                          %mi Id
                          %mi D
                      %annotation{:encoding => "application/x-tex"} F|_{1} = Id_D
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi F
                        %msub
                          %mo{:stretchy => "false"} |
                          %mn 0
                        %mo =
                        %mi f
                      %annotation{:encoding => "application/x-tex"} F|_{0} = f
                  ;
              %li
                %p
                  and for all
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi d
                          %mo ∈
                          %mi D
                        %annotation{:encoding => "application/x-tex"} d \in D
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo{:stretchy => "false"} (
                        %mo{:stretchy => "false"} {
                        %mi d
                        %mo{:stretchy => "false"} }
                        %mo ×
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo →
                        %mn 1
                        %mo{:stretchy => "false"} }
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F(\{d\}\times \{0  \to 1\})
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
                  in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi K
                        %annotation{:encoding => "application/x-tex"} K
            %p
              More generally, if we also specify possibly nontrivial
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalences of quasi-categories
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 0
                    %mo :
                    %mi C
                    %mover
                      %mo →
                      %mo ≃
                    %msub
                      %mi K
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} h_0 : C \stackrel{\simeq}{\to} K_{0}
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi h
                        %mn 1
                      %mo :
                      %mi D
                      %mover
                        %mo →
                        %mo ≃
                      %msub
                        %mi K
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} h_1 : D \stackrel{\simeq}{\to} K_{1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              and this choice of equivalences if the first twoo conditions above are generalized to
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi F
                        %msub
                          %mo{:stretchy => "false"} |
                          %mn 1
                        %mo =
                        %msub
                          %mi h
                          %mn 1
                      %annotation{:encoding => "application/x-tex"} F|_{1} = h_1
                  ;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi F
                        %msub
                          %mo{:stretchy => "false"} |
                          %mn 0
                        %mo =
                        %msub
                          %mi h
                          %mn 0
                        %mo ∘
                        %mi f
                      %annotation{:encoding => "application/x-tex"} F|_{0} = h_0 \circ f
                  ;
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, def. 5.2.1.1
          .un_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %mi K
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} p : K \to \Delta[1]
              a Cartesian fibration, the associated functor exists and is unique up to equivalence in the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Func
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi K
                        %mn 0
                      %mo ,
                      %msub
                        %mi K
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Func(K_{0}, K_{1})
          .proof
            %h6#proof_5 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop 5.2.1.5
            %p
              Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo :
                    %mo =
                    %msub
                      %mi K
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C := K_{0}
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                      %mo :
                      %mo =
                      %msub
                        %mi K
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} D := K_{1}
            %p
              With the notation described at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+for+Cartesian+fibrations"} model structure for Cartesian fibrations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mo ♭
                            %mo ×
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo ↪
                          %mtd
                            %msup
                              %mi K
                              %mo ♯
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mo ♭
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo #
                          %mtd
                            %mo →
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo #
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D^\flat \times \{1\} &amp;\hookrightarrow&amp; K^{\sharp}
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    D^{\flat} \times \Delta[1]^{#} &amp;\to&amp;
                    \\Delta[1]^#
                    }
            %p
              in the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
              of marked simplicial sets.
            %p
              Here the left vertical morphism is
              = succeed ":" do
                %a{:href => "http://ncatlab.org/nlab/show/model+structure+for+Cartesian+fibrations#MarkedAnodyne"} marked anodyne
              %a.existingWikiWord{:href => "/nlab/show/smash+product"} smash product
              of the marked cofibration (monomorphism)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Id
                    %mo :
                    %msup
                      %mi D
                      %mo ♭
                    %mo →
                    %msup
                      %mi D
                      %mo ♭
                  %annotation{:encoding => "application/x-tex"} Id : D^\flat \to D^\flat
              with the marked anodyne morphism
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mo #
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[1]^# \to \Delta[0]
              = succeed "," do
                %a{:href => "http://ncatlab.org/nlab/show/model+structure+for+Cartesian+fibrations#MarkedAnodyne"} Marked anodyne morphisms
            %p
              As discussed there, this means that a lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo :
                    %msup
                      %mi D
                      %mo ♭
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo #
                    %mo →
                    %msup
                      %mi K
                      %mo ♯
                  %annotation{:encoding => "application/x-tex"} d : D^\flat \times \Delta[1]^# \to K^{\sharp}
              against the Cartesian fibration in
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mo ♭
                            %mo ×
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo ↪
                          %mtd
                            %msup
                              %mi K
                              %mo ♯
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mi s
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mo ♭
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo #
                          %mtd
                            %mo →
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo #
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D^\flat \times \{1\} &amp;\hookrightarrow&amp; K^{\sharp}
                    \\\
                    \\downarrow &amp;\nearrow_{s}&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    D^{\flat} \times \Delta[1]^{#} &amp;\to&amp;
                    \\Delta[1]^#
                    }
            %p
              exists. This exhibits an associated functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo :
                      %mo =
                      %msub
                        %mi s
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} f := s_0
            %p
              Suppose now that another associated functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} f'
              is given. It will correspondingly come with its diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mo ♭
                            %mo ×
                            %mo{:stretchy => "false"} {
                            %mn 1
                            %mo{:stretchy => "false"} }
                          %mtd
                            %mo ↪
                          %mtd
                            %msup
                              %mi K
                              %mo ♯
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mrow
                                %mi s
                                %mo ′
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mo ♭
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo #
                          %mtd
                            %mo →
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo #
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D^\flat \times \{1\} &amp;\hookrightarrow&amp; K^{\sharp}
                    \\\
                    \\downarrow &amp;\nearrow_{s'}&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    D^{\flat} \times \Delta[1]^{#} &amp;\to&amp;
                    \\Delta[1]^#
                    }
                    \\,.
            %p Together this may be arranged to a diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mo ♭
                            %mo ×
                            %mi Λ
                            %mo{:stretchy => "false"} [
                            %mn 2
                            %msub
                              %mo{:stretchy => "false"} ]
                              %mn 2
                          %mtd
                            %mover
                              %mo →
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi s
                                %mo ,
                                %mi s
                                %mo ′
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi K
                              %mo ♯
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msub
                              %mo ↗
                              %mi q
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %msup
                              %mi D
                              %mo ♭
                            %mo ×
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 2
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo #
                          %mtd
                            %mo →
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} ]
                              %mo #
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    D^\flat \times \Lambda[2]_2
                    \&amp;\stackrel{(s,s')}{\to}&amp; K^{\sharp}
                    \\\
                    \\downarrow &amp;\nearrow_{q}&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    D^{\flat} \times \Delta[2]^{#} &amp;\to&amp;
                    \\Delta[1]^#
                    }
                    \\,,
            %p
              where the top horizontal morphism picks the 2-
              %a.existingWikiWord{:href => "/nlab/show/horn"} horn
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              whose two edges are labeled by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi s
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} s'
            %p
              Now, the left vertical morphism is still marked anodyne, and hence the lift
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              exists, as indicated. Being a morphism of marked simplicial sets, it must map for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi D
                  %annotation{:encoding => "application/x-tex"} d \in D
              the edge
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi d
                    %mo{:stretchy => "false"} }
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \{d\}\times \{0\to 1\}
              to a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                    %annotation{:encoding => "application/x-tex"} K
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi K
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} K_0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mn 0
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{0\}
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+morphism"} Cartesian morphism
              over a point is an equivalence. This means that the restriction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %mi D
                        %mo ×
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %mo →
                        %mn 1
                        %mo{:stretchy => "false"} }
                    %mo →
                    %msub
                      %mi K
                      %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    k|_{D \times \{0 \to 1\}} \to K_0
            %p
              is an invertible
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
              between
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ′
                    %annotation{:encoding => "application/x-tex"} f'
          %p
            Conversely, every functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi D
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} f : D \to C
            gives rise to a Cartesian fibration that it is associated to, in the above sense.
          .un_prop
            %h6#proposition_5 Proposition
            %p
              Every
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} f : D \to C
              is associated to some Cartesian fibration
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                      %mo :
                      %mi K
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} p : K \to \Delta[1]
          .proof
            %h6#proof_6 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop 5.2.1.3
            %p
              The idea is that we obtain
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              from first forming the cylinder
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} D \times \Delta[1]
              and the identifying the left boundary of that with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              Formally this means that we form the
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi D
                      %mo ♮
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo #
                    %mo{:stretchy => "false"} )
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                      %mrow
                        %msup
                          %mi D
                          %mo ♮
                        %mo ×
                        %mo{:stretchy => "false"} {
                        %mn 0
                        %msup
                          %mo{:stretchy => "false"} }
                          %mo #
                    %msup
                      %mi C
                      %mo ♮
                  %annotation{:encoding => "application/x-tex"}
                    N := (D^\natural \times \Delta[1]^#) \coprod_{D^\natural \times \{0\}^#} C^\natural
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi sSet
                        %mo +
                    %annotation{:encoding => "application/x-tex"} sSet^+
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mo ♮
                  %annotation{:encoding => "application/x-tex"} C^\natural
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mo ♮
                  %annotation{:encoding => "application/x-tex"} D^\natural
              are
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              with precisely the
              %a.existingWikiWord{:href => "/nlab/show/equivalence+in+a+quasi-category"} equivalences
              marked. This comes canonically with a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo ♯
                  %annotation{:encoding => "application/x-tex"}
                    N \to \Delta[1]^{\sharp}
            %p
              and does have the property that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mn 0
                      %mo =
                      %mi C
                    %annotation{:encoding => "application/x-tex"} N_0 = C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mn 1
                    %mo =
                    %mi D
                  %annotation{:encoding => "application/x-tex"} N_1 = D
              and that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is associated to it in that the restriction of the canonical morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi K
                  %annotation{:encoding => "application/x-tex"} D \times \Delta[1] \to K
              to the 0-fiber is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
            %p
              To fix this, use the
              %a.existingWikiWord{:href => "/nlab/show/small+object+argument"} small object argument
              to factor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} N \to \Delta[1]
              as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo →
                    %mi K
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo #
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    N \to K \to \Delta[1]^#
                    \\,,
            %p
              where the first morphism is
              %a{:href => "http://ncatlab.org/nlab/show/model+structure+for+Cartesian+fibrations#MarkedAnodyne"} marked anodyne
              and the second has the
              %a.existingWikiWord{:href => "/nlab/show/right+lifting+property"} right lifting property
              with respect to all marked anodyne morphisms and is hence (since every morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo #
                  %annotation{:encoding => "application/x-tex"} \Delta[1]^#
              is marked) a Cartesian fibration.
            %p
              It then remains to check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is still associated to this
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mo #
                    %annotation{:encoding => "application/x-tex"} K \to \Delta[1]^#
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is built succesively from
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi N
                              %mi α
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi N
                              %mrow
                                %mi α
                                %mo +
                                %mn 1
                          %mtd
                            %mo →
                          %mtd
                            %mi Δ
                            %mo{:stretchy => "false"} [
                            %mn 1
                            %mo{:stretchy => "false"} ]
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp; N_\alpha
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp; \searrow
                    \\\
                    B &amp;\to&amp; N_{\alpha+1} &amp;\to&amp; \Delta[1]
                    }
                    \\,,
            %p
              where the morphisms on the left are the generators of marked anodyne morphisms (see
              = succeed ")." do
                %a{:href => "http://ncatlab.org/nlab/show/model+structure+for+Cartesian+fibrations#MarkedAnodyne"} here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi α
                    %msub
                      %mo ×
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} N_\alpha \times_{\Delta[1]} \{0\}
              is equivalent to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mrow
                        %mi α
                        %mo +
                        %mn 1
                    %msub
                      %mo ×
                      %mrow
                        %mi Δ
                        %mo{:stretchy => "false"} [
                        %mn 1
                        %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} N_{\alpha +1} \times_{\Delta[1]} \{0\}
              and similarly for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi D
                    %annotation{:encoding => "application/x-tex"} D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is indeed associated to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} K \to \Delta[1]
            %p
              To see that the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              obtained this way is unique up to equivalence, consider…
          %h3#CartOverSimplex Cartesian fibrations over simplices
          %p
            … for the moment see
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, section 3.2.2
            …
          %h3#the_universal_cartesian_fibration The universal Cartesian fibration
          %p for the moment see
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/universal+fibration+of+%28%E2%88%9E%2C1%29-categories"}> universal fibration of (∞,1)-categories
              \.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/operadic+%28%E2%88%9E%2C1%29-Grothendieck+construction"} operadic (∞,1)-Grothendieck construction
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction+for+model+categories"} Grothendieck construction for model categories
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joyal+locus"}> Joyal locus
                ,
                %a.existingWikiWord{:href => "/nlab/show/tangent+%28infinity%2C1%29-topos"} tangent (infinity,1)-topos
          %h2#references References
          %p Textbook accounts:
          %ul
            %li#Lurie09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
                , Section 3.2 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} Higher Topos Theory
                = succeed "," do
                  %strong 170
                = succeed "," do
                  %a{:href => "https://press.princeton.edu/titles/8957.html"} pup:8957
                = succeed ")" do
                  %a{:href => "https://www.math.ias.edu/~lurie/papers/HTT.pdf"} pdf
            %li#Cisinski19
              %p
                %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
                , Section 5.2 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Categories+and+Homotopical+Algebra"} Higher Categories and Homotopical Algebra
                = succeed "," do
                  %a{:href => "https://doi.org/10.1017/9781108588737"} doi:10.1017/9781108588737
                = succeed ")" do
                  %a{:href => "http://www.mathematik.uni-regensburg.de/cisinski/CatLR.pdf"} pdf
              %blockquote
                %p
                  (for
                  = succeed "-groupoids)" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
          %p
            More on model-category theoretic construction of the
            = succeed "-Grothendieck" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li#HeutsMoerdijk13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gijs+Heuts"}> Gijs Heuts
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                %em Left fibrations and homotopy colimits
                (
                %a{:href => "http://arxiv.org/abs/1308.0704"}> arXiv:1308.0704
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Gijs+Heuts"}> Gijs Heuts
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"} Ieke Moerdijk
                %em Left fibrations and homotopy colimits II
                \&amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1602.01274"}> arXiv:1602.01274
                \&amp;rbrack;
          %p
            Discussion in terms of
            %a.existingWikiWord{:href => "/nlab/show/lax+%28infinity%2C1%29-colimits"} lax (infinity,1)-colimits
            is in
          %ul
            %li#GepnerHaugsengNikolaus15
              %a.existingWikiWord{:href => "/nlab/show/David+Gepner"}> David Gepner
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Rune+Haugseng"} Rune Haugseng
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Nikolaus"} Thomas Nikolaus
              %em
                Lax colimits and free fibrations in
                = succeed "-categories" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              (
              %a{:href => "http://arxiv.org/abs/1501.02161"}> arXiv:1501.02161
              )
          %p Section 1 of this paper reviews properties of the Grothendieck construction for quasicategories:
          %ul
            %li#MazelGee
              %a.existingWikiWord{:href => "/nlab/show/Aaron+Mazel-Gee"}> Aaron Mazel-Gee
              ,
              %em All about the Grothendieck construction
              (
              %a{:href => "https://arxiv.org/abs/1510.03525"}> arXiv:1510.03525
              )
          %p Another review is
          %ul
            %li
              Anders Jess Pedersen, Magnus Baunsgaard Kristensen,
              %em Straightening and Unstraightening
              %a{:href => "https://www.dropbox.com/s/alys3wg59rir3gt/Grothendieck_construction.pdf?dl=0"} (Dropbox)
          %p
            Discussion of the
            = succeed "-Grothendieck" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-functors"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-functors
            to
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-toposes"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-toposes
            from
            %a.existingWikiWord{:href => "/nlab/show/inverse+images"} inverse images
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/infinity-groupoid"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-groupoids
          %ul
            %li{:id => "BeardsleyPéroux22"}
              %a.existingWikiWord{:href => "/nlab/show/Jonathan+Beardsley"}> Jonathan Beardsley
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Maximilien+P%C3%A9roux"} Maximilien Péroux
              = succeed "," do
                %em Koszul Duality in Higher Topoi
              = succeed "," do
                %a{:href => "https://www.intlpress.com/site/pub/pages/journals/items/hha/_home/acceptedpapers/index.php"} (2022)
              = succeed "&rbrack;" do
                %a{:href => "https://arxiv.org/abs/1909.11724"} arXiv:1909.11724
          %p
            Discussion entirely within the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hoang+Kim+Nguyen"} Hoang Kim Nguyen
              %em The universal coCartesian fibration
              \&amp;lbrack;
              %a{:href => "https://arxiv.org/abs/2210.08945"}> arXiv:2210.08945
              \&amp;rbrack;
          %p
            which lends itself to understanding the
            %a.existingWikiWord{:href => "/nlab/show/universal+coCartesian+fibration"} universal coCartesian fibration
            as
            %a.existingWikiWord{:href => "/nlab/show/categorical+semantics"} categorical semantics
            for the
            %a.existingWikiWord{:href => "/nlab/show/type+universe"} type universe
            in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/directed+homotopy+type+theory"} directed homotopy type theory
          %ul
            %li#CisinskiEtAl23
              %a.existingWikiWord{:href => "/nlab/show/Denis-Charles+Cisinski"}> Denis-Charles Cisinski
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Hoang+Kim+Nguyen"} Hoang Kim Nguyen
              = succeed "," do
                %em Univalent Directed Type Theory
              %em
                %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/index.html"} CMU Homotopy Type Theory Seminar
              (13, 20, 27 Mar 2023) &amp;lbrack;
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/index.html#230313"}> web
              , video 1:
              %a{:href => "https://www.youtube.com/watch?v=5YOltuTcBK8"}> YT
              , 2:
              %a{:href => "https://www.youtube.com/watch?v=xWmELBvHMPo"}> YT
              , 3:
              %a{:href => "https://www.youtube.com/watch?v=P0Cfb4eUJo4"}> YT
              ; slides 0:
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-intro_talk1.pdf"}> pdf
              , 1:
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-talk1.pdf"}> pdf
              , 2:
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-talk2.pdf"}> pdf
              , 3:
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-talk3.pdf"}> pdf
              \&amp;rbrack;
          %p
            (see
            %a{:href => "https://youtu.be/P0Cfb4eUJo4?t=4618"} video 3 at 1:16:58
            and
            = succeed ")" do
              %a{:href => "https://www.cmu.edu/dietrich/philosophy/hott/seminars/slides/cisinski-nguyen-walde-talk3.pdf#page=33"} slides 3.33
        .revisedby
