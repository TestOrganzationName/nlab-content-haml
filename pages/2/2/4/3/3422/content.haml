                      %annotation{:encoding => "application/x-tex"} \tau_hc(S)
                  the corresponding
                  %a.existingWikiWord{:href => "/nlab/show/SSet-category"} SSet-category
                  (under the
                  %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi τ
                          %mi hc
                        %mo :
                        %mi SSet
                        %mo →
                        %mi SSet
                        %mi Cat
                      %annotation{:encoding => "application/x-tex"} \tau_{hc} : SSet \to SSet Cat
                  of the
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℭ
                      %annotation{:encoding => "application/x-tex"} \mathfrak{C}
                  in
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  an
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/SSet-category"} SSet-category
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo :
                        %msub
                          %mi τ
                          %mi hc
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} \phi : \tau_{hc}(S) \to C
                  a morphism of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/SSet-categories"} SSet-categories
            %blockquote
              %p
                In particular we will be interested in the case that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϕ
                    %annotation{:encoding => "application/x-tex"} \phi
                is the identity, or at least an equivalence, identifying
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                with
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi τ
                          %mi hc
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \tau_{hc}(S)
            %p
              For any object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p : X\to S)
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} sSet/S
              consider the
              %a.existingWikiWord{:href => "/nlab/show/sSet-category"} sSet-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\phi,p)
              obtained as the (ordinary)
              %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              in
              %a.existingWikiWord{:href => "/nlab/show/SSet+Cat"} SSet Cat
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi τ
                              %mi hc
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo →
                              %mrow
                          %mtd
                            %msub
                              %mi τ
                              %mi hc
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi X
                              %mo ▹
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mi ϕ
                                  %mo{:stretchy => "false"} (
                                  %mi p
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mo →
                          %mtd
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\tau_{hc}(X) &amp;\stackrel{}{\to}&amp; \tau_{hc}(X^{\triangleright})
                    \\\
                    {}^{\mathllap{\phi(p)}}\downarrow &amp;&amp; \downarrow
                    \\\
                    C &amp;\to&amp; K(\phi,p)
                    }
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo ▹
                    %mo =
                    %mi X
                    %mo ⋆
                    %mo{:stretchy => "false"} {
                    %mi v
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} X^{\triangleright} = X \star \{v\}
              is the
              %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join of simplicial sets
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              with a single vertex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
            %p
              Using this construction, define a functor, the
              = succeed "," do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/straightening+functor"} straightening functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mi ϕ
                    %mo :
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    St_\phi : sSet/S \to [C^{op}, sSet]
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
              of
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to the
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched functor category
              of
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} sSet
              by defining it on objects
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p : X \to S)
              to act as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi SSet
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    St_\phi(X) := K(\phi,p)(-,v) : C^{op} \to SSet
                    \\,.
          .un_example
            %h6#example Example
            %p
              The straightening functor effectively computes the fibers of a
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi p
                    %mo :
                    %mi X
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (p : X \to C)
              over every point
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} x \in C
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo =
                        %mo *
                      %annotation{:encoding => "application/x-tex"} C = *
                  only has a single point;
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                        %mo =
                        %mrow
                          %mo {
                          %mi a
                          %mo →
                          %mi b
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mspace{:width => "thickmathspace"}
                          %mi c
                          %mo }
                      %annotation{:encoding => "application/x-tex"} X = \left\{ a \to b \;\;\; c\right\}
                  is a category with three objects, two of them connected by a morphism
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi p
                        %mo{:lspace => "verythinmathspace"} :
                        %mi X
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} p \colon X \to C
                  is the only possible functor, sending everything to the point.
            %p Then
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mo ▹
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi a
                              %mtd
                                %mo →
                              %mtd
                                %mi b
                              %mtd
                              %mtd
                                %mi c
                            %mtr
                              %mtd
                              %mtd
                                %mo ↘
                                %mo ⇐
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↙
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi v
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      X^{\triangleright} =
                      \\left\{
                      \\array{
                      a &amp;\to&amp; b &amp;&amp; c
                      \\\
                      \&amp; \searrow \Leftarrow&amp; \downarrow &amp; \swarrow
                      \\\
                      \&amp;&amp; v
                      }
                      \\right\}
            %p and
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi X
                        %mo ▹
                      %msub
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mi X
                      %mi C
                      %mo =
                      %mrow
                        %mo {
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mo •
                            %mtr
                              %mtd
                              %mtd
                                %mo ↙
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↘
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ⇐
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                              %mtd
                                %mo ↘
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo ↙
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi v
                        %mo }
                    %annotation{:encoding => "application/x-tex"}
                      X^{\triangleright} \coprod_{X} C =
                      \\left\{
                      \\array{
                      \&amp;&amp; \bullet
                      \\\
                      \&amp; \swarrow &amp; \downarrow &amp; \searrow
                      \\\
                      \\downarrow&amp; \Leftarrow &amp; \downarrow
                      \\\
                      \&amp; \searrow &amp; \downarrow &amp; \swarrow
                      \\\
                      \&amp;&amp; v
                      }
                      \\right\}
            %p
              Therefore the category of morphisms in this pushout from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo *
                  %annotation{:encoding => "application/x-tex"} *
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is indeed again the category
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} {
                      %mi a
                      %mo →
                      %mi b
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi c
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \{a \to b \;\;\; c\}
            %p
              More on this is at
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
              in the section of adjoints to the Grothendieck construction.
          .un_prop
            %h6#proposition Proposition
            %p
              With the definitions
              = succeed "," do
                %a{:href => "#UnmarkedStraighteningFunctor"} as above
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo :
                    %mi C
                    %mo →
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \pi : C \to C'
              be an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              between
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet-categories"} sSet-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo !
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mrow
                        %mi C
                        %mo ′
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\pi_! : [C^{op}, sSet] \to [{C'}^{op}, sSet]
            %p
              for the left
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              along
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
            %p
              There is a
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
              of the straightening functor for the composite
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo ∘
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \pi \circ \phi
              and the original straightening functor for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              followed by left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              along
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi π
                    %annotation{:encoding => "application/x-tex"} \pi
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mrow
                        %mi π
                        %mo ∘
                        %mi ϕ
                    %mo ≃
                    %msub
                      %mi π
                      %mo !
                    %mo ∘
                    %msub
                      %mi St
                      %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    St_{\pi \circ \phi} \simeq \pi_! \circ St_\phi
                    \\,.
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, prop. 2.2.1.1.
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Harry+Gindi"} Harry Gindi
          .proof
            %h6#proof Proof
            %p
              We unwind what the
              %a.existingWikiWord{:href => "/nlab/show/sSet-categories"} sSet-categories
              with a single object adjoined to them look like:
            %p let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"}
                    F : C^{op} \to sSet
            %p
              be an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              %a.existingWikiWord{:href => "/nlab/show/sSet-category"} sSet-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi F
                  %annotation{:encoding => "application/x-tex"} C_F
              by setting
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi C
                          %mi F
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mi Obj
                        %mo{:stretchy => "false"} (
                        %mi C
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                        %mo{:stretchy => "false"} {
                        %mi ν
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} Obj(C_F) = Obj(C) \coprod \{\nu\}
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi C
                          %mi F
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mrow
                          %mo {
                          %mrow
                            %mtable
                              %mtr
                                %mtd
                                  %mi C
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo ,
                                  %mi d
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mi for
                                  %mi c
                                  %mo ,
                                  %mi d
                                  %mo ∈
                                  %mi Obj
                                  %mo{:stretchy => "false"} (
                                  %mi C
                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                  %mi F
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo{:stretchy => "false"} )
                                %mtd
                                  %mi for
                                  %mi c
                                  %mo ∈
                                  %mi Obj
                                  %mo{:stretchy => "false"} (
                                  %mi c
                                  %mo{:stretchy => "false"} )
                                  %mi and
                                  %mi d
                                  %mo =
                                  %mi ν
                              %mtr
                                %mtd
                                  %mi ∅
                                %mtd
                                  %mi for
                                  %mi c
                                  %mo =
                                  %mi ν
                                  %mi and
                                  %mi d
                                  %mo ∈
                                  %mi Obj
                                  %mo{:stretchy => "false"} (
                                  %mi C
                                  %mo{:stretchy => "false"} )
                              %mtr
                                %mtd
                                  %mo *
                                %mtd
                                  %mi for
                                  %mi c
                                  %mo =
                                  %mi d
                                  %mo =
                                  %mi ν
                      %annotation{:encoding => "application/x-tex"}
                        C_F(c,d) = \left\{
                        \\array{
                        C(c,d) &amp; for c,d \in Obj(C)
                        \\\
                        F(c) &amp; for c \in Obj(c) and d = \nu
                        \\\
                        \\emptyset &amp; for c = \nu and d \in Obj(C)
                        \\\
                        * &amp; for c = d = \nu
                        }
                        \\right.
            %p
              The composition operation is that induced from the composition in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and the enriched functoriality of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
            %p
              Observe that the
              %a.existingWikiWord{:href => "/nlab/show/sSet-category"} sSet-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\phi,p)
              appearing in the
              %a{:href => "#UnmarkedStraighteningFunctor"} definition of the straightening functor
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mi C
                      %mrow
                        %msub
                          %mi St
                          %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    K(\phi,p) \simeq C_{St_\phi(X)}
            %p
              (because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\phi,p)
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              with a single object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              and some morphisms to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                  %annotation{:encoding => "application/x-tex"} \nu
              adjoined, such that there are no non-degenerate morphisms originating at
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ν
                    %annotation{:encoding => "application/x-tex"} \nu
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi ϕ
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} K(\phi,p)
              is of form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi F
                  %annotation{:encoding => "application/x-tex"} C_F
              for some
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} St_\phi(X)
              is that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              by definition).
            %p To prove the proposition, we need to compute the pushout
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msub
                              %mi τ
                              %mi hc
                            %mo{:stretchy => "false"} (
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo →
                          %mtd
                            %msub
                              %mi τ
                              %mi hc
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi X
                              %mo ▹
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mo →
                          %mtd
                            %mi K
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo ,
                            %mi p
                            %mo{:stretchy => "false"} )
                            %mo =
                            %msub
                              %mi C
                              %mrow
                                %msub
                                  %mi St
                                  %mi ϕ
                                %mo{:stretchy => "false"} (
                                %mi X
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi π
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi C
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi Q
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\tau_{hc}(X) &amp;\to&amp; \tau_{hc}(X^{\triangleright})
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    C &amp;\to&amp; K(\phi,p) = C_{St_\phi(X)}
                    \\\
                    {}^{\mathllap{\pi}}\downarrow &amp;&amp; \downarrow
                    \\\
                    C' &amp;\to&amp; Q
                    }
            %p
              and show that indeed
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Q
                      %mo ≃
                      %mi C
                      %msub
                        %mo ′
                        %mrow
                          %msub
                            %mi π
                            %mo !
                          %msub
                            %mi St
                            %mi ϕ
                          %mo{:stretchy => "false"} (
                          %mi X
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Q \simeq C'_{\pi_! St_\phi(X)}
            %p
              Using the pasting law for
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              %a.existingWikiWord{:href => "/nlab/show/sSet-category"} sSet-category
              of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi F
                    %annotation{:encoding => "application/x-tex"} C_F
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo →
                    %msub
                      %mi C
                      %mi F
                  %annotation{:encoding => "application/x-tex"} C\to C_F
              along any
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                    %mo{:lspace => "verythinmathspace"} :
                    %mi C
                    %mo →
                    %mi C
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} \pi \colon C \to C'
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %msub
                        %mo ′
                        %mrow
                          %msub
                            %mi π
                            %mo !
                          %mi F
                    %annotation{:encoding => "application/x-tex"} C'_{\pi_! F}
            %p This follows by inspection of what a cocone
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi C
                          %mtd
                            %mover
                              %mo →
                              %mi ι
                          %mtd
                            %msub
                              %mi C
                              %mi F
                        %mtr
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mi π
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi d
                        %mtr
                          %mtd
                            %mi C
                            %mo ′
                          %mtd
                            %munder
                              %mo →
                              %mi r
                          %mtd
                            %mi Q
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    C &amp;\stackrel{\iota}{\to}&amp; C_F
                    \\\
                    {}^{\mathllap{\pi}}\downarrow &amp;&amp; \downarrow^{\mathrlap{d}}
                    \\\
                    C' &amp;\underset{r}{\to}&amp; Q
                    }
            %p
              is like: by the nature of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi F
                  %annotation{:encoding => "application/x-tex"} C_F
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
              is characterized by a functor
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi C
                      %mo :
                      %mi C
                      %mo →
                      %mi Q
                    %annotation{:encoding => "application/x-tex"} d|_C : C \to Q
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} d(\nu) \in Q
              together with a
              %a.existingWikiWord{:href => "/nlab/show/natural+transformation"} natural transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F(c) \to  Q(d|_C(c), d(\nu))
            %p
              being the component
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mrow
                        %mi c
                        %mo ,
                        %mi ν
                    %mo :
                    %msub
                      %mi C
                      %mi F
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F_{c,\nu} : C_F(c,\nu) \to Q(d(c), d(\nu))
              of the
              = succeed "-functor." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
            %p We may write this natural transformation as
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %mo{:stretchy => "false"} (
                    %mi d
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi C
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi ι
                      %mo *
                    %msup
                      %mi d
                      %mo *
                    %mi ν
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    F \to (d|_C)^* Q(-,d(\nu)) = \iota^* d^* \nu Q(-,d(\nu))
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi d
                      %mo *
                  %annotation{:encoding => "application/x-tex"} d^*
              etc. means precomposition with the functor
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
            %p By commutativity of the diagram this is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo ≃
                    %msup
                      %mi π
                      %mo *
                    %msup
                      %mi r
                      %mo *
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\cdots \simeq \pi^* r^* Q(-,d(\nu))
                    \\,.
            %p
              Now by the definition of left
              %a.existingWikiWord{:href => "/nlab/show/Kan+extension"} Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mo !
                  %annotation{:encoding => "application/x-tex"} \pi_!
              as the
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
              to prescomposition with a functor, this is bijectively a transformation
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %msub
                      %mi π
                      %mo !
                    %mi F
                    %mo →
                    %msup
                      %mi r
                      %mo *
                    %mi Q
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mi ν
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\eta : \pi_! F \to r^* Q(-,d(\nu))
                    \\,.
            %p
              Using this we see that we may find a universal cocone by setting
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Q
                    %mo :
                    %mo =
                    %mi C
                    %msub
                      %mo ′
                      %mrow
                        %msub
                          %mi π
                          %mo !
                        %mi F
                  %annotation{:encoding => "application/x-tex"} Q := C'_{\pi_! F}
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo :
                    %mi C
                    %mo ′
                    %mo →
                    %mi Q
                  %annotation{:encoding => "application/x-tex"} r : C' \to Q
              the canonical inclusion and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi F
                    %mo →
                    %mi C
                    %msub
                      %mo ′
                      %mrow
                        %msub
                          %mi π
                          %mo !
                        %mi F
                  %annotation{:encoding => "application/x-tex"} C_{F} \to C'_{\pi_! F}
              given by
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi π
                  %annotation{:encoding => "application/x-tex"} \pi
              on the restriction to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and by the
              %a.existingWikiWord{:href => "/nlab/show/unit+of+an+adjunction"} unit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo →
                    %msup
                      %mi π
                      %mo *
                    %msub
                      %mi π
                      %mo !
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F \to \pi^* \pi_! F
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi C
                        %mi F
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi ν
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} C_F(c,\nu)
              %a.existingWikiWord{:href => "/nlab/show/adjunct"} adjunct
              transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              is the identity, which makes this universal among all cocones.
          .un_prop
            %h6#proposition_2 Proposition
            %p
              This functor has a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Un
                      %mi ϕ
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    Un_\phi : [C^{op}, sSet] \to sSet/S
                    \\,,
            %p
              that takes a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaf"} simplicial presheaf
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              to a simplicial set over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              – this is the
              = succeed "." do
                %strong unstraightening functor
          .proof
            %h6#proof_2 Proof
            %p
              One checks that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mi ϕ
                  %annotation{:encoding => "application/x-tex"} St_\phi
              preserves
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
          %p
          .num_prop
            %h6 Proposition
            %p
              %strong
                (presentation of the
                = succeed "-Grothendieck" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,0)
              %br/
            %p
              The straightening and the unstraightening functor constitute a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi St
                      %mi ϕ
                    %mo ⊣
                    %msub
                      %mi Un
                      %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thinmathspace"}
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi S
                    %munderover
                      %mrow
                      %munder
                        %mo ⟶
                        %mrow
                          %msub
                            %mi St
                            %mi ϕ
                      %mover
                        %mo ⟵
                        %mrow
                          %msub
                            %mi Un
                            %mi ϕ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (St_\phi \dashv Un_\phi)
                    \\,\colon\,
                    sSet/S
                    \\underoverset
                    {\underset{St_\phi}{\longrightarrow}}
                    {\overset{Un_{\phi}}{\longleftarrow}}
                    {}
                    [C^{op}, sSet]
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+right+fibrations"} model structure for right fibrations
              and the global projective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is a weak equivalence in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+categories"} model structure on simplicial categories
              then this Quillen adjunction is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, theorem 2.2.1.2
          %p
            This models the Grothendieck construction for
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            in the following way:
          %ul
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} (∞,1)-category presented by
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                      %mo{:stretchy => "false"} /
                      %mi S
                    %annotation{:encoding => "application/x-tex"} sSet/S
                is
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi RFib
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} RFib(S)
              %p
                (
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"}> HTT, lemma 2.2.3.9
                )
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} (∞,1)-category presented by
                the global
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi C
                        %mi op
                      %mo ,
                      %mi SSet
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [C^{op}, SSet]
                is
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-presheaves"} (∞,1)-category of (∞,1)-presheaves
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi PSh
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi N
                        %mi hc
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh_{(\infty,1)}(N_{hc}(C))
          %p
            Hence the unstraightening functor is what models the
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            proper, in the sense of a construction that generalizes the construction of a
            %a.existingWikiWord{:href => "/nlab/show/fibered+category"} fibered category
            from a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
          %h2#for_general_fibered_categories
            For general fibered
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            The generalization of a
            %a.existingWikiWord{:href => "/nlab/show/fibered+category"} fibered category
            to
            %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
            theory is a
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/fibrations+of+quasi-categories"} fibration of quasi-categories
          .un_theorem
            %h6#theorem Theorem
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
                \-Grothendieck construction)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a small
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cart
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cart(C) \simeq Func(C^{op}, (\infty,1) Cat)
            %ul
              %li
                %p
                  on the left we have the
                  = succeed "-category" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mn ∞
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\infty,1)
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  with small fibers and cartesian functors between them – incarnated as a
                  = succeed "-" do
                    %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
                  %a.existingWikiWord{:href => "/nlab/show/subcategory"} subcategory
                  of the
                  %a.existingWikiWord{:href => "/nlab/show/overcategory"} overcategory
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi sSet
                        %mo{:stretchy => "false"} /
                        %mi C
                      %annotation{:encoding => "application/x-tex"} sSet/C
                  on
                  = succeed "s;" do
                    %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              %li
                %p
                  and on the right the
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi C
                          %mi op
                      %annotation{:encoding => "application/x-tex"} C^{op}
                  to the
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-categories"} (∞,1)-category of (∞,1)-categories
            %p
              Furthermore, this is equivalence is natural for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Cart
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Cart(-)
              acts by taking pullbacks and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %msup
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi op
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mi Cat
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Func(-^{op}, (\infty,1) Cat)
              acts by composition.
          %p
            A reference for the naturality in small
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is corollary A.32 of
            = succeed "." do
              %a{:href => "#GepnerHaugsengNikolaus15"} Gepner-Haugseng-Nikolaus 15
            = succeed "." do
              %a{:href => "#MazelGee"} Mazel-Gee
          %p
            In the next section we discuss how this statement is presented in terms of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
          %h3#ModCatCart Model category presentation
          %p
            Regard the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            in its incarnation as a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi hc
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \tau_{hc}(S)
            the corresponding
            %a.existingWikiWord{:href => "/nlab/show/simplicially+enriched+category"} simplicially enriched category
            (where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi τ
                    %mi hc
                %annotation{:encoding => "application/x-tex"} \tau_{hc}
            is the
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            of the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ϕ
                  %mo :
                  %msub
                    %mi τ
                    %mi hc
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \phi : \tau_{hc}(S) \to C
            be an
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
          .un_def
            %h6#definition_2 Definition
            %p
              %strong (extracting a marked simplicial presheaf from a marked fibration)
              (HTT, section 3.2.1)
            %p
              The
              %strong straightening functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mi ϕ
                    %mo :
                    %msup
                      %mi sSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %msup
                      %mi sSet
                      %mo +
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    St_\phi : sSet^+/S \to [C^{op}, sSet^+]
            %p
              from
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/marked+simplicial+set"} marked simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              to marked
              %a.existingWikiWord{:href => "/nlab/show/simplicial+presheaves"} simplicial presheaves
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi C
                      %mi op
                  %annotation{:encoding => "application/x-tex"} C^{op}
              is on the underlying simplicial sets (forgetting the marking) the same straightening functor as
              = succeed "." do
                %a{:href => "#GrpdModelCatVersion"} above
            %p On the markings the functor acts as follows.
            %p
              Each edge
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi d
                    %mo →
                    %mi e
                  %annotation{:encoding => "application/x-tex"} f: d \rightarrow e
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi sSet
                    %mo{:stretchy => "false"} /
                    %mi S
                  %annotation{:encoding => "application/x-tex"} X \in sSet/S
              gives rise to an edge
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                      %mo ∈
                      %msub
                        %mi St
                        %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde f \in St_\phi (X)(d) = K(\phi,p)(d,v)
              %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join
              2-simplex
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo ⋆
                    %mi v
                  %annotation{:encoding => "application/x-tex"} f \star v
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo ▹
                  %annotation{:encoding => "application/x-tex"} X^{\triangleright}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi d
                          %mtd
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                          %mtd
                            %mi e
                        %mtr
                          %mtd
                          %mtd
                            %msub
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mover
                                  %mi d
                                  %mo{:stretchy => "false"} ˜
                            %mo ↘
                          %mtd
                            %mover
                              %mo ⇒
                              %mover
                                %mi f
                                %mo{:stretchy => "false"} ˜
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mover
                                  %mi e
                                  %mo{:stretchy => "false"} ˜
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi v
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    d &amp;&amp; \stackrel{f}{\to} &amp;&amp; e
                    \\\
                    \&amp; {}_{\mathllap{\tilde d}}\searrow
                    \&amp; \stackrel{\tilde f}{\Rightarrow}
                    \&amp; \swarrow_{\mathrlap{\tilde e}}
                    \\\
                    \&amp;&amp; v
                    }
            %p
              with image
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mover
                      %mi d
                      %mo{:stretchy => "false"} ˜
                    %mo →
                    %msup
                      %mi f
                      %mo *
                    %mover
                      %mi e
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f : \tilde d \to f^* \tilde e
              in the pushout
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi K
                      %mo{:stretchy => "false"} (
                      %mi ϕ
                      %mo ,
                      %mi p
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mo =
                      %msub
                        %mi St
                        %mi ϕ
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} K(\phi,p)(d,v)=St_\phi X(d)
            %p
              We define the straightening functor to assign that marking of edges which is the minimal one such that all such morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                  %annotation{:encoding => "application/x-tex"} \tilde f
              are marked in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi St
                        %mi ϕ
                      %mi X
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} St_\phi X(d)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi d
                    %mo →
                    %mi e
                  %annotation{:encoding => "application/x-tex"} f : d \to e
              in
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} St_\phi(X)
              be
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functorial
            %p
              For that,
              %a.existingWikiWord{:href => "/nlab/show/marked+simplicial+set"} recall
              that the hom simplicial sets of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi sSet
                      %mo +
                  %annotation{:encoding => "application/x-tex"} sSet^+
              are the spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Map
                        %mo ♯
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo ,
                      %mi Y
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Map^\sharp(X,Y)
              %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mo =
                    %msup
                      %mi Y
                      %mi X
                  %annotation{:encoding => "application/x-tex"} Map(X,Y) := Y^X
              whose edges are all marked:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %msub
                      %mi Hom
                      %mrow
                        %msup
                          %mi sSet
                          %mo +
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mi n
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo #
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Map(X,Y)_n = Hom_{sSet^+}(X \times \Delta[n]^#, Y)
                    \\,.
            %p
              So we need to find a marking on the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} St_\phi(X)(-)
              such that for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo :
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g : \Delta[1] \to C(c,d)
              the composite
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mi g
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi St
                          %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi c
                        %mo ,
                        %mi d
                        %mo{:stretchy => "false"} )
                    %mi Map
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta[1]
                    \\stackrel{g}{\to}
                    C(c,d)
                    \\stackrel{St_\phi(X)(c,d)}{\to}
                    Map(St_\phi(X)(d), St_\phi(X)(c))
            %p is a marked edge of the mapping complex. By the internal hom-adjunction this edge corresponds to a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    St_\phi(X)(g)
                    \:
                    St_\phi(X)(d) \times \Delta[1] \rightarrow St_\phi(X)(c)
            %p
              and to be marked needs to carry edges of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo ×
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo →
                    %mn 1
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \tilde f \times \{0 \to 1\}
              i.e. 1-cells
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo ,
                    %mi Id
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} (\tilde f , Id) : \Delta[1] \to St_\phi(X)(d) \times \Delta[1]
              to marked edges
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mo *
                    %mover
                      %mi f
                      %mo{:stretchy => "false"} ˜
                    %mo :
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mover
                          %mi f
                          %mo{:stretchy => "false"} ˜
                        %mo ,
                        %mi Id
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi St
                          %mi ϕ
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi g
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    g^* \tilde f : \Delta[1] \stackrel{(\tilde f,Id)}{\to}
                    St_\phi(X)(d)\times \Delta[1] \stackrel{St_\phi(X)(g)}{\to}
                    St_{\phi}(X)(c)
            %p
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi St
                        %mi ϕ
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} St_\phi(X)(c)
            %p
              we define that the straightening functor marks an edge in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi St
                      %mi ϕ
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} St_\phi(X)(c)
              iff it is of this form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi g
                        %mo *
                      %mover
                        %mi f
                        %mo{:stretchy => "false"} ˜
                    %annotation{:encoding => "application/x-tex"} g^* \tilde f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi d
                    %mo →
                    %mi e
                  %annotation{:encoding => "application/x-tex"} f : d \to e
              a marked edge of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mo ∈
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo ,
                      %mi d
                      %msub
                        %mo{:stretchy => "false"} )
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} g \in C(c,d)_1
            %p
              As in the unmarked cae, the straightening functor has an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %strong unstraightening functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi n
                      %mi ϕ
                    %mo :
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %msup
                      %mi sSet
                      %mo +
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %msup
                      %mi sSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    n_\phi :  [C^{op}, sSet^+] \to sSet^+/S
                    \\,.
          %p
            This functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Un
                    %mi ϕ
                %annotation{:encoding => "application/x-tex"} Un_\phi
            exhibits the
            = succeed "-Grothendieck-construction" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
            from a given
            = succeed "-functor:" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          .un_theorem
            %h6#theorem_2 Theorem
            %p
              %strong
                (presentation of
                = succeed "-Grothendieck" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn ∞
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (\infty,1)
            %p
              This induces a
              %a.existingWikiWord{:href => "/nlab/show/Quillen+adjunction"} Quillen adjunction
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi St
                      %mi ϕ
                    %mo ⊣
                    %msub
                      %mi Un
                      %mi ϕ
                    %mo{:stretchy => "false"} )
                    %mo :
                    %msup
                      %mi SSet
                      %mo +
                    %mo{:stretchy => "false"} /
                    %mi S
                    %mover
                      %munder
                        %mo →
                        %mrow
                          %msub
                            %mi St
                            %mi ϕ
                      %mover
                        %mo ←
                        %mrow
                          %msub
                            %mi Un
                            %mi ϕ
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %msup
                      %mi SSet
                      %mo +
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    (St_\phi \dashv Un_\phi) : SSet^+/S
                    \\stackrel{\overset{Un_{\phi}}{\leftarrow}}{\underset{St_\phi}{\to}}
                    [C^{op}, SSet^+]
            %p
              between the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+for+Cartesian+fibrations"} model structure for Cartesian fibrations
              and the projective
              %a.existingWikiWord{:href => "/nlab/show/global+model+structure+on+functors"} global model structure on functors
              with values in the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+marked+simplicial+over-sets"} model structure on marked simplicial sets
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ϕ
                  %annotation{:encoding => "application/x-tex"} \phi
              is an equivalence in the
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+categories"} model structure on simplicial categories
              then this Quillen adjunction is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
          .proof
            %h6#proof_3 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, theorem 3.2.0.1
          %h4#OverCat Over an ordinary category
          %p
            In the case that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            happens to be an ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "-Grothendieck" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %p
            This is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, section 3.2.5
          .un_def
            %h6#definition_3 Definition
            %p
              %strong (relative nerve functor)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              be a small category and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi C
                    %mo →
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} f : C \to sSet
              be a functor. The simplicial set
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi N
                        %mi f
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N_f(C)
              %strong relative nerve
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is defined as follows:
            %p
              an
              = succeed "-cell" do
