          %h3#relation_beween_the_model_structures Relation beween the model structures
          %p
          .num_prop
            %h6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
