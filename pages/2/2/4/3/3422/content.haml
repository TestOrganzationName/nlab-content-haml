                    \\stackrel{\overset{}{\to}}{\overset{}{\leftarrow}}
                    (sSet^+/S)^{loc}
                    \\stackrel{\overset{}{\to}}{\overset{}{\leftarrow}}
                    (sSet/S)_{rfib}
                    \\stackrel{\overset{}{\to}}{\overset{}{\leftarrow}}
                    (sSet/S)_{Quillen}
                    \\,.
            %p Where from left to right we have
            %ol
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+an+overcategory"} model structure on an overcategory
                  for the Joyal
