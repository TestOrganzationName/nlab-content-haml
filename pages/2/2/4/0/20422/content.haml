          %h2#idea Idea
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebra"} vertex operator algebra
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            (
            %a.existingWikiWord{:href => "/nlab/show/VOA"}> VOA
            ) or
            %a.existingWikiWord{:href => "/nlab/show/super+vertex+operator+algebra"} super vertex operator algebra
            (
            %a.existingWikiWord{:href => "/nlab/show/sVOA"}> sVOA
            ), or more generally a full
            %a.existingWikiWord{:href => "/nlab/show/2d+CFT"} 2d CFT
            (of which the
            %a.existingWikiWord{:href => "/nlab/show/VOA"} VOA
            is the local and chiral data) or
            %a.existingWikiWord{:href => "/nlab/show/2d+SCFT"} 2d SCFT
            (hence a “
            %a.existingWikiWord{:href => "/nlab/show/2-spectral+triple"}> 2-spectral triple
            ”) one may ask (as for any
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            in any
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/automorphisms"} automorphisms
            %a.existingWikiWord{:href => "/nlab/show/homomorphisms"} homomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                  %mover
                    %mo ⟶
                    %mo ≃
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{V}
                  \\overset{\simeq}{\longrightarrow}
                  \\mathcal{V}
          %p
            in the corresponding
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            of sVOA-s/
            %a.existingWikiWord{:href => "/nlab/show/2d+SCFTs"}> 2d SCFTs
            , from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            to itself, which are
            %a.existingWikiWord{:href => "/nlab/show/invertible+morphism"} invertible
            and hence constitute a
            %em
              %a.existingWikiWord{:href => "/nlab/show/symmetry"} symmetry
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒱
                  %annotation{:encoding => "application/x-tex"} \mathcal{V}
          %h2#in_perturbative_string_vacua_and_conneslott_models In perturbative string vacua and Connes-Lott models
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            is a
            %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct summand
            of a
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/2d+CFT"} 2d CFT
            %a.existingWikiWord{:href => "/nlab/show/2-spectral+triple"} 2-spectral triple
            encoding a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+string+theory+vacuum"} perturbative string theory vacuum
            %a.existingWikiWord{:href => "/nlab/show/rational+2d+CFT"} rational 2d CFT
            such as a
            %a.existingWikiWord{:href => "/nlab/show/Gepner+model"} Gepner model
            encoding a “
            %a.existingWikiWord{:href => "/nlab/show/non-geometric+string+vacuum"}> non-geometric
            ”
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒱
                %annotation{:encoding => "application/x-tex"} \mathcal{V}
            are the
            %a.existingWikiWord{:href => "/nlab/show/formal+dual"} formal duals
            to
            %a.existingWikiWord{:href => "/nlab/show/symmetries"} symmetries
            of that
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/KK-compactification"} KK-compactification
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            space (see the references
            = succeed ")" do
              %a{:href => "#AsSymmetriesOfStringCompactifications"} below
          %p
            In the point-particle limit where the
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/2d+SCFT"} 2d SCFT
            %a.existingWikiWord{:href => "/nlab/show/2-spectral+triple"} 2-spectral triple
            becomes an ordinary
            %a.existingWikiWord{:href => "/nlab/show/spectral+triple"} spectral triple
            (see
            = succeed ")" do
              %a{:href => "2-spectral+triple#References"} there
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Connes-Lott-Chamseddine-Barrett+models"} Connes-Lott-Chamseddine-Barrett models
          %p (…)
          %h2#examples Examples
          %h3#moonshine Moonshine
          %p
            %a.existingWikiWord{:href => "/nlab/show/moonshine"}> moonshine
            \-examples:
          %ul
            %li
              %p
                The
                %a.existingWikiWord{:href => "/nlab/show/Conway+group"} Conway group
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi CO
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} CO_{0}
                is the
                %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} group of
                %a.existingWikiWord{:href => "/nlab/show/automorphisms+of+a+super+VOA"} automorphisms of a super VOA
                of the unique chiral
                %a.existingWikiWord{:href => "/nlab/show/number+of+supersymmetries"} N=1
                %a.existingWikiWord{:href => "/nlab/show/super+vertex+operator+algebra"} super vertex operator algebra
                of
                %a.existingWikiWord{:href => "/nlab/show/central+charge"} central charge
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo =
                      %mn 12
                    %annotation{:encoding => "application/x-tex"} c = 12
                without fields of
                %a.existingWikiWord{:href => "/nlab/show/conformal+weight"} conformal weight
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 1
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} 1/2
              %p
                (
                %a{:href => "#Duncan05"}> Duncan 05
                , see also
                = succeed ")" do
                  %a{:href => "#PaquettePerssonVolpato17"} Paquette-Persson-Volpato 17, p. 9
            %li
              %p
                similarly, there is a super VOA, the
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Monster+vertex+operator+algebra"} Monster vertex operator algebra
                %a.existingWikiWord{:href => "/nlab/show/automorphism+group"} group of
                of
                %a.existingWikiWord{:href => "/nlab/show/automorphisms+of+a+VOA"} automorphisms of a VOA
                is the
                %a.existingWikiWord{:href => "/nlab/show/monster+group"} monster group
              %p
                (
                %a{:href => "#FrenkelLepowskiMeurman89"}> Frenkel-Lepowski-Meurman 89
                ,
                = succeed ")" do
                  %a{:href => "#GriessLam11"} Griess-Lam 11
          %h2#related_entries Related entries
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/automorphism+group+of+a+Lie+algebra"} automorphism group of a Lie algebra
          %h2#references References
          %h3#general General
          %p (…)
          %h3#AsSymmetriesOfStringCompactifications As symmetries of non-geometric string compactifications
          %p
            Automorphisms of
            %a.existingWikiWord{:href => "/nlab/show/vertex+operator+algebras"} vertex operator algebras
            regarded as
            %a.existingWikiWord{:href => "/nlab/show/symmetries"} symmetries
            of non-geometric
            %a.existingWikiWord{:href => "/nlab/show/perturbative+string+theory+vacua"} perturbative string theory vacua
            (e.g.
            = succeed "):" do
              %a.existingWikiWord{:href => "/nlab/show/Gepner+models"} Gepner models
          %ul
            %li#HullIsraelSarti17
              %a.existingWikiWord{:href => "/nlab/show/Chris+Hull"}> Chris Hull
              , Dan Israel, Alessandra Sarti,
              = succeed "," do
                %em Non-geometric Calabi-Yau Backgrounds and K3 automorphisms
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1710.00853"} arXiv:1710.00853
          %h3#moonshine_automorphism_groups Moonshine automorphism groups
          %ul
            %li#FrenkelLepowskiMeurman89
              %p
                %a.existingWikiWord{:href => "/nlab/show/Igor+Frenkel"}> Igor Frenkel
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/James+Lepowsky"} James Lepowsky
                = succeed "," do
                  %em Vertex operator algebras and the monster
                = succeed "," do
                  %strong 134
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=996026"} MR0996026
            %li#Duncan05
              %p
                John F. Duncan,
                %em Super-moonshine for Conway’s largest sporadic group
                (
                %a{:href => "https://arxiv.org/abs/math/0502267"}> arXiv:math/0502267
                )
            %li#GriessLam11
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Griess"} Robert Griess
                Jr., Ching Hung Lam,
                %em A new existence proof of the Monster by VOA theory
                (
                %a{:href => "https://arxiv.org/abs/1103.1414"}> arXiv:1103.1414
                )
            %li#KachruPaquetteVolpato16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Shamit+Kachru"}> Shamit Kachru
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Natalie+Paquette"} Natalie Paquette
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Roberto+Volpato"} Roberto Volpato
                %em 3D String Theory and Umbral Moonshine
                (
                %a{:href => "http://arxiv.org/abs/1603.07330"}> arXiv:1603.07330
                )
            %li#PaquettePerssonVolpato16
              %p
