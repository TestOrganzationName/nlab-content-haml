                  %annotation{:encoding => "application/x-tex"} \pi_5
              for
              %code Moore(Z/2,3)
            %p
              To compute the 4th
              %a.existingWikiWord{:href => "/nlab/show/homotopy+group"} homotopy group
              of
              = succeed "," do
                %code Moore(Z/2,3)
            %pre
              %code
                :preserve
                    #+begin_src common-lisp
                    (require 'kenzo)
                    (setf m23 (moore 2 3))
                    (setf ch3 (chm1-class m23 3))
                    (setf f3 (z2-whitehead m23 ch3))
                    (setf x4 (fibration-total f3))
                    (homology x4 3 5) ;; this gives Z/2Z, which is the \pi_{4} for Moore(Z/2Z,3).
                    #+end_src            %p To compute its 5th homotopy group:
            %pre
              %code
                :preserve
                   #+begin_src common-lisp
                   (setf ch4 (chml-class x4 4))
                   (setf f4 (z2-whitehead x4 ch4))
                   (setf x5 (fibration-total f4))
                   (homology x5 4 6) ;; this gives Z/4Z, which is the \pi_{5} for Moore(Z/2Z,3)
                   #+end_src            %p
          %h3#computations Computations?
          %pre
            %code
              :preserve
                 (cprd) coproduct.. eg for a K(Z,1)
                
                 (aprd) product.. eg for a K(Z,1)          %h2#chapter_by_chapter Chapter by chapter
          %h3#1_chain_complexes 1. Chain complexes
          %h4#13_representation_of_a_chain_complex 1.3. Representation of a chain complex
          %p
          .num_remark
            %h6 Example
            %p
              %strong
                morphism from a chain complex to another, of degree
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            %p A chain complex is implemented as an instance of a CLOS class.
            %p See page 8 for the definition of the class
            %pre
              %code =CHAIN-COMPLEX=: =(DEFCLASS CHAIN-COMPLEX () [..])=
            %p This class has 8 slots
            %p
              %code> =cmpr=
              ,
              = succeed "," do
                %code =basis=
              = succeed "," do
                %code =bsgn=
              = succeed "," do
                %code =dffr=
              = succeed "," do
                %code =idnm=
              = succeed "," do
                %code =orgn=
              = succeed "," do
                %code =grmd=
              = succeed "." do
                %code =efhm=
            %p
              the accessors of the slots are the functions speficied after
              %code =:reader=
              in the defclass code.
            %p
              To build a chain complex, use
              = succeed "." do
                %code =build-chcm=
            %pre
              %code
                :preserve
                     #+begin_src common-lisp
                     ;; warning hasn't compiled
                     (setf diabolo-cmpr #'s-cmpr)
                     (setf diabolo-basis #'(lambda (dmn)
                                             (case dmn
                                               (0 '(s0 s1 s2 s3 s4 s5))
                                               (1 '(s01 s02 s12 s23 s34 s35 s45))
                                               (2 '(s345))
                                               (otherwise nil ))))
                     (setf diabolo-bspn 's0) ;; base point
                  
                     (setf diabolo-pure-dffr
                           #'(lambda (dmn gnr)
                               (unless (<= 0 dmn 2)
                                 (error "Non-correct dimension for diabolo-dp."))
                               (case dmn
                                    (0 (cmbn -1)) ; Note the null combination of degree -1
                                    (1 (case gnr
                                         (s01 (cmbn 0 -1 's0 1 's1))
                                         (s02 (cmbn 0 -1 's0 1 's2))
                                         (s12 (cmbn 0 -1 's1 1 's2))
                                         (s23 (cmbn 0 -1 's2 1 's3))
                                         (s34 (cmbn 0 -1 's3 1 's4))
                                         (s35 (cmbn 0 -1 's3 1 's5))
                                         (s45 (cmbn 0 -1 's4 1 's5))))
                                    (2 (case gnr
                                         (s345 (cmbn 1 1 's34 -1 's35 1 's45))))
                                    (otherwise (error "Bad generator for complex diabolo")))
                               ))
                     (setf diabolo-strt :GNRT)
                     (setf diabolo-orgn '(diabolo-for-example))
                  
                     ;; Then construct it!
                     (setf diabolo (build-chcm :cmpr diabolo-cmpr :basis diabolo-basis
                                               :bsgn diabolo-bspn :intr-dffr diabolo-pure-dffr
                                               :strt diabolo-strt :orgn diabolo-orgn))
                     #+end_src            %p
          %p
            Simple functions handling chain complexes:
            = succeed "," do
              %code =cat-init=
            = succeed "," do
              %code =chcm=
            = succeed "," do
              %code =cmpr=
            = succeed "," do
              %code =basis=
            = succeed "," do
              %code =dffr=
            = succeed "." do
              %code =z-chcm=
          %p
            An important trivial case Z[0]. Do it as exercise! .. Answer on page 14. You can call it by
            %code =(z-chcm)=
            (predefined).
          %p
          .num_remark
            %h6 Example
            %p
              %strong The circle.
            %pre
              %code
                :preserve
                     #+begin_src common-lisp
                     ;; warning hasn't compiled
                     (defun CIRCLE ()
                       (the chain-complex
                            (build-chcm
                             :cmpr #'(lambda (gnrt1 gnrt2) (the cmpr :equal))
                             :basis #'(lambda (dmns)
                                        (the list
                                             (case dmns (0 '(*)) (1 '(s1))
                                                        (otherwise +empty-list+))))
                             :bsgn '*
                             :intr-dffr #'zero-intr-dffr
                             :strt :cmbn
                             :orgn '(circle))))
                     #+end_src            %p
          %h4#14_morphisms 1.4. Morphisms
          %p See the final example provided in the end of this section.
          %h3#2_objects_with_effective_homology 2. Objects with effective homology
          %h3#21_computing_homotopy_groups 21. Computing homotopy groups
          %p
            By constructing the
            %a.existingWikiWord{:href => "/nlab/show/Whitehead+tower"} Whitehead tower
            of a space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %a.existingWikiWord{:href => "/nlab/show/homotopy+groups"} homotopy groups
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            is reduced to computing the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} homology
            groups of some pieces in the tower.
          %h4#212_the_functions_for_computing_homotopy_groups 21.2 The functions for computing homotopy groups
          %pre
            %code
              :preserve
                 #+begin_quote
                 In this version of Kenzo, only the case where the first non-null
                 homology group is Z or Z/2Z can be processed; ..
                 #+end_quote          %h2#examples Examples
          %h3{:id => ""}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"} S^{2}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/2-sphere"} 2-sphere
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} S^2
          %pre
            %code
              :preserve
                 #+begin_src common-lisp :eval never
                 ;; This looks like a 2-sphere to me
                 (setf short-s2?
                       (build-finite-ss
                        '(v0 v1 v2
                          1 e01 (v1 v0) e02 (v2 v0) e12 (v2 v1)
                          2 t (e12 e02 e01) t_ (e12 e02 e01))))
                 #+end_src          %h3#_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %msup
                    %mi P
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{R}P^{2}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/real+projective+plane"} real projective plane
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℝ
                    %msup
                      %mi P
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}P^2
          %pre
            %code
              :preserve
                 #+begin_src common-lisp :eval never
                 ;; This is a small construction of RP^2.. taken from lecture note.
                 ;; Constructive Homological Algebra and Applications-Julio Rubio and Francis Sergeraert-arXiv:1208.3816
                 (setf short-P2R
                       (build-finite-ss '(v 1 e (v v) 2 t ( e v e ))))
