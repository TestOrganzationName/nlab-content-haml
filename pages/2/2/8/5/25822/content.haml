                      \\,.
              %p
                Notice that the
                %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} F_0
                is
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi{:mathvariant => "normal"} d
                        %msub
                          %mi F
                          %mn 0
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \mathrm{d} F_0 = 0
                %a.existingWikiWord{:href => "/nlab/show/locally+constant+function"} locally constant function
                whose jump across the
                %a.existingWikiWord{:href => "/nlab/show/D8-brane"} D8-brane
                worldvolume measures the charge/number
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                of these D8-branes (cf. eg.
                = succeed ")." do
                  %a{:href => "NS5-brane#Fazzi17"} Fazzi (2017) p. 40
              #eq:RomansVacuum.maruku-equation
                %span.maruku-eq-number (5)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi x
                        %mn 9
                      %mo &lt;
                      %mi d
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mo ⇒
