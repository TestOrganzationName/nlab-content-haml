                  \:
                %ul
                  %li
                    %p
                      %a.existingWikiWord{:href => "/nlab/show/Dp-D%28p%2B2%29-brane+bound+state"} Dp-D(p+2)-brane bound state
                      and
                      %a.existingWikiWord{:href => "/nlab/show/Yang-Mills+monopoles"} Yang-Mills monopoles
                    %ul
                      %li
                        %p
