              %p which just means to disregard D6-brane whose presence is not due to the Hanany-Witten effect.
          %p
            With these boundary conditions set, the differential equation
            %a.maruku-eqref{:href => "#eq:BianchiIdentityForD6BraneFlux"} (3)
            may be solved for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} F_2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi x
                    %mn 9
                %annotation{:encoding => "application/x-tex"} x^9
            the number/charge of D6-branes seen is the integral of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi F
                    %mn 2
                %annotation{:encoding => "application/x-tex"} F^2
            around the 2-sphere in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 9
                      %mo ,
                      %mn 1
                  %mo ∖
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 6
                      %mo ,
                      %mn 1
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi ℝ
                    %mrow
                      %mn 6
                      %mo ,
                      %mn 1
                  %mo ×
                  %msub
                    %mi ℝ
                    %mo +
                  %mo ×
                  %msup
                    %mi S
                    %mn 2
                %annotation{:encoding => "application/x-tex"}
                  \\mathbb{R}^{9,1}
                  \\setminus
                  \\mathbb{R}^{6,1}
                  \\;\simeq\;
                  \\mathbb{R}^{6,1}
                  \\times
                  \\mathbb{R}_+
                  \\times
                  S^2
          %p
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mover
                      %mn 0
                      %mo{:stretchy => "false"} →
                    %mo ,
                    %msup
                      %mi x
                      %mn 9
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 6
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} (\vec 0, x^9) \,\in\, \mathbb{R}^{6,1}
          %p
            %br/
          %p
            %br/
          %p
            %br/
          %p
            %br/
          %p
            %br/
          #eq:IllustrationFluxDensitityofD6OnD8.maruku-equation
            %span.maruku-eq-number (7)
            %code.maruku-mathml
          %center
            %div{:style => "margin:-200px 10px 10px 0;"}
              %img{:src => "/nlab/files/FluxesOfD6BetweenNS5AndD8-230618b.jpg", :width => "650"}/
              %img/
          %ol
            %li
              %p
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo &lt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d \lt 0
                  – indicated in the top part of figure
                  %a.maruku-eqref{:href => "#eq:IllustrationFluxDensitityofD6OnD8"} (7)
              %p
                In this case the NS5-brane is to the “right” of the D8-brane and hence in the Romans vacuum where
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi F
                          %mn 0
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} F_0 = 0
                %a.maruku-eqref{:href => "#eq:BianchiIdentityForD6BraneFlux"} (3)
                becomes
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} d
                            %msub
                              %mi F
                              %mn 2
                          %mtd
                            %mo =
                          %mtd
                            %msub
                              %mi F
                              %mn 0
                            %mo ∧
                            %msub
                              %mi H
                              %mn 3
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mn 0
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{array}{c}
                      \\mathrm{d} F_2 &amp;=&amp; F_0 \wedge H_3
                      \\\
                      \&amp;=&amp; 0
                      \\end{array}
              %p
                This means that
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F_2
                does not change in the Romans vacuum, and hence if it vanishes to the left, as the boundary condition assumes, then it vanishes throughout.
              %p
                Since the integral of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F_2
                counts the number/charge of D6-brane, the conclsusion is that
                %em no D6-branes are created
                in this situation.
            %li
              %p
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo &gt;
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} d \gt 0
                  – indicated in the bottom part of figure
                  %a.maruku-eqref{:href => "#eq:IllustrationFluxDensitityofD6OnD8"} (7)
              %p
                In this case the NS5-brane is to the “left” of the D8-brane and hence in the region where
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 0
                      %mo =
                      %mi N
                    %annotation{:encoding => "application/x-tex"} F_0 = N
                equals the number of D8-branes. Here the differential equation
                %a.maruku-eqref{:href => "#eq:BianchiIdentityForD6BraneFlux"} (3)
                becomes
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mtable{:columnalign => "center", :displaystyle => "false", :rowspacing => "0.5ex"}
                        %mtr
                          %mtd
                            %mi{:mathvariant => "normal"} d
                            %msub
                              %mi F
                              %mn 2
                          %mtd
                            %mo =
                          %mtd
                            %msub
                              %mi F
                              %mn 0
                            %mo ∧
                            %msub
                              %mi H
                              %mn 3
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                          %mtd
                            %mi N
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi H
                              %mn 3
                    %annotation{:encoding => "application/x-tex"}
                      \\begin{array}{c}
                      \\mathrm{d} F_2 &amp;=&amp; F_0 \wedge H_3
                      \\\
                      \&amp;=&amp; N \, H_3
                      \\end{array}
              %p
                This means now that as approach the NS5/D8-branes from the “left”,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} F_2
                is continuously increasing by a rate measured by the density
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi H
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} H_3
                of NS5-brane flux. While this is everywhere non-vanishing, it is concentrated around the NS5-brane worldvolume locus (falling off by a power law from there). Therefore once we have “crossed the NS5-brane” and thus picked up most of its flux,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∫
                        %mrow
                          %msup
                            %mi S
                            %mn 2
                      %msub
                        %mi F
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \int_{S^2} F_2
                will have increased from its asympotically vanishing value to
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %msub
                          %mo ∫
                          %mrow
                            %msup
                              %mi S
                              %mn 2
                        %msubsup
                          %mo ∫
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn ∞
                          %mi d
                        %msub
                          %mi H
                          %mn 3
                        %mspace{:width => "thinmathspace"}
                        %mo ∼
                        %mspace{:width => "thinmathspace"}
                        %mi N
                        %msub
                          %mo ∫
                          %mrow
                            %msup
                              %mi S
                              %mn 3
                        %msub
                          %mi H
                          %mn 3
                        %mspace{:width => "thinmathspace"}
                        %mo ∼
                        %mspace{:width => "thinmathspace"}
                        %mi N
                        %mi k
                      %annotation{:encoding => "application/x-tex"} N \int_{S^2} \int_{-\infty}^d H_3 \,\sim\, N \int_{S^3} H_3 \,\sim\, N k
          %h3#D2StretchingBetweenNS5AndD5 D3 stretching between D5 and NS5
          %p
            (cf.
            = succeed ")" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/D3-D5+brane+bound+state"} D3-D5 brane bound state
          %p
            We discuss the “creation” of
            %a.existingWikiWord{:href => "/nlab/show/D3-brane"} D3-brane
            %a.existingWikiWord{:href => "/nlab/show/flux"} flux
            “in between” a
            %a.existingWikiWord{:href => "/nlab/show/background+field"} background
            of
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/D5-brane"} D5-brane
            %a.existingWikiWord{:href => "/nlab/show/NS5-brane"} NS5-brane
            flux as seen from (just) the
            = succeed "-equations." do
              %a.existingWikiWord{:href => "/nlab/show/pregeometric+RR-field"} pregeometric flux
          %p
            If we assume that there are no
            %a.existingWikiWord{:href => "/nlab/show/D7-branes"} D7-branes
            present in that the
            %a.existingWikiWord{:href => "/nlab/show/RR-field"} RR-field
            %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
            which they source vanishes,
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 1
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} F_1 = 0
            %a.existingWikiWord{:href => "/nlab/show/Bianchi+identity"} Bianchi identity
            for the
            = succeed "-flux" do
              %a.existingWikiWord{:href => "/nlab/show/D5-brane"} D5-brane
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mtable{:columnalign => "right center left", :displaystyle => "false", :rowspacing => "0.5ex"}
                    %mtr
                      %mtd
                        %mi{:mathvariant => "normal"} d
                        %mspace{:width => "thinmathspace"}
                        %msub
                          %mi F
                          %mn 3
                      %mtd
                        %mo =
                      %mtd
                        %msub
                          %mi H
                          %mn 3
                        %mo ∧
                        %msub
                          %mi F
                          %mn 1
                    %mtr
                      %mtd
                      %mtd
                        %mo =
                      %mtd
                        %mn 0
                %annotation{:encoding => "application/x-tex"}
                  \\begin{array}{rcl}
                  \\mathrm{d} \, F_3
                  \&amp;=&amp;
                  H_3 \wedge F_1
                  \\\
                  \&amp;=&amp; 0
                  \\end{array}
          %p
            just as for the
            %a.existingWikiWord{:href => "/nlab/show/B-field"} B-field
            %a.existingWikiWord{:href => "/nlab/show/flux+density"} flux density
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi{:mathvariant => "normal"} d
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi H
                    %mn 3
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\mathrm{d}\, H_3 \;=\; 0
                  \\,.
          %p
            Hence assume that there is a pair of flat parallel
            %a.existingWikiWord{:href => "/nlab/show/D5-branes"} D5-branes
            and
            %a.existingWikiWord{:href => "/nlab/show/NS5-branes"} NS5-branes
            at a
            %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            distance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 2
                  %mi d
                  %mo ∈
                  %msub
                    %mi ℝ
                    %mo +
                %annotation{:encoding => "application/x-tex"} 2 d \in \mathbb{R}_+
            from each other
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msubsup
                            %mi ℝ
                            %mrow
                              %mi NS
                              %mn 5
                            %mrow
                              %mn 5
                              %mo ,
                              %mn 1
                        %mtd
                          %mover
                            %mo ↪
                            %mphantom
                              %mrow
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mo −
                        %mtd
                          %msup
                            %mi ℝ
                            %mrow
                              %mn 10
                              %mo ,
                              %mn 1
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mi t
                          %mo ,
