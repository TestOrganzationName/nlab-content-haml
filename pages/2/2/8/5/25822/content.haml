            %li
              %p There is no D6-brane to the far “left” of the NS5/D8,
              #eq:ND6BesidesThoseCreated.maruku-equation
                %span.maruku-eq-number (6)
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %munder
                        %mi lim
                        %munder
