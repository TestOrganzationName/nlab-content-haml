                  \\big)
          %p
            In the following we regard both of these as further
            = succeed "/restricted" do
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pulled back
            %a.existingWikiWord{:href => "/nlab/show/complement"} complement
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mn 9
                        %mo ,
                        %mn 1
                    %mo ∖
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msubsup
