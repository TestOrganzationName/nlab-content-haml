                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [d, \iota_{[\hat v_1, \hat v_2]}] = 0
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mi d
                    %mo ,
                    %msub
                      %mi ι
