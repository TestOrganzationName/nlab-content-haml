                    %msub
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \hat v_2
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
