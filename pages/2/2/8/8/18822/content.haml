                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi E
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  E &amp;&amp; \overset{\text{vertical vector field}}{\longrightarrow} &amp;&amp; T_\Sigma E
                  \\\
