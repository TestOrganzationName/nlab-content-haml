                    %mspace{:width => "thickmathspace"}
                    %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Q \;\coloneqq\; \phi \,\iota_{\partial_0} dvol_\Sigma \in \Omega^{p,0}(E)
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi dvol
                      %mi Σ
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    P \;\coloneqq\; \eta^{\mu \nu} \phi_{,\mu} \, \iota_{\partial_\nu} dvol_{\Sigma} \in \Omega^{p,0}(E)
                    \\,.
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi Q
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    v_Q = -\partial_{\phi_{,0}}
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi P
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msub
                      %mo ∂
                      %mi ϕ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    v_P = - \partial_{\phi}
                    \\,.
            %p
              Hence the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} local Poisson bracket
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi P
                    %mo ,
                    %mi Q
                    %mo{:stretchy => "false"} }
                    %mo =
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi P
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi Q
                    %mi ω
                    %mo =
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{P,Q\} = \iota_{v_P} \iota_{v_Q} \omega = \iota_{\partial_0} dvol_\Sigma
                    \\,.
            %p
              More generally for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi b
                      %mn 1
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                    %mo ∈
                    %msubsup
                      %mi C
                      %mi cp
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi Σ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b_1, b_2 \in C^\infty_{cp}(\Sigma)
              two
              %a.existingWikiWord{:href => "/nlab/show/bump+functions"} bump functions
              then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi b
                      %mn 1
                    %mi P
                    %mo ,
                    %msub
                      %mi b
                      %mn 2
                    %mi Q
                    %mo{:stretchy => "false"} }
                    %mo =
                    %msub
                      %mi b
                      %mn 1
                    %msub
                      %mi b
                      %mn 2
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mn 0
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\{ b_1 P, b_2 Q \} = b_1 b_2 \iota_{\partial_0} dvol_\Sigma
                    \\,.
          #LocalPoissonBracketForDiracField.num_example
            %h6#example_6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} local Poisson bracket
                for
                %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (example
              = succeed ")," do
                %a.maruku-ref{:href => "#LagrangianDensityForDiracField"}
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
              is, according to example
              = succeed "," do
                %a.maruku-ref{:href => "#PresymplecticCurrentDiracField"}
            #eq:RecallPresymplecticCurrentOfDiracField.maruku-equation
              %span.maruku-eq-number (12)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi BFV
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mover
                      %mrow
                        %mi δ
                        %mi ψ
                      %mo ¯
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msup
                      %mi γ
                      %mi μ
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi δ
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi μ
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega_{BFV}
                    \\;=\;
                    (\overline{\delta \psi}) \, \gamma^\mu \, (\delta \psi) \, \iota_{\partial_\mu} dvol_\Sigma
                    \\,.
            %p
              Consider this specifically in
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                    %mo =
                    %mn 4
                  %annotation{:encoding => "application/x-tex"} p + 1 = 4
              in which case the components
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ψ
                      %mi α
                  %annotation{:encoding => "application/x-tex"} \psi_\alpha
              are
              = succeed "-valued" do
                %a.existingWikiWord{:href => "/nlab/show/complex+number"} complex number
              = succeed ")," do
                %a.maruku-ref{:href => "#SpacetimeAsMatrices"}
              %a.existingWikiWord{:href => "/nlab/show/tuple"} tuple
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ψ
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\psi_\alpha)
              amounts to 8 real-valued coordinate functions. By changing complex coordinates, we may equivalently consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ψ
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\psi_\alpha)
              as four coordinate functions, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mover
                        %mi ψ
                        %mo ¯
                      %mi α
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\overline{\psi}^\alpha)
              as another four independent coordinate functions.
            %p
              Using this coordinate transformation, it is immediate to find the following
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              of
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} Hamiltonian vector fields
              and their
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+forms"} Hamiltonian differential forms
              from def.
              %a.maruku-ref{:href => "#HamiltonianForms"}
              applied to
              %a.maruku-eqref{:href => "#eq:RecallPresymplecticCurrentOfDiracField"} (12)
            %table
              %thead
                %tr
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
                  %th
                    %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+form"} Hamiltonian differential form
              %tbody
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi AA
                          %msub
                            %mo ∂
                            %mrow
                              %msub
                                %mi ψ
                                %mi α
                        %annotation{:encoding => "application/x-tex"} \phantom{AA} \partial_{\psi_\alpha}
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi AA
                          %msup
                            %mrow
                              %mo (
                              %mover
                                %mrow
                                  %mi δ
                                  %mi ψ
                                %mo ¯
                              %msup
                                %mi γ
                                %mi μ
                              %mo )
                            %mi α
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ι
                            %mrow
                              %msub
                                %mo ∂
                                %mi μ
                          %msub
                            %mi dvol
                            %mi Σ
                        %annotation{:encoding => "application/x-tex"} \phantom{AA}\left(\overline{\delta \psi}\gamma^\mu\right)^\alpha\, \iota_{\partial_\mu} dvol_\Sigma
                %tr
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi AA
                          %msub
                            %mo ∂
                            %mrow
                              %msub
                                %mover
                                  %mi ψ
                                  %mo ¯
                                %mi α
                        %annotation{:encoding => "application/x-tex"} \phantom{AA} \partial_{\overline{\psi}_\alpha}
                  %td{:style => "text-align: left;"}
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mphantom
                            %mi AA
                          %msub
                            %mrow
                              %mo (
                              %msup
                                %mi γ
                                %mi μ
                              %mi ψ
                              %mo )
                            %mi α
                          %mspace{:width => "thinmathspace"}
                          %msub
                            %mi ι
                            %mrow
                              %msub
                                %mo ∂
                                %mi μ
                          %msub
                            %mi dvol
                            %mi Σ
                        %annotation{:encoding => "application/x-tex"} \phantom{AA}\left( \gamma^\mu \psi  \right)_\alpha \, \iota_{\partial_\mu} dvol_\Sigma
            %p
              and to obtain the following non-trivial
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} local Poisson brackets
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalPoissonBracket"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msub
                        %mrow
                          %mo (
                          %msup
                            %mi γ
                            %mi μ
                          %mi ψ
                          %mo )
                        %mi α
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi μ
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mrow
                          %mo (
                          %mover
                            %mi ψ
                            %mo ¯
                          %msup
                            %mi γ
                            %mi μ
                          %mo )
                        %mi β
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi μ
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mrow
                        %mo (
                        %msup
                          %mi γ
                          %mi μ
                        %mo )
                      %mi α
                    %msup
                      %mrow
                      %mi β
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi μ
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\left( \gamma^\mu \psi  \right)_\alpha \, \iota_{\partial_\mu} dvol_\Sigma
                    \\,,\,
                    \\left(\overline{\psi}\gamma^\mu\right)^\beta\, \iota_{\partial_\mu} dvol_\Sigma
                    \\right\}
                    \\;=\;
                    \\left(\gamma^\mu\right)_\alpha{}^{\beta} \, \iota_{\partial_\mu} dvol_\Sigma
                    \\,.
            %p
              Notice the signs: Due to the odd-grading of the field coordinate function
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ψ
                    %annotation{:encoding => "application/x-tex"} \psi
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \delta \psi
              has bi-degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo ,
                    %mi odd
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (1,odd)
              and the contraction operation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mi ψ
                  %annotation{:encoding => "application/x-tex"} \iota_{\psi}
              has bi-degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %mo ,
                      %mi odd
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (-1,odd)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi ψ
                      %mo ¯
                  %annotation{:encoding => "application/x-tex"} \overline{\psi}
              picks up
              %em two
              minus signs, a “cohomological” sign due to the differential form degrees, and a “supergeometric” one (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#DifferentialFormOnSuperCartesianSpaces"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ψ
                    %mover
                      %mrow
                        %mi δ
                        %mi ψ
                      %mo ¯
                    %mi ⋯
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mover
                      %mrow
                        %mi δ
                        %mi ψ
                      %mo ¯
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ψ
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{\partial_\psi} \overline{\delta \psi} \cdots
                    \=
                    (-1) (-1) \overline{\delta \psi} \,\iota_{\partial_\psi} \cdots
                    \\,.
            %p
              For the same reason, the
              %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} local Poisson bracket
              is a
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              with
              %em symmetric
              super Lie bracket:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %msub
                        %mrow
                          %mo (
                          %msup
                            %mi γ
                            %mi μ
                          %mi ψ
                          %mo )
                        %mi α
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi μ
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msup
                        %mrow
                          %mo (
                          %mover
                            %mi ψ
                            %mo ¯
                          %msup
                            %mi γ
                            %mi μ
                          %mo )
                        %mi β
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi μ
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mrow
                      %mo {
                      %msup
                        %mrow
                          %mo (
                          %mover
                            %mi ψ
                            %mo ¯
                          %msup
                            %mi γ
                            %mi μ
                          %mo )
                        %mi β
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi μ
                      %msub
                        %mi dvol
                        %mi Σ
                      %mspace{:width => "thinmathspace"}
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mrow
                          %mo (
                          %msup
                            %mi γ
                            %mi μ
                          %mi ψ
                          %mo )
                        %mi α
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mo ∂
                            %mi μ
                      %msub
                        %mi dvol
                        %mi Σ
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    \\left( \gamma^\mu \psi  \right)_\alpha \, \iota_{\partial_\mu} dvol_\Sigma
                    \\,,\,
                    \\left(\overline{\psi}\gamma^\mu\right)^\beta\, \iota_{\partial_\mu} dvol_\Sigma
                    \\right\}
                    \\;=\;
                    +
                    \\left\{
                    \\left(\overline{\psi}\gamma^\mu\right)^\beta\, \iota_{\partial_\mu} dvol_\Sigma
                    \\,,\,
                    \\left( \gamma^\mu \psi  \right)_\alpha \, \iota_{\partial_\mu} dvol_\Sigma
                    \\right\}
                    \\,.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            This concludes our discussion of general
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+a+Lagrangian"} infinitesimal symmetries of a Lagrangian
            %em
              %a{:href => "#GaugeSymmetries"} Gauge symmetries
            below. First, in the
            %a{:href => "#Observables"} next chapter
            we discuss the concept of
            %a.existingWikiWord{:href => "/nlab/show/observables"} observables
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
        .revisedby
          %p
