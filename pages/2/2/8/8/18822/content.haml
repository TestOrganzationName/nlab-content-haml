          %p The variational version replaces the vector bundle on the left with its jet bundle:
          #EvolutionaryVectorField.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"}> evolutionary vector fields
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              is “variational vertical vector field” on
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
              %a.existingWikiWord{:href => "/nlab/show/bundle"} bundle
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              out of the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msubsup
                              %mi J
