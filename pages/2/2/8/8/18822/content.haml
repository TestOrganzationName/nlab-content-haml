          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#InfinitesimalSymmetriesOfThePresymplecticPotentialCurrent
            %strong
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries"} infinitesimal symmetries
              of the
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+potential+current"} presymplectic potential current
          %p
            Evidently
            %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem I
            in
            %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
            (prop.
            = succeed ")" do
