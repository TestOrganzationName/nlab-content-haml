                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [v_1,v_2]
            %p
              This defines the structure of a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              on evolutionary vector fields.
          .proof
            %h6#proof_2 Proof
            %p
              It is clear that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
