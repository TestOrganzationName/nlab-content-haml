                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                              %mi var
                            %mo ∘
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %mo −
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %mo ∘
                            %msubsup
                              %mi ℒ
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                              %mi var
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\iota_{[v_1,v_2]^{var}}
                    \&amp; =
                    \\left[
                    \\mathcal{L}^{var}_{v_1}, \iota_{v_2}
                    \\right]
                    \\\
                    \&amp; \coloneqq
                    \\mathcal{L}^{var}_{v_1} \circ \iota_{v_2}
                    \-
