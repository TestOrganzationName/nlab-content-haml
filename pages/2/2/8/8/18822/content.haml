                %annotation{:encoding => "application/x-tex"} \,
          %p
            In the chapter
            %em
              %a{:href => "#PhaseSpace"} Phase space
            below we
            %a.existingWikiWord{:href => "/nlab/show/transgression"} transgress
            this
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} local Poisson bracket
            of
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries"} infinitesimal symmetries
            of the
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+potential+current"} presymplectic potential current
            to the “global”
            %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket"} Poisson bracket
            on the
            %em
              %a.existingWikiWord{:href => "/nlab/show/covariant+phase+space"} covariant phase space
            (def.
            %a.maruku-ref{:href => "#PoissonBracketOnHamiltonianLocalObservables"}
            below). This is the structure which then
            %a{:href => "#Quantization"} further below
            leads over to the
            %a.existingWikiWord{:href => "/nlab/show/quantization"} quantization
            (
            %a.existingWikiWord{:href => "/nlab/show/deformation+quantization"}> deformation quantization
            ) of the
            %a.existingWikiWord{:href => "/nlab/show/prequantum+field+theory"} prequantum field theory
            to a genuine
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            %a.existingWikiWord{:href => "/nlab/show/obstruction"} obstruction
            to this construction, namely the existence of special infinitesimal symmetries of the Lagrangian densities, called
            %em
              implicit
              %a.existingWikiWord{:href => "/nlab/show/gauge+symmetries"} gauge symmetries
            (discussed
            = succeed ")." do
              %a{:href => "#GaugeSymmetries"} further below
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p#InfinitesimalSymmetriesOfTheLagrangianDensity
            %strong
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries"} infinitesimal symmetries
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
          #Variation.num_defn
            %h6#definition Definition
            %p
              %strong (variation)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
              be a
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FieldsAndFieldBundles"}
            %p
              A
              %em variation
              is a
              %a.existingWikiWord{:href => "/nlab/show/vertical+vector+field"} vertical vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              on the
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} J^\infty_\Sigma(E)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#JetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/horizontal+differential+forms"} horizontal differential forms
            %p
              In the special case that the
              %a.existingWikiWord{:href => "/nlab/show/field+bundle"} field bundle
              is
              %a.existingWikiWord{:href => "/nlab/show/trivial+vector+bundle"} trivial vector bundle
              over
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              as in example
              = succeed "," do
                %a.maruku-ref{:href => "#TrivialVectorBundleAsAFieldBundle"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo =
                    %msup
                      %mi v
                      %mi a
                    %msub
                      %mo ∂
                      %mrow
                        %msup
                          %mi ϕ
                          %mi a
                    %mo +
                    %msubsup
                      %mi v
                      %mrow
                        %mo ,
                        %mi μ
                      %mi a
                    %msub
                      %mo ∂
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi μ
                          %mi a
                    %mo +
                    %msubsup
                      %mi v
                      %mrow
                        %msub
                          %mi μ
                          %mn 1
                        %msub
                          %mi μ
                          %mn 2
                      %mi a
                    %msub
                      %mo ∂
                      %mrow
                        %msubsup
                          %mi ϕ
                          %mrow
                            %msub
                              %mi μ
                              %mn 1
                            %msub
                              %mi μ
                              %mn 2
                          %mi a
                    %mo +
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"}
                    v = v^a \partial_{\phi^a} + v^a_{,\mu} \partial_{\phi^a_{,\mu}} + v^a_{\mu_1 \mu_2} \partial_{\phi^a_{\mu_1 \mu_2}} + \cdots
          %p
            The concept of variation in def.
            %a.maruku-ref{:href => "#Variation"}
            is very general, in that it allows to vary the field coordinates independently from the corresponding jets. This generality is necessary for discussion of symmetries of
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+currents"} presymplectic currents
            in def.
            %a.maruku-ref{:href => "#HamiltonianForms"}
            below. But for discussion of symmetries of
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+densities"} Lagrangian densities
            we are interested in explicitly varying just the
            %a.existingWikiWord{:href => "/nlab/show/field+%28physics%29"} field
            coordinates (def.
            %a.maruku-ref{:href => "#EvolutionaryVectorField"}
            below) and inducing from this the corresponding variations of the field derivatives (prop.
            = succeed ")" do
              %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
          %p
            In order to motivate the following definition
            %a.maruku-ref{:href => "#EvolutionaryVectorField"}
            of
            %em
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
            we follow remark
            %a.maruku-ref{:href => "#ReplacingBundleMorphismsByDifferentialOperators"}
            saying that concepts in
            %a.existingWikiWord{:href => "/nlab/show/variational+calculus"} variational calculus
            are obtained from their analogous concepts in plain
            %a.existingWikiWord{:href => "/nlab/show/differential+calculus"} differential calculus
            by replacing plain
            %a.existingWikiWord{:href => "/nlab/show/bundle+morphisms"} bundle morphisms
            by morphisms out of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/jet+bundle"} jet bundle
          %p
            Given a
            %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo →
                      %mi fb
                    %mi Σ
                  %annotation{:encoding => "application/x-tex"} E \overset{fb}{\to} \Sigma
            %em
              %a.existingWikiWord{:href => "/nlab/show/vertical+vector+field"} vertical vector field
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is a
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            of its
            %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"} vertical tangent bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi T
                    %mi Σ
                  %mi E
                %annotation{:encoding => "application/x-tex"} T_\Sigma E
            (def.
            = succeed ")," do
              %a.maruku-ref{:href => "#VerticalTangentBundle"}
            %a.existingWikiWord{:href => "/nlab/show/bundle+morphism"} bundle morphism
            of this form
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi E
                        %mtd
                        %mtd
                          %mover
