              with this vector field (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
              %a.existingWikiWord{:href => "/nlab/show/horizontal+derivative"} horizontal derivative
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi d
                      %mo ,
                      %msub
                        %mi ι
