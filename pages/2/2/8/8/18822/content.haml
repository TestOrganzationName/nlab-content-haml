                      %mo =
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} [d, \iota_{\hat v_i}]=0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
