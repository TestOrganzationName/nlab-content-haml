                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+forms"} Euler-Lagrange forms
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/formally+self-adjoint+differential+operator"} formally self-adjoint
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#MinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+derivative"} Euler-Lagrange derivative
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi δ
                      %mi EL
                    %mi L
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{EL}\mathbf{L}
                    \\;=\;
                    \\delta_{EL}L \wedge dvol_\Sigma
            %p
              (from prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/vertical+cotangent+bundle"} vertical cotangent bundle
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mrow
                        %msubsup
                          %mi J
                          %mi Σ
                          %mn ∞
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi T
                      %mi Σ
                      %mo *
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\delta_{EL}L
                    \\;\in\;
                    \\Gamma_{J^\infty_\Sigma(E)}(T^\ast_\Sigma E)
            %p
              as in example
              = succeed "." do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldsAsFieldDependentSections"}
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+derivative"} evolutionary derivative
              field-dependent
              %a.existingWikiWord{:href => "/nlab/show/differential+operator"} differential operator
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mi L
                  %annotation{:encoding => "application/x-tex"} D_{\delta_{EL}L}
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#FieldDependentDifferentialOperatorDerivative"}
              %a.existingWikiWord{:href => "/nlab/show/formally+self-adjoint+differential+operator"} formally self-adjoint
              (def.
              = succeed "):" do
                %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mi L
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mi L
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (D_{\delta_{EL}L})^\ast
                    \\;=\;
                    D_{\delta_{EL}L}
                    \\,.
            %p
              (In terms of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+complex"} Euler-Lagrange complex
              = succeed "," do
                %a.maruku-ref{:href => "#EulerLagrangeComplex"}
              %a.existingWikiWord{:href => "/nlab/show/Helmholtz+operator"} Helmholtz operator
              vanishes on the image of the
              = succeed ".)" do
                %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+operator"} Euler-Lagrange operator
          %p
            (
            %a{:href => "evolutionary+derivative#Olver93"}> Olver 93, theorem 5.92
            ) The following proof is due to
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Igor+Khavkine"} Igor Khavkine
          .proof
            %h6#proof_6 Proof
            %p
              By definition of the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mfrac
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                        %mi L
                      %mrow
                        %mi δ
                        %msup
                          %mi ϕ
                          %mi a
                    %mi δ
                    %msup
                      %mi ϕ
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi δ
                    %mi L
                    %mspace{:width => "thinmathspace"}
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\frac{\delta_{EL} L }{\delta \phi^a}
                    \\delta \phi^a
                    \\,
                    \\wedge
                    dvol_\Sigma
                    \\;=\;
                    \\delta L \,\wedge dvol_\Sigma \;+\; d(...)
                    \\,.
            %p
              Applying the
              %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                  %annotation{:encoding => "application/x-tex"} \delta
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#VariationalBicomplexOnSecondOrderJetBundleOverTrivialVectorBundleOverMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi δ
                      %mfrac
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mi L
                        %mrow
                          %mi δ
                          %msup
                            %mi ϕ
                            %mi a
                      %mo )
                    %mo ∧
                    %mi δ
                    %msup
                      %mi ϕ
                      %mi a
                    %mspace{:width => "thinmathspace"}
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %mi δ
                          %mi δ
                          %mi L
                        %mo ⏟
                      %mrow
                        %mo =
                        %mn 0
                    %mo ∧
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(\delta \frac{\delta_{EL} L }{\delta \phi^a}\right)
                    \\wedge
                    \\delta \phi^a
                    \\,
                    \\wedge
                    dvol_\Sigma
                    \\;=\;
                    \\underset{= 0}{\underbrace{\delta \delta L}} \wedge dvol_\Sigma
                    \\;+\;
                    d(...)
                    \\,.
            %p
              It follows that for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ,
                    %mi w
                  %annotation{:encoding => "application/x-tex"} v,w
              any two
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+fields"} evolutionary vector fields
              the contraction (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ContractionOfFormsWithVectorFields"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat v
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi w
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat w
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              %a.existingWikiWord{:href => "/nlab/show/variational+differential+form"} differential 2-form
              on the left is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi δ
                      %mfrac
                        %mrow
                          %msub
                            %mi δ
                            %mi EL
                          %mi L
                        %mrow
                          %mi δ
                          %msup
                            %mi ϕ
                            %mi a
                      %mo ∧
                      %mi δ
                      %msup
                        %mi ϕ
                        %mi a
                      %mo )
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo ,
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi w
                      %mi a
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msup
                      %mi v
                      %mi b
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\delta \frac{\delta_{EL} L }{\delta \phi^a}
                    \\wedge
                    \\delta \phi^a
                    \\right)(v,w)
                    \=
                    w^a
                    (\mathrm{D}_{\delta_{EL}})_a(v)
                    \-
                    v^b(\mathrm{D}_{\delta_{EL}})_b(w)
                    \\,,
            %p
              by inspection of the definition of the
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+derivative"} evolutionary derivative
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FieldDependentDifferentialOperatorDerivative"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %msub
                      %mi ι
                      %mover
                        %mi w
                        %mo{:stretchy => "false"} ^
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{\hat v}
                    \\iota_{\hat w}
                    d(...)
                    \\;=\;
                    d(...)
            %p
              by the fact (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              %a.existingWikiWord{:href => "/nlab/show/total+spacetime+derivative"} total spacetime derivative
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ProlongedEvolutionaryVectorFieldContractionAnticommutedWithHorizontalDerivative"} (2)
            %p Hence the last two equations combined give
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi w
                      %mi a
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msup
                      %mi v
                      %mi b
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi b
                    %mo{:stretchy => "false"} (
                    %mi w
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    w^a
                    (\mathrm{D}_{\delta_{EL}})_a(v)
                    \-
                    v^b(\mathrm{D}_{\delta_{EL}})_b(w)
                    \\;=\;
                    d(...)
                    \\,.
            %p
              This is the defining condition for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi{:mathvariant => "normal"} D
                      %mrow
                        %msub
                          %mi δ
                          %mi EL
                  %annotation{:encoding => "application/x-tex"} \mathrm{D}_{\delta_{EL}}
              to be
              %a.existingWikiWord{:href => "/nlab/show/formally+self-adjoint+differential+operator"} formally self-adjoint differential operator
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#FormallyAdjointDifferentialOperators"}
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Now we may finally prove that an
            %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
            is also an infinitesimal symmetry of the
            %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+equations"} Euler-Lagrange
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
          #InfinitesimalSymmetriesOfLagrangianAreAlsoSymmetriesOfTheEquationsOfMotion.num_prop
            %h6#proposition_6 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries+of+the+Lagrangian"} infinitesimal symmetries of the Lagrangian
                are also
                %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetries"} infinitesimal symmetries
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/equations+of+motion"} equations of motion
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
              then the
              %a.existingWikiWord{:href => "/nlab/show/flow"} flow
              along its prolongation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat v
              preserves the
              %a.existingWikiWord{:href => "/nlab/show/prolonged+shell"} prolonged shell
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℰ
                      %mn ∞
                    %mo ↪
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}^\infty \hookrightarrow J^\infty_\Sigma(E)
              %a.maruku-eqref{:href => "#eq:ProlongedShellInJetBundle"} (?)
              in that the
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              of the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \delta_{EL}\mathbf{L}
              along
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat v
              vanishes on
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℰ
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}^\infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %mi d
                    %mo{:stretchy => "false"} (
                    %mo .
                    %mo .
                    %mo .
                    %mo{:stretchy => "false"} )
                    %mphantom
                      %mi AAA
                    %mo ⇒
                    %mphantom
                      %mi AAA
                    %msub
                      %mi ℒ
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %msub
                      %mo{:stretchy => "false"} |
                      %mrow
                        %msup
                          %mi ℰ
                          %mn ∞
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{L}_{\hat v}\mathbf{L} = d(...)
                    \\phantom{AAA}
                    \\Rightarrow
                    \\phantom{AAA}
                    \\mathcal{L}_{\hat v} \, \delta_{EL}\mathbf{L}\vert_{\mathcal{E}^\infty} = 0
                    \\,.
          .proof
            %h6#proof_7 Proof
            %p
              Notice that for any vector field
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat v
              the
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartanHomotopyFormula"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℒ
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}_{\hat v}
              of the
              %a.existingWikiWord{:href => "/nlab/show/Euler-Lagrange+form"} Euler-Lagrange form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %mfrac
