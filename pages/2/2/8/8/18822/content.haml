                    \\end{aligned}
                    \\,,
          #HamiltonianForms.num_defn
            %h6#definition_8 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+fields"} infinitesimal symmetry of the presymplectic potential
                and
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+forms"} Hamiltonian differential forms
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+potential+current"} presymplectic potential current
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mi BFV
                  %annotation{:encoding => "application/x-tex"} \Theta_{BFV}
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:PresymplecticPotential"} (?)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo ↪
                    %msubsup
                      %mi J
                      %mi Σ
                      %mn ∞
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} \hookrightarrow J^\infty_\Sigma(E)
              for the
              %a.existingWikiWord{:href => "/nlab/show/shell"} shell
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:ShellInJetBundle"} (?)
            %p Then:
            %ol
              %li
                %p
                  An
                  %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                  variation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#Variation"}
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry"} infinitesimal symmetry
                    of the
                    %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
                  or
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+vector+field"} Hamiltonian vector field
                  if
                  %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#LieDerivativeVariational"}
                  = succeed ":" do
                    %a.existingWikiWord{:href => "/nlab/show/variational+derivative"} variational derivative
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi δ
                        %mo ∘
                        %msub
                          %mi ι
                          %mi v
                        %mo +
                        %msub
                          %mi ι
                          %mi v
                        %mo ∘
                        %mi δ
                        %mo{:stretchy => "false"} )
                        %msub
                          %mi Θ
                          %mi BFV
                        %mo =
                        %mi δ
                        %msub
                          %mover
                            %mi H
                            %mo{:stretchy => "false"} ˜
                          %mi v
                        %mphantom
                          %mi AAA
                        %mtext on
                        %mspace{:width => "thinmathspace"}
                        %mi ℰ
                      %annotation{:encoding => "application/x-tex"}
                        (\delta \circ \iota_v + \iota_v \circ \delta)  \Theta_{BFV}  = \delta \tilde H_v
                        \\phantom{AAA}
                        \\text{on}\, \mathcal{E}
                %p
                  for some variational form
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mover
                              %mi H
                              %mo{:stretchy => "false"} ˜
                            %mi v
                        %annotation{:encoding => "application/x-tex"} \tilde H_v
              %li
                %p
                  A
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+form"} Hamiltonian differential form
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi H
                      %annotation{:encoding => "application/x-tex"} H
                  (or
                  = succeed ")" do
                    %em local Hamiltonian current
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi v
                      %annotation{:encoding => "application/x-tex"} v
                  with
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi δ
                        %mi H
                        %mo =
                        %msub
                          %mi ι
                          %mi v
                        %msub
                          %mi Ω
                          %mi BFV
                        %mphantom
                          %mi AA
                        %mspace{:width => "thinmathspace"}
                        %mtext on
                        %mspace{:width => "thinmathspace"}
                        %mi ℰ
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\delta H = \iota_v \Omega_{BFV}
                        \\phantom{AA}
                        \\,
                        \\text{on}\, \mathcal{E}
                        \\,.
            %p We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi Ham
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mi H
                      %mo ,
                      %mi v
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi v
                      %mspace{:width => "thinmathspace"}
                      %mtext is a variation and
                      %mspace{:width => "thinmathspace"}
                      %msub
                        %mi ι
                        %mi v
                      %msub
                        %mi Ω
                        %mi BFV
                      %mo =
                      %mi δ
                      %mi H
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{p,0}_{\Sigma, Ham}(E)
                    \\;\coloneqq\;
                    \\left\{
                    (H,v)
                    \\;\vert\;
                    v \, \text{is a variation and}\,
                    \\iota_v \Omega_{BFV} = \delta H
                    \\right\}
            %p
              for the space of pairs consisting of a Hamiltonian differential forms
              %a.existingWikiWord{:href => "/nlab/show/on-shell"} on-shell
              and a corresponding variation.
          #HamiltonianDifferentialForms.num_prop
            %h6#proposition_8 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+Noether%27s+theorem"}> Hamiltonian Noether's theorem
                )
            %p
              A variation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is an infinitesimal symmetry of the presymplectic potential (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HamiltonianForms"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℒ
                      %mi v
                      %mi var
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Θ
                      %mi BFV
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi δ
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi v
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}^{var}_v ( \Theta_{BFV} ) = \delta \tilde H_v
              precisely if
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mi v
                    %mo ≔
                    %msub
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mi v
                    %mo −
                    %msub
                      %mi ι
                      %mi v
                    %msub
                      %mi Θ
                      %mi BFV
                  %annotation{:encoding => "application/x-tex"}
                    H_v \coloneqq \tilde H_v - \iota_v \Theta_{BFV}
            %p
              is a
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+form"} Hamiltonian differential form
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi v
                    %annotation{:encoding => "application/x-tex"} v
          .proof
            %h6#proof_9 Proof
            %p
              From the definition
              %a.maruku-eqref{:href => "#eq:LieDerivativeVariational"} (10)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi ℒ
                      %mi v
                      %mi var
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}^{var}_v
              we have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                          %mtd
                            %msubsup
                              %mi ℒ
                              %mi v
                              %mi var
                            %msub
                              %mi Θ
                              %mi BFV
                            %mo =
                            %mi δ
                            %msub
                              %mover
                                %mi H
                                %mo{:stretchy => "false"} ˜
                              %mi v
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi δ
                            %msub
                              %mi ι
                              %mi v
                            %msub
                              %mi Θ
                              %mi BFV
                            %mo +
                            %msub
                              %mi ι
                              %mi v
                            %munder
                              %munder
                                %mrow
                                  %mi δ
                                  %msub
                                    %mi Θ
                                    %mi BFV
                                %mo ⏟
                              %mrow
                                %mo =
                                %msub
                                  %mi Ω
                                  %mi BFV
                            %mo =
                            %mi δ
                            %msub
                              %mover
                                %mi H
                                %mo{:stretchy => "false"} ˜
                              %mi v
                        %mtr
                          %mtd
                            %mo ⇔
                            %mspace{:width => "thickmathspace"}
                            %mspace{:width => "thickmathspace"}
                          %mtd
                            %mi δ
                            %mrow
                              %mo (
                              %msub
                                %mover
                                  %mi H
                                  %mo{:stretchy => "false"} ˜
                                %mi v
                              %mo −
                              %msub
                                %mi ι
                                %mi v
                              %msub
                                %mi Θ
                                %mi BFV
                              %mo )
                            %mo =
                            %msub
                              %mi ι
                              %mi v
                            %msub
                              %mi Ω
                              %mi BFV
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \&amp; \mathcal{L}^{var}_v \Theta_{BFV}
                    \=
                    \\delta \tilde H_v
                    \\\
                    \\Leftrightarrow\;\;
                    \&amp;
                    \\delta \iota_v \Theta_{BFV} + \iota_v \underset{= \Omega_{BFV}}{\underbrace{\delta \Theta_{BFV}}} = \delta \tilde H_v
                    \\\
                    \\Leftrightarrow\;\;
                    \&amp;
                    \\delta \left(
                    \\tilde H_v - \iota_v \Theta_{BFV}
                    \\right)
                    \=
                    \\iota_v \Omega_{BFV}
                    \\,,
                    \\end{aligned}
            %p
              where we used the definition
              %a.maruku-eqref{:href => "#eq:PresymplecticCurrent"} (?)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi BFV
                  %annotation{:encoding => "application/x-tex"} \Omega_{BFV}
              \.
          %p
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \,
          %p
            Since therefore both the
            %a.existingWikiWord{:href => "/nlab/show/conserved+currents"} conserved currents
            from
            %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem
            as well as the
            %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+forms"} Hamiltonian differential forms
            are generators of infinitesimal
            %a.existingWikiWord{:href => "/nlab/show/symmetries"} symmetries
            of certain variational forms (namely of the
            %a.existingWikiWord{:href => "/nlab/show/Lagrangian+density"} Lagrangian density
            and of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/presymplectic+current"} presymplectic current
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Dickey+bracket"} Dickey bracket
                Lie algebra
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"} Poisson bracket Lie p+1-algebra
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
            %a.existingWikiWord{:href => "/nlab/show/transgression+of+variational+differential+forms"} transgression
            of this Lie algebra of Hamiltonian forms on the jet bundle to
            %a.existingWikiWord{:href => "/nlab/show/Cauchy+surfaces"} Cauchy surfaces
            yields a
            %a.existingWikiWord{:href => "/nlab/show/presymplectic+structure"} presymplectic structure
            on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/phase+space"} phase space
            = succeed "." do
              %a{:href => "#PhaseSpace"} below
          #LocalPoissonBracket.num_prop
            %h6#proposition_9 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Poisson+bracket+Lie+n-algebra"}> local Poisson bracket
                )
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,\mathbf{L})
              be a
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#LocalLagrangianDensityOnSecondOrderJetBundleOfTrivialVectorBundleOverMinkowskiSpacetime"}
            %p
              On the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mrow
                        %mi Σ
                        %mo ,
                        %mi Ham
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Omega^{p,0}_{\Sigma,Ham}(E)
              pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi H
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (H,v)
              of
              %a.existingWikiWord{:href => "/nlab/show/Hamiltonian+differential+forms"} Hamiltonian differential forms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                  %annotation{:encoding => "application/x-tex"} H
              with compatible variation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#HamiltonianForms"}
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Lie+bracket"} Lie bracket
            #eq:LocalPoissonLieBracket.maruku-equation
              %span.maruku-eq-number (11)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mn 2
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %msub
                      %mi Ω
                      %mi BFV
                    %mo ,
                    %mspace{:width => "thinmathspace"}
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi var
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{(H_1, v_1),\, (H_2, v_2)\right\}
                    \\;\coloneqq\;
                    (\iota_{v_1} \iota_{v_2} \Omega_{BFV},\, [v_1,v_2]^{var})
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %msub
                      %mi v
                      %mn 2
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi var
                  %annotation{:encoding => "application/x-tex"} [v_1, v_2]^{var}
              is the variational Lie bracket from def.
              = succeed "." do
                %a.maruku-ref{:href => "#LieDerivativeVariational"}
            %p
              We call this the
              = succeed "." do
                %em local Poisson Lie bracket
          .proof
            %h6#proof_10 Proof
            %p
              First we need to check that the bracket is well defined in itself. It is clear that it is linear and skew-symmetric, but what needs proof is that it does indeed land in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Ω
                        %mrow
                          %mi Σ
                          %mo ,
                          %mi Ham
                        %mrow
                          %mi p
                          %mo ,
                          %mn 0
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \Omega^{p,0}_{\Sigma,Ham}(E)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 2
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %msub
                      %mi Ω
                      %mi BFV
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ι
                      %mrow
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 1
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %msup
                          %mo{:stretchy => "false"} ]
                          %mi var
                    %msub
                      %mi Ω
                      %mi BFV
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\delta \iota_{v_2} \iota_{v_1} \Omega_{BFV}
                    \\;=\;
                    \\iota_{[v_1, v_2]^{var}} \Omega_{BFV}
                    \\,.
            %p
              With def.
              %a.maruku-ref{:href => "#LieDerivativeVariational"}
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℒ
                      %mi var
                  %annotation{:encoding => "application/x-tex"} \mathcal{L}^{var}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi var
                  %annotation{:encoding => "application/x-tex"} [-,-]^{var}
              we compute this as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi δ
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %msub
                              %mi Ω
                              %mi BFV
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mi δ
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                            %msub
                              %mi Ω
                              %mi BFV
                            %mo −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi v
                              %mn 1
                            %mo ↔
                            %msub
                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mrow
                              %mo (
                              %msubsup
                                %mi ℒ
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 1
                                %mi var
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 2
                              %msub
                                %mi Ω
                                %mi BFV
                              %mo −
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 1
                              %mi δ
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 2
                              %msub
                                %mi Ω
                                %mi BFV
                              %mo )
                            %mo −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi v
                              %mn 1
                            %mo ↔
                            %msub
                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mrow
                              %mo (
                              %msubsup
                                %mi ℒ
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 1
                                %mi var
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 2
                              %msub
                                %mi Ω
                                %mi BFV
                              %mo −
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 1
                              %msubsup
                                %mi ℒ
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 2
                                %mi var
                              %msub
                                %mi Ω
                                %mi BFV
                              %mo +
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 1
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 2
                              %munder
                                %munder
                                  %mrow
                                    %mi δ
                                    %msub
                                      %mi Ω
                                      %mi BFV
                                  %mo ⏟
                                %mrow
                                  %mo =
                                  %mn 0
                              %mo )
                            %mo −
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi v
                              %mn 1
                            %mo ↔
                            %msub
                              %mi v
                              %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} [
                            %msubsup
                              %mi ℒ
                              %mrow
                                %msub
                                  %mi v
                                  %mn 2
                              %mi var
                            %mo ,
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mn 1
                            %mo{:stretchy => "false"} ]
                            %msub
                              %mi Ω
                              %mi BFV
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mrow
                                %mo{:stretchy => "false"} [
                                %msub
                                  %mi v
                                  %mn 1
                                %mo ,
                                %msub
                                  %mi v
                                  %mn 2
                                %msup
                                  %mo{:stretchy => "false"} ]
                                  %mi var
                            %msub
                              %mi Ω
                              %mi BFV
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\delta \iota_{v_1} \iota_{v_2} \Omega_{BFV}
                    \&amp; =
                    \\tfrac{1}{2} \delta \iota_{v_1} \iota_{v_2} \Omega_{BFV}
                    \-
                    \\tfrac{1}{2} (v_1 \leftrightarrow v_2)
                    \\\
                    \&amp; =
                    \\tfrac{1}{2}
                    \\left(
                    \\mathcal{L}^{var}_{v_1} \iota_{v_2} \Omega_{BFV}
                    \-
                    \\iota_{v_1} \delta \iota_{v_2} \Omega_{BFV}
                    \\right)
                    \-
                    \\tfrac{1}{2} (v_1 \leftrightarrow v_2)
                    \\\
                    \&amp; =
                    \\tfrac{1}{2}
                    \\left(
                    \\mathcal{L}^{var}_{v_1} \iota_{v_2} \Omega_{BFV}
                    \-
                    \\iota_{v_1} \mathcal{L}^{var}_{v_2} \Omega_{BFV}
                    +
                    \\iota_{v_1} \iota_{v_2} \underset{= 0}{\underbrace{\delta \Omega_{BFV}}}
                    \\right)
                    \-
                    \\tfrac{1}{2} (v_1 \leftrightarrow v_2)
                    \\\
                    \&amp; =
                    [\mathcal{L}^{var}_{v_2}, \iota_{v_1}] \Omega_{BFV}
                    \\\
                    \&amp; =
                    \\iota_{[v_1, v_2]^{var}} \Omega_{BFV}
                    \\,.
                    \\end{aligned}
            %p This shows that the bracket is well defined.
            %p
              It remains to see that the bracket satifies the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi H
                        %mn 1
                      %mo ,
                      %msub
                        %mi v
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mrow
                        %mo {
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi H
                          %mn 2
                        %mo ,
                        %msub
                          %mi v
                          %mn 2
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi H
                          %mn 3
                        %mo ,
                        %msub
                          %mi v
                          %mn 3
                        %mo{:stretchy => "false"} )
                        %mo }
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi cyclic
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{ (H_1, v_1), \left\{ (H_2, v_2), (H_3,v_3) \right\} \right\}
                    \\;+\; (cyclic)
                    \\;=\;
                    0
            %p hence that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %msub
                        %mi ι
                        %mrow
                          %msub
                            %mi v
                            %mn 1
                      %msub
                        %mi ι
                        %mrow
                          %mo{:stretchy => "false"} [
                          %msub
                            %mi v
                            %mn 2
                          %mo ,
                          %msub
                            %mi v
                            %mn 3
                          %msup
                            %mo{:stretchy => "false"} ]
                            %mi var
                      %msub
                        %mi Ω
                        %mi BFV
                      %mo ,
                      %mspace{:width => "thinmathspace"}
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi v
                        %mn 1
                      %mo ,
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi v
                        %mn 2
                      %mo ,
                      %msub
                        %mi v
                        %mn 2
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi var
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mi var
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo +
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi cyclic
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(  \iota_{v_1} \iota_{[v_2,v_3]^{var}}  \Omega_{BFV} ,\,   [v_1, [v_2, v_2]^{var}]^{var} \right)
                    \\;+\; (cyclic)
                    \\;=\; 0
                    \\,.
            %p
              Here
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 2
                    %mo ,
                    %msub
                      %mi v
                      %mn 3
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi var
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi var
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi cyclic
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} [v_1, [v_2, v_3]^{var}]^{var} + (cyclic) = 0
              holds because by def.
              %a.maruku-ref{:href => "#LieDerivativeVariational"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msub
                      %mi v
                      %mn 1
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mi var
                  %annotation{:encoding => "application/x-tex"} [v_1,-]^{var}
              acts as a derivation, and hence what remains to be shown is that
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mn 1
                    %msub
                      %mi ι
                      %mrow
                        %mo (
                        %mo{:stretchy => "false"} [
                        %msub
                          %mi v
                          %mn 2
                        %mo ,
                        %msub
                          %mi v
                          %mn 3
                        %msup
                          %mo{:stretchy => "false"} ]
                          %mi var
                        %mo )
                    %msub
                      %mi Ω
                      %mi BFV
                    %mo +
                    %mo{:stretchy => "false"} (
                    %mi cyclic
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_1} \iota_{\left([v_2, v_3]^{var}\right)}   \Omega_{BFV} + (cyclic) = 0
            %p
              We check this by repeated uses of def.
              = succeed "," do
                %a.maruku-ref{:href => "#LieDerivativeVariational"}
            %ol
              %li
                %p
