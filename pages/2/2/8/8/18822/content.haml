            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/vertical+tangent+bundle"} vertical tangent bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
