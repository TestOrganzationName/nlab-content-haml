          #HorizontallyExactFormsDropOutOfLocalLieBracket.num_lemma
            %h6#lemma Lemma
            %p
              The horizontally exact Hamiltonian forms constitute a
              %a.existingWikiWord{:href => "/nlab/show/Lie+ideal"} Lie ideal
              for the local Poisson Lie bracket
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:LocalPoissonLieBracket"} (11)
          .proof
            %h6#proof_11 Proof
            %p
