                              %mo [
                              %msubsup
                                %mi ℒ
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 1
                                %mi var
                              %mo ,
                              %msub
                                %mi ι
                                %mrow
                                  %msub
                                    %mi v
                                    %mn 2
                              %mo ]
                        %mtr
                          %mtd
                          %mtd
