              a presymplectic potential
              %a.maruku-eqref{:href => "#eq:PresymplecticPotential"} (?)
              from def.
              = succeed "." do
                %a.maruku-ref{:href => "#EulerLagrangeOperatorForTivialVectorBundleOverMinkowskiSpacetime"}
          %p
            (
            %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem II
            is prop.
            %a.maruku-ref{:href => "#NoetherIdentities"}
            below.)
          .proof
            %h6#proof_3 Proof
            %p
              By
              %a.existingWikiWord{:href => "/nlab/show/Cartan%27s+homotopy+formula"} Cartan's homotopy formula
              for the
              %a.existingWikiWord{:href => "/nlab/show/Lie+derivative"} Lie derivative
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#CartanHomotopyFormula"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi δ
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"} \delta \mathbf{L}
              %a.maruku-eqref{:href => "#eq:dLDecomposition"} (?)
              and the fact that contraction
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \iota_{\hat v}
              with the prolongtion of an evolutionary vector field vanishes on horizontal differential forms
              %a.maruku-eqref{:href => "#eq:GenericComponentsForProlongationOfEvolutionaryVectorField"} (1)
              and anti-commutes with the horizontal differential
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:ProlongedEvolutionaryVectorFieldContractionAnticommutedWithHorizontalDerivative"} (2)
              = succeed "," do
                %a.maruku-ref{:href => "#EvolutionaryVectorField"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi d
                            %msub
                              %mover
                                %mi J
                                %mo{:stretchy => "false"} ˜
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                          %mtd
                            %mo =
                            %msub
                              %mi ℒ
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %munder
                              %munder
                                %mrow
                                  %mstyle{:mathvariant => "bold"}
                                    %mi d
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                %mo ⏟
                              %mrow
                                %mo =
                                %msub
                                  %mi δ
                                  %mi EL
                                %mstyle{:mathvariant => "bold"}
                                  %mi L
                                %mo −
                                %mi d
                                %msub
                                  %mi Θ
                                  %mi BFV
                            %mo +
                            %mstyle{:mathvariant => "bold"}
                              %mi d
                            %munder
                              %munder
                                %mrow
                                  %msub
                                    %mi ι
                                    %mi v
                                  %mstyle{:mathvariant => "bold"}
                                    %mi L
                                %mo ⏟
                              %mrow
                                %mo =
                                %mn 0
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %msub
                              %mi ι
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %msub
                              %mi δ
                              %mi EL
                            %mstyle{:mathvariant => "bold"}
                              %mi L
                            %mo +
                            %mi d
                            %msub
                              %mi ι
                              %mover
                                %mi v
                                %mo{:stretchy => "false"} ^
                            %msub
                              %mi Θ
                              %mi BFV
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d \tilde J_{\hat v}
                    \&amp; =
                    \\mathcal{L}_{\hat v} \mathbf{L}
                    \\\
                    \&amp; =
                    \\iota_{\hat v} \underset{= \delta_{EL}\mathbf{L} - d \Theta_{BFV}}{\underbrace{\mathbf{d} \mathbf{L}}}
                    +
                    \\mathbf{d} \underset{= 0}{\underbrace{\iota_v \mathbf{L}}}
                    \\\
                    \&amp; =
                    \\iota_{\hat v} \delta_{EL} \mathbf{L}
                    + d \iota_{\hat v} \Theta_{BFV}
                    \\end{aligned}
            %p which is equivalent to
            #eq:CurrentNoetherConservation.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo{:stretchy => "false"} (
                    %munder
                      %munder
                        %mrow
                          %msub
                            %mover
                              %mi J
                              %mo{:stretchy => "false"} ˜
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} ^
                          %mo −
                          %msub
                            %mi ι
                            %mover
                              %mi v
                              %mo{:stretchy => "false"} ^
                          %msub
                            %mi Θ
                            %mi BFV
                        %mo ⏟
                      %mrow
                        %mo =
                        %msub
                          %mi J
                          %mover
                            %mi v
                            %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ι
                      %mover
                        %mi v
                        %mo{:stretchy => "false"} ^
                    %msub
                      %mi δ
                      %mi EL
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                  %annotation{:encoding => "application/x-tex"}
                    d(\underset{= J_{\hat v}}{\underbrace{\tilde J_{\hat v} - \iota_{\hat v} \Theta_{BFV}}})
                    \\;=\;
                    \\iota_{\hat v} \delta_{EL}\mathbf{L}
            %p
              Since, by definition of the
              %a.existingWikiWord{:href => "/nlab/show/shell"} shell
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              this yields the claim.
          #ScalarFieldEnergyMomentum.num_example
            %h6#example Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/energy-momentum"} energy-momentum
                of the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field"} free
              %a.existingWikiWord{:href => "/nlab/show/scalar+field"} scalar field
              from def.
              = succeed ":" do
                %a.maruku-ref{:href => "#LagrangianForFreeScalarFieldOnMinkowskiSpacetime"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:displaystyle => "false"}
                      %mfrac
                        %mn 1
                        %mn 2
                    %mrow
                      %mo (
                      %msup
                        %mi η
                        %mrow
                          %mi μ
                          %mi ν
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi μ
                      %msub
                        %mi ϕ
                        %mrow
                          %mo ,
                          %mi ν
                      %mo −
                      %msup
                        %mi m
                        %mn 2
                      %msup
                        %mi ϕ
                        %mn 2
                      %mo )
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L}
                    \\;=\;
                    \\tfrac{1}{2}
                    \\left(
                    \\eta^{\mu \nu}\phi_{,\mu} \phi_{,\nu}
                    \-
                    m^2 \phi^2
                    \\right)
                    dvol_\Sigma
                    \\,.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ν
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mi p
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \nu \in \{0, 1, \cdots, p\}
              consider the vector field on the jet bundle given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi v
                      %mi ν
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi ν
                    %msub
                      %mo ∂
                      %mi ϕ
                    %mo +
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                        %mi ν
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi ϕ
                          %mrow
                            %mo ,
                            %mi μ
                    %mo +
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    v_\nu
                    \\;\coloneqq\;
                    \\phi_{,\nu} \partial_{\phi}
                    +
                    \\phi_{,\mu \nu} \partial_{\phi_{,\mu}}
                    +
                    \\cdots
                    \\,.
            %p
              This describes infinitesimal translations of the fields in the direction of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mo ∂
                        %mi ν
                    %annotation{:encoding => "application/x-tex"} \partial_\nu
            %p
              And this is an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mi v
                          %mi ν
                    %mstyle{:mathvariant => "bold"}
                      %mi d
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %mi d
                    %mi L
                    %mo ∧
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\iota_{v_\nu} \mathbf{d}\mathbf{L}
                    \=
                    d L \wedge \iota_{\partial_\nu} dvol_\Sigma
                    \\,.
            %p
              With the formula
              %a.maruku-eqref{:href => "#eq:PresymplecticPotentialOfFreeScalarField"} (?)
              for the presymplectic potential
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Θ
                      %mi BFV
                    %mo =
                    %msup
                      %mi η
                      %mrow
                        %mi μ
                        %mi ν
                    %msub
                      %mi ϕ
                      %mrow
                        %mo ,
                        %mi μ
                    %mi δ
                    %mi ϕ
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi ν
                    %msub
                      %mi dvol
                      %mi Σ
                  %annotation{:encoding => "application/x-tex"}
                    \\Theta_{BFV}
                    \=
                    \\eta^{\mu \nu} \phi_{,\mu} \delta \phi \iota_{\partial_{\nu}} dvol_\Sigma
            %p
              it hence follows from
              %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#NoethersFirstTheorem"}
              %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi T
                              %mi ν
                          %mtd
                            %mo =
                            %mi L
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi ν
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo −
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mi v
                                  %mi ν
                            %msub
                              %mi Θ
                              %mi BFV
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mi L
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi ν
                            %msub
                              %mi dvol
                              %mi Σ
                            %mo −
                            %msup
                              %mi η
                              %mrow
                                %mi ρ
                                %mi μ
                            %msub
                              %mi ϕ
                              %mrow
                                %mo ,
                                %mi ρ
                            %msub
                              %mi ϕ
                              %mrow
                                %mo ,
                                %mi ν
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi μ
                            %msub
                              %mi dvol
                              %mi Σ
                        %mtr
                          %mtd
                          %mtd
                            %mo =
                            %mo{:stretchy => "false"} (
                            %munder
                              %munder
                                %mrow
                                  %msubsup
                                    %mi δ
                                    %mi ν
                                    %mi μ
                                  %mi L
                                  %mo −
                                  %msup
                                    %mi η
                                    %mrow
                                      %mi ρ
                                      %mi μ
                                  %msub
                                    %mi ϕ
                                    %mrow
                                      %mo ,
                                      %mi ρ
                                  %msub
                                    %mi ϕ
                                    %mrow
                                      %mo ,
                                      %mi ν
                                %mo ⏟
                              %mrow
                                %mo =
                                %mo :
                                %msubsup
                                  %mi T
                                  %mi ν
                                  %mi μ
                            %mo{:stretchy => "false"} )
                            %mspace{:width => "thinmathspace"}
                            %msub
                              %mi ι
                              %mrow
                                %msub
                                  %mo ∂
                                  %mi μ
                            %msub
                              %mi dvol
                              %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    T_\nu
                    \&amp; =
                    L \, \iota_{\partial_\nu} dvol_\Sigma
                    \-
                    \\iota_{v_\nu}\Theta_{BFV}
                    \\\
                    \&amp;
                    \=
                    L \, \iota_{\partial_\nu} dvol_\Sigma
                    \-
                    \\eta^{\rho \mu} \phi_{,\rho} \phi_{,\nu}
                    \\,
                    \\iota_{\partial_\mu} dvol_\Sigma
                    \\\
                    \&amp;  =
                    (
                    \\underset{=: T^\mu_\nu}{
                    \\underbrace{
                    \\delta^\mu_\nu  L
                    \-
                    \\eta^{\rho \mu} \phi_{,\rho} \phi_{,\nu}
                    }
                    }
                    )
                    \\,
                    \\iota_{\partial_\mu} dvol_\Sigma
                    \\end{aligned}
                    \\,.
            %p
              This
              %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
              is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/energy-momentum+tensor"} energy-momentum tensor
          #DiracCurrent.num_example
            %h6#example_2 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Dirac+current"}> Dirac current
                )
            %p
              Consider the
              %a.existingWikiWord{:href => "/nlab/show/Lagrangian+field+theory"} Lagrangian field theory
              of the
              %a.existingWikiWord{:href => "/nlab/show/free+field+theory"} free
              %a.existingWikiWord{:href => "/nlab/show/Dirac+field"} Dirac field
              on
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              in spacetime dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo +
                    %mn 1
                    %mo =
                    %mn 3
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} p + 1 = 3+1
              (example
              = succeed ")" do
                %a.maruku-ref{:href => "#LagrangianDensityForDiracField"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi L
                    %mo =
                    %mi i
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi γ
                      %mi μ
                    %msub
                      %mi ψ
                      %mrow
                        %mo ,
                        %mi μ
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{L} = i \overline{\psi} \gamma^\mu \psi_{,\mu} \, dvol_\Sigma
                    \\,.
            %p
              Then the prolongation (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorFieldProlongation"}
              %a.existingWikiWord{:href => "/nlab/show/evolutionary+vector+field"} evolutionary vector field
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EvolutionaryVectorField"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi i
                    %msub
                      %mi ψ
                      %mi α
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi ψ
                          %mi α
                  %annotation{:encoding => "application/x-tex"}
                    v \;\coloneqq\; i \psi_\alpha \partial_{\psi_\alpha}
            %p
              is an
              %a.existingWikiWord{:href => "/nlab/show/infinitesimal+symmetry+of+the+Lagrangian"} infinitesimal symmetry of the Lagrangian
              (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#SymmetriesAndConservedCurrents"}
              %a.existingWikiWord{:href => "/nlab/show/conserved+current"} conserved current
              that corresponds to this under
              %a.existingWikiWord{:href => "/nlab/show/Noether%27s+theorem"} Noether's theorem I
              (prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#NoethersFirstTheorem"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mover
                      %mi ψ
                      %mo ¯
                    %msup
                      %mi γ
                      %mi μ
                    %mi ψ
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi ι
                      %mrow
                        %msub
                          %mo ∂
                          %mi μ
                    %msub
                      %mi dvol
                      %mi Σ
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mi Σ
                      %mrow
                        %mi p
                        %mo ,
                        %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    i
                    \\overline{\psi} \gamma^\mu \psi \, \iota_{\partial_\mu} dvol_\Sigma
                    \\;\in\;
                    \\Omega^{p,0}_{\Sigma}(E)
                    \\,.
            %p
              This is called the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Dirac+current"} Dirac current
          .proof
            %h6#proof_4 Proof
            %p
              By equation
              %a.maruku-eqref{:href => "#eq:ProlongationOfEvolutionaryVectorFieldExplicit"} (4)
              the prolongation of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi v
                      %mo{:stretchy => "false"} ^
                    %mo =
                    %mi i
                    %msub
                      %mi ψ
                      %mi α
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi ψ
                          %mi α
                    %mo +
                    %mi i
                    %msub
                      %mi ψ
                      %mrow
                        %mi α
                        %mo ,
                        %mi μ
                    %msub
                      %mo ∂
                      %mrow
                        %msub
                          %mi ψ
                          %mrow
                            %mi α
                            %mo ,
                            %mi μ
                    %mo +
                    %mi ⋯
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\hat v
                    \=
                    i \psi_\alpha \partial_{\psi_\alpha}
                    +
                    i \psi_{\alpha,\mu} \partial_{\psi_{\alpha,\mu}}
                    +
                    \\cdots
                    \\,.
