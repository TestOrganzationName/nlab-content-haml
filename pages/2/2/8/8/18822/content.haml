                          %mn 2
                        %mo{:stretchy => "false"} ]
                      %mo ^
                  %annotation{:encoding => "application/x-tex"} \widehat{[v_1, v_2]}
              of a unique evolutionary vector field
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %msub
