                      %mi A
                      %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (S_a)_{(a\colon A)}
            generates
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            under colimits
          %p More generally:
          .num_defn
            %h6#definition_5 Definition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              is a subclass of epimorphisms, we say that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi a
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:lspace => "verythinmathspace"} :
                        %mi A
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S_a)_{(a\colon A)}
              is an
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
                \-separator
              or
              %strong
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
                \-generator
              if each morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ε
                      %mi X
                  %annotation{:encoding => "application/x-tex"} \varepsilon_X
              (as above) is in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
          %p
            The weakest commonly-seen strengthened notion is that of
            = succeed "," do
              %strong extremal separator
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi ε
                    %mi X
                %annotation{:encoding => "application/x-tex"} \varepsilon_X
            are
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/extremal+epimorphisms"} extremal epimorphisms
          #Extremal.num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small
              and has all small
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi I
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S_i)_{(i\colon I)}
              is an extremal separator if and only if the functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo →
                    %mi{:mathvariant => "normal"} Set
                  %annotation{:encoding => "application/x-tex"} C(S_i,-):C\to\mathrm{Set}
              are jointly faithful and jointly
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/conservative+functor"} conservative
          .proof
            %h6#proof Proof
            %p
              Assume first that the family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi I
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S_i)_{(i\colon I)}
              is an extremal separator. The functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi C
                    %mo →
                    %mi{:mathvariant => "normal"} Set
                  %annotation{:encoding => "application/x-tex"} C(S_i,-):C\to\mathrm{Set}
              are jointly faithful for every separator. To see that they are also jointly conservative, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} f:A\to B
              such that all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(S_i,f)
              are bijective. Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ε
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \varepsilon_B
              factors through
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              since all its components do, which implies that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is an extremal epi since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ε
                      %mi B
                  %annotation{:encoding => "application/x-tex"} \varepsilon_B
              is one by assumption. It remains to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              is a monomorphism. For this, let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo ,
                    %mi v
                    %mo :
                    %mi X
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} u,v:X\to A
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mi u
                      %mo =
                      %mi f
                      %mi v
                    %annotation{:encoding => "application/x-tex"} f u = f v
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mi u
                    %mi h
                    %mo =
                    %mi f
                    %mi v
                    %mi h
                  %annotation{:encoding => "application/x-tex"} f u h = f v h
              for all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i\in I
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi h
                      %mo :
                      %msub
                        %mi S
                        %mi i
                      %mo →
                      %mi X
                    %annotation{:encoding => "application/x-tex"} h:S_i\to X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mi h
                    %mo =
                    %mi v
                    %mi h
                  %annotation{:encoding => "application/x-tex"} u h = v h
              since the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(S_i,f)
              are bijective, and we conclude that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %mi v
                  %annotation{:encoding => "application/x-tex"} u=v
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi I
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S_i)_{(i\colon I)}
              is separating.
            %p
              Conversely, assume that the functors
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(S_i,-)
              are jointly faithful and jointly conservative. Given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} A\in C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ε
                      %mi A
                  %annotation{:encoding => "application/x-tex"} \varepsilon_A
              is epic. To see that it is extremally so, assume a factorization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ε
                      %mi A
                    %mo =
                    %mi m
                    %mi g
                  %annotation{:encoding => "application/x-tex"} \varepsilon_A = m g
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              monic. We have to show that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is an isomorphism, and for this it is sufficient to show that all
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %mo ,
                    %mi m
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(S_i,m)
              are bijections. Injectivity is clear since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is monic, and surjectivity follows since every
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %msub
                      %mi S
                      %mi i
                    %mo →
                    %mi A
                  %annotation{:encoding => "application/x-tex"} h:S_i\to A
              factors through
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ε
                        %mi A
                    %annotation{:encoding => "application/x-tex"} \varepsilon_A
          %p
            The concepts “strong separator” and “regular separator” corresponding to the notions of
            %a.existingWikiWord{:href => "/nlab/show/strong+epimorphism"} strong epimorphism
            and
            %a.existingWikiWord{:href => "/nlab/show/regular+epimorphism"} regular epimorphism
            do not admit such a reformulation, but the following result shows that they are equivalent to extremal separators in reasonable categories.
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Assume that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small
              and has all small
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            %ol
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is balanced, then every separator is extremal.
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  has pullbacks, then every extremal separator is strong.
              %li
                %p
                  If
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  is
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular
            %p The converse implications do always hold.
          .proof
            %h6#proof_2 Proof
            %p This is a direct consequence of the facts that
            %ol
              %li
                %p in a balanced category every epi is extremal,
              %li
                %p in a category with pullbacks, every extremal epi is strong, and
              %li
                %p in a regular category every strong epi is regular.
          .un_remark
            %h6#remarks Remarks
            %ol
              %li
                %p
                  Proposition
                  %a.maruku-ref{:href => "#Extremal"}
                  gives rise to a notion of extremal separator that makes sense independently of the existence of coproducts. In fact claim 1 of the preceding result holds in this more general setting, since every faithful functor out of a balanced category is conservative.
              %li
                %p
                  Most of the literature uses the term “strong separator” (or strong generator) for what we call an extremal separator.
                  %a{:href => "#AdamekRosicky"} Adamek and Rosicky (Section 0.6)
                  also comment on this mismatch, writing “It would be more reasonable, but unfortunately less standard, to call [a strong generator] an extremal generator”. However, item 2 of the preceding result shows that this discrepancy disappears and the terms coincide in presence of pullbacks (and coproducts).
              %li
                %p
                  In the Elephant, Johnstone uses “separator” in the same sense as we do, and writes “generator” for extremal separators, in the more general sense not assuming coproducts. Since he always assumes finite limits, he can use a simplified criterion only requiring joint conservativity of the hom-functors (since a conservative functor
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo :
                        %mi C
                        %mo →
                        %mi D
                      %annotation{:encoding => "application/x-tex"} F:C\to D
                  is automatically faithful whenever
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                      %annotation{:encoding => "application/x-tex"} C
                  has equalizers and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                      %annotation{:encoding => "application/x-tex"} F
                  preserves them).
          %h3#dense_separators Dense separators
          %p
            Finally, the strongest kind of separator commonly seen is that of
            = succeed "." do
              %strong dense separator
          .num_defn
            %h6#definition_6 Definition
            %p
              A
              %strong dense separator
              in a category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is a family
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi S
                      %mi i
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi i
                        %mo{:lspace => "verythinmathspace"} :
                        %mi I
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (S_i)_{(i\colon I)}
              of objects such that the generated full subcategory is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/dense+subcategory"} dense
          %p
            Every dense separator is an extremal separator, and it is also strong and regular whenever those words make sense, i.e.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is locally small and has small coproducts. If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            furthermore has pullbacks and the coproducts are pullback-stable, then every regular separator is dense (see
            = succeed ")." do
              %a{:href => "#Borceux"} Borceux I, Proposition 4.5.6
          %h3#girauds_axioms Giraud’s axioms
          %p
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos#Giraud"} Giraud's axioms
            characterize Grothendieck toposes as locally small regular categories with effective equivalence relations and disjoint and pullback-stable coproducts admitting a small separator. The previously stated and cited results show that in fact every such separator is dense (the effectivity and disjointness assumptions don’t play a role for this conclusion).
