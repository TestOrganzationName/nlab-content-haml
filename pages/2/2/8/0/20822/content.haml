              ,
              = succeed "," do
                %em Gerbes and Massive Type II Configurations
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/hep-th/9905018"} arXiv:hep-th/9905018
          %h4#D6D8BoundStatesWithDefects D6-D8-brane bound states with D2-D4-brane defects
          %p
