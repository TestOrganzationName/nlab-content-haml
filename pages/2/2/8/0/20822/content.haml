            %a.existingWikiWord{:href => "/nlab/show/black+brane"} black
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mspace{:width => "thickmathspace"}
                %annotation{:encoding => "application/x-tex"} \;
            %a.existingWikiWord{:href => "/nlab/show/D6-D8-brane+bound+states"} D6-D8-brane bound states
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/massive+type+IIA+string+theory"} massive type IIA string theory
            %a.existingWikiWord{:href => "/nlab/show/defect+QFT"} defect
            %a.existingWikiWord{:href => "/nlab/show/D2-D4-brane+bound+states"} D2-D4-brane bound states
