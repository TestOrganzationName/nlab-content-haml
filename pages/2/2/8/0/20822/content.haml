                2018 (
                %a{:href => "http://physics.ipm.ac.ir/conferences/stringtheory3/note/N.Petri.pdf"}> pdf
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Giuseppe+Dibitetto"}> Giuseppe Dibitetto
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicol%C3%B2+Petri"} Nicolò Petri
                %em
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
