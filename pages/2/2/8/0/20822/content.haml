                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Anayeli+Ramirez"} Anayeli Ramirez
                %em
                  Two dimensional
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
