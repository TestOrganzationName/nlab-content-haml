                              %mi Σ
                              %mi n
                          %annotation{:encoding => "application/x-tex"} \Sigma_n
                %li
                  %p
                    the composition operation satisfies
                    %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
                    and
                    %a.existingWikiWord{:href => "/nlab/show/unitality"} unitality
                    in the obvious way;
                %li
                  %p
                    and is
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi Σ
                            %mi n
                        %annotation{:encoding => "application/x-tex"} \Sigma_n
                    equivariant in the evident way.
          %p
            An equivalent term for a colored operad in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+multicategory"} symmetric multicategory
            which is
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} horizontal categorification
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            a “colored
            = succeed "\u201D" do
              %a.existingWikiWord{:href => "/nlab/show/monoid"} monoid
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            a “colored
            = succeed "\u201D.)" do
              %a.existingWikiWord{:href => "/nlab/show/group"} group
          %h3#relation_to_symmetric_monoidal_categories Relation to symmetric monoidal categories
          %p
            Every
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            %a.existingWikiWord{:href => "/nlab/show/strict+monoidal+category"} strict monoidal category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            has an underlying colored operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo =
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ,
                  %mo ×
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} V = (Set, \times)
            where the set of colors is the set of all objects of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            and each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi c
                    %mn 1
                  %mo ,
                  %mi ⋯
                  %mo ,
                  %msub
                    %mi c
                    %mi n
                  %mo ;
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} P(c_1, \cdots, c_n; c)
            is the set of all morphisms from
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi c
                    %mn 1
                  %mo ⊗
                  %mi ⋯
                  %mo ⊗
                  %msub
                    %mi c
                    %mi n
                %annotation{:encoding => "application/x-tex"} c_1 \otimes \cdots \otimes c_n
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ,
                  %mo ×
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Set, \times)
            freely generates a symmetric strict monoidal category. This gives rise to an adjunction between the category of colored operads in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Set
                  %mo ,
                  %mo ×
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Set, \times)
            and the category of strict symmetric monoidal categories (
            %a{:href => "#ElmendorfMandell2007"}> Elmendorf-Mandell 2007
            ).
          %p
            There is also an analogous adjunction between
            %em non-symmetric
            colored operads, better known as
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/multicategories"} multicategories
            = succeed ")." do
              %a{:href => "Hermida2000"} Hermida 2000
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/multicategory#relation_to_monoidal_categories"} Multicategory: relation to monoidal categories
          %p
            This 2-categorical treatment was later generalized to the symmetric case (
            %a{:href => "#Weber2009"}> Weber 2009
            ). Namely, there is a forgetful 2-functor from the 2-category of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+categories"} symmetric monoidal categories
            %a.existingWikiWord{:href => "/nlab/show/lax+monoidal+functors"} lax monoidal functors
            and
            %a.existingWikiWord{:href => "/nlab/show/monoidal+natural+transformations"} monoidal natural transformations
            to a 2-category of colored operads in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo ,
                    %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Set, \times)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo ,
                    %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Set, \times)
          %h3#algebras Algebras
          %p
            An
            %em
              %a.existingWikiWord{:href => "/nlab/show/algebra+over+an+operad"} algebra over an operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is just a semantics for interpreting the
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(n)
            as objects of actual
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            consists of a collection of maps
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %mi n
                  %mo →
                  %mi v
                %annotation{:encoding => "application/x-tex"} F(n) \otimes v^{\otimes n} \to v
          %p which intuitively is a mapping like this:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi θ
                  %mo ⊗
                  %msub
                    %mi x
                    %mn 1
                  %mo ⊗
                  %mi …
                  %mo ⊗
                  %msub
                    %mi x
                    %mi n
                  %mo ↦
                  %mi θ
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi x
                    %mn 1
                  %mo ,
                  %mi …
                  %mo ,
                  %msub
                    %mi x
                    %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \theta \otimes x_1 \otimes \ldots \otimes x_n \mapsto \theta(x_1, \ldots, x_n)
          %p
            so that “elements” of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F(n)
            are interpreted as as
            = succeed "-ary" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                  %annotation{:encoding => "application/x-tex"} v
          %p
            Perhaps the quickest way to define it is to suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is symmetric monoidal
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
            %a.existingWikiWord{:href => "/nlab/show/representations"} representations
            or
            %a.existingWikiWord{:href => "/nlab/show/modules"} modules
            work. Just as an
            = succeed "-module" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed ")" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi R
                  %mo →
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi A
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} R \to \hom(A, A)
          %p
            where the hom here is an internal hom of abelian groups, called an
            = succeed "," do
              %em
                %a.existingWikiWord{:href => "/nlab/show/endomorphism+ring"} endomorphism ring
            %em
              %a.existingWikiWord{:href => "/nlab/show/endomorphism+operad"} endomorphism operad
            attached to any object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            in a symmetric monoidal closed category, and an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is the same thing as an operad morphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo →
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %mo •
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F \to \hom(v^{\otimes \bullet}, v)
          %p
            to an endomorphism operad (also called a
            = succeed ")." do
              %em tautological operad
          %p Now that the clue has been given, the rest is not hard to figure out. The components of the endomorphism operad are defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi End
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %mi n
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} End(v)(n) = \hom(v^{\otimes n}, v)
          %p
            Certainly
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi S
                    %mi n
                %annotation{:encoding => "application/x-tex"} S_n
            acts on the right (that is, contravariantly) on the
            %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi hom
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi v
                      %mrow
                        %mo ⊗
                        %mi n
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \hom(v^{\otimes n}, v)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi e
                  %mo :
                  %mi I
                  %mo →
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %mi v
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} e: I \to \hom(v, v)
            to play the role of the unit. The operad composition involves an instance of enriched functoriality of iterated tensor products: there is a map
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %msub
                        %mi n
                        %mn 1
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi …
                  %mo ⊗
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %msub
                        %mi n
                        %mi k
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi v
                    %mrow
                      %msub
                        %mi n
                        %mn 1
                      %mo +
                      %mi …
                      %mo +
                      %msub
                        %mi n
                        %mi k
                  %mo ,
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %mi k
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hom(v^{\otimes n_1}, v) \otimes \ldots \otimes \hom(v^{\otimes n_k}, v) \to \hom(v^{n_1 + \ldots + n_k}, v^{\otimes k})
          %p
            The endomorphism operad composition is obtained by tensoring this last arrow with
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %mi k
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hom(v^{\otimes k}, v)
            on the left, and composing the result with ordinary internal hom-composition
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %mi k
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %msub
                        %mi n
                        %mn 1
                      %mo +
                      %mi …
                      %mo +
                      %msub
                        %mi n
                        %mi k
                  %mo ,
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %mi k
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi v
                    %mrow
                      %mo ⊗
                      %msub
                        %mi n
                        %mn 1
                      %mo +
                      %mi …
                      %mo +
                      %msub
                        %mi n
                        %mi k
                  %mo ,
                  %mi v
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \hom(v^{\otimes k}, v) \otimes \hom(v^{\otimes n_1 + \ldots + n_k}, v^{\otimes k}) \to \hom(v^{\otimes n_1 + \ldots + n_k}, v)
          %p
            A closely related way of defining an
            = succeed "-algebra" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %p
            Note that this definition still makes sense when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                %annotation{:encoding => "application/x-tex"} v
            lives in any symmetric monoidal
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            itself.
          %h2#Conceptual A detailed conceptual treatment
          %p
            We describe here a compact one-sentence definition of operad first worked out by
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
            %a.existingWikiWord{:href => "/nlab/show/enriched+category+theory"} enriched category theory
            and the formalism of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            first, that is for categories
            %a.existingWikiWord{:href => "/nlab/show/enriched+category"} enriched in
            = succeed ";" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo =
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} V = Set
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                %annotation{:encoding => "application/x-tex"} V
            is completely parallel.
          %p
            More details along these lines are add
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/toddtrimble/published/Towards+a+doctrine+of+operads"} Towards a doctrine of operads
          %h3#preparation Preparation
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℙ
                %annotation{:encoding => "application/x-tex"} \mathbb{P}
            be the
            %a.existingWikiWord{:href => "/nlab/show/groupoid"} groupoid
            of finite cardinals with
            %a.existingWikiWord{:href => "/nlab/show/bijections"} bijections
            as morphisms – the
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/permutation+category"} permutation category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℙ
                %annotation{:encoding => "application/x-tex"} \mathbb{P}
            is the
            %a.existingWikiWord{:href => "/nlab/show/core"} core
            groupoid of the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fin
                %annotation{:encoding => "application/x-tex"} Fin
            of finite cardinals and functions between them, the
            %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fin
                %annotation{:encoding => "application/x-tex"} Fin
            restricts to a symmetric monoidal product called the cardinal sum on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℙ
                  %annotation{:encoding => "application/x-tex"} \mathbb{P}
          .un_remark{:style => "margin-left:2em"}
            %h6#remark Remark
            %p
              Under this symmetric monoidal structure,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℙ
                  %annotation{:encoding => "application/x-tex"} \mathbb{P}
              may be characterized as the free symmetric strict monoidal category on one generator.
          %p
            The cardinal sum on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℙ
                %annotation{:encoding => "application/x-tex"} \mathbb{P}
            extends along the
            %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
            to a symmetric monoidal product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ⊗
                  %mi G
                %annotation{:encoding => "application/x-tex"} F \otimes G
            on the
            %a.existingWikiWord{:href => "/nlab/show/presheaf+category"} presheaf category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℙ
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P}) \coloneqq [\mathbb{P}^{op},Set]
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Day+convolution"} Day convolution
          .un_note{:style => "margin-left:2em"}
            %h6#warning Warning
            %p
              By abuse of notation, we will also denote the presheaf category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
              equipped with the monoidal structure induced by the cardinal sum by
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Psh
                      %mo{:stretchy => "false"} (
                      %mi ℙ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
            is a presheaf category, it is cocomplete, and since the Day convolution is
            %a.existingWikiWord{:href => "/nlab/show/cocontinuous+functor"} cocontinuous
            in each of its separate arguments we say that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
            is
            = succeed "." do
              %strong symmetric monoidally cocomplete
          .un_note{:style => "margin-left:2em"}
            %h6#note Note
            %p
              In addition to the standard
              %a.existingWikiWord{:href => "/nlab/show/coend"} coend
              formula, the Day convolution product on the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
              may be described by the rule:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ⊗
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} [
                    %mi S
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi S
                        %mo =
                        %mi T
                        %mo +
                        %mi U
                    %mi F
                    %mo{:stretchy => "false"} [
                    %mi T
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi G
                    %mo{:stretchy => "false"} [
                    %mi U
                    %mo{:stretchy => "false"} ]
                    %mo ,
                  %annotation{:encoding => "application/x-tex"} (F \otimes G)[S] = \sum_{S = T + U} F[T] \times G[U],
            %p
              summing over all partitions of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              into two parts (each possibly empty).
          %p
            According to the yoga of presheaf categories and Day convolution, given a symmetric monoidally cocomplete category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mi ℙ
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} X: \mathbb{P} \to D
          %p
            extends uniquely up to isomorphism to a symmetric monoidal
            %em cocontinuous
            functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                  %mo ,
                %annotation{:encoding => "application/x-tex"} \hat{X}: Psh(\mathbb{P}) \to D,
          %p
            taking a presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi W
                  %mo :
                  %msup
                    %mi ℙ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} W: \mathbb{P}^{op} \to Set
            to the
            %a.existingWikiWord{:href => "/nlab/show/weighted+colimit"} weighted colimit
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo ⋅
                    %mi X
                  %annotation{:encoding => "application/x-tex"} W \cdot X
          .un_remark{:style => "margin-left:2em"}
            %h6#remark_2 Remark
            %p
              It follows from the earlier remark and the above that we may describe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
              universally up to equivalence as the free symmetric monoidally cocomplete category on a single generator.
          .un_note{:style => "margin-left:2em"}
            %h6#digression Digression
            %p
              Recall that we can describe
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %msub
                      %mo ⋅
                      %mi ℙ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} W \cdot_{\mathbb{P}} X
              as follows: First note that the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Λ
                      %mn 0
                    %mo ≔
                    %msub
                      %mi Hom
                      %mi D
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mo ⋅
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⋅
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %msup
                      %mi ℙ
                      %mi op
                    %mo ×
                    %mi D
                    %mo →
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\Lambda_0
                    \\coloneqq
                    Hom_D(X(\cdot),\cdot)
                    \\colon
                    \\mathbb{P}^{op}\times D\to Set
                    \\,,
            %p
              so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Λ
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} \Lambda_0
              also gives a functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                    %mo :
                    %mi D
                    %mo →
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi ℙ
                      %mi op
                    %mo ,
                    %mi Set
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Lambda: D\to [\mathbb{P}^{op},Set]
              by
              %a.existingWikiWord{:href => "/nlab/show/currying"} currying
              through the second coordinate.
            %p
              Then we define
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %msub
                      %mo ⋅
                      %mi ℙ
                    %mi X
                  %annotation{:encoding => "application/x-tex"} W \cdot_{\mathbb{P}} X
              to be the object representing the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Λ
                      %mi W
                    %mo ≔
                    %msub
                      %mi Hom
                      %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ,
                    %mi Λ
                    %mo{:stretchy => "false"} (
                    %mo ⋅
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi D
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \Lambda_W \coloneqq Hom_Psh(\mathbb{P})(W,\Lambda(\cdot)):D\to Set
            %p
              whenever
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Λ
                      %mi W
                  %annotation{:encoding => "application/x-tex"} \Lambda_W
              is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/representable+functor"} representable
            %p In general, weighted colimits may be described explicitly by coend formulas; here
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %msub
                      %mo ⋅
                      %mi ℙ
                    %mi X
                    %mo =
                    %msup
                      %mo ∫
                      %mrow
                        %mi k
                        %mo :
                        %mi ℙ
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W \cdot_{\mathbb{P}} X = \int^{k: \mathbb{P}} F(k) \cdot X(k)
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⋅
                    %mi d
                  %annotation{:encoding => "application/x-tex"} S \cdot d
              denotes the tensoring of a set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              with an object
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              = succeed "-indexed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi k
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %msub
                      %mi S
                      %mi k
                    %mo ⋅
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⇉
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi k
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mo ∫
                      %mi k
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_k W(k) \cdot S_k \cdot X(k) \rightrightarrows \sum_k W(k) \cdot X(k) \to \int^k W(k) \cdot X(k)
            %p
              where one of the parallel arrows involves right actions of symmetric groups
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi k
                  %annotation{:encoding => "application/x-tex"} S_k
              on the
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} F(k)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi k
                  %annotation{:encoding => "application/x-tex"} S_k
              on objects
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %msub
                      %mo ⋅
                      %mi ℙ
                    %mi X
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi k
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi S
                          %mi k
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} W \cdot_{\mathbb{P}} X = \sum_k W(k) \otimes_{S_k} X(k).
          %p
            The aforementioned universal property of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
            with its convolution product may be more explicitly described as follows: given a symmetric monoidally cocomplete category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi D
                %annotation{:encoding => "application/x-tex"} D
            and an object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi d
                %annotation{:encoding => "application/x-tex"} d
            therein, there exists up to isomorphism a
            %em unique
            symmetric monoidal cocontinuous functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi D
                %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P}) \to D
            which sends the presheaf representable by the cardinal
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} 1
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi h
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} h_1
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                  %annotation{:encoding => "application/x-tex"} d
          %p
            Explicitly, this functor takes a presheaf
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi ℙ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F: \mathbb{P}^{op} \to Set
            to the following object of
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi k
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi S
                        %mi k
                  %msup
                    %mi d
                    %mrow
                      %mo ⊗
                      %mi k
                  %mo .
                %annotation{:encoding => "application/x-tex"} \sum_k F(k) \otimes_{S_k} d^{\otimes k}.
          #analytic.num_example{:style => "margin-left:2em"}
            %h6#example Example
            %p
              When
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi D
                  %annotation{:encoding => "application/x-tex"} D
              is the symmetric monoidally cocomplete category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo ,
                    %mo ×
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Set, \times)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              is a set, this formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi k
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %msub
                          %mi S
                          %mi k
                    %msup
                      %mi x
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \hat{F}(x) = \sum_k F(k) \otimes_{S_k} x^k
            %p
              is the value at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              of what Joyal calls the
              %em analytic functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \hat{F}: Set \to Set
              associated to a
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+species"} species
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                    %annotation{:encoding => "application/x-tex"} F
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/generating+function"} generating function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ↦
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \mapsto \hat{F}(x)
              is symmetric monoidal (cocontinuous) means that there is a canonical isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi F
                        %msub
                          %mo ⊗
                          %mi Day
                        %mi G
                        %mo{:stretchy => "false"} )
                      %mo ^
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mover
                      %mi G
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \widehat{(F \otimes_{Day} G)}(x) \cong \hat{F}(x) \times \hat{G}(x)
            %p
              In other words,
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ↦
                    %mover
                      %mi F
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} F \mapsto \hat{F}
              behaves like a categorified version of Fourier transform, taking convolution products to ordinary (pointwise) products.
          .un_definition
            %p
              For symmetric monoidally cocomplete categories
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ,
                      %mi D
                    %annotation{:encoding => "application/x-tex"} C, D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Hom
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \underline{Hom}(C, D)
              denote the category of symmetric monoidal cocontinuous functors
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo →
                      %mi D
                    %annotation{:encoding => "application/x-tex"} C \to D
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
              means that we have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Hom
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi D
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi D
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \underline{Hom}(Psh(\mathbb{P}), D) \simeq D.
            %p
              Consequently, we have an equivalence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi Hom
                      %mo ̲
                    %mo{:stretchy => "false"} (
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} \underline{Hom}(Psh(\mathbb{P}), Psh(\mathbb{P})) \simeq Psh(\mathbb{P}).
            %p
              Since symmetric monoidal cocontinuous functors are stable under composition, the category on the left carries a monoidal product given by endofunctor composition. By transport of structure across the equivalence, we induce a monoidal product on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
              given by endofunctor composition called the
              = succeed "." do
                %em substitution product of species
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ,
                    %mi G
                  %annotation{:encoding => "application/x-tex"} F, G
              is denoted
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi F
                      %mo ∘
                      %mi G
                    %annotation{:encoding => "application/x-tex"} F \circ G
          %p
            In detail: a species
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo{:lspace => "verythinmathspace"} :
                  %msup
                    %mi ℙ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} G \colon \mathbb{P}^{op} \to Set
            induces a symmetric monoidal cocontinuous functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                  %mo →
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi F
                  %mo ↦
                  %mi F
                  %mo ∘
                  %mi G
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi k
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi S
                        %mi k
                  %msup
                    %mi G
                    %mrow
                      %msub
                        %mo ⊗
                        %mi Day
                      %mi k
                %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P}) \to Psh(\mathbb{P}): F \mapsto F \circ G = \sum_k F(k) \otimes_{S_k} G^{\otimes_{Day} k}
          %p
            The
            = succeed "-fold" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is given (in the language of species) by the formula
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi G
                    %mrow
                      %mo ⊗
                      %mi k
                  %mo{:stretchy => "false"} [
                  %mi S
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi S
                      %mo =
                      %msub
                        %mi T
                        %mn 1
                      %mo +
                      %mi …
                      %mo +
                      %msub
                        %mi T
                        %mi k
                  %mi G
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi G
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi T
                    %mn 2
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi …
                  %mo ×
                  %mi G
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi T
                    %mi k
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} G^{\otimes k}[S] = \sum_{S = T_1 + \ldots + T_k} G[T_1] \times G[T_2] \times \ldots \times G[T_k]
          %p
            where we sum over all ways of breaking up a finite set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            into
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            blocks, some possibly empty. Thus we have an explicit description of the substitution product,
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo ∘
                  %mi G
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mi k
                  %mi F
                  %mo{:stretchy => "false"} [
                  %mi k
                  %mo{:stretchy => "false"} ]
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi S
                        %mi k
                  %mo{:stretchy => "false"} (
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %msub
                        %mi T
                        %mn 1
                      %mo +
                      %mi …
                      %mo +
                      %msub
                        %mi T
                        %mi k
                  %mi G
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi T
                    %mn 1
                  %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi …
                  %mo ×
                  %mi G
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} |
                  %msub
                    %mi T
                    %mi k
                  %mo{:stretchy => "false"} |
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo ,
                %annotation{:encoding => "application/x-tex"} (F \circ G)[n] = \sum_k F[k] \otimes_{S_k} (\sum_{[n] = T_1 + \ldots + T_k} G[|T_1|] \times \ldots \times G [|T_k|]),
          %p
            and it is clear from our discussion above that substitution is a monoidal product. The monoidal unit
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                %annotation{:encoding => "application/x-tex"} I
            is a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℙ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \mathbb{P}^{op} \to Set
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi I
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} I[n]
            is terminal if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n = 1
          %h3#DefinitionAsMonoid Definition as monoid
          %p
            We are at last ready for the one-sentence
            = succeed ":" do
              %strong definition
          %p
            A (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            \-based)
            %strong operad
            is a
            %a.existingWikiWord{:href => "/nlab/show/monoid+in+a+monoidal+category"} monoid
            in the
            %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ∘
                    %mo ,
                    %mi I
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Psh(\mathbb{P}), \circ, I)
          %h3#remarks Remarks
          %ul
            %li#CartesianOperads
              %p
                We can get different flavors of operads by considering different notions of ambient
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
                plays the role of the free (strict) monoidal category on one generator, and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi ℕ
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{\mathbb{N}^{op}}
                the free monoidally cocomplete category on one generator. Similarly, for braided monoidal categories, we have the braid category
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔹
                      %annotation{:encoding => "application/x-tex"} \mathbb{B}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi 𝔹
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{\mathbb{B}^{op}}
                is the free braided monoidally cocomplete category on one generator. Again, for cartesian categories, we have
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Fin
                        %mi op
                    %annotation{:encoding => "application/x-tex"} Fin^{op}
                (the opposite of finite sets and functions) as the
                %a.existingWikiWord{:href => "/nlab/show/free+cartesian+category"} free cartesian category
                on one generator, and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mi Fin
                    %annotation{:encoding => "application/x-tex"} Set^{Fin}
                is the free cartesian monoidally cocomplete category on one generator. In each of these cases we get a corresponding notion of operad by following the above treatment
                = succeed ":" do
                  %em mutatis mutandis
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theories
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+multicategory"} generalized multicategory
            %li
              %p
                All of the above carries over to the enriched setting, where we work over a complete, cocomplete symmetric monoidal closed base category
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℕ
                        %mo ,
                        %mi ℙ
                        %mo ,
                        %mi 𝔹
                        %mo ,
                        %mi Fin
                      %annotation{:encoding => "application/x-tex"} \mathbb{N}, \mathbb{P}, \mathbb{B}, Fin
                = succeed "-enriched" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/hom-set"} hom-set
                %a.existingWikiWord{:href => "/nlab/show/hom-objects"} hom-objects
                by applying the change of base functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo →
                      %mi V
                    %annotation{:encoding => "application/x-tex"} Set \to V
              %p
                that takes a set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
                to the
                = succeed "-fold" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo ⋅
                        %mi I
                      %annotation{:encoding => "application/x-tex"} S \cdot I
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi I
                    %annotation{:encoding => "application/x-tex"} I
                is the monoidal unit of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/generalized+multicategories"} generalized multicategories
            %li
              %p
                The notion of generalized muticategories is even more general than this; for instance it also includes
                %a.existingWikiWord{:href => "/nlab/show/globular+operads"} globular operads
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
                %a.existingWikiWord{:href => "/nlab/show/generalized+multicategory"} generalized multicategory
                for details.
            %li
              %p
                In still other directions, there are for example notions of
                %a.existingWikiWord{:href => "/nlab/show/cyclic+operad"} cyclic operad
                and
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/modular+operad"} modular operad
            %li
              %p It is sometimes useful to consider an alternative definition of operad based on “partial” composition operations
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi sub
                        %mi i
                      %mo :
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi m
                      %mo +
                      %mi n
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} sub_i: C(m) \times C(n) \to C(m+n-1)
              %p
                which encode the idea of substituting an
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo −
                      %mi th
                    %annotation{:encoding => "application/x-tex"} i-th
                argument of an
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi m
                      %annotation{:encoding => "application/x-tex"} m
                = succeed "-ary" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi m
                        %mo +
                        %mi n
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (m+n-1)
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/non-unital+operad"} non-unital operad
                = succeed ")." do
                  %a{:href => "#MarklShniderStasheff"} (Markl, Shnider, and Stasheff)
                = succeed "," do
                  %a{:href => "#Markl2008"} (Markl 2008)
                %a{:href => "#FresseHOGTG"} (Fresse, HOGTG I)
                for a more detailed discussion).
            %li
              %p
                Finally, some authors place restrictions on operations of arity zero (a.k.a. nullary operations, or “constants”). May’s original definition
                %a{:href => "#May1972"} (1972)
                required exactly one nullary operation, while the definition in
                %a{:href => "#MarklShniderStasheff"} (Markl, Shnider, and Stasheff)
                considers only operations of positive arity. Fresse gives a special status to these two restricted forms of operads, referring to them respectively as
                %strong unitary operads
                and
                %strong non-unitary operads
                (see 3.1.10 of
                %a{:href => "#FresseMOF"} (Fresse 2009)
                and 1.1.19
                = succeed ")." do
                  %a{:href => "#FresseHOGTG"} (Fresse, HOGTG I)
                %em not
                the complement of unitary operads (which have exactly one nullary operation), nor are they the same thing as non-unital operads (which have no identity operation). As an example, Stasheff’s original presentation of the
                %a.existingWikiWord{:href => "/nlab/show/associahedra"} associahedra
                %a{:href => "#Stasheff63a"} (Stasheff 1963)
                implicitly defined an operad which was
                %em both
                non-unitary and non-unital.
          %h2#the_monad_attached_to_an_operad The monad attached to an operad
          %p
            Each
            = succeed "-based" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            gives rise to a monad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{M}
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mo ∘
                  %mo ,
                  %mi I
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (Psh(\mathbb{P}), \circ, I)
            acts on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            in such a way as to give an
            %a.existingWikiWord{:href => "/nlab/show/actegory"} actegory
            structure, and therefore an operad or
            = succeed "-monoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∘
                  %annotation{:encoding => "application/x-tex"} \circ
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} Set
          %p Here are the details. There is a functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi Set
                  %mo →
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i: Set \to Psh(\mathbb{P})
          %p
            which sends a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            to the functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                  %mo :
                  %msup
                    %mi ℙ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} \hat{X}: \mathbb{P}^{op} \to Set
          %p
            taking
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi n
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [n]
            to
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            if
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n = 0
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            as giving a set of 0-ary operations or constants indexed by itself. Notice that the composite
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Set
                  %mover
                    %mo →
                    %mrow
                      %mn 1
                      %mo ×
                      %mi i
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mo ∘
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P}) \times Set \stackrel{1 \times i}{\to} Psh(\mathbb{P}) \times Psh(\mathbb{P}) \stackrel{\circ}{\to} Psh(\mathbb{P})
          %p
            factors through the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo :
                  %mi Set
                  %mo →
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i: Set \to Psh(\mathbb{P})
            (conceptually, when one applies a formal operation to constants, the result is again a constant). This gives an action
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi ℙ
                  %mo{:stretchy => "false"} )
                  %mo ×
                  %mi Set
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P}) \times Set \to Set
          %p
            for an actegory structure; as it is the restriction of the substitution product
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∘
                %annotation{:encoding => "application/x-tex"} \circ
            along the inclusion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            in the second argument, we again denote it
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∘
                  %annotation{:encoding => "application/x-tex"} \circ
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %msup
                    %mi ℙ
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F: \mathbb{P}^{op} \to Set
            and a set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo ∘
                  %mi X
                  %mo ≅
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                    %mrow
                      %mi k
                      %mo ≥
                      %mn 0
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi k
                  %mo{:stretchy => "false"} )
                  %msub
                    %mo ⊗
                    %mrow
                      %msub
                        %mi S
                        %mi k
                  %msup
                    %mi X
                    %mi k
                %annotation{:encoding => "application/x-tex"} F \circ X \cong \sum_{k \geq 0} F(k) \otimes_{S_k} X^k
          %p
            and given
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo :
                    %msup
                      %mi ℙ
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} G: \mathbb{P}^{op} \to Set
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo ∘
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi X
                    %mo ≅
                    %mi F
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ∘
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (F \circ G) \circ X \cong F \circ (G \circ X)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo ∘
                    %mi X
                    %mo ≅
                    %mi X
                  %annotation{:encoding => "application/x-tex"} I \circ X \cong X
          .un_def
            %h6#definition Definition
            %p
              The
              %strong monad
              associated with an operad
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi m
                    %mo :
                    %mi M
                    %mo ∘
                    %mi M
                    %mo →
                    %mi M
                    %mo ,
                    %mi u
                    %mo :
                    %mi I
                    %mo →
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M, m: M \circ M \to M, u: I \to M)
              is the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi M
                      %mo{:stretchy => "false"} ^
                    %mo :
                    %mi Set
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} \hat{M}: Set \to Set
              taking
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mo ∘
                      %mi X
                    %annotation{:encoding => "application/x-tex"} M \circ X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi M
                      %mo{:stretchy => "false"} ^
                    %mover
                      %mi M
                      %mo{:stretchy => "false"} ^
                    %mi X
                    %mo =
                    %mi M
                    %mo ∘
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ∘
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo ≅
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ∘
                    %mi M
                    %mo{:stretchy => "false"} )
                    %mo ∘
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %mi m
                        %mo ∘
                        %mi X
                    %mi M
                    %mo ∘
                    %mi X
                    %mo =
                    %mover
                      %mi M
                      %mo{:stretchy => "false"} ^
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \hat{M} \hat{M} X = M \circ (M \circ X) \cong (M \circ M) \circ X \stackrel{m \circ X}{\to} M \circ X = \hat{M} X
            %p []
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ≅
                    %mi I
                    %mo ∘
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %mi u
                        %mo ∘
                        %mi X
                    %mi M
                    %mo ∘
                    %mi X
                    %mo =
                    %mover
                      %mi M
                      %mo{:stretchy => "false"} ^
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X \cong I \circ X \stackrel{u \circ X}{\to} M \circ X = \hat{M} X
            %p
              which provide
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi M
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat{M}
              with the structure of a monad.
          %p This definition of the associated monad carries over with ease to the enriched case, and to variants such as nonpermutative operads, braided operads, and cartesian operads (Lawvere theories).
          %p
            Notice that an algebra for the operad
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi M
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat{M}
            is a set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            equipped with a structure map
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi α
                  %mo :
                  %mi M
                  %mo ∘
                  %mi X
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} \alpha: M \circ X \to X
            which makes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i(X)
            a
            %a.existingWikiWord{:href => "/nlab/show/module"} module
            over the monoid
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            in the monoidal category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Psh
                    %mo{:stretchy => "false"} (
                    %mi ℙ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Psh(\mathbb{P})
          %p
            See also related discussion at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/club"} club
          %h2#examples Examples
