                    %mo →
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} F U F U A_i \stackrel{\overset{\varepsilon F U A_i}{\to}}{\underset{F U \varepsilon A_i}{\to}} F U A_i \to A_i
            %p
              and since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi U
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F(\sum_i U A_i)
              is the coproduct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi F
                    %mi U
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \sum_i F U A_i
              in the category of algebras, i.e., since coproducts of free algebras exist, the coproduct of the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} A_i
              is constructed as a coequalizer of the pair
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi ε
                    %mi F
                    %mi U
                    %msub
                      %mi A
                      %mi i
                    %mo ,
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi F
                    %mi U
                    %mi ε
                    %msub
                      %mi A
                      %mi i
                    %mo{:stretchy => "false"} )
                    %mo :
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi F
                    %mi U
                    %mi F
                    %mi U
                    %msub
                      %mi A
                      %mi i
                    %mover
                      %mo →
                      %mo →
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi i
                    %mi F
                    %mi U
                    %msub
                      %mi A
                      %mi i
                  %annotation{:encoding => "application/x-tex"} (\sum_i \varepsilon F U A_i, \sum_i F U \varepsilon A_i): \sum_i F U F U A_i \stackrel{\to}{\to} \sum_i F U A_i
            %p
              obtained by summing over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                  %annotation{:encoding => "application/x-tex"} i
              each of the parallel pairs.
          %h2#over_a_cocomplete_cartesian_closed_category Over a cocomplete cartesian closed category
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            is a
            %a.existingWikiWord{:href => "/nlab/show/finitary+monad"} finitary monad
            defined on a cocomplete cartesian closed category
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi T
                %annotation{:encoding => "application/x-tex"} T
            preserves
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/reflexive+coequalizer"} reflexive coequalizer
            = succeed ")," do
              %a{:href => "http://nlab.mathforge.org/nlab/show/reflexive+coequalizer#applications_4"} here
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %msup
                    %mi X
                    %mi T
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} U: X^T \to X
          %p
            reflects reflexive coequalizers (since the underlying functor reflects classes of colimits preserved by the monad). Since the parallel pairs in the proof of the preceding proposition are reflexive, we see by adapting that proof that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi X
                    %mi T
                %annotation{:encoding => "application/x-tex"} X^T
            has coproducts. It remains only to prove the following.
          .un_lem
            %h6#lemma_3 Lemma
            %p If a category has finite coproducts and reflexive coequalizers, then it has general coequalizers.
          .proof
            %h6#proof_4 Proof
            %p
              Given a parallel pair
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                      %mo :
                      %mi A
                      %mover
                        %mo →
                        %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f, g: A \stackrel{\to}{\to} B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo ,
                    %msub
                      %mn 1
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} (
                    %mi g
                    %mo ,
                    %msub
                      %mn 1
                      %mi B
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %mo +
                    %mi B
                    %mover
                      %mo →
                      %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} (f, 1_B), (g, 1_B): A + B \stackrel{\to}{\to} B
            %p
              whose coequalizer is the coequalizer of the pair
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo ,
                      %mi g
                    %annotation{:encoding => "application/x-tex"} f, g
