                admits a selection
            %p is satisfied.
          %p
            For now we omit giving the proof (given in
            = succeed ")." do
              %a{:href => "#Michael56"} Michael
          %p Before applying this theorem, we need a few lemmas that play supporting roles.
          #pullback.num_lemma
            %h6#lemma_2 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi X
                    %mo ↛
                    %mi B
                  %annotation{:encoding => "application/x-tex"} (R, p, q): X \nrightarrow B
              is entire, lsc, closed and convex, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f: A \to X
              is a continuous map, then the pullback relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mi R
                    %mo ,
                    %mi r
                    %mo ,
                    %mi q
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi A
                    %mo ↛
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} (f^\ast R, r, q g): A \nrightarrow Y
              (as in the pullback diagram)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi f
                              %mo *
                            %mi R
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mi R
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi r
                            %mo ↙
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi pb
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↙
                            %mpadded{:width => "0"}
                              %mi p
                          %mtd
                          %mtd
                            %mo ↘
                            %mpadded{:width => "0"}
                              %mi q
                          %mtd
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                            %munder
                              %mo →
                              %mi f
                          %mtd
                            %mi X
                          %mtd
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp; &amp; f^\ast R &amp; \stackrel{g}{\to} &amp; R &amp; &amp; \\
                    \&amp; \mathllap{r} \swarrow &amp; (pb) &amp; \swarrow \mathrlap{p} &amp; &amp; \searrow \mathrlap{q} &amp; \\
                    A &amp; \underset{f}{\to} &amp; X &amp; &amp; &amp; &amp; B
                    }
            %p is also entire, lsc, closed and convex.
          .proof
            %h6#proof_3 Proof
            %p
              Clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
              is surjective (being a pullback of a surjection), so the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi R
                  %annotation{:encoding => "application/x-tex"} f^\ast R
              is entire, and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} a \in A
              we have
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mi R
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi a
                    %mo =
                    %msub
                      %mi R
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi a
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^\ast R)_a = R_{f(a)}
              so that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi R
                  %annotation{:encoding => "application/x-tex"} f^\ast R
              is closed and convex if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is. We also have
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mi g
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                    %mo =
                    %msub
                      %mo ∃
                      %mi r
                    %msup
                      %mi g
                      %mo *
                    %msup
                      %mi q
                      %mo *
                    %mo =
                    %msup
                      %mi f
                      %mo *
                    %msub
                      %mo ∃
                      %mi p
                    %msup
                      %mi q
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \exists_r (q g)^\ast = \exists_r g^\ast q^\ast = f^\ast \exists_p q^\ast
            %p
              where the second equation follows from a Beck-Chevalley equation (induced by the pullback square). The map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi p
                    %msup
                      %mi q
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \exists_p q^\ast
              preserves openness since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is lsc, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                  %annotation{:encoding => "application/x-tex"} f^\ast
              preserves openness by continuity, so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∃
                      %mi r
                    %mo{:stretchy => "false"} (
                    %mi q
                    %mi g
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \exists_r (q g)^\ast
              preserves openness, which proves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi f
                      %mo *
                    %mi R
                  %annotation{:encoding => "application/x-tex"} f^\ast R
              is lsc.
          %p The next result is an important observation about extending continuous selections.
          #extension.num_lemma
            %h6#lemma_3 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              satisfies the condition
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo •
                  %annotation{:encoding => "application/x-tex"} \bullet
              of Theorem
              %a.maruku-ref{:href => "#Michael"}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi A
                    %mo ↪
                    %mi X
                  %annotation{:encoding => "application/x-tex"} f: A \hookrightarrow X
              is a closed embedding, then for every
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                      %mo :
                      %mi X
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} (R, p, q): X \to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo :
                    %mi A
                    %mo →
                    %msup
                      %mi f
                      %mo *
                    %mi R
                  %annotation{:encoding => "application/x-tex"} \sigma: A \to f^\ast R
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi f
                      %mo *
                    %mi R
                    %mo ,
                    %mi r
                    %mo ,
                    %mi q
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (f^\ast R, r, q g)
              can be extended to a selection of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo ,
                      %mi p
                      %mo ,
                      %mi q
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (R, p, q)
          .proof
            %h6#proof_4 Proof
            %p
              Replace the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              by the relation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mrow
                        %mi f
                        %mo{:stretchy => "false"} (
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} S_{f(x)} = \{\sigma(x)\}
              if
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi x
                    %mo =
                    %msub
                      %mi R
                      %mi x
                  %annotation{:encoding => "application/x-tex"} S_x = R_x
              if
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∉
                      %mi f
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} x \notin f(A)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mi x
                  %annotation{:encoding => "application/x-tex"} S_x
              is closed, convex, and inhabited, so
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is closed and convex and entire. We check that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is lsc. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              be open in
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi π
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \pi_X(S \cap (X \times V))
              is an interior point of that set. If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mo ¬
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in \neg A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ¬
                    %mi A
                    %mo ∩
                    %msub
                      %mi π
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo ¬
                    %mi A
                    %mo ∩
                    %msub
                      %mi π
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \neg A \cap \pi_X(S \cap (X \times V)) = \neg A \cap \pi_X(R \cap (X \times V)
            %p
              is open. If
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x \in A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              there is open neighborhood
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                  %annotation{:encoding => "application/x-tex"} U
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ′
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} \sigma(x') \in V
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ′
                      %mo ∈
                      %mi U
                      %mo ∩
                      %mi A
                    %annotation{:encoding => "application/x-tex"} x' \in U \cap A
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi U
                    %mo ∩
                    %msub
                      %mi π
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ⊆
                    %msub
                      %mi π
                      %mi X
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ∩
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ×
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} U \cap \pi_X(R \cap (X \times V)) \subseteq \pi_X(S \cap (X \times V))
            %p
              so that the left side is an open neighborhood of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              contained within the right side. Thus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is lsc.
            %p
              Since hypothesis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo •
                  %annotation{:encoding => "application/x-tex"} \bullet
              holds for
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              admits a selection
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                    %annotation{:encoding => "application/x-tex"} \tau
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              we must have that
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi τ
                      %msub
                        %mo{:stretchy => "false"} |
                        %mi A
                      %mo =
                      %mi σ
                    %annotation{:encoding => "application/x-tex"} \tau |_A = \sigma
          %h2#applications_to_colimits_of_paracompact_hausdorff_spaces Applications to colimits of paracompact Hausdorff spaces
          %p Now we put Michael’s selection theorem to use in developing colimits of paracompact Hausdorff spaces.
          #ClosedEmbeddingsOfParacompactaClosedUnderPushout.num_theorem
            %h6#theorem_2 Theorem
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ,
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} X, Y, Z
              are paracompact Hausdorff spaces and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                    %mo :
                    %mi X
                    %mo →
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} h: X \to Z
              is a closed embedding and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f: X \to Y
              is a continuous map, then in the pushout diagram in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi h
                          %mtd
                            %mi Z
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi g
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo →
                              %mi k
                          %mtd
                            %mi W
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp; \stackrel{h}{\to} &amp; Z \\
                    \\mathllap{f} \downarrow &amp; &amp; \downarrow \mathrlap{g} \\
                    Y &amp; \underset{k}{\to} &amp; W,
                    }
            %p
              the space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is a paracompact Hausdorff space (and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo :
                    %mi Y
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} k: Y \to W
              is a closed embedding, by Lemma
              = succeed ")." do
                %a.maruku-ref{:href => "#poclosed"}
          %p
            (Compare a similar result for normal spaces,
            = succeed ".)" do
              %a{:href => "https://ncatlab.org/nlab/show/colimits+of+normal+spaces#attach"} here
          .proof
            %h6#proof_5 Proof
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mover
                      %mo ←
                      %mi p
                    %mi R
                    %mover
                      %mo →
                      %mi q
                    %mi B
                  %annotation{:encoding => "application/x-tex"} W \stackrel{p}{\leftarrow} R \stackrel{q}{\to} B
              be an entire, lsc, closed and convex relation to a Banach space
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              admits a section. That
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              is
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi T
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} T_1
              is easy: a point
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                    %mo ∈
                    %mi W
                  %annotation{:encoding => "application/x-tex"} x \in W
              either belongs to the closed subspace
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo ↪
                    %mi W
                  %annotation{:encoding => "application/x-tex"} Y \hookrightarrow W
              or it doesn’t. If it does, then because
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is Hausdorff, it is a closed point in a closed subspace, so it is a closed point in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                    %annotation{:encoding => "application/x-tex"} W
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi k
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi ∅
                  %annotation{:encoding => "application/x-tex"} k^{-1}(x) = \emptyset
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi g
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} g^{-1}(x)
              is a singleton in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              and thus closed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} Z
              is Hausdorff, i.e., the inverse image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              under the quotient map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi Y
                    %mo +
                    %mi Z
                    %mo →
                    %mi W
                  %annotation{:encoding => "application/x-tex"} (k, g): Y + Z \to W
              is the closed subset
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ∅
                      %mo +
                      %msup
                        %mi g
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \emptyset + g^{-1}(x)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              must be closed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              by definition of quotient topology.
            %p
              Thus we have only to prove
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
              admits a section. Using Lemma
              = succeed "," do
                %a.maruku-ref{:href => "#pullback"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R, p, q)
              to entire, lsc, closed and convex relations to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and from
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Z
                    %annotation{:encoding => "application/x-tex"} Z
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi h
                          %mtd
                            %mi Z
                          %mtd
                          %mtd
                        %mtr
                          %mtd
                            %mpadded{:lspace => "-100%width", :width => "0"}
                              %mi f
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                            %mpadded{:width => "0"}
                              %mi g
                          %mtd
                            %mo ↖
                          %mtd
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %munder
                              %mo →
                              %mi k
                          %mtd
                            %mi W
                          %mtd
                          %mtd
                            %msup
                              %mi g
                              %mo *
                            %mi R
                        %mtr
                          %mtd
                          %mtd
                            %mo ↖
                          %mtd
                          %mtd
                            %mo ↖
                            %mpadded{:width => "0"}
                              %mi p
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi k
                              %mo *
                            %mi R
                          %mtd
                            %mo →
                          %mtd
                            %mi R
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    X &amp; \stackrel{h}{\to} &amp; Z &amp; &amp; \\
                    \\mathllap{f} \downarrow &amp; &amp; \downarrow \mathrlap{g} &amp; \nwarrow &amp; \\
                    Y &amp; \underset{k}{\to} &amp; W &amp; &amp; g^\ast R \\
                    \&amp; \nwarrow &amp; &amp; \nwarrow \mathrlap{p} &amp; \downarrow \\
                    \&amp; &amp; k^\ast R &amp; \to &amp; R.
                    }
            %p
              By paracompactness of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              and the selection criterion, there is a section
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                  %annotation{:encoding => "application/x-tex"} s
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi k
                        %mo *
                      %mi R
                      %mo →
                      %mi Y
                    %annotation{:encoding => "application/x-tex"} k^\ast R \to Y
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi s
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %msup
                      %mi k
                      %mo *
                    %mi R
                  %annotation{:encoding => "application/x-tex"} s f: X \to k^\ast R
              in turn induces a selection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                      %mo :
                      %mi X
                      %mo →
                      %msup
                        %mi f
                        %mo *
                      %msup
                        %mi k
                        %mo *
                      %mi R
                      %mo ≅
                      %msup
                        %mi h
                        %mo *
                      %msup
                        %mi g
                        %mo *
                      %mi R
                    %annotation{:encoding => "application/x-tex"} t: X \to f^\ast k^\ast R \cong h^\ast g^\ast R
              = succeed "," do
                %a.maruku-ref{:href => "#extension"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi t
                  %annotation{:encoding => "application/x-tex"} t
              may be extended to a selection
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi u
                      %mo :
                      %mi Z
                      %mo →
                      %msup
                        %mi g
                        %mo *
                      %mi R
                    %annotation{:encoding => "application/x-tex"} u: Z \to g^\ast R
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mover
                      %mo →
                      %mi s
                    %msup
                      %mi k
                      %mo *
                    %mi R
                    %mo →
                    %mi R
                    %mo ,
                    %mspace{:width => "2em"}
                    %mi Z
                    %mover
                      %mo →
                      %mi u
                    %msup
                      %mi g
                      %mo *
                    %mi R
                    %mo →
                    %mi R
                  %annotation{:encoding => "application/x-tex"} Y \stackrel{s}{\to} k^\ast R \to R, \qquad Z \stackrel{u}{\to} g^\ast R \to R
            %p
              may be pasted together (i.e., their respective composites with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi h
                  %annotation{:encoding => "application/x-tex"} h
              agree) to give a map out of the pushout,
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi i
                      %mo :
                      %mi W
                      %mo →
                      %mi R
                    %annotation{:encoding => "application/x-tex"} i: W \to R
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi p
                    %annotation{:encoding => "application/x-tex"} p
          #ColimitsOfSequencesOfParacompacta.num_prop
            %h6#proposition_3 Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi i
                      %mi n
                    %mo :
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                  %annotation{:encoding => "application/x-tex"} (i_n: X_n \to X_{n+1})_{n \in \mathbb{N}}
              is a countable sequence of closed embeddings between paracompact Hausdorff spaces, then the colimit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %msub
                      %mi colim
                      %mi n
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X = colim_n X_n
              is also a paracompact Hausdorff space.
          .proof
            %h6#proof_6 Proof
            %p
              Clearly
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi T
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} T_1
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi x
                      %mo ∈
                      %mi X
                    %annotation{:encoding => "application/x-tex"} x \in X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %mi x
                    %mo{:stretchy => "false"} }
                    %mo ∩
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} \{x\} \cap X_n
              is closed in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mi n
                  %annotation{:encoding => "application/x-tex"} X_n
              for all
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi x
                  %annotation{:encoding => "application/x-tex"} x
              must a closed point of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi j
                      %mi n
                    %mo :
                    %msub
                      %mi X
                      %mi n
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} j_n: X_n \to X
              denote a component of the colimit cocone. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo ,
                    %mi p
                    %mo ,
                    %mi q
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (R, p, q)
              from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              to a Banach space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              be an entire, lsc, closed and convex relation. Pulling this back to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} X_0
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 0
                      %mo →
                      %msubsup
                        %mi j
                        %mn 0
                        %mo *
                      %mi R
                    %annotation{:encoding => "application/x-tex"} X_0 \to j_0^\ast R
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mi n
                      %mo →
                      %msubsup
                        %mi j
                        %mi n
                        %mo *
                      %mi R
                    %annotation{:encoding => "application/x-tex"} X_n \to j_n^\ast R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi i
                      %mi n
                  %annotation{:encoding => "application/x-tex"} i_n
              to a selection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mo →
                    %msubsup
                      %mi j
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mo *
                    %mi R
                  %annotation{:encoding => "application/x-tex"} X_{n+1} \to j_{n+1}^\ast R
              using paracompactness and Lemma
              = succeed "." do
                %a.maruku-ref{:href => "#extension"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi i
                        %mi n
                    %annotation{:encoding => "application/x-tex"} i_n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                      %mo →
                      %mi R
                    %annotation{:encoding => "application/x-tex"} X \to R
          %p
            In particular this may be used to see that
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/CW-complexes+are+paracompact+Hausdorff+spaces"} CW-complexes are paracompact Hausdorff spaces
