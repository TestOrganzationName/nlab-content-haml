          %h4#discrete_object_classifier Discrete object classifier
          .num_defn
            %h6#definition_4 Definition
            %p
              A
              %strong discrete object classifier
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
