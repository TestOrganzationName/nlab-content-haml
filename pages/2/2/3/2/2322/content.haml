                          %mi C
                        %annotation{:encoding => "application/x-tex"} Cod_C^S \to C
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/right+fibration"} right fibration
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Cod
                            %mi C
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi S
                              %mo{:stretchy => "false"} )
                          %mo →
                          %mi C
                        %annotation{:encoding => "application/x-tex"} Cod_C^{(S)} \to C
            %p
              We say a morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi x
                    %mo →
                    %mi y
                  %annotation{:encoding => "application/x-tex"} f :x \to y
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              %em classifies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              – or simply that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi y
                  %annotation{:encoding => "application/x-tex"} y
              classifies
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              – if it is the
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal object
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Cod
                        %mi C
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi S
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Cod_C^{(S)}
          %p
            This is
            %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, notation 6.1.3.4
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, def. 6.1.6.1
          %h4#DetailsSubObjClassf Subobject classifier
          .num_defn
            %h6#definition_3 Definition
            %p
              A
              %strong subobject classifier
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is an object that classifies the class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              of
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/monomorphism+in+an+%28%E2%88%9E%2C1%29-category"} monomorphisms
              %a.existingWikiWord{:href => "/nlab/show/%28-1%29-truncated"} (-1)-truncated
              morphisms in
