                  %mrow
                    %msub
                      %mi Cod
                      %mi C
                    %mo :
                    %mo =
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Cod_C := Func(\Delta[1], C)
            %p
              equipped with the
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Cod
                      %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} Cod_C \to C
              induced from the endpoint inclusion
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 0
                      %mo{:stretchy => "false"} ]
                      %mo →
                      %mi Δ
                      %mo{:stretchy => "false"} [
                      %mn 1
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} \Delta[0] \to \Delta[1]
            %p Write
            %ul
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Cod
                          %mi C
                          %mi S
                      %annotation{:encoding => "application/x-tex"} Cod_C^S
                  for the full
                  %a.existingWikiWord{:href => "/nlab/show/sub-%28%E2%88%9E%2C1%29-category"} sub-(∞,1)-category
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Cod
                          %mi C
                      %annotation{:encoding => "application/x-tex"} Cod_C
                  on the object in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msubsup
                          %mi Cod
                          %mi C
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi S
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Cod_C^{(S)}
                  the non-full subcategory whose objects are the elements of
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
            %p
              Then evaluation at
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \Delta[0] \to \Delta[1]
              yields
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} Cartesian fibration
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msubsup
                            %mi Cod
                            %mi C
                            %mi S
