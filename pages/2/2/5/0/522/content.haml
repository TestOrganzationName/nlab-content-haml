                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\mathbf{E}_{pt} &amp;\longrightarrow&amp; *
                  \\\
                  \\big\downarrow{}^{\mathrlap{p}}
                  \&amp;\swArrow&amp;
                  \\big\downarrow{}^{\mathrlap{pt_B}}
                  \\\
                  B &amp;\stackrel{id}{\longrightarrow}&amp; B
                  }
                  \\,.
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            of the generalized universal bundle is the
            %a.existingWikiWord{:href => "/nlab/show/loop+space+object"} loop monoid
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Ω
                      %mi pt
                    %mi B
                  %annotation{:encoding => "application/x-tex"} \Omega_{pt} B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mi Ω
                            %mi pt
                          %mi B
                        %mtd
                          %mo ⟶
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi pt
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo *
                      %mtr
