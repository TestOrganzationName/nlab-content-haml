                      %mi E
                    %mi pt
                  %mi B
                  %mover
                    %mo →
                    %mi p
                  %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\Omega_{pt}B \stackrel{i}{\to} \mathbf{E}_{pt} B \stackrel{p}{\to} B
          %p
            is exact in that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                %annotation{:encoding => "application/x-tex"} i
            is the kernel of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi p
                %annotation{:encoding => "application/x-tex"} p
            in the sense of kernels of morphisms of
            %a.existingWikiWord{:href => "/nlab/show/pointed+objects"} pointed objects
            (see there).
          %h2#examples Examples
          %h3#groupoid_incarnations_of_universal_principal_bundles Groupoid incarnations of universal principal bundles
          %p
            In (higher) categorical contexts, take the interval object to the the interval category
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo :
                    %mo =
                    %mo{:stretchy => "false"} {
                    %mi a
                    %mo →
                    %mi b
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} I := \{a \to b\}
          %h4#ordinary_principal_bundles
            Ordinary
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo =
                %annotation{:encoding => "application/x-tex"} C =
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                  %mo :
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} B := \mathbf{B}G
            a one-object groupoid corresponding to a group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            with the unique point,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi pt
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mo =
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mi G
                  %mo =
                  %mi G
                  %mo{:stretchy => "false"} /
                  %mo{:stretchy => "false"} /
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{E}_{pt} \mathbf{B}G = \mathbf{E}G = G//G
            is the
            %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            acting on itself. The sequence of groupoids is
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                  %mo →
                  %mi G
                  %mo ⫽
                  %mi G
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  G \to G \sslash G \to \mathbf{B}G
                  \\,.
          %p
            This is the universal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
            to the familiar universal
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Top
                  %annotation{:encoding => "application/x-tex"} Top
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            in the ordinary sense is the pullback of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{E} G
            in the following sense:
          %p
            the
            = succeed "-bundle" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} P \to X
            is classified by a nonabelian
            = succeed "-valued" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %a.existingWikiWord{:href => "/nlab/show/anafunctor"} anafunctor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mover
                            %mi X
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mover
                            %mo ⟶
                            %mi g
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %msup
                            %mrow
                            %mpadded{:width => "0"}
                              %mi π
                      %mtr
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\hat X &amp;\stackrel{g}{\longrightarrow}&amp; \mathbf{B}G
                  \\\
                  \\big\downarrow{}^{\mathrlap{\pi}}
                  \\\
                  X
                  }
                  \\,.
          %p
            (For instance
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat X
            could be the Čech groupoid of a
            %a.existingWikiWord{:href => "/nlab/show/cover"} cover
            of
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
          %p
            The universal groupoid bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mi G
                  %mo →
                  %mstyle{:mathvariant => "bold"}
                    %mi B
                  %mi G
                %annotation{:encoding => "application/x-tex"} \mathbf{E}G \to \mathbf{B}G
            may now be pulled back along this anafunctor to yield the groupoid bundle
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi g
                    %mo *
                  %mstyle{:mathvariant => "bold"}
                    %mi E
                  %mi G
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} g^* \mathbf{E}G \to X
            given by the total left vertical morphism in
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi g
                            %mo *
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi G
                        %mtd
                          %mo ⟶
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi G
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                      %mtr
                        %mtd
                          %mover
                            %mi X
                            %mo{:stretchy => "false"} ^
                        %mtd
                          %mover
                            %mo ⟶
                            %mi g
                        %mtd
                          %mstyle{:mathvariant => "bold"}
                            %mi B
                          %mi G
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                          %msup
                            %mrow
                            %mpadded{:width => "0"}
                              %mi π
                      %mtr
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  g^* \mathbf{E}G &amp;\longrightarrow&amp; \mathbf{E}G
                  \\\
                  \\big\downarrow &amp;&amp; \big\downarrow
                  \\\
                  \\hat X &amp;\stackrel{g}{\longrightarrow}&amp; \mathbf{B}G
                  \\\
                  \\big\downarrow{}^{\mathrlap{\pi}}
                  \\\
                  X
                  }
                  \\,.
          %p
            This bundle of groupoids is weakly equivalent to the
            = succeed "-principal" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            regarded as a bundle of discrete groupoids)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msup
                            %mi g
                            %mo *
                          %mstyle{:mathvariant => "bold"}
                            %mi E
                          %mi G
                        %mtd
                        %mtd
                          %mover
                            %mo ⟶
                            %mo ≃
                        %mtd
                        %mtd
                          %mi P
                      %mtr
                        %mtd
                        %mtd
                          %mo ↘
                        %mtd
                        %mtd
                          %mo ↙
                      %mtr
                        %mtd
                        %mtd
                        %mtd
                          %mi X
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  g^* \mathbf{E}G &amp;&amp;\stackrel{\simeq}{\longrightarrow}&amp;&amp; P
                  \\\
