            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi P
                %annotation{:encoding => "application/x-tex"} P
            is the “lax pullback” (really
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/comma+object"} comma object
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi g
                %annotation{:encoding => "application/x-tex"} g
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mi P
                        %mtd
                          %mo →
                        %mtd
                          %mo *
                      %mtr
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                        %mtd
                          %mo ⇙
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
