                        %mtd
                        %mtd
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                      %mtr
                        %mtd
                          %mi X
                        %mtd
                          %mover
                            %mo ⟶
                            %mi g
                        %mtd
                          %mi B
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  P &amp;\longrightarrow&amp; \mathbf{E}_{pt}
                  \\\
