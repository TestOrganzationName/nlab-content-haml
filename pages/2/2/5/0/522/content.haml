                  }
                  \\,.
          %p
            The generalized universal bundle can be constructed in this way if we take
            = succeed ":" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo =
                    %mi B
                  %annotation{:encoding => "application/x-tex"} X = B
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %msub
                            %mstyle{:mathvariant => "bold"}
                              %mi E
                            %mi pt
                        %mtd
                          %mo ⟶
                        %mtd
                          %mo *
                      %mtr
                        %mtd
