          %h2#examples Examples
          #FinitrRankBundleHomomorphismIsSectionOfTensorProductWithDual.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi i
                    %mover
                      %mo →
                      %mrow
                        %msub
                          %mi p
                          %mi i
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_i \overset{p_i}{\to} X
              be a two
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              over
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank of a vector bundle
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f \;\colon\; E_1 \rightarrow E_2
            %p
              is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/section"} section
              of the tensor product of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} E_2
              with the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+bundle"} dual vector bundle
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn 1
                    %annotation{:encoding => "application/x-tex"} E_1
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mrow
                        %mi Vect
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi E
                      %mn 1
                    %mo ,
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Γ
                      %mi X
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi E
                      %mn 1
                      %mo *
                    %msub
                      %mo ⊗
                      %mi X
                    %msub
                      %mi E
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_{Vect(X)}(E_1, E_2)
                    \\;\simeq\;
                    \\Gamma_X( E_1^\ast \otimes_X E_2)
                    \\,.
            %p
              Moreover, this section is a trivializing section (
              %a{:href => "topological+vector+bundle#FiberwiseLinearlyIndependentSectionsTrivialize"}> this example
              ) precisely if the corresponding morphism is an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
