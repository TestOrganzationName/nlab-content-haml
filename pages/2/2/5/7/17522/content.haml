                    %mphantom
                      %mi AAA
                    %mtext and
                    %mphantom
                      %mi AAA
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi g
                        %mn 2
                      %msub
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi i
                          %mi j
                      %mo{:lspace => "verythinmathspace"} :
                      %msub
                        %mi U
                        %mi i
                      %mo ∩
                      %msub
                        %mi U
                        %mi j
                      %mo ⟶
                      %mi GL
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    (g_1)_{i j}
                    \\colon U_i \cap U_j \to GL(n_1)
                    \\right\}
                    \\phantom{AAA}
                    \\text{and}
                    \\phantom{AAA}
                    \\left\{
                    (g_2)_{i j}
                    \\colon
                    U_i \cap U_j \longrightarrow GL(n_2)
                    \\right\}
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/transition+functions"} transition functions
              of these two bundles with respect to this cover.
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo ,
                    %mi j
                    %mo ∈
                    %mi I
                  %annotation{:encoding => "application/x-tex"} i, j \in I
              write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
