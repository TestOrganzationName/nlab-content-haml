          %h2#idea Idea
          %p
            Given two
            %a.existingWikiWord{:href => "/nlab/show/vector+bundles"} vector bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} V_1 \to X
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 2
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} V_2 \to X
            over the same base space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
            %em tensor product of vector bundles
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                  %mo ⊗
                  %msub
                    %mi V
                    %mn 2
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} V_1 \otimes V_2 \to X
            is the vector bundle over
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
            whose
            %a.existingWikiWord{:href => "/nlab/show/fiber"} fiber
            over any point is the
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+vector+spaces"} tensor product of vector spaces
            (i.e. the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+modules"} tensor product of modules
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 1
                %annotation{:encoding => "application/x-tex"} V_1
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mn 2
                %annotation{:encoding => "application/x-tex"} V_2
            (the
            %a{:href => "topological+vector+bundle#FiberwiseOperations"} fiber-wise
            tensor product).
          %p
            The tensor product of vector bundles makes the category
            %a.existingWikiWord{:href => "/nlab/show/Vect%28X%29"} Vect(X)
            into a
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/distributive+monoidal+category"} distributive monoidal category
          %h2#definition Definition
          .num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (tensor product of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 1
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_1 \to X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mn 2
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E_2 \to X
              be two
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundles"} topological vector bundles
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi U
                      %mi i
                    %mo ⊂
                    %mi X
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi I
                  %annotation{:encoding => "application/x-tex"} \{U_i \subset X\}_{i \in I}
              be an
              %a.existingWikiWord{:href => "/nlab/show/open+cover"} open cover
              with respect to which both vector bundles locally trivialize (this always exists: pick a
              %a.existingWikiWord{:href => "/nlab/show/local+trivialization"} local trivialization
              of either bundle and form the joint
              %a.existingWikiWord{:href => "/nlab/show/refinement"} refinement
              of the respective
              %a.existingWikiWord{:href => "/nlab/show/open+covers"} open covers
              by
              %a.existingWikiWord{:href => "/nlab/show/intersection"} intersection
              of their patches). Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
