                  %a{:href => "/nlab/new/Stephen+T.+Ahearn"} ?
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicholas+J.+Kuhn"} Nicholas J. Kuhn
                = succeed "," do
                  %em Product and other fine structure in polynomial resolutions of mapping spaces
                %strong 2
                (2002) 591-647 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/math/0109041"}> arXiv:math/0109041
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.2140/agt.2002.2.591"} doi:10.2140/agt.2002.2.591
            %li
              %p
                Andrew Mauer-Oats,
                = succeed "," do
                  %em Algebraic Goodwillie calculus and a cotriple model for the remainder
                %strong 358
                (2006), no. 5, 1869–1895
                = succeed "," do
                  %a{:href => "http://www.ams.org/tran/2006-358-05/S0002-9947-05-03936-X/home.html"} journal
                %a{:href => "http://arxiv.org/abs/math/0212095"} math.AT/0212095
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/David+Barnes"}> David Barnes
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Rosona+Eldred"} Rosona Eldred
                = succeed "," do
                  %em Capturing Goodwillie’s Derivative
              %p
                %strong 220
                1 (2016) 197-222 &amp;lbrack;
                %a{:href => "https://arxiv.org/abs/1406.0424"}> arXiv:1406.0424
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/j.jpaa.2015.06.006"} doi:10.1016/j.jpaa.2015.06.006
          %p
            Discussion in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/chromatic+homotopy+theory"} chromatic homotopy theory
          %ul
            %li#AroneMahowald98
              %p
                %a.existingWikiWord{:href => "/nlab/show/Greg+Arone"}> Greg Arone
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mark+Mahowald"} Mark Mahowald
                = succeed "," do
                  %em The Goodwillie tower of the identity functor and the unstable periodic homotopy of spheres
                = succeed "," do
                  %a{:href => "http://hopf.math.purdue.edu/Arone-Mahowald/ArMahowald.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s002220050300"} doi:10.1007/s002220050300
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicholas+Kuhn"}> Nicholas Kuhn
                ,
                = succeed "," do
                  %em Goodwillie towers and chromatic homotopy: an overview
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/math/0410342"} arXiv:math/0410342
                = succeed ")" do
                  %a{:href => "http://dx.doi.org/10.2140/gtm.2007.10.245"} doi:10.2140/gtm.2007.10.245
          %p
            Discussion via
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-categories"} (∞,1)-categories
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/stable+%28%E2%88%9E%2C1%29-categories"} stable (∞,1)-categories
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              = succeed "," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C2%29-Categories+and+the+Goodwillie+Calculus"} (∞,2)-Categories and the Goodwillie Calculus
              %a{:href => "http://www.math.harvard.edu/~lurie/papers/GoodwillieI.pdf#page=159"} section 5
          %p This is now section 7 of
          %ul
            %li#HigherAlg
              %a.existingWikiWord{:href => "/nlab/show/Jacob+Lurie"}> Jacob Lurie
              ,
              %em
                %a.existingWikiWord{:href => "/nlab/show/Higher+Algebra"} Higher Algebra
          %p See also
          %ul
            %li
              %p
                Luis Pereira,
                %em A general context for Goodwillie Calculus
                (
                %a{:href => "http://arxiv.org/abs/1301.2832"}> arXiv:1301.2832
                )
            %li#Joyal08
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andr%C3%A9+Joyal"}> André Joyal
                ,
                = succeed "," do
                  %em Notes on Logoi
                = succeed ")" do
                  %a{:href => "http://www.math.uchicago.edu/~may/IMA/JOYAL/Joyal.pdf"} pdf
          %p
            Generalization from
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-categories"} (infinity,1)-categories
            to
            %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-categories"} (infinity,n)-categories
            and relation to
            %a.existingWikiWord{:href => "/nlab/show/rational+homotopy+theory"} rational homotopy theory
            is discussed in
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Gijs+Heuts"}> Gijs Heuts
              ,
              %em Goodwillie approximations to higher categories
              (
              %a{:href => "http://arxiv.org/abs/1510.03304"}> arXiv:1510.03304
              )
          %p
            Relation to
            %a.existingWikiWord{:href => "/nlab/show/chromatic+homotopy+theory"} chromatic homotopy theory
            is discussed in
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Greg+Arone"}> Greg Arone
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Mark+Mahowald"} Mark Mahowald
                = succeed "," do
                  %em The Goodwillie tower of the identity functor and the unstable periodic homotopy of spheres
                = succeed ")" do
                  %a{:href => "http://hopf.math.purdue.edu/Arone-Mahowald/ArMahowald.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicholas+Kuhn"}> Nicholas Kuhn
                ,
                = succeed "," do
                  %em Goodwillie towers and chromatic homotopy: an overview
                = succeed ")" do
                  %a{:href => "http://arxiv.org/abs/math/0410342"} arXiv:math/0410342
          %p
            On the relation to
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+space+%28mathematics%29"} configuration spaces
          %ul
            %li#Ching05
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Ching"}> Michael Ching
                ,
                = succeed "," do
                  %em Bar constructions for topological operads and the Goodwillie derivatives of the identity
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/math/0501429"} arXiv:math/0501429
            %li#Ching05b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Ching"}> Michael Ching
                ,
                = succeed "," do
                  %em Calculus of Functors and Configuration Spaces
                = succeed ")" do
                  %a{:href => "https://www3.amherst.edu/~mching/Work/skye.pdf"} pdf
          %p
            Discussion in terms of
            %a.existingWikiWord{:href => "/nlab/show/spectral+Mackey+functors"} spectral Mackey functors
          %ul
            %li#Glasman15
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saul+Glasman"}> Saul Glasman
                ,
                %em Stratified categories, geometric fixed points and a generalized Arone-Ching theorem
                (
                %a{:href => "https://arxiv.org/abs/1507.01976"}> arXiv:1507.01976
                ,
                = succeed ")" do
                  %a{:href => "http://www-users.math.umn.edu/~sglasman/strattalk.pdf"} talk notes pdf
            %li#Glasman16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Saul+Glasman"}> Saul Glasman
                ,
                %em Goodwillie calculus and Mackey functors
                (
                %a{:href => "https://arxiv.org/abs/1610.03127"}> arXiv:1610.03127
                )
          %p
            Discussion in an
            %a.existingWikiWord{:href => "/nlab/show/equivariant"} equivariant
            setting is in
          %ul
            %li
              Emanuele Dotto,
              = succeed "," do
                %em Higher Equivariant Excision
              = succeed ")" do
                %a{:href => "https://arxiv.org/abs/1507.01909"} arXiv:1507.01909
