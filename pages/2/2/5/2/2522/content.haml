                  %a.existingWikiWord{:href => "/nlab/show/N%3D4+D%3D4+super+Yang-Mills+theory"} N=4 D=4 super Yang-Mills theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/spinning+particle"} spinning particle
                (which happens to have
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/worldline+supersymmetry"} worldline supersymmetry
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/superparticle"} superparticle
              %ul
                %li
                  %a.existingWikiWord{:href => "/nlab/show/%281%2C1%29-dimensional+Euclidean+field+theories+and+K-theory"} (1,1)-dimensional Euclidean field theories and K-theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/SCFT"} SCFT
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/2d+SCFT"} 2d SCFT
                  %ul
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/spinning+string"} spinning string
                        %a.existingWikiWord{:href => "/nlab/show/superstring"} superstring
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/heterotic+string"}> heterotic string
                        ,
                        %a.existingWikiWord{:href => "/nlab/show/2d+%282%2C0%29-superconformal+QFT"} 2d (2,0)-superconformal QFT
                    %li
                      %p
                        %a.existingWikiWord{:href => "/nlab/show/type+II+superstring"} type II superstring
                    %li
