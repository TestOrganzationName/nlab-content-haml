                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi 𝔤
                                %msub
                                  %mo ⊗
                                  %mi k
                                %mi 𝔤
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msubsup
                                      %mi τ
                                      %mrow
                                        %mi 𝔤
                                        %mo ,
                                        %mi 𝔤
                                      %mi super
                              %mtd
                                %mi 𝔤
                                %msub
                                  %mo ⊗
                                  %mi k
                                %mi 𝔤
                            %mtr
                              %mtd
                                %msup
                                  %mrow
                                  %mpadded{:lspace => "-100%width", :width => "0"}
                                    %mrow
                                      %mo{:stretchy => "false"} [
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo ,
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} ]
                                %mo{:stretchy => "false"} ↓
                              %mtd
                              %mtd
                                %msup
                                  %mo{:stretchy => "false"} ↓
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mo{:stretchy => "false"} [
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo ,
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} ]
                            %mtr
                              %mtd
                                %mi 𝔤
                              %mtd
                                %munder
                                  %mo ⟶
                                  %mrow
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mn 1
                              %mtd
                                %mi 𝔤
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathfrak{g} \otimes_k \mathfrak{g}
                        \&amp;
                        \\overset{\tau^{super}_{\mathfrak{g},\mathfrak{g}}}{\longrightarrow}
                        \&amp;
                        \\mathfrak{g} \otimes_k \mathfrak{g}
                        \\\
                        {}^{\mathllap{[-,-]}}\downarrow &amp;&amp; \downarrow^{\mathrlap{[-,-]}}
                        \\\
                        \\mathfrak{g} &amp;\underset{-1}{\longrightarrow}&amp; \mathfrak{g}
                        }
                %p
                  (here
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi τ
                          %mi super
                      %annotation{:encoding => "application/x-tex"} \tau^{super}
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
                  %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
                  in the category of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
                  holds in that the following
                  %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} diagram commutes
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi 𝔤
                                %msub
                                  %mo ⊗
                                  %mi k
                                %mi 𝔤
                                %msub
                                  %mo ⊗
                                  %mi k
                                %mi 𝔤
                              %mtd
                              %mtd
                                %mover
                                  %mo ⟶
                                  %mrow
                                    %msubsup
                                      %mi τ
                                      %mrow
                                        %mi 𝔤
                                        %mo ,
                                        %mi 𝔤
                                      %mi super
                                    %msub
                                      %mo ⊗
                                      %mi k
                                    %mi id
                              %mtd
                              %mtd
                                %mi 𝔤
                                %msub
                                  %mo ⊗
                                  %mi k
                                %mi 𝔤
                                %msub
                                  %mo ⊗
                                  %mi k
                                %mi 𝔤
                            %mtr
                              %mtd
                              %mtd
                                %msub
                                  %mrow
                                  %mrow
                                    %mpadded{:lspace => "-100%width", :width => "0"}
                                      %mrow
                                        %mo{:stretchy => "false"} [
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mo ,
                                        %mo{:stretchy => "false"} [
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mo ,
                                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                        %mo{:stretchy => "false"} ]
                                        %mo{:stretchy => "false"} ]
                                    %mo −
                                    %mo{:stretchy => "false"} [
                                    %mo{:stretchy => "false"} [
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo ,
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} ]
                                    %mo ,
                                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                    %mo{:stretchy => "false"} ]
                                %mo ↘
                              %mtd
                              %mtd
                                %msub
                                  %mo ↙
                                  %mpadded{:width => "0"}
                                    %mrow
                                      %mo{:stretchy => "false"} [
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo ,
                                      %mo{:stretchy => "false"} [
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo ,
                                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                      %mo{:stretchy => "false"} ]
                                      %mo{:stretchy => "false"} ]
                            %mtr
                              %mtd
                              %mtd
                              %mtd
                                %mi 𝔤
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        \\mathfrak{g} \otimes_k \mathfrak{g} \otimes_k \mathfrak{g}
                        \&amp;&amp;
                        \\overset{\tau^{super}_{\mathfrak{g}, \mathfrak{g}} \otimes_k id }{\longrightarrow}
                        \&amp;&amp;
                        \\mathfrak{g} \otimes_k \mathfrak{g} \otimes_k \mathfrak{g}
                        \\\
                        \&amp; {}_{\mathllap{[-,[-,-]]} - [[-,-],-] }\searrow &amp;&amp; \swarrow_{\mathrlap{[-,[-,-]]}}
                        \\\
                        \&amp;&amp; \mathfrak{g}
                        }
                        \\,.
          %p Externally this means the following:
          #SuperLieAlgebraTraditional.num_prop
            %h6#proposition Proposition
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              according to def.
              %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              is equivalently
            %ol
              %li
                %p
                  a
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi 𝔤
                            %mi even
                          %mo ⊕
                          %msub
                            %mi 𝔤
                            %mi odd
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}_{even} \oplus \mathfrak{g}_{odd}
              %li
                %p
                  equipped with a
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
                  (the
                  = succeed ")" do
                    %em super Lie bracket
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %mo :
                        %mi 𝔤
                        %msub
                          %mo ⊗
                          %mi k
                        %mi 𝔤
                        %mo →
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"}
                        [-,-] : \mathfrak{g}\otimes_k \mathfrak{g} \to \mathfrak{g}
                %p
                  which is
                  %em graded
                  skew-symmetric: for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} x,y \in \mathfrak{g}
                  two elements of homogeneous degree
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mi x
                        %annotation{:encoding => "application/x-tex"} \sigma_x
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi σ
                            %mi y
                        %annotation{:encoding => "application/x-tex"} \sigma_y
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi σ
                              %mi x
                            %msub
                              %mi σ
                              %mi y
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo ,
                      %annotation{:encoding => "application/x-tex"}
                        [x,y] = -(-1)^{\sigma_x \sigma_y} [y,x]
                        \\,,
              %li
                %p
                  that satisfies the
                  = succeed "-graded" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℤ
                          %mo{:stretchy => "false"} /
                          %mn 2
                        %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
                  %a.existingWikiWord{:href => "/nlab/show/Jacobi+identity"} Jacobi identity
                  in that for any three elements
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ,
                        %mi y
                        %mo ,
                        %mi z
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} x,y,z \in \mathfrak{g}
                  of homogeneous super-degree
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi σ
                          %mi x
                        %mo ,
                        %msub
                          %mi σ
                          %mi y
                        %mo ,
                        %msub
                          %mi σ
                          %mi z
                        %mo ∈
                        %msub
                          %mi ℤ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \sigma_x,\sigma_y,\sigma_z\in \mathbb{Z}_2
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi y
                        %mo{:stretchy => "false"} ]
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %msub
                              %mi σ
                              %mi x
                            %mo ⋅
                            %msub
                              %mi σ
                              %mi y
                        %mo{:stretchy => "false"} [
                        %mi y
                        %mo ,
                        %mo{:stretchy => "false"} [
                        %mi x
                        %mo ,
                        %mi z
                        %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} ]
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        [x, [y, z]] = [[x,y],z] + (-1)^{\sigma_x \cdot \sigma_y} [y, [x,z]]
                        \\,.
            %p
              A
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
              of super Lie algebras is a homomorphisms of the underlying
              %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              which preserves the Lie bracket. We write
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sLieAlg
                  %annotation{:encoding => "application/x-tex"}
                    sLieAlg
            %p
              for the resulting
              %a.existingWikiWord{:href => "/nlab/show/category"} category
              of super Lie algebras.
          %p Some obvious but important classes of examples are the following:
          #SuperVectorSpaceAsAbelianSuperLieAlgebra.num_example
            %h6#example Example
            %p
              every
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2
              %a.existingWikiWord{:href => "/nlab/show/graded+vector+space"} graded vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %a.existingWikiWord{:href => "/nlab/show/zero+morphism"} zero map
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} ]
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    [-,-] = 0
                    \\,.
            %p These may be called the “abelian” super Lie algebras.
          #OrdinaryLieAlgebraAsSuperLieAlgebra.num_example
            %h6#example_2 Example
            %p
              Every ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LieAlg
                    %mo ↪
                    %mi sLieAlg
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    LieAlg \hookrightarrow sLieAlg
                    \\,.
            %p
              which is a
              %a.existingWikiWord{:href => "/nlab/show/coreflective+subcategory"} coreflective subcategory
              inclusion in that it has a
              %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left adjoint
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi LieAlg
                    %munderover
                      %mo ⊥
                      %munder
                        %mo ⟵
                        %mover
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                          %mo ⇝
                      %mo ↪
                    %mi sLieAlg
                  %annotation{:encoding => "application/x-tex"}
                    LieAlg
                    \\underoverset
                    {\underset{ \overset{ \rightsquigarrow}{(-)} }{\longleftarrow}}
                    {\hookrightarrow}
                    {\bot}
                    sLieAlg
            %p given on the underlying super vector spaces by restriction to the even graded part
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi 𝔰
                      %mo ⇝
                    %mo =
                    %msub
                      %mi 𝔰
                      %mi even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overset{\rightsquigarrow}{\mathfrak{s}} = \mathfrak{s}_{even}
                    \\,.
          %p Using this we may finally say what a super-extension is supposed to be:
          #SuperExtensions.num_defn
            %h6#definition_3 Definition
            %p
              Given an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %em super-extension
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"} \mathfrak{s}
              (def.
              = succeed "," do
                %a.maruku-ref{:href => "#SuperLieAlgebraAsLieAlgebraInternalToSuperVectorSpaces"}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperLieAlgebraTraditional"}
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mo ↪
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"}
                    i \;\colon\; \mathfrak{g} \hookrightarrow  \mathfrak{s}
            %p
              (where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              is regarded as a super Lie algebra according to example
              = succeed ")" do
                %a.maruku-ref{:href => "#OrdinaryLieAlgebraAsSuperLieAlgebra"}
            %p
              such that this is an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              on the even part (example
              = succeed ")" do
                %a.maruku-ref{:href => "#OrdinaryLieAlgebraAsSuperLieAlgebra"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi i
                      %mo ⇝
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi 𝔤
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msub
                      %mi 𝔰
                      %mi even
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\overset{\rightsquigarrow}{i}
                    \\;\colon\;
                    \\mathfrak{g} \overset{\simeq}{\longrightarrow} \mathfrak{s}_{even}
                    \\,.
          %p We now make explicit structure involved in super-extensions of Lie algebras:
          #DataInSuperExtension.num_prop
            %h6#proposition_2 Proposition
            %p
              Given an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %mo ↪
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \hookrightarrow \mathfrak{s}
              according to def.
              %a.maruku-ref{:href => "#SuperExtensions"}
              is equivalently the following data:
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  a Lie action of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  on
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo :
                        %mi 𝔤
                        %mo ⟶
                        %mi 𝔤𝔩
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{(-)} : \mathfrak{g} \longrightarrow \mathfrak{gl}(S)
                %p
                  from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism+Lie+algebra"} endomorphism Lie algebra
                  of
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  a symmetric
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi S
                        %msub
                          %mo ⊗
                          %mi k
                        %mi S
                        %mo ⟶
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"}
                        (-,-) \;\colon\; S \otimes_k S \longrightarrow \mathfrak{g}
            %p such that
            %ol
              %li
                %p
                  the pairing is
                  = succeed "-equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} t \in \mathfrak{g}
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{t}(-,-) = (\rho_t(-),(-)) + (-,\rho_t(-))
              %li
                %p the pairing satisfies
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi ϕ
                            %mo ,
                            %mi ϕ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{(\phi,\phi)}(\phi) = 0
                %p
                  for all
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ϕ
                          %mo ∈
                          %mi S
                        %annotation{:encoding => "application/x-tex"} \phi \in S
          .proof
            %h6#proof Proof
            %p
              By definition of super-extension, the underlying super vector space of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"} \mathfrak{s}
              is necessarily of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝔰
                      %mi even
                    %mo =
                    %munder
                      %munder
                        %mi 𝔤
                        %mo ⏟
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi even
                    %mo ⊕
                    %munder
                      %munder
                        %mi S
                        %mo ⏟
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi odd
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{s}_{even} = \underset{\mathfrak{s}_{even}}{\underbrace{\mathfrak{g}}} \oplus \underset{\mathfrak{s}_{odd}}{\underbrace{S}}
            %p
              for some vector space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi S
                    %annotation{:encoding => "application/x-tex"} S
            %p
              Moreover the super Lie bracket on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                  %annotation{:encoding => "application/x-tex"} \mathfrak{s}
              restricts to that of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              when restricted to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                    %msub
                      %mo ⊗
                      %mi k
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g} \otimes_{k}\mathfrak{g}
              and otherwise constitutes
            %ol
              %li
                %p a bilinear map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi 𝔰
                              %mi even
                            %mo ⊕
                            %msub
                              %mi 𝔰
                              %mi odd
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi 𝔤
                        %msub
                          %mo ⊗
                          %mi k
                        %mi S
                        %mo ⟶
                        %mi S
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{(-)}(-) \coloneqq [-,-]\vert_{\mathfrak{s}_{even}\oplus \mathfrak{s}_{odd}} \;\colon\; \mathfrak{g} \otimes_k S \longrightarrow S
              %li
                %p a symmetric bilinear map
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ≔
                        %mo{:stretchy => "false"} [
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} ]
                        %msub
                          %mo{:stretchy => "false"} |
                          %mrow
                            %msub
                              %mi 𝔰
                              %mi odd
                            %mo ⊕
                            %msub
                              %mi 𝔰
                              %mi odd
                        %mspace{:width => "thickmathspace"}
                        %mo{:lspace => "verythinmathspace"} :
                        %mspace{:width => "thickmathspace"}
                        %mi S
                        %msub
                          %mo ⊗
                          %mi k
                        %mi S
                        %mo ⟶
                        %mi 𝔤
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        (-,-) \coloneqq [-,-]\vert_{\mathfrak{s}_{odd} \oplus \mathfrak{s}_{odd}} \;\colon\; S \otimes_k S \longrightarrow \mathfrak{g}
                        \\,.
            %p
              This yields the claimed
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} structure
              %a.existingWikiWord{:href => "/nlab/show/stuff%2C+structure%2C+property"} properties
              of these linear maps are now just a restatement of the super-Jacobi identity in terms of this data:
            %ol
              %li
                %p
                  The restriction of the super Jacobi identity of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi even
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{even}
                  is equivalently the Jacobi identity in
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  and hence is no new constraint;
              %li
                %p
                  The restriction of the super Jacobi identity of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{odd}
                  says that for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi t
                          %mn 1
                        %mo ,
                        %msub
                          %mi t
                          %mn 2
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} t_1,t_2 \in \mathfrak{g}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \phi \in S
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi t
                              %mn 1
                            %mo ,
                            %msub
                              %mi t
                              %mn 2
                            %mo{:stretchy => "false"} ]
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo +
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{t_1}( \rho_{t_2}(\phi) ) = \rho_{[t_1,t_2]}(\phi) + \rho_{t_1}( \rho_{t_2}(\phi) )
                        \\,.
                %p This is equivalent to
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo ∘
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                        %mo −
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 2
                        %mo ∘
                        %msub
                          %mi ρ
                          %mrow
                            %msub
                              %mi t
                              %mn 1
                        %mo =
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} [
                            %msub
                              %mi t
                              %mn 1
                            %mo ,
                            %msub
                              %mi t
                              %mn 2
                            %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{t_1} \circ \rho_{t_2} - \rho_{t_2} \circ \rho_{t_1} = \rho_{[t_1,t_2]}
                %p
                  which means equivalently that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \rho_{(-)}
                  is a Lie algebra homomorphism from
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  to the
                  %a.existingWikiWord{:href => "/nlab/show/endomorphism+Lie+algebra"} endomorphism Lie algebra
                  of
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  The restriction of the super Jacobi identity of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi even
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}_{even} \otimes_k \mathfrak{s}_{odd}  \otimes_k \mathfrak{s}_{odd}
                  says that for
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi t
                        %mo ∈
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} t \in \mathfrak{g}
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ϕ
                        %mo ,
                        %mi ψ
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \phi,\psi \in S
                  then
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo +
                        %mo{:stretchy => "false"} (
                        %mi ϕ
                        %mo ,
                        %msub
                          %mi ρ
                          %mi t
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\rho_{t}(\phi,\psi) = (\rho_t(\phi), \psi) + (\phi, \rho_t(\psi))
                        \\,.
                %p
                  This is exactly the claimed
                  = succeed "-equivariance" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %li
                %p
                  The restriction of the super Jacobi identity of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}
                  to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝔰
                          %mi odd
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                        %msub
                          %mo ⊗
                          %mi k
                        %msub
                          %mi 𝔰
                          %mi odd
                      %annotation{:encoding => "application/x-tex"} \mathfrak{s}_{odd} \otimes_k \mathfrak{s}_{odd}  \otimes_k \mathfrak{s}_{odd}
                  implies that for all
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo ∈
                        %mi S
                      %annotation{:encoding => "application/x-tex"} \psi \in S
                  that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mi ψ
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} ]
                        %mo −
                        %mo{:stretchy => "false"} [
                        %mi ψ
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} ]
                      %annotation{:encoding => "application/x-tex"}
                        [\psi,(\psi,\psi)] = [ (\psi,\psi), \psi  ] - [\psi, (\psi, \psi)]
                %p and hence that
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} [
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %mi ψ
                        %mo{:stretchy => "false"} ]
                        %mo =
                        %msub
                          %mi ρ
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi ψ
                            %mo ,
                            %mi ψ
                            %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi ψ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mn 0
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        [(\psi,\psi),\psi] =  \rho_{(\psi,\psi)}(\psi) = 0
                        \\,.
                %p
                  Hence it only remains to show that this special case is in fact equivalent to the full odd-odd-odd super Jacobi identity. This follows by polarization: First insert
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo =
                        %msub
                          %mi ϕ
                          %mn 1
                        %mo +
                        %msub
                          %mi ϕ
                          %mn 2
                      %annotation{:encoding => "application/x-tex"} \psi = \phi_1 + \phi_2
                  into the above cubic condition to obtain a quadratic condition, then polarize once more in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ϕ
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} \phi_2
          #TrivialSuperExtension.num_example
            %h6#example_3 Example
            %p
              Given an ordinary
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra"} Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              there is the
              %em trivial
              super extension (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperExtensions"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔰
                    %mo ≔
                    %mi 𝔤
                    %mo ⊕
                    %mi V
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{s} \coloneqq \mathfrak{g} \oplus V
            %p
              and with both the action and the pairing (via prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#DataInSuperExtension"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\rho = 0
            %p and
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (-,-) = 0
                    \\,.
          %p The key example of interest now is going to be this:
          #SuperExtensionOfPoincare.num_example
            %h6#example_4 Example
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} d \in \mathbb{N}
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperExtensions"}
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \mathfrak{iso}(\mathbb{R}^{d-1,1})
              (recalled as def.
              %a.maruku-ref{:href => "#PoincareLieAlgebra"}
              below) which is non-trivial (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#TrivialSuperExtension"}
            %ol
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+representation"} Lie algebra representation
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ρ
                      %annotation{:encoding => "application/x-tex"} \rho
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔰𝔬
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} \mathfrak{so}(d-1,1)
                  on some
                  %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                        %annotation{:encoding => "application/x-tex"} S
              %li
                %p
                  an
                  = succeed "-equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝔰𝔬
                        %annotation{:encoding => "application/x-tex"} \mathfrak{so}
                  = succeed "-" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %a.existingWikiWord{:href => "/nlab/show/bilinear+map"} bilinear pairing
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo ,
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo{:lspace => "verythinmathspace"} :
                        %mi S
                        %msub
                          %mo ⊗
                          %mi k
                        %mi S
                        %mo →
                        %msup
                          %mi ℝ
                          %mrow
                            %mi d
                            %mo −
                            %mn 1
                            %mo ,
                            %mn 1
                      %annotation{:encoding => "application/x-tex"} (-,-) \colon S \otimes_k S \to \mathbb{R}^{d-1,1}
            %p
              It turns out that data as in example
              %a.maruku-ref{:href => "#SuperExtensionOfPoincare"}
              is given for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ρ
                  %annotation{:encoding => "application/x-tex"} \rho
              the Lie algebra version of a
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
              of the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              (see
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+superymmetry#SpinorToVectorPairing"} this prop
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supersymmetry"} geometry of physics – supersymmetry
              in the section
              = succeed "." do
                %em
                  %a{:href => "geometry+of+physics+--+superymmetry##RealSpinRepresentations"} Real spin representations
            %p
              The super-extensions of the
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
              induced by
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representations"} real spin representations
              are called
              %em
                %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebras"} super Poincaré Lie algebras
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperMinkowskiSpacetime"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetry
                algebras
              in the physics literature.
          %p But beware that there are more super-extensions of the Poincaré Lie algebra:
          #AnExotiSuperExtensionOfThePoincareLieAlgebra.num_example
            %h6#example_5 Example
            %p
              %strong (an exotic super-extension of the Poincaré Lie algebra)
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 3
                    %mo ,
                    %mn 4
                    %mo ,
                    %mn 6
                    %mo ,
                    %mn 10
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} d \in \{3,4,6,10\}
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %msub
                      %mi Rep
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S \in Rep_{\mathbb{R}}(Spin(d-1,1))
              be an
              %a.existingWikiWord{:href => "/nlab/show/irreducible+representation"} irreducible
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
              in that dimension. Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mi S
                    %mo ⊗
                    %mi S
                    %mo →
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} (-,-) \colon S \otimes S \to \mathbb{R}^{d-1,1}
              be the symmetric spinor pairing as in example
              = succeed "," do
                %a.maruku-ref{:href => "#SuperExtensionOfPoincare"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              via the even-odd super-bracket not be the Spin-action of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔰𝔬
                    %annotation{:encoding => "application/x-tex"} \mathfrak{so}
              %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
              action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo ⟶
                    %mi End
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(-) \;\colon \; \mathbb{R}^{d-1,1} \longrightarrow End(S)
                    \\,.
            %p
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo ,
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi ψ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"}
                    \\Gamma(\psi,\psi)(\psi) = 0
            %p
              from prop.
              %a.maruku-ref{:href => "#DataInSuperExtension"}
              does hold: this turns out to be equivalent to the
              %a.existingWikiWord{:href => "/nlab/show/Green-Schwarz+superstring"} Green-Schwarz superstring
              cocycle condition in these dimensions, here in its incarnation as the “3-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ψ
                  %annotation{:encoding => "application/x-tex"} \psi
              rule” of
              = succeed "," do
                %a{:href => "#Schray96"} Schray 96
              = succeed "." do
                %a{:href => "#BaezHuerta09"} Baez-Huerta 09, theorem 10
            %p
              Now
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(-)
              thus defined is clearly not a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              and hence fails one of the other conditions in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#DataInSuperExtension"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ≔
                    %msub
                      %mi S
                      %mo +
                    %mo ⊕
                    %msub
                      %mi S
                      %mo −
                  %annotation{:encoding => "application/x-tex"} S \coloneqq S_+ \oplus S_-
              to be the
              %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
              of two copies of the
              %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
              representation and take
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(-)
              to map as before, but from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi S
                      %mo +
                  %annotation{:encoding => "application/x-tex"} S_+
              to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mo −
                    %annotation{:encoding => "application/x-tex"} S_-
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi S
                        %mo −
                    %annotation{:encoding => "application/x-tex"} S_-
              %a.existingWikiWord{:href => "/nlab/show/commutator"} commutator
              of
              %a.existingWikiWord{:href => "/nlab/show/endomorphisms"} endomorphisms
              in the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                  %annotation{:encoding => "application/x-tex"} \Gamma
              to vanish, and hence makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Γ
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \Gamma(-)
              a
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              of the abelian Lie algebra
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
          .num_remark
            %h6#remark Remark
            %p
              By prop.
              %a.maruku-ref{:href => "#DataInSuperExtension"}
              the data in example
              %a.maruku-ref{:href => "#SuperExtensionOfPoincare"}
              is sufficient for producing super-extensions (in the sense of def.
              = succeed ")" do
                %a.maruku-ref{:href => "#SuperExtensions"}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebras"} Poincaré Lie algebras
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebras"} super Poincaré Lie algebras
              %a.maruku-ref{:href => "#AnExotiSuperExtensionOfThePoincareLieAlgebra"}
              is a super-extension in the sense of def.
              %a.maruku-ref{:href => "#SuperExtensions"}
              of the
              %a.existingWikiWord{:href => "/nlab/show/Poincar%C3%A9+Lie+algebra"} Poincaré Lie algebra
              which is not a
              %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
              of the form of example
              = succeed "." do
                %a.maruku-ref{:href => "#SuperExtensionOfPoincare"}
            %p
              One may add further natural conditions on the super-extension in order to narrow down to the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+super+Lie+algebras"} super Poincaré super Lie algebras
            %ol
              %li
                %p
                  From the assumption alone that
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/spin+representation"} spin representation
                  and using that the
                  = succeed "-equivariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                        %annotation{:encoding => "application/x-tex"} Spin
                  %a.existingWikiWord{:href => "/nlab/show/irreducible+representations"} irreducible representations
                  to an irreducible representation, one may in some dimensions already deduce that the pairing has to land in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi ℝ
                            %mi d
                          %mo ↪
                          %mi 𝔦𝔰𝔬
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi ℝ
                            %mrow
                              %mi d
                              %mo −
                              %mn 1
                              %mo ,
                              %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d} \hookrightarrow \mathfrak{iso}(\mathbb{R}^{d-1,1})
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi d
                        %mo =
                        %mn 4
                      %annotation{:encoding => "application/x-tex"} d = 4
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                  the irreducible
                  %a.existingWikiWord{:href => "/nlab/show/Majorana+representation"} Majorana representation
                  this is done in
                  = succeed "." do
                    %a{:href => "#Varadarajan04"} Varadarajan 04, section 3.2
              %li
                %p
                  One may appeal to the
                  = succeed "." do
                    %em
                      %a.existingWikiWord{:href => "/nlab/show/Haag%E2%80%93%C5%81opusza%C5%84ski%E2%80%93Sohnius+theorem"} Haag–Łopuszański–Sohnius theorem
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi P
                          %mi a
                        %msup
                          %mi P
                          %mi a
                      %annotation{:encoding => "application/x-tex"} P_a P^a
                  remains a
                  %a.existingWikiWord{:href => "/nlab/show/Casimir+operator"} Casimir operator
                  after super-extension, and more conditions. These conditions are well motivated from the expected symmetry-behaviour of
                  %a.existingWikiWord{:href => "/nlab/show/S-matrices"} S-matrices
                  in
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/field+theory"} field theory
            %p
              At
              %em
                %a.existingWikiWord{:href => "/nlab/show/geometry+of+physics+--+supersymmetry"} geometry of physics – supersymmetry
              in the section
              %em
                %a{:href => "geometry+of+physics+--+superymmetry##SupersymmetryFromTheSuperpoint"} supersymmetry from the superpoint
              we discuss something at least related. The
              %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebras"} super Poincaré Lie algebras
              at least in certain dimensions are singled out from a different perspective: they are precisely the result of iterative maximal invariant
              %a.existingWikiWord{:href => "/nlab/show/central+extensions"} central extensions
              of the superpoint.
          %p
            Now we write out the supersymmetry algebra thus obtained more explicitly. In all of the following it is most convenient to regard
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
            dually via their
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
          #CEAlgebraofSuperLieAlgebra.num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              of
              %a.existingWikiWord{:href => "/nlab/show/finite+number"} finite
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %em
                %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              is the super-
              %a.existingWikiWord{:href => "/nlab/show/Grassmann+algebra"} Grassmann algebra
              on the
              %a.existingWikiWord{:href => "/nlab/show/dual+vector+space"} dual
              super vector space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    \\wedge^\bullet  \mathfrak{g}^\ast
            %p
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} d_{\mathfrak{g}}
              that on generators is the linear dual of the super Lie bracket
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi 𝔤
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %msup
                      %mo{:stretchy => "false"} ]
                      %mo *
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo →
                    %msup
                      %mi 𝔤
                      %mo *
                    %mo ∧
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"}
                    d_{\mathfrak{g}} \;\coloneqq\; [-,-]^\ast \;\colon\; \mathfrak{g}^\ast \to \mathfrak{g}^\ast \wedge \mathfrak{g}^\ast
            %p
              and which is extended to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo ∧
                      %mo •
                    %msup
                      %mi 𝔤
                      %mo *
                  %annotation{:encoding => "application/x-tex"} \wedge^\bullet \mathfrak{g}^\ast
              by the graded Leibniz rule (i.e. as a graded
              = succeed ")." do
                %a.existingWikiWord{:href => "/nlab/show/derivation"} derivation
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mspace{:width => "thinmathspace"}
                  %annotation{:encoding => "application/x-tex"} \,
            %p
              Here all elements are
              = succeed "-bigraded," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo ×
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\mathbb{Z} \times \mathbb{Z}/2)
              %em cohomological grading
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mo ∧
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} n
                      %msup
                        %mi 𝔤
                        %mo *
                    %annotation{:encoding => "application/x-tex"} \wedge^\n \mathfrak{g}^\ast
              %em super-grading
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              (even/odd).
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mi i
                    %mo ∈
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \alpha_i \in CE(\mathfrak{g})
              two elements of homogeneous bi-degree
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi n
                        %mi i
                      %mo ,
                      %msub
                        %mi σ
                        %mi i
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n_i, \sigma_i)
              %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} sign rule
              is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi α
                      %mn 1
                    %mo ∧
                    %msub
                      %mi α
                      %mn 2
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %msub
                          %mi n
                          %mn 2
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %msup
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi σ
                          %mn 1
                        %msub
                          %mi σ
                          %mn 2
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi α
                      %mn 2
                    %mo ∧
                    %msub
                      %mi α
                      %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\alpha_1 \wedge \alpha_2 = (-1)^{n_1 n_2} (-1)^{\sigma_1 \sigma_2}\; \alpha_2 \wedge \alpha_1
                    \\,.
            %p
              (See at
              %em
                %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
              for discussion of this sign rule and of an alternative sign rule that is also in use. )
          %p
            We may think of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CE
                  %mo{:stretchy => "false"} (
                  %mi 𝔤
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
            equivalently as the
            %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
            of
            %a.existingWikiWord{:href => "/nlab/show/invariant+differential+form"} left-invariant
            %a.existingWikiWord{:href => "/nlab/show/super+differential+forms"} super differential forms
            on the
            %a.existingWikiWord{:href => "/nlab/show/Lie+theory"} corresponding
            simply connected
            %a.existingWikiWord{:href => "/nlab/show/super+Lie+group"} super Lie group
            \.
          %p
            The concept of
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebras"} Chevalley-Eilenberg algebras
            is traditionally introduced as a means to define
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
          #SuperLieAlgebraCohomology.num_defn
            %h6#definition_5 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
            %ol
              %li
                %p
                  an
                  %em
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mi n
                        %annotation{:encoding => "application/x-tex"} n
                    \-cocycle
                  on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  (with
                  %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                  in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} (n,even)
                  in its
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
                  (def.
                  = succeed ")" do
                    %a.maruku-ref{:href => "#CEAlgebraofSuperLieAlgebra"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi d
                          %mi 𝕘
                      %annotation{:encoding => "application/x-tex"} d_{\mathbb{g}}
                  closed.
              %li
                %p
                  the cocycle is non-trivial if it is not
                  = succeed "-exact" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi d
                            %mi 𝔤
                        %annotation{:encoding => "application/x-tex"} d_{\mathfrak{g}}
              %li
                %p
                  hene the
                  %em
                    super-
                    %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+cohomology"} Lie algebra cohomology
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝔤
                      %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                  (with
                  %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
                  in
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℝ
                        %annotation{:encoding => "application/x-tex"} \mathbb{R}
                  %a.existingWikiWord{:href => "/nlab/show/cochain+cohomology"} cochain cohomology
                  of its
                  %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo ,
                        %mi ℝ
                        %mo{:stretchy => "false"} )
                        %mo =
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi CE
                        %mo{:stretchy => "false"} (
                        %mi 𝔤
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        H^\bullet(\mathfrak{g}, \mathbb{R}) = H^\bullet(CE(\mathfrak{g}))
                        \\,.
          %p
            The following says that the
            %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
            is an equivalent incarnation of the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
          .num_prop
            %h6#proposition_3 Proposition
            %p The functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msup
                      %mi sLieAlg
                      %mi fin
                    %mo ↪
                    %msup
                      %mi dgAlg
                      %mi op
                  %annotation{:encoding => "application/x-tex"}
                    CE \;\colon\; sLieAlg^{fin}  \hookrightarrow dgAlg^{op}
            %p
              that sends a finite dimensional
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔤
                  %annotation{:encoding => "application/x-tex"} \mathfrak{g}
              to its
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔤
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{g})
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#CEAlgebraofSuperLieAlgebra"}
              %a.existingWikiWord{:href => "/nlab/show/fully+faithful+functor"} fully faithful functor
              which hence exibits
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebras"} super Lie algebras
              as a
              %a.existingWikiWord{:href => "/nlab/show/full+subcategory"} full subcategory
              of the
              %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
              of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/differential-graded+algebras"} differential-graded algebras
          #SuperMinkowskiSpacetime.num_defn
            %h6#definition_6 Definition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"}
                    d \in \mathbb{N}
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/spacetime"} spacetime
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              and let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo ∈
                    %msub
                      %mi Rep
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N \in Rep_{\mathbb{R}}(Spin(d-1,1))
            %p
              be a
              %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
              of the
              %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
              cover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
              of the
              %a.existingWikiWord{:href => "/nlab/show/Lorentz+group"} Lorentz group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} O(d-1,1)
              in this dimension. Then the
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
                \-dimensional
                = succeed "-supersymmetric" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                %a.existingWikiWord{:href => "/nlab/show/super-Minkowski+spacetime"} super-Minkowski spacetime
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1|N}
              is the
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              that is characterized by the fact that its
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathbb{R}^{d-1,1})
              is as follows:
            %p
              The algebra has generators (as an
              %a.existingWikiWord{:href => "/nlab/show/associative+algebra"} associative algebra
              over
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi e
                            %mi a
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mtext and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi ψ
                            %mi α
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi odd
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{deg = (1,even)}{\underbrace{e^a}}
                    \\;\;\;\;
                    \\text{and}
                    \\;\;\;\;
                    \\underset{deg = (1,odd)}{\underbrace{\psi^\alpha}}
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi ⋯
                    %mo ,
                    %mn 9
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} a \in \{0,1,2, \cdots, 9\}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                    %mo ∈
                    %mo{:stretchy => "false"} {
                    %mn 1
                    %mo ,
                    %mn 2
                    %mo ,
                    %mi ⋯
                    %msub
                      %mi dim
                      %mi ℝ
                    %mo{:stretchy => "false"} (
                    %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} \alpha \in \{1, 2, \cdots dim_{\mathbb{R}}(N)\}
              subjects to the
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} relations
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msup
                              %mi e
                              %mi a
                            %mo ∧
                            %msup
                              %mi e
                              %mi b
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi e
                              %mi b
                            %mo ∧
                            %msup
                              %mi e
                              %mi a
                        %mtr
                          %mtd
                            %msup
                              %mi ψ
                              %mi α
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi β
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                            %msup
                              %mi ψ
                              %mi β
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi α
                        %mtr
                          %mtd
                            %msup
                              %mi e
                              %mi a
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi α
                            %mo =
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %msup
                              %mi ψ
                              %mi α
                            %mo ∧
                            %msup
                              %mi e
                              %mi a
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    e^a \wedge e^b = - e^b \wedge e^a
                    \\\
                    \\psi^\alpha \wedge \psi^\beta = + \psi^\beta \wedge \psi^\alpha
                    \\\
                    e^a \wedge \psi^\alpha = - \psi^\alpha \wedge e^a
                    \\end{aligned}
            %p
              (see at
              = succeed ")," do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/signs+in+supergeometry"} signs in supergeometry
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mi CE
                  %annotation{:encoding => "application/x-tex"} d_{CE}
              acts on the generators as follows:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mi d
                                    %mo −
                                    %mn 1
                                    %mo ,
                                    %mn 1
                                    %mo{:stretchy => "false"} |
                                    %mi N
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi ψ
                              %mi α
                          %mtd
                            %mo ≔
                            %mn 0
                        %mtr
                          %mtd
                            %msub
                              %mi d
                              %mrow
                                %msup
                                  %mi ℝ
                                  %mrow
                                    %mi d
                                    %mo −
                                    %mn 1
                                    %mo ,
                                    %mn 1
                                    %mo{:stretchy => "false"} |
                                    %mi N
                            %mspace{:width => "thickmathspace"}
                            %msup
                              %mi e
                              %mi a
                          %mtd
                            %mo ≔
                            %mover
                              %mi ψ
                              %mo ¯
                            %mo ∧
                            %msup
                              %mi Γ
                              %mi a
                            %mi ψ
                        %mtr
                          %mtd
                          %mtd
                            %mo ≔
                            %mrow
                              %mo (
                              %msub
                                %mi C
                                %mrow
                                  %mi α
                                  %mi α
                                  %mo ′
                              %msup
                                %mrow
                                  %msup
                                    %mi Γ
                                    %mi a
                                %mrow
                                  %mi α
                                  %mo ′
                              %msub
                                %mrow
                                %mi β
                              %mo )
                            %msup
                              %mi ψ
                              %mi α
                            %mo ∧
                            %msup
                              %mi ψ
                              %mi β
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    d_{\mathbb{R}^{d-1,1\vert N}} \; \psi^\alpha &amp;
                    \\coloneqq
                    0
                    \\\
                    d_{\mathbb{R}^{d-1,1\vert N}} \; e^a
                    \&amp; \coloneqq \overline{\psi} \wedge \Gamma^a \psi
                    \\\
                    \&amp; \coloneqq   \left(C_{\alpha \alpha'} {\Gamma^a}^{\alpha'}{}_\beta\right)  \psi^\alpha \wedge \psi^\beta
                    \\end{aligned}
                    \\,,
            %p where
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mover
                          %mi ψ
                          %mo ¯
                        %mo ∧
                        %msup
                          %mi Γ
                          %mi a
                        %mi ψ
                      %annotation{:encoding => "application/x-tex"} \overline{\psi} \wedge \Gamma^a \psi
                  denotes the
                  = succeed "-component" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi a
                        %annotation{:encoding => "application/x-tex"} a
                  = succeed "-invariant" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Spin
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} Spin(d-1,1)
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                        %mo{:lspace => "0em", :rspace => "thinmathspace"} otime
                        %mi N
                        %mo →
                        %msup
                          %mi ℝ
                          %mi d
                      %annotation{:encoding => "application/x-tex"} N \otime N \to \mathbb{R}^d
                  that comes with every
                  %a.existingWikiWord{:href => "/nlab/show/real+spin+representation"} real spin representation
                  applied to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ψ
                        %mo ∧
                        %mi ψ
                      %annotation{:encoding => "application/x-tex"} \psi \wedge \psi
                  regarded as an
                  = succeed "-valued" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi N
                          %mo ⊗
                          %mi N
                        %annotation{:encoding => "application/x-tex"} N \otimes N
              %li
                %p
                  hence in components (if
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi N
                      %annotation{:encoding => "application/x-tex"} N
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
                  representation, by
                  = succeed "):" do
                    %a{:href => "geometry+of+physics+--+supersymmetry#SpinorToVectorBilinearPairing"} this prop.
                %ol
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi C
                            %mo =
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi C
                              %mrow
                                %mi α
                                %mi α
                                %mo ′
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} C = (C_{\alpha \alpha'})
                      is the
                      %a.existingWikiWord{:href => "/nlab/show/charge+conjugation+matrix"} charge conjugation matrix
                      (as discussed at
                      = succeed ");" do
                        %em
                          %a.existingWikiWord{:href => "/nlab/show/Majorana+spinor"} Majorana spinor
                  %li
                    %p
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %msup
                              %mi Γ
                              %mi a
                            %mo =
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi Γ
                              %mi a
                            %msup
                              %mo{:stretchy => "false"} )
                              %mi α
                            %msub
                              %mrow
                              %mi β
                            %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \Gamma^a = ((\Gamma^a)^{\alpha}{}_\beta)
                      are the
                      %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
                      representing the
                      %a.existingWikiWord{:href => "/nlab/show/Clifford+algebra"} Clifford algebra
                      action on
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mi N
                          %annotation{:encoding => "application/x-tex"} N
                      in the
                      %a.existingWikiWord{:href => "/nlab/show/linear+basis"} linear basis
                      %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                        %semantics
                          %mrow
                            %mo{:stretchy => "false"} {
                            %msup
                              %mi ψ
                              %mi α
                            %msubsup
                              %mo{:stretchy => "false"} }
                              %mrow
                                %mi α
                                %mo =
                                %mn 1
                              %mrow
                                %msub
                                  %mi dim
                                  %mi ℝ
                                %mo{:stretchy => "false"} (
                                %mi N
                                %mo{:stretchy => "false"} )
                          %annotation{:encoding => "application/x-tex"} \{\psi^\alpha\}_{\alpha = 1}^{dim_{\mathbb{R}}(N)}
              %li
                %p
                  %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} summation over paired indices
                  is understood.
            %p
              That this indeed yields a
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              follows by the symmetry and equivariance of the bilinear spinor pairing (via
              = succeed ")." do
                %a{:href => "geometry+of+physics+--+supersymmetry#SpinorToVectorPairing"} this prop.
            %p
              There is a canonical
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
              of the
              %a.existingWikiWord{:href => "/nlab/show/special+orthogonal+Lie+algebra"} special orthogonal Lie algebra
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Lie
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Lie(Spin(d-1,1)) \simeq \mathfrak{so}(d-1,1)
            %p
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^{d-1,1\vert 1}
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi N
                    %annotation{:encoding => "application/x-tex"} N
                \-supersymmetric
                %a.existingWikiWord{:href => "/nlab/show/super+Poincar%C3%A9+Lie+algebra"} super Poincaré Lie algebra
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝔦𝔰𝔬
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi ℝ
                        %mrow
                          %mi d
                          %mo −
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} |
                          %mi N
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathfrak{iso}(\mathbb{R}^{d-1,1\vert N})
                in dimension
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                    %annotation{:encoding => "application/x-tex"} d
              is the
              %a.existingWikiWord{:href => "/nlab/show/super+Lie+algebra"} super Lie algebra
              which is the
              %a.existingWikiWord{:href => "/nlab/show/semidirect+product+Lie+algebra"} semidirect product Lie algebra
              of this
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+action"} Lie algebra action
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo ⋊
                    %mi 𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo −
                    %mn 1
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathfrak{iso}(\mathbb{R}^{d-1,1\vert N})
                    \=
                    \\mathbb{R}^{d-1,1\vert N} \rtimes \mathfrak{so}(d-1,1)
                    \\,.
            %p
              This is characterized by the fact that its
              %a.existingWikiWord{:href => "/nlab/show/Chevalley-Eilenberg+algebra"} Chevalley-Eilenberg algebra
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CE
                    %mo{:stretchy => "false"} (
                    %mi 𝔦𝔰𝔬
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℝ
                      %mrow
                        %mi d
                        %mo −
                        %mn 1
                        %mo ,
                        %mn 1
                        %mo{:stretchy => "false"} |
                        %mi N
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} CE(\mathfrak{iso}(\mathbb{R}^{d-1,1\vert N}))
              is as follows:
            %p
              it is
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
              from elements
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi e
                            %mi a
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi ψ
                            %mi α
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi odd
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi and
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %msup
                            %mi ω
                            %mrow
                              %mi a
                              %mi b
                          %mo =
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %msup
                            %mi ω
                            %mrow
                              %mi b
                              %mi a
                        %mo ⏟
                      %mrow
                        %mi deg
                        %mo =
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo ,
                        %mi even
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\underset{deg = (1,even)}{\underbrace{e^a}}
                    \\;\;\;\;
                    and
                    \\;\;\;\;
                    \\underset{deg = (1,odd)}{\underbrace{\psi^\alpha}}
                    \\;\;\;\;
                    and
                    \\;\;\;\;
                    \\underset{deg = (1,even)}{\underbrace{\omega^{a b} = - \omega^{b a}}}
            %p
              with the
              %a.existingWikiWord{:href => "/nlab/show/super+vielbein"} super vielbein
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi e
                      %mi a
                    %mo ,
                    %msup
                      %mi ψ
