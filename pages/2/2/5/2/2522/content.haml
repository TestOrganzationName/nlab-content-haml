              = succeed ")" do
                %a{:href => "http://inspirehep.net/record/191839?ln=en"} SPIRE
          %p with review in
          %ul
            %li#EllisOlive10
              %a.existingWikiWord{:href => "/nlab/show/John+Ellis"}> John Ellis
