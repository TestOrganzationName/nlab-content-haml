            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ≤
                  %mi n
                  %mo +
                  %mn 1
                %annotation{:encoding => "application/x-tex"} r \leq n + 1
            (except when
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} n = -2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                  %mo ≥
                  %mn 0
                %annotation{:encoding => "application/x-tex"} r \geq 0
            and so we simply take
            = succeed ".)" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} r = 0
          %h2#HomtopyTheory Homotopy-theoretic relation
          %p
            From the point of view of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,r)
            %a.existingWikiWord{:href => "/nlab/show/homotopy+n-type"} homotopy n-type
            and that of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/directed+space"} directed space
          %p
            Recall that an
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C0%29-category"} (∞,0)-category
            is an
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/homotopy+hypothesis"} homotopy hypothesis
            – that identifies
            = succeed "-groupoids" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
            and
            %a.existingWikiWord{:href => "/nlab/show/n-groupoids"} n-groupoids
            with
            %a.existingWikiWord{:href => "/nlab/show/homotopy+n-types"} homotopy n-types
            – and in view of the notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/directed+space"} directed space
          .standout
            %p
              An
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi r
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n,r)
              = succeed "-directed" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "-type." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
          %p Here we read
          %ul
            %li
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} 0
                \-directed
              as
              %em undirected
          %p and
          %ul
            %li
              %em
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn 1
                    %annotation{:encoding => "application/x-tex"} 1
                \-directed
              as
              %em directed
              \.
          %p Then, indeed, we have for instance that
          %ul
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/%281%2C0%29-category"} (1,0)-category
                is an undirected 1-type: a 1-
                %a.existingWikiWord{:href => "/nlab/show/groupoid"}> groupoid
                ,
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/%28n%2Cr%29-category"} (2,0)-category
                is an undirected 2-type: a
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/2-groupoid"} 2-groupoid
            %li
              %p etc.
            %li
              %p
                a
                %a.existingWikiWord{:href => "/nlab/show/%28n%2Cn%29-category"} (1,1)-category
                is
                %strong directed 1-type
