            %li
              %p
                an
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cn%29-category"} (∞,n)-category
                is an
                = succeed "-directed" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi n
                      %annotation{:encoding => "application/x-tex"} n
            %li
              %p etc.
          %h2#special_cases Special cases
          %p
            An
