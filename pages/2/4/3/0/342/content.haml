          %h2#idea Idea
          %p
            An
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,r)
            %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} higher category
            such that, essentially:
          %ul
            %li
              %p
                all
                %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo &gt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} k \gt n
                are trivial.
            %li
              %p
                all
                %a.existingWikiWord{:href => "/nlab/show/k-morphisms"} k-morphisms
                for
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo &gt;
                      %mi r
                    %annotation{:encoding => "application/x-tex"} k \gt r
                are reversible.
          %p
            Put another way: given a sequence of (higher) categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mn 0
                  %mo ,
                  %msub
                    %mi C
                    %mn 1
                  %mo ,
                  %mo .
                  %mo .
                  %mo .
                  %mo ,
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_0, C_1, ..., C_n
            in which each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mrow
                      %mi i
                      %mo +
                      %mn 1
                %annotation{:encoding => "application/x-tex"} C_{i+1}
            is of the form
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi B
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Hom(A, B)
            for some
            = succeed "-cells" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} 0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi B
                %annotation{:encoding => "application/x-tex"} B
            from
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mi i
                  %annotation{:encoding => "application/x-tex"} C_i
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mi n
                %annotation{:encoding => "application/x-tex"} C_n
            is a depth-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            Hom-category of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi C
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} C_0
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            Hom-categories, by taking the position that there are none). An
            = succeed "-category," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n, r)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi r
                %annotation{:encoding => "application/x-tex"} r
            Hom-category is an
            = succeed "-groupoid," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi n
                  %mo +
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (n+2)
            Hom-category is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/point"} point
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo +
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n+2
            here rather than
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            allows us to make sense of this definition even when
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            is as low as
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} -2
          %p
            So
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,r)
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            %a.existingWikiWord{:href => "/nlab/show/n-category"} categories
            and
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} groupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            increases, there are many more possibilities, until there are infinitely many kinds of
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,r)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2Cn%29-category"} categories
          %p
          .num_remark
            %h6 Remark
            %p This definition does not attempt to cover all possible scenarios regarding the triviality or invertibility of morphisms at different dimensions. In particular:
            %ul
              %li
                %p
                  In general, if a morphism at dimension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  always uniquely exists, it need not follow that a morphism at dimension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} k+1
                  always uniquely exists. A counterexample are monoid-
                  %a.existingWikiWord{:href => "/nlab/show/enriched+category"}> enriched categories
                  , where we
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} view monoids as single-object categories
                  %em sets
                  of 1-morphisms are singletons, but whose sets of 2-morphisms are not.
              %li
                %p
                  In general, if all morphisms at dimension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                      %annotation{:encoding => "application/x-tex"} k
                  are invertible, it need not follow that all morphisms at dimension
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi k
                        %mo +
                        %mn 1
                      %annotation{:encoding => "application/x-tex"} k+1
                  are invertible. A counterexample is ordered groupoids, and in particular the
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+categorification"} single object case
                  of
                  %a.existingWikiWord{:href => "/nlab/show/ordered+groups"} ordered groups
                  such as
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi ℤ
                          %mo ,
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                          %mo ,
                          %mo ≤
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} (\mathbb{Z}, +, \leq)
            %p
              A more fine-grained classification of higher categories could thus be imagined, where we would not specify two numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi r
                    %annotation{:encoding => "application/x-tex"} r
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
          %h2#Definition Definition
          %p
            Given a notion of
            %a.existingWikiWord{:href => "/nlab/show/infinity-category"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
              \-category
            (as weak or strict as you like), then an
            %strong
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo ,
                    %mi r
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n,r)
              \-category
            can be defined to be an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %ul
            %li
              any two
              %a.existingWikiWord{:href => "/nlab/show/parallel+morphisms"} parallel
              = succeed "-morphisms" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed ";" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo &gt;
                      %mi n
                    %annotation{:encoding => "application/x-tex"} k \gt n
            %li
              any
              = succeed "-morphism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo &gt;
                      %mi r
                    %annotation{:encoding => "application/x-tex"} k \gt r
          %p
            As explained below, we may assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ≥
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mn 2
                %annotation{:encoding => "application/x-tex"} n \geq -2
            and
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 0
                    %mo ≤
                    %mi r
                    %mo ≤
                    %mi max
                    %mo{:stretchy => "false"} (
                    %mn 0
                    %mo ,
                    %mi n
                    %mo +
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 0 \leq r \leq \max(0, n + 1)
          %p
            For finite
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                  %annotation{:encoding => "application/x-tex"} r
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cr%29-categories"} (∞,r)-categories
            as follows:
          .num_defn
            %h6#definition_2 Definition
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 2
                      %mo ≤
                      %mi n
                      %mo ≤
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} -2 \leq n \leq \infty
              %strong
                %a.existingWikiWord{:href => "/nlab/show/%28n%2C0%29-category"} (n,0)-category
              is an
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              that is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/n-truncated"} n-truncated
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/n-groupoid"} n-groupoid
            %p
              For
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn 0
                      %mo &lt;
                      %mi r
                      %mo &lt;
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} 0 \lt r \lt \infty
              %strong (n,r)-category
              is an
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2Cr%29-category"} (∞,r)-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              such that for all
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X,Y \in C
              the
              = succeed "-categorical" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mi r
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,r-1)
              %a.existingWikiWord{:href => "/nlab/show/hom-object"} hom-object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi Y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} C(X,Y)
              is an
              = succeed "-category." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo −
                      %mn 1
                      %mo ,
                      %mi r
                      %mo −
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n-1,r-1)
          %p
            (Even for
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi r
                    %mo =
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} r = \infty
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mo −
                  %mn 1
                %annotation{:encoding => "application/x-tex"} \infty - 1
            to be
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mn 1
                    %mo ,
                    %mn ∞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (-1,\infty)
            = succeed "-category." do
