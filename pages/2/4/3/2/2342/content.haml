                    %mi Δ
                    %mo =
                    %msubsup
                      %mi c
                      %mn 4
                      %mn 3
                    %mo −
                    %msubsup
                      %mi c
                      %mn 6
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    1728 \Delta = c_4^3 - c_6^2
                    \\,.
          .num_remark
            %h6#remark_4 Remark
            %p
              Over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} R = \mathbb{C}
              the
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              the quantities
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} c_4
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} c_6
              in def.
              %a.maruku-ref{:href => "#DiscriminantAndJInvariant"}
              are proportional to the
              %a.existingWikiWord{:href => "/nlab/show/modular+forms"} modular forms
              called the
              %a.existingWikiWord{:href => "/nlab/show/Eisenstein+series"} Eisenstein series
              (see there)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi G
                      %mn 4
                  %annotation{:encoding => "application/x-tex"} G_4
              and
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mn 6
                    %annotation{:encoding => "application/x-tex"} G_6
          %h5#EllipticCurvesNodalCurvesCuspidalCurves Elliptic curves, Nodal curves, Cuspidal curves
          %p
            The following is a definition if one takes the coordinate-description as fundamental. If one takes the more abstract characterization of def.
            %a.maruku-ref{:href => "#EllipticCurve"}
            as fundamental then the following is a proposition.
          .num_defn
            %h6#definitionproposition Definition/Proposition
            %p
              A solution to the Weierstrass cubic, def.
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralWeierstrassCubic"}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi c
                        %mn 4
                    %annotation{:encoding => "application/x-tex"} c_4
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi c
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} c_6
              and discriminant
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                  %annotation{:encoding => "application/x-tex"} \Delta
              according to def.
              %a.maruku-ref{:href => "#DiscriminantAndJInvariant"}
              is
            %ol
              %li
                %p
                  an
                  %em elliptic curve
                  iff
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi Δ
                          %mo ≠
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} \Delta \neq 0
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/nodal+curve"} nodal curve
                  or
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cubic+curve"} cubic curve
                    with nodal
                    %a.existingWikiWord{:href => "/nlab/show/singular+point+of+an+algebraic+variety"} singularity
                  iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \Delta = 0
                  and
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi c
                            %mn 4
                          %mo ≠
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} c_4 \neq 0
              %li
                %p
                  a
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cuspidal+curve"} cuspidal curve
                  or
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/cubic+curve"} cubic curve
                    with
                    %a.existingWikiWord{:href => "/nlab/show/cusp"} cusp
                    %a.existingWikiWord{:href => "/nlab/show/singular+point+of+an+algebraic+variety"} singularity
                  iff
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Δ
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} \Delta = 0
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 4
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} c_4 = 0
                  (which by remark
                  %a.maruku-ref{:href => "#RelationBetweenDiscriminantAndTheModularInvariants"}
                  is equivalent to
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi c
                          %mn 4
                        %mo =
                        %mn 0
                      %annotation{:encoding => "application/x-tex"} c_4 = 0
                  and
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi c
                            %mn 6
                          %mo =
                          %mn 0
                        %annotation{:encoding => "application/x-tex"} c_6 = 0
          .num_remark
            %h6#remark_5 Remark
            %p
              Adding the nodal curve to the
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
              yields its
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/compactification"} compactification
              %a.existingWikiWord{:href => "/nlab/show/formal+neighbourhood"} formal neighbourhood
              of the nodal curve in that compactification is known as the
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/Tate+curve"} Tate curve
          %h5#localization_at_2_and_3 Localization at 2 and 3
          #WeierstrassEquationLocalAt2And3.num_prop
            %h6#proposition Proposition
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 2
                  %annotation{:encoding => "application/x-tex"} 2
              is invertible in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              (is a
              %a.existingWikiWord{:href => "/nlab/show/unit"} unit
              ), and hence generally over the
              %a.existingWikiWord{:href => "/nlab/show/localization+of+a+ring"} localization
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[\frac{1}{2}]
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              at 2, the general
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Weierstrass+equation"} Weierstrass equation
              = succeed "," do
                %a.maruku-ref{:href => "#GeneralWeierstrassCubic"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi y
                      %mn 2
                    %mo =
                    %mn 4
                    %msup
                      %mi x
                      %mn 3
                    %mo +
                    %msub
                      %mi b
                      %mn 2
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %mn 2
                    %msub
                      %mi b
                      %mn 4
                    %mi x
                    %mo +
                    %msub
                      %mi b
                      %mn 6
                  %annotation{:encoding => "application/x-tex"}
                    y^2  = 4 x^3  + b_2 x^2 + 2 b_4 x + b_6
            %p
              with the
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              identified as in def.
              = succeed "." do
                %a.maruku-ref{:href => "#DiscriminantAndJInvariant"}
            %p
              If moreover
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} 3
              is also invertible in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo{:stretchy => "false"} [
                    %mfrac
                      %mn 1
                      %mn 2
                    %mo ,
                    %mfrac
                      %mn 1
                      %mn 3
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} R[\frac{1}{2}, \frac{1}{3}]
              then this equation is equivalent to just
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi y
                      %mn 2
                    %mo =
                    %msup
                      %mi x
                      %mn 3
                    %mo −
                    %mn 27
                    %msub
                      %mi c
                      %mn 4
                    %mi x
                    %mo −
                    %mn 54
                    %msub
                      %mi c
                      %mn 6
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    y^2 = x^3 - 27 c_4 x - 54 c_6
                    \\,.
          %h3#OverTheComplexNumbers Over the complex numbers
          %h4#in_terms_of_algebraic_geometry In terms of algebraic geometry
          .num_remark
            %h6#remark_6 Remark
            %p
              If the
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                    %mo =
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} R= \mathbb{C}
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %a.existingWikiWord{:href => "/nlab/show/Weierstrass+equation"} Weierstrass equation
              as in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#WeierstrassEquationLocalAt2And3"}
              %a.existingWikiWord{:href => "/nlab/show/torus"} torus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi z
                    %mo ∈
                    %mi ℂ
                    %mo{:stretchy => "false"} /
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} z \in \mathbb{C}/\Lambda
              (as discussed in the section
              = succeed ")" do
                %a{:href => "#InTermsOfCpomplexGeometry"} in terms of complex geometry
              %a.existingWikiWord{:href => "/nlab/show/Weierstrass+elliptic+function"} Weierstrass elliptic function
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℘
                  %annotation{:encoding => "application/x-tex"} \wp
              as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo =
                    %mi ℘
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi y
                    %mo =
                    %mi ℘
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (x = \wp(z), y = \wp'(z), )
              in the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℘
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi z
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo +
                    %mn 4
                    %mi ℘
                    %mo{:stretchy => "false"} (
                    %mi z
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 3
                    %mo −
                    %msub
                      %mi g
                      %mn 2
                    %mi p
                    %mo{:stretchy => "false"} (
                    %mi z
                    %mo{:stretchy => "false"} )
                    %mo −
                    %msub
                      %mi g
                      %mn 3
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\wp'(z)^2 + 4 \wp(z)^3 - g_2 p(z) - g_3
                    \\,.
          %p
            See e.g. (
            %a{:href => "#Hain08"}> Hain 08, section 5
            ) on how complex elliptic curves are expressed in this algebraic geometric fashion.
          %h4#InTermsOfCpomplexGeometry In terms of complex geometry
          #CharacterizationOverC.num_prop
            %h6#proposition_2 Proposition
            %p
              An
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
              = succeed "," do
                %a.maruku-ref{:href => "#EllipticCurve"}
              %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              is equivalently
            %ul
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/Riemann+surface"} Riemann surface
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  of
                  %a.existingWikiWord{:href => "/nlab/show/genus"} genus
                  1 with a base point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi P
                        %mo ∈
                        %mi X
                      %annotation{:encoding => "application/x-tex"} P \in X
                  (e.g.
                  %a{:href => "#Hain08"}> Hain 08, def. 1.1
                  )
              %li
                %p
                  a quotient
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi ℂ
                        %mo{:stretchy => "false"} /
                        %mi Λ
                      %annotation{:encoding => "application/x-tex"} \mathbb{C}/\Lambda
                  where
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Λ
                      %annotation{:encoding => "application/x-tex"} \Lambda
                  is a
                  %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
                  in
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi ℂ
                        %annotation{:encoding => "application/x-tex"} \mathbb{C}
              %li
                %p
                  a compact complex
                  %a.existingWikiWord{:href => "/nlab/show/Lie+group"} Lie group
                  of dimension 1.
              %li
                %p
                  a
                  %a.existingWikiWord{:href => "/nlab/show/smooth+scheme"} smooth
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+curve"} algebraic curve
                  of degree 3 in
                  = succeed "." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi 𝒫
                        %annotation{:encoding => "application/x-tex"} \mathcal{P}
          .num_remark
            %h6#remark_7 Remark
            %p
              From the second definition it follows that to study the
              %a.existingWikiWord{:href => "/nlab/show/moduli+space+of+elliptic+curves"} moduli space of elliptic curves
              it suffices to study the
              %a.existingWikiWord{:href => "/nlab/show/moduli+space"} moduli space
              of
              %a.existingWikiWord{:href => "/nlab/show/lattices"} lattices
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℂ
                    %annotation{:encoding => "application/x-tex"} \mathbb{C}
          .num_defn
            %h6#definition_5 Definition
            %p
              A
              %strong
                %a.existingWikiWord{:href => "/nlab/show/framed+elliptic+curve"} framed elliptic curve
              is an elliptic curve
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi P
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X,P)
              in the sense of the first item in prop.
              = succeed "," do
                %a.maruku-ref{:href => "#CharacterizationOverC"}
              %a.existingWikiWord{:href => "/nlab/show/ordering"} ordered
              %a.existingWikiWord{:href => "/nlab/show/basis"} basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ,
                    %mi b
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (a,b)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi H
                      %mn 1
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo ,
                    %mi ℤ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H_1(X, \mathbb{Z})
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi a
                    %mo ⋅
                    %mi b
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} (a \cdot b) = 1
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              a natural number, a
              %strong
                %a.existingWikiWord{:href => "/nlab/show/level+n-structure+on+an+elliptic+curve"} level n-structure on an elliptic curve
              over the complex numbers is similar data but with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              only in the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mi n
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
            %p
              A
              %strong framed lattice
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} \mathbb{C}
              is a lattice
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              together with an ordered basis
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi λ
                      %mn 1
                    %mo ,
                    %msub
                      %mi λ
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\lambda_1, \lambda_2)
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Λ
                  %annotation{:encoding => "application/x-tex"} \Lambda
              such that
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Im
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi λ
                        %mn 2
                      %mo{:stretchy => "false"} /
                      %msub
                        %mi λ
                        %mn 1
                      %mo{:stretchy => "false"} )
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} Im(\lambda_2/\lambda_1) \gt 0
          %p
            Hence a framed elliptic curve is the quotient of the complex plane by a lattice
            %em together
            with the information on how this quotient was obtained. This is useful for describing the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
            over the complex numbers.
          %h3#OverTheRationalNumbers Over the rational numbers
          %p
            Over the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            %a{:href => "http://www.sagemath.org/doc/reference/plane_curves/sage/schemes/elliptic_curves/ell_rational_field.html"} Sagemath: Elliptic curves over the rational numbers
          %h3#OverpAdics
            Over the
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
            = succeed "-adic" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          %p
            Over the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/p-adic+integers"} p-adic integers
            = succeed ")." do
              %a{:href => "#Conrad07"} Conrad 07
          %p
            Over the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/p-adic+numbers"} p-adic numbers
            = succeed ")." do
              %a{:href => "#Winter11"} Winter 11
          %h2#level_structures Level structures
          %p
            In the case over the
            %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
            an elliptic curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            is equivalently the
            %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
            of the
            %a.existingWikiWord{:href => "/nlab/show/complex+plane"} complex plane
            by a framed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/lattice"} lattice
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi a
                    %mn 1
                  %mo ,
                  %msub
                    %mi a
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo ∈
                  %msub
                    %mi H
                    %mn 1
                  %mo{:stretchy => "false"} (
                  %mi Σ
                  %mo ,
                  %mi ℤ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  (a_1, a_2)\in H_1(\Sigma, \mathbb{Z})
          %p
            of the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            group of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Σ
                %annotation{:encoding => "application/x-tex"} \Sigma
            with
            %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
            in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/integers"} integers
          %p
            If here one replaces the integers by a
            %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℤ
                  %mo{:stretchy => "false"} /
                  %mi n
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} \mathbb{Z}/n\mathbb{Z}
            then one obtains what is called a
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/level+structure+on+an+elliptic+curve"} level-n structure on an elliptic curve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            structures on elliptic curves may also be defined over general rings.
          %p
            These structures are useful in that the
            %a.existingWikiWord{:href => "/nlab/show/moduli+stack"} moduli stack
            of
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curves+with+level-n+structure"} elliptic curves with level-n structure
            (a
            %em
              %a.existingWikiWord{:href => "/nlab/show/modular+curve"} modular curve
            in the case over the complex numbers) provides a finite
            %a.existingWikiWord{:href => "/nlab/show/covering"} covering
            of the full
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
          %h2#group_structure Group structure
          %p
            A vital reason for the importance of elliptic curves in number theory, arithmetic geometry, and elsewhere is their group structure. This group structure is present by fiat in Definition
            = succeed "," do
              %a.maruku-ref{:href => "#DefinitionEllipticCurve"}
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/torsion+element"} torsion elements
            of this group structure when the elliptic curve is defined over a
            %a.existingWikiWord{:href => "/nlab/show/number+field"} number field
            have good Galois-theoretic properties. See
            %a.existingWikiWord{:href => "/nlab/show/torsion+points+of+an+elliptic+curve"} torsion points of an elliptic curve
            for more.
          %h2#constructions Constructions
          %h3#formal_group_law Formal group law
          %p
            Given an
            %a.existingWikiWord{:href => "/nlab/show/elliptic+curve"} elliptic curve
            over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo →
                    %mi Spec
                    %mi R
                  %annotation{:encoding => "application/x-tex"} E \to Spec R
            %a.existingWikiWord{:href => "/nlab/show/formal+group"} formal group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                %annotation{:encoding => "application/x-tex"} \hat E
            by completing
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            along its identity
            %a.existingWikiWord{:href => "/nlab/show/section"} section
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi σ
                    %mn 0
                %annotation{:encoding => "application/x-tex"} \sigma_0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo →
                  %mi Spec
                  %mo{:stretchy => "false"} (
                  %mi R
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi σ
                        %mn 0
                  %mi E
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  E \to Spec(R) \stackrel{\sigma_0}{\to} E
                  \\,,
          %p
            we get a
            %a.existingWikiWord{:href => "/nlab/show/ringed+space"} ringed space
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mover
                    %mi E
                    %mo{:stretchy => "false"} ^
                  %mo ,
                  %msub
                    %mover
                      %mi O
                      %mo{:stretchy => "false"} ^
                    %mrow
                      %mi E
                      %mo ,
                      %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\hat E, \hat O_{E,0})
          .num_example
            %h6#example Example
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              is a
              %a.existingWikiWord{:href => "/nlab/show/field"} field
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              %a.existingWikiWord{:href => "/nlab/show/structure+sheaf"} structure sheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi O
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi E
                        %mo ,
                        %mn 0
                    %mo ≃
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi z
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} \hat O_{E,0} \simeq k[ [z] ]
            %p then
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mover
                        %mi O
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi E
                        %mo ×
                        %mi E
                        %mo ,
                        %mo{:stretchy => "false"} (
                        %mn 0
                        %mo ,
                        %mn 0
                        %mo{:stretchy => "false"} )
                    %mo ≃
                    %msub
                      %mover
                        %mi O
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi E
                        %mo ,
                        %mn 0
                    %msub
                      %mover
                        %mo ⊗
                        %mo{:stretchy => "false"} ^
                      %mi k
                    %msub
                      %mover
                        %mi O
                        %mo{:stretchy => "false"} ^
                      %mrow
                        %mi E
                        %mo ,
                        %mn 0
                    %mo ≃
                    %mi k
                    %mo{:stretchy => "false"} [
                    %mo{:stretchy => "false"} [
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"}
                    \\hat O_{E \times E, (0,0)} \simeq
                    \\hat O_{E,0}
                    \\hat \otimes_k
                    \\hat O_{E,0}
                    \\simeq
                    k[[x,y]]
          .num_example
            %h6#example_2 Example
            %p
              %strong (Jacobi quartics)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi y
                      %mn 2
                    %mo =
                    %mn 1
                    %mo −
                    %mn 2
                    %mi δ
                    %msup
                      %mi x
                      %mn 2
                    %mo +
                    %mi ϵ
                    %msup
                      %mi x
                      %mn 4
                  %annotation{:encoding => "application/x-tex"}
                    y^2 = 1- 2 \delta x^2 + \epsilon x^4
            %p
              defines
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              over
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo =
                      %mi ℤ
                      %mo{:stretchy => "false"} [
                      %msub
                        %mi Y
                        %mi Z
                      %mo ,
                      %mi ϵ
                      %mo ,
                      %mi δ
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} R = \mathbb{Z}[Y_Z,\epsilon, \delta]
            %p
              The corresponding
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
              is
              %strong Euler’s formal group law
            #eq:EulerFormalGroupLaw.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mi x
                        %msqrt
                          %mrow
                            %mn 1
                            %mo −
                            %mn 2
                            %mi δ
                            %msup
                              %mi y
                              %mn 2
                            %mo +
                            %mi ϵ
                            %msup
                              %mi y
                              %mn 4
                        %mo +
                        %mi y
                        %msqrt
                          %mrow
                            %mn 1
                            %mo −
                            %mn 2
                            %mi δ
                            %msup
                              %mi x
                              %mn 2
                            %mo +
                            %mi ϵ
                            %msup
                              %mi x
                              %mn 4
                      %mrow
                        %mn 1
                        %mo −
                        %mi ϵ
                        %msup
                          %mi x
                          %mn 2
                        %msup
                          %mi y
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    f(x,y)
                    \\;=\;
                    \\frac{
                    x{\sqrt{1- 2 \delta y^2 + \epsilon y^4}} + y{\sqrt{1- 2 \delta x^2 + \epsilon x^4}}
                    }
                    {1- \epsilon x^2 y^2}
            %p
              if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo ≔
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi δ
                      %mn 2
                    %mo −
                    %mi ϵ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo ≠
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \Delta \coloneqq \epsilon(\delta^2 - \epsilon)^2 \neq 0
              then this is a non-trivial elliptic curve.
          %p
            If
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo =
                  %mn 0
                %annotation{:encoding => "application/x-tex"} \Delta = 0
            then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mi G
                    %mi m
                  %mo ,
                  %msub
                    %mi G
                    %mi a
                %annotation{:encoding => "application/x-tex"} f(x,y) \simeq G_m, G_a
            (
            %a.existingWikiWord{:href => "/nlab/show/additive+group"} additive
            or
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+group"} multiplicative
            formal group law corresponding to
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            and
            %a.existingWikiWord{:href => "/nlab/show/topological+K-theory"} topological K-theory
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/KU"} KU
          %h3#elliptic_cohomology_2 Elliptic cohomology
          %p
            Elliptic curves, via their
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"} elliptic cohomology
            theories.
          %p See also
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/A+Survey+of+Elliptic+Cohomology+-+formal+groups+and+cohomology"} A Survey of Elliptic Cohomology - formal groups and cohomology
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/abelian+variety"} abelian variety
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Tate+curve"} Tate curve
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Szpiro%27s+conjecture"} Szpiro's conjecture
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cubic+curve"} cubic curve
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/moduli+stack+of+elliptic+curves"} moduli stack of elliptic curves
              %ul
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/modular+form"}> modular form
                    ,
                    %a.existingWikiWord{:href => "/nlab/show/Jacobi+form"} Jacobi form
                %li
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/topological+modular+form"} topological modular form
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/modularity+theorem"} modularity theorem
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/elliptic+fibration"} elliptic fibration
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/elliptic+cohomology"}> elliptic cohomology
                ,
                %a.existingWikiWord{:href => "/nlab/show/tmf"} tmf
          %h2#references References
          %p Classical accounts of the general case:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Rapoport"} Michael Rapoport
                %em Les Schémas de Modules de Courbes Elliptiques
                In: Deligne P., Kuijk W. (eds)
                = succeed "," do
                  %em Modular Functions of One Variable II
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/978-3-540-37855-6_4"} doi:10.1007/978-3-540-37855-6_4
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
                ,
                %em Courbes Elliptiques: Formulaire (d’apres J. Tate)
                (
                %a{:href => "http://modular.math.washington.edu/Tables/antwerp/deligne/"}> web
                )
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Nicholas+Katz"}> Nicholas Katz
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Barry+Mazur"} Barry Mazur
                %em Arithmetic moduli of elliptic curves, Annals of Mathematics Studies
                %strong 108
                Princeton University Press (1985) &amp;lbrack;
                %a{:href => "https://www.jstor.org/stable/j.ctt1b9s05p"}> jstor:j.ctt1b9s05p
                \&amp;rbrack;
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Joachim+Wehler"}> Joachim Wehler
                \:
                %em Modular Forms and Elliptic Curves
                (2021) &amp;lbrack;
                %a{:href => "https://www.mathematik.uni-muenchen.de/~wehler/ModularFormsScript.pdf"}> pdf
                \&amp;rbrack;
          %p Introductory lecture notes for elliptic curves over the complex numbers:
          %ul
            %li#Hain08
              %p
                Richard Hain,
                %em Lectures on Moduli Spaces of Elliptic Curves
                (
                %a{:href => "http://arxiv.org/abs/0812.1803"}> arXiv:0812.1803
                )
            %li#Neeman07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Amnon+Neeman"}> Amnon Neeman
                , section 1.2 of
                = succeed "," do
                  %em Algebraic and analytic geometry
                = succeed "," do
                  %strong 345
                = succeed ")" do
                  %a{:href => "http://www.cambridge.org/us/academic/subjects/mathematics/geometry-and-topology/algebraic-and-analytic-geometry"} publisher
          %p and for the general case:
          %ul
            %li#QuickIntro
              %p
                %em A quick introduction to elliptic curves
                (
                %a{:href => "http://people.reed.edu/~jerry/311/ecintro.pdf"}> pdf
                )
            %li
              %p
                R. Sujatha,
                %em Elliptic Curves &amp; Number Theory
                (
                %a.existingWikiWord{:href => "/nlab/files/SujahtaElliptic.pdf", :title => "pdf"}> pdf
                )
            %li#Sutherland21
              %p
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Sutherland"}> Andrew Sutherland
                ,
                = succeed "," do
                  %em Elliptic curves
                = succeed ")" do
                  %a{:href => "https://ocw.mit.edu/courses/18-783-elliptic-curves-spring-2021/"} web
          %p See also
          %ul
            %li#AndoHopkinsStrickland01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Neil+Strickland"} Neil Strickland
                = succeed "," do
                  %em Elliptic spectra, the Witten genus, and the theorem of the cube
                = succeed "," do
                  %a{:href => "http://www.math.rochester.edu/people/faculty/doug/otherpapers/musix.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s002220100175"} doi:10.1007/s002220100175
              %p
                (review of general elliptic curves in the context of
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/elliptic+genera"} elliptic genera
                %a.existingWikiWord{:href => "/nlab/show/elliptic+spectra"} elliptic spectra
                and the
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/string+orientation+of+tmf"} string orientation of tmf
          %p
            Discussion of the
            %a.existingWikiWord{:href => "/nlab/show/formal+group+law"} formal group law
            of elliptic curves:
          %ul
            %li
              %p
                Antonia W. Bluher,
                = succeed "," do
                  %em Formal groups, elliptic curves, and some theorems of Couveignes
                %em Algorithmic Number Theory
                ANTS 1998. Lecture Notes in Computer Science, vol 1423. Springer 1998 (
                %a{:href => "https://arxiv.org/abs/math/9708215"}> arXiv:math/9708215
                ,
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/BFb0054887"} doi:10.1007/BFb0054887
            %li#Friedl17
              %p
                Stefan Friedl,
                %em An elementary proof of the group law for elliptic curves
                (
                %a{:href => "https://arxiv.org/abs/1710.00214"}> arXiv:1710.00214
                )
          %p
            For more along these lines see also at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/arithmetic+geometry"} arithmetic geometry
          %p
            In the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/elliptic+fibrations"} elliptic fibrations
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Rick+Miranda"}> Rick Miranda
              ,
              = succeed "," do
                %em The basic theory of elliptic surfaces
              = succeed ")" do
                %a{:href => "http://www.math.colostate.edu/~miranda/BTES-Miranda.pdf"} pdf
          %p A general textbook account is
          %ul
            %li#Silverman09
              %a.existingWikiWord{:href => "/nlab/show/Joseph+Silverman"}> Joseph Silverman
              ,
              = succeed "," do
                %em The arithmetic of elliptic curves
          %p
            Discussion over the
            %a.existingWikiWord{:href => "/nlab/show/rational+numbers"} rational numbers
            includes
          %ul
            %li
              Sagemath
              %em
                %a{:href => "http://www.sagemath.org/doc/reference/plane_curves/sage/schemes/elliptic_curves/ell_rational_field.html"} Elliptic curves over the rational numbers
          %p
            Discussion of elliptic curves over the
            %a.existingWikiWord{:href => "/nlab/show/p-adic+numbers"} p-adic numbers
            includes
          %ul
            %li#Conrad07
              %p
                %a.existingWikiWord{:href => "/nlab/show/Brian+Conrad"}> Brian Conrad
                \:
                = succeed "," do
                  %em Arithmetic moduli of generalized elliptic curves
                %strong 6
                2 (2007) 209-278 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S1474748006000089"}> doi:10.1017/S1474748006000089
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://math.stanford.edu/~conrad/papers/kmpaper.pdf"} pdf
            %li#Winter11
              %p
                Rosa Winter,
                = succeed "," do
                  %em
                    Elliptic curves over
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi ℚ
                            %mi p
                        %annotation{:encoding => "application/x-tex"} \mathbb{Q}_p
                = succeed ")" do
                  %a{:href => "http://www.math.leidenuniv.nl/scripties/BachWinter.pdf"} pdf
          %p See also
          %ul
            %li
              %em
                %a.existingWikiWord{:href => "/nlab/show/A+Survey+of+Elliptic+Cohomology+-+elliptic+curves"} A Survey of Elliptic Cohomology - elliptic curves
