                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              %a.existingWikiWord{:href => "/nlab/show/Zariski+topology"} Zariski locally
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Spec
                    %mo{:stretchy => "false"} (
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Spec(R)
              a
              %a.existingWikiWord{:href => "/nlab/show/cubic+curve"} cubic curve
              is a solution in the corresponding
              %a.existingWikiWord{:href => "/nlab/show/projective+space"} projective space
              to an
              %a.existingWikiWord{:href => "/nlab/show/equation"} equation
              of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
