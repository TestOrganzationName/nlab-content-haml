                    %annotation{:encoding => "application/x-tex"} R
            %p
          .num_remark
            %h6#remark Remark
            %p
              This implies that an elliptic curve has
              %a.existingWikiWord{:href => "/nlab/show/arithmetic+genus"} arithmetic genus
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
