            %p
              Since the two braidings above are equivalent (
              %a{:href => "chain+complex+in+super+vector+spaces#EquivalenceTwoSymmetricMonoidalStructuresOnChSuperVect"}> this Prop
              ) the corresponding two categories of
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebras"} differential graded-commutative superalgebras
              are also canonically
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ComMon
                    %mrow
                      %mo (
                      %mi Ch
                      %mo{:stretchy => "false"} (
                      %mi SuperVect
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %msub
                        %mi τ
                        %mi Deligne
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ComMon
                    %mrow
                      %mo (
                      %mi Ch
                      %mo{:stretchy => "false"} (
                      %mi SuperVect
                      %mo{:stretchy => "false"} )
                      %mo ,
                      %mo ⊗
                      %mo ,
                      %msub
                        %mi τ
                        %mi Bernst
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    ComMon\left(  Ch(SuperVect), \otimes, \tau_{Deligne} \right)
                    \\;\simeq\;
                    ComMon\left(  Ch(SuperVect), \otimes, \tau_{Bernst} \right)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi sdgcAlg
