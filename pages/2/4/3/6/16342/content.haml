                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi sdgcAlg
                      %mi Bernst
                  %annotation{:encoding => "application/x-tex"}
                    sdgcAlg_{Deligne}
                    \\;\simeq\;
                    sdgcAlg_{Bernst}
          .num_example
            %h6#example_4 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring+spectra"}> commutative ring spectra
                ,
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/E-infinity+rings"} E-infinity rings
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi SymSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ∧
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi sym
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (SymSpec(Top_{cg}),\wedge, \mathbb{S}_{sym})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi OrthSpec
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi Top
                      %mi cg
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ∧
                    %mo ,
                    %msub
                      %mi 𝕊
                      %mi orth
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (OrthSpec(Top_{cg}),\wedge, \mathbb{S}_{orth})
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %msubsup
                      %mi Top
                      %mrow
                        %mi cg
                        %mo ,
                        %mi fin
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo ,
                    %msubsup
                      %mi Top
                      %mi cg
                      %mrow
                        %mo *
                        %mo{:stretchy => "false"} /
                    %mo{:stretchy => "false"} ]
                    %mo ,
                    %mo ∧
                    %mo ,
                    %mi 𝕊
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} ([Top^{\ast/}_{cg,fin}, Top^{\ast/}_{cg}], \wedge, \mathbb{S} )
              for the categories, respectively of
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+spectra"} symmetric spectra
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+spectra"} orthogonal spectra
              and
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/pre-excisive+functors"} pre-excisive functors
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+smash+product+of+spectra"} symmetric monoidal smash product of spectra
              %a.existingWikiWord{:href => "/nlab/show/tensor+unit"} tensor unit
              is the corresponding standard incarnation of the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
            %p
              A commutative monoid in any one of these three categories is equivalently a
              %a.existingWikiWord{:href => "/nlab/show/commutative+ring+spectrum"} commutative ring spectrum
              in the strong sense: via the respective
              %a.existingWikiWord{:href => "/nlab/show/model+structure+on+spectra"} model structure on spectra
              it represents an
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
          .num_example
            %h6#example_5 Example
            %p
              %strong (in a cocartesian monoidal category)
            %p
              Every object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              in a
              %a.existingWikiWord{:href => "/nlab/show/cocartesian+monoidal+category"} cocartesian monoidal category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              becomes a commutative monoid in a unique way: the multiplication must be the
              %a.existingWikiWord{:href => "/nlab/show/fold+map"} fold map
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo ∇
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo +
                      %mi A
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} \nabla \colon A + A \to A
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo !
                      %mo{:lspace => "verythinmathspace"} :
                      %mn 0
                      %mo →
                      %mi A
                    %annotation{:encoding => "application/x-tex"} ! \colon 0 \to A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              becomes a morphism of commutative monoid objects, so the category of commutative monoid objects in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is isomorphic to
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .num_example
            %h6#example_6 Example
            %p
              %strong
                (in
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi CommMon
                      %annotation{:encoding => "application/x-tex"} CommMon
            %p
              Since the category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi CommMon
                  %annotation{:encoding => "application/x-tex"} CommMon
              of commutative monoids (in
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi CommMon
                    %mo ,
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (CommMon,+)
              is again
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi CommMon
                    %annotation{:encoding => "application/x-tex"} CommMon
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
