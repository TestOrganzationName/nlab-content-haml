            %p
              in this algebra is the
              %a.existingWikiWord{:href => "/nlab/show/smooth+function"} smooth function
              (
              %a.existingWikiWord{:href => "/nlab/show/differential+0-forms"}> differential 0-forms
              ) which is
              %a.existingWikiWord{:href => "/nlab/show/constant+function"} constant
              on the
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ×
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n \times n
              %a.existingWikiWord{:href => "/nlab/show/identity+matrix"} identity matrix
              and independent of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi t
                    %annotation{:encoding => "application/x-tex"} t
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+principal+bundle"} connection
              on a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+valued+differential+form"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝔤
                    %annotation{:encoding => "application/x-tex"} \mathfrak{g}
                \-valued
              %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature form
              as an element of this algebra
            #eq:CurvatureFormAsElementOfMatrixValuedEvenDegreeDifferentialForm.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msup
