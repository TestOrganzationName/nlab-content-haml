                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %mi ℂ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{2\bullet}
                    \\big(X\big)
                    \\otimes_{\mathbb{R}}
                    End_{\mathbb{C}}(V)
                    \\;\simeq\;
                    \\Omega^{2\bullet}(X)
                    \\otimes_{\mathbb{R}}
                    \\big(
