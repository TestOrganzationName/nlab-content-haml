                    %mrow
                      %msubsup
                        %mi 𝒱
                        %mi X
                        %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \mathcal{V}^{\mathbb{R}}_X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒱
                      %mi X
                    %mspace{:width => "thickmathspace"}
                    %mtext has complex rank
                    %mspace{:width => "thickmathspace"}
                    %mi n
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
