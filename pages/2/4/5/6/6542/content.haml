                      %mrow
                        %mn 2
                        %mo •
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mi ℝ
                    %msub
                      %mi End
                      %mi ℂ
