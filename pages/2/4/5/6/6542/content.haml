            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            of the
            %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
            with itself equals the
            = succeed "th" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
            %a.existingWikiWord{:href => "/nlab/show/Pontryagin+class"} Pontryagin class
          #eq:EulerSquareIsPontryagin.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi χ
                  %mo{:stretchy => "false"} (
