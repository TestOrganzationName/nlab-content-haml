                    \\underset{ \color{blue} = p_2(\nabla) }{
                    \\underbrace{
                    \\frac
                    {
                    \- 2
                    \\cdot
                    tr\big( (F_\nabla)^4 \big)
                    +
                    tr\big(  (F_\nabla)^2 \big)^2
                    }
                    {128 \pi^4}
                    }}
                    \\\
                    \\phantom{\;=\;}
                    +
                    \\cdots
                    \\end{aligned}
            %p
              Hence the first couple of
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin+forms"} Pontrjagin forms
              are
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %msub
                              %mi p
                              %mn 1
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mo −
                            %mfrac
                              %mrow
                                %mo{:lspace => "0em", :rspace => "thinmathspace"} tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %mn 8
                                %msup
                                  %mi π
                                  %mn 2
                        %mtr
                          %mtd
                            %msub
                              %mi p
                              %mn 2
                            %mo{:stretchy => "false"} (
                            %mo ∇
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mspace{:width => "thickmathspace"}
                            %mo =
                            %mspace{:width => "thickmathspace"}
                            %mfrac
                              %mrow
                                %mi tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 2
                                %msup
                                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                                  %mn 2
                                %mo −
                                %mn 2
                                %mo ⋅
                                %mi tr
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                                %mo{:stretchy => "false"} (
                                %msub
                                  %mi F
                                  %mo ∇
                                %msup
                                  %mo{:stretchy => "false"} )
                                  %mn 4
                                %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                              %mrow
                                %mn 128
                                %msup
                                  %mi π
                                  %mn 4
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    p_1(\nabla)
                    \&amp;
                    \\;=\;
                    \-
                    \\frac
                    {\tr\big( (F_\nabla)^2 \big) }
                    { 8 \pi^2  }
                    \\\
                    p_2(\nabla)
                    \&amp; \;=\;
                    \\frac
                    {
                    tr\big(  (F_\nabla)^2 \big)^2
                    \- 2
                    \\cdot
                    tr\big( (F_\nabla)^4 \big)
                    }
                    {128 \pi^4}
                    \\,.
                    \\end{aligned}
            %p
              (See also, e.g.,
              = succeed ")" do
                %a{:href => "#Nakahara03"} Nakahara 2003, Exp. 11.5
            %h5#euler_forms Euler forms
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo =
                    %mn 2
                    %mi k
                  %annotation{:encoding => "application/x-tex"} n = 2k
              and with the
              %a.existingWikiWord{:href => "/nlab/show/curvature+form"} curvature form
              again regarded as a 2-form valued
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (2k) \times (2k)
              %a.existingWikiWord{:href => "/nlab/show/square+matrix"} square matrix
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mo ∇
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi a
                    %msub
                      %mrow
                      %mi b
                    %msub
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mrow
                        %mn 1
                        %mo ≤
                        %mi a
                        %mo ,
                        %mi b
                        %mo ,
                        %mo ≤
                        %mn 2
                        %mi k
                  %annotation{:encoding => "application/x-tex"}
                    F_{\nabla}
                    \\;=\;
                    \\big(
                    (F_{\nabla})^a{}_b
                    \\big)_{1 \leq a,b, \leq 2k}
            %p
              the
              %a.existingWikiWord{:href => "/nlab/show/Euler+form"} Euler form
              is its
              %a.existingWikiWord{:href => "/nlab/show/Pfaffian"} Pfaffian
              of this matrix, hence the following
              %a.existingWikiWord{:href => "/nlab/show/sum"} sum
              over
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                    %mo ∈
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sigma \in Sym(2k)
              with summands signed by the the
              %a.existingWikiWord{:href => "/nlab/show/signature+of+a+permutation"} signature
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sgn
                      %mo{:stretchy => "false"} (
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mo{:stretchy => "false"} {
                      %mo ±
                      %mn 1
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} sgn(\sigma) \in \{\pm 1\}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mn 1
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mi π
                        %msup
                          %mo{:stretchy => "false"} )
                          %mi k
                        %mo ⋅
                        %mi k
                        %mo !
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mi σ
                    %mi sgn
                    %mo{:stretchy => "false"} (
                    %mi σ
                    %mo{:stretchy => "false"} )
                    %mo ⋅
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 3
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 4
                        %mo{:stretchy => "false"} )
                    %mo ∧
                    %mi ⋯
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi F
                      %mo ∇
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi k
                        %mo −
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mi σ
                        %mo{:stretchy => "false"} (
                        %mn 2
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_{2k}(\nabla)
                    \\;=\;
                    \\frac
                    {(-1)^k}
                    { (4 \pi)^k \cdot k! }
                    \\underset{\sigma}{\sum}
                    sgn(\sigma)
                    \\cdot
                    (F_{\nabla})_{\sigma(1)\sigma(2)}
                    \\wedge
                    (F_{\nabla})_{\sigma(3)\sigma(4)}
                    \\wedge
                    \\cdots
                    \\wedge
                    (F_{\nabla})_{\sigma(2k-1)\sigma(2k)}
                    \\,.
            %p
              The first of these is, using the
              %a.existingWikiWord{:href => "/nlab/show/Einstein+summation+convention"} Einstein summation convention
              and the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Levi-Civita+symbol"} Levi-Civita symbol
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi χ
                      %mn 4
                    %mo{:stretchy => "false"} (
                    %mo ∇
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mfrac
                      %mrow
                        %msup
                          %mi ϵ
                          %mrow
                            %mi a
                            %mi b
                            %mi c
                            %mi d
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mo ∇
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi a
                            %mi b
                        %mo ∧
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mo ∇
                        %msub
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mi c
                            %mi d
                      %mrow
                        %mn 32
                        %msup
                          %mi π
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\chi_4(\nabla)
                    \\;=\;
                    \\frac
                    { \epsilon^{ a b c d} (F_{\nabla})_{a b} \wedge (F_\nabla)_{c d}  }
                    {32 \pi^2}
            %p
              (See also, e.g.,
              = succeed ")" do
                %a{:href => "#Nakahara03"} Nakahara 2003, Exp. 11.7
          %h3#on_unit_sphere_bundles On unit sphere bundles
          #TrivializationOfEulerFormOnUnitSphereBundle.num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mover
                      %mo ⟶
                      %mi π
                    %mi X
                  %annotation{:encoding => "application/x-tex"} E \overset{\pi}{\longrightarrow} X
              an oriented
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundle"} real vector bundle
              of
              %a.existingWikiWord{:href => "/nlab/show/even+number"} even
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/rank+of+a+vector+bundle"} rank
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi rank
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                      %mo =
                      %mn 2
                      %mi k
                      %mo +
                      %mn 2
                    %annotation{:encoding => "application/x-tex"} rank(E) = 2k + 2
            %p
              For any choice of
              %a.existingWikiWord{:href => "/nlab/show/connection+on+a+bundle"} connection
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∇
                  %annotation{:encoding => "application/x-tex"} \nabla
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
              (
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mi SO
                    %mo{:stretchy => "false"} (
                    %mi dim
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} SO(dim(X))
              \-connection), let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∇
                      %mi E
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %msup
                      %mi Ω
                      %mrow
                        %mn 2
                        %mi k
                    %mo{:stretchy => "false"} (
                    %mi X
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi(\nabla_E) \in \Omega^{2k}(X)
              denote the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Euler+form"} Euler form
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/pullback+of+differential+forms"} pullback
              of the
              %a.existingWikiWord{:href => "/nlab/show/Euler+form"} Euler form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∇
                      %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \chi(\nabla_E)
              to the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere+bundle"} unit sphere bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi π
                        %mo{:stretchy => "false"} )
                    %mi X
                  %annotation{:encoding => "application/x-tex"} S(E) \overset{S(\pi)}{\longrightarrow} X
              is
              %a.existingWikiWord{:href => "/nlab/show/exact+differential+form"} exact
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi π
                    %mo{:stretchy => "false"} )
                    %msup
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo *
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∇
                      %mi E
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi d
                    %mi Ω
                  %annotation{:encoding => "application/x-tex"}
                    \\big( S(\pi) \big)^\ast
                    \\chi(\nabla_E)
                    \\;=\;
                    d \Omega
            %p
              such that the trivializing form has (minus) unit
              %a.existingWikiWord{:href => "/nlab/show/integration+of+differential+forms"} integral
              over any of the
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/n-sphere"} (2k+1)-sphere
              %a.existingWikiWord{:href => "/nlab/show/fibers"} fibers
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi S
                        %mi x
                        %mrow
                          %mn 2
                          %mi k
                          %mo +
                          %mn 1
                      %mover
                        %mo ↪
                        %mrow
                          %msub
                            %mi ι
                            %mi x
                      %mi S
                      %mo{:stretchy => "false"} (
                      %mi E
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^{2k+1}_x \overset{\iota_x}{\hookrightarrow} S(E)
            #eq:FiberIntegrationOfTrivialization.maruku-equation
              %span.maruku-eq-number (7)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mrow
                        %msup
                          %mi S
                          %mrow
                            %mn 2
                            %mi k
                            %mo +
                            %mn 1
                    %msubsup
                      %mi ι
                      %mi x
                      %mo *
                    %mi Ω
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo −
                    %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\int_{S^{2k+1}} \iota_x^\ast \Omega
                    \\;=\;
                    \-1
                    \\,.
          %p
            (e.g.
            = succeed "," do
              %a{:href => "#Walschap04"} Walschap 04, Chapter 6.6, Thm. 6.1, p. 201-202
            = succeed "," do
              %a{:href => "#Poor07"} Poor 07, 3.68
            = succeed ")" do
              %a{:href => "#Nie09"} Nie 09
          %h3#fiber_integration Fiber integration
          #FiberIntegrationOfCupPowersOfChiOver4Sphere.num_prop
            %h6#proposition_3 Proposition
            %p Let
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mn 4
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi B
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mn 4
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:maxsize => "1.2em", :minsize => "1.2em"} ↓
                              %mpadded{:width => "0"}
                                %mi π
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi B
                            %mi Spin
                            %mo{:stretchy => "false"} (
                            %mn 5
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^4
                    \&amp;\longrightarrow&amp;
                    B Spin(4)
                    \\\
                    \&amp;&amp;
                    \\big\downarrow^{\mathrlap{\pi}}
                    \\\
                    \&amp;&amp;
                    B Spin(5)
                    }
            %p
              be the
              %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"} spherical fibration
              of
              %a.existingWikiWord{:href => "/nlab/show/classifying+spaces"} classifying spaces
              induced from the canonical inclusion of
              %a.existingWikiWord{:href => "/nlab/show/Spin%284%29"} Spin(4)
              into
              %a.existingWikiWord{:href => "/nlab/show/Spin%285%29"} Spin(5)
              and using that the
              %a.existingWikiWord{:href => "/nlab/show/4-sphere"} 4-sphere
              is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/coset+space"} coset space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mn 4
                    %mo ≃
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 5
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 4
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} S^4 \simeq Spin(5)/Spin(4)
              (
              %a{:href => "sphere#nSphereAsCosetSpace"}> this Prop.
              ).
            %p
              Then the
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
              of the odd
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup powers
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi χ
                      %mrow
                        %mn 2
                        %mi k
                        %mo +
                        %mn 1
                  %annotation{:encoding => "application/x-tex"} \chi^{2k+1}
              of the
              %a.existingWikiWord{:href => "/nlab/show/Euler+class"} Euler class
