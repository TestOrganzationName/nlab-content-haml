              %a.existingWikiWord{:href => "/nlab/show/Whitney+sum"} Whitney sum
              of two
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} oriented
              %a.existingWikiWord{:href => "/nlab/show/real+vector+bundles"} real vector bundles
              to the
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              of the separate Euler classes:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ⊕
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo ⌣
                    %mi χ
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\chi( E \oplus F )
                    \\;=\;
                    \\chi(E)  \smile \chi(F)
                    \\,.
          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Walschap04"} Walschap 04, Section 6.4
          %h3#relation_to_top_chern_class Relation to top Chern class
          %p
          .num_prop
            %h6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/top+Chern+class"} top Chern class
              of a
              %a.existingWikiWord{:href => "/nlab/show/complex+vector+bundle"} complex vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
