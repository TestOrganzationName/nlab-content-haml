                    \\big(
                    \\Omega^{2\bullet}(X) \otimes_{\mathbb{R}} \mathbb{C}
                    \\big)
                    \\,.
            %p
              The multiplicative
              %a.existingWikiWord{:href => "/nlab/show/unit"} unit
            #eq:UnitInAlgebraOfEndomorphismValuedEvenDegreeDifferentialForms.maruku-equation
              %span.maruku-eq-number (4)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi Mat
                      %mrow
                        %mi n
                        %mo ×
                        %mi n
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
