            %a.existingWikiWord{:href => "/nlab/show/Euler+form"} Euler form
            of a
            %a.existingWikiWord{:href => "/nlab/show/connection"} connection
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ∇
                %annotation{:encoding => "application/x-tex"} \nabla
