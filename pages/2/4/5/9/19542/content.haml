          %h2#idea Idea
          %p
            A
            %em
              %a.existingWikiWord{:href => "/nlab/show/chain+complex"} chain complex
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi V
                    %mo •
                %annotation{:encoding => "application/x-tex"} V_\bullet
            of
            %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            is for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
            a
            %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi n
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mo{:lspace => "0em", :rspace => "thinmathspace"} even
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi odd
                  %annotation{:encoding => "application/x-tex"} V_n = (V_n)_\even \oplus (V_n)_odd
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                  %mo ∈
                  %mi ℤ
                %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
            a
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mo ∂
                    %mi n
                  %mspace{:width => "thickmathspace"}
                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi V
                    %mrow
                      %mi n
                      %mo +
                      %mn 1
                  %mo →
                  %msub
                    %mi V
                    %mi n
                %annotation{:encoding => "application/x-tex"} \partial_n \;\colon\; V_{n+1} \to V_n
            of
            %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            such that
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo ∘
                    %mo ∂
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} \partial \circ \partial = 0
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ch
                  %mo{:stretchy => "false"} (
                  %mi SuperVect
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch(SuperVect)
            of chain complexes of super vector space is much like the
            %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ch
                  %mo{:stretchy => "false"} (
                  %mi Vect
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch(Vect)
            of ordinary
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/vector+spaces"} vector spaces
            %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
            that makes it a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
            %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
            %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ch
                  %mo{:stretchy => "false"} (
                  %mi SuperVect
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch(SuperVect)
            which involves not just the signs used in the braiding in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi Vect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(Vect)
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} SuperVect
            %a.existingWikiWord{:href => "/nlab/show/commutative+monoid+in+a+symmetric+monoidal+category"} commutative monoids
            with respect to this symmetric braiding on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ch
                  %mo{:stretchy => "false"} (
                  %mi SuperVect
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch(SuperVect)
            are the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/differential+graded-commutative+superalgebras"} differential graded-commutative superalgebras
          %p
            In fact there are two such such non-trivial symmetric braidings on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ch
                  %mo{:stretchy => "false"} (
                  %mi SuperVect
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Ch(SuperVect)
            (Prop.
            %a.maruku-ref{:href => "#SymmetricStructureOnCategoryOfChainComplexesOfSuperVectorSpaces"}
            below), but they are equivalent to each other (Prop.
            %a.maruku-ref{:href => "#EquivalenceTwoSymmetricMonoidalStructuresOnChSuperVect"}
            below).
          %h2#definition Definition
          #ChainComplexesOfSuperVectorSpaces.num_defn
            %h6#definition_2 Definition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/chain+complexes"} chain complexes
                of
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi SuperVect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(SuperVect)
              for the
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes"} category of chain complexes
              inside the category of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
            %p
              Hence for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo •
                    %mo ∈
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi SuperVect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_\bullet \in Ch(SuperVect)
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/object"} object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℤ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{Z}
              there is a
              %a.existingWikiWord{:href => "/nlab/show/super+vector+space"} super vector space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mi n
                    %mo =
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi even
                    %mo ⊕
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi V
                      %mi n
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi odd
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mi SuperVect
                  %annotation{:encoding => "application/x-tex"}
                    V_n = (V_n)_{even} \oplus (V_n)_{odd} \;\in SuperVect
            %p
              where we write the elements of the
              %a.existingWikiWord{:href => "/nlab/show/group+of+order+two"} group of order two
              as
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo =
                      %mo{:stretchy => "false"} {
                      %mi even
                      %mo ,
                      %mi odd
                      %mo{:stretchy => "false"} }
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}/2 =\{even, odd\}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi even
                  %annotation{:encoding => "application/x-tex"} even
              being the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/neutral+element"} neutral element
            %p
              Hence we may regard any
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi V
                      %mo •
                    %mo ∈
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi SuperVect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} V_\bullet \in Ch(SuperVect)
              equivalently as a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z} \times (\mathbb{Z}/2)
              %a.existingWikiWord{:href => "/nlab/show/graded+object"} graded
              %a.existingWikiWord{:href => "/nlab/show/vector+space"} vector space
              equipped with a
              %a.existingWikiWord{:href => "/nlab/show/differential"} differential
              of degree
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %mi even
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1,even)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi v
                    %mo ∈
                    %mi V
                  %annotation{:encoding => "application/x-tex"} v \in V
              an element in definite (“homogeneous”) bi-degree, we denote this degree by
            #eq:BidegreeOnChainComplexOfSuperVectorSpaces.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi deg
                    %mo{:stretchy => "false"} (
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ≔
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi n
                      %mi v
                    %mo ,
                    %msub
                      %mi σ
                      %mi v
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo ×
                    %mo{:stretchy => "false"} (
                    %mi ℤ
                    %mo{:stretchy => "false"} /
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    deg(v) \coloneqq (n_v, \sigma_v) \;\in\; \mathbb{Z} \times (\mathbb{Z}/2)
                    \\,.
            %p
              The category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi SuperVect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(SuperVect)
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
              under the
              %a.existingWikiWord{:href => "/nlab/show/tensor+product+of+chain+complexes"} tensor product of chain complexes
              applied to the tensor product of
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/super+vector+spaces"} super vector spaces
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                      %mo ,
                      %mi W
