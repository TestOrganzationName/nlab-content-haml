                        %mi Bernst
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi v
                      %mo ⊗
                      %mi w
                      %mo ↦
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                      %msup
                        %mo{:stretchy => "false"} )
                        %mrow
                          %mi parity
                          %mo{:stretchy => "false"} (
                          %mi v
                          %mo{:stretchy => "false"} )
                          %mi parity
                          %mo{:stretchy => "false"} (
                          %mi w
                          %mo{:stretchy => "false"} )
                      %mi w
                      %mo ⊗
                      %mi v
                    %annotation{:encoding => "application/x-tex"} \tau_{Bernst} \;\colon\; v \otimes w \mapsto (-1)^{ parity(v) parity(w) } w \otimes v
                \.
            %p
              Notice that for the other symmetric braiding
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi τ
                        %mi Deligne
                    %annotation{:encoding => "application/x-tex"} \tau_{Deligne}
          #EquivalenceTwoSymmetricMonoidalStructuresOnChSuperVect.num_prop
            %h6#proposition_2 Proposition
            %p
              %strong
                (the two
                %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal
                %a.existingWikiWord{:href => "/nlab/show/structures"} structures
                on the category of chain complexes of super vector spaces are equivalent)
            %p
              The two
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric monoidal category
              %a.existingWikiWord{:href => "/nlab/show/structures"} structures
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Deligne
                  %annotation{:encoding => "application/x-tex"} \tau_{Deligne}
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Bernst
                  %annotation{:encoding => "application/x-tex"} \tau_{Bernst}
              on the
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal
              %a.existingWikiWord{:href => "/nlab/show/category+of+chain+complexes+of+super+vector+spaces"} category of chain complexes of super vector spaces
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi SuperVect
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⊗
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Ch(SuperVect), \otimes)
              from Prop.
              %a.maruku-ref{:href => "#SymmetricStructureOnCategoryOfChainComplexesOfSuperVectorSpaces"}
              are equivalent
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Deligne
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi τ
                      %mi Bernst
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_{Deligne}
                    \\;\simeq\;
                    \\tau_{Bernst}
            %p
              in that the
              %a.existingWikiWord{:href => "/nlab/show/identity+functor"} identity functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi SuperVect
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mi id
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi SuperVect
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Ch(SuperVect) \overset{id}{\longrightarrow} Ch(SuperVect)
              equipped with the following monoidal
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi id
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi id
                            %mo{:stretchy => "false"} (
                            %mi W
                            %mo{:stretchy => "false"} )
                            %mover
                              %mo ⟶
                              %mi μ
                            %mi id
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo ⊗
                            %mi W
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi v
                            %mo ⊗
                            %mi w
                            %mspace{:width => "thickmathspace"}
                            %mo ↦
                            %mspace{:width => "thickmathspace"}
                            %mo{:stretchy => "false"} (
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mn 1
                            %msup
                              %mo{:stretchy => "false"} )
                              %mrow
                                %msub
                                  %mi n
                                  %mi v
                                %msub
                                  %mi σ
                                  %mi w
                            %mspace{:width => "thinmathspace"}
                            %mi v
                            %mo ⊗
                            %mi w
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    id(V) \otimes id(W) \overset{\mu}{\longrightarrow} id(V \otimes W)
                    \\\
                    v \otimes w
                    \\;\mapsto\;
                    (-1)^{ n_v \sigma_w  } \, v \otimes w
                    }
            %p
              (the second line shows its action on elements of homogeneous bidegree
              = succeed ")" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo ,
                      %mi σ
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi ℤ
                      %mo ×
                      %mo{:stretchy => "false"} (
                      %mi ℤ
                      %mo{:stretchy => "false"} /
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (n,\sigma) \in \mathbb{Z} \times (\mathbb{Z}/2)
            %p
              becomes a
              %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+functor"} symmetric monoidal functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi SuperVect
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %msub
                      %mi τ
                      %mi Deligne
                    %mo{:stretchy => "false"} )
                    %munderover
                      %mo ⟶
                      %mo ≃
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi id
                        %mo ,
                        %mi μ
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi Ch
                    %mo{:stretchy => "false"} (
                    %mi SuperVect
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mo ⊗
                    %mo ,
                    %msub
                      %mi τ
                      %mi Bernst
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (Ch(SuperVect), \otimes, \tau_{Deligne})
                    \\underoverset{\simeq}{(id,\mu)}{\longrightarrow}
                    (Ch(SuperVect), \otimes, \tau_{Bernst})
                    \\,.
          %p
            (
            %a{:href => "#DeligneMorgan99"}> Deligne-Morgan 99, remark 1.2.8
            )
          .proof
            %h6#proof_2 Proof
            %p
              First to see that we have a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/strong+monoidal+functor"} strong monoidal functor
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associativity
              condition
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi id
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi id
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ⊗
                            %mi id
                            %mo{:stretchy => "false"} (
                            %msub
                              %mi V
                              %mn 3
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munderover
                              %mo ⟶
                              %mo ≃
                              %mrow
                                %msub
                                  %mi a
                                  %mrow
                                    %mi id
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi V
                                      %mn 1
                                    %mo{:stretchy => "false"} )
                                    %mo ,
                                    %mi id
                                    %mo{:stretchy => "false"} (
                                    %msub
                                      %mi V
                                      %mn 2
                                    %mo{:stretchy => "false"} )
                                    %mo ,
                                    %mi id
                                    %mo{:stretchy => "false"} (
                                    %msub
