          #Parity.num_remark
            %h6#remark Remark
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/parity"}> parity
                )
            %p
              For the
              %a.existingWikiWord{:href => "/nlab/show/symmetric+monoidal+category"} symmetric
              %a.existingWikiWord{:href => "/nlab/show/braiding"} braiding
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi Bernst
                  %annotation{:encoding => "application/x-tex"} \tau_{Bernst}
              in Prop.
              %a.maruku-ref{:href => "#SymmetricStructureOnCategoryOfChainComplexesOfSuperVectorSpaces"}
              it makes sense to name the additive
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi ℤ
                            %mo ×
                            %mo{:stretchy => "false"} (
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ⟶
                              %mi parity
                          %mtd
                            %mi ℤ
                            %mo{:stretchy => "false"} /
                            %mn 2
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo ,
                            %mi σ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi σ
                            %mo +
                            %mi n
                            %mspace{:width => "thinmathspace"}
                            %mi mod
                            %mspace{:width => "thinmathspace"}
                            %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\mathbb{Z} \times (\mathbb{Z}/2)
                    \&amp;\overset{ parity }{\longrightarrow}&amp;
                    \\mathbb{Z}/2
                    \\\
                    (n , \sigma) &amp;\mapsto&amp; \sigma + n \, mod \, 2
                    }
            %p
              This is called
              %em
                %a.existingWikiWord{:href => "/nlab/show/parity"} parity
              in parts of the literature (following
              = succeed ")." do
                %a{:href => "#AKSZ+sigma-model#AKSZ"} AKSZ 95
              %a.maruku-ref{:href => "#SymmetricStructureOnCategoryOfChainComplexesOfSuperVectorSpaces"}
              is simply
            %ul
              %li
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
