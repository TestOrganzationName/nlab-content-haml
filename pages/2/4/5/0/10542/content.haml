                    SU(3) \times SU(3)
                    \\,.
          %p
            (
            %a{:href => "#Yokota09"}> Yokota 09, theorem 2.12.2
            )
          %p
          #StabilizerOf4dMinkowskiInsideOctonionicAlbertAlgebra.num_prop
            %h6 Proposition
            %p
              The further
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi F
                      %mn 4
                      %mi w
                    %mo ≃
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi ℤ
                      %mn 3
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi F
                      %mn 4
                  %annotation{:encoding => "application/x-tex"}
                    F_4^w
                    \\simeq
                    \\big(
                    SU(3) \times SU(3)
                    \\big) / \mathbb{Z}_3
                    \\;\subset\;
                    F_4
              (Prop.
              = succeed ")" do
                %a.maruku-ref{:href => "#JordanAlgebraAutomorphismsFixingAnImaginaryOctonion"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Mat
                      %mrow
                        %mn 2
                        %mo ×
                        %mn 2
                      %mi herm
                    %mo{:stretchy => "false"} (
                    %mi ℂ
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ⊂
                    %mspace{:width => "thickmathspace"}
                    %munder
                      %munder
                        %mrow
                          %msubsup
                            %mi Mat
                            %mrow
                              %mn 3
                              %mo ×
                              %mn 3
                            %mi herm
                          %mo{:stretchy => "false"} (
                          %mi ℂ
                          %mo{:stretchy => "false"} )
                          %mspace{:width => "thickmathspace"}
                          %mo ⊕
                          %mspace{:width => "thickmathspace"}
                          %msub
                            %mi Mat
                            %mrow
                              %mn 3
                              %mo ×
                              %mn 3
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                        %mo ⏟
                      %mrow
                        %msubsup
                          %mi Mat
                          %mrow
                            %mn 3
                            %mo ×
                            %mn 3
                          %mi herm
                        %mo{:stretchy => "false"} (
                        %mi 𝕆
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Mat_{2 \times 2}^{herm}(\mathbb{C})
                    \\;\subset\;
                    \\underset{
                    Mat_{3 \times 3}^{herm}( \mathbb{O} )
                    }{
                    \\underbrace{
                    Mat_{3 \times 3}^{herm}(\mathbb{C})
                    \\;\oplus\;
                    Mat_{3 \times 3}(V)
                    }}
            %p
              (hence, by the
              = succeed "," do
                %a{:href => "#RelationTo10dSuperSpacetime"} above
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              (incarnated via its
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/Pauli+matrices"} Pauli matrices
              %a.existingWikiWord{:href => "/nlab/show/Minkowski+spacetime"} Minkowski spacetime
              inside the octonionic Albert algebra)
            %p is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mo{:stretchy => "false"} /
                    %msub
                      %mi ℤ
                      %mn 6
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    U(1)
                    \\times
                    SU(2)
                    \\times
                    SU(3)
                    \\big) /  \mathbb{Z}_6
                    \\,,
            %p
              where the
              %a.existingWikiWord{:href => "/nlab/show/quotient+group"} quotient
              is by the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              which is
              %a.existingWikiWord{:href => "/nlab/show/generators+and+relations"} generated
              by the element
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo (
                      %mi exp
                      %mrow
                        %mo (
                        %mn 2
                        %mi π
                        %mi i
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 6
                        %mo )
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi exp
                      %mrow
                        %mo (
                        %mn 2
                        %mi π
                        %mi i
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %mo )
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mn 2
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mi exp
                      %mrow
                        %mo (
                        %mn 2
                        %mi π
                        %mi i
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 3
                        %mo )
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mn 3
                      %mo )
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left(
                    \\exp\left(2 \pi i \tfrac{1}{6}\right)\;,\;
                    \\exp\left(2 \pi i \tfrac{1}{2}\right) \mathbf{1}_2\;,\;
                    \\exp\left(2 \pi i \tfrac{1}{3}\right) \mathbf{1}_3
                    \\right)
                    \\;\in\;
                    U(1) \times SU(2) \times SU(3)
                    \\,.
            %p
              (Hence this group happens to coincide with the
              %em exact
              %a.existingWikiWord{:href => "/nlab/show/gauge+group"} gauge group
              of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/standard+model+of+particle+physics"} standard model of particle physics
              = succeed ")." do
                %a{:href => "standard+model+of+particle+physics#GaugeGroup"} there
            %p
          %p
            This was claimed without proof in
            = succeed "." do
              %a{:href => "#DuboisVioletteTodorov18"} Dubois-Violette &amp; Todorov 18
            = succeed "." do
              %a{:href => "#Krasnov19"} Krasnov 19
          %p
          .proof
            %h6 Proof
            %p
              By Prop.
              %a.maruku-ref{:href => "#JordanAlgebraAutomorphismsFixingAnImaginaryOctonion"}
              %a.maruku-eqref{:href => "#eq:MatrixMultiplicationRepresentationOfiFixingJordanAutomorphism"} (3)
              it is clear that the subgroup in question is that represented by those
              %a.existingWikiWord{:href => "/nlab/show/pairs"} pairs
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi A
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo ∈
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi SU
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (A,B) \in SU(3) \times SU(3)
              for which
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              is
              = succeed "-block" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo +
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (1 + 2)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              form the
              %a.existingWikiWord{:href => "/nlab/show/subgroup"} subgroup
              of
              %a.existingWikiWord{:href => "/nlab/show/SU%283%29"} SU(3)
              of
              %a.existingWikiWord{:href => "/nlab/show/matrices"} matrices
              that may be written in the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi diag
                    %mrow
                      %mo (
                      %msup
                        %mi c
                        %mn 2
                      %mo ,
                      %msup
                        %mi c
                        %mrow
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 1
                      %mstyle{:mathvariant => "bold"}
                        %mi σ
                      %mo )
                  %annotation{:encoding => "application/x-tex"}
                    diag\left(
                    c^2, c^{-1} \mathbf{\sigma}
                    \\right)
            %p
              for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi U
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in U(1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi σ
                    %mo ∈
                  %annotation{:encoding => "application/x-tex"} \mathbf{\sigma} \in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/SU%282%29"} SU(2)
              %a.existingWikiWord{:href => "/nlab/show/kernel"} kernel
              of the
              %a.existingWikiWord{:href => "/nlab/show/group+homomorphism"} group homomorphism
            #eq:IdentifyingU1SU2inSU3.maruku-equation
              %span.maruku-eq-number (5)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mn 3
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} (
                            %mi c
                            %mo ,
                            %mstyle{:mathvariant => "bold"}
                              %mi σ
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↦
                          %mtd
                            %mi diag
                            %mrow
                              %mo (
                              %msup
                                %mi c
                                %mn 2
                              %mo ,
                              %msup
                                %mi c
                                %mrow
                                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                  %mn 1
                              %mstyle{:mathvariant => "bold"}
                                %mi σ
                              %mo )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    U(1) \times SU(2) &amp;\longrightarrow&amp; SU(3)
                    \\\
                    (c,\mathbf{\sigma}) &amp;\mapsto&amp; diag\left(
                    c^{2}, c^{-1} \mathbf{\sigma}
                    \\right)
                    }
            %p
              is clearly the
              %a.existingWikiWord{:href => "/nlab/show/cyclic+group"} cyclic group
            #eq:Z2Generator.maruku-equation
              %span.maruku-eq-number (6)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mo {
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo ,
                      %msub
                        %mstyle{:mathvariant => "bold"}
                          %mn 1
                        %mn 2
                      %mo{:stretchy => "false"} )
                      %mspace{:width => "thickmathspace"}
                      %mo ,
                      %mspace{:width => "thickmathspace"}
                      %mrow
                        %mo (
                        %msup
                          %mi e
                          %mrow
                            %mn 2
                            %mi π
                            %mi i
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                        %mo ,
                        %msup
                          %mi e
                          %mrow
                            %mn 2
                            %mi π
                            %mi i
                            %mstyle{:displaystyle => "false"}
                              %mfrac
                                %mn 1
                                %mn 2
                        %msub
                          %mstyle{:mathvariant => "bold"}
                            %mn 1
                          %mn 2
                        %mo )
                      %mo }
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ℤ
                      %mn 2
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\left\{
                    (1,\mathbf{1}_2)\;,\;
                    \\left(
                    e^{2\pi i \tfrac{1}{2}},e^{2\pi i \tfrac{1}{2}}\mathbf{1}_2
                    \\right)
                    \\right\}
                    \\;\simeq\;
                    \\mathbb{Z}_2
                    \\,.
            %p Hence the subgroup in question is
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi ℤ
                              %mn 2
                            %mspace{:width => "thickmathspace"}
                            %mo ×
                            %mspace{:width => "thickmathspace"}
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mn 3
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi ℤ
                              %mn 3
                          %mtd
                            %mo ≃
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thickmathspace"}
                            %mo ×
                            %mspace{:width => "thickmathspace"}
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mn 3
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi ℤ
                              %mn 2
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi ℤ
                              %mn 3
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} (
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mi U
                            %mo{:stretchy => "false"} (
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mo ×
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thickmathspace"}
                            %mo ×
                            %mspace{:width => "thickmathspace"}
                            %mi SU
                            %mo{:stretchy => "false"} (
                            %mn 3
                            %mo{:stretchy => "false"} )
                            %mo{:maxsize => "1.8em", :minsize => "1.8em"} )
                            %mo{:stretchy => "false"} /
                            %msub
                              %mi ℤ
                              %mn 6
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    \\Big(
                    \\big( U(1) \times SU(2) \big)/ \mathbb{Z}_2
                    \\;\times\;
                    SU(3)
                    \\Big)/ \mathbb{Z}_3
                    \&amp; \simeq
                    \\Big(
                    \\Big(
                    \\big( U(1) \times SU(2) \big)
                    \\;\times\;
                    SU(3)
                    \\Big) / \mathbb{Z}_2
                    \\Big) / \mathbb{Z}_3
                    \\\
                    \&amp;\simeq
                    \\Big(
                    \\big( U(1) \times SU(2) \big)
                    \\;\times\;
                    SU(3)
                    \\Big) / \mathbb{Z}_6
                    \\,,
                    \\end{aligned}
            %p
              where in the first step we extended the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              as the
              %a.existingWikiWord{:href => "/nlab/show/trivial+action"} trivial action
              on the
              = succeed "-factor," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi SU
                      %mo{:stretchy => "false"} (
                      %mn 3
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} SU(3)
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo ×
                    %msub
                      %mi ℤ
                      %mn 3
                    %mo ≃
                    %msub
                      %mi ℤ
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2 \times \mathbb{Z}_3 \simeq \mathbb{Z}_6
              (an application of the “
              %a.existingWikiWord{:href => "/nlab/show/fundamental+theorem+of+cyclic+groups"}> fundamental theorem of cyclic groups
              ”, if you wish).
            %p
              It remains to see that the
              %a.existingWikiWord{:href => "/nlab/show/action"} action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 6
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_6
              is as claimed. By the above identification
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 6
                      %mo ≃
                      %msub
                        %mi ℤ
                        %mn 2
                      %mo ×
                      %msub
                        %mi ℤ
                        %mn 3
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_6 \simeq \mathbb{Z}_2 \times \mathbb{Z}_3
              %em joint
              action of that of the generators of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi ℤ
                      %mn 3
                  %annotation{:encoding => "application/x-tex"} \mathbb{Z}_3
              and of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi ℤ
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}_2
              %a.maruku-eqref{:href => "#eq:Z3Generator"} (4)
              and
              = succeed "," do
                %a.maruku-eqref{:href => "#eq:Z2Generator"} (6)
            .maruku-equation
