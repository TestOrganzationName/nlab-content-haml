                  %mo{:stretchy => "false"} (
                  %msub
                    %mi ℤ
                    %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} S^1/(\mathbb{Z}_2)
            in
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Horava-Witten+theory"} Horava-Witten theory
          %p
            This decomposition hence induces an
            %a.existingWikiWord{:href => "/nlab/show/action"} action
            of the
            %a.existingWikiWord{:href => "/nlab/show/spin+group"} spin group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
