          %h3#Automorphisms Automorphisms and exceptional Lie groups
          .num_prop
            %h6#proposition Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/general+linear+group"} general linear group
                of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi Mat
                        %mrow
                          %mn 3
                          %mo ×
                          %mn 3
                        %mi herm
                      %mo{:stretchy => "false"} (
                      %mi 𝕆
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Mat_{3\times 3}^{herm}(\mathbb{O})
                preserving
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
                is
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/E6"} E6
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/group"} group
              of
              = succeed "-preserving" do
                %a.existingWikiWord{:href => "/nlab/show/determinant"} determinant
              %a.existingWikiWord{:href => "/nlab/show/linear+map"} linear
              %a.existingWikiWord{:href => "/nlab/show/isomorphisms"} isomorphisms
              of the vector space underlying the octonionic Albert algebra is the
              %a.existingWikiWord{:href => "/nlab/show/exceptional+Lie+group"} exceptional Lie group
              %a.existingWikiWord{:href => "/nlab/show/E6"} E6
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mrow
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                          %mn 26
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} {}_{(-26)}
          %p
            (see e.g. (
            %a{:href => "#ManogueDray09"}> Manogue-Dray 09
            )).
          #JordanAutomorphisms.num_prop
