          %p
            (e.g.
            = succeed ")" do
              %a{:href => "#Yokota09"} Yokota 09, section 2.2
          #JordanAlgebraAutomorphismsFixingAnImaginaryOctonion.num_prop
            %h6#proposition_3 Proposition
            %p
