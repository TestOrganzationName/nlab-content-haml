              on the octonionic Albert algebra is the
              %a.existingWikiWord{:href => "/nlab/show/exceptional+Lie+group"} exceptional Lie group
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/F4"} F4
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Aut
                    %mrow
