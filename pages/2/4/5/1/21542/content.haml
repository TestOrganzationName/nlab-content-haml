          %h2#properties Properties
          .num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %msup
                        %mi 𝕋
                        %mn 2
                    %mtext -
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi 𝕋
                    %mtext -
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %mi ℰ
                    %msup
                      %mo{:stretchy => "false"} )
                      %mn 2
                    %mo =
                    %mi 𝕋
                    %mtext -
                    %mi Mod
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi ℰ
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "1em"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"} {\mathbb{T}^2}\text{-}Mod(\mathcal{E})=\mathbb{T}\text{-}Mod(\mathcal{E})^2=\mathbb{T}\text{-}Mod(\mathcal{E}^2)\quad.
          %p
            Cf. Johnstone (
            %a{:href => "#J77"}> 1977
            , p. 203;
            = succeed "," do
              %a{:href => "#J02"} 2002
            = succeed "," do
              %a{:href => "#MM94"} 1994
          %p
            Note that the second equality determines the class of
            = succeed "-model" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕋
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}
            = succeed "-models" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕋
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℰ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathcal{E}^2
            are known.
          %p
            %strong> Remark
            \: This e.g. precludes the existence of geometric theories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝕋
                    %mi op
                %annotation{:encoding => "application/x-tex"} \mathbb{T}^{op}
            or
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝕋
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathbb{T}^\times
            with the property that, given a geometric theory
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕋
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %msup
                      %mi 𝕋
                      %mi op
                  %mtext -
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {\mathbb{T}^{op}}\text{-}Mod(\mathcal{E})
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %msup
                      %mi 𝕋
                      %mo ×
                  %mtext -
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {\mathbb{T}^{\times}}\text{-}Mod(\mathcal{E})
            coincide with the
            %a.existingWikiWord{:href => "/nlab/show/opposite+category"} opposite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕋
                  %mtext -
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                %annotation{:encoding => "application/x-tex"} {\mathbb{T}}\text{-}Mod(\mathcal{E})^{op}
            or the
            %a.existingWikiWord{:href => "/nlab/show/twisted+arrow+category"} twisted arrow category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕋
                  %mtext -
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ×
                %annotation{:encoding => "application/x-tex"} {\mathbb{T}}\text{-}Mod(\mathcal{E})^\times
            for any
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝕆
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{O}^2
            (see the examples below) assigns the
            %a.existingWikiWord{:href => "/nlab/show/arrow+category"} arrow category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℰ
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathcal{E}^2
            as category of models to a Grothendieck topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            no geometric theory can assign all Grothendieck toposes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            their
            %a.existingWikiWord{:href => "/nlab/show/twisted+arrow+category"} twisted arrow category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℰ
                    %mo ×
                %annotation{:encoding => "application/x-tex"} \mathcal{E}^\times
            as category of models because the class of models coincides with the class of models for the theory of morphisms.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ▪
                %annotation{:encoding => "application/x-tex"} \qed
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi ℰ
                    %mn 2
                  %mo =
                  %mi ℰ
                  %mo ×
                  %msup
                    %mi Set
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathcal{E}^2=\mathcal{E}\times Set^2
            in general and the
            %a.existingWikiWord{:href => "/nlab/show/Sierpinski+topos"} Sierpinski topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mn 2
                %annotation{:encoding => "application/x-tex"} Set^2
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exponentiable+topos"} exponentiable
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %msup
                      %mi 𝕋
                      %mn 2
                  %mtext -
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi 𝕋
                  %mtext -
                  %mi Mod
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℰ
                    %mn 2
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi ℰ
                    %mn 2
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} [
                  %mi 𝕋
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo ×
                  %msup
                    %mi Set
                    %mn 2
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} [
                  %mi 𝕋
                  %mo{:stretchy => "false"} ]
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Hom
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} [
                  %mi 𝕋
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo{:stretchy => "false"} (
                      %msup
                        %mi Set
                        %mn 2
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} {\mathbb{T}^2}\text{-}Mod(\mathcal{E})=\mathbb{T}\text{-}Mod(\mathcal{E}^2)=Hom(\mathcal{E}^2,Set[\mathbb{T}])=Hom(\mathcal{E}\times Set^2, Set[\mathbb{T}])=Hom(\mathcal{E},Set[\mathbb{T}]^{(Set^2)})
          %p or in other words
          .num_prop
            %h6#corollary Corollary
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
              for the theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕋
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}^2
              of
              = succeed "-model" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕋
                    %annotation{:encoding => "application/x-tex"} \mathbb{T}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝕋
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %mi Set
                      %mo{:stretchy => "false"} [
                      %mi 𝕋
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Set
                            %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Set[\mathbb{T}^2]= Set[\mathbb{T}]^{(Set^2)}
          %p
            %strong> Remark
            \: It is worthwhile to muse a bit how “squaring” fares as a theory operator with respect to the various subdoctrines of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/geometric+logic"} geometric logic
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕋
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/regular+logic"} regular
            %a.existingWikiWord{:href => "/nlab/show/coherent+logic"} coherent logic
            are respected by the passage to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕋
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}^2
            %a.existingWikiWord{:href => "/nlab/show/localic+topos"} propositional theory
            i.e. one over a signature lacking sort symbols, is again propositional - this implies e.g. via the above corollary that the exponentiation of a
            %a.existingWikiWord{:href => "/nlab/show/localic+topos"} localic topos
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi Set
                    %mn 2
                %annotation{:encoding => "application/x-tex"} Set^2
            is again a localic topos. The order sensitive subdoctrines like
            %a.existingWikiWord{:href => "/nlab/show/essentially+algebraic+theory"} cartesian
            or
            %a.existingWikiWord{:href => "/nlab/show/disjunctive+logic"} disjunctive logic
            are also respected. One case where squaring does not preserve the subdoctrine is
            %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} 1-sorted algebraic logic
            since then
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝕋
                    %mn 2
                %annotation{:encoding => "application/x-tex"} \mathbb{T}^2
            is necessarily 2-sorted.
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ▪
                %annotation{:encoding => "application/x-tex"} \qed
          %p
            By an observation of Hébert (
            %a{:href => "#H10"}> 2010
            , p.1), the finitely presentable objects in arrow categories
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝒦
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathcal{K}^2
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒦
                %annotation{:encoding => "application/x-tex"} \mathcal{K}
            whence, denoting the subcategory of finitely presentable models of a theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕋
                %annotation{:encoding => "application/x-tex"} \mathbb{T}
            in a topos
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℰ
                %annotation{:encoding => "application/x-tex"} \mathcal{E}
            by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕋
                  %mtext -
                  %msub
                    %mi Mod
                    %mi fp
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \mathbb{T}\text{-}Mod_{fp}(\mathcal{E})
            one has
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi 𝕋
                    %mn 2
                  %mtext -
                  %msub
                    %mi Mod
                    %mi fp
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi 𝕋
                  %mtext -
                  %msub
                    %mi Mod
                    %mi fp
                  %mo{:stretchy => "false"} (
                  %mi ℰ
                  %msup
                    %mo{:stretchy => "false"} )
                    %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"} \mathbb{T}^2\text{-}Mod_{fp}(\mathcal{E})=\mathbb{T}\text{-}Mod_{fp}(\mathcal{E})^2\;.
          %p
            But since classifying toposes of cartesian theories are given by the presheaf toposes on the opposite of the category of their finitely presentable models in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Set
                %annotation{:encoding => "application/x-tex"} Set
            (cf. Johnstone
            = succeed "," do
              %a{:href => "J02b"} 2002b
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝕋
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/essentially+algebraic+theory"} cartesian theory
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi 𝕋
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} \mathbb{T}^2
              of
              = succeed "-model" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕋
                    %annotation{:encoding => "application/x-tex"} \mathbb{T}
              %a.existingWikiWord{:href => "/nlab/show/classifying+topos"} classifying topos
              is
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Set
                      %mo{:stretchy => "false"} [
                      %msup
                        %mi 𝕋
                        %mn 2
                      %mo{:stretchy => "false"} ]
                      %mo =
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi 𝕋
                            %mn 2
                          %mtext -
                          %msub
                            %mi Mod
                            %mi fp
                          %mo{:stretchy => "false"} (
                          %mi Set
                          %mo{:stretchy => "false"} )
                      %mo =
                      %msup
                        %mi Set
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi 𝕋
                          %mtext -
                          %msub
                            %mi Mod
                            %mi fp
                          %mo{:stretchy => "false"} (
                          %mi Set
                          %msup
                            %mo{:stretchy => "false"} )
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mo =
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                      %msup
                        %mi Set
                        %mrow
                          %mi 𝕋
                          %mtext -
                          %msub
                            %mi Mod
                            %mi fp
                          %mo{:stretchy => "false"} (
                          %mi Set
                          %mo{:stretchy => "false"} )
                      %msup
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Set
                            %mn 2
                          %mo{:stretchy => "false"} )
                      %mo =
                      %mi Set
                      %mo{:stretchy => "false"} [
                      %mi 𝕋
                      %msup
                        %mo{:stretchy => "false"} ]
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi Set
                            %mn 2
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Set[\mathbb{T}^2]=Set^{\mathbb{T}^2\text{-}Mod_{fp}(Set)}=Set^{(\mathbb{T}\text{-}Mod_{fp}(Set)^2)}=\big (Set^{\mathbb{T}\text{-}Mod_{fp}(Set)}\big)^{(Set^2)}=Set[\mathbb{T}]^{(Set^2)}
          %p
            For an easy application of this result see at the theory
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝕆
                %annotation{:encoding => "application/x-tex"} \mathbb{O}
            of objects in the examples below!
          %h2#examples Examples
          %ul
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝕋
                        %mi ∅
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} \mathbb{T}^\emptyset_\emptyset
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝕋
                        %mn 1
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} \mathbb{T}^\emptyset_1
                be the
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/empty+theory"} empty theory
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝕋
                        %mi ∅
                        %mrow
                          %mi ∅
                          %mn 2
                      %mo =
                      %msubsup
                        %mi 𝕋
                        %mi ∅
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} \mathbb{T}^{\emptyset 2}_\emptyset=\mathbb{T}^\emptyset_\emptyset
                and
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi 𝕋
                        %mn 1
                        %mrow
                          %mi ∅
                          %mn 2
                      %mo =
                      %msubsup
                        %mi 𝕋
                        %mn 1
                        %mi ∅
                    %annotation{:encoding => "application/x-tex"} \mathbb{T}^{\emptyset 2}_1=\mathbb{T}^\emptyset_1
                in accordance with the fact that these theories have only empty models whence all model homomorphisms are
                %a.existingWikiWord{:href => "/nlab/show/identity"} identity morphisms
                of empty models. In other words, squaring theories obeys the laws of arithmetic at 0 and 1.
            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕆
                    %annotation{:encoding => "application/x-tex"} \mathbb{O}
                be the
                %a.existingWikiWord{:href => "/nlab/show/theory+of+objects"} theory of objects
                i.e. the theory with no sequents over the signature with one sort symbol
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi O
