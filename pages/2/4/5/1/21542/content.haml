                      %mi dom
                      %mo →
                      %mstyle{:mathvariant => "bold"}
                        %mi O
                      %mo ∘
                      %mi cod
                    %annotation{:encoding => "application/x-tex"} \eta\,:\,\mathbf{O}\circ dom\to\mathbf{O}\circ cod
                with
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi O
                    %annotation{:encoding => "application/x-tex"} \mathbf{O}
                the
                %em generic object
                i.e. the inclusion functor
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi FinSet
                        %mo ↪
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} FinSet\hookrightarrow Set
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi dom
