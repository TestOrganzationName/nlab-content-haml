            %li
              %p
                Let
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝕂
                    %annotation{:encoding => "application/x-tex"} \mathbb{K}
                be the
                %a.existingWikiWord{:href => "/nlab/show/theory+of+categories"} theory of categories
                (e.g. Johnstone
                = succeed "," do
                  %a{:href => "#J77"} 1977
                %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
