          .footnotes
            %hr/
            %ol
              %li#fn:1
                %p
                  It is understood that variables and contexts are updated with the new sorts e.g. the sequent
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊤
                        %msub
                          %mo ⊢
                          %mrow
                            %mi x
                            %mo :
                            %mi S
                        %mi x
                        %mo =
                        %mi x
                      %annotation{:encoding => "application/x-tex"} \top\vdash_{x:S} x=x
                  yields two sequents
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊤
                        %msub
                          %mo ⊢
                          %mrow
                            %mi x
                            %mo :
                            %msup
                              %mi S
                              %mn 0
                        %mi x
                        %mo =
                        %mi x
                      %annotation{:encoding => "application/x-tex"} \top\vdash_{x:S^0} x=x
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊤
                        %msub
                          %mo ⊢
                          %mrow
                            %mi x
                            %mo :
                            %msup
                              %mi S
                              %mn 1
                        %mi x
                        %mo =
                        %mi x
                      %annotation{:encoding => "application/x-tex"} \top\vdash_{x:S^1} x=x
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊤
                        %mo ⊢
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo ∀
                        %mi x
                        %mo :
                        %mi S
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mi x
                        %mo =
                        %mi x
                      %annotation{:encoding => "application/x-tex"} \top\vdash \big (\forall x:S\big ) x=x
                  yields
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊤
                        %mo ⊢
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo ∀
                        %mi x
                        %mo :
                        %msup
                          %mi S
                          %mn 0
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mi x
                        %mo =
                        %mi x
                      %annotation{:encoding => "application/x-tex"} \top\vdash \big (\forall x:S^0\big ) x=x
                  and
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo ⊤
                        %mo ⊢
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mo ∀
                        %mi x
                        %mo :
                        %msup
                          %mi S
                          %mn 1
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mi x
                        %mo =
                        %mi x
                      %annotation{:encoding => "application/x-tex"} \top\vdash \big (\forall x:S^1\big ) x=x
                  etc. In case, the sequent
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi φ
                        %mo ⊢
                        %mi ψ
                      %annotation{:encoding => "application/x-tex"} \varphi\vdash\psi
                  contains nothing to update (e.g. the sequent
                  = succeed ")" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo ⊤
                          %mo ⊢
