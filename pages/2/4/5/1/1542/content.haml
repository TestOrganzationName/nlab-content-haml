                  \\rightrightarrows
                  X_0
                  \\big)
                  \\;\;\;
                  \\mapsto
                  \\;\;\;
                  X_0
          %p
            sends a groupoid to its set of
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/objects"} objects
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to this functor sends a set to its codiscrete groupoid according to Def.
            = succeed "." do
              %a.maruku-ref{:href => "#CodiscreteGroupoid"}
            %a{:href => "adjoint+functor#InTermsOfHomIsomorphism"} hom-isomorphism
            that reflects this adjunction:
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mo =
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi 𝒳
                    %mn 1
                  %mo ⇉
                  %msub
                    %mi 𝒳
                    %mn 0
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} \mathcal{X} = \big( \mathcal{X}_1 \rightrightarrows \mathcal{X}_0\big)\,\in\,
            %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                %annotation{:encoding => "application/x-tex"} S \,\in\,
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
            of groupoids (i.e. a
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/functor"} functor
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒳
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %mi F
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi CoDisc
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{X}
                  \\xrightarrow{\;\; F \;\;}
                  CoDisc(S)
          %p is uniquely determined as soon as its component function
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi 𝒳
                    %mn 0
                  %mover
                    %mo →
                    %mrow
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                      %msub
                        %mi F
                        %mn 0
                      %mspace{:width => "thickmathspace"}
                      %mspace{:width => "thickmathspace"}
                  %mi CoDisc
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi S
                %annotation{:encoding => "application/x-tex"}
                  \\mathcal{X}_0
                  \\xrightarrow{\;\; F_0 \;\;}
                  CoDisc(S) = S
          %p
            is chose, because for every morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mover
                    %mo →
                    %mi f
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo ∈
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi 𝒳
                    %mn 1
                %annotation{:encoding => "application/x-tex"} (x \xrightarrow{f} y) \,\in\,\mathcal{X}_1
            there is one and only one morphism
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi F
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msub
                    %mi F
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} F_0(x) \to F_0(y)
            that it may be sent to, and making this unique choice for each
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            does constitute a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            for every choice of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi F
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} F_0
          %p
            This association there gives a
            %a.existingWikiWord{:href => "/nlab/show/natural+bijection"} natural bijection
            of
            %a.existingWikiWord{:href => "/nlab/show/hom-sets"} hom-sets
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Grpd
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %mi 𝒳
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi CoDisc
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo{:stretchy => "false"} )
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ≃
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi Set
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                  %msub
                    %mi 𝒳
                    %mn 0
                  %mo ,
                  %mspace{:width => "thinmathspace"}
                  %mi S
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                %annotation{:encoding => "application/x-tex"}
                  Grpd
                  \\big(
                  \\mathcal{X}
                  ,\,
                  CoDisc(S)
                  \\big)
                  \\;\;
                  \\simeq
                  \\;\;
                  Set
                  \\big(
                  \\mathcal{X}_0
                  ,\,
                  S
                  \\big)
          %p
            and hence witnesses the claimed
            %a.existingWikiWord{:href => "/nlab/show/adjunction"} adjunction
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi CoDisc
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo ⊣
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msub
                    %mo{:stretchy => "false"} )
                    %mn 0
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  CoDisc
                  \\;\; \dashv  \;\;
                  (-)_0
                  \\,.
          %p
            It has been argued in
            %a{:href => "chaos#Lawvere84"} Lawvere 1984
            that such
            = succeed "-constructions," do
              %a.existingWikiWord{:href => "/nlab/show/codiscrete+object"} codiscrete object
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            to
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/forgetful+functors"} forgetful functors
          %p
            Correspondingly,
            %a.existingWikiWord{:href => "/nlab/show/nerves"} nerves
            of codiscrete groupoids are precisely the
            %a.existingWikiWord{:href => "/nlab/show/codiscrete+objects"} codiscrete objects
            in
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %a.existingWikiWord{:href => "/nlab/show/cohesive+topos"} cohesive topos
            over
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %h2#examples Examples
          %p
          #UniversalGPrincipalBundle.num_remark
            %h6 Example
            %p
              %strong
                (chaotic groupoids as models for
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundles"} universal principal bundles
              %br/
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mo ∈
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \in Grp(Set)
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/group"} group
              %a.existingWikiWord{:href => "/nlab/show/pair+groupoid"} pair groupoid
              on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              is
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi G
                    %mo ×
                    %mi G
                    %munderover
                      %mo ⇉
                      %mrow
                        %msub
                          %mi pr
                          %mn 2
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\big(
                    G \times G
                    \\underoverset
                    {pr_2}
                    {pr_1}
                    {\rightrightarrows} G
                    \\big)
                    \\;\;
                    \\simeq
                    \\;\;
                    \\mathbf{E}G
            %p
              to the
              %a.existingWikiWord{:href => "/nlab/show/action+groupoid"} action groupoid
              of the right (say)
              %a.existingWikiWord{:href => "/nlab/show/group+action"} group action
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on itself by right group-multiplication:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo ≔
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mo ×
                    %mi G
                    %munderover
                      %mo ⇉
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                        %mo ⋅
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi pr
                          %mn 1
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{E}G
                    \\;\coloneqq\;
                    G \times G
                    \\underoverset
                    {(-) \cdot (-)}
                    {pr_1}
                    {\rightrightarrows}
                    G
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              of the latter is
              %em equal
              to the standard incarnation (since we chose right action) of the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+simplicial+complex"} universal principal simplicial complex
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mi G
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} W G \, \in \, sSet
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mi W
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N(\mathbf{E}G)
                    \\;\;
                    \=
                    \\;\;
                    W G
                    \\,.
            %p
              The residual left multiplication action of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              on itself makes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}G
              a
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/action+object"} action object
              %a.existingWikiWord{:href => "/nlab/show/internalization"} internal to
              %a.existingWikiWord{:href => "/nlab/show/Grpd"} Grpd
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi Grpd
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{E}G
                    \\;\;\;
                    \\in
                    \\;
                    G Act(Grpd)
                    \\,.
            %p
              Since the nerve operation is a
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              (
              %a{:href => "nerve+and+realization#NerveAndRealizationAreAdjoint"}> this Prop.
              ) it
              %a.existingWikiWord{:href => "/nlab/show/preserved+limit"} preserves
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/action+objects"} action objects
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mspace{:width => "thickmathspace"}
                    %mo ∈
                    %mspace{:width => "thickmathspace"}
                    %mi G
                    %mi Act
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    W G
                    \\;=\;
                    N(\mathbf{E}G)
                    \\;\;\;
                    \\in
                    \\;
                    G Act(sSet)
            %p
              is the standard
              = succeed "-action" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+simplicial+complex"} universal principal simplicial complex
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/quotient"} quotient
              of the group action on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{E}G
              yields the
              %a.existingWikiWord{:href => "/nlab/show/delooping+groupoid"} delooping groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"} \mathbf{B}G
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            #eq:CoprojectionFromEGToBG.maruku-equation
              %span.maruku-eq-number (1)
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\mathbf{E}G
                    \\xrightarrow{\;\;}
                    (\mathbf{E}G)/G
                    \\;=\;
                    \\mathbf{B}G
                    \\,.
            %p
              While the
              %a.existingWikiWord{:href => "/nlab/show/nerve"} nerve
              operation does not in general preserve
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              (
              %a{:href => "nerve#NervesDoNotPreserveQuotientOfDeloopingByNormalSubgroup"}> this Exp.
              ) it does preserve (by
              = succeed ")" do
                %a{:href => "nerve#NerveDoesPreserveQuotientOfPairGroupoidOfGroupByGroupAction"} this Exp.
              %a.existingWikiWord{:href => "/nlab/show/coprojection"} coprojection
              = succeed "." do
                %a.maruku-eqref{:href => "#eq:CoprojectionFromEGToBG"} (1)
              %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi W
                    %mi G
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mover
                      %mi W
                      %mo ¯
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi N
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi G
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    N(\mathbf{E}G)
                    \\;=\;
                    W G
                    \\xrightarrow{\;\;}
                    (W G)/G
                    \\;=\;
                    \\overline{W}G
                    \\;=\;
                    N(\mathbf{B}G)
                    \\;=\;
                    N\big((\mathbf{E}G)/G\big)
            %p
              is the
              %a.existingWikiWord{:href => "/nlab/show/universal+simplicial+principal+bundle"} universal simplicial principal bundle
              with
              %a.existingWikiWord{:href => "/nlab/show/structure+group"} structure group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi Set
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ↪
                      %mi Disc
                    %mi Grp
                    %mo{:stretchy => "false"} (
                    %mi sSet
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} G \,\in\, Grp(Set) \xhookrightarrow{Disc} Grp(sSet)
              regarded as a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+group"} simplicial group
            %p
              Finally, the
              %a.existingWikiWord{:href => "/nlab/show/geometric+realization"} geometric realization
              of this into
              %a.existingWikiWord{:href => "/nlab/show/compactly+generated+topological+spaces"} compactly generated
              %a.existingWikiWord{:href => "/nlab/show/topological+spaces"} topological spaces
              is the standard model for the
              %a.existingWikiWord{:href => "/nlab/show/universal+principal+bundle"} universal principal bundle
              of
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mi G
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi E
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mspace{:width => "thickmathspace"}
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mstyle{:mathvariant => "bold"}
                      %mi B
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} |
                    %mspace{:width => "thickmathspace"}
                    %mo =
                    %mspace{:width => "thickmathspace"}
                    %mi B
                    %mi G
                  %annotation{:encoding => "application/x-tex"}
                    E G
                    \\;=\;
                    \\big\vert
                    N(\mathbf{E}G)
                    \\big\vert
                    \\xrightarrow{\;\;}
                    \\big\vert
                    N(\mathbf{B}G)
                    \\big\vert
                    \\;=\;
                    B G
            %p
              over its
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi G
                    %mo ≃
                    %mi K
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B G \simeq K(G,1)
              (which here is an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Eilenberg-MacLane+space"} Eilenberg-MacLane space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
              was assumed to be
              %a.existingWikiWord{:href => "/nlab/show/discrete+group"} discrete group
              – but this was just for simplicitiy of exposition, the analogous discussion applies to the chaotic
              %a.existingWikiWord{:href => "/nlab/show/topological+groupoid"} topological groupoid
              of a
              %a.existingWikiWord{:href => "/nlab/show/topological+group"} topological group
              = succeed ")." do
