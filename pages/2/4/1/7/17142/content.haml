                                    %mo ∈
                                    %mi ℝ
                              %mo }
                          %mtd
                            %mo ⟶
                          %mtd
                            %mrow
                              %mo {
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %msub
                                      %mi V
                                      %mrow
                                        %mi n
                                        %mo +
                                        %mn 1
                                    %mo ⊂
                                    %msup
                                      %mi ℝ
                                      %mrow
                                        %mi k
                                        %mo +
                                        %mn 1
                                  %mo ,
                                %mrow
                                  %mi v
                                  %mo ∈
                                  %msub
                                    %mi V
                                    %mrow
                                      %mi n
                                      %mo +
                                      %mn 1
                              %mo }
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %msub
                              %mi Gr
                              %mi n
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mi k
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msub
                              %mi Gr
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} (
                            %msup
                              %mi ℝ
                              %mrow
                                %mi k
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\left\{
                    {V_{n}\subset \mathbb{R}^k, }
                    \\atop
                    {v \in V_n, v_{n+1} \in \mathbb{R}}
                    \\right\}
                    \&amp;\longrightarrow&amp;
                    \\left\{
                    {V_{n+1} \subset \mathbb{R}^{k+1}},
                    \\atop
                    v \in V_{n+1}
                    \\right\}
                    \\\
                    \\downarrow &amp;&amp; \downarrow
                    \\\
                    Gr_n(\mathbb{R}^k)
                    \&amp;\longrightarrow&amp;
                    Gr_{n+1}(\mathbb{R}^{k+1})
