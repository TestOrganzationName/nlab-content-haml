          .proof
            %h6#proof_3 Proof
            %p
              For each
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k \in \mathbb{N}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo ≥
                    %mi n
                  %annotation{:encoding => "application/x-tex"} k \geq n
              there is such a pullback of the canonical vector bundles over
              %a.existingWikiWord{:href => "/nlab/show/Grassmannians"} Grassmannians
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mrow
                              %mo {
                              %mfrac{:linethickness => "0"}
                                %mrow
                                  %mrow
                                    %msub
                                      %mi V
                                      %mi n
                                    %mo ⊂
                                    %msup
                                      %mi ℝ
                                      %mi k
                                    %mo ,
                                %mrow
                                  %mrow
                                    %mi v
                                    %mo ∈
                                    %msub
                                      %mi V
                                      %mi n
                                    %mo ,
                                    %msub
                                      %mi v
