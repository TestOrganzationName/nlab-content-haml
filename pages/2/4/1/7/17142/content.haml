              as being the image of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              under the component map in the sequential colimit that defines the stable homotopy groups (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1#StableHomotopyGroups"}> def.
              ). Therefore
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi α
                  %annotation{:encoding => "application/x-tex"} \alpha
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi α
                        %mrow
                          %msub
                            %mi k
                            %mn 2
                    %annotation{:encoding => "application/x-tex"} \alpha_{k_2}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi k
                        %mn 2
                      %mo ∈
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} k_2 \in \mathbb{N}
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mi ℬ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_{\bullet}(M \mathcal{B})
          %h2#ThomTheorem Thom’s theorem
          %p
            Recall that the
            %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+construction"} Pontrjagin-Thom construction
            (
            %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#PontrjaginThomConstruction"}> def.
            ) associates to an embbeded manifold
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ,
                  %mi i
                  %mo ,
                  %mover
                    %mi g
                    %mo{:stretchy => "false"} ^
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (X,i,\hat g)
            with normal
            = succeed "-structure" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
            = succeed ")" do
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#ManifoldWithBfStructure"} def.
            %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+group"} stable homotopy group
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi π
                    %mrow
                      %mi dim
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi M
                  %mi ℬ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \pi_{dim(X)}(M \mathcal{B})
            of the universal
            = succeed "-" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
            %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            in degree the dimension of that manifold.
          #PontrjaginThomIsRingHomomorphims.num_lemma
            %h6#lemma Lemma
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              be a multiplicative
              %a.existingWikiWord{:href => "/nlab/show/%28B%2Cf%29-structure"} (B,f)-structure
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#BfStructure"}> def.
              ), the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+construction"} Pontrjagin-Thom construction
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#PontrjaginThomConstruction"}> def.
              ) is compatible with all the relations involved to yield a graded
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              %a.existingWikiWord{:href => "/nlab/show/homomorphism"} homomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi ℬ
                    %mo ⟶
                    %msub
                      %mi π
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\xi
                    \\;\colon\;
                    \\Omega^{\mathcal{B}}_\bullet
                    \\longrightarrow
                    \\pi_\bullet(M \mathcal{B})
            %p
              from the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %a.existingWikiWord{:href => "/nlab/show/bordism+ring"} bordism ring
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BordismGroupAndBordismRing"}
              %a.existingWikiWord{:href => "/nlab/show/stable+homotopy+groups"} stable homotopy groups
              of the universal
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              equipped with the ring structure induced from the canonical
              %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
              structure (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#UniversalThomSpectrumForBfStructure"}> def.
              ).
          .proof
            %h6#proof_6 Proof
            %p
              By prop.
              %a.maruku-ref{:href => "#PontrjaginThomConstructionGivesWellDefinedStableHomotopyGroup"}
              the underlying function of sets is well-defined before dividing out the bordism relation (def.
              = succeed ")." do
                %a.maruku-ref{:href => "#BordismRelation"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              a
              %a.existingWikiWord{:href => "/nlab/show/left+homotopy"} left homotopy
              of representatives of homotopy groups.
            %p Next we need to show that it is
            %ol
              %li
                %p a group homomorphism;
              %li
                %p a ring homomorphism.
            %p Regarding the first point:
            %p
              The element 0 in the
              %a.existingWikiWord{:href => "/nlab/show/cobordism+group"} cobordism group
              is represented by the empty manifold. It is clear that the Pontrjagin-Thom construction takes this to the trivial stable homotopy now.
            %p
              Given two
              = succeed "-manifolds" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              into some
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} \mathbb{R}^{k}
              such that the
              %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhoods"} tubular neighbourhoods
              of the two direct summands do not intersect. There is then a map from two copies of the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/n-cube"} k-cube
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mo □
                      %mi k
                    %munder
                      %mo ⊔
                      %mrow
                        %msup
                          %mo □
                          %mrow
                            %mi k
                            %mo −
                            %mn 1
                    %msup
                      %mo □
                      %mi k
                    %mo ⟶
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"}
                    \\Box^k \underset{\Box^{k-1}}{\sqcup} \Box^k
                    \\longrightarrow
                    \\mathbb{R}^k
            %p
              such that the first manifold with its tubular neighbourhood sits inside the image of the first cube, while the second manifold with its tubular neighbourhood sits indide the second cube. After applying the Pontryagin-Thom construction to this setup, each cube separately maps to the image under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              of the respective manifold, while the union of the two cubes manifestly maps to the sum of the resulting elements of homotopy groups, by the very definition of the group operation in the homotopy groups (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+P#HomotopyGroupsOftopologicalSpaces"}> def.
              ). This shows that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                  %annotation{:encoding => "application/x-tex"} \xi
              is a group homomorphism.
            %p Regarding the second point:
            %p
              The element 1 in the
              %a.existingWikiWord{:href => "/nlab/show/cobordism+ring"} cobordism ring
              is represented by the manifold which is the point. Without restriction we may consoder this as embedded into
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi ℝ
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} \mathbb{R}^0
              %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
              is of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              0 and hence (by remark
              = succeed ")" do
                %a.maruku-ref{:href => "#ThomSpaceForRankZeroBundle"}
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              is
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mn 0
                    %annotation{:encoding => "application/x-tex"} S^0
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/0-sphere"} 0-sphere
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi V
                      %mn 0
                      %mi ℬ
                  %annotation{:encoding => "application/x-tex"} V^{\mathcal{B}}_0
              is the rank-0 vector bundle over the point, and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo ≃
                    %msup
                      %mi S
                      %mn 0
                  %annotation{:encoding => "application/x-tex"} (M \mathcal{B})_0 \simeq S^0
              (by def.
              = succeed ")" do
                %a.maruku-ref{:href => "#UniversalThomSpectrumForBfStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ξ
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo{:lspace => "verythinmathspace"} :
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mn 0
                    %mover
                      %mo →
                      %mo ≃
                    %msup
                      %mi S
                      %mn 0
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \xi(\ast) \colon (S^0 \overset{\simeq}{\to} S^0)
              indeed represents the unit element in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi π
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi M
                      %mi ℬ
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \pi_\bullet(M\mathcal{B})
            %p
              Finally regarding respect for the ring product structure: for two manifolds with stable normal
              = succeed "-structure," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
