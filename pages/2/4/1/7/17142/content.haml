                        %mi T
                        %mrow
                          %mi i
                          %mo{:stretchy => "false"} (
                          %mi x
                          %mo{:stretchy => "false"} )
                      %msup
                        %mi ℝ
                        %mi k
                      %mo }
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    N_i
                    \\coloneqq
                    \\left\{
                    x\in X, v \in T_{i(x)}\mathbb{R}^k
