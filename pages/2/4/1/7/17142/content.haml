                    %semantics
                      %mrow
                        %mi n
                        %mo ∈
                        %mi ℕ
                      %annotation{:encoding => "application/x-tex"} n\in \mathbb{N}
                  a
                  %a.existingWikiWord{:href => "/nlab/show/pointed+topological+space"} pointed
                  %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
