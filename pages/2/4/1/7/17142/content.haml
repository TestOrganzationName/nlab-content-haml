          #BordismRelation.num_defn
            %h6#definition_5 Definition
            %p
              Two closed manifolds of
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              equipped with normal
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 1
                    %mo ,
                    %msub
                      %mi i
                      %mn 1
                    %mo ,
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_1, i_1, \hat g_1)
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mn 2
                    %mo ,
                    %msub
                      %mi i
                      %mn 2
                    %mo ,
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_2,i_2,\hat g_2)
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#ManifoldWithBfStructure"}> def.
              ) are called
              %strong bordant
              if there exists a
              %a.existingWikiWord{:href => "/nlab/show/manifold+with+boundary"} manifold with boundary
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                  %annotation{:encoding => "application/x-tex"} W
              of dimension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo +
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} n+1
              equipped with
              = succeed "-strcuture" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ,
                    %msub
                      %mi i
                      %mi W
                    %mo ,
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mi W
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (W,i_W, \hat g_W)
              if its
              %a.existingWikiWord{:href => "/nlab/show/boundary"} boundary
              with
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} X_1
              with the negative of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi X
                        %mn 2
                    %annotation{:encoding => "application/x-tex"} X_2
              %a.maruku-ref{:href => "#NegativeOfManifoldWithBfStructure"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∂
                    %mo{:stretchy => "false"} (
                    %mi W
                    %mo ,
                    %msub
                      %mi i
                      %mi W
                    %mo ,
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mi W
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mo{:stretchy => "false"} (
