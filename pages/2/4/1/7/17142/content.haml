              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi O
                  %annotation{:encoding => "application/x-tex"} M O
              is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/spectrum"} spectrum
              %a.existingWikiWord{:href => "/nlab/show/sequential+prespectrum"} sequential prespectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1#SequentialSpectra"}> def.
              ) whose
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              (def.
