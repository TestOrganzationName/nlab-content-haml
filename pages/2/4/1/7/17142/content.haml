                    %mo ,
                    %msub
                      %mi i
                      %mn 2
                    %mo ,
                    %msub
                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mn 2
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\partial(W,i_W,\hat g_W)
                    \\simeq
                    (X_1, i_1, \hat g_1)
                    \\sqcup
                    \-(X_2, i_2, \hat g_2)
                    \\,.
          #BordismIsAnEquivalenceRelation.num_prop
            %h6#proposition Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/relation"} relation
              of
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %a.existingWikiWord{:href => "/nlab/show/bordism"} bordism
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#BordismRelation"}
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/equivalence+relation"} equivalence relation
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \Omega^\mathcal{B}_{\bullet}
              for the
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℕ
                    %annotation{:encoding => "application/x-tex"} \mathbb{N}
              = succeed "-bordism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              = succeed "-manifolds." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
          #BordismGroupAndBordismRing.num_prop
            %h6#proposition_2 Proposition
            %p
              Under
              %a.existingWikiWord{:href => "/nlab/show/disjoint+union"} disjoint union
              of manifolds, then the set of
              = succeed "-bordism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %a.maruku-ref{:href => "#BordismIsAnEquivalenceRelation"}
              becomes an
              = succeed "-graded" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℤ
                    %annotation{:encoding => "application/x-tex"} \mathbb{Z}
              %a.existingWikiWord{:href => "/nlab/show/abelian+group"} abelian group
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi ℬ
                    %mo ∈
                    %msup
                      %mi Ab
                      %mi ℤ
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{\mathcal{B}}_\bullet \in Ab^{\mathbb{Z}}
            %p
              (that happens to be concentrated in non-negative degrees). This is called the
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℬ
                      %annotation{:encoding => "application/x-tex"} \mathcal{B}
                  \-bordism group
            %p
              Moreover, if the
              %a.existingWikiWord{:href => "/nlab/show/%28B%2Cf%29-structure"} (B,f)-structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              is multiplicative (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#BfStructure"}> def.
              ), then
              %a.existingWikiWord{:href => "/nlab/show/Cartesian+product"} Cartesian product
              of manifolds followed by the multiplicative composition operation of
              = succeed "-structures" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              = succeed "-bordism" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
              = succeed "." do
                %strong
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mi ℬ
                      %annotation{:encoding => "application/x-tex"} \mathcal{B}
                  \-bordism ring
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi Ω
                      %mo •
                      %mi ℬ
                    %mo ∈
                    %msup
                      %mi CRing
                      %mi ℤ
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Omega^{\mathcal{B}}_\bullet \in CRing^{\mathbb{Z}}
                    \\,.
          %p
            e.g. (
            %a{:href => "#Kochmann96"}> Kochmann 96, prop. 1.5.3
            )
          %h3#thom_spaces Thom spaces
          #ThomSpace.num_defn
            %h6#definition_6 Definition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+space"} topological space
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
              be a
              %a.existingWikiWord{:href => "/nlab/show/vector+bundle"} vector bundle
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi n
                    %annotation{:encoding => "application/x-tex"} n
              %a.existingWikiWord{:href => "/nlab/show/associated+bundle"} associated
              to an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/orthogonal+group"} O(n)
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/principal+bundle"} principal bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi X
                  %annotation{:encoding => "application/x-tex"} V \to X
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
              of the
              %a.existingWikiWord{:href => "/nlab/show/universal+vector+bundle"} universal vector bundle
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi E
                      %mi n
                    %mo →
                    %mi B
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} E_n \to B O(n)
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#EOn"}
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              = succeed "." do
                %span.newWikiWord
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi O
                        %mo{:stretchy => "false"} (
                        %mi n
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} B O(n)
                  %a{:href => "/nlab/new/BO%28n%29"} ?
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi O
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo{:stretchy => "false"} )
