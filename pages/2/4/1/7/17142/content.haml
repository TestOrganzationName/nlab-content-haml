                    \&amp;\longrightarrow&amp;
                    E O(n+1) \underset{O(n+1)}{\times} \mathbb{R}^{n+1}
                    \\\
                    \\downarrow &amp;(pb)&amp; \downarrow
                    \\\
                    B O(n) &amp;\longrightarrow&amp; B O(n+1)
