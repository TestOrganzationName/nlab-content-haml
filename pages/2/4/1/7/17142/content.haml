                      %mover
                        %mi g
                        %mo{:stretchy => "false"} ^
                      %mn 1
                    %mo{:stretchy => "false"} )
                    %mo ⊔
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
