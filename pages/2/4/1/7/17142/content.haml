                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi O
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo +
                                %mn 1
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi ℝ
                              %mrow
                                %mi n
                                %mo +
                                %mn 1
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msubsup
                              %mi f
                              %mi n
                              %mo *
                            %mo{:stretchy => "false"} (
                            %mi ℝ
                            %mo ⊕
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mi O
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo{:stretchy => "false"} )
                            %munder
                              %mo ×
                              %mrow
                                %mi O
                                %mo{:stretchy => "false"} (
                                %mi n
                                %mo{:stretchy => "false"} )
                            %msup
                              %mi ℝ
                              %mi n
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %mi ℝ
                            %mo ⊕
                            %msup
                              %mi V
                              %mrow
                                %msub
                                  %mi ℬ
                                  %mi n
                            %mspace{:width => "thinmathspace"}
                            %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\begin{aligned}
                    (g_{n,n+1})^\ast V^{\mathcal{B}}_{n+1}
                    \&amp; =
                    (g_{n,n+1})^\ast f_{n+1}^\ast (E O(n+1)\underset{O(n+1)}{\times} \mathbb{R}^{n+1})
                    \\\
                    \&amp; \simeq
                    (g_{n,n+1} \circ f_{n+1})^\ast (E O(n+1)\underset{O(n+1)}{\times} \mathbb{R}^{n+1})
                    \\\
                    \&amp; \simeq
                    ( f_n \circ i_n )^\ast (E O(n+1)\underset{O(n+1)}{\times} \mathbb{R}^{n+1})
                    \\\
                    \&amp; \simeq
                    f_n^\ast i_n^\ast (E O(n+1)\underset{O(n+1)}{\times} \mathbb{R}^{n+1})
                    \\\
                    \&amp; \simeq
                    f_n^\ast (\mathbb{R} \oplus (E O(n)\underset{O(n)}{\times} \mathbb{R}^{n}))
                    \\\
                    \&amp;\simeq \mathbb{R} \oplus V^{\mathcal{B}_n}
                    \\,,
                    \\end{aligned}
            %p
              where the second but last step is due to prop.
              = succeed "." do
                %a.maruku-ref{:href => "#PullbackOfUniversalOnBundleUnderCoordinateRestriction"}
          #UniversalThomSpectrumForBfStructure.num_defn
            %h6#definition_9 Definition
            %p
              Given a
              %a.existingWikiWord{:href => "/nlab/show/%28B%2Cf%29-structure"} (B,f)-structure
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} \mathcal{B}
              (def.
              = succeed ")," do
                %a.maruku-ref{:href => "#BfStructure"}
              %strong universal Thom spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} M \mathcal{B}
              is, as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/sequential+prespectrum"} sequential prespectrum
              %a.existingWikiWord{:href => "/nlab/show/Thom+spaces"} Thom spaces
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ThomSpace"}
              = succeed "-associated" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} \mathcal{B}
              %a.maruku-ref{:href => "#VectorBundleAssociatedWithBfStructure"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo ≔
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mi n
                      %mi ℬ
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (M \mathcal{B})_n
                    \\coloneqq
                    Th(V^{\mathcal{B}}_n)
            %p
              and with structure maps given via prop.
              %a.maruku-ref{:href => "#SuspensionOfThomSpaces"}
              by the top maps in prop.
              = succeed ":" do
                %a.maruku-ref{:href => "#PullbackOfUniversalBfBundleUnderCoordinateRestriction"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi σ
                      %mi n
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mi Σ
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mi n
                    %mo =
                    %mi Σ
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mi n
                      %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi ℝ
                    %mo ⊕
                    %msubsup
                      %mi V
                      %mi n
                      %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi Th
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi e
                          %mrow
                            %mi n
                            %mo ,
                            %mi n
                            %mo +
                            %mn 1
                        %mo{:stretchy => "false"} )
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                      %mi ℰ
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %mi n
                        %mo +
                        %mn 1
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\sigma_n
                    \\;\colon\;
                    \\Sigma (M \mathcal{B})_n
                    \=
                    \\Sigma Th(V^{\mathcal{E}}_n)
                    \\simeq
                    Th(\mathbb{R}\oplus V^{\mathcal{E}}_n)
                    \\overset{Th(e_{n,n+1})}{\longrightarrow}
                    Th(V^{\mathcal{E}}_{n+1})
                    \=
                    (M \mathcal{B})_{n+1}
                    \\,.
            %p
              Similarly for an
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi S
                        %mi k
                      %mo −
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} S^k-(B,f)
              = succeed "th" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/almost+complex+structure"} almost complex structure
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/almost+quaternionic+structure"} almost quaternionic structure
              = succeed ")," do
                %a.maruku-ref{:href => "#ExamplesOfBfStructures"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi S
                      %mi k
                  %annotation{:encoding => "application/x-tex"} S^k
              spectrum (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1#SequentialTSpectra"}> def.
              ).
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                    %mo =
                    %mi B
                    %msub
                      %mi G
                      %mi n
                  %annotation{:encoding => "application/x-tex"} B_n = B G_n
              for some natural system of groups
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi G
                        %mi n
                      %mo →
                      %mi O
                      %mo{:stretchy => "false"} (
                      %mi n
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} G_n \to O(n)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi G
                  %annotation{:encoding => "application/x-tex"} M G
              for
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mi ℬ
                    %annotation{:encoding => "application/x-tex"} M \mathcal{B}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                      %mi SO
                    %annotation{:encoding => "application/x-tex"} M SO
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/MSpin"} MSpin
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/MU"} MU
              %a.existingWikiWord{:href => "/nlab/show/MSp"} MSp
              etc.
            %p
              If the
              = succeed "-structure" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B,f)
              = succeed ")," do
                %a.maruku-ref{:href => "#BfStructure"}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mi ℬ
                  %annotation{:encoding => "application/x-tex"} M \mathcal{B}
              canonical becomes a
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/ring+spectrum"} ring spectrum
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ×
                    %msub
                      %mi B
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo →
                    %msub
                      %mi B
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"} B_{n_1} \times B_{n_2}\to B_{n_1 + n_2}
              are covered by maps of vector bundles
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi V
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                      %mi ℬ
                    %mo ⊠
                    %msubsup
                      %mi V
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                      %mi ℬ
                    %mo ⟶
                    %msubsup
                      %mi V
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                      %mi ℬ
                  %annotation{:encoding => "application/x-tex"}
                    V^{\mathcal{B}}_{n_1} \boxtimes V^{\mathcal{B}}_{n_2}
                    \\longrightarrow
                    V^{\mathcal{B}}_{n_1 + n_2}
            %p
              and under forming
              %a.existingWikiWord{:href => "/nlab/show/Thom+spaces"} Thom spaces
              this yields (
              %a{:href => "Thom+space#ThomSpaceOfExternalProductOfVectorBundles"}> prop.
              ) maps
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                    %mo ∧
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mn 2
                    %mo ⟶
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mrow
                        %msub
                          %mi n
                          %mn 1
                        %mo +
                        %msub
                          %mi n
                          %mn 2
                  %annotation{:encoding => "application/x-tex"}
                    (M \mathcal{B})_{n_1}
                    \\wedge
                    (M \mathcal{B})_{n_2}
                    \\longrightarrow
                    (M \mathcal{B})_{n_1 + n_2}
            %p
              which are
              %a.existingWikiWord{:href => "/nlab/show/associativity"} associative
              by the associativity condition in a multiplicative
              = succeed "-structure." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo ,
                      %mi f
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (B,f)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mi ℬ
                    %msub
                      %mo{:stretchy => "false"} )
                      %mn 0
                    %mo =
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %msubsup
                      %mi V
                      %mn 0
                      %mi ℬ
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mo *
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %msup
                      %mi S
                      %mn 0
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    (M \mathcal{B})_0
                    \=
                    Th(V^{\mathcal{B}}_0)
                    \\simeq
                    Th(\ast)
                    \\simeq
                    S^0
                    \\,,
            %p
              by remark
              = succeed "." do
                %a.maruku-ref{:href => "#ThomSpaceForRankZeroBundle"}
          .num_example
            %h6#example_3 Example
            %p
              The universal
              %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#UniversalThomSpectrumForBfStructure"}
              %em
                %a.existingWikiWord{:href => "/nlab/show/framing"} framing
                structure
              (
              %a{:href => "tangential+structure#ExamplesOfBfStructures"}> exmpl.
              ) is equivalently the
              %a.existingWikiWord{:href => "/nlab/show/sphere+spectrum"} sphere spectrum
              (
              %a{:href => "Introduction+to+Stable+homotopy+theory+--+1#StandardSphereSpectrum"}> def.
              )
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mn 1
                    %mo ≃
                    %mi 𝕊
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    M 1 \simeq \mathbb{S}
                    \\,.
            %p
              Because in this case
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi B
                      %mi n
                    %mo ≃
                    %mo *
                  %annotation{:encoding => "application/x-tex"} B_n \simeq \ast
              and so
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msubsup
                        %mi E
                        %mi n
                        %mi ℬ
                      %mo ≃
                      %msup
                        %mi ℝ
                        %mi n
                    %annotation{:encoding => "application/x-tex"} E^{\mathcal{B}}_n \simeq \mathbb{R}^n
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Th
                      %mo{:stretchy => "false"} (
                      %msubsup
                        %mi E
                        %mi n
                        %mi ℬ
                      %mo{:stretchy => "false"} )
                      %mo ≃
                      %msup
                        %mi S
                        %mi n
                    %annotation{:encoding => "application/x-tex"} Th(E^{\mathcal{B}}_n) \simeq S^n
          %h3#pontrjaginthom_construction Pontrjagin-Thom construction
          #TubularNeighbourhood.num_defn
            %h6#definition_10 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              a
              %a.existingWikiWord{:href => "/nlab/show/smooth+manifold"} smooth manifold
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi i
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo ↪
                    %msup
                      %mi ℝ
                      %mi k
                  %annotation{:encoding => "application/x-tex"} i \colon X \hookrightarrow \mathbb{R}^k
              an
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/embedding"} embedding
              %strong
                %a.existingWikiWord{:href => "/nlab/show/tubular+neighbourhood"} tubular neighbourhood
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is a subset of the form
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi τ
                      %mi i
                    %mi X
                    %mo ≔
                    %mrow
                      %mo {
                      %mi x
                      %mo ∈
                      %msup
                        %mi ℝ
                        %mi k
                      %mspace{:width => "thickmathspace"}
                      %mo{:stretchy => "false"} |
                      %mspace{:width => "thickmathspace"}
                      %mi d
                      %mo{:stretchy => "false"} (
                      %mi x
                      %mo ,
                      %mi i
                      %mo{:stretchy => "false"} (
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo &lt;
                      %mi ϵ
                      %mo }
                  %annotation{:encoding => "application/x-tex"}
                    \\tau_i X
                    \\coloneqq
                    \\left\{
                    x \in \mathbb{R}^k \;\vert\; d(x,i(X)) \lt \epsilon
                    \\right\}
            %p
              for some
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo ∈
                      %mi ℝ
                    %annotation{:encoding => "application/x-tex"} \epsilon \in \mathbb{R}
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ϵ
                      %mo &gt;
                      %mn 0
                    %annotation{:encoding => "application/x-tex"} \epsilon \gt 0
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi N
                      %mi i
                    %mi X
                    %mo ⟶
                    %msub
                      %mi τ
                      %mi i
                    %mi X
                  %annotation{:encoding => "application/x-tex"}
                    N_i X \longrightarrow \tau_i X
            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/normal+bundle"} normal bundle
              (def.
              = succeed ")" do
                %a.maruku-ref{:href => "#ClassifyingMapOfNormalBundle"}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi v
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %mi ϵ
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo −
                    %msup
                      %mi e
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mrow
                          %mo{:stretchy => "false"} |
                          %mi v
                          %mo{:stretchy => "false"} |
                    %mo{:stretchy => "false"} )
                    %mi v
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    (i(x),v) \mapsto (i(x), \epsilon (1-e^{- {\vert v\vert}}) v )
            %p
              is a
