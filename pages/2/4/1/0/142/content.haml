                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
                  %td{:style => "text-align: left;"}
                    %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-sheaf"}> (∞,1)-sheaf
                    \/​
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stack"} ∞-stack
                  %td{:style => "text-align: left;"}
                    h-
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
                    \-groupoid
          %h2#references References
          %p
            The concept originates (under the French term
            %em champ
            and for the purpose of defining
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/non-abelian+cohomology"} non-abelian cohomology
          %ul
            %li#Giraud66
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jean+Giraud"}> Jean Giraud
                ,
                = succeed "," do
                  %em Cohomologie non abélienne
                = succeed "&rbrack;" do
                  %a{:href => "https://books.google.de/books/about/Cohomologie_non_ab%C3%A9lienne.html?id=EQ1CAAAAIAAJ&redir_esc=y"} GoogleBooks
              %p
                published as: Grundlehren
                = succeed "," do
                  %strong 179
                = succeed "&rbrack;" do
                  %a{:href => "https://www.springer.com/gp/book/9783540053071"} doi:10.1007/978-3-662-62103-5
          %p
            and under the English term
            %em stack
            (for specialization to
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Deligne-Mumford+stacks"} Deligne-Mumford stacks
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/orbifolds"} orbifolds
          %ul
            %li#DeligneMumford69
              %a.existingWikiWord{:href => "/nlab/show/Pierre+Deligne"}> Pierre Deligne
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Mumford"} David Mumford
              = succeed "," do
                %em The irreducibility of the space of curves of given genus
              %strong 36
              (1969) 75-109 &amp;lbrack;
              %a{:href => "https://doi.org/10.1007/BF02684599"}> doi:10.1007/BF02684599
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.numdam.org/item?id=PMIHES_1969__36__75_0"} numdam:PMIHES_1969__36__75_0
          %p
            and in the context of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/classifying+toposes"} classifying toposes
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Jean+Giraud"}> Jean Giraud
              ,
              = succeed "," do
                %em Classifying topos
              %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"} William Lawvere
              (ed.)
              = succeed "," do
                %em Toposes, Algebraic Geometry and Logic
              = succeed ")" do
                %a{:href => "https://doi.org/10.1007/BFb0073964"} doi:10.1007/BFb0073964
          %p Further early discussion:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"}> Marta Bunge
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Pare"} Robert Pare
                = succeed "," do
                  %em Stacks and equivalence of indexed categories
                = succeed "&rbrack;" do
                  %a{:href => "http://www.numdam.org/item?id=CTGDC_1979__20_4_373_0"} numdam
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marta+Bunge"}> Marta Bunge
                ,
                = succeed "," do
                  %em Stack completions and Morita equivalence for categories in a topos
              %p
                401-436 &amp;lbrack;
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=558106"}> MR558106
                ,
                = succeed "&rbrack;" do
                  %a{:href => "http://www.numdam.org/item?id=CTGDC_1979__20_4_401_0"} numdam
          %p
            See also the references at
            %em
              %a.existingWikiWord{:href => "/nlab/show/2-sheaf"} 2-sheaf
            and for considerably more literature see at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/algebraic+stack"} algebraic stack
          %p Review:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ieke+Moerdijk"}> Ieke Moerdijk
                ,
                %em Introduction to the language of stacks and gerbes
                \&amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math/0212266"}> arXiv:math/0212266
                \&amp;rbrack;
              %blockquote
                %p
                  (including discussion of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/gerbes"} gerbes
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Jochen+Heinloth"}> Jochen Heinloth
                ,
                %em Notes on differentiable stacks
                (2004) &amp;lbrack;
                %a{:href => "https://math.nyu.edu/~tschinke/WS04/pdf/heinloth.pdf"}> pdf
                ,
                = succeed "&rbrack;" do
                  %a.existingWikiWord{:href => "/nlab/files/Heinloth-DifferentiableStacks.pdf", :title => "pdf"} pdf
              %blockquote
                %p
                  (focused on
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/differentiable+stacks"} differentiable stacks
          %p
            Discussion of stacks in their incarnation (under the
            = succeed ")" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+construction"} Grothendieck construction
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+fibrations"} Grothendieck fibrations
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Angelo+Vistoli"}> Angelo Vistoli
              ,
              %em Grothendieck topologies, fibered categories and descent theory
              \&amp;lbrack;
              %a{:href => "http://arxiv.org/abs/math/0412512"}> math.AG/0412512
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=2223406"} MR2223406
              = succeed "," do
                %em
                  Fundamental algebraic geometry. Grothendieck’s
                  %a.existingWikiWord{:href => "/nlab/show/FGA+explained"} FGA explained
              = succeed "," do
                %strong 123
              = succeed "," do
                %a{:href => "https://bookstore.ams.org/surv-123-s"} ISBN:978-0-8218-4245-4
              = succeed "&rbrack;" do
                %a{:href => "http://www.ams.org/mathscinet-getitem?mr=2007f:14001"} MR2007f:14001
          %p
            A
            %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            structure on
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/presheaves+of+groupoids"} presheaves of groupoids
            %a.existingWikiWord{:href => "/nlab/show/Bousfield+localization+of+model+categories"} localization
            of a
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+presheaves"} model structure on simplicial presheaves
            (modeling
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-stacks"} ∞-stacks
            before localization):
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/John+F.+Jardine"}> John F. Jardine
                ,
                = succeed "," do
                  %em Stacks and the homotopy theory of simplicial sheaves
                %strong 3
                2 (2001) 361-384 &amp;lbrack;
                %a{:href => "https://projecteuclid.org/euclid.hha/1139840259"}> euclid:hha/1139840259
                \&amp;rbrack;
            %li#Hollander01
              %p
                %a.existingWikiWord{:href => "/nlab/show/Sharon+Hollander"}> Sharon Hollander
                ,
                = succeed "," do
                  %em A homotopy theory for stacks
                %strong 163
                1 (2008) 93-124 &amp;lbrack;
                %a{:href => "http://arxiv.org/abs/math.AT/0110247"}> arXiv:math.AT/0110247
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1007/s11856-008-0006-5"} doi:10.1007/s11856-008-0006-5
