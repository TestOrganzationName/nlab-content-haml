                    \\,
                    \\underset{
                    \\underset{i' \in \mathcal{I}'}{\longrightarrow}
                    }{\lim}
                    \\,
                    \\bigg(
                    PSh(\mathcal{C}_{/X})
                    \\Big(
                    \\big(
                    c_U(i)
                    ,\,
                    p_{c_U(i)}
                    \\big)
                    \\,,
                    \\big(
                    c_{U'}(i')
                    ,\,
                    p_{c_{U'}(i')}
                    \\big)
                    \\Big)
                    \\bigg)
                    \\\
                    \\;\simeq\;
                    PSh(\mathcal{C}_{/X})
                    \\Big(
                    \\underset{
                    \\underset{i \in \mathcal{I}}{\longrightarrow}
                    }{\lim}
                    \\big(
                    c_U(i)
                    ,\,
                    p_{c_U(i)}
                    \\big)
                    \\,,
                    \\underset{
                    \\underset{i' \in \mathcal{I}'}{\longrightarrow}
                    }{\lim}
                    \\big(
                    c_{U'}(i')
                    ,\,
                    p_{c_{U'}(i')}
                    \\big)
                    \\Big)
                    \\bigg)
                    \\\
                    \\;\simeq\;
                    PSh(\mathcal{C}_{/X})
                    \\Big(
                    \\big(
                    U
                    ,\,
                    p_U
                    \\big)
                    \\,,
                    \\big(
                    U'
                    ,\,
                    p_{U'}
                    \\big)
                    \\Big)
                    \\bigg)
                    \\mathrlap{\,.}
                    \\end{array}
            %p Here
            %ul
              %li
                %p
                  the first step is the definition
                  %a.maruku-eqref{:href => "#eq:HomInSliceCategoryAsFiberProduct"} (3)
                  of the slice hom;
              %li
                %p
                  the second step is the expression of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                      %annotation{:encoding => "application/x-tex"} U
                  as a colimit of representables (
                  %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"}> co-Yoneda lemma
                  ), together with the fact that any
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/hom-functor+preserves+limits"} hom functor sends colimits in the first argument to limits
              %li
                %p
                  the third step is the the
                  %a.existingWikiWord{:href => "/nlab/show/fiber+product"} fiber product
                  commutes with this limit (since
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/limits+commute+with+limits"} limits commute with limits
              %li
                %p
                  the fourth step is the expression of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi U
                        %mo ′
                      %annotation{:encoding => "application/x-tex"} U'
                  as a colimit of representables (
                  %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"}> co-Yoneda lemma
                  ), together with the
                  %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
                  and the fact that colimits of presheaves are computed objectwise (
                  %a{:href => "category+of+presheaves#LimitsOfPresheavesAreComputedObjectwise"}> here
                  );
              %li
                %p
                  the fifth step is
                  %a.existingWikiWord{:href => "/nlab/show/universal+colimits"} universal colimits
                  in the ambient
                  %a.existingWikiWord{:href => "/nlab/show/topos"} topos
                  (of
                  = succeed ");" do
                    %a.existingWikiWord{:href => "/nlab/show/Sets"} Sets
              %li
                %p
                  the sixths step recognizes that the slice hom
                  %a.maruku-eqref{:href => "#eq:HomInSliceCategoryAsFiberProduct"} (3)
                  defining
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi 𝒞
                          %mrow
                            %mo{:stretchy => "false"} /
                            %mi X
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}_{/X}
                  has appeared and moves the colimits back inside by the reverse of the previous arguments, now over the slice side.
            %p
          %p
            The following statement enhances this equivalence of categories to an
            %a.existingWikiWord{:href => "/nlab/show/adjoint+equivalence"} adjoint equivalence
            and identifying its
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
            as the
            %a.existingWikiWord{:href => "/nlab/show/functor"} functor
            of forming
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/sections"} sections
            %a.existingWikiWord{:href => "/nlab/show/simplicial+Quillen+adjunction"} simplicial
            %a.existingWikiWord{:href => "/nlab/show/Quillen+equivalence"} Quillen equivalence
            below.
          %p
          #TheAdjointEquivalenceInOrdinaryCategoryTheory.num_prop
            %h6 Proposition
            %p
