                            %mspace{:width => "thickmathspace"}
                            %mo ≃
                            %mspace{:width => "thickmathspace"}
                            %mi 𝒢
                            %mi Act
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mi Grpd
                              %mn ∞
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                            %mspace{:width => "thinmathspace"}
                            %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \\big(Grpd_\infty\big)_{/\mathbf{B}\mathcal{G}}
                    \\,\simeq\,
                    \\big(
                    PSh_\infty(\ast)
                    \\big)_{/\mathbf{B}\mathcal{G}}
                    \&amp;
                    \\underoverset
                    {\phantom{--}\sim\phantom{--}}
                    {\Gamma}
                    {\longrightarrow}
                    \&amp;
                    PSh_\infty
                    \\big(
                    \\ast_{/\mathbf{B}\mathcal{G}}
                    \\big)
                    \\;\simeq\;
                    PSh_\infty(
                    \\mathbf{B}\mathcal{G}
                    \\big)
                    \\;\simeq\;
                    \\mathcal{G} Act
                    \\big(
                    Grpd_\infty
                    \\big)
                    \\,.
                    }
            %p
              This is the identification of the slice over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi 𝒢
                  %annotation{:encoding => "application/x-tex"} B \mathcal{G}
              with
              %a.existingWikiWord{:href => "/nlab/show/infinity-action"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-actions
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
              = succeed "-presentation" do
                %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              = succeed "." do
                %em
                  %a{:href => "Borel+model+structure#RelationToSliceOverSimplicialClassifyingSpace"} Borel model structure – Relation to the slice over the simplicial classifying space
          %p
          #CohesionOfGlobalOverGEquivariantHomotopyTheory.num_remark
            %h6 Example
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/cohesion+of+global-+over+G-equivariant+homotopy+theory"}> cohesion of global- over G-equivariant homotopy theory
                )
              %br/
            %p
              In the case that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo =
                    %mspace{:width => "thinmathspace"}
                    %mi Snglrt
                    %mspace{:width => "thinmathspace"}
                    %mo ≔
                    %mspace{:width => "thinmathspace"}
                    %msubsup
                      %mi Grpd
                      %mrow
                        %mn 1
                        %mo ,
                        %mo ≥
                        %mn 1
                      %mi fin
                  %annotation{:encoding => "application/x-tex"} \mathbf{C} \,=\, Snglrt \,\coloneqq\, Grpd^{fin}_{1,\geq 1}
              is the
              %a.existingWikiWord{:href => "/nlab/show/global+orbit+category"} global orbit category
              (a
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/%282%2C1%29-category"} (2,1)-category
              %a.maruku-ref{:href => "#EquivalenceOfInfinityCategories"}
              extracts the system of
              %a.existingWikiWord{:href => "/nlab/show/fixed+loci"} fixed loci
              of an object in
              %a.existingWikiWord{:href => "/nlab/show/global+equivariant+homotopy+theory"} global equivariant homotopy theory
              sliced over the archetypical
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orbi-singularity"} orbi-singularity
              %a.existingWikiWord{:href => "/nlab/show/equivariance+group"} equivariance group
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              %a.existingWikiWord{:href => "/nlab/show/adjoint+quadruple"} adjoint quadruple
              that is induced (see
              = succeed ")" do
                %a{:href => "adjoint+quadruple#ViaKanExtensionOfAdjointPairs"} here
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-Kan+extension"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-Kan extension
              from the
              %a.existingWikiWord{:href => "/nlab/show/reflective+sub-%28infinity%2C1%29-category"} reflection
              onto the
              = succeed "-" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                    %annotation{:encoding => "application/x-tex"} G
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/orbit+category"} orbit category
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cohesion+of+global-+over+G-equivariant+homotopy+theory"} cohesion of global- over G-equivariant homotopy theory
          %p
