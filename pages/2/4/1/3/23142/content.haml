            %p
              from the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"}
                slice
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              of the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-presheaves"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-category of
                = succeed "-presheaves" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              over
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mstyle{:mathvariant => "bold"}
                      %mi C
                  %annotation{:encoding => "application/x-tex"} \mathbf{C}
              to the
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-category+of+%28infinity%2C1%29-presheaves"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-category of
                = succeed "-presheaves" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              over the
              %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-category"}
                slice
                = succeed "-category" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mstyle{:mathvariant => "bold"}
                        %mi C
                    %annotation{:encoding => "application/x-tex"} \mathbf{C}
          %p
            An alternative proof of this statement in terms of
            %a.existingWikiWord{:href => "/nlab/show/quasi-categories"} quasi-categories
            is in
            = succeed "." do
              %a{:href => "#Lurie09"} Lurie 2009, Prop. 5.1.6.12
            %a{:href => "slice+infinity1-topos#SheavesOnBigSite"} here
            at
            = succeed ".)" do
              %em
                %a.existingWikiWord{:href => "/nlab/show/slice+%28infinity%2C1%29-topos"}
                  slice
                  = succeed "-topos" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mn ∞
                        %annotation{:encoding => "application/x-tex"} \infty
          %p
            A(nother)
            = succeed "-theory" do
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
            %a.existingWikiWord{:href => "/nlab/show/1-truncated"} 1-truncated
            simplicial presheaf is in (
            %a{:href => "#Hollander08"}> Hollander 2008
            ).
          %p
            A
            = succeed "-proof" do
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
            = succeed "." do
              %a{:href => "#Lurie09"} Lurie 2009, Cor. 5.1.6.12
          %p
          #InfinityActionsAsSlice.num_remark
            %h6 Example
            %p
              %strong
                (
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mi 𝒢
                    %annotation{:encoding => "application/x-tex"} \mathcal{G}
                \-
                %a.existingWikiWord{:href => "/nlab/show/infinity-action"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %mn ∞
                      %annotation{:encoding => "application/x-tex"} \infty
                  \-actions
                as slice over
                = succeed ")" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mi 𝒢
                      %annotation{:encoding => "application/x-tex"} B\mathcal{G}
              %br/
              Consider
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo ≃
                    %mspace{:width => "thinmathspace"}
                    %mi Ω
                    %mi B
                    %mi 𝒢
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi Grp
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %msub
                      %mi Grpd
                      %mn ∞
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\mathcal{G}
                    \\,\simeq\,
                    \\Omega B \mathcal{G}
                    \\,\in\,
                    Grp\big(Grpd_\infty\big)
            %p
              an
              %a.existingWikiWord{:href => "/nlab/show/infinity-group"}
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
                \-group
              with
              = succeed "/" do
                %a.existingWikiWord{:href => "/nlab/show/delooping"} delooping
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mi 𝒢
                      %mspace{:width => "thinmathspace"}
                      %mo ∈
                      %mspace{:width => "thinmathspace"}
                      %msubsup
                        %mi Grpd
                        %mn ∞
                        %mrow
                          %mo ≥
                          %mn 1
                    %annotation{:encoding => "application/x-tex"} B \mathcal{G} \,\in\, Grpd_\infty^{\geq 1}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒳
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %msub
                      %mi Grpd
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} \mathcal{X} \,\in\, Grpd_\infty
              is that
              = succeed "-groupoid:" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo *
                      %mrow
                        %mo{:stretchy => "false"} /
                        %mi 𝒳
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi 𝒳
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    \\ast_{/\mathcal{X}}
                    \\;\simeq\;
                    \\mathcal{X}
                    \\,,
            %p
