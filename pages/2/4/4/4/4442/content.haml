                                %mn 2
                            %annotation{:encoding => "application/x-tex"} AdS_2
                        holography and the SYK model
                    = succeed "," do
                      %a{:href => "https://arxiv.org/abs/1711.08482"} arXiv:1711.08482
                    = succeed ")" do
                      %a{:href => "https://doi.org/10.22323/1.323.0001"} doi:10.22323/1.323.0001
                %li#Maldacena18
