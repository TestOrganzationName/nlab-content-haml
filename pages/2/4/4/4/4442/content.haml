                = succeed "," do
                  %em Review of AdS/CFT Integrability: An Overview
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1012.3982"} arXiv:1012.3982
          %div
            %div
              %h3#sykmodel_in_
                SYK-model in
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
