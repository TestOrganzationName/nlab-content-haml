                        %mrow
                          %msub
                            %mi AdS
                            %mn 2
                        %annotation{:encoding => "application/x-tex"} AdS_2
                    gravity
                  (
                  %a{:href => "https://arxiv.org/abs/1707.02325"}> arXiv:1707.02325
                  )
              %p
                Relation to
                %a.existingWikiWord{:href => "/nlab/show/black+holes+in+string+theory"} black holes in string theory
                and
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/random+matrix+theory"} random matrix theory
              %ul
