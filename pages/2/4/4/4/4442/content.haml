                    %a.existingWikiWord{:href => "/nlab/show/Juan+Maldacena"}> Juan Maldacena
                    ,
                    = succeed "," do
                      %em Toy models for black holes II
                    %em From QBits to spacetime
                    (
                    %a{:href => "https://video.ias.edu/PiTP/2018/0726-JuanMaldacena"}> recording
