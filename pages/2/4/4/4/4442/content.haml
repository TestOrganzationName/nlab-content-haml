                          %mi 𝒩
                          %mo =
                          %mn 4
                        %annotation{:encoding => "application/x-tex"} \mathcal{N} = 4
                    Super Yang Mills
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0202021"} arXiv:hep-th/0202021
              %p
                (whence “
                %a.existingWikiWord{:href => "/nlab/show/BMN+operators"}> BMN operators
                ”)
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Steven+Gubser"}> Steven Gubser
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Igor+Klebanov"} Igor Klebanov
                = succeed "," do
