                    Super Yang-Mills
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0212208"} arXiv:hep-th/0212208
            %li#BeisertStaudacher03
              %p
                %a.existingWikiWord{:href => "/nlab/show/Niklas+Beisert"}> Niklas Beisert
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Matthias+Staudacher"} Matthias Staudacher
                = succeed "," do
