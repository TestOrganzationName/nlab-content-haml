                %a{:href => "https://arxiv.org/abs/hep-th/0204051"}> arXiv:hep-th/0204051
                ,
                = succeed "&rbrack;" do
                  %a{:href => "https://doi.org/10.1016/S0550-3213(02)00373-5"} doi:10.1016/S0550-3213(02)00373-5
            %li#Kruczenski04
              %p
                %a.existingWikiWord{:href => "/nlab/show/Martin+Kruczenski"}> Martin Kruczenski
                ,
                = succeed "," do
                  %em Spiky strings and single trace operators in gauge theories
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/hep-th/0410226"} arXiv:hep-th/0410226
          %p
            The identification of the relevant
            %a.existingWikiWord{:href => "/nlab/show/single+trace+operators"} single trace operators
            with
            %a.existingWikiWord{:href => "/nlab/show/integrable+system"} integrable
            %a.existingWikiWord{:href => "/nlab/show/spin+chains"} spin chains
            is due to
          %ul
            %li#MinahanZarembo02
              %p
                J. A. Minahan,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Konstantin+Zarembo"} Konstantin Zarembo
                = succeed "," do
                  %em
                    The Bethe-Ansatz for
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
