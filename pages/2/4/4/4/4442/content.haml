                    = succeed ")" do
                      %a{:href => "https://arxiv.org/abs/1604.07818"} arXiv:1604.07818
                %li#Sachdev10
                  %p
                    %a.existingWikiWord{:href => "/nlab/show/Subir+Sachdev"}> Subir Sachdev
                    ,
                    = succeed "," do
                      %em Holographic metals and the fractionalized Fermi liquid
                    = succeed ")" do
                      %a{:href => "https://arxiv.org/abs/1006.3794"} arXiv:1006.3794
              %p Review:
              %ul
                %li
                  %p
                    Gábor Sárosi,
                    = succeed "," do
                      %em
                        %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                          %semantics
                            %mrow
