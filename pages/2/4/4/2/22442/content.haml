                  %mi ℕ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  [d_C]
                  \\;\coloneqq\;
                  \\big(
                  d_C
                  \\big(
                  \\sigma_i, \sigma_j
                  \\big)
                  \\big)_{i,j}
                  \\;\in\;
                  Mat_{6 \times 6}(\mathbb{N})
          %p is
          #eq:ExplicitCayleyDistanceMatrix.maruku-equation
            %span.maruku-eq-number (1)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %msub
                    %mi d
                    %mi c
                  %mo{:stretchy => "false"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo =
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo [
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                          %mtd
                            %mn 2
                          %mtd
                            %mn 2
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mn 0
                          %mtd
                            %mn 2
                          %mtd
                            %mn 2
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mn 2
                          %mtd
                            %mn 0
                          %mtd
                            %mn 2
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mn 1
                          %mtd
                            %mn 2
                          %mtd
                            %mn 2
                          %mtd
                            %mn 0
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mn 2
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                          %mtd
                            %mn 0
                          %mtd
                            %mn 2
                        %mtr
                          %mtd
                            %mn 2
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                          %mtd
                            %mn 1
                          %mtd
                            %mn 2
                          %mtd
                            %mn 0
                    %mo ]
                %annotation{:encoding => "application/x-tex"}
                  [d_c]
                  \\;=\;
                  \\left[
                  \\array{
                  0 &amp; 1 &amp; 1 &amp; 1  &amp; 2 &amp;  2
                  \\\
                  1 &amp; 0 &amp; 2 &amp; 2 &amp; 1 &amp; 1
                  \\\
                  1 &amp; 2 &amp; 0 &amp; 2 &amp; 1 &amp; 1
                  \\\
                  1 &amp; 2 &amp; 2 &amp; 0 &amp; 1 &amp; 1
                  \\\
                  2 &amp; 1 &amp; 1 &amp; 1 &amp; 0 &amp; 2
                  \\\
                  2 &amp; 1 &amp; 1 &amp; 1 &amp; 2 &amp; 0
                  }
                  \\right]
          %h3#cayley_distance_kernel Cayley distance kernel
          %p
            For
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo ∈
                    %msub
                      %mi ℝ
                      %mo +
                  %annotation{:encoding => "application/x-tex"} \lambda \in \mathbb{R}_+
          #eq:CayleyDistanceKernel.maruku-equation
            %span.maruku-eq-number (2)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                  %msup
                    %mi e
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mi λ
                      %mo ⋅
                      %msub
                        %mi d
                        %mi C
                  %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %mspace{:width => "thickmathspace"}
                  %mo ∈
                  %mspace{:width => "thickmathspace"}
                  %msub
                    %mi Mat
                    %mrow
                      %mn 6
                      %mo ×
                      %mn 6
                  %mo{:stretchy => "false"} (
                  %mi ℝ
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\big[
                  e^{- \lambda \cdot d_C}
                  \\big]
                  \\;\in\;
                  Mat_{6 \times 6}(\mathbb{R})
          %p
            for the
            %em
              %a.existingWikiWord{:href => "/nlab/show/Cayley+distance+kernel"} Cayley distance kernel
            on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Sym
                    %mo{:stretchy => "false"} (
                    %mn 3
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Sym(3)
            %a.existingWikiWord{:href => "/nlab/show/matrix"} matrix
            which is the
            %a.existingWikiWord{:href => "/nlab/show/exponential"} exponential
            of the
            = succeed "-matrix" do
              %a.existingWikiWord{:href => "/nlab/show/Cayley+distance"} Cayley distance
            %a.maruku-eqref{:href => "#eq:ExplicitCayleyDistanceMatrix"} (1)
            multiplied by
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mi λ
                  %annotation{:encoding => "application/x-tex"} - \lambda
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/eigenvalues"} eigenvalues
            of this matrix are (from
            = succeed ")" do
              %a{:href => "https://www.wolframalpha.com/input/?i=eigenvalues++exp%5B+-+ln%5Bbeta%5D+*++%7B++%7B0%2C1%2C1%2C1+%2C2%2C+2%7D%2C+%7B1%2C+0+%2C+2%2C+2%2C+1%2C+1%7D%2C+%7B1%2C+2%2C+0%2C+2%2C+1%2C+1%7D%2C+%7B1%2C2%2C+2%2C0%2C1%2C+1+%7D%2C+%7B2%2C+1%2C+1%2C+1%2C+0%2C+2+%7D%2C+%7B2%2C1%2C1%2C1%2C2%2C0%7D++%7D+%5D"} here
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mfrac
                    %mrow
                      %msup
                        %mi e
                        %mrow
                          %mn 2
                          %mi λ
                      %mo −
                      %mn 1
                    %mrow
                      %msup
                        %mi e
                        %mrow
                          %mn 2
                          %mi λ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mfrac
                    %mrow
                      %msup
                        %mi e
                        %mrow
                          %mn 2
                          %mi λ
                      %mo ±
                      %mn 3
                      %msup
                        %mi e
                        %mi λ
                      %mo +
                      %mn 2
                    %mrow
                      %msup
                        %mi e
                        %mrow
                          %mn 2
                          %mi λ
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\frac
                  {
                  e^ {2\lambda} -1
                  }
                  {e^ {2\lambda}}
                  \\,,\;\;\;
                  \\frac
                  {
                  e^{2\lambda} \pm 3 e^{\lambda}  + 2
                  }
                  {e^{2\lambda}}
                  \\,,
          %p
            where the first one appears with multiplicity 4 and is
            %a.existingWikiWord{:href => "/nlab/show/positive+number"} positive
            since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                %annotation{:encoding => "application/x-tex"} \lambda
            is positive. The only eigenvalue that can become non-positive for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi λ
                  %mo ∈
                  %msub
                    %mi ℝ
                    %mo +
                %annotation{:encoding => "application/x-tex"} \lambda \in \mathbb{R}_+
            is:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi e
                    %mrow
                      %mn 2
                      %mi λ
                  %mo −
                  %mn 3
                  %msup
                    %mi e
                    %mi λ
                  %mo +
                  %mn 2
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mi is
                  %mspace{:width => "thickmathspace"}
                  %mspace{:width => "thickmathspace"}
                  %mrow
                    %mo {
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mo &lt;
                            %mn 0
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi λ
                            %mo &lt;
                            %mi ln
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo =
                            %mn 0
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi λ
                            %mo =
                            %mi ln
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo &gt;
                            %mn 0
                          %mtd
                            %mo{:stretchy => "false"} |
                          %mtd
                            %mi λ
                            %mo &gt;
                            %mi ln
                            %mo{:stretchy => "false"} (
                            %mn 2
                            %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  e^{2\lambda} - 3 e^\lambda + 2
                  \\;\;is\;\;
                  \\left\{
                  \\array{
                  \\lt 0 &amp;\vert&amp; \lambda \lt ln(2)
                  \\\
                  \= 0 &amp;\vert&amp; \lambda = ln(2)
                  \\\
                  \\gt 0 &amp;\vert&amp; \lambda \gt ln(2)
                  }
                  \\right.
          %p In conclusion:
          %p
            The
            %a.existingWikiWord{:href => "/nlab/show/Cayley+distance+kernel"} Cayley distance kernel
            = succeed "," do
              %a.maruku-eqref{:href => "#eq:CayleyDistanceKernel"} (2)
            %a.existingWikiWord{:href => "/nlab/show/bilinear+form"} bilinear form
            on the
            %a.existingWikiWord{:href => "/nlab/show/linear+span"} linear span
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℝ
                  %mo{:stretchy => "false"} [
                  %mi Sym
                  %mo{:stretchy => "false"} (
                  %mn 3
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \mathbb{R}[Sym(3)]
            is:
          #eq:DefinitenessOfKernelInDependenceOfParameter.maruku-equation
            %span.maruku-eq-number (3)
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mtext indefinite
                        %mtd
                          %mtext for
                        %mtd
                          %mi λ
                          %mo &lt;
                          %mi ln
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mtext positive semi-definite
                        %mtd
                          %mtext for
                        %mtd
                          %mi λ
                          %mo =
                          %mi ln
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mtext positive definite
                        %mtd
                          %mtext for
                        %mtd
                          %mi λ
                          %mo &gt;
                          %mi ln
                          %mo{:stretchy => "false"} (
                          %mn 2
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  \\text{indefinite} &amp; \text{for} &amp; \lambda \lt ln(2)
                  \\\
                  \\text{positive semi-definite} &amp;\text{for}&amp; \lambda = ln(2)
                  \\\
                  \\text{positive definite} &amp;\text{for}&amp;  \lambda \gt ln(2)
                  }
          %p
          #RelationToWeightSystemsOnHorizontalChordDiagrams.num_remark
            %h6 Remark
            %p
              %strong
                (relation to
                %a.existingWikiWord{:href => "/nlab/show/weight+systems"} weight systems
                on
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
              %br/
              Incidentally, the critical value
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi λ
                    %mo =
                    %mi ln
                    %mo{:stretchy => "false"} (
                    %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lambda = ln(2)
              in
              %a.maruku-eqref{:href => "#eq:DefinitenessOfKernelInDependenceOfParameter"} (3)
              is that corresponding to the
              %a.existingWikiWord{:href => "/nlab/show/fundamental+representation"} fundamental
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sl%282%2CC%29"} sl(2,C)
              %a.existingWikiWord{:href => "/nlab/show/Lie+algebra+weight+systems"} Lie algebra weight systems
              on
              %a.existingWikiWord{:href => "/nlab/show/horizontal+chord+diagrams"} horizontal chord diagrams
              (under the canonical identification of the latter with
              %a.existingWikiWord{:href => "/nlab/show/permutations"} permutations
              and using
              %a{:href => "Cayley+distance#CayleyObservation"} Cayley’s observation
              to express
              %a.existingWikiWord{:href => "/nlab/show/Cayley+distance"} Cayley distance
              in terms of numbers of
              = succeed ")," do
                %a.existingWikiWord{:href => "/nlab/show/permutation+cycles"} permutation cycles
              = succeed "." do
                %a.existingWikiWord{:href => "/schreiber/show/Weight+systems+that+are+states"} CSS21
