                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
              is a factorization system.
          .proof
            %h6#proof_3 Proof
            %p
              Write
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                  %annotation{:encoding => "application/x-tex"} \ell
              for the corresponding reflection. Now given
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                      %mo{:lspace => "verythinmathspace"} :
                      %mi A
                      %mo →
                      %mi B
                    %annotation{:encoding => "application/x-tex"} f\colon A\to B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              be the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℓ
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \ell(f)
              along
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi B
                      %mo{:lspace => "verythinmathspace"} :
                      %mi B
                      %mo →
                      %mi ℓ
                      %mi B
                    %annotation{:encoding => "application/x-tex"} \eta_B\colon B \to \ell B
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi Y
                          %mtd
                            %mover
                              %mo →
                              %mi g
                          %mtd
                            %mi ℓ
                            %mi A
                        %mtr
                          %mtd
                            %msup
                              %mo
                              %mi m
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %mi ℓ
                                %mo{:stretchy => "false"} (
                                %mi f
                                %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %munder
                              %mo →
                              %mrow
                                %msub
                                  %mi η
                                  %mi B
                          %mtd
                            %mi ℓ
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{ Y &amp; \overset{g}{\to} &amp; \ell A \\
                    ^m \downarrow &amp; &amp; \downarrow^{\ell(f)}\\
                    B &amp; \underset{\eta_B}{\to} &amp; \ell B}
            %p
              By closure properties of prefactorization systems, any morphism in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} /
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} M/1
              lies in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi M
                    %annotation{:encoding => "application/x-tex"} M
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi M
                    %annotation{:encoding => "application/x-tex"} \ell(f)\in M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              is stable under pullback (being, again, the right class of a prefactorization system), we have
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                      %mo ∈
                      %mi M
                    %annotation{:encoding => "application/x-tex"} m\in M
            %p
              But
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                  %annotation{:encoding => "application/x-tex"} f
              factors through
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi m
                    %annotation{:encoding => "application/x-tex"} m
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              at
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi f
                    %annotation{:encoding => "application/x-tex"} f
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo =
                    %mi m
                    %mi e
                  %annotation{:encoding => "application/x-tex"} f = m e
              and it suffices to show
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ∈
                      %mi E
                    %annotation{:encoding => "application/x-tex"} e\in E
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi g
                      %mi e
                      %mo =
                      %msub
                        %mi η
                        %mi A
                    %annotation{:encoding => "application/x-tex"} g e = \eta_A
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi A
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \eta_A\in E
              by definition, and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi g
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} g\in E
              by assumption (being the pullback of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi η
                      %mi B
                    %mo ∈
                    %mi E
                  %annotation{:encoding => "application/x-tex"} \eta_B\in E
              along
              = succeed ")." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℓ
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo ∈
                      %mi M
                    %annotation{:encoding => "application/x-tex"} \ell(f)\in M
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
              is reflective this implies
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi e
                      %mo ∈
                      %mi E
                    %annotation{:encoding => "application/x-tex"} e\in E
          %p
            A reflection satisfying the condition of Theorem
            %a.maruku-ref{:href => "#SemiLeftExact"}
            is called
            %strong
              %a.existingWikiWord{:href => "/nlab/show/semi-left-exact+reflection"} semi-left-exact
            (which see, for more equivalent characterizations). Note that saying that
            = succeed "-morphisms" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %em all
            pullbacks is equivalent to saying that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                %annotation{:encoding => "application/x-tex"} \ell
            preserves all pullbacks, hence all finite limits—i.e. it is left-exact. In this case the factorization system is called
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/stable+factorization+system"} stable
          %p
            However, semi-left-exactness is not necessary for the “one-step” construction in the proof of Theorem
            %a.maruku-ref{:href => "#SemiLeftExact"}
            to work. The necessary and sufficient condition is that the reflection is
            = succeed ";" do
              %strong simple
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                %annotation{:encoding => "application/x-tex"} f
            is in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                %annotation{:encoding => "application/x-tex"} M
            if and only if its naturality square for the reflector
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi ℓ
                  %mo :
                  %mi C
                  %mo →
                  %mi A
                %annotation{:encoding => "application/x-tex"} \ell:C\to A
            is a pullback. For others, see
            = succeed "." do
              %a{:href => "#CHK"} CHK, Theorem 4.1
          %h3#Localization Relation to localizations
          %p
            For any favorable prefactorization system
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi M
                  %mo{:stretchy => "false"} /
                  %mn 1
                %annotation{:encoding => "application/x-tex"} M/1
            is the
            %a.existingWikiWord{:href => "/nlab/show/localization"} localization
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            at
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi E
                  %mo ′
                  %mo ,
                  %mi M
                  %mo ′
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (E',M')
            is the reflective interior of
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi M
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E,M)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                  %mo ′
                %annotation{:encoding => "application/x-tex"} E'
            is the class of maps inverted by the reflector into
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} /
                    %mn 1
                  %annotation{:encoding => "application/x-tex"} M/1
            %em saturation
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            in the sense of localization (the class of maps inverted by the localization at
            = succeed ")." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                  %annotation{:encoding => "application/x-tex"} E
          %h3#reflective_stable_factorization_systems Reflective stable factorization systems
          %p
            A reflective factorization system on a finitely
            %a.existingWikiWord{:href => "/nlab/show/complete+category"} complete category
            is a
            %a.existingWikiWord{:href => "/nlab/show/stable+factorization+system"} stable factorization system
            if and only if its corresponding
            %a.existingWikiWord{:href => "/nlab/show/reflector"} reflector
            preserves
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/finite+limits"} finite limits
            = succeed "." do
              %strong local
          %h2#examples Examples
          %p
            Obviously, any
            %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
            gives rise to a reflective factorization system. Here are a few examples.
          %ul
            %li
              %p
                The category of complete
                %a.existingWikiWord{:href => "/nlab/show/metric+spaces"} metric spaces
                is reflective in the category of all metric spaces; the reflector is completion. In the corresponding factorization system,
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is the class of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/dense+subspace"} dense embeddings
            %li
              %p
                Given a small
                %a.existingWikiWord{:href => "/nlab/show/site"} site
                = succeed "," do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                      %annotation{:encoding => "application/x-tex"} S
                %a.existingWikiWord{:href => "/nlab/show/sheaf+topos"} sheaf topos
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sh
                      %mo{:stretchy => "false"} (
                      %mi S
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sh(S)
                is a reflective subcategory of the
                %a.existingWikiWord{:href => "/nlab/show/presheaf+topos"} presheaf topos
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Psh
                        %mo{:stretchy => "false"} (
                        %mi S
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Psh(S)
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi E
                    %annotation{:encoding => "application/x-tex"} E
                is the class of
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/local+isomorphisms"} local isomorphisms
          %p On the other hand, many commonly encountered factorization systems are not reflective.
          %ul
            %li
              The factorization system
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi Epi
                    %mo ,
                    %mi Mono
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Epi, Mono)
              on
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
              is not reflective. If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ′
                    %mo ,
                    %mi M
                    %mo ′
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (E',M')
              is its reflective interior, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} E'
              is the class of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} e\colon X\to Y
              such that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/inhabited+set"} inhabited
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo ′
                  %annotation{:encoding => "application/x-tex"} M'
              is the class of morphisms
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                    %mo{:lspace => "verythinmathspace"} :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} m\colon X\to Y
              such that if
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              is inhabited, then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi m
                  %annotation{:encoding => "application/x-tex"} m
              is an isomorphism.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/semi-left-exact+reflection"} semi-left-exact reflection
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/stable+factorization+system"} stable factorization system
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/closure+operator"} closure operator
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/reflective+localization"} reflective localization
          %h2#references References
          %p The basic theory is developed in
          %ul
            %li#CHK
              %p
                C. Cassidy, M. Hébert,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
                = succeed "," do
                  %em Reflective subcategories, localizations, and factorization systems
                %strong 38
                (1985) 287-329 &amp;lbrack;
                %a{:href => "https://doi.org/10.1017/S1446788700023624"}> doi:10.1017/S1446788700023624
                \&amp;rbrack;
            %li#CJKP
              %p
                %a.existingWikiWord{:href => "/nlab/show/Aurelio+Carboni"}> Aurelio Carboni
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/George+Janelidze"} George Janelidze
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Max+Kelly"} Max Kelly
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Robert+Par%C3%A9"} Robert Paré
                = succeed "," do
                  %em On localization and stabilization for factorization systems
                %strong 5
                (1997) 1-58 &amp;lbrack;
                %a{:href => "https://doi.org/10.1023/A:1008620404444"}> doi:10.1023/A:1008620404444
                \&amp;rbrack;
          %p Discussion of “simple” reflective factorization systems and of simultaneously reflective and coreflective factorization systems:
          %ul
            %li#RosickyTholen08
              %a.existingWikiWord{:href => "/nlab/show/Jiri+Rosicky"}> Jiri Rosicky
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Walter+Tholen"} Walter Tholen
              = succeed "," do
                %em Factorization, Fibration and Torsion
              %strong 2
              2 (2007) 295-314 &amp;lbrack;
              %a{:href => "http://arxiv.org/abs/0801.0063"}> arXiv:0801.0063
              ,
              = succeed "&rbrack;" do
                %a{:href => "http://www.emis.de/journals/JHRS/volumes/2007/n2a14/"} publisher
          %p
            Discussion from the perspective of
            %a.existingWikiWord{:href => "/nlab/show/modalities"} modalities
            and
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/modal+homotopy+type+theory"} modal homotopy type theory
          %ul
            %li#RSS
              %a.existingWikiWord{:href => "/nlab/show/Egbert+Rijke"}> Egbert Rijke
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mike+Shulman"} Mike Shulman
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Bas+Spitters"} Bas Spitters
              = succeed "," do
                %em Modalities in homotopy type theory
              %strong 16
              1 (2020) &amp;lbrack;
              %a{:href => "https://arxiv.org/abs/1706.07526"}> arXiv:1706.07526
