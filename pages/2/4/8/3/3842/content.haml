          %p
          #EpimorphismsOfPresheavesAreDetectedObjectwise.num_prop
            %h6 Proposition
            %p
              A morphism
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mover
                      %mo →
                      %mrow
                        %mspace{:width => "thickmathspace"}
                        %mi f
                        %mspace{:width => "thickmathspace"}
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} X \xrightarrow{\;f\;} Y
              of presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ,
                    %mi Y
                    %mspace{:width => "thinmathspace"}
                    %mo ∈
                    %mspace{:width => "thinmathspace"}
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} X,Y \,\in\, PSh(\mathcal{C})
              is an
              %a.existingWikiWord{:href => "/nlab/show/epimorphism"} epimorphism
              or
              %a.existingWikiWord{:href => "/nlab/show/monomorphism"} monomorphism
              precisely if it is so over each
              %a.existingWikiWord{:href => "/nlab/show/object"} object
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi 𝒞
                    %annotation{:encoding => "application/x-tex"} \mathcal{C}
              %a.existingWikiWord{:href => "/nlab/show/surjection"} surjection
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/injection"} injection
          .proof
            %h6 Proof
            %p
              Using for instance the characterization of epimorphisms by
              %a.existingWikiWord{:href => "/nlab/show/pushouts"} pushouts
              (
              %a{:href => "epimorphism#BasicCharacterizationOfEpimorphisms"}> this Prop.
              ) and of monomorphism by
              %a.existingWikiWord{:href => "/nlab/show/pullbacks"} pullbacks
              (
              %a{:href => "monomorphism#BasicCharacterizationOfMonomorphisms"}> this Prop.
              ), the statement follows by Prop.
              = succeed "." do
                %a.maruku-ref{:href => "#LimitsOfPresheavesAreComputedObjectwise"}
          %p
            Now assume that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi 𝒞
                %annotation{:encoding => "application/x-tex"} \mathcal{C}
            is a
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/small+category"} small category
          %p
          .num_prop
            %h6 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(\mathcal{C})
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/cartesian+closed+category"} cartesian closed category
          .proof
            %h6 Proof
            %p
              This is spelled out at
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
          %p
          .num_prop
            %h6 Proposition
            %p
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi 𝒞
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(\mathcal{C})
              is a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/topos"} topos
          .proof
            %h6 Proof
            %p
              This is the base case of
              = succeed "." do
                %em
                  %a.existingWikiWord{:href => "/nlab/show/sheaf+toposes+are+equivalently+the+left+exact+reflective+subcategories+of+presheaf+toposes"} sheaf toposes are equivalently the left exact reflective subcategories of presheaf toposes
          %ul
            %li
              %p
                The category of presheaves
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} PSh(\mathcal{C})
                is the
                %a.existingWikiWord{:href => "/nlab/show/free+cocompletion"} free cocompletion
                of
                = succeed "." do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi 𝒞
                      %annotation{:encoding => "application/x-tex"} \mathcal{C}
            %li
              %p
                the
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+lemma"} Yoneda lemma
                says that the
                %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi j
                      %mo{:lspace => "verythinmathspace"} :
                      %mi 𝒞
                      %mo →
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi 𝒞
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} j \colon \mathcal{C} \to PSh(\mathcal{C})
                is – in particular – a
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/full+and+faithful+functor"} full and faithful functor
            %li
              %p
                The construction of forming (co)-presheaves extends to a
                %a.existingWikiWord{:href => "/nlab/show/2-functor"} 2-functor
              .maruku-equation
                %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ,
                      %mi Set
                      %mo{:stretchy => "false"} ]
                      %mspace{:width => "thickmathspace"}
                      %mo{:lspace => "verythinmathspace"} :
                      %mspace{:width => "thickmathspace"}
                      %mi Cat
                      %mo →
                      %mi Topos
                    %annotation{:encoding => "application/x-tex"}
                      [-,Set] \;\colon\; Cat \to Topos
              %p
                from the
                %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
                %a.existingWikiWord{:href => "/nlab/show/Cat"} Cat
                to the
                %a.existingWikiWord{:href => "/nlab/show/2-category"} 2-category
                = succeed "." do
                  %a.existingWikiWord{:href => "/nlab/show/Topos"} Topos
                %a.existingWikiWord{:href => "/nlab/show/geometric+morphism"} geometric morphism
                the section
                %a{:href => "geometric+morphism#BetweenPresheafToposes"} Between presheaf toposes
                for details.)
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/reflective+subcategory"} reflective subcategory
                of a category of presheaves is a
                %a.existingWikiWord{:href => "/nlab/show/locally+presentable+category"} locally presentable category
                if it is closed under
                = succeed "-" do
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi κ
                      %annotation{:encoding => "application/x-tex"} \kappa
                = succeed "s" do
                  %a.existingWikiWord{:href => "/nlab/show/directed+colimit"} directed colimit
                %a.existingWikiWord{:href => "/nlab/show/regular+cardinal"} regular cardinal
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi κ
                    %annotation{:encoding => "application/x-tex"} \kappa
                (the embedding is an
                = succeed ")." do
                  %a.existingWikiWord{:href => "/nlab/show/accessible+functor"} accessible functor
            %li
              %p
                A
                %a.existingWikiWord{:href => "/nlab/show/geometric+embedding"} sub-topos
                of a category of presheaves is a
                = succeed ":" do
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
                %a.existingWikiWord{:href => "/nlab/show/category+of+sheaves"} category of sheaves
                (see there for details).
          %h3#comonadicity_over_families (Co-)Monadicity over families
          %p
            There is a functor from presheaves to families of sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi U
                  %mo :
                  %mi Psh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %mi Ob
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                  %mo ≅
                  %mi Set
                  %mo{:stretchy => "false"} /
                  %mi Ob
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} U : Psh(C) \to Set^{Ob(C)} \cong Set/Ob(C)
            given by “forgetting” the functorial action on morphisms of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/monadic+functor"} monadic
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/comonadic+functor"} comonadic
          %h3#functoriality Functoriality
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functoriality+of+categories+of+presheaves"} functoriality of categories of presheaves
          %h3#characterization Characterization
          %p
            The following
            %a.existingWikiWord{:href => "/nlab/show/Giraud+theorem"} Giraud like
            theorem stems from
            = succeed ":" do
              %a{:href => "#Bunge66"} Bunge 1966
          #bunge_theorem.num_theorem
            %h6#theorem Theorem
            %p
              A category is equivalent to a presheaf topos if and only if it is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/cocomplete"} cocomplete
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/well-powered+category"} well-powered
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/well-powered+category"} co-well-powered
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/atomic+category"} atomic
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/regular+category"} regular
          %p
            This characterisation was proven for
            %a.existingWikiWord{:href => "/nlab/show/enriched+functor+category"} enriched presheaf categories
            in Theorem 4.16 of
            %a{:href => "#Bunge69"} Bunge 1969
            (Corollary 4.19 for the unenriched statement).
          %p
            In the unenriched case, a much sharper result was later proved in
            = succeed ":" do
              %a{:href => "#Centazzo-Rosický-Vitale04"} Centazzo, Rosický &amp; Vitale 2004
          .num_theorem{:id => "CentazzoRosickýVitale_theorem"}
            %h6#theorem_2 Theorem
            %p A category is equivalent to a presheaf topos if and only if it is cocomplete and atomic.
          %p
            Another characterization, using
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/exact+completion"} exact completions
            %a{:href => "#CarboniVitale98"} Carboni &amp; Vitale 1998
            and in
            = succeed ":" do
              %a{:href => "#Centazzo-Vitale04"} Centazzo &amp; Vitale 2004
          #carboni_vitale_theorem.num_theorem
            %h6#theorem_3 Theorem
            %p
              A category is equivalent to a presheaf topos if and only if it is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/locally+small+category"} locally small
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/extensive+category"} extensive
              %a.existingWikiWord{:href => "/nlab/show/exact+category"} exact
              and has a small set of projective and indecomposable
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/separator"} generators
          %p
            %a{:href => "#CarboniVitale98"} Carboni &amp; Vitale 1998
            also have an interesting comparison to a classical characterization of categories
            %a.existingWikiWord{:href => "/nlab/show/monadic+category"} monadic
            over
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %h3#RelWithOvercategories Presheaves on over-categories and over-categories of presheaves
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            be a
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/category"} category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi c
                %annotation{:encoding => "application/x-tex"} c
            an
            %a.existingWikiWord{:href => "/nlab/show/object"} object
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            and let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi c
                %annotation{:encoding => "application/x-tex"} C/c
            be the
            %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            over
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} [
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi c
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} PSh(C/c) = [(C/c)^{op}, Set]
            for the category of
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                  %mo{:stretchy => "false"} /
                  %mi c
                %annotation{:encoding => "application/x-tex"} C/c
            and write
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} /
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} PSh(C)/Y(c)
            for the
            %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
            of
            %a.existingWikiWord{:href => "/nlab/show/presheaf"} presheaves
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            over the presheaf
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Y(c)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo :
                  %mi C
                  %mo →
                  %mi PSh
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Y : C \to PSh(C)
            is the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Yoneda+embedding"} Yoneda embedding
          %p
            This is explained in more detail at
            = succeed "." do
              %em
                %a.existingWikiWord{:href => "/nlab/show/slice+of+presheaves+is+presheaves+on+slice"} slice of presheaves is presheaves on slice
          #representable_case.num_prop
            %h6#proposition Proposition
            %p
              There is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence"} equivalence
              of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    e : PSh(C/c) \stackrel{\simeq}{\to} PSh(C)/Y(c)
                    \\,.
          .proof
            %h6#proof Proof
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              takes
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in PSh(C/c)
              to the presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo :
                    %mi d
                    %mo ↦
                    %msub
                      %mo ⊔
                      %mrow
                        %mi f
                        %mo ∈
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F' : d \mapsto \sqcup_{f \in C(d,c)} F(f)
              which is equipped with the natural transformation
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi F
                    %mo ′
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \eta : F' \to Y(c)
              with component map
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi η
                        %mi d
                      %msub
                        %mo ⊔
                        %mrow
                          %mi f
                          %mo ∈
                          %mi C
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo ,
                          %mi c
                          %mo{:stretchy => "false"} )
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mi f
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi C
                      %mo{:stretchy => "false"} (
                      %mi d
                      %mo ,
                      %mi c
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \eta_d \sqcup_{f \in C(d,c)} F(f) \to C(d,c)
            %p
              A weak inverse of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi e
                  %annotation{:encoding => "application/x-tex"} e
              is given by the functor
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi e
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\bar e : PSh(C)/Y(c) \to PSh(C/c)
            %p
              which sends
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                    %mo :
                    %mi F
                    %mo ′
                    %mo →
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\eta : F' \to Y(C))
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in PSh(C/c)
              given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo :
                    %mi d
                    %mo →
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ↦
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi c
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    F : (f : d \to c) \mapsto F'(d)|_c
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} |
                      %mi c
                  %annotation{:encoding => "application/x-tex"} F'(d)|_c
              is the
              %a.existingWikiWord{:href => "/nlab/show/pullback"} pullback
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi F
                            %mo ′
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                            %msub
                              %mo{:stretchy => "false"} |
                              %mi c
                          %mtd
                            %mo →
                          %mtd
                            %mi F
                            %mo ′
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mrow
                                %msub
                                  %mi η
                                  %mi d
                        %mtr
                          %mtd
                            %mi pt
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi C
                            %mo{:stretchy => "false"} (
                            %mi d
                            %mo ,
                            %mi c
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    F'(d)|_c &amp;\to&amp; F'(d)
                    \\\
                    \\downarrow &amp;&amp; \downarrow^{\eta_d}
                    \\\
                    pt &amp;\stackrel{f}{\to}&amp; C(d,c)
                    }
                    \\,.
          .un_example
            %h6#example Example
            %p
              Suppose the presheaf
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ∈
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} F \in PSh(C/c)
              does not actually depend on the morphisms to
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %a.existingWikiWord{:href => "/nlab/show/over+category"} over category
              to
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi c
                    %msup
                      %mo{:stretchy => "false"} )
                      %mi op
                    %mo →
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    F : (C/c)^{op} \to C^{op} \to Set
                    \\,.
            %p
              Then
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ⊔
                      %mrow
                        %mi f
                        %mo ∈
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi f
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mo ⊔
                      %mrow
                        %mi f
                        %mo ∈
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi c
                        %mo{:stretchy => "false"} )
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    F'(d) = \sqcup_{f \in C(d,c)} F(f)
                    \= \sqcup_{f \in C(d,c)} F(d)
                    \\simeq
                    C(d,c) \times F(d)
              and hence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo ′
                    %mo =
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F ' = Y(c) \times F
              with respect to the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+structure+on+presheaves"} closed monoidal structure on presheaves
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/functors+and+comma+categories"} functors and comma categories
          %p
            For the analog statement in
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            theory see
          %ul
            %li
              %a{:href => "http://ncatlab.org/nlab/show/(infinity%2C1)-category+of+(infinity%2C1)-presheaves#interaction_with_forming_overcategories_19"} (∞,1)-category of (∞,1)-presheaves – Interaction with overcategories
          .un_remark
            %h6#remark Remark
            %p
              Consider
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo ∫
                      %mi C
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \int_C Y(c)
              , the
              %a.existingWikiWord{:href => "/nlab/show/category+of+elements"} category of elements
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} Y(c):C^{op}\to Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 1
                    %mo ,
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d_1,p_1)
              with
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi p
                        %mn 1
                      %mo ∈
                      %mi Y
                      %mo{:stretchy => "false"} (
                      %mi c
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} (
                      %msub
                        %mi d
                        %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} p_1\in Y(c)(d_1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
              is just an arrow
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi d
                      %mn 1
                    %mo →
                    %mi c
                  %annotation{:encoding => "application/x-tex"} d_1\to c
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 1
                    %mo ,
                    %msub
                      %mi p
                      %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d_1, p_1)
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi d
                      %mn 2
                    %mo ,
                    %msub
                      %mi p
                      %mn 2
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (d_2, p_2)
              is just a map
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo :
                    %msub
                      %mi d
                      %mn 1
                    %mo →
                    %msub
                      %mi d
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} u:d_1\to d_2
              such that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                    %mo ∘
                    %mi u
                    %mo =
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_2\circ u =p_1
              but this is just a morphism from
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 1
                  %annotation{:encoding => "application/x-tex"} p_1
              to
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mn 2
                  %annotation{:encoding => "application/x-tex"} p_2
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo{:stretchy => "false"} /
                      %mi c
                    %annotation{:encoding => "application/x-tex"} C/c
            %p
              Hence, the above proposition
              %a.maruku-ref{:href => "#representable_case"}
              can be rephrased as
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %msub
                      %mo ∫
                      %mi C
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi PSh
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} PSh(\int_C Y(c))\simeq PSh(C)/Y(c)
              which is an instance of the following formula:
          .num_prop
            %h6#proposition_2 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                    %mo :
                    %msup
                      %mi C
                      %mi op
                    %mo →
                    %mi Set
                  %annotation{:encoding => "application/x-tex"} P:C^{op}\to Set
              be a presheaf. Then there is an
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalence of categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi PSh
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mstyle{:displaystyle => "false"}
                      %mrow
                        %msub
                          %mo ∫
                          %mi C
                      %mi P
                      %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                      %mo ≃
                      %mi PSh
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi P
                      %mspace{:width => "thinmathspace"}
                      %mo .
                  %annotation{:encoding => "application/x-tex"}
                    PSh\big(\textstyle{\int_C} P\big) \simeq PSh(C)/P
                    \\,.
          %p
            On objects this takes
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mo{:stretchy => "false"} (
                  %msub
                    %mo ∫
                    %mi C
                  %mi P
                  %msup
                    %mo{:stretchy => "false"} )
                    %mi op
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} F : (\int_C P)^{op} \to Set
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi i
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ∈
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo ,
                  %mi a
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} |
                  %mi p
                  %mo ∈
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi a
                  %mo ∈
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} }
                  %mo =
                  %msub
                    %mi Σ
                    %mrow
                      %mi p
                      %mo ∈
                      %mi P
                      %mo{:stretchy => "false"} (
                      %mi A
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi p
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} i(F)(A \in C) = \{ (p,a) | p \in P(A), a \in F(A,p) \} = \Sigma_{p \in P(A)} F(A,p)
          %p
            with obvious projection to
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi P
                  %annotation{:encoding => "application/x-tex"} P
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi f
                  %mo :
                  %mi Q
                  %mo →
                  %mi P
                %annotation{:encoding => "application/x-tex"} f : Q \to P
            to
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi i
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi f
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo ,
                  %mi p
                  %mo ∈
                  %mi P
                  %mo{:stretchy => "false"} (
                  %mi A
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msubsup
                    %mi f
                    %mi A
                    %mrow
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mn 1
                  %mo{:stretchy => "false"} (
                  %mi p
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"} i^{-1}(f)(A, p \in P(A)) = f_A^{-1}(p)\;.
          %p
            For a proof see
            = succeed "." do
              %a{:href => "#KS06"} Kashiwara-Schapira (2006, Lemma 1.4.12, p. 26)
            = succeed "." do
              %a{:href => "#MacLaneMoerdijk"} Mac Lane-Moerdijk (1994, p.157)
          %p
            In particular, this equivalence shows that
            = succeed "." do
              %em slices of presheaf toposes are presheaf toposes
          %h3#artin_gluings Artin gluings
          %p
            The statements of the preceding
            %a{:href => "#RelWithOvercategories"} subsection
            may be generalized further:
          .num_theorem
            %h6#theorem_4 Theorem
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo :
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi C
                          %mi op
                    %mo →
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi D
                          %mi op
                  %annotation{:encoding => "application/x-tex"} T: Set^{C^{op}} \to Set^{D^{op}}
              be a functor that preserves
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/wide+pullbacks"} wide pullbacks
              %a.existingWikiWord{:href => "/nlab/show/Artin+gluing"} Artin gluing
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi D
                          %mi op
                    %mo{:stretchy => "false"} ↓
                    %mi T
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (Set^{D^{op}} \downarrow T)
              is also a presheaf topos.
          .proof
            %h6#proof_2 Proof
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
              is
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/parametric+right+adjoint"} familially representable
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi D
                      %mi op
                    %mo →
                    %mi Fam
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi C
                          %mi op
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} D^{op} \to Fam(Set^{C^{op}})
              into the small
              %a.existingWikiWord{:href => "/nlab/show/free+coproduct+completion"} coproduct cocompletion
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Set
                        %mrow
                          %msup
                            %mi C
                            %mi op
                    %annotation{:encoding => "application/x-tex"} Set^{C^{op}}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi d
                    %mo ∈
                    %mi Ob
                    %mo{:stretchy => "false"} (
                    %mi D
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} d \in Ob(D)
              to a formal coproduct
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo ∈
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi W
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \sum_{x \in T(1)(d)} W_{(d, x)}
              of presheaves
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi W
                        %mrow
                          %mo{:stretchy => "false"} (
                          %mi d
                          %mo ,
                          %mi x
                          %mo{:stretchy => "false"} )
                      %mo :
                      %msup
                        %mi C
                        %mi op
                      %mo →
                      %mi Set
                    %annotation{:encoding => "application/x-tex"} W_{(d, x)}: C^{op} \to Set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} T(F)
              is given by the formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo =
                    %munder
                      %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∑
                      %mrow
                        %mi x
                        %mo ∈
                        %mi T
                        %mo{:stretchy => "false"} (
                        %mn 1
                        %mo{:stretchy => "false"} )
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo{:stretchy => "false"} )
                    %msup
                      %mi Set
                      %mrow
                        %msup
                          %mi C
                          %mi op
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi W
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo ,
                    %mi F
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} T(F)(d) = \sum_{x \in T(1)(d)} Set^{C^{op}}(W_{(d, x)}, F).
            %p
              The Artin gluing itself is then describable as the presheaf category over the
              %a.existingWikiWord{:href => "/nlab/show/collage"} collage
              of the
              %a.existingWikiWord{:href => "/nlab/show/profunctor"} profunctor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo :
                    %mi C
                    %mo ↛
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi y
                      %mi D
                    %mo{:stretchy => "false"} ↓
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W: C \nrightarrow (y_D \downarrow T(1))
              defined by the formula
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ;
                    %mo{:stretchy => "false"} (
                    %mi d
                    %mo ,
                    %mi x
                    %mo :
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi T
                    %mo{:stretchy => "false"} (
                    %mn 1
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo =
                    %msub
                      %mi W
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi d
                        %mo ,
                        %mi x
                        %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo{:stretchy => "false"} )
                    %mo .
                  %annotation{:encoding => "application/x-tex"} W(c; (d, x: D(-, d) \to T(1))) = W_{(d, x)}(c).
            %p
              For details, see for example Appendix C.3 of
              = succeed "." do
                %a{:href => "#Lein"} Leinster
              = succeed "." do
                %a{:href => "#cj"} Carboni and Johnstone
          %p
            In passing, we note that the small coproduct cocompletion
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fam
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Fam(Set^{C^{op}})
            is itself a presheaf topos: there are
            %a.existingWikiWord{:href => "/nlab/show/equivalence+of+categories"} equivalences
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Fam
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                  %mo{:stretchy => "false"} ↓
                  %mi Δ
                  %mo ≃
                  %msup
                    %mi Set
                    %mrow
                      %msubsup
                        %mi C
                        %mo +
                        %mi op
                %annotation{:encoding => "application/x-tex"} Fam(Set^{C^{op}}) \simeq Set^{C^{op}} \downarrow \Delta \simeq Set^{C_+^{op}}
          %p
            where
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo :
                  %mi Set
                  %mo →
                  %msup
                    %mi Set
                    %mrow
                      %msup
                        %mi C
                        %mi op
                %annotation{:encoding => "application/x-tex"} \Delta: Set \to Set^{C^{op}}
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/diagonal+functor"} diagonal functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi C
                    %mo +
                %annotation{:encoding => "application/x-tex"} C_+
            is the result of freely adjoining an
            %a.existingWikiWord{:href => "/nlab/show/initial+object"} initial object
            to
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
            %a.existingWikiWord{:href => "/nlab/show/ordinal+sum+of+categories"} ordinal sum of categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                  %msub
                    %mo +
                    %mi σ
                  %mi C
                %annotation{:encoding => "application/x-tex"} 1 +_\sigma C
            of categories (
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn 1
                %annotation{:encoding => "application/x-tex"} 1
            being
            = succeed ")," do
              %a.existingWikiWord{:href => "/nlab/show/terminal+object"} terminal
            %a.existingWikiWord{:href => "/nlab/show/cone"} cone
            of
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          %h3#finite_presheaves Finite presheaves
          %p
            A
            %em finite presheaf
            on a category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is a functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi C
                    %mi op
                  %mo →
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} C^{op}\to FinSet
            valued in the
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/FinSet"} category of finite sets
            %a.existingWikiWord{:href => "/nlab/show/Grothendieck+toposes"} Grothendieck toposes
            for want of infinite limits but they still can turn out to be
            %a.existingWikiWord{:href => "/nlab/show/elementary+toposes"} elementary toposes
            as e.g. in the case of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi FinSet
                %annotation{:encoding => "application/x-tex"} FinSet
            itself.
          %p
            By going through the proof that ordinary categories of presheaves are toposes, one observes that the constructions stay within finite presheaves when applied to a finite category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            i.e. one with only a finite set of morphisms. Hence, one has the following
          .num_prop
            %h6#proposition_3 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a finite category. Then the category of finite presheaves
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi C
                      %mi op
                    %mo ,
                    %mi FinSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [C^{op},FinSet]
              is a topos.
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ▪
                  %annotation{:encoding => "application/x-tex"} \qed
          %p
            Note, that the category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo ,
                  %mi FinSet
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [G,FinSet]
            of finite
            = succeed "-sets" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi G
                  %annotation{:encoding => "application/x-tex"} G
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi G
                %annotation{:encoding => "application/x-tex"} G
            is infinite! In this case it is crucial that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Ω
                  %mo =
                  %mo{:stretchy => "false"} {
                  %mi ∅
                  %mo ,
                  %mi G
                  %mo{:stretchy => "false"} }
                %annotation{:encoding => "application/x-tex"} \Omega =\{\emptyset , G\}
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} [
                  %mi G
                  %mo ,
                  %mi Set
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} [G,Set]
            is a finite set.
          %p
            (Cf.
            = succeed ")" do
              %a{:href => "#Borceux3"} Borceux (1994, p.299)
