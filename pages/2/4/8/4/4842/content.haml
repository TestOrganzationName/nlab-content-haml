                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℝ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{R}
              the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              %a.existingWikiWord{:href => "/nlab/show/injection"} injection
              of the
              %a.existingWikiWord{:href => "/nlab/show/real+vector+space"} real vector space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒲
                  %annotation{:encoding => "application/x-tex"} \mathcal{W}
              of
              %a.existingWikiWord{:href => "/nlab/show/framed+weight+systems"} framed weight systems
              %a.maruku-eqref{:href => "#eq:SpaceOfWeightSystemsAsLinearDual"} (?)
              into the
              %a.existingWikiWord{:href => "/nlab/show/real+cohomology"} real cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/based+loop+spaces"} based loop spaces
              of the ordered
              %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
              in 3-
              %a.existingWikiWord{:href => "/nlab/show/dimension"} dimensional
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/Euclidean+space"} Euclidean space
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒲
