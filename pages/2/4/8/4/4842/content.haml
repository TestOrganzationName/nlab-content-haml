              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                    %mo =
                    %mi ℝ
                    %mo ,
                    %mi ℂ
                  %annotation{:encoding => "application/x-tex"} k = \mathbb{R}, \mathbb{C}
              the
              %a.existingWikiWord{:href => "/nlab/show/real+numbers"} real numbers
              or
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/complex+numbers"} complex numbers
              %a.existingWikiWord{:href => "/nlab/show/natural+number"} natural number
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo ∈
                    %mi ℕ
                  %annotation{:encoding => "application/x-tex"} n \in \mathbb{N}
              a canonical
              %a.existingWikiWord{:href => "/nlab/show/linear+isomorphism"} linear isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi 𝒱
