            %a.existingWikiWord{:href => "/nlab/show/Feynman+diagrams"} Feynman diagrams
            in the
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/graph+complex"} graph complex
          %ul
            %li
              %p
                %a{:href => "#Kontsevich93"} Kontsevich 93, Section 5
            %li#AF96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Daniel+Altschuler"}> Daniel Altschuler
                ,
                = succeed "," do
