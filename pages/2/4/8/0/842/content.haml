                            %mo{:stretchy => "false"} )
                            %mo ⋆
                            %mi D
                            %mo ,
                            %mi C
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
