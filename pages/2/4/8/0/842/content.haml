          %h3#WithValInooGrpd
            Limits and colimits with values in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \infty Grpd
          %p
            Limits and colimits over a
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            with values in the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-Grpd"} ∞-Grpd
            of
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
            may be reformulated in terms of the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/universal+fibration+of+%28%E2%88%9E%2C1%29-categories"} universal fibration of (∞,1)-categories
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-Grothendieck+construction"} (∞,1)-Grothendieck construction
          %p
            Let
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            be the
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category"} (∞,1)-category
            of
            = succeed "s." do
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
            %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi Grpd
                  %mo →
                  %mn ∞
                  %msup
                    %mi Grpd
