              be a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
