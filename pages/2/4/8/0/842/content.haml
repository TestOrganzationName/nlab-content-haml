                    \\\
                    \&amp; \simeq {\lim_{\leftarrow}}_r Hom([r], C/X)
                    \\\
                    \&amp; \simeq {\lim_{\leftarrow}}_r Hom_F\big( [r] \star D, C \big)
                    \\\
                    \&amp; \simeq  Hom_F\big({\lim_{\to}}_r ([r] \star D), C \big)
