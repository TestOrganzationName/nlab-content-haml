            %a.existingWikiWord{:href => "/nlab/show/Cartesian+fibration"} coCartesian fibration
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi E
                    %mi F
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} E_F \to X
            classified by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            is the pullback of the
            %a.existingWikiWord{:href => "/nlab/show/universal+fibration+of+%E2%88%9E-groupoids"} universal fibration of ∞-groupoids
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Z
                  %msub
                    %mo{:stretchy => "false"} |
                    %mi Grpd
                %annotation{:encoding => "application/x-tex"} Z|_{Grpd}
            along F:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
