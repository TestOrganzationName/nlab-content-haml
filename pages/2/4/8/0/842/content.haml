                            %mi r
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ←
                              %mi r
                            %msub
                              %mi Hom
                              %mi F
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} [
                            %mi r
                            %mo{:stretchy => "false"} ]
                            %mo ⋆
                            %mi D
                            %mo ,
                            %mi C
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi F
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi r
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi r
                            %mo{:stretchy => "false"} ]
                            %mo ⋆
                            %mi D
                            %mo{:stretchy => "false"} )
                            %mo ,
                            %mi C
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mi Hom
                              %mi F
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %mo{:stretchy => "false"} (
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi r
                            %mo{:stretchy => "false"} [
                            %mi r
