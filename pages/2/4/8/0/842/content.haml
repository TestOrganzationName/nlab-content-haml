                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right
            and
            %a.existingWikiWord{:href => "/nlab/show/left+adjoint"} left
            %a.existingWikiWord{:href => "/nlab/show/adjoint+%28infinity%2C1%29-functor"} adjoint (infinity,1)-functor
            of the constant diagram
            = succeed "-functor," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infinity,1)
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi const
                    %mo :
                    %mi C
                    %mo →
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} const : C \to Func(K,C)
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi colim
                  %mo ⊣
                  %mi const
                  %mo ⊣
                  %mi lim
                  %mo{:stretchy => "false"} )
