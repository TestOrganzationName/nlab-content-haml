          %h3#TermsOfHomotopy In terms of homotopy limits
          %p
            The notion of
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
            %a.existingWikiWord{:href => "/nlab/show/model+categories"} model categories
            and in particular for
            %a.existingWikiWord{:href => "/nlab/show/simplicial+model+categories"} simplicial model categories
            and in fact in all plain
            = succeed "-" do
              %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
            %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
            – as described in more detail at
            %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extension
            – is supposed to be a model for
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            to quasi-categories
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi C
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(C)
            using the
            %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
            functor, homotopy limits should precisely corespond to quasi-categorical limits. That this is indeed the case is asserted by the following statements.
          .num_prop
            %h6#proposition_5 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi J
                  %annotation{:encoding => "application/x-tex"} J
              be
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              %a.existingWikiWord{:href => "/nlab/show/enriched+categories"} enriched categories
              and let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi J
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : J \to C
              be an
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
            %p
              Then a
              %a.existingWikiWord{:href => "/nlab/show/cocone"} cocone
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} {
                    %msub
                      %mi η
                      %mi i
                    %mo :
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi i
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi c
                    %msub
                      %mo{:stretchy => "false"} }
                      %mrow
                        %mi i
                        %mo ∈
                        %mi J
                  %annotation{:encoding => "application/x-tex"} \{\eta_i : F(i) \to c\}_{i \in J}
              under
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              exhibits the object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              as a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              (in the sense discussed in detail at
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extension
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mrow
                        %mi N
                        %mo{:stretchy => "false"} (
                        %mi F
                        %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} ¯
                    %mo :
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi J
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ▹
                    %mo →
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\bar {N(F)} : N(J)^{\triangleright} \to N(C)
            %p
              is a quasi-categorical colimit
              %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} N(C)
          %p
            Here
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                %annotation{:encoding => "application/x-tex"} N
            is the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi J
                  %msup
                    %mo{:stretchy => "false"} )
                    %mo ▹
                %annotation{:encoding => "application/x-tex"} N(J)^{\triangleright}
            the
            %a.existingWikiWord{:href => "/nlab/show/join+of+quasi-categories"} join of quasi-categories
            with the point,
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %mi F
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(F)
            the image of the simplicial functor
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                %annotation{:encoding => "application/x-tex"} F
            under the homotopy coherent nerve and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mrow
                      %mi N
                      %mo{:stretchy => "false"} (
                      %mi F
                      %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} ¯
                %annotation{:encoding => "application/x-tex"} \bar{N(F)}
            its extension to the join determined by the cocone maps
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
          .proof
            %h6#proof_3 Proof
            %p
              This is
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, theorem 4.2.4.1
            %p
              A central ingredient in the proof is the fact, discused at
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-category+of+%28%E2%88%9E%2C1%29-functors"} (∞,1)-category of (∞,1)-functors
              and at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/model+structure+on+functors"} model structure on functors
              = succeed "-" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/enriched+functor"} enriched functor
              = succeed "s," do
                %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-functor"} (∞,1)-functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+simplicial+model+category"} combinatorial simplicial model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              a
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi τ
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \tau(S)
              the corresponding
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi sSet
                    %annotation{:encoding => "application/x-tex"} sSet
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+coherent+nerve"} homotopy coherent nerve
              %a.existingWikiWord{:href => "/nlab/show/equivalence+of+quasi-categories"} equivalence of quasi-categories
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} (
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi A
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mi proj
                    %msup
                      %mo{:stretchy => "false"} )
                      %mo ∘
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi Func
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo ∘
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    N(([C,A]_{proj})^\circ)
                    \\simeq
                    Func(S, N(A^\circ))
            %p
              and the same is trued for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              itself replaced by a
              %span.newWikiWord
                chunk
                %a{:href => "/nlab/new/chunk+of+a+model+category"} ?
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi U
                      %mo ⊂
                      %mi A
                    %annotation{:encoding => "application/x-tex"} U \subset A
            %p
              With this and the discussion at
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extension
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi η
                  %annotation{:encoding => "application/x-tex"} \eta
              induce for each
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo ∈
                    %mo{:stretchy => "false"} [
                    %mi C
                    %mo ,
                    %mi sSet
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} a \in [C,sSet]
              a
              %a.existingWikiWord{:href => "/nlab/show/homotopy+equivalence"} homotopy equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi a
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo →
                      %mrow
                    %mo{:stretchy => "false"} [
                    %msup
                      %mi J
                      %mi op
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} ]
                    %mo{:stretchy => "false"} (
                    %mi j
                    %mi F
                    %mo ,
                    %mi const
                    %mi a
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    C(c,a) \stackrel{}{\to}
                    [J^{op}, C](j F, const a)
            %p
              which is hence equivalently an equivalence of the corresponding
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/hom-object+in+a+quasi-category"} quasi-categorical hom-objects
              = succeed "-hom" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                    %annotation{:encoding => "application/x-tex"} \infty
          .num_cor
            %h6#corollary Corollary
            %p
              The quasi-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi A
                      %mo ∘
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} N(A^\circ)
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28%E2%88%9E%2C1%29-category"} presented
              by a
              %a.existingWikiWord{:href => "/nlab/show/combinatorial+simplicial+model+category"} combinatorial simplicial model category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              has all small quasi-categorical limits and colimits.
          .proof
            %h6#proof_4 Proof
            %p
              This is
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, 4.2.4.8
            %p
              It follows from the fact that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              has (pretty much by definition of
              %a.existingWikiWord{:href => "/nlab/show/model+category"} model category
              and
              = succeed ")" do
                %a.existingWikiWord{:href => "/nlab/show/combinatorial+model+category"} combinatorial model category
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+limit"} homotopy limit
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+colimit"} homotopy colimit
              = succeed "s)" do
                %a.existingWikiWord{:href => "/nlab/show/homotopy+Kan+extension"} homotopy Kan extension
          %p
            Since
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo{:stretchy => "false"} (
                  %msup
                    %mi A
                    %mo ∘
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} N(A^\circ)
            for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi A
                %annotation{:encoding => "application/x-tex"} A
            a
            %a.existingWikiWord{:href => "/nlab/show/combinatorial+simplicial+model+category"} combinatorial simplicial model category
            are precisely the
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/locally+presentable+%28%E2%88%9E%2C1%29-categories"} locally presentable (∞,1)-categories
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h3#CommutativityOfLimits Commutativity of limits
          %p
            The following proposition says that if for an
            = succeed "-functor" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi F
                  %mo :
                  %mi X
                  %mo ×
                  %mi Y
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} F : X \times Y \to C
            limits (colimits) over each of the two variables exist separately, then they commute.
          .num_prop
            %h6#proposition_6 Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                  %annotation{:encoding => "application/x-tex"} X
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} Y
              be
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                    %mo :
                    %msup
                      %mi X
                      %mo ◃
                    %mo ×
                    %msup
                      %mi Y
                      %mo ◃
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p : X^{\triangleleft} \times Y^{\triangleleft} \to C
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            %ol
              %li
                %p
                  for every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi x
                        %mo ∈
                        %msup
                          %mi X
                          %mo ◃
                      %annotation{:encoding => "application/x-tex"} x \in X^{\triangleleft}
                  (including the cone point) the restricted diagram
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi x
                        %mo :
                        %msup
                          %mi Y
                          %mo ◃
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} p_x : Y^{\triangleleft} \to C
                  is a limit diagram;
              %li
                %p
                  for every object
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi y
                        %mo ∈
                        %mi Y
                      %annotation{:encoding => "application/x-tex"} y \in Y
                  (not including the cone point) the restricted diagram
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi p
                          %mi y
                        %mo :
                        %msup
                          %mi X
                          %mo ◃
                        %mo →
                        %mi C
                      %annotation{:encoding => "application/x-tex"} p_y : X^{\triangleleft} \to C
                  is a limit diagram;
            %p
              then, with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              denoting the cone point of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi Y
                        %mo ◃
                    %annotation{:encoding => "application/x-tex"} Y^{\triangleleft}
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi p
                      %mi c
                    %mo :
                    %msup
                      %mi X
                      %mo ◃
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} p_c : X^{\triangleleft} \to C
              is also a limit diagram.
          .proof
            %h6#proof_5 Proof
            %p
              This is
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, lemma 5.5.2.3
          %p
            In other words, suppose that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi lim
                    %mi x
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lim_x F(x,y)
            exists for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi y
                %annotation{:encoding => "application/x-tex"} y
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi lim
                    %mi y
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lim_y F(x,y)
            exists for all
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                %annotation{:encoding => "application/x-tex"} x
            and also that
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi lim
                    %mi y
                  %mo{:stretchy => "false"} (
                  %msub
                    %mi lim
                    %mi x
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mi x
                  %mo ,
                  %mi y
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \lim_y (\lim_x F(x,y))
            exists, then this object is also
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi lim
                      %mi x
                    %msub
                      %mi lim
                      %mi y
                    %mi F
                    %mo{:stretchy => "false"} (
                    %mi x
                    %mo ,
                    %mi y
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} \lim_x \lim_y F(x,y)
          %h2#examples Examples
          %h3#limits_of_special_shape
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mn ∞
                %annotation{:encoding => "application/x-tex"} \infty
            \-Limits of special shape
          %h4#coproduct Coproduct
          %p
            See also at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-coproduct"} (infinity,1)-coproduct
          %p (…)
          %h4#pullback__pushout Pullback / Pushout
          %p
            See also
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-pullback"} (∞,1)-pullback
          %p
            The non-degenerate cells of the
            %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                %annotation{:encoding => "application/x-tex"} \Delta[1] \times \Delta[1]
            obtained as the
            %a.existingWikiWord{:href => "/nlab/show/cartesian+product"} cartesian product
            of the simplicial 1-
            %a.existingWikiWord{:href => "/nlab/show/simplex"} simplex
            with itself look like
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mrow
                    %mtable
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 0
                          %mo{:stretchy => "false"} )
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} ↓
                        %mtd
                          %mo ↘
                        %mtd
                          %mo{:stretchy => "false"} ↓
                      %mtr
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 0
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                        %mtd
                          %mo →
                        %mtd
                          %mo{:stretchy => "false"} (
                          %mn 1
                          %mo ,
                          %mn 1
                          %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\array{
                  (0,0) &amp;\to&amp; (1,0)
                  \\\
                  \\downarrow &amp;\searrow&amp; \downarrow
                  \\\
                  (0,1) &amp;\to&amp; (1,1)
                  }
          %p
            A
            %strong sqare
            in a
            %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            is an image of this in
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi s
                  %mo :
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi C
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  s : \Delta[1] \times \Delta[1] \to C
                  \\,.
          %p
            The simplicial square
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %msup
                    %mo{:stretchy => "false"} ]
                    %mrow
                      %mo ×
                      %mn 2
                %annotation{:encoding => "application/x-tex"} \Delta[1]^{\times 2}
            is
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphic
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join of simplicial sets
            of a 2-
            %a.existingWikiWord{:href => "/nlab/show/horn"} horn
            with the point:
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mo{:stretchy => "false"} {
                  %mi v
                  %mo{:stretchy => "false"} }
                  %mo ⋆
                  %mi Λ
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 2
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi v
                          %mtd
                            %mo →
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mn 2
                    %mo )
                %annotation{:encoding => "application/x-tex"}
                  \\Delta[1] \times \Delta[1]
                  \\simeq
                  \\{v\} \star \Lambda[2]_2
                  \=
                  \\left(
                  \\array{
                  v &amp;\to&amp; 1
                  \\\
                  \\downarrow &amp;\searrow&amp; \downarrow
                  \\\
                  0 &amp;\to&amp; 2
                  }
                  \\right)
          %p and
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mi Λ
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo ⋆
                  %mo{:stretchy => "false"} {
                  %mi v
                  %mo{:stretchy => "false"} }
                  %mo =
                  %mrow
                    %mo (
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mn 0
                          %mtd
                            %mo →
                          %mtd
                            %mn 1
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %mo ↘
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mn 2
                          %mtd
                            %mo →
                          %mtd
                            %mi v
                    %mo )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\Delta[1] \times \Delta[1]
                  \\simeq
                  \\Lambda[2]_0 \star \{v\}
                  \=
                  \\left(
                  \\array{
                  0&amp;\to&amp; 1
                  \\\
                  \\downarrow &amp;\searrow&amp; \downarrow
                  \\\
                  2 &amp;\to&amp; v
                  }
                  \\right)
                  \\,.
          %p
            If a square
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ×
                  %mi Δ
                  %mo{:stretchy => "false"} [
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo ≃
                  %mi Λ
                  %mo{:stretchy => "false"} [
                  %mn 2
                  %msub
                    %mo{:stretchy => "false"} ]
                    %mn 0
                  %mo ⋆
                  %mo{:stretchy => "false"} {
                  %mi v
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \Delta[1] \times \Delta[1] \simeq \Lambda[2]_0 \star \{v\} \to C
            exhibits
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} {
                  %mi v
                  %mo{:stretchy => "false"} }
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} \{v\} \to C
            as a colimit over
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo :
                    %mi Λ
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %msub
                      %mo{:stretchy => "false"} ]
                      %mn 0
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} F : \Lambda[2]_0 \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi v
                  %mo :
                  %mo =
                  %munder
                    %mi lim
                    %mo →
                  %mi F
                  %mo :
                  %mo =
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∐
                    %mrow
                      %mi F
                      %mo{:stretchy => "false"} (
                      %mn 0
                      %mo{:stretchy => "false"} )
                  %mi F
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  v := \lim_\to F := F(1) \coprod_{F(0)} F(2)
          %p
            is
            %a.existingWikiWord{:href => "/nlab/show/generalized+the"} the
            %strong pushout
            of the diagram
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
          %h5#PushoutPasting Pasting law of pushouts
          %p
            We have the following
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a{:href => "http://ncatlab.org/nlab/show/pullback#Pasting"} pasting law of pushouts
            in ordinary
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
          .num_prop
            %h6#proposition_7 Proposition
            %p A pasting diagram of two squares is a morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 2
                    %mo{:stretchy => "false"} ]
                    %mo ×
                    %mi Δ
                    %mo{:stretchy => "false"} [
                    %mn 1
                    %mo{:stretchy => "false"} ]
                    %mo →
                    %mi C
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\Delta[2] \times \Delta[1] \to C
                    \\,.
            %p Schematically this looks like
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi x
                          %mtd
                            %mo →
                          %mtd
                            %mi y
                          %mtd
                            %mo →
                          %mtd
                            %mi z
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi x
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi y
                            %mo ′
                          %mtd
                            %mo →
                          %mtd
                            %mi z
                            %mo ′
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    x &amp;\to&amp; y &amp;\to&amp; z
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    x' &amp;\to&amp; y' &amp;\to&amp; z'
                    }
                    \\,.
            %p
              If the left square is a pushout diagram in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .proof
            %h6#proof_6 Proof
            %p
              A proof appears as
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, lemma 4.4.2.1
          %h4#coequalizer Coequalizer
          %p
            See also at
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/%28infinity%2C1%29-coequalizer"} (infinity,1)-coequalizer
          %p (…)
          %h4#quotients Quotients
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/infinity-quotient"} infinity-quotient
          %h4#Tensoring
            Tensoring and cotensoring with an
            = succeed "-groupoid" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
          %h5#recap_of_the_1categorical_situation Recap of the 1-categorical situation
          %p
            An ordinary
            %a.existingWikiWord{:href => "/nlab/show/category"} category
            with
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/limit"} limit
            %a.existingWikiWord{:href => "/nlab/show/power"} cotensored
            over
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/Set"} Set
          %p
            For
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ,
                  %mi T
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} S, T \in
            %a.existingWikiWord{:href => "/nlab/show/Set"} Set
            and
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi const
                    %mi T
                  %mo :
                  %mi S
                  %mo →
                  %mi Set
                %annotation{:encoding => "application/x-tex"} const_T : S \to Set
            the
            %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
            parameterized by
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            that is constant on
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi T
                  %annotation{:encoding => "application/x-tex"} T
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mo ←
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi const
                    %mi T
                  %mo ≃
                  %msup
                    %mi T
                    %mi S
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  \\lim_{\leftarrow} \, const_T \simeq T^S
                  \\,.
          %p Accordingly the cotensoring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %msup
                    %mo{:stretchy => "false"} )
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                  %mo :
                  %msup
                    %mi Set
                    %mi op
                  %mo ×
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  (-)^{(-)} : Set^{op} \times C \to C
          %p is defined by
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mi c
                    %mi S
                  %mo :
                  %mo =
                  %munder
                    %mi lim
                    %mo ←
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mover
                    %mo →
                    %mrow
                      %msub
                        %mi const
                        %mi c
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo =
                  %munder
                    %mo{:lspace => "thinmathspace", :rspace => "thinmathspace"} ∏
                    %mi S
                  %mi c
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  c^S := \lim_{\leftarrow} (S \stackrel{const_c}{\to} C)
                  \= \prod_{S} c
                  \\,.
          %p
            And by continuity of the
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            this implies the required natural isomorphisms
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %msup
                    %mi c
                    %mi S
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %msub
                    %mrow
                      %munder
                        %mi lim
                        %mo ←
                    %mi S
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mrow
                      %munder
                        %mi lim
                        %mo ←
                    %mi S
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi c
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Set
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi d
                  %mo ,
                  %mi C
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Hom_C(d,c^S) = Hom_C(d, {\lim_{\leftarrow}}_S c) \simeq {\lim_{\leftarrow}}_S
                  Hom_C(d,c) \simeq Set(S,Hom_C(d,C))
                  \\,.
          %p
            Correspondingly if
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            has
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            %a.existingWikiWord{:href => "/nlab/show/copower"} tensoring
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mi Set
                  %mo ×
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  (-) \otimes (-) : Set \times C \to C
          %p
            is given by forming
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊗
                    %mi c
                    %mo :
                    %mo =
                    %msub
                      %mrow
                        %msub
                          %mi lim
                          %mo →
                      %mi S
                    %mi c
                  %annotation{:encoding => "application/x-tex"} S \otimes c := {\lim_{\to}}_S c
            %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
            we have the required natural isomorphism
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ⊗
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mrow
                      %munder
                        %mi lim
                        %mo →
                    %mi S
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mrow
                      %munder
                        %mi lim
                        %mo ←
                    %mi S
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mi Set
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Hom_C(S \otimes c, d) =
                  Hom_C({\lim_{\to}}_S c,d)
                  \\simeq
                  {\lim_{\leftarrow}}_S Hom_C(c,d)
                  
                  \\simeq
                  Set(S,Hom_C(c,d))
                  \\,.
          %p
            Of course all the colimits appearing here are just
            = succeed "s" do
              %a.existingWikiWord{:href => "/nlab/show/coproduct"} coproduct
            = succeed "s," do
              %a.existingWikiWord{:href => "/nlab/show/product"} product
            = succeed "-categories" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
          %h5#definition_3 Definition
          %p
            We expect for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ,
                  %mi T
                  %mo ∈
                %annotation{:encoding => "application/x-tex"} S, T \in
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            and for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi const
                    %mi T
                  %mo :
                  %mi S
                  %mo →
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} const_T : S \to \infty Grpd
            the constant diagram, that
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %munder
                    %mi lim
                    %mo ←
                  %mspace{:width => "thinmathspace"}
                  %msub
                    %mi const
                    %mi T
                  %mo ≃
                  %msup
                    %mi T
                    %mi S
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  \\lim_{\leftarrow} \, const_T \simeq T^S
                  \\,,
          %p
            where on the right we have the
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            of
            = succeed "-groupoids," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn ∞
                  %annotation{:encoding => "application/x-tex"} \infty
            %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model structure on simplicial sets
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi sSet
                    %mi Quillen
                %annotation{:encoding => "application/x-tex"} sSet_{Quillen}
            by the fact that this is a
            %a.existingWikiWord{:href => "/nlab/show/closed+monoidal+category"} closed
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/monoidal+category"} monoidal category
          %p
            Correspondingly, for
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi C
                %annotation{:encoding => "application/x-tex"} C
            an
            = succeed "-category" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/copower"} tensored
            over
            %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
            by setting
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo ⊗
                  %mo{:stretchy => "false"} (
                  %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                  %mo{:stretchy => "false"} )
                  %mo :
                  %mn ∞
                  %mi Grpd
                  %mo ×
                  %mi C
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"}
                  (-)\otimes (-) : \infty Grpd \times C \to C
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                  %mo ⊗
                  %mi c
                  %mo :
                  %mo =
                  %msub
                    %mrow
                      %munder
                        %mi lim
                        %mo →
                    %mi S
                  %mi c
                  %mspace{:width => "thinmathspace"}
                  %mo ,
                %annotation{:encoding => "application/x-tex"}
                  S \otimes c := {\lim_{\to}}_S c
                  \\,,
          %p
            where now on the right we have the
            = succeed "-categorical" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi const
                  %mo :
                  %mi S
                  %mo →
                  %mi C
                %annotation{:encoding => "application/x-tex"} const : S \to C
            of shape
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi S
                %annotation{:encoding => "application/x-tex"} S
            on
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
          %p
            Then by the
            = succeed "-continuity" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/internal+hom"} internal hom
            in
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mn ∞
                  %mi Grpd
                %annotation{:encoding => "application/x-tex"} \infty Grpd
            we have the required natural equivalence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ⊗
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo =
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %msub
                    %mrow
                      %munder
                        %mi lim
                        %mo →
                    %mi S
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msub
                    %mrow
                      %munder
                        %mi lim
                        %mo ←
                    %mi S
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %mn ∞
                  %mi Grpd
                  %mo{:stretchy => "false"} (
                  %mi S
                  %mo ,
                  %msub
                    %mi Hom
                    %mi C
                  %mo{:stretchy => "false"} (
                  %mi c
                  %mo ,
                  %mi d
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thinmathspace"}
                  %mo .
                %annotation{:encoding => "application/x-tex"}
                  Hom_C(S \otimes c, d)
                  \=
                  Hom_C({\lim_{\to}}_S c, d)
                  \\simeq
                  {\lim_{\leftarrow}}_S Hom_C(c,d)
                  \\simeq
                  \\infty Grpd(S,Hom_C(c,d))
                  \\,.
          %p The following proposition should assert that this is all true
          #TensoringProposition.num_prop
            %h6#proposition_8 Proposition
            %p
              The
              = succeed "-categorical" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %msub
                        %mi lim
                        %mo →
                    %mi c
                  %annotation{:encoding => "application/x-tex"} {\lim_{\to}} c
              over the diagram of shape
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mn ∞
                    %mi Grpd
                  %annotation{:encoding => "application/x-tex"} S \in \infty Grpd
              constant on
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              is characterized by the fact that it induces natural equivalences
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mi S
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    Hom_C({\lim_{\to}}_S c, d)
                    \\simeq
                    \\infty Grpd(S, Hom_C(c,d))
            %p
              for all
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi d
                      %mo ∈
                      %mi C
                    %annotation{:encoding => "application/x-tex"} d \in C
          %p
            This is essentially
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, corollary 4.4.4.9
          #EveryInfinityGroupoidIsHomotopyColimitOfConstantFunctorOverItself.num_cor
            %h6#corollary_2 Corollary
            %p
              Every
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoid"} ∞-groupoid
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                  %annotation{:encoding => "application/x-tex"} S
              is the
              = succeed "-colimit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              of the constant diagram on the
              %a.existingWikiWord{:href => "/nlab/show/point"} point
              over itself:
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ≃
                    %msub
                      %mrow
                        %munder
                          %mi lim
                          %mo →
                      %mi S
                    %msub
                      %mi const
                      %mo *
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \simeq {\lim_{\to}}_S const_*
                    \\,.
          %p This justifies the following definition
          .num_defn
            %h6#definition_4 Definition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              an
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %strong
                tensoring of
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
                over
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mn ∞
                      %mi Grpd
                    %annotation{:encoding => "application/x-tex"} \infty Grpd
              is the
              = succeed "-functor" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ⊗
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mn ∞
                    %mi Grpd
                    %mo ×
                    %mi C
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"}
                    (-) \otimes (-) : \infty Grpd \times C \to C
            %p given by
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ⊗
                    %mi c
                    %mo =
                    %munder
                      %mi lim
                      %mo →
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi const
                      %mi c
                    %mo :
                    %mi S
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    S \otimes c = \lim_{\to} (const_c : S \to C)
                    \\,.
          %p
            See
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/Higher+Topos+Theory"} HTT, section 4.4.4
          %h5#ModelsForTensoring Models
          %p
            We discuss models for
            = succeed "-(co)limits" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
            %a.existingWikiWord{:href => "/nlab/show/category+theory"} category theory
            and
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+theory"} homotopy theory
          %p
          .num_lemma
            %h6 Lemma
            %p
              If
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              is
              %a.existingWikiWord{:href => "/nlab/show/presentable+%28infinity%2C1%29-category"} presented
              by a
              %a.existingWikiWord{:href => "/nlab/show/simplicial+model+category"} simplicial model category
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                    %annotation{:encoding => "application/x-tex"} A
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                      %mo ≃
                      %msup
                        %mi A
                        %mo ∘
                    %annotation{:encoding => "application/x-tex"} C \simeq A^\circ
              = succeed "-tensoring" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "-cotensoring" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              over
              %a.existingWikiWord{:href => "/nlab/show/%E2%88%9EGrpd"} ∞Grpd
              is modeled by the ordinary
              %a.existingWikiWord{:href => "/nlab/show/copower"} tensoring
              and
              %a.existingWikiWord{:href => "/nlab/show/power"} powering
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              over
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ∈
                    %mi A
                  %annotation{:encoding => "application/x-tex"} \hat c \in A
              cofibant and representing an object
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %mi C
                  %annotation{:encoding => "application/x-tex"} c \in C
              and for
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi S
                    %mo ∈
                    %mi sSet
                  %annotation{:encoding => "application/x-tex"} S \in sSet
              any simplicial set, we have an equivalence
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ⊗
                    %mi S
                    %mo ≃
                    %mover
                      %mi C
                      %mo{:stretchy => "false"} ^
                    %mo ⋅
                    %mi S
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    c \otimes S \simeq \hat C \cdot S
                    \\,.
            %p
          .proof
            %h6#proof_7 Proof
            %p
              The powering in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi A
                  %annotation{:encoding => "application/x-tex"} A
              satisfies the
              %a.existingWikiWord{:href => "/nlab/show/natural+isomorphism"} natural isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi sSet
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ,
                    %mover
                      %mi d
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mi A
                    %mo{:stretchy => "false"} (
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                    %mo ⋅
                    %mi S
                    %mo ,
                    %mover
                      %mi d
                      %mo{:stretchy => "false"} ^
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    sSet(S,A(\hat c,\hat d)) \simeq A(\hat c \cdot S, \hat d)
            %p
              in
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/sSet"} sSet
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi c
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat c
              a cofibrant and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mover
                      %mi d
                      %mo{:stretchy => "false"} ^
                  %annotation{:encoding => "application/x-tex"} \hat d
              a fibrant representative, we have that both sides here are
              = succeed "es" do
                %a.existingWikiWord{:href => "/nlab/show/Kan+complex"} Kan complex
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/derived+hom+space"} derived hom space
              = succeed "-category" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ⋅
                    %mi S
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo ≃
                    %mn ∞
                    %mi Grpd
                    %mo{:stretchy => "false"} (
                    %mi S
                    %mo ,
                    %msub
                      %mi Hom
                      %mi C
                    %mo{:stretchy => "false"} (
                    %mi c
                    %mo ,
                    %mi d
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    Hom_C(c \cdot S, d)
                    \\simeq
                    \\infty Grpd(S, Hom_C(c,d))
                    \\,.
            %p The claim then follows from the above proposition.
          %h3#InOvercategories
            Limits in over-
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mn ∞
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (\infty,1)
            \-categories
          .num_prop
            %h6#proposition_9 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              an
              = succeed "-category," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo{:lspace => "verythinmathspace"} :
                    %mi D
                    %mo →
                    %mi C
                  %annotation{:encoding => "application/x-tex"} X \colon D \to C
              a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/diagram"} diagram
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C/X
              the
              %a.existingWikiWord{:href => "/nlab/show/over-%28%E2%88%9E%2C1%29-category"} over-(∞,1)-category
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                    %mo{:lspace => "verythinmathspace"} :
                    %mi K
                    %mo →
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} F \colon K \to C/X
              a diagram in the over-
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mn ∞
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (\infty,1)
              \-category, then the
              %a.existingWikiWord{:href => "/nlab/show/%28%E2%88%9E%2C1%29-limit"} (∞,1)-limit
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo ←
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \underset{\leftarrow}{\lim} F
              in
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C/X
              coincides with the
              = succeed "-limit" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mn ∞
                      %mo ,
                      %mn 1
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} (\infty,1)
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo ←
                    %mi F
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} \underset{\leftarrow}{\lim} F/X
              in
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi C
                    %annotation{:encoding => "application/x-tex"} C
          .proof
            %h6#proof_8 Proof
            %p
              Modelling
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                  %annotation{:encoding => "application/x-tex"} C
              as a
              %a.existingWikiWord{:href => "/nlab/show/quasi-category"} quasi-category
              we have that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                  %annotation{:encoding => "application/x-tex"} C/X
              is given by the
              %a.existingWikiWord{:href => "/nlab/show/simplicial+set"} simplicial set
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⋆
                    %mi D
                    %mo ,
                    %mi C
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    C/X
                    \\;\colon\;
                    [n] \mapsto Hom_X\big([n] \star D, C\big)
                    \\,,
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ⋆
                  %annotation{:encoding => "application/x-tex"} \star
              denotes the
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/join+of+simplicial+sets"} join of simplicial sets
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi lim
                      %mo ←
                    %mi F
                  %annotation{:encoding => "application/x-tex"} \underset{\leftarrow}{\lim} F
              is the terminal object in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} (
                      %mi C
                      %mo{:stretchy => "false"} /
                      %mi X
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} /
                      %mi F
                    %annotation{:encoding => "application/x-tex"} (C/X)/F
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} /
                    %mi F
                    %mspace{:width => "thickmathspace"}
                    %mo{:lspace => "verythinmathspace"} :
                    %mspace{:width => "thickmathspace"}
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ↦
                    %msub
                      %mi Hom
                      %mi F
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mo{:stretchy => "false"} [
                    %mi n
                    %mo{:stretchy => "false"} ]
                    %mo ⋆
                    %mi K
                    %mo ,
                    %mi C
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    (C/X)/F
                    \\;\colon\;
                    [n] \mapsto Hom_{F}\big([n] \star K, C/X\big)
                    \\,.
            %p
              Since the join
              %a.existingWikiWord{:href => "/nlab/show/preserved+colimit"} preserves
              %a.existingWikiWord{:href => "/nlab/show/colimits"} colimits
              of simplicial sets in both arguments, we can apply the
              %a.existingWikiWord{:href => "/nlab/show/co-Yoneda+lemma"} co-Yoneda lemma
              to decompose
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mo{:stretchy => "false"} [
                      %mi n
                      %mo{:stretchy => "false"} ]
                      %mo ⋆
                      %mi K
                      %mo =
                      %munder
                        %mi lim
                        %munder
                          %mo →
                          %mrow
                            %mo{:stretchy => "false"} [
                            %mi r
                            %mo{:stretchy => "false"} ]
                            %mo →
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ⋆
                            %mi K
                      %mo{:stretchy => "false"} [
                      %mi r
                      %mo{:stretchy => "false"} ]
                    %annotation{:encoding => "application/x-tex"} [n] \star K = \underset{\underset{{[r] \to [n]\star K}}{\to}}{\lim} [r]
              %a.existingWikiWord{:href => "/nlab/show/hom-functor"} hom-functor
              %a.existingWikiWord{:href => "/nlab/show/hom-functor+preserves+limits"} sends colimits in the first argument to limits
              and obtain
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable{:columnalign => "right left right left right left right left right left", :columnspacing => "0em", :displaystyle => "true"}
                        %mtr
                          %mtd
                            %mi Hom
                            %mo{:stretchy => "false"} (
                            %mo{:stretchy => "false"} [
                            %mi n
                            %mo{:stretchy => "false"} ]
                            %mo ⋆
                            %mi K
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ≃
                            %mi Hom
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo →
                              %mi r
                            %mo{:stretchy => "false"} [
                            %mi r
                            %mo{:stretchy => "false"} ]
                            %mo ,
                            %mi C
                            %mo{:stretchy => "false"} /
                            %mi X
                            %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                        %mtr
                          %mtd
                          %mtd
                            %mo ≃
                            %msub
                              %mrow
                                %munder
                                  %mi lim
                                  %mo ←
                              %mi r
                            %mi Hom
                            %mo{:stretchy => "false"} (
