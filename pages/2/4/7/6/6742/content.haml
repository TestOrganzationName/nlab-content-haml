          %p (Posted on behalf of Jim Stasheff, needs a little polishing before announcing.)
          #sectiona.num_subsection
          %h3#the_pentagonal_algebra_of_open_string_field_theory.num_subsection The pentagonal algebra of open string field theory
          %p
            One version of an open string in physics is a geometric object - something like an oriented arc in a Riemannian manifold
            = succeed "." do
              %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi M
                    %mo ,
                    %mi g
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (M, g)
          %p Fig. 3.
          %h4#e_endpoint_interaction E: endpoint interaction
          %p
            Here we are dealing with a space of maps
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Map
                  %mo{:stretchy => "false"} (
                  %mi I
                  %mo ,
                  %mi M
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} Map(I, M)
            where
            = succeed "." do
              %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi I
                    %mo =
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mn 1
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} I = [0, 1]
            = succeed ".)" do
              %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} [
                    %mn 0
                    %mo ,
                    %mi π
                    %mo{:stretchy => "false"} ]
                  %annotation{:encoding => "application/x-tex"} [0, \pi ]
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            requires a reparameterization; define
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_6.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo +
                  %mi Y
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 1
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} X + Y :[0, 1] \to M
            by
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mtext for
                  %mi t
                  %mo ≤
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                %annotation{:encoding => "application/x-tex"} X(2t) \text{for} t \leq 1/2
            and
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mn 2
                  %mi t
                  %mo −
                  %mn 1
                  %mo{:stretchy => "false"} )
                  %mtext for
                  %mn 1
                  %mo{:stretchy => "false"} /
                  %mn 2
                  %mo ≤
                  %mi t
                  %mo ≤
                  %mn 1
                  %mo .
                %annotation{:encoding => "application/x-tex"} Y(2t-1) \text{for} 1/2 \leq t \leq 1.
            This operation failed to have units, inverses or associativity, though all were present “up to homotopy”.
          %p
            So as to restore associativity, we follow J. C. Moore [?] and consider the space PM of parametrized paths
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi M
                  %mo .
                %annotation{:encoding => "application/x-tex"} X : [0, r] \to M.
            (Fixing r can be regarded as a (partial) choice of ‘gauge’.) Now we define the endpoint joining operation
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∨
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \vee Y
            for for paths
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ,
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X,Y
            such that
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mn 0
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X(r) = Y(0)
            so that
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ∨
                  %mi Y
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mi r
                  %mo +
                  %mi s
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} X \vee Y : [0, r + s] \to M
            by
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mtext for
                  %mn 0
                  %mo ≤
                  %mi t
                  %mo ≤
                  %mi r
                %annotation{:encoding => "application/x-tex"} X(t) \text{for} 0\leq t \leq r
            and
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo −
                  %mi r
                  %mo{:stretchy => "false"} )
                  %mtext for
                  %mi r
                  %mo ≤
                  %mi t
                  %mo ≤
                  %mi r
                  %mo +
                  %mi s
                  %mo .
                %annotation{:encoding => "application/x-tex"} Y(t-r) \text{for} r\leq t\leq r+s.
            This operation is associative where defined and has units
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_16.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi x
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi M
                  %mo ,
                %annotation{:encoding => "application/x-tex"} x : [0,0] \to M,
            but has inverses only up to homotopy.
          %p
            Conversely, splitting of the picture of a string at an arbitrary point led naturally to the use of parametrized paths
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mi r
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} X : [0, r] \to M
            and to what are known as 4-point functions in physics. This splitting rather than combining paths seems to have occurred first in physics in the work of Kaku and Kikkawa [?]. Although couched in the physics language of light-cone Feynman diagrams, channels, Lagrangians, etc., they remark:
          %blockquote
            %p the four-string interaction corresponds to the continuous defomation of the t-channel topology into the u-channel topology…([?], p.1124),
          %p
            in other words, an associating homotopy. In considering multiple string interactions, they remark that the number of relevant light-cone Feynman diagrams is equal to the number of non-crossing triangulations of a convex
            = succeed "-gon," do
              %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            = succeed "-dimensional" do
              %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                    %mo −
                    %mn 3
                  %annotation{:encoding => "application/x-tex"} N-3
            = succeed "-point" do
              %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi N
                  %annotation{:encoding => "application/x-tex"} N
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_21.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi N
                  %mo &gt;
                  %mn 4
                  %mo .
                %annotation{:encoding => "application/x-tex"} N\gt 4.
            Translation:the pentagonal condition is satisfied on the nose, no need for higher homotopies.
          %h4#m_midpoint_or_half_overlap_interaction M: midpoint or half overlap interaction
          %p Here when the latter half of one path is the same as the first half of the second path but with reversed orientation, the interaction produces a third path by ‘cancelling’ the overlapping halves. The picture is symmetric with respect to cyclic permutations and is so interpreted.
          %p The endpoint case E is familiar in mathematics as far back as the study of the fundamental group; the midpoint case M was considered by Witten in 1986 [?] for string field theory, although in fact it had been considered independently in mathematics by Lashof [?] in 1956.
          %h4#v_variable_overlap_interaction V: variable overlap interaction
          %p
            But if overlapping halves can be cancelled, why not vary the portion that is cancelled? This idea seems to have occurred first in physics in the work of Kaku [?], although it follows from an interpretation of the HIKKO
            %sup#fnref:1
              %a{:href => "#fn:1", :rel => "footnote"} 1
            interaction [?] of open string field theory. This (independently) uses Moore’s associative endpoint interaction, but then creates inverses by cancellation as in the midpoint case. (see also the work of Kaku [?]). From the physicist’s symmetrical point of view, this picture also gives inverses in the endpoint gauge by reversing orientation and cancellation of a portion of one string by all of another.
          %p FIGURE
          %p
            This variable overlap joining V of paths is given by the operation
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_22.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⋆
                  %mi Y
                %annotation{:encoding => "application/x-tex"} X \star Y
            defined as follows: Let
            = succeed "," do
              %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_23.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi u
                    %mo =
                    %mtext max
                    %mo{:stretchy => "false"} {
                    %mi r
                    %mtext such that
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mo =
                    %mi X
                    %mo{:stretchy => "false"} (
                    %mi r
                    %mo −
                    %mi t
                    %mo{:stretchy => "false"} )
                    %mtext for
                    %mn 0
                    %mo ≤
                    %mi t
                    %mo ≤
                    %mi r
                    %mo{:stretchy => "false"} }
                  %annotation{:encoding => "application/x-tex"} u = \text{max} \{ r \text{such that} Y(t) = X(r-t) \text{for} 0 \leq t \leq r\}
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_24.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⋆
                  %mi Y
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mi r
                  %mo +
                  %mi s
                  %mo −
                  %mn 2
                  %mi u
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} X \star Y: [0, r+s-2u] \to M
            by
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_25.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mtext for
                  %mn 0
                  %mo ≤
                  %mi t
                  %mo ≤
                  %mi r
                  %mo −
                  %mi u
                %annotation{:encoding => "application/x-tex"} X(t ) \text{for} 0\leq t \leq r-u
            and
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_26.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi Y
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo −
                  %mi r
                  %mo +
                  %mn 2
                  %mi u
                  %mo{:stretchy => "false"} )
                  %mtext for
                  %mi r
                  %mo −
                  %mi u
                  %mo ≤
                  %mi t
                  %mo ≤
                  %mi r
                  %mo +
                  %mi s
                  %mo −
                  %mn 2
                  %mi u
                  %mo .
                %annotation{:encoding => "application/x-tex"} Y(t-r+2u) \text{for} r-u\leq t\leq r+s-2u.
            Again
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_27.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi m
                  %mo :
                  %mo{:stretchy => "false"} [
                  %mn 0
                  %mo ,
                  %mn 0
                  %mo{:stretchy => "false"} ]
                  %mo →
                  %mi M
                %annotation{:encoding => "application/x-tex"} m: [0, 0] \to M
            is a unit, and the reversal
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_28.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mover
                    %mi X
                    %mo{:stretchy => "false"} ¯
                  %mo{:stretchy => "false"} (
                  %mi t
                  %mo{:stretchy => "false"} )
                  %mo =
                  %mi X
                  %mo{:stretchy => "false"} (
                  %mi r
                  %mo −
                  %mi t
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} \bar{X}(t) = X(r - t)
            provides a strict inverse, but now
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_29.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            occasionally fails to be associative; there is a hidden destruction of associativity in what HIKKO refer to as ‘horn’ diagrams. for example in the configuration of Fig.
            %a.maruku-ref{:href => "#horn"}
          %p
            On the other hand,
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_30.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ⋆
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ⋆
                  %mi Z
                %annotation{:encoding => "application/x-tex"} (X \star Y) \star Z
            and
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_31.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                  %mo ⋆
                  %mo{:stretchy => "false"} (
                  %mi Y
                  %mo ⋆
                  %mi Z
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} X \star (Y\star Z)
            are clearly homotopic - just gradually shrink the back-and-forth part of
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_32.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo ⋆
                  %mi Y
                  %mo{:stretchy => "false"} )
                  %mo ⋆
                  %mi Z
                %annotation{:encoding => "application/x-tex"} (X \star Y) \star Z
            \- and hence
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_33.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            is homotopy associative. Denote such a homotopy
            = succeed "." do
              %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ⋆
                    %mi Y
                    %mo ⋆
                    %mi Z
                  %annotation{:encoding => "application/x-tex"} X \star Y \star Z
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_35.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mn 2
                %annotation{:encoding => "application/x-tex"} m_{2}
            and
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_36.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msub
                    %mi m
                    %mn 3
                %annotation{:encoding => "application/x-tex"} m_{3}
            in defining an
            = succeed "-algebra," do
              %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_37.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi A
                      %mn ∞
                  %annotation{:encoding => "application/x-tex"} A_{\infty }
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_38.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star \star
            with
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_39.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo ⋆
                %annotation{:encoding => "application/x-tex"} \star
            on
            %math#mathml_ce72e4d79f17c4f127d9670317d3f85d4968e112_40.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
