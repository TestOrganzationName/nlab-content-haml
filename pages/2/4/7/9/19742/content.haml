            %h6#proposition_6 Proposition
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary
              %a.existingWikiWord{:href => "/nlab/show/cohomology+ring"} cohomology ring
              of the
              %a.existingWikiWord{:href => "/nlab/show/classifying+space"} classifying space
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 8
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} B Spin(8)
              is:
            %p
              %strong 1)
              with
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in the
              = succeed ":" do
                %a.existingWikiWord{:href => "/nlab/show/cyclic+group+of+order+2"} cyclic group of order 2
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                    %mi B
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 8
                    %mo{:stretchy => "false"} )
                    %mo ,
                    %msub
                      %mi ℤ
                      %mn 2
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                    %mspace{:width => "thickmathspace"}
                    %mo ≃
                    %mspace{:width => "thickmathspace"}
                    %mi ℤ
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} [
                    %msub
                      %mi w
                      %mn 4
                    %mo ,
                    %msub
                      %mi w
                      %mn 6
                    %mo ,
                    %msub
                      %mi w
                      %mn 7
                    %mo ,
                    %msub
                      %mi w
                      %mn 8
                    %mo ,
                    %mspace{:width => "thickmathspace"}
                    %msub
                      %mi ρ
                      %mn 2
                    %mrow
                      %mo (
                      %mstyle{:displaystyle => "false"}
                        %mfrac
                          %mn 1
                          %mn 4
                      %mrow
                        %mo (
                        %msub
                          %mi p
                          %mn 2
                        %mo −
                        %mo{:maxsize => "1.2em", :minsize => "1.2em"} (
                        %mstyle{:displaystyle => "false"}
                          %mfrac
                            %mn 1
                            %mn 2
                        %msub
                          %mi p
                          %mn 1
                        %msup
                          %mo{:maxsize => "1.2em", :minsize => "1.2em"} )
                          %mn 2
                        %mo −
                        %mn 2
                        %mi χ
                        %mo )
                      %mo )
                    %mo{:maxsize => "1.2em", :minsize => "1.2em"} ]
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet
                    \\big(
                    B Spin(8), \mathbb{Z}_2
                    \\big)
                    \\;\simeq\;
                    \\mathbb{Z}
                    \\big[
                    w_4, w_6, w_7, w_8,
                    \\;
                    \\rho_2
                    \\left(
                    \\tfrac{1}{4}
                    \\left(
                    p_2
                    \-
                    \\big(\tfrac{1}{2}p_1\big)^2
                    \-
                    2 \chi
                    \\right)
                    \\right)
                    \\big]
            %p
              where
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi w
                      %mi i
                  %annotation{:encoding => "application/x-tex"} w_i
              are the
              %a.existingWikiWord{:href => "/nlab/show/universal+characteristic+class"} universal
              = succeed "," do
