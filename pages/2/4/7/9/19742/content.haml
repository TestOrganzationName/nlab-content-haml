          #Spin3DotSpin5SubgroupsInSpin8.num_prop
            %h6#proposition_5 Proposition
            %p
              %strong
                (
                %a.existingWikiWord{:href => "/nlab/show/Spin%285%29.Spin%283%29"}> Spin(5).Spin(3)
                \-
                %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
                in
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/show/Spin%288%29"} Spin(8)
            %p
              The groups
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Spin%285%29.Spin%283%29"} Spin(5).Spin(3)
              %a.existingWikiWord{:href => "/nlab/show/Sp%282%29.Sp%281%29"} Sp(2).Sp(1)
              and
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi Sp
                      %mo{:stretchy => "false"} (
                      %mn 1
                      %mo{:stretchy => "false"} )
                      %mo ⋅
                      %mi Sp
                      %mo{:stretchy => "false"} (
                      %mn 2
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} Sp(1) \cdot Sp(2)
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Spin%288%29"} Spin(8)
              %a.existingWikiWord{:href => "/nlab/show/conjugacy+classes+of+subgroups"} conjugacy classes
              of
              %a.existingWikiWord{:href => "/nlab/show/subgroups"} subgroups
              inside
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Spin%288%29"} Spin(8)
              %a.existingWikiWord{:href => "/nlab/show/triality"} triality
              group
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Out
                    %mo{:stretchy => "false"} (
                    %mi Spin
                    %mo{:stretchy => "false"} (
                    %mn 8
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Out(Spin(8))
              %a.existingWikiWord{:href => "/nlab/show/action"} acts
              %a.existingWikiWord{:href => "/nlab/show/transitive+action"} transitively
              on these three classes.
