                %a{:href => "http://dx.doi.org/10.2178/jsl/1203350779"} doi
            %li
              %p
                Margarita Otero,
                = succeed "," do
                  %em A survey on groups definable in o-minimal structures
                = succeed "," do
                  %strong 350
                = succeed "," do
                  %a{:href => "https://www.ams.org/mathscinet-getitem?mr=2436142"} MR2010b:03042
                %a{:href => "https://doi.org/10.1017/CBO9780511735219.006"} doi
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Ehud+Hrushovski"}> Ehud Hrushovski
                ,
                %em Groupoids, imaginaries and internal covers
                Turk. J. Math 36 (2012) 173 – 198
                %a{:href => "https://doi.org/10.3906/mat-1001-91"} doi
                %a{:href => "https://arxiv.org/abs/math/0603413"} arxiv/math.LO/0603413
