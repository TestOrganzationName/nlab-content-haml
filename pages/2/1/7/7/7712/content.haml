        #revision
          %p This entry is about a section of the text
          %ul
            %li
              Michel
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Demazure%2C+lectures+on+p-divisible+groups"} Demazure, lectures on p-divisible groups
              %a{:href => "http://sites.google.com/site/mtnpdivisblegroupsworkshop/lecture-notes-on-p-divisible-groups"} web
          %p
            Let
            %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_1.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi k
                %annotation{:encoding => "application/x-tex"} k
            be a perfect field of prime characteristic
            = succeed "." do
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_2.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi p
                  %annotation{:encoding => "application/x-tex"} p
          .num_defn
            %h6#definition Definition
            %p
              Let
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_3.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi W
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline W
              denote the codirected system of
              %span.newWikiWord
                affine commutative unipotent
                %a{:href => "/nlab/new/unipotent+k-group"} ?
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_4.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Acu
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Acu_k
              = succeed "-groups" do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_5.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
            .maruku-equation
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_6.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi W
                      %mrow
                        %mn 1
                        %mi k
                    %mover
                      %mo →
                      %mi T
                    %msub
                      %mi W
                      %mrow
                        %mn 2
                        %mi k
                    %mover
                      %mo →
                      %mi T
                    %msub
                      %mi W
                      %mrow
                        %mn 3
                        %mi k
                    %mover
                      %mo →
                      %mi T
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} W_{1k}\stackrel{T}{\to}W_{2k}\stackrel{T}{\to}W_{3k}\stackrel{T}{\to}\cdots
            %p
              The
              %a.existingWikiWord{:href => "/nlab/show/Witt+vectors"} Witt ring
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_7.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(k)
              operates on
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_8.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %munder
                      %mi W
                      %mo ̲
                  %annotation{:encoding => "application/x-tex"} \underline W
              as follows:
            %p
              Let
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_9.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi σ
                  %annotation{:encoding => "application/x-tex"} \sigma
              denote the Frobenius morphism
              = succeed "," do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_10.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                      %mo →
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(k)\to W(k)
              = succeed "." do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_11.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ↦
                      %msup
                        %mi a
                        %mrow
                          %mo{:stretchy => "false"} (
                          %msup
                            %mi p
                            %mi n
                          %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a\mapsto a^{(p^n)}
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_12.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              is perfect. Let
              = succeed "," do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_13.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi a
                      %mo ∈
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi k
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} a\in W(k)
              = succeed "," do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_14.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi w
                      %mo ∈
                      %msub
                        %mi W
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} w\in W_n(R)
              = succeed "." do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_15.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                      %mo ∈
                      %msub
                        %mi M
                        %mi k
                    %annotation{:encoding => "application/x-tex"} R\in M_k
            .maruku-equation
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_16.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi a
                    %mo *
                    %mi w
                    %mo :
                    %mo =
                    %msup
                      %mi a
                      %mrow
                        %msup
                          %mi p
                          %mrow
                            %mn 1
                            %mo −
                            %mi n
                    %mi R
                    %mo ⋅
                    %mi w
                  %annotation{:encoding => "application/x-tex"} a * w:=a^{p^{1-n}} R\cdot w
            %p
              where
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_17.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mrow
                        %msup
                          %mi p
                          %mrow
                            %mn 1
                            %mo −
                            %mi n
                    %mi R
                  %annotation{:encoding => "application/x-tex"} a^{p^{1-n} }R
              is the image of
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_18.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi a
                      %mrow
                        %mo{:stretchy => "false"} (
                        %msup
                          %mi p
                          %mrow
                            %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                            %mi n
                        %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} a^{(p^{-n})}
              in
              = succeed "," do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_19.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi W
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} W(R)
              = succeed "," do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_20.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi b
                      %mo ⋅
                      %mi w
                      %mo ∈
                      %msub
                        %mi W
                        %mi n
                      %mo{:stretchy => "false"} (
                      %mi R
                      %mo{:stretchy => "false"} )
