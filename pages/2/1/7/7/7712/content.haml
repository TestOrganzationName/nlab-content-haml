          .num_defn
            %h6#definition_and_remark Definition and Remark
            %ol
              %li
                %p
                  For a
                  = succeed "-module" do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_41.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
