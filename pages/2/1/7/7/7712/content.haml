                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo{:stretchy => "false"} )
                          %mover
                            %mo →
                            %mo ∼
                          %mi M
                          %mo{:stretchy => "false"} (
                          %mi G
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} M(G)^{(p)}\stackrel{\sim}{\to}M(G)^{(p)}
              %li
                %p
                  The Frobenius morphism and the Verschiebung morphisminduce morphisms of
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_50.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} W(k)
                  modules.
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_51.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi F
                        %mo :
                        %mo =
                        %mi M
                        %mo{:stretchy => "false"} (
                        %msub
                          %mi F
                          %mi G
                        %mo{:stretchy => "false"} )
                        %mo :
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %msup
                          %mo{:stretchy => "false"} )
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %mo →
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} F:=M(F_G):M(G)^{(p)}\to M(G)
                  and
                  = succeed "." do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_52.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                          %mo :
                          %mo =
                          %mi M
                          %mo{:stretchy => "false"} (
                          %msub
                            %mi V
                            %mi G
                          %mo{:stretchy => "false"} )
                          %mo :
                          %mi M
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                          %mo →
                          %mi M
                          %mo{:stretchy => "false"} (
                          %mi G
                          %msup
                            %mo{:stretchy => "false"} )
                            %mrow
                              %mo{:stretchy => "false"} (
                              %mi p
                              %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} V:=M(V_G):M(G)\to M(G)^{(p)}
              %li
                %p
                  The translation morphism
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_53.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi T
                        %mo :
                        %msub
                          %mi W
                          %mi nk
                        %mo →
                        %msub
                          %mi W
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mi k
                      %annotation{:encoding => "application/x-tex"} T:W_{nk}\to W_{(n+1)k}
                  is a monomorphism and the maps
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_54.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Acu
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %msub
                          %mi W
                          %mi nk
                        %mo{:stretchy => "false"} )
                        %mo →
                        %msub
                          %mi Acu
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %msub
                          %mi W
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi n
                            %mo +
                            %mn 1
                            %mo{:stretchy => "false"} )
                            %mi k
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Acu_k(G,W_{nk})\to Acu_k(G,W_{(n+1)k})
                  are injective.
              %li
                %p
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_55.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Acu
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %msub
                          %mi W
                          %mi nk
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} Acu_k(G,W_{nk})
                  can be identified with a submodule of
                  = succeed "," do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_56.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi M
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} M(G)
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_57.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msub
                          %mi Acu
                          %mi k
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo ,
                        %msub
                          %mi W
                          %mi nk
                        %mo{:stretchy => "false"} )
                        %mo =
                        %mo{:stretchy => "false"} {
                        %mi m
                        %mo ∈
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                        %mo ,
                        %msup
                          %mi V
                          %mi n
                        %mi m
                        %mo =
                        %mn 0
                        %mo{:stretchy => "false"} }
                      %annotation{:encoding => "application/x-tex"} Acu_k(G,W_{nk})=\{m\in M(G),V^n m=0\}
                  and we say that an element of
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_58.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} M(G)
                  is killed by a power of
                  = succeed "." do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_59.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi V
                        %annotation{:encoding => "application/x-tex"} V
          .num_defn
            %h6#definition_and_remark_2 Definition and Remark
            %p
              Let
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_60.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi k
                  %annotation{:encoding => "application/x-tex"} D_k
              be the (non-commutative) ring generated by
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_61.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi k
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(k)
              and two elements
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_62.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi F
                  %annotation{:encoding => "application/x-tex"} F
              and
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_63.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              subject to the relations
            .maruku-equation
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_64.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Fw
                    %mo =
                    %msup
                      %mi w
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mi F
                  %annotation{:encoding => "application/x-tex"} Fw=w^{(p)} F
            .maruku-equation
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_65.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi w
                      %mrow
                        %mo{:stretchy => "false"} (
                        %mi p
                        %mo{:stretchy => "false"} )
                    %mi V
                    %mo =
                    %mi V
                    %mi w
                  %annotation{:encoding => "application/x-tex"} w^{(p)}V=V w
            .maruku-equation
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_66.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi FV
                    %mo =
                    %mi VF
                    %mo =
                    %mi p
                  %annotation{:encoding => "application/x-tex"} FV=VF=p
            %p
              Any element of
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_67.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi k
                  %annotation{:encoding => "application/x-tex"} D_k
              can be written uniquely as a finite sum
            .maruku-equation
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_68.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Σ
                      %mrow
                        %mi i
                        %mo &gt;
                        %mn 0
                    %msub
                      %mi a
                      %mrow
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi i
                    %msup
                      %mi V
                      %mi i
                    %mo +
                    %msub
                      %mi a
                      %mn 0
                    %mo +
                    %msub
                      %mi Σ
                      %mrow
                        %mi i
                        %mo &gt;
                        %mn 0
                    %msub
                      %mi a
                      %mi i
                    %msup
                      %mi F
                      %mi i
                  %annotation{:encoding => "application/x-tex"} \Sigma_{i\gt 0}a_{-i}V^i + a_0 + \Sigma_{i\gt 0}a_i F^i
            %p
              If
              = succeed "," do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_69.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi G
                      %mo ∈
                      %msub
                        %mi Acu
                        %mi k
                    %annotation{:encoding => "application/x-tex"} G\in Acu_k
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_70.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M(G)
              has a canonical structure of a left
              = succeed "-module." do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_71.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi k
                    %annotation{:encoding => "application/x-tex"} D_k
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_72.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              is a perfect extension of
              = succeed "," do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_73.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi k
                    %annotation{:encoding => "application/x-tex"} k
              = succeed "-modules" do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_74.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi k
                    %annotation{:encoding => "application/x-tex"} D_k
            .maruku-equation
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_75.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo ⊗
                      %mi k
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(K)\otimes_{W(k)}M(G)\to M(G \otimes_k K)
            %p
              Note that
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_76.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi D
                      %mi K
                    %mo ≃
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %msub
                      %mi D
                      %mi k
                  %annotation{:encoding => "application/x-tex"} D_K\simeq W(K)\otimes_{W(k)} D_k
              and the left hand side can also be written
              = succeed "." do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_77.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi K
                      %msub
                        %mo ⊗
                        %mrow
                          %msub
                            %mi D
                            %mi k
                      %mi M
                      %mo{:stretchy => "false"} (
                      %mi G
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} D_K\otimes_{D_k}M(G)
          .num_theorem
            %h6#theorem Theorem
            %p
              The functor
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_78.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi M
                  %annotation{:encoding => "application/x-tex"} M
              induces an (contravariant) equivalence
            .maruku-equation
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_79.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Acu
                      %mi k
                    %mo →
                    %msub
                      %mi Tor
                      %mi V
                    %msub
                      %mi D
                      %mi k
                    %mi Mod
                  %annotation{:encoding => "application/x-tex"} Acu_k\to Tor_V D_k Mod
            %p
              between
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_80.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi Acu
                      %mi k
                  %annotation{:encoding => "application/x-tex"} Acu_k
              and the category of all
              = succeed "-modules" do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_81.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi D
                        %mi k
                    %annotation{:encoding => "application/x-tex"} D_k
              = succeed "-torsion." do
                %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_82.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
            %p
              For any perfect extension
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_83.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi K
                  %annotation{:encoding => "application/x-tex"} K
              \\of
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_84.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi k
                  %annotation{:encoding => "application/x-tex"} k
              we have that
            .maruku-equation
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_85.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi W
                    %mo{:stretchy => "false"} (
                    %mi K
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo ⊗
                      %mrow
                        %mi W
                        %mo{:stretchy => "false"} (
                        %mi k
                        %mo{:stretchy => "false"} )
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi M
                    %mo{:stretchy => "false"} (
                    %mi G
                    %msub
                      %mo ⊗
                      %mi k
                    %mi K
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} W(K)\otimes_{W(k)}M(G)\to M(G \otimes_k K)
            %p is an isomorphism. Moreover
            %ol
              %li
                %p
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_86.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is algebraic iff
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_87.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} M(G)
                  is a finitely generated
                  = succeed "-module." do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_88.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msub
                            %mi D
                            %mi k
                        %annotation{:encoding => "application/x-tex"} D_k
              %li
                %p
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_89.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi G
                      %annotation{:encoding => "application/x-tex"} G
                  is finite iff
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_90.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi M
                        %mo{:stretchy => "false"} (
                        %mi G
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} M(G)
                  is a
                  = succeed "-module" do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_91.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi W
                          %mo{:stretchy => "false"} (
                          %mi k
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} W(k)
