                      %annotation{:encoding => "application/x-tex"} \begin{cases}M(G)\to M(G^{(p)})\\f\mapsto f^{(p)}\end{cases}
              %li
                %p
                  (…) There is an isomorphism
                  = succeed "." do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_49.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi M
