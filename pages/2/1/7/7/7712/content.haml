                        %annotation{:encoding => "application/x-tex"} M^{(p)}:=M\otimes_{W(k),\sigma}W(k)
              %li
                %p
                  As a group
                  = succeed "," do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_44.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi M
