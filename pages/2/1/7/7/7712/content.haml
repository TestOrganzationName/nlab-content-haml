                              %mo{:stretchy => "false"} )
                          %mi m
                        %annotation{:encoding => "application/x-tex"} (w,m)\mapsto w^{(p^{-1})}m
              %li
                %p
                  If
                  = succeed "," do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_46.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi f
                          %mo ∈
                          %msub
                            %mi Acu
                            %mi k
                          %mo{:stretchy => "false"} (
                          %mi G
                          %mo ,
                          %msub
                            %mi W
                            %mi nk
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} f\in Acu_k(G,W_{nk})
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_47.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mi f
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %mo :
                        %msup
                          %mi G
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %mo →
                        %msubsup
                          %mi W
                          %mi nk
                          %mrow
                            %mo{:stretchy => "false"} (
                            %mi p
                            %mo{:stretchy => "false"} )
                        %mo =
                        %msub
                          %mi W
                          %mi nk
                      %annotation{:encoding => "application/x-tex"} f^{(p)}:G^{(p)}\to W^{(p)}_{nk}=W_{nk}
                  is a morphism and hence a map
                  %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_48.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mo {
                          %mrow
                            %mtable{:columnalign => "left left", :displaystyle => "false"}
                              %mtr
                                %mtd
                                  %mi M
