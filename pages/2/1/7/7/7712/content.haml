                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} (
                    %mi G
                    %mo ,
                    %munder
                      %mi W
                      %mo ̲
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} M(G)=codir(Acu_k)(G,\underline W)
              where
              %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_34.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
