                  = succeed "." do
                    %math#mathml_9be2acc07c21c75d1ddc30375178e05b499afa75_45.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mo{:stretchy => "false"} (
