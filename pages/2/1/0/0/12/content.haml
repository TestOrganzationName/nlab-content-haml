                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %msup
                            %mi Ext
                            %mi n
                        %annotation{:encoding => "application/x-tex"} Ext^n
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/projective+module"} projective module
                  %a.existingWikiWord{:href => "/nlab/show/projective+resolution"} projective
                  and
                  %a.existingWikiWord{:href => "/nlab/show/injective+resolution"} injective
                  resolution of a module,
                  %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
                  and
                  %span.newWikiWord
                    hyperhomology
                    %a{:href => "/nlab/new/hyperhomology"} ?
                  appear in this book for the first time
              %tr
                %td{:style => "text-align: left;"} 1956
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+homotopy+theory"} simplicial homotopy theory
                  also called categorical homotopy theory: a homotopy theory completely internal to the
                  %a.existingWikiWord{:href => "/nlab/show/SimpSet"} category of simplicial sets
              %tr
                %td{:style => "text-align: left;"} 1957
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Charles+Ehresmann"}> Charles Ehresmann
                  –
                  %a.existingWikiWord{:href => "/nlab/show/Jean+B%C3%A9nabou"} Jean Bénabou
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/pointless+topology"} pointless topology
                  building on
                  = succeed "'s" do
                    %a.existingWikiWord{:href => "/nlab/show/Marshall+Stone"} Marshall Stone
              %tr
                %td{:style => "text-align: left;"} 1957
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/abelian+category"} abelian categories
                  in homological algebra that combine exactness and linearity
              %tr
                %td{:style => "text-align: left;"} 1957
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  influential
                  %a.existingWikiWord{:href => "/nlab/show/Tohoku"} Tohoku
                  paper rewrites
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/homological+algebra"} homological algebra
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+duality"} Grothendieck duality
                  (Serre duality for possibly singular algebraic varieties). He also showed that the conceptual basis for homological algebra over a ring also holds for linear objects varying as sheaves over a space
              %tr
                %td{:style => "text-align: left;"} 1957
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  the
                  = succeed "," do
                    %span.newWikiWord
                      Grothendieck relative point of view
                      %a{:href => "/nlab/new/Grothendieck+relative+point+of+view"} ?
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/S-scheme"} S-scheme
              %tr
                %td{:style => "text-align: left;"} 1957
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %span.newWikiWord
                    Grothendieck-Hirzebruch-Riemann-Roch theorem
                    %a{:href => "/nlab/new/Grothendieck-Hirzebruch-Riemann-Roch+theorem"} ?
                  for smooth schemes
              %tr
                %td{:style => "text-align: left;"} 1957
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Kan+complexes"}> Kan complexes
                  \:
                  %a.existingWikiWord{:href => "/nlab/show/simplicial+sets"} simplicial sets
                  (in which every horn has a filler) that are
                  %a.existingWikiWord{:href => "/nlab/show/geometric+model+of+higher+categories"} geometric models
                  of
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/%E2%88%9E-groupoids"} ∞-groupoids
                  %a.existingWikiWord{:href => "/nlab/show/model+structure+on+simplicial+sets"} model categories of simplicial sets
                  for which the fibrations are
                  = succeed "s." do
                    %a.existingWikiWord{:href => "/nlab/show/Kan+fibration"} Kan fibration
              %tr
                %td{:style => "text-align: left;"} 1958
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  starts new foundation of
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+geometry"} algebraic geometry
                  by generalizing varieties and other spaces in algebraic geometry to
                  %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
                  which have the structure of a category with open subsets as objects and restrictions as morphisms. Schemes form a category that is a
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
              %tr
                %td{:style => "text-align: left;"} 1958
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Roger+Godement"} Roger Godement
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/monad"}> monad
                  s in category theory (which he called standard constructions). Monads generalize classical notions from
                  %a.existingWikiWord{:href => "/nlab/show/universal+algebra"} universal algebra
                  and can in this sense be thought of as an
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
                  over a category: the theory of the category of
                  = succeed "-algebras." do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi T
                        %annotation{:encoding => "application/x-tex"} T
              %tr
                %td{:style => "text-align: left;"} 1958
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/adjoint+functors"} adjoint functors
              %tr
                %td{:style => "text-align: left;"} 1958
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/limits"} limits
                  in category theory
              %tr
                %td{:style => "text-align: left;"} 1958
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  Introduces
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/pseudofunctor"} pseudofunctor
                  %a.existingWikiWord{:href => "/nlab/show/descent"} descent
                  theory in FGA but publish them later with Pierre Gabriel in SGA1 1961 modernized into
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/fibred+categories"} fibred categories
              %tr
                %td{:style => "text-align: left;"} 1959
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  Introduces
                  %a.existingWikiWord{:href => "/nlab/show/formal+geometry"} formal algebraic geometry
                  and
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/formal+scheme"} formal scheme
              %tr
                %td{:style => "text-align: left;"} 1959
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"} Bernard Dwork
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  proves the rationality part of the
                  %a.existingWikiWord{:href => "/nlab/show/Weil+conjectures"} Weil conjectures
                  (the first conjecture)
              %tr
                %td{:style => "text-align: left;"} 1960
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/fiber+functor"}> fiber functor
                  s
              %tr
                %td{:style => "text-align: left;"} 1960
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Daniel+Kan"} Daniel Kan
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Kan+extension"}> Kan extension
                  s
              %tr
                %td{:style => "text-align: left;"} 1960
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/representable+functors"} representable functors
              %tr
                %td{:style => "text-align: left;"} 1960
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  categorizes Galois theory (
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+Galois+theory"}> Grothendieck Galois theory
                  )
              %tr
                %td{:style => "text-align: left;"} 1960
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/descent"} descent
                  theory: an idea extending the notion of
                  %a.existingWikiWord{:href => "/nlab/show/quotient+space"} gluing
                  in topology to
                  %a.existingWikiWord{:href => "/nlab/show/schemes"} schemes
                  to get around the brute equivalence relations. It also generalizes
                  %a.existingWikiWord{:href => "/nlab/show/localization"} localization
                  in topology
              %tr
                %td{:style => "text-align: left;"} 1960
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Pierre+Gabriel"} Pierre Gabriel
                  %sup
                    %a{:href => "http://ncatlab.org/nlab/show/Timeline+of+category+theory+and+related+mathematics#2"} [2]
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  Reconstruction of a scheme from the category of
                  %a.existingWikiWord{:href => "/nlab/show/quasicoherent+sheaf"} quasicoherent sheaves
                  over it (Gabriel–Rosenberg theorem in the separated quasicompact case and a precursor of
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/noncommutative+algebraic+geometry"} noncommutative algebraic geometry
              %tr
                %td{:style => "text-align: left;"} 1961
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %span.newWikiWord>
                    local cohomology
                    %a{:href => "/nlab/new/local+cohomology"} ?
                  \. Introduced at a seminar in 1961 but the notes are published in 1967
              %tr
                %td{:style => "text-align: left;"} 1961
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/associahedron"} associahedra
                  later used in the definition of
                  %a.existingWikiWord{:href => "/nlab/show/weak+n-category"} weak n-categories
              %tr
                %td{:style => "text-align: left;"} 1961
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Richard+Swan"} Richard Swan
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  Shows there is a one-to-one correspondence between topological vector bundles over a compact Hausdorff space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  and finitely generated projective modules over the ring
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi C
                        %mo{:stretchy => "false"} (
                        %mi X
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} C(X)
                  of continuous functions on
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi X
                      %annotation{:encoding => "application/x-tex"} X
                  (
                  %a.existingWikiWord{:href => "/nlab/show/Serre-Swan+theorem"}> Serre-Swan theorem
                  )
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Frank+Adams"}> Frank Adams
                  –
                  %a.existingWikiWord{:href => "/nlab/show/Saunders+Mac+Lane"} Saunders Mac Lane
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/PROP"} PROP
                  categories and
                  %span.newWikiWord
                    PACT
                    %a{:href => "/nlab/new/PACT"} ?
                  categories for higher homotopies. PROPs are categories for describing families of operations with any number of inputs and outputs.
                  %a.existingWikiWord{:href => "/nlab/show/operad"} Operads
                  are special PROPs with operations with only one output
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/etale+topology"}> etale topology
                  , a special Grothendieck topology on schemes
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/etale+cohomology"} etale cohomology
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Alexander+Grothendieck"} Alexander Grothendieck
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+toposes"}> Grothendieck toposes
                  , which are categories which are like universes (generalized spaces) of sets in which one can do mathematics
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"} William Lawvere
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theories
                  and
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+category"} algebraic categories
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/William+Lawvere"} William Lawvere
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  Founds
                  = succeed "," do
                    %a.existingWikiWord{:href => "/nlab/show/categorical+logic"} categorical logic
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/Lawvere+theory"} Lawvere theories
                  = succeed ")" do
                    %a.existingWikiWord{:href => "/nlab/show/doctrine"} doctrine
                  %a.existingWikiWord{:href => "/nlab/show/algebraic+theory"} algebraic theory
                  as a category with finite products and possessing a “generic algebra” (such as a generic group). The structures described by a Lawvere theory are models of the Lawvere theory
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Jean-Louis+Verdier"} Jean-Louis Verdier
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  after the advice of Grothendieck, defined
                  %a.existingWikiWord{:href => "/nlab/show/triangulated+category"} triangulated categories
                  and
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/triangulated+functor"} triangulated functor
                  = succeed "." do
                    %a.existingWikiWord{:href => "/nlab/show/derived+category"} derived categories
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/derived+functor"} derived functor
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Jim+Stasheff"} Jim Stasheff
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}>
                    %semantics
                      %mrow
                        %msub
                          %mi A
                          %mn ∞
                      %annotation{:encoding => "application/x-tex"} A_\infty
                  \-
                  %a.existingWikiWord{:href => "/nlab/show/A-infinity-algebra"}> algebras
                  \:
                  %a.existingWikiWord{:href => "/nlab/show/dg-algebra"} dg-algebra
                  analogs of
                  = succeed "s" do
                    %a.existingWikiWord{:href => "/nlab/show/topological+monoid"} topological monoid
                  = succeed "s)" do
                    %a.existingWikiWord{:href => "/nlab/show/H-space"} H-space
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Jean+Giraud"} Jean Giraud
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Giraud characterization theorem
                  characterizing Grothendieck toposes as categories of sheaves over a small site
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Charles+Ehresmann"} Charles Ehresmann
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/internal+category"} internal category
                  theory: internalization of categories in a category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  with pullbacks replacing the category
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Set
                      %annotation{:encoding => "application/x-tex"} Set
                  (same for classes instead of sets) by
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi V
                      %annotation{:encoding => "application/x-tex"} V
                  in the definition of a category. Internalization is a way to rise the
                  %a.existingWikiWord{:href => "/nlab/show/higher+category+theory"} categorical dimension
              %tr
                %td{:style => "text-align: left;"} 1963
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/Charles+Ehresmann"} Charles Ehresmann
                %td{:style => "text-align: left;"}
                %td{:style => "text-align: left;"}
                  %a.existingWikiWord{:href => "/nlab/show/multiple+category"} multiple categories
                  and
                  %span.newWikiWord
                    multiple functors
                    %a{:href => "/nlab/new/multiple+functor"} ?
