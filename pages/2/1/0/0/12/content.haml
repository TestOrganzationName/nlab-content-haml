                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mo{:stretchy => "false"} |
                        %mo .
                        %mo{:stretchy => "false"} |
                      %annotation{:encoding => "application/x-tex"} \vert{.}\vert
