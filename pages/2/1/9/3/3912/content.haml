                  %mo{:lspace => "verythinmathspace"} :
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi H
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi X
                  %mo{:stretchy => "false"} )
                  %mover
                    %mo ⟶
                    %mo ≃
                  %msup
                    %mover
                      %mi H
                      %mo{:stretchy => "false"} ˜
