                  \\;\colon\;
                  H^\bullet(X)
                  \\stackrel{\simeq}{\longrightarrow}
                  \\tilde H^{\bullet + n}\big(Th(V)\big)
          %p
            from the
            %a.existingWikiWord{:href => "/nlab/show/cohomology"} cohomology
            of
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi X
                %annotation{:encoding => "application/x-tex"} X
