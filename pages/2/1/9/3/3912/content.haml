            against this volume form.
          %h2#statement Statement
          %h3#concretely Concretely
          %h4#in_ordinary_cohomology In ordinary cohomology
          #Smooth0TypeIsSheavesOnSmoothMfd.num_prop
            %h6#proposition Proposition
            %p
              Let
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                    %mo →
                    %mi B
                  %annotation{:encoding => "application/x-tex"} V \to B
              be a
              %a.existingWikiWord{:href => "/nlab/show/topological+vector+bundle"} topological vector bundle
              of
              %a.existingWikiWord{:href => "/nlab/show/rank"} rank
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                    %mo &gt;
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} n \gt 0
              over a
              %a.existingWikiWord{:href => "/nlab/show/simply+connected+topological+space"} simply connected
              %a.existingWikiWord{:href => "/nlab/show/CW-complex"} CW-complex
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                    %annotation{:encoding => "application/x-tex"} B
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi R
                  %annotation{:encoding => "application/x-tex"} R
              be a
              = succeed "." do
                %a.existingWikiWord{:href => "/nlab/show/commutative+ring"} commutative ring
            %p
              There exists an element
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                    %mo ∈
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} c \in H^n(Th(V);R)
              (in the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              of
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              = succeed ")" do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/Thom+class"} Thom class
              %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi c
                  %annotation{:encoding => "application/x-tex"} c
              induces an
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mrow
                        %mi c
                        %mo ∪
                        %mo{:stretchy => "false"} (
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mo{:stretchy => "false"} )
                    %msup
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} +
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    H^\bullet(B;R)
                    \\overset{c \cup (-)}{\longrightarrow}
                    \\tilde H^{\bullet + n}(Th(V);R)
            %p
              of degree
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi n
                  %annotation{:encoding => "application/x-tex"} n
              from the unreduced
              %a.existingWikiWord{:href => "/nlab/show/cohomology+group"} cohomology group
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi B
                  %annotation{:encoding => "application/x-tex"} B
              to the
              %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology"} reduced cohomology
              of the
              %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
              of
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
          #ProofOfThomIsomorphismViaFiberwiseThomSpaceFibration.proof
            %h6#proof Proof
            %p
              %strong (of Thom isomorphism via fiberwise Thom spaces)
            %p
              Choose an
              %a.existingWikiWord{:href => "/nlab/show/orthogonal+structure"} orthogonal structure
              on
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi V
                    %annotation{:encoding => "application/x-tex"} V
              %em fiberwise
              %a.existingWikiWord{:href => "/nlab/show/cofiber"} cofiber
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi E
                    %mo ≔
                    %mi D
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %msub
                      %mo{:stretchy => "false"} /
                      %mi B
                    %mi S
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    E \coloneqq D(V)/_B S(V)
            %p
              of the inclusion of the
              %a.existingWikiWord{:href => "/nlab/show/unit+sphere"} unit sphere
              bundle into the unit disk bundle of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi V
                  %annotation{:encoding => "application/x-tex"} V
              (
              %a{:href => "Thom+space#ThomSpace"}> def.
              ).
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %msup
                              %mi S
                              %mrow
                                %mi n
                                %mo −
                                %mn 1
                          %mtd
                            %mo ↪
                          %mtd
                            %msup
                              %mi D
                              %mi n
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi S
                              %mi n
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                            %mi S
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ↪
                          %mtd
                            %mi D
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %mi E
                        %mtr
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mi p
                        %mtr
                          %mtd
                            %mi B
                          %mtd
                            %mo =
                          %mtd
                            %mi B
                          %mtd
                            %mo =
                          %mtd
                            %mi B
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    S^{n-1} &amp;\hookrightarrow&amp; D^n &amp;\longrightarrow&amp; S^n
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow
                    \\\
                    S(V) &amp;\hookrightarrow&amp; D(V) &amp;\longrightarrow&amp; E
                    \\\
                    \\downarrow &amp;&amp; \downarrow &amp;&amp; \downarrow^{\mathrlap{p}}
                    \\\
                    B &amp;=&amp; B &amp;=&amp; B
                    }
            %p Observe that this has the following properties
            %ol
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi p
                        %mi B
                      %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} B
                  is an
                  %a.existingWikiWord{:href => "/nlab/show/n-sphere"} n-sphere
                  %a.existingWikiWord{:href => "/nlab/show/fiber+bundle"} fiber bundle
                  (
                  %a.existingWikiWord{:href => "/nlab/show/spherical+fibration"}> spherical fibration
                  ), hence in particular a
                  = succeed ";" do
                    %a.existingWikiWord{:href => "/nlab/show/Serre+fibration"} Serre fibration
              %li
                %p
                  the
                  %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi Th
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %mi E
                        %mo{:stretchy => "false"} /
                        %mi B
                      %annotation{:encoding => "application/x-tex"} Th(V)\simeq E/B
                  is the
                  %a.existingWikiWord{:href => "/nlab/show/quotient+topological+space"} quotient
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  by the base space, because of the
                  %a.existingWikiWord{:href => "/nlab/show/pasting+law"} pasting law
                  applied to the following pasting diagram of
                  %a.existingWikiWord{:href => "/nlab/show/pushout"} pushout
                  squares:
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mrow
                          %mtable
                            %mtr
                              %mtd
                                %mi S
                                %mo{:stretchy => "false"} (
                                %mi V
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi D
                                %mo{:stretchy => "false"} (
                                %mi V
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi po
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mi B
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi D
                                %mo{:stretchy => "false"} (
                                %mi V
                                %mo{:stretchy => "false"} )
                                %msub
                                  %mo{:stretchy => "false"} /
                                  %mi B
                                %mi S
                                %mo{:stretchy => "false"} (
                                %mi V
                                %mo{:stretchy => "false"} )
                            %mtr
                              %mtd
                                %mo{:stretchy => "false"} ↓
                              %mtd
                                %mo{:stretchy => "false"} (
                                %mi po
                                %mo{:stretchy => "false"} )
                              %mtd
                                %mo{:stretchy => "false"} ↓
                            %mtr
                              %mtd
                                %mo *
                              %mtd
                                %mo ⟶
                              %mtd
                                %mi Th
                                %mo{:stretchy => "false"} (
                                %mi V
                                %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"}
                        \\array{
                        S(V) &amp;\longrightarrow&amp; D(V)
                        \\\
                        \\downarrow &amp;(po)&amp; \downarrow
                        \\\
                        B &amp;\longrightarrow&amp; D(V)/_B S(V)
                        \\\
                        \\downarrow &amp;(po)&amp; \downarrow
                        \\\
                        \\ast &amp;\longrightarrow&amp; Th(V)
                        }
              %li
                %p
                  hence the
                  %a.existingWikiWord{:href => "/nlab/show/reduced+cohomology"} reduced cohomology
                  of the Thom space is (
                  %a{:href => "Introduction+to+Stable+homotopy+theory+--+S#ReducedToUnreducedGeneralizedCohomology"}> def.
                  ) the
                  %a.existingWikiWord{:href => "/nlab/show/relative+cohomology"} relative cohomology
                  of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                      %annotation{:encoding => "application/x-tex"} E
                  relative to
                  = succeed ":" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi B
                        %annotation{:encoding => "application/x-tex"} B
                .maruku-equation
                  %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %msup
                          %mover
                            %mi H
                            %mo{:stretchy => "false"} ˜
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi Th
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo ;
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mo ≃
                        %msup
                          %mi H
                          %mo •
                        %mo{:stretchy => "false"} (
                        %mi E
                        %mo ,
                        %mi B
                        %mo ;
                        %mi R
                        %mo{:stretchy => "false"} )
                        %mspace{:width => "thinmathspace"}
                        %mo .
                      %annotation{:encoding => "application/x-tex"}
                        \\tilde H^\bullet(Th(V);R) \simeq H^\bullet(E,B;R)
                        \\,.
              %li
                %p
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi E
                        %mover
                          %mo →
                          %mi p
                        %mi B
                      %annotation{:encoding => "application/x-tex"} E \overset{p}{\to} B
                  has a global
                  %a.existingWikiWord{:href => "/nlab/show/section"} section
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi B
                        %mover
                          %mo →
                          %mi s
                        %mi E
                      %annotation{:encoding => "application/x-tex"} B \overset{s}{\to} E
                  (given over any point
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi b
                        %mo ∈
                        %mi B
                      %annotation{:encoding => "application/x-tex"} b \in B
                  by the class of any point in the fiber of
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi S
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                        %mo →
                        %mi B
                      %annotation{:encoding => "application/x-tex"} S(V) \to B
                  over
                  = succeed ";" do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi b
                        %annotation{:encoding => "application/x-tex"} b
                  %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                    %semantics
                      %mrow
                        %mi D
                        %mo{:stretchy => "false"} (
                        %mi V
                        %mo{:stretchy => "false"} )
                      %annotation{:encoding => "application/x-tex"} D(V)
                  and from
                  = succeed "," do
                    %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                      %semantics
                        %mrow
                          %mi S
                          %mo{:stretchy => "false"} (
                          %mi V
                          %mo{:stretchy => "false"} )
                        %annotation{:encoding => "application/x-tex"} S(V)
            %p
              In the following we write
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                      %mo ≔
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo ;
                      %mi R
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} H^\bullet(-)\coloneqq H^\bullet(-;R)
            %p
              By the first point, there is the
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thom-Gysin+sequence"} Thom-Gysin sequence
              %a.existingWikiWord{:href => "/nlab/show/exact+sequence"} exact sequence
              running vertically in the following diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %msup
                                    %mi p
                                    %mo *
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %msup
                              %mover
                                %mi H
                                %mo{:stretchy => "false"} ˜
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mo ⟶
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi E
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %msup
                                  %mi s
                                  %mo *
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mo{:stretchy => "false"} ↓
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi H
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; H^\bullet(B)
                    \\\
                    \&amp;&amp; {}^{\mathllap{p^\ast}}\downarrow  &amp; \searrow^{\mathrlap{\simeq}}
                    \\\
                    \\tilde H^\bullet(Th(V))
                    \&amp;\longrightarrow&amp;
                    H^\bullet(E)
                    \&amp;\underset{s^\ast}{\longrightarrow}&amp;
                    H^\bullet(B)
                    \\\
                    \&amp;&amp; \downarrow
                    \\\
                    \&amp;&amp; H^{\bullet-n}(B)
                    }
                    \\,.
            %p
              By the second point above this is
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/split+exact+sequence"} split
              %a{:href => "generalized+%28Eilenberg-Steenrod%29+cohomology#ExactnessUnreduced"} exact sequence in relative cohomology
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ⋯
                    %mo →
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo ,
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mo →
                    %mi ⋯
                  %annotation{:encoding => "application/x-tex"} \cdots \to H^\bullet(E,B) \to H^\bullet(E) \to H^\bullet(B) \to \cdots
              induced from the section
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi B
                      %mo ↪
                      %mi E
                    %annotation{:encoding => "application/x-tex"} B \hookrightarrow E
            %p
              Hence using the splitting to decompose the term in the middle as a
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/direct+sum"} direct sum
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mrow
                              %mpadded{:lspace => "-100%width", :width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mn 0
                                  %mo ,
                                  %mi id
                                  %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} ↓
                          %mtd
                            %msup
                              %mo ↘
                              %mpadded{:width => "0"}
                                %mo ≃
                        %mtr
                          %mtd
                            %msup
                              %mover
                                %mi H
                                %mo{:stretchy => "false"} ˜
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                          %mtd
                            %mover
                              %mo ↪
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mi id
                                %mo ,
                                %mn 0
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mover
                                %mi H
                                %mo{:stretchy => "false"} ˜
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi Th
                            %mo{:stretchy => "false"} (
                            %mi V
                            %mo{:stretchy => "false"} )
                            %mo{:stretchy => "false"} )
                            %mo ⊕
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                          %mtd
                            %munder
                              %mo ⟶
                              %mrow
                                %mo{:stretchy => "false"} (
                                %mn 0
                                %mo ,
                                %mi id
                                %mo{:stretchy => "false"} )
                          %mtd
                            %msup
                              %mi H
                              %mo •
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mo{:stretchy => "false"} ↓
                              %mpadded{:width => "0"}
                                %mrow
                                  %mo{:stretchy => "false"} (
                                  %mi id
                                  %mo ,
                                  %mn 0
                                  %mo{:stretchy => "false"} )
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %msup
                              %mi H
                              %mrow
                                %mo •
                                %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                                %mi n
                            %mo{:stretchy => "false"} (
                            %mi B
                            %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    \&amp;&amp; H^\bullet(B)
                    \\\
                    \&amp;&amp; {}^{\mathllap{(0,id)}}\downarrow  &amp; \searrow^{\mathrlap{\simeq}}
                    \\\
                    \\tilde H^\bullet(Th(V))
                    \&amp;\overset{(id,0)}{\hookrightarrow}&amp;
                    \\tilde H^\bullet(Th(V))
                    \\oplus
                    H^\bullet(B)
                    \&amp;\underset{(0,id)}{\longrightarrow}&amp;
                    H^\bullet(B)
                    \\\
                    \&amp;&amp; \downarrow^{\mathrlap{(id,0)}}
                    \\\
                    \&amp;&amp; H^{\bullet-n}(B)
                    }
            %p and hence an isomorphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mover
                        %mi H
                        %mo{:stretchy => "false"} ˜
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                    %mo{:stretchy => "false"} )
                    %mover
                      %mo ⟶
                      %mo ≃
                    %msup
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo .
                  %annotation{:encoding => "application/x-tex"}
                    \\tilde H^\bullet(Th(V))
                    \\overset{\simeq}{\longrightarrow}
                    H^{\bullet-n}(B)
                    \\,.
            %p
              To see that this is the inverse of a morphism of the form
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi c
                      %mo ∪
                      %mo{:stretchy => "false"} (
                      %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} c \cup (-)
              = succeed "." do
                %a{:href => "Thom-Gysin+sequence#ProofOfThomGysinSequence"} proof of the Gysin sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mrow
                        %mo •
                        %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                        %mi n
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^{\bullet-n}(B)
              here is identified with elements that on the second page of the corresponding
              %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
              are cup products
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                    %mo ∪
                    %mi b
                  %annotation{:encoding => "application/x-tex"}
                    \\iota \cup b
            %p
              with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              fiberwise the canonical class
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mn 1
                    %mo ∈
                    %msup
                      %mi H
                      %mi n
                    %mo{:stretchy => "false"} (
                    %msup
                      %mi S
                      %mi n
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} 1 \in H^n(S^n)
              and with
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi b
                    %mo ∈
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} b \in H^\bullet(B)
              any element. Since
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo ;
                    %mi R
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet(-;R)
              is a
              %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theory"} multiplicative cohomology theory
              (because the
              %a.existingWikiWord{:href => "/nlab/show/coefficients"} coefficients
              form a
              %a.existingWikiWord{:href => "/nlab/show/ring"} ring
              = succeed ")," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi R
                    %annotation{:encoding => "application/x-tex"} R
              = succeed "-page" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi H
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                    %mo →
                    %msup
                      %mi B
                      %mo •
                    %mo{:stretchy => "false"} (
                    %mi B
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H^\bullet(E) \to B^\bullet(B)
              above, hence also the isomorphism
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msup
                        %mover
                          %mi H
                          %mo{:stretchy => "false"} ˜
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi Th
                      %mo{:stretchy => "false"} (
                      %mi V
                      %mo{:stretchy => "false"} )
                      %mo{:stretchy => "false"} )
                      %mo →
                      %msup
                        %mi H
                        %mo •
                      %mo{:stretchy => "false"} (
                      %mi B
                      %mo{:stretchy => "false"} )
                    %annotation{:encoding => "application/x-tex"} \tilde H^\bullet(Th(V)) \to H^\bullet(B)
              = succeed "-page" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
              = succeed ")." do
                %a{:href => "Thom-Gysin+sequence#ProofOfThomGysinSequence"} proof of the Gysin sequence
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ι
                  %annotation{:encoding => "application/x-tex"} \iota
              on the
              = succeed "-page" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %msub
                        %mi E
                        %mn ∞
                    %annotation{:encoding => "application/x-tex"} E_\infty
          %h4#in_generalized_cohomology In generalized cohomology
          %p
            Let
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            be a
            %a.existingWikiWord{:href => "/nlab/show/generalized+%28Eilenberg-Steenrod%29+cohomology"} generalized (Eilenberg-Steenrod) cohomology
            theory. First observe that an
            %a.existingWikiWord{:href => "/nlab/show/E-orientation"} E-orientation
            on
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi V
                  %mo →
                  %mi X
                %annotation{:encoding => "application/x-tex"} V \to X
            induces an
            = succeed "-orientation," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi H
                    %msub
                      %mi π
                      %mn 0
                    %mo{:stretchy => "false"} (
                    %mi E
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} H \pi_0(E)
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            with coefficients in the degree-0 ground ring.
          %p
            To see this, let’s assume
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi E
                %annotation{:encoding => "application/x-tex"} E
            is
            = succeed "." do
              %a.existingWikiWord{:href => "/nlab/show/connective+spectrum"} connective
            %a.existingWikiWord{:href => "/nlab/show/Atiyah-Hirzebruch+spectral+sequence"} Atiyah-Hirzebruch spectral sequence
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi H
                      %mo{:stretchy => "false"} ˜
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi E
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mi H
                    %mi p
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi E
                    %mi q
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mspace{:width => "thickmathspace"}
                  %mo ⇒
                  %mspace{:width => "thickmathspace"}
                  %msup
                    %mi E
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ≃
                  %msup
                    %mover
                      %mi E
                      %mo{:stretchy => "false"} ˜
                    %mo •
                  %mo{:stretchy => "false"} (
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\tilde H^p(Th(V), E^q(\ast))
                  \\simeq
                  H^p(D(V),S(V), E^q(\ast))
                  \\;\Rightarrow\;
                  E^\bullet(D(V), S(V))
                  \\simeq
                  \\tilde E^\bullet(Th(V))
          %p
            Since
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mo{:stretchy => "false"} (
                  %mi D
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %mi S
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"} (D(V), S(V))
            is
            = succeed "-connected" do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mi n
                    %mo −
                    %mn 1
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (n-1)
            %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %mi n
                %annotation{:encoding => "application/x-tex"} n
            vector bundle, then
            = succeed "." do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msubsup
                      %mi E
                      %mn 2
                      %mrow
                        %mi p
                        %mo &lt;
                        %mi n
                        %mo ,
                        %mi q
                    %mo =
                    %mn 0
                  %annotation{:encoding => "application/x-tex"} E_2^{p \lt n, q} = 0
          .maruku-equation
            %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
              %semantics
                %mrow
                  %msup
                    %mover
                      %mi H
                      %mo{:stretchy => "false"} ˜
                    %mi k
                  %mo{:stretchy => "false"} (
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo ,
                  %msup
                    %mi E
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mo *
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                  %mo ⟶
                  %msup
                    %mover
                      %mi H
                      %mo{:stretchy => "false"} ˜
                    %mn 0
                  %mo{:stretchy => "false"} (
                  %mi Th
                  %mo{:stretchy => "false"} (
                  %mi V
                  %mo{:stretchy => "false"} )
                  %mo{:stretchy => "false"} )
                %annotation{:encoding => "application/x-tex"}
                  \\tilde H^k(Th(V), E^0(\ast)) \longrightarrow \tilde H^0(Th(V))
          %p
            is an
            = succeed "," do
              %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
          %p
            For a fully detailed account see (
            %a{:href => "#Pedrotti16"}> Pedrotti 16
            ).
          %h3#abstractly Abstractly
          %p
            A general abstract discussion is around page 30, 31 of (
            %a{:href => "#ABGHR"}> ABGHR
            ).
          %p (…)
          %h2#applications Applications
          %ul
            %li
              The Thom isomorphism is used to define
              %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
              of multiplicative cohomology theories.
          %h2#related_concepts Related concepts
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thom-Gysin+sequence"} Thom-Gysin sequence
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/cobordism+theory"} cobordism theory
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Thom+space"}> Thom space
                ,
                %a.existingWikiWord{:href => "/nlab/show/Thom+spectrum"} Thom spectrum
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/fiber+integration"} fiber integration
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pontrjagin-Thom+collapse+map"} Pontrjagin-Thom collapse map
          %h2#references References
          %p
            The original proof that the Thom isomorphism is indeed an
            %a.existingWikiWord{:href => "/nlab/show/isomorphism"} isomorphism
            is due to
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Ren%C3%A9+Thom"}> René Thom
              ,
              %em Quelques propriétés globales des variétés différentiables
              Comm. Math. Helv. , 28 (1954) pp. 17–86
          %p
            The argument via a
            %a.existingWikiWord{:href => "/nlab/show/Serre+spectral+sequence"} Serre spectral sequence
            for a relative fibration seems to be due to
          %ul
            %li
              W. H. Cockcroft,
              = succeed "," do
                %em On the Thom isomorphism Theorem
              = succeed "," do
                %a{:href => "http://journals.cambridge.org/abstract_S0305004100036409"} web
              = succeed ")" do
                %a{:href => "http://journals.cambridge.org/action/displayFulltext?type=1&fid=2056796&jid=PSP&volumeId=58&issueId=02&aid=2056788&bodyId=&membershipNumber=&societyETOCSession="} pdf
          %p Textbook accounts:
          %ul
            %li#Rudyak98
              %a.existingWikiWord{:href => "/nlab/show/Yuli+Rudyak"}> Yuli Rudyak
              , chapter V of
              = succeed "," do
                %em Thom spectra, Orientability and Cobordism
              = succeed ")" do
                %a{:href => "http://www.maths.ed.ac.uk/~aar/papers/rudyakthom.pdf"} pdf
          %p
            Discussion in the generality of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/complex+oriented+cohomology+theory"} complex oriented cohomology theory
          %ul
            %li#ConnerFloyd66
              %p
                %a.existingWikiWord{:href => "/nlab/show/Pierre+Conner"}> Pierre Conner
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Edwin+Floyd"} Edwin Floyd
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/The+Relation+of+Cobordism+to+K-Theories"} The Relation of Cobordism to K-Theories
                %strong 28
                Springer 1966 (
                %a{:href => "https://link.springer.com/book/10.1007/BFb0071091"}> doi:10.1007/BFb0071091
                ,
                = succeed ")" do
                  %a{:href => "http://www.ams.org/mathscinet-getitem?mr=216511"} MR216511
            %li#Kochman96
              %p
                %a.existingWikiWord{:href => "/nlab/show/Stanley+Kochman"}> Stanley Kochman
                , Section 2.6 of:
                = succeed "," do
                  %em
                    %a.existingWikiWord{:href => "/nlab/show/Bordism%2C+Stable+Homotopy+and+Adams+Spectral+Sequences"} Bordism, Stable Homotopy and Adams Spectral Sequences
            %li#TamakiKono06
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dai+Tamaki"}> Dai Tamaki
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Akira+Kono"} Akira Kono
                = succeed "," do
                  %em Generalized Cohomology
                = succeed ")" do
                  %a{:href => "https://bookstore.ams.org/mmono-230"} ISBN: 978-0-8218-3514-2
          %p Lecture notes:
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Akhil+Mathew"}> Akhil Mathew
                ,
                = succeed "," do
                  %em
                    %a{:href => "https://amathew.wordpress.com/2010/12/11/the-thom-isomorphism-theorem/"} The Thom isomorphism theorem
            %li#Ebert12
              %p
                %a.existingWikiWord{:href => "/nlab/show/Johannes+Ebert"}> Johannes Ebert
                , sections 2.3, 2.4 of
                = succeed "," do
                  %em A lecture course on Cobordism Theory
                = succeed ")" do
                  %a{:href => "http://wwwmath.uni-muenster.de/u/jeber_02/skripten/bordism-skript.pdf"} pdf
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
                (notes by
                = succeed ")," do
                  %a.existingWikiWord{:href => "/nlab/show/Akhil+Mathew"} Akhil Mathew
                = succeed "," do
                  %em Spectra and stable homotopy theory
                = succeed "," do
                  %a{:href => "http://math.uchicago.edu/~amathew/256y.pdf"} pdf
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/HopkinsMathewStableHomotopyTheory.pdf", :title => "pdf"} pdf
            %li#Freed13
              %p
                %a.existingWikiWord{:href => "/nlab/show/Dan+Freed"}> Dan Freed
                , lecture 8 of
                = succeed "," do
                  %em Bordism: old and new
                = succeed ")" do
                  %a{:href => "http://www.ma.utexas.edu/users/dafr/bordism.pdf"} pdf
            %li#Pedrotti16
              %p
                %a.existingWikiWord{:href => "/nlab/show/Riccardo+Pedrotti"}> Riccardo Pedrotti
                ,
                = succeed "," do
                  %em Complex oriented cohomology, generalized orientation and Thom isomorphism
                = succeed ")" do
                  %a.existingWikiWord{:href => "/nlab/files/PedrotticECohomology2018.pdf", :title => "pdf"} pdf
          %p
            A discussion in
            %a.existingWikiWord{:href => "/nlab/show/differential+geometry"} differential geometry
            with fiberwise compactly supported differential forms is around theorem 6.17 of
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Loring+Tu"} Loring Tu
              %em
                %a.existingWikiWord{:href => "/nlab/show/Differential+Forms+in+Algebraic+Topology"} Differential Forms in Algebraic Topology
          %p
            A comprehensive general abstract account for
            %a.existingWikiWord{:href => "/nlab/show/multiplicative+cohomology+theories"} multiplicative cohomology theories
            in terms of
            %a.existingWikiWord{:href => "/nlab/show/E-infinity+ring"} E-infinity ring
            %a.existingWikiWord{:href => "/nlab/show/spectra"} spectra
            is in
          %ul
            %li#ABGHR
              %a.existingWikiWord{:href => "/nlab/show/Matthew+Ando"}> Matthew Ando
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Blumberg"} Andrew Blumberg
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Gepner"} David Gepner
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Michael+Hopkins"} Michael Hopkins
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Charles+Rezk"} Charles Rezk
              %em Units of ring spectra and Thom spectra
              (
              %a{:href => "http://arxiv.org/abs/0810.4535"}> arXiv:0810.4535
              )
          %p
            An alternative simple formulation in terms of geometric cycles as in
            %a.existingWikiWord{:href => "/nlab/show/bivariant+cohomology+theory"} bivariant cohomology theory
            is in
          %ul
            %li
              Martin Jakob,
              %em A note on the Thom isomorphism in geometric (co)homology
              (
              %a{:href => "http://arxiv.org/abs/math/0403540"}> arXiv:math/0403540
              )
          %p See also
          %ul
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Albrecht+Dold"}> Albrecht Dold
                ,
                = succeed "," do
                  %em Relations between ordinary and extraordinary homology
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Yuli+Rudyak"}> Yuli Rudyak
                ,
                %em On the Thom–Dold isomorphism for nonorientable bundles
                Soviet Math. Dokl. , 22 (1980) pp. 842–844 Dokl. Akad. Nauk. SSSR , 255 : 6 (1980) pp. 1323–1325
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Robert+Switzer"}> Robert Switzer
                ,
                %em Algebraic topology - homotopy and homology
                , Springer (1975)
            %li
              %p
                PlanetMath,
                = succeed "," do
                  %em
                    %a{:href => "http://myyn.org/m/article/thom-space"} Thom space
                = succeed "," do
                  %em
                    %a{:href => "http://myyn.org/m/article/thom-class"} Thom class
                %em
                  %a{:href => "http://myyn.org/m/article/thom-isomorphism-theorem"} Thom isomorphism theorem
          %p
            Formalization in
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/homotopy+type+theory"} homotopy type theory
          %ul
            %li#Brunerie16
              %a.existingWikiWord{:href => "/nlab/show/Guillaume+Brunerie"}> Guillaume Brunerie
              ,
              %em On the homotopy groups of spheres in homotopy type theory
              (
              %a{:href => "http://arxiv.org/abs/1606.05916"}> arXiv:1606.05916
              )
