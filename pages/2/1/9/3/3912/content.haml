            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            = succeed "," do
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi Th
                    %mo{:stretchy => "false"} (
                    %mi V
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} Th(V)
            %a.existingWikiWord{:href => "/nlab/show/pullback+in+cohomology"} pullback
            to the
            %a.existingWikiWord{:href => "/nlab/show/Thom+space"} Thom space
            followed by
            %a.existingWikiWord{:href => "/nlab/show/cup+product"} cup product
            with a
