                  \\text{of Chern-Simons theory}
                  \\\
                  \\phantom{A}
                  }
                  }
                  {
                  \\longrightarrow
                  }
                  \\underset{
                  \\color{blue}
                  \\array{
                  \\phantom{A}
                  \\\
                  \\text{de Rham algebra}
                  \\\
                  \\text{of semi-algebraic differential forms}
                  \\\
                  \\text{on the FM-compactification}
                  \\\
                  \\text{of the configuration space of n points}
                  \\\
                  \\text{in}\; \Sigma
                  }
                  }{
                  \\Omega^\bullet_{PA}
                  \\big(
                  Conf_n\big(  \Sigma \big)
                  \\big)
                  }
                  \\,.
          %h2#related_concepts Related concepts
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/quantization+of+3d+Chern-Simons+theory"} quantization of 3d Chern-Simons theory
          %h2#references References
          %p
            The approach was originally considered specifically for
            %a.existingWikiWord{:href => "/nlab/show/Chern-Simons+theory"} Chern-Simons theory
            in
          %ul
            %li#AxelrodSinger93
              %a.existingWikiWord{:href => "/nlab/show/Scott+Axelrod"}> Scott Axelrod
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Isadore+Singer"} Isadore Singer
              = succeed "," do
                %em Chern–Simons Perturbation Theory II
              = succeed ")" do
                %a{:href => "http://arxiv.org/abs/hep-th/9304087"} arXiv:hep-th/9304087
          %p which was re-amplified in
          %ul
            %li
              %p
                Daniel Altschuler, Laurent Freidel, Section 3 of:
                = succeed "," do
                  %em Vassiliev knot invariants and Chern-Simons perturbation theory to all orders
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/q-alg/9603010"} arxiv:q-alg/9603010
            %li#BottCattaneo97
              %p
                %a.existingWikiWord{:href => "/nlab/show/Raoul+Bott"}> Raoul Bott
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"} Alberto Cattaneo
                = succeed "," do
                  %em Integral invariants of 3-manifolds
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/dg-ga/9710001"} arXiv:dg-ga/9710001
            %li#CattaneoMnev10
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pavel+Mnev"} Pavel Mnev
                = succeed "," do
                  %em Remarks on Chern-Simons invariants
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/0811.2045"} arXiv:0811.2045
            %li
              %p
                %a.existingWikiWord{:href => "/nlab/show/Alberto+Cattaneo"}> Alberto Cattaneo
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Pavel+Mnev"} Pavel Mnev
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Nicolai+Reshetikhin"} Nicolai Reshetikhin
                = succeed "," do
                  %em Perturbative quantum gauge theories on manifolds with boundary
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/1507.01221"} arXiv:1507.01221
                = succeed ")" do
                  %a{:href => "https://doi.org/10.1007/s00220-017-3031-6"} doi:10.1007/s00220-017-3031-6
          %p
            and highlighted as a means to obtain
            = succeed "-models" do
              %a.existingWikiWord{:href => "/nlab/show/graph+complex"} graph complex
            %a.existingWikiWord{:href => "/nlab/show/de+Rham+cohomology"} de Rham cohomology
            of
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            %a.existingWikiWord{:href => "/nlab/show/knot+spaces"} knot spaces
            in
          %ul
            %li#Kontsevich93
              %p
                %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
                ,
                = succeed "," do
                  %em Vassiliev’s knot invariants
                = succeed ")" do
                  %a{:href => "http://pagesperso.ihes.fr/~maxim/TEXTS/VassilievKnot.pdf"} pdf
            %li#Kontsevich94
              %p
                %a.existingWikiWord{:href => "/nlab/show/Maxim+Kontsevich"}> Maxim Kontsevich
                , pages 11-12 of
                = succeed "," do
                  %em Feynman diagrams and low-dimensional topology
                = succeed "," do
                  %strong 120
                = succeed ")" do
                  %a{:href => "http://www.ihes.fr/~maxim/TEXTS/Feynman%20%20diagrams%20and%20low-dimensional%20topology.pdf"} pdf
          %p with full details and proofs in
          %ul
            %li#LambrechtsVolic14
              %a.existingWikiWord{:href => "/nlab/show/Pascal+Lambrechts"}> Pascal Lambrechts
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Ismar+Voli%C4%87"} Ismar Volić
              = succeed "," do
                %em Formality of the little N-disks operad
              = succeed "," do
                %a{:href => "https://arxiv.org/abs/0808.0457"} arxiv:0808.0457
              = succeed ")" do
                %a{:href => "http://dx.doi.org/10.1090/memo/1079"} doi:10.1090/memo/1079
          %p see also
          %ul
            %li#CamposIdrissiLambrechtsWillwacher18
              %a.existingWikiWord{:href => "/nlab/show/Ricardo+Campos"}> Ricardo Campos
              , Najib Idrissi,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Pascal+Lambrechts"} Pascal Lambrechts
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Thomas+Willwacher"} Thomas Willwacher
              %em Configuration Spaces of Manifolds with Boundary
              (
              %a{:href => "https://arxiv.org/abs/1802.00716"}> arXiv:1802.00716
              )
          %p
            A systematic development of
            %a.existingWikiWord{:href => "/nlab/show/Euclidean+field+theory"} Euclidean
            %a.existingWikiWord{:href => "/nlab/show/perturbative+quantum+field+theory"} perturbative quantum field theory
            with
            %a.existingWikiWord{:href => "/nlab/show/n-point+functions"} n-point functions
            considered as
            %a.existingWikiWord{:href => "/nlab/show/smooth+functions"} smooth functions
            on
            = succeed "/" do
              %a.existingWikiWord{:href => "/nlab/show/Fulton-MacPherson+compactifications"} Fulton-MacPherson compactifications
            %a.existingWikiWord{:href => "/nlab/show/wonderful+compactifications"} wonderful compactifications
            of
            %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
            and more generally of subspace arrangements is due to
          %ul
            %li#BergbauerBrunettiKreimer09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Bergbauer"}> Christoph Bergbauer
                ,
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Romeo+Brunetti"} Romeo Brunetti
                = succeed "," do
                  %a.existingWikiWord{:href => "/nlab/show/Dirk+Kreimer"} Dirk Kreimer
                = succeed "," do
                  %em Renormalization and resolution of singularities
                = succeed "," do
                  %a{:href => "https://arxiv.org/abs/0908.0633"} arXiv:0908.0633
                = succeed ")" do
                  %a{:href => "https://mat.univie.ac.at/~esiprpr/esi2244.pdf"} ESI:2244
            %li#Bergbauer09
              %p
                %a.existingWikiWord{:href => "/nlab/show/Christoph+Bergbauer"}> Christoph Bergbauer
                ,
                = succeed "," do
                  %em Renormalization and resolution of singularities
                = succeed ")" do
                  %a{:href => "http://www.emg.uni-mainz.de/Dateien/bergbauer.pdf"} pdf
            %li#Berghoff14a
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marko+Berghoff"}> Marko Berghoff
                ,
                = succeed "," do
                  %em Wonderful renormalization
                = succeed "," do
                  %a{:href => "http://www2.mathematik.hu-berlin.de/%7Ekreimer/wp-content/uploads/Berghoff-Marko.pdf"} pdf
                = succeed ")" do
                  %a{:href => "https://doi.org/10.18452/17160"} doi:10.18452/17160
            %li#Berghoff14b
              %p
                %a.existingWikiWord{:href => "/nlab/show/Marko+Berghoff"}> Marko Berghoff
                ,
                = succeed "," do
                  %em Wonderful compactifications in quantum field theory
                = succeed ")" do
                  %a{:href => "https://arxiv.org/abs/1411.5583"} arXiv:1411.5583
          %p
            Analogous discussion for configuration spaces of points regarded as
            %a.existingWikiWord{:href => "/nlab/show/Hilbert+schemes+of+points"} Hilbert schemes of points
            and with their
            %a.existingWikiWord{:href => "/nlab/show/ordinary+cohomology"} ordinary cohomology
            replaced by
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/K-theory"} K-theory
          %ul
            %li
              Jian Zhou,
              %em K-Theory of Hilbert Schemes as a Formal Quantum Field Theory
              (
              %a{:href => "https://arxiv.org/abs/1803.06080"}> arXiv:1803.06080
              )
          %p
            Discussion specifically in
            %a.existingWikiWord{:href => "/nlab/show/topological+quantum+field+theory"} topological quantum field theory
            with an eye towards
            %a.existingWikiWord{:href => "/nlab/show/supersymmetry"} supersymmetric
            field theory, in terms of the
            %a.existingWikiWord{:href => "/nlab/show/ordinary+homology"} ordinary homology
            of
            = succeed ":" do
              %a.existingWikiWord{:href => "/nlab/show/configuration+spaces+of+points"} configuration spaces of points
          %ul
            %li
              %a.existingWikiWord{:href => "/nlab/show/Christopher+Beem"}> Christopher Beem
              ,
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/David+Ben-Zvi"} David Ben-Zvi
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Mathew+Bullimore"} Mathew Bullimore
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Tudor+Dimofte"} Tudor Dimofte
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/Andrew+Neitzke"} Andrew Neitzke
              %em Secondary products in supersymmetric field theory
              (
              %a{:href => "https://arxiv.org/abs/1809.00009"}> arXiv:1809.00009
              )
