                          %mtd
                          %mtd
                          %mtd
                            %mi X
                          %mtd
                            %mover
                              %mo →
                              %mi f
                          %mtd
                            %mi Y
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;\to&amp; X \times_X B &amp;\to&amp; B
                    \\\
                    \&amp;{}_{\mathllap{a}}\searrow&amp; \downarrow^{\mathrlap{f^*(b)}} &amp;&amp; \downarrow^{\mathrlap{b}}
                    \\\
                    \&amp;&amp; X &amp;\stackrel{f}{\to}&amp; Y
                    }
            %p
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi Y
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo{:stretchy => "false"} (
