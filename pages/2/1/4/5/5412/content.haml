                  %annotation{:encoding => "application/x-tex"}
                    (X_! \dashv X^* \dashv X_*)
                    \:
                    \\mathcal{T}/X \stackrel{\overset{X_!}{\to}}{\stackrel{\overset{X^*}{\leftarrow}}{\underset{X_*}{\to}}}
                    \\mathcal{T}
                    \\,.
          .proof
            %h6#proof Proof
            %p
              The functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X^*
              is given by taking the
              %a.existingWikiWord{:href => "/nlab/show/product"} product
              with
              = succeed ":" do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msup
                      %mi X
                      %mo *
                    %mo :
                    %mi K
                    %mo ↦
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi p
                      %mn 2
                    %mo :
                    %mi K
                    %mo ×
                    %mi X
                    %mo →
                    %mi X
                    %mo{:stretchy => "false"} )
                    %mspace{:width => "thinmathspace"}
                    %mo ,
                  %annotation{:encoding => "application/x-tex"}
                    X^* : K \mapsto (p_2 : K \times X \to X)
                    \\,,
            %p
              since
              = succeed "s" do
                %a.existingWikiWord{:href => "/nlab/show/commuting+diagram"} commuting diagram
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mrow
                      %mtable
                        %mtr
                          %mtd
                            %mi A
                          %mtd
                          %mtd
                            %mo →
                          %mtd
                          %mtd
                            %mi K
                            %mo ×
                            %mi X
                        %mtr
                          %mtd
                          %mtd
                            %mo ↘
                          %mtd
                          %mtd
                            %msub
                              %mo ↙
                              %mpadded{:width => "0"}
                                %mrow
                                  %msub
                                    %mi p
                                    %mn 2
                        %mtr
                          %mtd
                          %mtd
                          %mtd
                            %mi X
                  %annotation{:encoding => "application/x-tex"}
                    \\array{
                    A &amp;&amp;\to&amp;&amp; K \times X
                    \\\
                    \&amp; \searrow &amp;&amp; \swarrow_{\mathrlap{p_2}}
                    \\\
                    \&amp;&amp; X
                    }
            %p
              are evidently uniquely specified by their components
              = succeed "." do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi A
                      %mo →
                      %mi K
                    %annotation{:encoding => "application/x-tex"} A \to K
            %p
              Moreover, since in the Grothendieck topos
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
              we have
              = succeed "," do
                %a.existingWikiWord{:href => "/nlab/show/universal+colimits"} universal colimits
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo{:stretchy => "false"} )
                    %mo ×
                    %mi X
                  %annotation{:encoding => "application/x-tex"} (-) \times X
              preserves all
              = succeed "s." do
                %a.existingWikiWord{:href => "/nlab/show/colimit"} colimit
              %a.existingWikiWord{:href => "/nlab/show/adjoint+functor+theorem"} adjoint functor theorem
              a further
              %a.existingWikiWord{:href => "/nlab/show/right+adjoint"} right adjoint
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo *
                  %annotation{:encoding => "application/x-tex"} X_*
              exists.
          .num_remark
            %h6#remark_2 Remark
            %p
              One also says that
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo !
