                    %mi ℰ
                    %mo →
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{E} \to \mathcal{T}
              equivalent to one of the form
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo !
                    %mo ⊣
                    %msup
                      %mi X
                      %mo *
                    %mo ⊣
                    %msub
                      %mi X
                      %mo *
                    %mo{:stretchy => "false"} )
                  %annotation{:encoding => "application/x-tex"} (X_! \dashv X^* \dashv X_*)
              is called an
              = succeed "." do
                %strong
                  %a.existingWikiWord{:href => "/nlab/show/etale+geometric+morphism"} etale geometric morphism
          %p More generally:
          #GeneralEtaleGeometricMorphism.num_prop
            %h6#proposition_5 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi ℰ
                  %annotation{:encoding => "application/x-tex"} \mathcal{E}
              a
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi f
                    %mo :
                    %mi X
                    %mo →
                    %mi Y
                  %annotation{:encoding => "application/x-tex"} f : X \to Y
              a
              %a.existingWikiWord{:href => "/nlab/show/morphism"} morphism
              in
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                  %semantics
                    %mrow
                      %mi ℰ
                    %annotation{:encoding => "application/x-tex"} \mathcal{E}
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi f
                      %mo !
                    %mo ⊣
                    %msup
                      %mi f
                      %mo *
                    %mo ⊣
                    %msub
                      %mi f
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi ℰ
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi f
                              %mo *
                        %mover
                          %mo ←
