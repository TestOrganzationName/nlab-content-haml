          %h2#properties Properties
          %h3#EtaleGeometricMorphism Étale geometric morphism
          .num_prop
            %h6#proposition_4 Proposition
            %p
              For
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
              a
              %a.existingWikiWord{:href => "/nlab/show/Grothendieck+topos"} Grothendieck topos
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi X
                    %mo ∈
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} X \in \mathcal{T}
              any object, the canonical projection functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo !
                    %mo :
                    %mi 𝒯
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mo →
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} X_! : \mathcal{T}/X \to \mathcal{T}
              is part of an
              %a.existingWikiWord{:href => "/nlab/show/essential+geometric+morphism"} essential geometric morphism
            .maruku-equation
              %math.maruku-mathml{:display => "block", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo{:stretchy => "false"} (
                    %msub
                      %mi X
                      %mo !
                    %mo ⊣
                    %msup
                      %mi X
                      %mo *
                    %mo ⊣
                    %msub
                      %mi X
                      %mo *
                    %mo{:stretchy => "false"} )
                    %mo :
                    %mi 𝒯
                    %mo{:stretchy => "false"} /
                    %mi X
                    %mover
                      %mover
                        %munder
                          %mo →
                          %mrow
                            %msub
                              %mi X
                              %mo *
                        %mover
                          %mo ←
                          %mrow
                            %msup
                              %mi X
                              %mo *
                      %mover
                        %mo →
                        %mrow
                          %msub
                            %mi X
                            %mo !
                    %mi 𝒯
                    %mspace{:width => "thinmathspace"}
