                    %mo{:lspace => "verythinmathspace", :rspace => "0em"} −
                    %mo :
                    %mi 𝒯
                    %mo →
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} X \times -: \mathcal{T} \to \mathcal{T}
              (with comultiplication induced by the diagonal
              = succeed "," do
                %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
