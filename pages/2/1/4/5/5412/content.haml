                    %mrow
                      %mi X
                    %annotation{:encoding => "application/x-tex"} X
            %p
              Moreover, in terms of the
              %a.existingWikiWord{:href => "/nlab/show/internal+logic"} internal logic
              of
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mi 𝒯
                  %annotation{:encoding => "application/x-tex"} \mathcal{T}
              the functor
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %msub
                      %mi X
                      %mo !
                  %annotation{:encoding => "application/x-tex"} X_!
              is the
              %em
                %a.existingWikiWord{:href => "/nlab/show/existential+quantifier"} existential quantifier
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
                %semantics
                  %mrow
                    %mo ∃
                  %annotation{:encoding => "application/x-tex"} \exists
              and
              %math.maruku-mathml{:display => "inline", :xmlns => "http://www.w3.org/1998/Math/MathML"}
